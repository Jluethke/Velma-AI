{
  "name": "s2i-errata-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "spec",
    "errata",
    "rfc-editor",
    "w3c",
    "iso"
  ],
  "inputs": [
    "spec_bundle"
  ],
  "outputs": [
    "errata_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
