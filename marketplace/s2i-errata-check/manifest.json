    {
      "flow_name": "s2i-bcp14-keyword-scan",
      "relationship": "feeds_into",
      "description": "outputs errata_log consumed by s2i-bcp14-keyword-scan"
    },
    {
      "flow_name": "s2i-requirements-table",
      "relationship": "feeds_into",
      "description": "outputs errata_log consumed by s2i-requirements-table"
    },
    {
      "flow_name": "s2i-ambiguity-log",
      "relationship": "feeds_into",
      "description": "outputs errata_log consumed by s2i-ambiguity-log"
    },
    {
      "flow_name": "s2i-test-vectors-extract",
      "relationship": "feeds_into",
      "description": "outputs errata_log consumed by s2i-test-vectors-extract"
    },
    {
      "flow_name": "s2i-iana-registry-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "s2i-state-machine-extract",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "s2i-abnf-extract-validate",
      "relationship": "feeds_into",
      "description": "outputs errata_log consumed by s2i-abnf-extract-validate"
    }
  ]
}
