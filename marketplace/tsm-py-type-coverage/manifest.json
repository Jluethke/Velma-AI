{
  "name": "tsm-py-type-coverage",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "python",
    "mypy-reports",
    "any-exprs",
    "verifytypes"
  ],
  "inputs": [
    "repo_path",
    "migration_profile"
  ],
  "outputs": [
    "py_type_coverage"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure Python type coverage with mypy any-exprs and lineprecision reports or pyright --verifytypes and record the per-module numbers.",
  "related_flows": [
    {
      "flow_name": "tsm-migration-intake",
      "relationship": "fed_by",
      "description": "provides migration_profile needed here"
    },
    {
      "flow_name": "tsm-py-error-baseline",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-py-ci-gate",
      "relationship": "feeds_into",
      "description": "outputs py_type_coverage consumed by tsm-py-ci-gate"
    },
    {
      "flow_name": "tsm-ts-error-baseline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-type-coverage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-ci-gate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-conversion-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-stubs-missing-imports",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
