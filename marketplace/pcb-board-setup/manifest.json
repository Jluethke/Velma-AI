{
  "name": "pcb-board-setup",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "layout",
    "kicad",
    "design-rules"
  ],
  "inputs": [
    "skidl_source",
    "netlist",
    "bom",
    "board_spec",
    "creepage_constraints",
    "review_verdict",
    "project_dir"
  ],
  "outputs": [
    "setup_board",
    "net_classes"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Generate the starting KiCad 9 board from a reviewed SKiDL design and set outline, stackup, fab rules, IPC-2221 power net widths, differential pair classes, and isolation keepouts.",
  "related_flows": [
    {
      "flow_name": "pcb-placement-candidates",
      "relationship": "feeds_into",
      "description": "outputs setup_board consumed by pcb-placement-candidates"
    },
    {
      "flow_name": "pcb-placement-scoring",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-critical-routing",
      "relationship": "feeds_into",
      "description": "outputs net_classes consumed by pcb-critical-routing"
    },
    {
      "flow_name": "pcb-autoroute",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-drc-closure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-layout-metrics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "fed_by",
      "description": "provides board_spec needed here"
    },
    {
      "flow_name": "pcb-stock-sourcing",
      "relationship": "fed_by",
      "description": "provides bom needed here"
    }
  ]
}
