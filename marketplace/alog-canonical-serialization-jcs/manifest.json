      "description": "provides record_schema needed here"
    },
    {
      "flow_name": "alog-hash-chain-link-design",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "alog-verifier-tool-spec",
      "relationship": "feeds_into",
      "description": "outputs canonicalization_spec consumed by alog-verifier-tool-spec"
    },
    {
      "flow_name": "alog-threat-model-requirements",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "alog-hash-algorithm-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "alog-py-canonical-hash",
      "relationship": "feeds_into",
      "description": "outputs canonicalization_spec consumed by alog-py-canonical-hash"
    },
    {
      "flow_name": "alog-go-canonical-hash",
      "relationship": "feeds_into",
      "description": "outputs canonicalization_spec consumed by alog-go-canonical-hash"
    },
    {
      "flow_name": "alog-py-crash-safe-append",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
