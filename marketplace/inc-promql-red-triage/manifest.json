{
  "name": "inc-promql-red-triage",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "incident-response",
    "prometheus",
    "promql",
    "metrics",
    "red-method"
  ],
  "inputs": [
    "incident_record",
    "prometheus_url",
    "sli_queries"
  ],
  "outputs": [
    "metric_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Query Prometheus for rate, error, duration and saturation over the incident window and find which signal moved first and when.",
  "related_flows": [
    {
      "flow_name": "inc-change-correlation",
      "relationship": "feeds_into",
      "description": "outputs metric_findings consumed by inc-change-correlation"
    },
    {
      "flow_name": "inc-hypothesis-draft",
      "relationship": "feeds_into",
      "description": "outputs metric_findings consumed by inc-hypothesis-draft"
    },
    {
      "flow_name": "inc-pg-blocking-queries",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "inc-mysql-lock-waits",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "inc-hypothesis-verdict",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "inc-declare-severity",
      "relationship": "fed_by",
      "description": "provides incident_record needed here"
    },
    {
      "flow_name": "inc-assign-incident-roles",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-timeline-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
