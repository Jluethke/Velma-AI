{
  "name": "mex-schema-ownership-split",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "monolith-decomposition",
    "database",
    "schema",
    "grants",
    "migrations"
  ],
  "inputs": [
    "table_ownership",
    "shared_tables",
    "database_engine",
    "module_interface",
    "deployment_decision"
  ],
  "outputs": [
    "schema_split_plan",
    "migration_scripts"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Move owned tables into their own schema or database with compatibility views and revoked grants, then replace cross-boundary foreign keys.",
  "related_flows": [
    {
      "flow_name": "mex-dual-write-or-cdc-decision",
      "relationship": "feeds_into",
      "description": "outputs schema_split_plan consumed by mex-dual-write-or-cdc-decision"
    },
    {
      "flow_name": "mex-transactional-outbox",
      "relationship": "feeds_into",
      "description": "outputs schema_split_plan consumed by mex-transactional-outbox"
    },
    {
      "flow_name": "mex-cdc-debezium-postgres",
      "relationship": "feeds_into",
      "description": "outputs schema_split_plan consumed by mex-cdc-debezium-postgres"
    },
    {
      "flow_name": "mex-cdc-debezium-mysql",
      "relationship": "feeds_into",
      "description": "outputs schema_split_plan consumed by mex-cdc-debezium-mysql"
    },
    {
      "flow_name": "mex-backfill-and-reconcile",
      "relationship": "feeds_into",
      "description": "outputs schema_split_plan consumed by mex-backfill-and-reconcile"
    },
    {
      "flow_name": "mex-table-ownership-map",
      "relationship": "fed_by",
      "description": "provides shared_tables, table_ownership needed here"
    },
    {
      "flow_name": "mex-interface-boundary-contract",
      "relationship": "fed_by",
      "description": "provides module_interface needed here"
    },
    {
      "flow_name": "mex-in-process-or-service-decision",
      "relationship": "fed_by",
      "description": "provides deployment_decision needed here"
    }
  ]
}
