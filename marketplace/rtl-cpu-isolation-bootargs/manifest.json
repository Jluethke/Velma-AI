{
  "name": "rtl-cpu-isolation-bootargs",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "realtime-linux",
    "isolcpus",
    "nohz_full",
    "rcu_nocbs"
  ],
  "inputs": [
    "kernel_report",
    "rt_cpus",
    "housekeeping_cpus"
  ],
  "outputs": [
    "isolation_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Isolate the real-time CPUs with isolcpus, nohz_full, rcu_nocbs and irqaffinity boot parameters and verify them after reboot.",
  "related_flows": [
    {
      "flow_name": "rtl-kernel-rt-check",
      "relationship": "fed_by",
      "description": "provides kernel_report needed here"
    },
    {
      "flow_name": "rtl-cyclictest-baseline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rtl-hw-noise-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rtl-power-cstate-tuning",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rtl-cpuset-partition",
      "relationship": "feeds_into",
      "description": "outputs isolation_config consumed by rtl-cpuset-partition"
    },
    {
      "flow_name": "rtl-irq-affinity",
      "relationship": "feeds_into",
      "description": "outputs isolation_config consumed by rtl-irq-affinity"
    },
    {
      "flow_name": "rtl-threaded-irq-priority",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rtl-cyclictest-under-load",
      "relationship": "feeds_into",
      "description": "outputs isolation_config consumed by rtl-cyclictest-under-load"
    }
  ]
}
