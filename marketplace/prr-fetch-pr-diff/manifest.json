{
  "name": "prr-fetch-pr-diff",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "git",
    "github",
    "gitlab",
    "diff"
  ],
  "inputs": [
    "repo_dir",
    "pr_number",
    "forge",
    "base_branch"
  ],
  "outputs": [
    "diff_file",
    "changed_files",
    "diff_stat",
    "head_sha",
    "pr_description"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Fetch a GitHub PR or GitLab MR head with git refspecs and save the merge-base diff, rename-aware file list, size summary, head SHA and description.",
  "related_flows": [
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "feeds_into",
      "description": "outputs pr_description, changed_files consumed by prr-intent-scope-check"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "feeds_into",
      "description": "outputs head_sha, diff_stat consumed by prr-large-pr-split"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "feeds_into",
      "description": "outputs changed_files consumed by prr-diff-reading-order"
    },
    {
      "flow_name": "prr-severity-comments",
      "relationship": "feeds_into",
      "description": "outputs head_sha, diff_file consumed by prr-severity-comments"
    },
    {
      "flow_name": "prr-approval-decision",
      "relationship": "feeds_into",
      "description": "outputs head_sha consumed by prr-approval-decision"
    },
    {
      "flow_name": "prr-gh-post-review",
      "relationship": "feeds_into",
      "description": "outputs head_sha consumed by prr-gh-post-review"
    },
    {
      "flow_name": "prr-glab-post-review",
      "relationship": "feeds_into",
      "description": "outputs head_sha consumed by prr-glab-post-review"
    },
    {
      "flow_name": "prr-concurrency-pass",
      "relationship": "feeds_into",
      "description": "outputs diff_file consumed by prr-concurrency-pass"
    }
  ]
}
