{
  "name": "ros2-tf2-static-frames",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ros2",
    "robotics",
    "tf2",
    "rep-103",
    "rep-105",
    "frames"
  ],
  "inputs": [
    "frame_spec",
    "workspace_dir"
  ],
  "outputs": [
    "frame_tree",
    "tf_check"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Lay out a REP 103 and REP 105 frame tree, publish fixed mounts as static transforms with one publisher per transform, and verify the tree with view_frames and tf2_echo.",
  "related_flows": [
    {
      "flow_name": "ros2-tf2-lookup-debug",
      "relationship": "feeds_into",
      "description": "outputs frame_tree consumed by ros2-tf2-lookup-debug"
    },
    {
      "flow_name": "ros2-doctor-introspection",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ros2-rosbag2-mcap-record",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ros2-rosbag2-replay-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
