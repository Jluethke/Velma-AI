{
  "name": "dlog-storage-budget",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "logging",
    "storage",
    "rotation",
    "capacity"
  ],
  "inputs": [
    "measured_rates",
    "disk_throughput",
    "storage_capacity_bytes",
    "retention_policy"
  ],
  "outputs": [
    "storage_budget"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Compute recording hours, file rotation size and duration, and retention from measured byte rates and the real capacity of the logging volume.",
  "related_flows": [
    {
      "flow_name": "dlog-format-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dlog-sensor-rate-inventory",
      "relationship": "fed_by",
      "description": "provides measured_rates needed here"
    },
    {
      "flow_name": "dlog-disk-throughput-measure",
      "relationship": "fed_by",
      "description": "provides disk_throughput needed here"
    },
    {
      "flow_name": "dlog-drop-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dlog-ros2-bag-record",
      "relationship": "feeds_into",
      "description": "outputs storage_budget consumed by dlog-ros2-bag-record"
    },
    {
      "flow_name": "dlog-py-mcap-writer",
      "relationship": "feeds_into",
      "description": "outputs storage_budget consumed by dlog-py-mcap-writer"
    },
    {
      "flow_name": "dlog-cpp-mcap-writer",
      "relationship": "feeds_into",
      "description": "outputs storage_budget consumed by dlog-cpp-mcap-writer"
    },
    {
      "flow_name": "dlog-can-blf-capture",
      "relationship": "feeds_into",
      "description": "outputs storage_budget consumed by dlog-can-blf-capture"
    }
  ]
}
