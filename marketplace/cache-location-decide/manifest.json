{
  "name": "cache-location-decide",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "caching",
    "architecture",
    "redis",
    "memcached",
    "cdn"
  ],
  "inputs": [
    "read_hotspots",
    "deployment_topology",
    "consistency_requirement"
  ],
  "outputs": [
    "cache_plan",
    "cache_backend"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Choose in-process, shared Redis or Memcached, HTTP private or CDN caching for each hotspot with a first-match decision table, and pick the shared backend.",
  "related_flows": [
    {
      "flow_name": "cache-read-hotspot-measure",
