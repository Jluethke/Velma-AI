{
  "name": "ffr-flag-removal-pr",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "cleanup",
    "refactoring",
    "dead-code",
    "pull-request"
  ],
  "inputs": [
    "stale_flags",
    "repo_path",
    "stack",
    "experiment_decision"
  ],
  "outputs": [
    "removal_pr"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Remove one stale flag from code in a single pull request, keeping the verified production variant and deleting only branch-specific tests.",
  "related_flows": [
    {
      "flow_name": "ffr-stale-flag-detect",
      "relationship": "fed_by",
      "description": "provides stale_flags needed here"
    },
    {
      "flow_name": "ffr-flag-type-classify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-targeting-rules",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-otel-flag-telemetry",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-guardrail-metrics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-ab-sample-size",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-srm-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-experiment-readout",
      "relationship": "fed_by",
      "description": "provides experiment_decision needed here"
    }
  ]
}
