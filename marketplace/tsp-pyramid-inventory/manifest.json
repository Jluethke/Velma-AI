{
  "name": "tsp-pyramid-inventory",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "testing",
    "test-pyramid",
    "e2e",
    "integration",
    "inventory"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "baseline_report",
    "hotspot_plan"
  ],
  "outputs": [
    "pyramid_inventory"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Classify every test file by the boundaries it crosses, join with durations, and list tests whose assertions can be checked at a lower layer.",
  "related_flows": [
    {
      "flow_name": "tsp-baseline-lock",
      "relationship": "fed_by",
      "description": "provides baseline_report needed here"
    },
    {
      "flow_name": "tsp-hotspot-classify",
      "relationship": "fed_by",
      "description": "provides hotspot_plan needed here"
    },
    {
      "flow_name": "tsp-pg-template-clone",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsp-pyramid-push-down",
      "relationship": "feeds_into",
      "description": "outputs pyramid_inventory consumed by tsp-pyramid-push-down"
    },
    {
      "flow_name": "tsp-order-isolation-check",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsp-coverage-parity-gate",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsp-speedup-report",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsp-py-durations-report",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
