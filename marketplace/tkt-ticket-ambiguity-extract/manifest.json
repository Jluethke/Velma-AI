{
  "name": "tkt-ticket-ambiguity-extract",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ticket",
    "requirements",
    "ambiguity",
    "clarification",
    "planning"
  ],
  "inputs": [
    "ticket_text",
    "ticket_id"
  ],
  "outputs": [
    "ambiguity_list",
    "clarification_questions",
    "working_requirements"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Classify every ticket sentence, detect ambiguity with a nine-class table, and turn each gap into a closed question with a sourced default.",
  "related_flows": [
    {
      "flow_name": "tkt-acceptance-criteria-gwt",
      "relationship": "feeds_into",
      "description": "outputs working_requirements, ambiguity_list consumed by tkt-acceptance-criteria-gwt"
    },
    {
      "flow_name": "tkt-repo-orient-detect",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "tkt-rg-call-trace",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "tkt-lsp-reference-trace",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "tkt-change-impact-list",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "tkt-test-level-choose",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "tkt-branch-create",
      "relationship": "feeds_into",
      "description": "outputs working_requirements consumed by tkt-branch-create"
    },
    {
      "flow_name": "tkt-failing-test-first",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
