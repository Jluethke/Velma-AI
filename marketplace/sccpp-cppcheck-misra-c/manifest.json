{
  "name": "sccpp-cppcheck-misra-c",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "cppcheck",
    "misra",
    "static-analysis",
    "c"
  ],
  "inputs": [
    "codebase_dir",
    "build_profiles",
    "misra_rule_texts"
  ],
  "outputs": [
    "cppcheck_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run Cppcheck with its MISRA C:2012 addon on the compile database and report findings and configuration errors by ID.",
  "related_flows": [
    {
      "flow_name": "sccpp-standard-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-cmake-build-profiles",
      "relationship": "fed_by",
      "description": "provides build_profiles needed here"
    },
    {
      "flow_name": "sccpp-gcc-warning-set",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-clang-warning-set",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-clang-tidy-config",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-findings-triage",
      "relationship": "feeds_into",
      "description": "outputs cppcheck_findings consumed by sccpp-findings-triage"
    },
    {
      "flow_name": "sccpp-deviation-record",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
