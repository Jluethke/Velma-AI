{
  "name": "ctr-base-image-select",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "containers",
    "docker",
    "base-image",
    "distroless",
    "alpine"
  ],
  "inputs": [
    "build_profile",
    "base_preference"
  ],
  "outputs": [
    "base_image_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Choose builder and runtime base images from a decision table and record the shell, libc, package manager and default user each one provides.",
  "related_flows": [
    {
      "flow_name": "ctr-stack-inventory",
      "relationship": "fed_by",
      "description": "provides build_profile needed here"
    },
    {
      "flow_name": "ctr-dockerignore",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ctr-alpine-musl-check",
      "relationship": "feeds_into",
      "description": "outputs base_image_plan consumed by ctr-alpine-musl-check"
    },
    {
      "flow_name": "ctr-pin-base-digest",
      "relationship": "feeds_into",
      "description": "outputs base_image_plan consumed by ctr-pin-base-digest"
    },
    {
      "flow_name": "ctr-layer-cache-order",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ctr-build-args-secrets",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ctr-nonroot-user",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ctr-healthcheck",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
