{
  "name": "detd-field-log-corpus",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "regression",
    "corpus",
    "field-logs",
    "privacy"
  ],
  "inputs": [
    "field_logs_dir",
    "record_schema",
    "replay_harness"
  ],
  "outputs": [
    "regression_corpus",
    "corpus_manifest"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a validated, deduplicated, scrubbed and labeled regression corpus from field recordings with a versioned manifest.",
  "related_flows": [
    {
      "flow_name": "detd-boundary-record-schema",
      "relationship": "fed_by",
      "description": "provides record_schema needed here"
    },
    {
      "flow_name": "detd-ros2-bag-record-replay",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "detd-can-log-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "detd-replay-harness-bitexact",
      "relationship": "fed_by",
      "description": "provides replay_harness needed here"
    },
    {
      "flow_name": "detd-state-snapshot-restore",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "detd-failing-log-minimize",
      "relationship": "feeds_into",
      "description": "outputs regression_corpus consumed by detd-failing-log-minimize"
    },
    {
      "flow_name": "detd-ci-replay-gate-github",
      "relationship": "feeds_into",
      "description": "outputs corpus_manifest consumed by detd-ci-replay-gate-github"
    },
    {
      "flow_name": "detd-bench-hil-replay",
      "relationship": "feeds_into",
      "description": "outputs corpus_manifest consumed by detd-bench-hil-replay"
    }
  ]
}
