{
  "name": "dfc-readme-structure",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "documentation",
    "readme",
    "install",
    "quickstart",
    "markdown"
  ],
  "inputs": [
    "repo_path",
    "audience_profile",
    "doc_plan"
  ],
  "outputs": [
    "readme_path",
    "readme_commands"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a README in a fixed section order with copy-pasteable commands sourced from manifest files, and extract its install and quickstart commands.",
  "related_flows": [
    {
      "flow_name": "dfc-audience-doctype-plan",
      "relationship": "fed_by",
      "description": "provides audience_profile, doc_plan needed here"
    },
    {
      "flow_name": "dfc-lychee-link-check",
      "relationship": "feeds_into",
      "description": "outputs readme_path consumed by dfc-lychee-link-check"
    },
    {
      "flow_name": "dfc-quickstart-clean-container-verify",
      "relationship": "feeds_into",
      "description": "outputs readme_commands consumed by dfc-quickstart-clean-container-verify"
    },
    {
      "flow_name": "dfc-py-docstring-conventions",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-node-tsdoc-conventions",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-go-doc-comments",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-rust-doc-comments",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-py-sphinx-autodoc",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
