{
  "name": "sdk-spec-spectral-lint",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "openapi",
    "spectral",
    "lint",
    "sdk",
    "api-spec"
  ],
  "inputs": [
    "spec_path",
    "spectral_ruleset"
  ],
  "outputs": [
    "lint_report",
    "validated_spec"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Validate and lint an OpenAPI spec with a pinned Spectral CLI, read the JSON report by severity, and fix every error before SDK generation.",
  "related_flows": [
    {
      "flow_name": "sdk-spec-sdk-readiness-rules",
      "relationship": "feeds_into",
      "description": "outputs validated_spec, lint_report consumed by sdk-spec-sdk-readiness-rules"
    },
    {
      "flow_name": "sdk-spec-inventory",
      "relationship": "feeds_into",
      "description": "outputs validated_spec consumed by sdk-spec-inventory"
    },
    {
      "flow_name": "sdk-generator-decision",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "sdk-model-type-mapping",
      "relationship": "feeds_into",
      "description": "outputs validated_spec consumed by sdk-model-type-mapping"
    },
    {
      "flow_name": "sdk-handwritten-endpoint-map",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "sdk-endpoint-coverage-audit",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "sdk-auth-api-key",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "sdk-auth-oauth-client-credentials",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
