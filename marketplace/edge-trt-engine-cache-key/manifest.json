    {
      "flow_name": "edge-trtexec-engine-build",
      "relationship": "fed_by",
      "description": "provides engine_file needed here"
    },
    {
      "flow_name": "edge-quantization-accuracy-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-latency-throughput-benchmark",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-jetpack-l4t-version-check",
      "relationship": "fed_by",
      "description": "provides platform_report needed here"
    },
    {
      "flow_name": "edge-cuda-cudnn-aarch64-verify",
      "relationship": "fed_by",
      "description": "provides cuda_stack_report needed here"
    },
    {
      "flow_name": "edge-ota-model-package",
