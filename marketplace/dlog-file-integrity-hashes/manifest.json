{
  "name": "dlog-file-integrity-hashes",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "logging",
    "sha256",
    "integrity",
    "hashing"
  ],
  "inputs": [
    "log_dir",
    "run_manifest"
  ],
  "outputs": [
    "hash_manifest"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Compute SHA-256 hashes for every closed log file and the run manifest, write a SHA256SUMS file and verify it with sha256sum -c.",
  "related_flows": [
    {
      "flow_name": "dlog-log-validate-recover",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dlog-run-manifest",
      "relationship": "fed_by",
      "description": "provides run_manifest needed here"
    },
    {
      "flow_name": "dlog-offload-verify",
      "relationship": "feeds_into",
      "description": "outputs hash_manifest consumed by dlog-offload-verify"
    },
    {
      "flow_name": "dlog-drive-index-sqlite",
      "relationship": "feeds_into",
      "description": "outputs hash_manifest consumed by dlog-drive-index-sqlite"
    }
  ]
}
