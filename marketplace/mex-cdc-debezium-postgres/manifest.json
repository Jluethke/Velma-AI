      "description": "provides sync_strategy needed here"
    },
    {
      "flow_name": "mex-transactional-outbox",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mex-cdc-debezium-mysql",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mex-backfill-and-reconcile",
      "relationship": "feeds_into",
      "description": "outputs pg_cdc_pipeline consumed by mex-backfill-and-reconcile"
    }
  ]
