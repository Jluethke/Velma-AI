{
  "name": "mex-cdc-debezium-postgres",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "monolith-decomposition",
    "debezium",
    "postgres",
    "cdc",
    "logical-replication"
  ],
  "inputs": [
    "schema_split_plan",
    "sync_strategy"
  ],
  "outputs": [
    "pg_cdc_pipeline"
