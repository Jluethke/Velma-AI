{
  "name": "etl-source-key-watermark-discovery",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "etl",
    "primary-key",
    "watermark",
    "incremental",
    "deletes"
  ],
  "inputs": [
    "source_connection",
    "source_profile"
  ],
  "outputs": [
    "extraction_keys"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Prove each source table's key with duplicate SQL, test whether a change column is a safe incremental watermark, and classify how deletes appear.",
  "related_flows": [
    {
      "flow_name": "etl-source-profile-sql",
      "relationship": "fed_by",
      "description": "provides source_profile needed here"
    },
    {
      "flow_name": "etl-target-schema-contract",
      "relationship": "feeds_into",
      "description": "outputs extraction_keys consumed by etl-target-schema-contract"
    },
    {
      "flow_name": "etl-freshness-failure-alerts",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "etl-late-arriving-data-policy",
      "relationship": "feeds_into",
      "description": "outputs extraction_keys consumed by etl-late-arriving-data-policy"
    },
    {
      "flow_name": "etl-extract-watermark-incremental",
      "relationship": "feeds_into",
      "description": "outputs extraction_keys consumed by etl-extract-watermark-incremental"
    },
    {
      "flow_name": "etl-cdc-debezium-postgres",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "etl-cdc-debezium-mysql",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "etl-cdc-merge-apply",
      "relationship": "feeds_into",
      "description": "outputs extraction_keys consumed by etl-cdc-merge-apply"
    }
  ]
}
