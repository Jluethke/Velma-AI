{
  "name": "rag-faiss-index-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rag",
    "faiss",
    "vector-search",
    "hnsw",
    "ivf"
  ],
  "inputs": [
    "chunk_config",
    "embedding_choice",
    "eval_harness",
    "work_dir",
    "target_ann_recall",
    "latency_budget_ms"
  ],
  "outputs": [
    "vector_index",
    "ann_recall_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a FAISS index with an id map, choose Flat, HNSW or IVF by measured latency and recall against IndexFlatIP, tune efSearch or nprobe, and persist it.",
  "related_flows": [
    {
      "flow_name": "rag-retrieval-eval-harness",
      "relationship": "fed_by",
      "description": "provides eval_harness needed here"
    },
    {
      "flow_name": "rag-embedding-model-select",
      "relationship": "fed_by",
      "description": "provides embedding_choice needed here"
    },
    {
      "flow_name": "rag-chunk-size-select",
      "relationship": "fed_by",
      "description": "provides chunk_config needed here"
    },
    {
      "flow_name": "rag-pg-fts-rrf-hybrid",
      "relationship": "feeds_into",
      "description": "outputs vector_index consumed by rag-pg-fts-rrf-hybrid"
    },
    {
      "flow_name": "rag-py-bm25s-rrf-hybrid",
      "relationship": "feeds_into",
      "description": "outputs vector_index consumed by rag-py-bm25s-rrf-hybrid"
    },
    {
      "flow_name": "rag-qdrant-sparse-hybrid",
      "relationship": "feeds_into",
      "description": "outputs vector_index consumed by rag-qdrant-sparse-hybrid"
    }
  ]
}
