{
  "name": "pcb-drc-closure",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "drc",
    "kicad",
    "verification"
  ],
  "inputs": [
    "routed_board",
    "board_spec"
  ],
  "outputs": [
    "kicad_pcb",
    "drc_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run KiCad headless DRC with schematic parity and fix every violation at its cause until zero violations and zero unconnected items.",
  "related_flows": [
    {
      "flow_name": "pcb-board-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-placement-candidates",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-placement-scoring",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-critical-routing",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-autoroute",
      "relationship": "fed_by",
      "description": "provides routed_board needed here"
    },
    {
      "flow_name": "pcb-layout-metrics",
      "relationship": "feeds_into",
      "description": "outputs kicad_pcb consumed by pcb-layout-metrics"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "fed_by",
      "description": "provides board_spec needed here"
    },
    {
      "flow_name": "pcb-gerber-export",
      "relationship": "feeds_into",
      "description": "outputs drc_report, kicad_pcb consumed by pcb-gerber-export"
    }
  ]
}
