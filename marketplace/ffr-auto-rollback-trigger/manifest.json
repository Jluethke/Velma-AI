{
  "name": "ffr-auto-rollback-trigger",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "automated-rollback",
    "alertmanager",
    "webhook",
    "kill-switch"
  ],
  "inputs": [
    "rollout_plan",
    "guardrail_metrics",
    "provider_choice",
    "alerting_stack"
  ],
  "outputs": [
    "rollback_automation"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Route firing guardrail alerts to an off-only, allow-listed, idempotent flag rollback through the provider API or a flag trigger, and test it end to end.",
  "related_flows": [
    {
      "flow_name": "ffr-otel-flag-telemetry",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-guardrail-metrics",
      "relationship": "fed_by",
      "description": "provides guardrail_metrics needed here"
    },
    {
      "flow_name": "ffr-rollout-stage-plan",
      "relationship": "fed_by",
      "description": "provides rollout_plan needed here"
    },
    {
      "flow_name": "ffr-argo-rollouts-canary",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-flagger-canary",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-canary-mann-whitney-judge",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-kill-switch-drill",
      "relationship": "feeds_into",
      "description": "outputs rollback_automation consumed by ffr-kill-switch-drill"
    },
    {
      "flow_name": "ffr-provider-select",
      "relationship": "fed_by",
      "description": "provides provider_choice needed here"
    }
  ]
}
