{
  "name": "debt-payoff-strategist",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "debt",
    "payoff",
    "strategist"
  ],
  "inputs": [
    "debt_list",
    "debt_payoff_method",
    "emergency_fund_monthly_contribution",
    "monthly_surplus_deficit"
  ],
  "outputs": [
    "debt_payoff_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process debt_list, debt_payoff_method, emergency_fund_monthly_contribution to produce debt_payoff_plan.",
  "related_flows": [
    {
      "flow_name": "expense-analyzer",
      "relationship": "fed_by",
      "description": "provides monthly_surplus_deficit needed here"
    },
    {
      "flow_name": "zero-based-budget-builder",
      "relationship": "feeds_into",
      "description": "outputs debt_payoff_plan consumed by zero-based-budget-builder"
    },
    {
      "flow_name": "financial-timeline-report-generator",
      "relationship": "feeds_into",
      "description": "outputs debt_payoff_plan consumed by financial-timeline-report-generator"
    }
  ]
}
