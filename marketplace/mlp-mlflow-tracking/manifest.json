{
  "name": "mlp-mlflow-tracking",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "mlflow",
    "experiment-tracking"
  ],
  "inputs": [
    "repo_path",
    "tracking_uri",
    "experiment_name",
    "data_version",
    "sklearn_determinism",
    "torch_determinism"
  ],
  "outputs": [
    "mlflow_run_ref"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Sets up MLflow tracking with a SQLite or server backend and logs, for every training run, the git commit, DVC data hashes, seed and determinism record, params, per-fold and final metrics, and artifacts, so any number in a report traces to one run ID.",
  "related_flows": [
    {
      "flow_name": "mlp-sklearn-seed-determinism",
      "relationship": "fed_by",
      "description": "provides sklearn_determinism needed here"
    },
    {
      "flow_name": "mlp-baseline-models",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-sklearn-feature-pipeline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-optuna-search",
      "relationship": "feeds_into",
      "description": "outputs mlflow_run_ref consumed by mlp-optuna-search"
    },
    {
      "flow_name": "mlp-nested-cv-estimate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-bootstrap-metric-ci",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-paired-model-comparison",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-calibration-diagnose",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
