{
  "name": "mob-android-crash-reporting",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "mobile",
    "android",
    "crashlytics",
    "sentry",
    "r8",
    "retrace"
  ],
  "inputs": [
    "app_profile",
    "crash_backend"
  ],
  "outputs": [
    "android_crash_setup"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Wire Crashlytics or Sentry on Android, upload R8 mappings and native symbols, verify with retrace and a forced crash, and confirm ANR capture.",
  "related_flows": [
    {
      "flow_name": "mob-app-profile",
      "relationship": "fed_by",
      "description": "provides app_profile needed here"
    },
    {
      "flow_name": "mob-device-os-matrix",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "mob-android-play-release",
      "relationship": "feeds_into",
      "description": "outputs android_crash_setup consumed by mob-android-play-release"
    },
    {
      "flow_name": "mob-screen-state-machine",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mob-android-compose-screen",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mob-network-retry-policy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mob-android-okhttp-offline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mob-android-room-store",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
