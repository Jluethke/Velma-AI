{
  "name": "sigre-capture-plan-labeled-actions",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "reverse-engineering",
    "capture-plan",
    "test-design",
    "automotive"
  ],
  "inputs": [
    "capture_scope",
    "target_signals",
    "reference_source",
    "repetitions",
    "baseline_seconds"
  ],
  "outputs": [
    "capture_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a CAN capture plan of isolated, repeated, labeled actions with rest gaps and an actions.tsv marker file on the capture host clock.",
  "related_flows": [
    {
      "flow_name": "sigre-scope-owned-vehicle-readonly",
      "relationship": "fed_by",
      "description": "provides capture_scope needed here"
    },
    {
      "flow_name": "sigre-log-normalize-convert",
      "relationship": "feeds_into",
      "description": "outputs capture_plan consumed by sigre-log-normalize-convert"
    },
    {
      "flow_name": "sigre-baseline-idle-inventory",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sigre-linux-socketcan-listen-only-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sigre-linux-candump-capture",
      "relationship": "feeds_into",
      "description": "outputs capture_plan consumed by sigre-linux-candump-capture"
    },
    {
      "flow_name": "sigre-py-python-can-listen-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sigre-py-python-can-capture",
      "relationship": "feeds_into",
      "description": "outputs capture_plan consumed by sigre-py-python-can-capture"
    },
    {
      "flow_name": "sigre-linux-cansniffer-isolate",
      "relationship": "feeds_into",
      "description": "outputs capture_plan consumed by sigre-linux-cansniffer-isolate"
    }
  ]
}
