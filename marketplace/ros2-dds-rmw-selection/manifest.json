{
  "name": "ros2-dds-rmw-selection",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ros2",
    "robotics",
    "dds",
    "rmw",
    "discovery",
    "networking"
  ],
  "inputs": [
    "ros_distro",
    "network_topology"
  ],
  "outputs": [
    "rmw_choice",
    "rmw_env"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Select one RMW implementation for every host from a decision table, set the RMW, domain and discovery environment consistently, and prove cross-host discovery.",
  "related_flows": [
    {
      "flow_name": "ros2-qos-profile-selection",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ros2-qos-incompatibility-debug",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ros2-fastdds-xml-tuning",
      "relationship": "feeds_into",
      "description": "outputs rmw_env consumed by ros2-fastdds-xml-tuning"
    },
    {
      "flow_name": "ros2-cyclonedds-xml-tuning",
      "relationship": "feeds_into",
      "description": "outputs rmw_env consumed by ros2-cyclonedds-xml-tuning"
    },
    {
      "flow_name": "ros2-doctor-introspection",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
