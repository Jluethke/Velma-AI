{
  "name": "prr-ts-static-checks",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "typescript",
    "tsc",
    "eslint",
    "static-analysis"
  ],
  "inputs": [
    "repo_dir",
    "base_branch",
    "changed_files",
    "findings_dir"
  ],
  "outputs": [
    "ts_static_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run tsc and ESLint with the repository config on PR head and merge base, keep only new diagnostics, confirm promise rules, and audit new type escapes.",
  "related_flows": [
    {
      "flow_name": "prr-self-review-before-request",
      "relationship": "fed_by",
      "description": "provides changed_files needed here"
    },
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides changed_files needed here"
    }
  ]
}
