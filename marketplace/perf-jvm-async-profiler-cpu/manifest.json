{
  "name": "perf-jvm-async-profiler-cpu",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "performance",
    "jvm",
    "java",
    "async-profiler",
    "flame-graph"
  ],
  "inputs": [
    "workload_spec",
    "repo_path"
  ],
  "outputs": [
    "jvm_cpu_profile"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Profile a warm JVM with async-profiler in CPU, itimer or wall mode without safepoint bias and read the HTML flame graph.",
  "related_flows": [
    {
      "flow_name": "perf-metric-workload-define",
      "relationship": "fed_by",
      "description": "provides workload_spec needed here"
    },
    {
      "flow_name": "perf-bench-env-stabilize",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-jvm-jmh-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-bench-baseline-normalize",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-flame-graph-read",
      "relationship": "feeds_into",
      "description": "outputs jvm_cpu_profile consumed by perf-flame-graph-read"
    },
    {
      "flow_name": "perf-hotspot-classify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-fix-algorithmic-complexity",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-jvm-alloc-profile",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
