{
  "name": "k8s-kustomize-overlays",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "kustomize",
    "overlays",
    "configmapgenerator"
  ],
  "inputs": [
    "packaging_choice",
    "manifest_layout",
    "rollout_deployment",
    "pdb_manifest",
    "service_manifest",
    "ingress_manifest",
    "config_manifests",
    "hpa_manifest",
    "network_policies",
    "namespace_manifest",
    "environments"
  ],
  "outputs": [
    "kustomize_dir",
    "kustomize_rendered_manifests"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a Kustomize base and per-environment overlays that change only listed fields, and prove each build matches the verified manifests.",
  "related_flows": [
    {
      "flow_name": "k8s-helm-vs-kustomize-decision",
      "relationship": "fed_by",
      "description": "provides packaging_choice, manifest_layout needed here"
    },
    {
      "flow_name": "k8s-helm-chart-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-kubeconform-validate",
      "relationship": "feeds_into",
      "description": "outputs kustomize_rendered_manifests consumed by k8s-kubeconform-validate"
    },
    {
      "flow_name": "k8s-kube-linter-check",
      "relationship": "feeds_into",
      "description": "outputs kustomize_rendered_manifests consumed by k8s-kube-linter-check"
    },
    {
      "flow_name": "k8s-argocd-application",
      "relationship": "feeds_into",
      "description": "outputs kustomize_dir consumed by k8s-argocd-application"
    },
    {
      "flow_name": "k8s-flux-kustomization",
      "relationship": "feeds_into",
      "description": "outputs kustomize_dir consumed by k8s-flux-kustomization"
    },
    {
      "flow_name": "k8s-rollout-status-watch",
      "relationship": "feeds_into",
      "description": "outputs kustomize_rendered_manifests consumed by k8s-rollout-status-watch"
    },
    {
      "flow_name": "k8s-service-ingress-manifest",
      "relationship": "fed_by",
      "description": "provides service_manifest, ingress_manifest needed here"
    }
  ]
}
