{
  "name": "port-go-golden-replay",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "porting",
    "go",
    "table-driven-tests",
    "golden-tests",
    "replay"
  ],
  "inputs": [
    "target_repo",
    "golden_corpus",
    "corpus_schema"
  ],
  "outputs": [
    "go_replay_command"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a table-driven Go replay test over the golden corpus in testdata with uncached and race-detector commands.",
  "related_flows": [
    {
      "flow_name": "port-golden-corpus-schema",
      "relationship": "fed_by",
      "description": "provides corpus_schema needed here"
    },
    {
      "flow_name": "port-golden-corpus-freeze",
      "relationship": "fed_by",
      "description": "provides golden_corpus needed here"
    },
    {
      "flow_name": "port-porting-rulebook",
      "relationship": "feeds_into",
      "description": "outputs go_replay_command consumed by port-porting-rulebook"
    }
  ]
}
