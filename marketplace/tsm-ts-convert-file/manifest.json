{
  "name": "tsm-ts-convert-file",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "typescript",
    "conversion",
    "git-mv",
    "esm"
  ],
  "inputs": [
    "repo_path",
    "ts_conversion_order",
    "ts_declarations",
    "migration_profile"
  ],
  "outputs": [
    "ts_converted_files"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Convert JavaScript files to TypeScript one file per commit in leaf-first order, with zero new tsc errors and a passing test run after each file.",
  "related_flows": [
    {
      "flow_name": "tsm-migration-intake",
      "relationship": "fed_by",
      "description": "provides migration_profile needed here"
    },
    {
      "flow_name": "tsm-ts-error-baseline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-type-coverage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-conversion-order",
      "relationship": "fed_by",
      "description": "provides ts_conversion_order needed here"
    },
    {
      "flow_name": "tsm-ts-allowjs-checkjs",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-declaration-files",
      "relationship": "fed_by",
      "description": "provides ts_declarations needed here"
    },
    {
      "flow_name": "tsm-ts-noimplicitany",
      "relationship": "feeds_into",
      "description": "outputs ts_converted_files consumed by tsm-ts-noimplicitany"
    },
    {
      "flow_name": "tsm-ts-strictnullchecks",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
