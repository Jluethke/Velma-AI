{
  "name": "k8s-py-health-endpoints",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "python",
    "probes",
    "fastapi",
    "django",
    "gunicorn"
  ],
  "inputs": [
    "repo_dir",
    "workload_profile"
  ],
  "outputs": [
    "py_health_endpoints"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Add liveness and readiness endpoints to a FastAPI, Flask or Django service, fix the Django ALLOWED_HOSTS probe trap, and prove a clean SIGTERM exit.",
  "related_flows": [
    {
      "flow_name": "k8s-workload-inventory",
      "relationship": "fed_by",
      "description": "provides workload_profile needed here"
    },
    {
      "flow_name": "k8s-node-health-endpoints",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-go-health-endpoints",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-jvm-health-endpoints",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-probe-tuning",
      "relationship": "feeds_into",
      "description": "outputs py_health_endpoints consumed by k8s-probe-tuning"
    },
    {
      "flow_name": "k8s-rollout-status-watch",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-rolling-update-pdb",
      "relationship": "feeds_into",
      "description": "outputs py_health_endpoints consumed by k8s-rolling-update-pdb"
    }
  ]
}
