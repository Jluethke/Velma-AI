    },
    {
      "flow_name": "ctrl-path-spline-smoothing",
      "relationship": "fed_by",
      "description": "provides reference_path needed here"
    },
    {
      "flow_name": "ctrl-actuator-rate-saturation",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "ctrl-closed-loop-sim-py",
      "relationship": "feeds_into",
      "description": "outputs reference_trajectory consumed by ctrl-closed-loop-sim-py"
    },
    {
      "flow_name": "ctrl-pure-pursuit",
      "relationship": "feeds_into",
      "description": "outputs reference_trajectory consumed by ctrl-pure-pursuit"
    },
    {
      "flow_name": "ctrl-stanley",
      "relationship": "feeds_into",
      "description": "outputs reference_trajectory consumed by ctrl-stanley"
    }
  ]
