    "reference_trajectory"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a speed profile that respects user-supplied speed, lateral acceleration, acceleration and jerk limits with a forward-backward pass and a piecewise-jerk QP.",
  "related_flows": [
