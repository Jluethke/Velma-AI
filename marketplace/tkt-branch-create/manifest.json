{
  "name": "tkt-branch-create",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "git",
    "branching",
    "naming",
    "workflow"
  ],
  "inputs": [
    "ticket_id",
    "working_requirements",
    "repo_profile",
    "base_branch"
  ],
  "outputs": [
    "branch_name"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Create a topic branch named by repo convention from the freshly fetched base tip, validated with git check-ref-format.",
  "related_flows": [
    {
      "flow_name": "tkt-ticket-ambiguity-extract",
      "relationship": "fed_by",
      "description": "provides working_requirements needed here"
    },
    {
      "flow_name": "tkt-acceptance-criteria-gwt",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tkt-repo-orient-detect",
      "relationship": "fed_by",
      "description": "provides repo_profile needed here"
    },
    {
      "flow_name": "tkt-rg-call-trace",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tkt-lsp-reference-trace",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tkt-change-impact-list",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tkt-test-level-choose",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tkt-failing-test-first",
      "relationship": "feeds_into",
      "description": "outputs branch_name consumed by tkt-failing-test-first"
    }
  ]
}
