{
  "name": "can-detective",
  "version": "1.0.0",
  "domain": "automotive",
  "tags": [
    "can-bus",
    "traffic-analysis",
    "intermittent",
    "diagnostics",
    "signals"
  ],
  "inputs": [
    "baseline",
    "vehicle",
    "symptom",
    "bus"
  ],
  "outputs": [
    "traffic_diff",
    "anomaly_list",
    "signal_forensics",
    "suspect_modules"
  ],
  "execution_pattern": "linear",
  "price": "0",
  "license": "PRIVATE",
  "description": "CAN bus traffic forensics for intermittent vehicle problems. Records a baseline capture, compares it to a live session, identifies frames that changed frequency, new or missing arbitration IDs, payload bit drift, and timing jitter. Maps anomalies back to the originating ECU module.",
