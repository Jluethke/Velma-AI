{
  "name": "rel-go-verify-install",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "go",
    "go-get",
    "install-verification",
    "sumdb"
  ],
  "inputs": [
    "go_module_version_check",
    "release_tag"
  ],
  "outputs": [
    "go_install_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Fetch the just-published Go module version through the public proxy into a fresh module with checksum database verification on, and prove it builds and installs.",
  "related_flows": [
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "fed_by",
      "description": "provides release_tag needed here"
    },
    {
      "flow_name": "rel-go-publish-module-proxy",
      "relationship": "fed_by",
      "description": "provides go_module_version_check needed here"
    },
    {
      "flow_name": "rel-yank-bad-release",
      "relationship": "feeds_into",
      "description": "outputs go_install_report consumed by rel-yank-bad-release"
    }
  ]
}
