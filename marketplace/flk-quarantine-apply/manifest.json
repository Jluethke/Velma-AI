{
    "name": "flk-quarantine-apply",
    "version": "1.0.0",
    "domain": "engineering",
    "tags": [
        "flaky-tests",
        "quarantine",
        "ci",
        "policy"
    ],
    "inputs": [
        "flake_evidence",
        "flake_class",
        "baseline_rate",
        "stack",
        "repo_path",
        "quarantine_owner",
        "quarantine_expiry",
        "quarantine_now"
    ],
    "outputs": [
        "quarantine_record"
    ],
    "execution_pattern": "phase_pipeline",
    "price": "0",
    "license": "OPEN",
    "description": "Quarantine a confirmed flaky test so it keeps running in a non-blocking job, with an owner, a tracking issue and an expiry date."
}
