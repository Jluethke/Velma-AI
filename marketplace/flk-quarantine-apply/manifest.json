{
  "name": "flk-quarantine-apply",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "flaky-tests",
    "quarantine",
    "ci",
    "policy"
  ],
  "inputs": [
    "flake_evidence",
    "flake_class",
    "baseline_rate",
    "stack",
    "repo_path",
    "quarantine_owner",
    "quarantine_expiry",
    "quarantine_now"
  ],
  "outputs": [
    "quarantine_record"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Quarantine a confirmed flaky test so it keeps running in a non-blocking job, with an owner, a tracking issue and an expiry date.",
  "related_flows": [
    {
      "flow_name": "flk-flake-evidence-intake",
      "relationship": "fed_by",
      "description": "provides flake_evidence needed here"
    },
    {
      "flow_name": "flk-run-count-derive",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-py-repeat-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-node-jest-loop-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-go-count-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-classify-root-cause",
      "relationship": "fed_by",
      "description": "provides baseline_rate, flake_class needed here"
    },
    {
      "flow_name": "flk-verify-same-count",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-quarantine-release",
      "relationship": "feeds_into",
      "description": "outputs quarantine_record consumed by flk-quarantine-release"
    }
  ]
}
