{
  "name": "tsm-ts-error-baseline",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "typescript",
    "tsc",
    "baseline",
    "diagnostics"
  ],
  "inputs": [
    "repo_path",
    "migration_profile"
  ],
  "outputs": [
    "ts_error_baseline"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Capture the exact tsc error count per file and per TS error code under current and target strict settings as the migration baseline.",
  "related_flows": [
    {
      "flow_name": "tsm-migration-intake",
      "relationship": "fed_by",
      "description": "provides migration_profile needed here"
    },
    {
      "flow_name": "tsm-ts-type-coverage",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsm-ts-ci-gate",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsm-ts-noimplicitany",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-strictnullchecks",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-strict-family-flags",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-eliminate-any",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-conversion-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
