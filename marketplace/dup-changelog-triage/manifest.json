{
  "name": "dup-changelog-triage",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "changelog",
    "release-notes",
    "migration-guide",
    "breaking-changes"
  ],
  "inputs": [
    "upgrade_scope",
    "baseline_report"
  ],
  "outputs": [
    "breaking_changes"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Read every release note and migration guide between current and target versions, extract breaking changes and documented codemods, and grep the repo for each.",
  "related_flows": [
    {
      "flow_name": "dup-scope-intake",
      "relationship": "fed_by",
      "description": "provides upgrade_scope needed here"
    },
    {
      "flow_name": "dup-baseline-snapshot",
      "relationship": "fed_by",
      "description": "provides baseline_report needed here"
    },
    {
      "flow_name": "dup-upgrade-order-plan",
      "relationship": "feeds_into",
      "description": "outputs breaking_changes consumed by dup-upgrade-order-plan"
    },
    {
      "flow_name": "dup-rollback-plan",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dup-apply-one-bump",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dup-verify-and-pr",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dup-py-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "dup-node-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
