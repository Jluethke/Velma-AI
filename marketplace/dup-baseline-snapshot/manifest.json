{
  "name": "dup-baseline-snapshot",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "dependencies",
    "upgrade",
    "baseline",
    "testing",
    "deprecation"
  ],
  "inputs": [
    "upgrade_scope"
  ],
  "outputs": [
    "baseline_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Record the pre-upgrade commit, lockfile hashes, install, build and two test runs, collected test count and deprecation warning count as the baseline every later step is compared against.",
  "related_flows": [
    {
      "flow_name": "dup-scope-intake",
      "relationship": "fed_by",
      "description": "provides upgrade_scope needed here"
    },
    {
      "flow_name": "dup-py-lockfile-hygiene",
      "relationship": "feeds_into",
      "description": "outputs baseline_report consumed by dup-py-lockfile-hygiene"
    },
    {
      "flow_name": "dup-node-lockfile-hygiene",
      "relationship": "feeds_into",
      "description": "outputs baseline_report consumed by dup-node-lockfile-hygiene"
    },
    {
      "flow_name": "dup-changelog-triage",
      "relationship": "feeds_into",
      "description": "outputs baseline_report consumed by dup-changelog-triage"
    },
    {
      "flow_name": "dup-upgrade-order-plan",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dup-rollback-plan",
      "relationship": "feeds_into",
      "description": "outputs baseline_report consumed by dup-rollback-plan"
    },
    {
      "flow_name": "dup-apply-one-bump",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dup-verify-and-pr",
      "relationship": "feeds_into",
      "description": "outputs baseline_report consumed by dup-verify-and-pr"
    }
  ]
}
