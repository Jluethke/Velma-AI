{
    "name": "uic-component-ship-gate",
    "version": "1.0.0",
    "domain": "engineering",
    "tags": [
        "quality-gate",
        "ci",
        "frontend",
        "release",
        "verification"
    ],
    "inputs": [
        "repo_dir",
        "stack",
        "a11y_report",
        "visual_report",
        "size_report",
        "i18n_report",
        "component_docs"
    ],
    "outputs": [
        "ship_verdict"
    ],
    "execution_pattern": "phase_pipeline",
    "price": "0",
    "license": "OPEN",
    "description": "Rerun every component check from a clean install and issue a PASS or FAIL verdict backed only by fresh exit codes and named report fields."
}
