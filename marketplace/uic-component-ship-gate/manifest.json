{
  "name": "uic-component-ship-gate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "quality-gate",
    "ci",
    "frontend",
    "release",
    "verification"
  ],
  "inputs": [
    "repo_dir",
    "stack",
    "a11y_report",
    "visual_report",
    "size_report",
    "i18n_report",
    "component_docs"
  ],
  "outputs": [
    "ship_verdict"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Rerun every component check from a clean install and issue a PASS or FAIL verdict backed only by fresh exit codes and named report fields.",
  "related_flows": [
    {
      "flow_name": "uic-i18n-readiness",
      "relationship": "fed_by",
      "description": "provides i18n_report needed here"
    },
    {
      "flow_name": "uic-axe-a11y-check",
      "relationship": "fed_by",
      "description": "provides a11y_report needed here"
    },
    {
      "flow_name": "uic-visual-regression",
      "relationship": "fed_by",
      "description": "provides visual_report needed here"
    },
    {
      "flow_name": "uic-bundle-size-check",
      "relationship": "fed_by",
      "description": "provides size_report needed here"
    },
    {
      "flow_name": "uic-component-docs",
      "relationship": "fed_by",
      "description": "provides component_docs needed here"
    }
  ]
}
