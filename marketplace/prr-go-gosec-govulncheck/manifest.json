{
  "name": "prr-go-gosec-govulncheck",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "go",
    "security",
    "gosec",
    "govulncheck"
  ],
  "inputs": [
    "repo_dir",
    "base_branch",
    "changed_files",
    "findings_dir"
  ],
  "outputs": [
    "go_sast_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run gosec on changed Go packages and govulncheck on head and merge base to find new issues and newly reachable vulnerabilities, auditing nosec and replace directives.",
  "related_flows": [
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides changed_files needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-severity-comments",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-approval-decision",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-gh-post-review",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-glab-post-review",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
