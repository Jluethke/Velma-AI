{
  "name": "tsm-ts-type-coverage",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "typescript",
    "type-coverage",
    "metrics",
    "any"
  ],
  "inputs": [
    "repo_path",
    "migration_profile"
  ],
  "outputs": [
    "ts_type_coverage"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure the percentage of typed identifiers with the type-coverage CLI and list every remaining any location per file.",
  "related_flows": [
    {
      "flow_name": "tsm-migration-intake",
      "relationship": "fed_by",
      "description": "provides migration_profile needed here"
    },
    {
      "flow_name": "tsm-ts-error-baseline",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsm-ts-ci-gate",
      "relationship": "feeds_into",
      "description": "outputs ts_type_coverage consumed by tsm-ts-ci-gate"
    },
    {
      "flow_name": "tsm-ts-noimplicitany",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-strictnullchecks",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-strict-family-flags",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-eliminate-any",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-conversion-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
