{
  "name": "perc-onnx-export-verify",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "perception",
    "onnx",
    "export",
    "onnxruntime",
    "parity"
  ],
  "inputs": [
    "trained_checkpoint",
    "input_shape",
    "holdout_annotations"
  ],
  "outputs": [
    "onnx_model",
    "onnx_parity_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Export a PyTorch detector to ONNX with a fixed opset and input shape, validate the graph, and measure PyTorch to ONNX Runtime parity on real images.",
  "related_flows": [
    {
      "flow_name": "perc-preprocess-spec-extract",
      "relationship": "feeds_into",
      "description": "outputs onnx_model consumed by perc-preprocess-spec-extract"
    },
    {
      "flow_name": "perc-trtexec-fp16-engine",
      "relationship": "feeds_into",
      "description": "outputs onnx_model consumed by perc-trtexec-fp16-engine"
    },
    {
      "flow_name": "perc-int8-calibration-trt",
      "relationship": "feeds_into",
      "description": "outputs onnx_model consumed by perc-int8-calibration-trt"
    },
    {
      "flow_name": "perc-detection-map-eval",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "perc-model-select-pareto",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "perc-nsys-profile-pipeline",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "perc-e2e-latency-budget",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "perc-py-gpu-preprocess",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
