{
  "name": "stp-keep-or-revert-edit",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "revert",
    "git-restore",
    "checkpoint",
    "small-model"
  ],
  "inputs": [
    "verify_result",
    "applied_edit",
    "py_error_diagnosis",
    "node_error_diagnosis",
    "go_error_diagnosis",
    "rust_error_diagnosis",
    "java_error_diagnosis",
    "baseline_report",
    "start_commit",
    "scratch_log",
    "repo_path"
  ],
  "outputs": [
    "edit_outcome"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Keep the edit by staging it as the new checkpoint or revert it from the index by a fixed table, never fixing forward.",
  "related_flows": [
    {
      "flow_name": "stp-apply-one-edit",
      "relationship": "fed_by",
      "description": "provides applied_edit needed here"
    },
    {
      "flow_name": "stp-run-verify-capture",
      "relationship": "fed_by",
      "description": "provides verify_result needed here"
    },
    {
      "flow_name": "stp-test-integrity-guard",
      "relationship": "feeds_into",
      "description": "outputs edit_outcome consumed by stp-test-integrity-guard"
    },
    {
      "flow_name": "stp-stop-or-continue",
      "relationship": "feeds_into",
      "description": "outputs edit_outcome consumed by stp-stop-or-continue"
    },
    {
      "flow_name": "stp-final-evidence-report",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "stp-goal-to-runnable-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "stp-scratch-log-start",
      "relationship": "fed_by",
      "description": "provides scratch_log, start_commit needed here"
    },
    {
      "flow_name": "stp-baseline-capture",
      "relationship": "fed_by",
      "description": "provides baseline_report needed here"
    }
  ]
}
