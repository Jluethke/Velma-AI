{
  "name": "tsp-baseline-lock",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "testing",
    "performance",
    "baseline",
    "hyperfine",
    "coverage"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "test_command",
    "run_count"
  ],
  "outputs": [
    "baseline_report",
    "coverage_baseline"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Record a repeatable test suite baseline of wall time over repeated hyperfine runs, test count, pass state and covered-line counts before any speed change.",
  "related_flows": [
    {
      "flow_name": "tsp-coverage-parity-gate",
      "relationship": "feeds_into",
      "description": "outputs baseline_report, coverage_baseline consumed by tsp-coverage-parity-gate"
    },
    {
      "flow_name": "tsp-speedup-report",
      "relationship": "feeds_into",
      "description": "outputs baseline_report consumed by tsp-speedup-report"
    },
    {
      "flow_name": "tsp-hotspot-classify",
      "relationship": "feeds_into",
      "description": "outputs baseline_report consumed by tsp-hotspot-classify"
    },
    {
      "flow_name": "tsp-pg-template-clone",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "tsp-pyramid-inventory",
      "relationship": "feeds_into",
      "description": "outputs baseline_report consumed by tsp-pyramid-inventory"
    },
    {
      "flow_name": "tsp-pyramid-push-down",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsp-order-isolation-check",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsp-py-durations-report",
      "relationship": "feeds_into",
      "description": "outputs baseline_report consumed by tsp-py-durations-report"
    }
  ]
}
