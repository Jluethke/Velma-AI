{
  "name": "dup-py-vuln-scan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "python",
    "security",
    "pip-audit",
    "vulnerabilities"
  ],
  "inputs": [
    "upgrade_scope",
    "lockfile_status"
  ],
  "outputs": [
    "vuln_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Scan the locked Python dependency set with pip-audit and record each advisory with its smallest fixing version, no-fix status or user-accepted exception.",
  "related_flows": [
    {
      "flow_name": "dup-scope-intake",
      "relationship": "fed_by",
      "description": "provides upgrade_scope needed here"
    },
    {
      "flow_name": "dup-baseline-snapshot",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "dup-py-lockfile-hygiene",
      "relationship": "fed_by",
      "description": "provides lockfile_status needed here"
    },
    {
      "flow_name": "dup-changelog-triage",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "dup-upgrade-order-plan",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "dup-rollback-plan",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "dup-apply-one-bump",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "dup-verify-and-pr",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
