{
  "name": "ci0-clean-room-command-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ci",
    "docker",
    "reproducibility",
    "verification"
  ],
  "inputs": [
    "repo_dir",
    "py_ci_commands",
    "node_ci_commands",
    "go_ci_commands",
    "jvm_ci_commands",
    "runner_image"
  ],
  "outputs": [
    "verified_commands",
    "junit_report_globs"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run a stack's CI commands cold in a fresh container and fresh clone so machine-specific dependencies are caught before they enter CI config.",
  "related_flows": [
    {
      "flow_name": "ci0-detect-stack",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "ci0-py-ci-commands",
      "relationship": "fed_by",
      "description": "provides py_ci_commands needed here"
    },
    {
      "flow_name": "ci0-node-ci-commands",
      "relationship": "fed_by",
      "description": "provides node_ci_commands needed here"
    },
    {
      "flow_name": "ci0-go-ci-commands",
      "relationship": "fed_by",
      "description": "provides go_ci_commands needed here"
    },
    {
      "flow_name": "ci0-jvm-ci-commands",
      "relationship": "fed_by",
      "description": "provides jvm_ci_commands needed here"
    },
    {
      "flow_name": "ci0-gha-workflow-baseline",
      "relationship": "feeds_into",
      "description": "outputs verified_commands consumed by ci0-gha-workflow-baseline"
    },
    {
      "flow_name": "ci0-gha-dependency-cache",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ci0-gha-test-matrix",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
