{
  "name": "e2e-node-pw-setup",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "e2e",
    "playwright",
    "typescript",
    "node",
    "setup"
  ],
  "inputs": [
    "repo_dir",
    "app_url",
    "runner_decision",
    "start_command"
  ],
  "outputs": [
    "pw_node_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Install Playwright Test for Node, write a playwright.config.ts with each key set on purpose, and prove it with a smoke spec seen to pass and fail.",
  "related_flows": [
    {
      "flow_name": "e2e-journey-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-runner-select",
      "relationship": "fed_by",
      "description": "provides runner_decision needed here"
    },
    {
      "flow_name": "e2e-selector-policy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-node-pw-fixtures-pom",
      "relationship": "feeds_into",
      "description": "outputs pw_node_config consumed by e2e-node-pw-fixtures-pom"
    },
    {
      "flow_name": "e2e-node-pw-data-seed",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-node-pw-auth-state",
      "relationship": "feeds_into",
      "description": "outputs pw_node_config consumed by e2e-node-pw-auth-state"
    },
    {
      "flow_name": "e2e-mock-vs-real-decide",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-pw-network-mock",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
