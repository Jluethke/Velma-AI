{
    "name": "k8s-rollout-status-watch",
    "version": "1.0.0",
    "domain": "engineering",
    "tags": [
        "kubernetes",
        "kubectl",
        "rollout",
        "server-side-apply"
    ],
    "inputs": [
        "cluster_context",
        "namespace",
        "app_name",
        "lint_report",
        "helm_rendered_manifests",
        "kustomize_rendered_manifests",
        "argocd_application",
        "flux_resources",
        "gitops_tool",
        "change_cause"
    ],
    "outputs": [
        "rollout_result",
        "deployed_revision"
    ],
    "execution_pattern": "phase_pipeline",
    "price": "0",
    "license": "OPEN",
    "description": "Apply or confirm sync, record a change cause, watch kubectl rollout status with a deadline-based timeout, and classify the result from Deployment conditions."
}
