{
  "name": "rel-py-reproducible-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "python",
    "reproducible-builds",
    "source-date-epoch",
    "wheel"
  ],
  "inputs": [
    "repo_path",
    "release_tag"
  ],
  "outputs": [
    "py_dist",
    "py_repro_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a Python sdist and wheel twice from the release tag with SOURCE_DATE_EPOCH pinned and prove the artifacts are bit-identical.",
  "related_flows": [
    {
      "flow_name": "rel-commit-history-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-py-api-break-griffe",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-semver-bump-decision",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-changelog-git-cliff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "fed_by",
      "description": "provides release_tag needed here"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "feeds_into",
      "description": "outputs py_dist consumed by rel-slsa-provenance-attest"
    },
    {
      "flow_name": "rel-py-publish-pypi-trusted",
      "relationship": "feeds_into",
      "description": "outputs py_dist consumed by rel-py-publish-pypi-trusted"
    },
    {
      "flow_name": "rel-py-verify-install",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
