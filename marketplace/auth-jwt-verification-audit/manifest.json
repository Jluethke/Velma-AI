    },
    {
      "flow_name": "auth-oauth-pkce-authorization-code",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "auth-oidc-id-token-validation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "auth-refresh-token-rotation",
      "relationship": "feeds_into",
      "description": "outputs jwt_findings consumed by auth-refresh-token-rotation"
    },
    {
      "flow_name": "auth-py-cookie-flags-hardening",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "auth-node-cookie-flags-hardening",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "auth-session-fixation-logout",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "auth-rbac-vs-abac-decision",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
