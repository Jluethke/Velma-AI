{
  "name": "auth-jwt-verification-audit",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "authentication",
    "jwt",
    "rfc8725",
    "algorithm-confusion",
    "security-audit"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "auth_mechanism_decision"
  ],
  "outputs": [
    "jwt_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Audit JWT sign and verify sites for RFC 8725 failure classes such as governance engine none, algorithm confusion and missing claim checks, and prove fixes with forged-token tests.",
  "related_flows": [
