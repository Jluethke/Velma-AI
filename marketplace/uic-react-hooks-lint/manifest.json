{
  "name": "uic-react-hooks-lint",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "react",
    "hooks",
    "eslint",
    "exhaustive-deps",
    "lint"
  ],
  "inputs": [
    "repo_dir",
    "component_path",
    "react_build_report"
  ],
  "outputs": [
    "hooks_lint_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run eslint-plugin-react-hooks on one component and fix every rules-of-hooks and exhaustive-deps finding from a decision table without suppressions.",
  "related_flows": [
    {
      "flow_name": "uic-props-state-events-contract",
      "relationship": "fed_by",
      "description": "provides component_path needed here"
    },
    {
      "flow_name": "uic-controlled-uncontrolled-decision",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-styling-approach-decision",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-aria-pattern-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-react-component-build",
      "relationship": "fed_by",
      "description": "provides react_build_report needed here"
    },
    {
      "flow_name": "uic-react-effect-cleanup",
      "relationship": "feeds_into",
      "description": "outputs hooks_lint_report consumed by uic-react-effect-cleanup"
    },
    {
      "flow_name": "uic-react-memo-profile",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-keyboard-handler-implement",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
