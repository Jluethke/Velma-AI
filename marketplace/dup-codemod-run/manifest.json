{
  "name": "dup-codemod-run",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "codemod",
    "openrewrite",
    "jscodeshift",
    "django-upgrade",
    "migration"
  ],
  "inputs": [
    "upgrade_scope",
    "upgrade_plan",
    "breaking_changes",
    "applied_bumps"
  ],
  "outputs": [
    "codemod_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Apply a documented framework or library codemod for one planned major: dry run, apply on a clean tree, commit the mechanical change separately and fix leftovers by hand.",
  "related_flows": [
    {
      "flow_name": "dup-scope-intake",
      "relationship": "fed_by",
      "description": "provides upgrade_scope needed here"
    },
    {
      "flow_name": "dup-baseline-snapshot",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "dup-changelog-triage",
      "relationship": "fed_by",
      "description": "provides breaking_changes needed here"
    },
    {
      "flow_name": "dup-upgrade-order-plan",
      "relationship": "fed_by",
      "description": "provides upgrade_plan needed here"
    },
    {
      "flow_name": "dup-rollback-plan",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "dup-apply-one-bump",
      "relationship": "fed_by",
      "description": "provides applied_bumps needed here"
    },
    {
      "flow_name": "dup-verify-and-pr",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "dup-py-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
