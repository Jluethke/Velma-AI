{
  "name": "data-sampler-with-pii-detection",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "data",
    "sampler",
    "with"
  ],
  "inputs": [
    "column_metadata",
    "connection_status",
    "sampling_config"
  ],
  "outputs": [
    "data_quality_notes",
    "pii_flags",
    "sample_values"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process column_metadata, connection_status, sampling_config to produce data_quality_notes, pii_flags, sample_values.",
  "related_flows": [
    {
      "flow_name": "database-connection-validator",
      "relationship": "fed_by",
      "description": "provides connection_status needed here"
    },
    {
      "flow_name": "schema-metadata-extractor",
      "relationship": "fed_by",
      "description": "provides column_metadata needed here"
    },
    {
      "flow_name": "data-dictionary-compiler",
      "relationship": "feeds_into",
      "description": "outputs pii_flags, sample_values, data_quality_notes consumed by data-dictionary-compiler"
    },
    {
      "flow_name": "dictionary-validator",
      "relationship": "feeds_into",
      "description": "outputs pii_flags consumed by dictionary-validator"
    }
  ]
}
