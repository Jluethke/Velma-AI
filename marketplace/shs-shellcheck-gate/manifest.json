{
  "name": "shs-shellcheck-gate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "shellcheck",
    "lint",
    "static-analysis",
    "bash",
    "posix-sh"
  ],
  "inputs": [
    "script_path",
    "shell_dialect"
  ],
  "outputs": [
    "shellcheck_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run ShellCheck at a pinned version with a committed .shellcheckrc, fix findings code by code, and end with exit 0 at the chosen severity.",
  "related_flows": [
    {
      "flow_name": "shs-bash-vs-posix-decision",
      "relationship": "fed_by",
      "description": "provides shell_dialect needed here"
    },
    {
      "flow_name": "shs-ci-shell-matrix",
      "relationship": "feeds_into",
      "description": "outputs shellcheck_report consumed by shs-ci-shell-matrix"
    },
    {
      "flow_name": "shs-posix-sh-skeleton",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "shs-bash-errexit-pitfalls",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "shs-posix-bashism-removal",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "shs-quoting-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "shs-safe-filename-iteration",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "shs-mktemp-trap-cleanup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
