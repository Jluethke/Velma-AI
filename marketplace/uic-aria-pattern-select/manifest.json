    },
    {
      "flow_name": "uic-styling-approach-decision",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "uic-axe-a11y-check",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "uic-react-component-build",
      "relationship": "feeds_into",
      "description": "outputs aria_spec consumed by uic-react-component-build"
    },
    {
      "flow_name": "uic-vue-composition-component",
