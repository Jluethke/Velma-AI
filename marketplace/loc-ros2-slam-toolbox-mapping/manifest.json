    "ros2",
    "slam_toolbox",
    "mapping"
  ],
  "inputs": [
    "lidar_slam_choice",
    "sensor_bag",
    "frame_spec",
    "project_dir"
  ],
  "outputs": [
    "map_files"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
