    },
    {
      "flow_name": "loc-rosbag2-drive-logging",
      "relationship": "fed_by",
      "description": "provides sensor_bag needed here"
    },
    {
      "flow_name": "loc-lidar-slam-selection",
      "relationship": "fed_by",
      "description": "provides lidar_slam_choice needed here"
    },
    {
      "flow_name": "loc-kiss-icp-lidar-odometry",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "loc-ros2-map-relocalization",
      "relationship": "feeds_into",
      "description": "outputs map_files consumed by loc-ros2-map-relocalization"
    }
  ]
