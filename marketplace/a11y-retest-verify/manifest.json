{
  "name": "a11y-retest-verify",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "retest",
    "verification",
    "regression",
    "wcag"
  ],
  "inputs": [
    "ranked_issues",
    "react_fix_log",
    "vue_fix_log",
    "angular_fix_log",
    "html_fix_log",
    "site_url"
  ],
  "outputs": [
    "retest_results"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Re-tests every ranked issue with the same tool, browser, assistive technology and steps that found it, re-runs the full automated scans to catch regressions, and classifies each issue as fixed, still failing, partially fixed or regressed, with evidence that matches the original finding.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-axe-playwright-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-scan-merge-dedupe",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "fed_by",
      "description": "provides ranked_issues needed here"
    },
    {
      "flow_name": "a11y-fix-plan-by-criterion",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-react-fix-and-test",
      "relationship": "fed_by",
      "description": "provides react_fix_log needed here"
    },
    {
      "flow_name": "a11y-ci-regression-gate",
      "relationship": "feeds_into",
      "description": "outputs retest_results consumed by a11y-ci-regression-gate"
    },
    {
      "flow_name": "a11y-vue-fix-and-test",
      "relationship": "fed_by",
      "description": "provides vue_fix_log needed here"
    }
  ]
}
