{
  "name": "mlp-model-card",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "model-card",
    "documentation",
    "reporting"
  ],
  "inputs": [
    "problem_frame",
    "data_version",
    "metric_ci",
    "comparison_result",
    "slice_report",
    "calibration_report",
    "parity_report",
    "sklearn_model_package",
    "onnx_model_package"
  ],
  "outputs": [
    "model_card"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Writes `MODEL_CARD.md` using the sections of Mitchell et al. (2019), \"Model Cards for Model Reporting\", where every number links to the artifact or tracker run that produced it, including the test interval, slice results, calibration and parity status.",
  "related_flows": [
    {
      "flow_name": "mlp-bootstrap-metric-ci",
      "relationship": "fed_by",
      "description": "provides metric_ci needed here"
    },
    {
      "flow_name": "mlp-paired-model-comparison",
      "relationship": "fed_by",
      "description": "provides comparison_result needed here"
    },
    {
      "flow_name": "mlp-slice-error-analysis",
      "relationship": "fed_by",
      "description": "provides slice_report needed here"
    },
    {
      "flow_name": "mlp-calibration-diagnose",
      "relationship": "fed_by",
      "description": "provides calibration_report needed here"
    },
    {
      "flow_name": "mlp-frame-problem-metric",
      "relationship": "fed_by",
      "description": "provides problem_frame needed here"
    },
    {
      "flow_name": "mlp-dvc-version-raw-data",
      "relationship": "fed_by",
      "description": "provides data_version needed here"
    },
    {
      "flow_name": "mlp-sklearn-mlflow-model-package",
      "relationship": "fed_by",
      "description": "provides sklearn_model_package needed here"
    },
    {
      "flow_name": "mlp-torch-onnx-export",
      "relationship": "fed_by",
      "description": "provides onnx_model_package needed here"
    }
  ]
}
