    },
    {
      "flow_name": "etl-source-profile-sql",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "etl-source-key-watermark-discovery",
      "relationship": "fed_by",
      "description": "provides extraction_keys needed here"
    },
    {
      "flow_name": "etl-target-schema-contract",
      "relationship": "fed_by",
      "description": "provides data_contract needed here"
    },
    {
      "flow_name": "etl-schema-drift-snapshot-diff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "etl-extract-watermark-incremental",
