      "description": "outputs late_data_policy consumed by etl-extract-watermark-incremental"
    },
    {
      "flow_name": "etl-load-upsert-postgres",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "etl-load-merge-snowflake",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
