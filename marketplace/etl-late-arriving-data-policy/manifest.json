{
  "name": "etl-late-arriving-data-policy",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "etl",
    "late-data",
    "lookback",
    "event-time"
  ],
  "inputs": [
    "source_connection",
    "data_contract",
    "extraction_keys"
  ],
  "outputs": [
    "lateness_profile",
    "late_data_policy"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
