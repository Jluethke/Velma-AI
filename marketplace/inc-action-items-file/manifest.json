{
  "name": "inc-action-items-file",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "incident-response",
    "action-items",
    "github-issues",
    "jira",
    "postmortem"
  ],
  "inputs": [
    "postmortem_doc",
    "issue_tracker",
    "tracker_project"
  ],
  "outputs": [
    "action_items"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "File postmortem actions as GitHub or Jira tickets with one owner, type, priority, due date and checkable done condition, labeled by incident ID.",
  "related_flows": [
    {
      "flow_name": "inc-declare-resolved",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-postmortem-blameless",
      "relationship": "fed_by",
      "description": "provides postmortem_doc needed here"
    },
    {
      "flow_name": "inc-follow-up-review",
      "relationship": "feeds_into",
      "description": "outputs action_items consumed by inc-follow-up-review"
    }
  ]
}
