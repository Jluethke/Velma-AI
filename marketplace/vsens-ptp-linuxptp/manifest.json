      "description": "outputs ptp_sync_report consumed by vsens-pps-chrony"
    },
    {
      "flow_name": "vsens-ros2-stamp-latency",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-camera-led-latency",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-integration-acceptance",
      "relationship": "feeds_into",
      "description": "outputs ptp_sync_report consumed by vsens-integration-acceptance"
    }
  ]
