{
  "name": "mlp-split-integrity-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "pytest",
    "split",
    "leakage"
  ],
  "inputs": [
    "random_split",
    "time_split",
    "group_split",
    "data_version",
    "split_strategy"
  ],
  "outputs": [
    "split_manifest",
    "split_violations"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Runs a pytest suite against the saved split file that proves rows are disjoint, groups never cross splits, time windows are ordered with the label gap, and duplicates do not straddle train and test, then publishes the single `split_manifest` every later step reads.",
  "related_flows": [
    {
      "flow_name": "mlp-frame-problem-metric",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-dvc-version-raw-data",
      "relationship": "fed_by",
      "description": "provides data_version needed here"
    },
    {
      "flow_name": "mlp-leakage-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-split-random-stratified",
      "relationship": "fed_by",
      "description": "provides random_split needed here"
    },
    {
      "flow_name": "mlp-split-time-based",
      "relationship": "fed_by",
      "description": "provides time_split needed here"
    },
    {
      "flow_name": "mlp-split-grouped",
      "relationship": "fed_by",
      "description": "provides group_split needed here"
    },
    {
      "flow_name": "mlp-dvc-pipeline-stages",
      "relationship": "feeds_into",
      "description": "outputs split_manifest consumed by mlp-dvc-pipeline-stages"
    },
    {
      "flow_name": "mlp-baseline-models",
      "relationship": "feeds_into",
      "description": "outputs split_manifest consumed by mlp-baseline-models"
    }
  ]
}
