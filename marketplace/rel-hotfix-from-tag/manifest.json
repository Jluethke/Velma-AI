{
    "name": "rel-hotfix-from-tag",
    "version": "1.0.0",
    "domain": "engineering",
    "tags": [
        "release",
        "hotfix",
        "cherry-pick",
        "backport",
        "maintenance-branch"
    ],
    "inputs": [
        "repo_path",
        "branching_model",
        "bad_version",
        "fix_commit",
        "withdrawal_actions"
    ],
    "outputs": [
        "hotfix_branch",
        "hotfix_version"
    ],
    "execution_pattern": "phase_pipeline",
    "price": "0",
    "license": "OPEN",
    "description": "Produce a patch release for a released line by cherry-picking a tested fix onto a branch cut from the release tag, and confirm the fix also exists on the main branch."
}
