{
  "name": "rel-hotfix-from-tag",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "hotfix",
    "cherry-pick",
    "backport",
    "maintenance-branch"
  ],
  "inputs": [
    "repo_path",
    "branching_model",
    "bad_version",
    "fix_commit",
    "withdrawal_actions"
  ],
  "outputs": [
    "hotfix_branch",
    "hotfix_version"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Produce a patch release for a released line by cherry-picking a tested fix onto a branch cut from the release tag, and confirm the fix also exists on the main branch.",
  "related_flows": [
    {
      "flow_name": "rel-changelog-git-cliff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-yank-bad-release",
      "relationship": "fed_by",
      "description": "provides withdrawal_actions needed here"
    },
    {
      "flow_name": "rel-branching-model-select",
      "relationship": "fed_by",
      "description": "provides branching_model needed here"
    }
  ]
}
