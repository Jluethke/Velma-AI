    },
    {
      "flow_name": "obs-otel-collector-pipeline",
      "relationship": "feeds_into",
      "description": "outputs signal_plan consumed by obs-otel-collector-pipeline"
    },
    {
      "flow_name": "obs-prometheus-scrape-config",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "obs-red-metrics-spec",
      "relationship": "feeds_into",
      "description": "outputs signal_plan consumed by obs-red-metrics-spec"
    },
    {
      "flow_name": "obs-histogram-bucket-design",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "obs-signal-emission-verify",
      "relationship": "feeds_into",
      "description": "outputs signal_plan consumed by obs-signal-emission-verify"
    },
    {
      "flow_name": "obs-log-level-policy",
      "relationship": "feeds_into",
      "description": "outputs signal_plan consumed by obs-log-level-policy"
    },
    {
      "flow_name": "obs-py-structlog-correlation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
