{
  "name": "obs-signal-inventory",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "observability",
    "red-method",
    "use-method",
    "inventory",
    "telemetry"
  ],
  "inputs": [
    "service_repo",
    "stack",
    "service_name"
  ],
  "outputs": [
    "signal_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Inventory a service's entrypoints, resources and existing telemetry libraries and classify each component for RED or USE signals.",
  "related_flows": [
    {
      "flow_name": "obs-py-otel-sdk-setup",
