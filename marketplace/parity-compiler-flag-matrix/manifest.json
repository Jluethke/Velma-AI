{
  "name": "parity-compiler-flag-matrix",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "parity",
    "compiler-matrix",
    "cmake-presets",
    "cpp"
  ],
  "inputs": [
    "port_repo",
    "fp_flags",
    "golden_manifest",
    "comparison_policy"
  ],
  "outputs": [
    "matrix_results"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build and run the parity harness across compilers, versions, optimization levels, and ISA targets with fixed floating-point flags, and read the failure pattern.",
  "related_flows": [
    {
      "flow_name": "parity-env-fingerprint",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "parity-fp-flag-baseline",
      "relationship": "fed_by",
      "description": "provides fp_flags needed here"
    },
    {
      "flow_name": "parity-libm-divergence",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "parity-cross-arch-aarch64",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "parity-golden-manifest-lock",
      "relationship": "fed_by",
      "description": "provides golden_manifest needed here"
    },
    {
      "flow_name": "parity-ulp-tolerance-policy",
      "relationship": "fed_by",
      "description": "provides comparison_policy needed here"
    },
    {
      "flow_name": "parity-report",
      "relationship": "feeds_into",
      "description": "outputs matrix_results consumed by parity-report"
    }
  ]
}
