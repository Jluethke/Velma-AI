{
  "name": "k8s-argocd-application",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "argocd",
    "gitops",
    "continuous-delivery"
  ],
  "inputs": [
    "chart_dir",
    "kustomize_dir",
    "gitops_repo_url",
    "namespace",
    "app_name",
    "lint_report"
  ],
  "outputs": [
    "argocd_application"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Register the chart or overlay as Argo CD Applications in a restricted AppProject with automated sync and prove Synced and Healthy.",
  "related_flows": [
    {
      "flow_name": "k8s-helm-vs-kustomize-decision",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-helm-chart-build",
      "relationship": "fed_by",
      "description": "provides chart_dir needed here"
    },
    {
      "flow_name": "k8s-kustomize-overlays",
      "relationship": "fed_by",
      "description": "provides kustomize_dir needed here"
    },
    {
      "flow_name": "k8s-kubeconform-validate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-kube-linter-check",
      "relationship": "fed_by",
      "description": "provides lint_report needed here"
    },
    {
      "flow_name": "k8s-flux-kustomization",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-rollout-status-watch",
      "relationship": "feeds_into",
      "description": "outputs argocd_application consumed by k8s-rollout-status-watch"
    }
  ]
}
