{
  "name": "prr-glab-post-review",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "gitlab",
    "glab",
    "discussions-api",
    "review"
  ],
  "inputs": [
    "repo_dir",
    "pr_number",
    "head_sha",
    "review_comments",
    "review_verdict",
    "verdict_rationale"
  ],
  "outputs": [
    "posted_review_url"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Post each comment as a positioned GitLab merge request discussion with glab api, add the summary note, approve only on APPROVE, and verify the threads.",
  "related_flows": [
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides head_sha needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-severity-comments",
      "relationship": "fed_by",
      "description": "provides review_comments needed here"
    },
    {
      "flow_name": "prr-approval-decision",
      "relationship": "fed_by",
      "description": "provides review_verdict, verdict_rationale needed here"
    },
    {
      "flow_name": "prr-gh-post-review",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-concurrency-pass",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
