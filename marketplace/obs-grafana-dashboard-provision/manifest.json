{
  "name": "obs-grafana-dashboard-provision",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "observability",
    "grafana",
    "dashboard",
    "provisioning",
    "promql"
  ],
  "inputs": [
    "red_metric_spec",
    "use_queries",
    "slo_spec",
    "grafana_url"
  ],
  "outputs": [
    "dashboard_json"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a service dashboard JSON with SLO, RED and USE rows using a datasource variable and rate_interval, provision it by file or HTTP API, and verify every panel query returns data.",
  "related_flows": [
    {
      "flow_name": "obs-red-metrics-spec",
      "relationship": "fed_by",
      "description": "provides red_metric_spec needed here"
    },
    {
      "flow_name": "obs-use-metrics-node-exporter",
      "relationship": "fed_by",
      "description": "provides use_queries needed here"
    },
    {
      "flow_name": "obs-slo-error-budget-define",
      "relationship": "fed_by",
      "description": "provides slo_spec needed here"
    },
    {
      "flow_name": "obs-signal-emission-verify",
      "relationship": "feeds_into",
      "description": "outputs dashboard_json consumed by obs-signal-emission-verify"
    }
  ]
}
