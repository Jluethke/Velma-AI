{
  "name": "cfg-triage-secret-findings",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "secret-scanning",
    "triage",
    "gitleaks",
    "trufflehog",
    "allowlist"
  ],
  "inputs": [
    "gitleaks_report",
    "trufflehog_report",
    "repo_path"
  ],
  "outputs": [
    "confirmed_leaks",
    "allowlist_changes"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Merge gitleaks and TruffleHog findings per credential, classify them with an ordered decision table, record exposure, and write narrow allowlists only for non-secrets.",
  "related_flows": [
    {
      "flow_name": "cfg-gitleaks-scan-history",
      "relationship": "fed_by",
      "description": "provides gitleaks_report needed here"
    },
    {
      "flow_name": "cfg-trufflehog-verify-secrets",
      "relationship": "fed_by",
      "description": "provides trufflehog_report needed here"
    },
    {
      "flow_name": "cfg-rotate-leaked-secret",
      "relationship": "feeds_into",
      "description": "outputs confirmed_leaks consumed by cfg-rotate-leaked-secret"
    },
    {
      "flow_name": "cfg-aws-access-key-rotation",
      "relationship": "feeds_into",
      "description": "outputs confirmed_leaks consumed by cfg-aws-access-key-rotation"
    },
    {
      "flow_name": "cfg-git-filter-repo-purge",
      "relationship": "feeds_into",
      "description": "outputs confirmed_leaks consumed by cfg-git-filter-repo-purge"
    },
    {
      "flow_name": "cfg-precommit-gitleaks-hook",
      "relationship": "feeds_into",
      "description": "outputs allowlist_changes consumed by cfg-precommit-gitleaks-hook"
    },
    {
      "flow_name": "cfg-ci-secret-scan-gate",
      "relationship": "feeds_into",
      "description": "outputs allowlist_changes consumed by cfg-ci-secret-scan-gate"
    }
  ]
}
