{
  "name": "trademark-international-search",
  "version": "1.0.0",
  "domain": "legal",
  "tags": [
    "trademark",
    "international",
    "tmview",
    "wipo",
    "madrid",
    "euipo",
    "ip-clearance"
  ],
  "fabric": false,
  "inputs": [
    "proposed_mark",
    "mark_variants",
    "trademark_classes",
    "jurisdictions_required"
  ],
  "outputs": [
    "tmview_eu_matches",
    "wipo_madrid_matches",
    "jurisdiction_specific_matches",
    "international_conflict_candidates"
  ],
  "execution_pattern": "linear",
  "price": "0",
  "license": "OPEN",
  "description": "Searches TMView (EU IPO), WIPO Global Brand Database (Madrid System), and jurisdiction-specific registries (UK IPO, Canadian IPO, IP Australia) for international marks that could conflict with a proposed US mark if the business operates cross-border.",
  "related_flows": [
    {
      "flow_name": "trademark-risk-report",
      "relationship": "feeds_into",
      "description": "outputs international_conflict_candidates consumed by trademark-risk-report"
    }
  ]
}
