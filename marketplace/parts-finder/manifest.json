{
  "name": "parts-finder",
  "version": "1.0.0",
  "domain": "automotive",
  "tags": [
    "parts",
    "oem",
    "aftermarket",
    "repair",
    "mopar"
  ],
  "inputs": [
    "vehicle",
    "dtc_or_symptom",
    "component"
  ],
  "outputs": [
    "component_id",
    "oem_parts",
    "aftermarket_options",
    "sourcing_plan",
    "install_notes"
  ],
  "execution_pattern": "linear",
  "price": "0",
  "license": "PRIVATE",
  "description": "Translates a DTC code or symptom into the exact component that needs replacement, provides OEM Mopar part numbers, compatible aftermarket alternatives, sourcing options with price ranges, and installation difficulty rating.",
  "related_flows": [
    {
      "flow_name": "vehicle-health",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "budget-builder",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "troubleshooter",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "can-detective",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "maintenance-schedule",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "home-status",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
