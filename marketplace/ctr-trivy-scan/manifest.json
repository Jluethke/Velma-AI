{
    "name": "ctr-trivy-scan",
    "version": "1.0.0",
    "domain": "engineering",
    "tags": [
        "containers",
        "security",
        "trivy",
        "vulnerabilities",
        "misconfiguration"
    ],
    "inputs": [
        "image_name",
        "project_dir",
        "severity_threshold"
    ],
    "outputs": [
        "trivy_report"
    ],
    "execution_pattern": "phase_pipeline",
    "price": "0",
    "license": "OPEN",
    "description": "Scan an image with Trivy for vulnerabilities, secrets and Dockerfile misconfigurations against the user's severity threshold."
}
