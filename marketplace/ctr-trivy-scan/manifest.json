{
  "name": "ctr-trivy-scan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "containers",
    "security",
    "trivy",
    "vulnerabilities",
    "misconfiguration"
  ],
  "inputs": [
    "image_name",
    "project_dir",
    "severity_threshold"
  ],
  "outputs": [
    "trivy_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Scan an image with Trivy for vulnerabilities, secrets and Dockerfile misconfigurations against the user's severity threshold.",
  "related_flows": [
    {
      "flow_name": "ctr-syft-sbom",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctr-grype-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctr-vuln-triage",
      "relationship": "feeds_into",
      "description": "outputs trivy_report consumed by ctr-vuln-triage"
    },
    {
      "flow_name": "ctr-reproducible-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
