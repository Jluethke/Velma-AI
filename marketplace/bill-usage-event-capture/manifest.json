{
  "name": "bill-usage-event-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "billing",
    "metering",
    "outbox",
    "idempotency",
    "postgresql"
  ],
  "inputs": [
    "meter_config",
    "database_url"
  ],
  "outputs": [
    "usage_outbox_schema",
    "capture_code"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Capture billable usage events in the application's database through a transactional outbox with a stable idempotency identifier per event.",
  "related_flows": [
    {
      "flow_name": "bill-stripe-meter-create",
      "relationship": "fed_by",
      "description": "provides meter_config needed here"
    },
    {
      "flow_name": "bill-py-usage-reporter",
      "relationship": "feeds_into",
      "description": "outputs usage_outbox_schema consumed by bill-py-usage-reporter"
    },
    {
      "flow_name": "bill-node-usage-reporter",
      "relationship": "feeds_into",
      "description": "outputs usage_outbox_schema consumed by bill-node-usage-reporter"
    },
    {
      "flow_name": "bill-usage-reconcile",
      "relationship": "feeds_into",
      "description": "outputs usage_outbox_schema consumed by bill-usage-reconcile"
    }
  ]
}
