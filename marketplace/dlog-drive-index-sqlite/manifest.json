{
  "name": "dlog-drive-index-sqlite",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "logging",
    "index",
    "sqlite",
    "search",
    "mcap"
  ],
  "inputs": [
    "archive_path",
    "run_manifest",
    "hash_manifest"
  ],
  "outputs": [
    "drive_index"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a SQLite index of archived drives from MCAP summaries and run manifests so drives, files and topics can be searched by time and content.",
  "related_flows": [
    {
      "flow_name": "dlog-log-validate-recover",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dlog-run-manifest",
      "relationship": "fed_by",
      "description": "provides run_manifest needed here"
    },
    {
      "flow_name": "dlog-file-integrity-hashes",
      "relationship": "fed_by",
      "description": "provides hash_manifest needed here"
    },
    {
      "flow_name": "dlog-offload-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dlog-camera-privacy-anonymize",
      "relationship": "feeds_into",
      "description": "outputs drive_index consumed by dlog-camera-privacy-anonymize"
    },
    {
      "flow_name": "dlog-test-case-extract",
      "relationship": "feeds_into",
      "description": "outputs drive_index consumed by dlog-test-case-extract"
    },
    {
      "flow_name": "dlog-ros2-bag-replay",
      "relationship": "feeds_into",
      "description": "outputs drive_index consumed by dlog-ros2-bag-replay"
    },
    {
      "flow_name": "dlog-py-replay-harness",
      "relationship": "feeds_into",
      "description": "outputs drive_index consumed by dlog-py-replay-harness"
    }
  ]
}
