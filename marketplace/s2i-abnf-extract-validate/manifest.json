{
  "name": "s2i-abnf-extract-validate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "spec",
    "abnf",
    "rfc5234",
    "grammar",
    "bap"
  ],
  "inputs": [
    "spec_bundle",
    "errata_log",
    "project_dir"
  ],
  "outputs": [
    "grammar_file",
    "grammar_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Extract all ABNF rules from the spec and its imports into one self-contained grammar validated by two ABNF checkers.",
  "related_flows": [
    {
      "flow_name": "s2i-spec-acquire-pin",
      "relationship": "fed_by",
      "description": "provides spec_bundle needed here"
    },
    {
      "flow_name": "s2i-errata-check",
      "relationship": "fed_by",
      "description": "provides errata_log needed here"
    },
    {
      "flow_name": "s2i-py-abnf-parser",
      "relationship": "feeds_into",
      "description": "outputs grammar_file consumed by s2i-py-abnf-parser"
    },
    {
      "flow_name": "s2i-node-abnf-parser",
      "relationship": "feeds_into",
      "description": "outputs grammar_file consumed by s2i-node-abnf-parser"
    },
    {
      "flow_name": "s2i-go-abnf-parser",
      "relationship": "feeds_into",
      "description": "outputs grammar_file consumed by s2i-go-abnf-parser"
    },
    {
      "flow_name": "s2i-rust-abnf-parser",
      "relationship": "feeds_into",
      "description": "outputs grammar_file consumed by s2i-rust-abnf-parser"
    },
    {
      "flow_name": "s2i-abnfgen-grammar-coverage",
      "relationship": "feeds_into",
      "description": "outputs grammar_file consumed by s2i-abnfgen-grammar-coverage"
    }
  ]
}
