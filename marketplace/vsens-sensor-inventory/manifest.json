{
  "name": "vsens-sensor-inventory",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "sensors",
    "vehicle",
    "robotics",
    "inventory",
    "time-sync"
  ],
  "inputs": [
    "platform_description",
    "sensor_list"
  ],
  "outputs": [
    "sensor_inventory",
    "timing_requirements"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Inventory every vehicle or robot sensor with stable device paths, cited rates, frame ids and a planned sync mechanism, and derive the timing requirements later flows use.",
  "related_flows": [
    {
      "flow_name": "vsens-gnss-nmea-gpsd",
      "relationship": "feeds_into",
      "description": "outputs sensor_inventory consumed by vsens-gnss-nmea-gpsd"
    },
    {
      "flow_name": "vsens-pps-chrony",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "vsens-ros2-stamp-latency",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "vsens-gmsl-csi-bringup",
      "relationship": "feeds_into",
      "description": "outputs sensor_inventory consumed by vsens-gmsl-csi-bringup"
    },
    {
      "flow_name": "vsens-v4l2-camera-probe",
      "relationship": "feeds_into",
      "description": "outputs sensor_inventory consumed by vsens-v4l2-camera-probe"
    },
    {
      "flow_name": "vsens-v4l2-exposure-framerate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-gstreamer-capture-pipeline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-cpp-v4l2-mmap-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
