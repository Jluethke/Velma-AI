{
  "name": "k8s-requests-limits-from-usage",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "resources",
    "requests",
    "limits",
    "qos"
  ],
  "inputs": [
    "probed_deployment",
    "usage_report",
    "request_percentile",
    "qos_target",
    "memory_headroom",
    "namespace"
  ],
  "outputs": [
    "resourced_deployment"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Convert measured usage into CPU and memory requests and limits with a QoS decision table, checked against LimitRange, ResourceQuota and node allocatable.",
  "related_flows": [
    {
      "flow_name": "k8s-resource-usage-measure",
      "relationship": "fed_by",
      "description": "provides usage_report needed here"
    },
    {
      "flow_name": "k8s-py-gunicorn-worker-sizing",
      "relationship": "feeds_into",
      "description": "outputs resourced_deployment consumed by k8s-py-gunicorn-worker-sizing"
    },
    {
      "flow_name": "k8s-node-heap-sizing",
      "relationship": "feeds_into",
      "description": "outputs resourced_deployment consumed by k8s-node-heap-sizing"
    },
    {
      "flow_name": "k8s-go-gomaxprocs-gomemlimit",
      "relationship": "feeds_into",
      "description": "outputs resourced_deployment consumed by k8s-go-gomaxprocs-gomemlimit"
    },
    {
      "flow_name": "k8s-jvm-container-heap",
      "relationship": "feeds_into",
      "description": "outputs resourced_deployment consumed by k8s-jvm-container-heap"
    },
    {
      "flow_name": "k8s-hpa-autoscaling",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-probe-tuning",
      "relationship": "fed_by",
      "description": "provides probed_deployment needed here"
    },
    {
      "flow_name": "k8s-security-context-hardening",
      "relationship": "feeds_into",
      "description": "outputs resourced_deployment consumed by k8s-security-context-hardening"
    }
  ]
}
