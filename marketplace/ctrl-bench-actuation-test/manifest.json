{
  "name": "ctrl-bench-actuation-test",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "bench-test",
    "actuation",
    "emergency-stop",
    "safety"
  ],
  "inputs": [
    "control_spec",
    "stability_report",
    "py_controller_build",
    "cpp_controller_build",
    "py_timing_report",
    "cpp_timing_report"
  ],
  "outputs": [
    "bench_log",
    "bench_verdict"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run sign, unit, limit, fault and step tests on a bench rig behind an independent hardware emergency stop and issue a bench verdict.",
  "related_flows": [
    {
      "flow_name": "ctrl-tracking-metrics",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "ctrl-spec-intake",
      "relationship": "fed_by",
      "description": "provides control_spec needed here"
    },
    {
      "flow_name": "ctrl-impl-py",
      "relationship": "fed_by",
      "description": "provides py_controller_build needed here"
    },
    {
      "flow_name": "ctrl-impl-cpp",
      "relationship": "fed_by",
      "description": "provides cpp_controller_build needed here"
    },
    {
      "flow_name": "ctrl-loop-timing-py",
      "relationship": "fed_by",
      "description": "provides py_timing_report needed here"
    },
    {
      "flow_name": "ctrl-loop-timing-cpp",
      "relationship": "fed_by",
      "description": "provides cpp_timing_report needed here"
    },
    {
      "flow_name": "ctrl-closed-course-run",
      "relationship": "feeds_into",
      "description": "outputs bench_verdict consumed by ctrl-closed-course-run"
    },
    {
      "flow_name": "ctrl-stability-margins",
      "relationship": "fed_by",
      "description": "provides stability_report needed here"
    }
  ]
}
