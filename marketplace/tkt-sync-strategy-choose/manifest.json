      "flow_name": "tkt-review-comment-response",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-rebase-conflict-resolve",
      "relationship": "feeds_into",
      "description": "outputs sync_strategy consumed by tkt-rebase-conflict-resolve"
    },
    {
      "flow_name": "tkt-merge-conflict-resolve",
      "relationship": "feeds_into",
      "description": "outputs sync_strategy consumed by tkt-merge-conflict-resolve"
    },
    {
      "flow_name": "tkt-post-merge-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-branch-create",
      "relationship": "fed_by",
      "description": "provides branch_name needed here"
    },
    {
      "flow_name": "tkt-pr-description",
      "relationship": "fed_by",
      "description": "provides pr_url needed here"
    }
  ]
