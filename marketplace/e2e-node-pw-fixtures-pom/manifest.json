{
  "name": "e2e-node-pw-fixtures-pom",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "e2e",
    "playwright",
    "fixtures",
    "page-objects",
    "typescript"
  ],
  "inputs": [
    "repo_dir",
    "pw_node_config",
    "selector_policy",
    "critical_journeys"
  ],
  "outputs": [
    "node_fixture_layer"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Decide per page between page objects, helpers and inline locators, expose page objects through Playwright test.extend fixtures, and convert specs one at a time.",
  "related_flows": [
    {
      "flow_name": "e2e-journey-select",
      "relationship": "fed_by",
      "description": "provides critical_journeys needed here"
    },
    {
      "flow_name": "e2e-runner-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-node-pw-setup",
      "relationship": "fed_by",
      "description": "provides pw_node_config needed here"
    },
    {
      "flow_name": "e2e-selector-policy",
      "relationship": "fed_by",
      "description": "provides selector_policy needed here"
    },
    {
      "flow_name": "e2e-node-pw-data-seed",
      "relationship": "feeds_into",
      "description": "outputs node_fixture_layer consumed by e2e-node-pw-data-seed"
    },
    {
      "flow_name": "e2e-node-pw-auth-state",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-mock-vs-real-decide",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-pw-network-mock",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
