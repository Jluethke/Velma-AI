{
  "name": "perf-node-cpu-prof-devtools",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "performance",
    "node",
    "cpu-profile",
    "chrome-devtools",
    "profiling"
  ],
  "inputs": [
    "workload_spec",
    "repo_path"
  ],
  "outputs": [
    "node_cpu_profile"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Capture a V8 cpuprofile with --cpu-prof or DevTools, map frames to sources, and read Bottom-Up self time and Call Tree totals.",
  "related_flows": [
    {
      "flow_name": "perf-metric-workload-define",
      "relationship": "fed_by",
      "description": "provides workload_spec needed here"
    },
    {
      "flow_name": "perf-bench-env-stabilize",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-node-tinybench-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-bench-baseline-normalize",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-node-clinic-0x-flame",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-flame-graph-read",
      "relationship": "feeds_into",
      "description": "outputs node_cpu_profile consumed by perf-flame-graph-read"
    },
    {
      "flow_name": "perf-hotspot-classify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-fix-algorithmic-complexity",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
