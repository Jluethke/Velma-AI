{
  "name": "mlp-leakage-audit",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "leakage",
    "polars",
    "data-quality"
  ],
  "inputs": [
    "data_version",
    "problem_frame",
    "primary_metric"
  ],
  "outputs": [
    "leakage_findings",
    "clean_feature_list"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Runs five concrete leakage checks (availability time, ID-like columns, single-feature score versus baseline, duplicate rows, label-derived columns) on the versioned dataset and emits a feature list with every leaking column removed and the reason recorded.",
  "related_flows": [
    {
      "flow_name": "mlp-frame-problem-metric",
      "relationship": "fed_by",
      "description": "provides primary_metric, problem_frame needed here"
    },
    {
      "flow_name": "mlp-dvc-version-raw-data",
      "relationship": "fed_by",
      "description": "provides data_version needed here"
    },
    {
      "flow_name": "mlp-split-random-stratified",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-split-time-based",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-split-grouped",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-split-integrity-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-dvc-pipeline-stages",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-baseline-models",
      "relationship": "feeds_into",
      "description": "outputs clean_feature_list consumed by mlp-baseline-models"
    }
  ]
}
