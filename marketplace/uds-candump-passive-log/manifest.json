{
  "name": "uds-candump-passive-log",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "candump",
    "can-utils",
    "logging",
    "socketcan",
    "capture"
  ],
  "inputs": [
    "can_link_status",
    "can_interface",
    "capture_seconds"
  ],
  "outputs": [
    "candump_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Record a replayable listen-only candump log of the vehicle bus and check it for drops and error frames.",
  "related_flows": [
    {
      "flow_name": "uds-socketcan-link-setup",
      "relationship": "fed_by",
      "description": "provides can_link_status needed here"
    },
    {
      "flow_name": "uds-kernel-can-isotp-module",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "uds-isotp-frame-decode",
      "relationship": "feeds_into",
      "description": "outputs candump_log consumed by uds-isotp-frame-decode"
    },
    {
      "flow_name": "uds-isotp-flow-control-params",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "uds-py-isotp-library",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "uds-diag-scope-readonly",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uds-vcan-bench-replay",
      "relationship": "feeds_into",
      "description": "outputs candump_log consumed by uds-vcan-bench-replay"
    },
    {
      "flow_name": "uds-c-isotp-socket",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
