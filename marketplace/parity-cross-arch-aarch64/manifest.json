{
  "name": "parity-cross-arch-aarch64",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "parity",
    "aarch64",
    "qemu",
    "cross-compile"
  ],
  "inputs": [
    "port_repo",
    "fp_flags",
    "golden_manifest",
    "comparison_policy"
  ],
  "outputs": [
    "cross_arch_results"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Cross-compile the parity harness for aarch64, pre-check under QEMU user mode, and record the result of record on real aarch64 hardware.",
  "related_flows": [
    {
      "flow_name": "parity-env-fingerprint",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "parity-fp-flag-baseline",
      "relationship": "fed_by",
      "description": "provides fp_flags needed here"
    },
    {
      "flow_name": "parity-libm-divergence",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "parity-compiler-flag-matrix",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "parity-golden-manifest-lock",
      "relationship": "fed_by",
      "description": "provides golden_manifest needed here"
    },
    {
      "flow_name": "parity-ulp-tolerance-policy",
      "relationship": "fed_by",
      "description": "provides comparison_policy needed here"
    },
    {
      "flow_name": "parity-report",
      "relationship": "feeds_into",
      "description": "outputs cross_arch_results consumed by parity-report"
    }
  ]
}
