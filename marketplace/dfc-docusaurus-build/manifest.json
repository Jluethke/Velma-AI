{
  "name": "dfc-docusaurus-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "docusaurus",
    "docs-site",
    "mdx",
    "broken-links",
    "mermaid"
  ],
  "inputs": [
    "repo_path",
    "doc_plan"
  ],
  "outputs": [
    "site_dir",
    "site_build_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a Docusaurus 3 site with a Diataxis sidebar, Mermaid, and broken links and anchors set to throw, fixing errors until the build passes.",
  "related_flows": [
    {
      "flow_name": "dfc-audience-doctype-plan",
      "relationship": "fed_by",
      "description": "provides doc_plan needed here"
    },
    {
      "flow_name": "dfc-readme-structure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-node-tsdoc-conventions",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-node-typedoc-reference",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-node-mdx-tested-samples",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-lychee-link-check",
      "relationship": "feeds_into",
      "description": "outputs site_dir consumed by dfc-lychee-link-check"
    }
  ]
}
