{
  "name": "vsim-gz-sensor-noise",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "gazebo",
    "sensor-noise",
    "imu",
    "gnss",
    "simulation"
  ],
  "inputs": [
    "vehicle_sdf",
    "sensor_spec",
    "noise_params"
  ],
  "outputs": [
    "noisy_vehicle_sdf"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Add Gazebo sensors with Gaussian noise derived from datasheet figures and measure the simulated noise to confirm it.",
  "related_flows": [
    {
      "flow_name": "vsim-gz-vehicle-model",
      "relationship": "fed_by",
      "description": "provides vehicle_sdf needed here"
    },
    {
      "flow_name": "vsim-gz-ros2-bridge",
      "relationship": "feeds_into",
      "description": "outputs noisy_vehicle_sdf consumed by vsim-gz-ros2-bridge"
    },
    {
      "flow_name": "vsim-gz-seed-determinism",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-ros2-bag-replay-sil",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-sim2real-gap-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
