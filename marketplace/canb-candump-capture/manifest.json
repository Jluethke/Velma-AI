{
  "name": "canb-candump-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "can-utils",
    "candump",
    "logging",
    "socketcan"
  ],
  "inputs": [
    "can_netdev",
    "link_state",
    "capture_filters",
    "capture_seconds"
  ],
  "outputs": [
    "candump_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Record CAN and CAN FD traffic with candump using log-file timestamps, kernel filters and error frames, then check the log for drops.",
  "related_flows": [
    {
      "flow_name": "canb-tx-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "canb-usb-adapter-bringup",
      "relationship": "fed_by",
      "description": "provides can_netdev needed here"
    },
    {
      "flow_name": "canb-termination-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "canb-bit-timing-calc",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "canb-socketcan-link-up",
      "relationship": "fed_by",
      "description": "provides link_state needed here"
    },
    {
      "flow_name": "canb-error-frame-diagnosis",
      "relationship": "feeds_into",
      "description": "outputs candump_log consumed by canb-error-frame-diagnosis"
    },
    {
      "flow_name": "canb-busoff-recovery",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-canbusload-measure",
      "relationship": "feeds_into",
      "description": "outputs candump_log consumed by canb-canbusload-measure"
    }
  ]
}
