{
  "name": "srf-baseline-green-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "refactoring",
    "git",
    "testing",
    "baseline"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "test_command",
    "refactorings",
    "refactor_name"
  ],
  "outputs": [
    "baseline_commit",
    "refactor_branch",
    "baseline_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Prove the repository is clean and the full test suite passes twice with identical counts, then create the refactor branch and record the baseline commit.",
  "related_flows": [
    {
      "flow_name": "srf-verify-step-history",
      "relationship": "feeds_into",
      "description": "outputs baseline_commit, refactor_branch consumed by srf-verify-step-history"
    },
    {
      "flow_name": "srf-py-characterization-tests",
      "relationship": "feeds_into",
      "description": "outputs baseline_commit consumed by srf-py-characterization-tests"
    },
    {
      "flow_name": "srf-node-characterization-tests",
      "relationship": "feeds_into",
      "description": "outputs baseline_commit consumed by srf-node-characterization-tests"
    },
    {
      "flow_name": "srf-go-golden-master-tests",
      "relationship": "feeds_into",
      "description": "outputs baseline_commit consumed by srf-go-golden-master-tests"
    },
    {
      "flow_name": "srf-js-codemod-jscodeshift",
      "relationship": "feeds_into",
      "description": "outputs baseline_commit consumed by srf-js-codemod-jscodeshift"
    },
    {
      "flow_name": "srf-go-rewrite-gofmt-r",
      "relationship": "feeds_into",
      "description": "outputs baseline_commit consumed by srf-go-rewrite-gofmt-r"
    },
    {
      "flow_name": "srf-py-approval-tests-combinations",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "srf-py-api-snapshot-griffe",
      "relationship": "feeds_into",
      "description": "outputs baseline_commit consumed by srf-py-api-snapshot-griffe"
    }
  ]
}
