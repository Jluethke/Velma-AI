{
  "name": "rag-gold-question-set-label",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rag",
    "evaluation",
    "labeling",
    "qrels",
    "test-set"
  ],
  "inputs": [
    "clean_records",
    "seed_questions",
    "work_dir"
  ],
  "outputs": [
    "question_set",
    "qrels_spans"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a labeled question set tied to gold answer spans by character offsets, with unanswerable questions, measured labeler agreement and a frozen dev/test split.",
  "related_flows": [
    {
      "flow_name": "rag-corpus-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-py-pdf-extract-pymupdf",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-ocr-scanned-pdf-ocrmypdf",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-py-html-extract-trafilatura",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-corpus-normalize-dedupe",
      "relationship": "fed_by",
      "description": "provides clean_records needed here"
    },
    {
      "flow_name": "rag-retrieval-eval-harness",
      "relationship": "feeds_into",
      "description": "outputs question_set, qrels_spans consumed by rag-retrieval-eval-harness"
    },
    {
      "flow_name": "rag-answer-faithfulness-score",
      "relationship": "feeds_into",
      "description": "outputs question_set consumed by rag-answer-faithfulness-score"
    },
    {
      "flow_name": "rag-failure-analysis-triage",
      "relationship": "feeds_into",
      "description": "outputs question_set consumed by rag-failure-analysis-triage"
    }
  ]
}
