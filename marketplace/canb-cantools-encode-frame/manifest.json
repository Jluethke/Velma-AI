{
  "name": "canb-cantools-encode-frame",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "cantools",
    "dbc",
    "encode",
    "python"
  ],
  "inputs": [
    "dbc_file",
    "signal_values",
    "tx_permission"
  ],
  "outputs": [
    "encoded_frames"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Encode physical signal values into CAN payloads with cantools in strict mode, verify them by round-trip decode and emit bench-only frames.",
  "related_flows": [
    {
      "flow_name": "canb-tx-scope-check",
      "relationship": "fed_by",
      "description": "provides tx_permission needed here"
    },
    {
      "flow_name": "canb-vcan-setup",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "canb-dbc-lint-load",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "canb-py-bus-notifier",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-c-raw-socket-filters",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-dbc-c-codegen",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-cansend-cangen-bench",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-py-cyclic-tx",
      "relationship": "feeds_into",
      "description": "outputs encoded_frames consumed by canb-py-cyclic-tx"
    }
  ]
}
