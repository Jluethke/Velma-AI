{
  "name": "pcb-autoroute",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "routing",
    "freerouting",
    "kicad"
  ],
  "inputs": [
    "critical_routed_board",
    "locked_nets"
  ],
  "outputs": [
    "routed_board",
    "route_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Route remaining nets with Freerouting through a Specctra DSN round trip, pour and fill ground zones, and confirm locked critical nets are unchanged with zero unrouted.",
  "related_flows": [
    {
      "flow_name": "pcb-board-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-placement-candidates",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-placement-scoring",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-critical-routing",
      "relationship": "fed_by",
      "description": "provides locked_nets, critical_routed_board needed here"
    },
    {
      "flow_name": "pcb-drc-closure",
      "relationship": "feeds_into",
      "description": "outputs routed_board consumed by pcb-drc-closure"
    },
    {
      "flow_name": "pcb-layout-metrics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
