{
  "name": "rtw-heartbeat-config",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "realtime",
    "websocket",
    "heartbeat",
    "ping-pong",
    "timeouts"
  ],
  "inputs": [
    "transport_decision",
    "network_path"
  ],
  "outputs": [
    "heartbeat_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Derive the realtime heartbeat interval and dead-peer timeout from the smallest idle timeout on the network path and map them to library settings.",
