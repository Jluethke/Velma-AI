{
  "name": "xarch-ldd-shared-deps-audit",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "cross-compile",
    "aarch64",
    "readelf",
    "dependencies",
    "sysroot"
  ],
  "inputs": [
    "binary_path",
    "sysroot",
    "toolchain_prefix"
  ],
  "outputs": [
    "deps_report",
    "missing_libs"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Read the DT_NEEDED entries and interpreter of an aarch64 binary with readelf and resolve each against the sysroot, reporting every dependency missing before deploy.",
  "related_flows": [
    {
      "flow_name": "xarch-elf-arch-verify",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "xarch-musl-static-link",
      "relationship": "feeds_into",
      "description": "outputs missing_libs consumed by xarch-musl-static-link"
    },
    {
      "flow_name": "xarch-glibc-version-diagnose",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-remote-deploy-rsync",
      "relationship": "feeds_into",
      "description": "outputs deps_report consumed by xarch-remote-deploy-rsync"
    },
    {
      "flow_name": "xarch-gdbserver-remote-debug",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-gcc-toolchain-select",
      "relationship": "fed_by",
      "description": "provides toolchain_prefix needed here"
    },
    {
      "flow_name": "xarch-sysroot-from-image",
      "relationship": "fed_by",
      "description": "provides sysroot needed here"
    }
  ]
}
