{
  "name": "ledg-pg-idempotent-posting",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ledger",
    "postgresql",
    "idempotency",
    "on-conflict",
    "retry"
  ],
  "inputs": [
    "ledger_schema",
    "reversal_procedure"
  ],
  "outputs": [
    "posting_service"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Post journal entries exactly once per idempotency key with ON CONFLICT DO NOTHING and a canonical request hash.",
  "related_flows": [
    {
      "flow_name": "ledg-pg-double-entry-schema",
      "relationship": "fed_by",
      "description": "provides ledger_schema needed here"
    },
    {
      "flow_name": "ledg-pg-immutable-reversals",
      "relationship": "fed_by",
      "description": "provides reversal_procedure needed here"
    },
    {
      "flow_name": "ledg-pg-balance-locking",
      "relationship": "feeds_into",
      "description": "outputs posting_service consumed by ledg-pg-balance-locking"
    },
    {
      "flow_name": "ledg-float-money-audit",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "ledg-money-representation-decision",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "ledg-rounding-policy",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "ledg-allocate-remainder",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "ledg-py-decimal-money",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
