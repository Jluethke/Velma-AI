{
  "name": "inc-stabilize-decision-table",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "incident-response",
    "mitigation",
    "rollback",
    "stabilize",
    "decision-table"
  ],
  "inputs": [
    "incident_record",
    "severity",
    "metric_findings",
    "change_correlation"
  ],
  "outputs": [
    "mitigation_choice"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Pick one stabilizing mitigation (rollback, flag off, scale out, traffic shift, shed load or restart) from a decision table before root cause work starts.",
  "related_flows": [
    {
      "flow_name": "inc-declare-severity",
      "relationship": "fed_by",
      "description": "provides severity, incident_record needed here"
    },
    {
      "flow_name": "inc-assign-incident-roles",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-timeline-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-status-page-update",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-promql-red-triage",
      "relationship": "fed_by",
      "description": "provides metric_findings needed here"
    },
    {
      "flow_name": "inc-change-correlation",
      "relationship": "fed_by",
      "description": "provides change_correlation needed here"
    },
    {
      "flow_name": "inc-k8s-rollout-undo",
      "relationship": "feeds_into",
      "description": "outputs mitigation_choice consumed by inc-k8s-rollout-undo"
    },
    {
      "flow_name": "inc-feature-flag-off",
      "relationship": "feeds_into",
      "description": "outputs mitigation_choice consumed by inc-feature-flag-off"
    }
  ]
}
