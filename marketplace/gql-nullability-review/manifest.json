{
  "name": "gql-nullability-review",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "graphql",
    "nullability",
    "schema-design",
    "error-propagation"
  ],
  "inputs": [
    "schema_sdl",
    "existing_data_model"
  ],
  "outputs": [
    "nullable_schema",
    "nullability_decisions"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Decide non-null markers for every field and argument with a fixed rule table based on GraphQL null propagation, recording the rule behind each decision.",
  "related_flows": [
    {
      "flow_name": "gql-use-case-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-schema-sdl-draft",
      "relationship": "fed_by",
      "description": "provides schema_sdl needed here"
    },
    {
      "flow_name": "gql-relay-connection-schema",
      "relationship": "feeds_into",
      "description": "outputs nullable_schema consumed by gql-relay-connection-schema"
    },
    {
      "flow_name": "gql-schema-lint-graphql-eslint",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-schema-breaking-diff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
