{
  "name": "e2e-flake-triage",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "e2e",
    "flaky-tests",
    "triage",
    "quarantine",
    "debugging"
  ],
  "inputs": [
    "repo_dir",
    "stack",
    "retry_policy",
    "failure_diagnosis",
    "flaky_tests",
