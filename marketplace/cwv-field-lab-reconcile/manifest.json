{
  "name": "cwv-field-lab-reconcile",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "web-performance",
    "field-vs-lab",
    "triage",
    "core-web-vitals"
  ],
  "inputs": [
    "field_baseline",
    "failing_metrics",
    "rum_p75_report",
    "lab_report",
    "wpt_findings"
  ],
  "outputs": [
    "diagnosis_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Reconcile CrUX and RUM field data with Lighthouse and WebPageTest lab data using a decision table and emit the ordered list of metric workflows to run.",
  "related_flows": [
    {
      "flow_name": "cwv-field-crux-baseline",
      "relationship": "fed_by",
      "description": "provides field_baseline, failing_metrics needed here"
    },
    {
      "flow_name": "cwv-rum-p75-analysis",
      "relationship": "fed_by",
      "description": "provides rum_p75_report needed here"
    },
    {
      "flow_name": "cwv-lab-lighthouse-run",
      "relationship": "fed_by",
      "description": "provides lab_report needed here"
    },
    {
      "flow_name": "cwv-lab-webpagetest-waterfall",
      "relationship": "fed_by",
      "description": "provides wpt_findings needed here"
    },
    {
      "flow_name": "cwv-lcp-subparts-breakdown",
      "relationship": "feeds_into",
      "description": "outputs diagnosis_plan consumed by cwv-lcp-subparts-breakdown"
    },
    {
      "flow_name": "cwv-inp-interaction-profile",
      "relationship": "feeds_into",
      "description": "outputs diagnosis_plan consumed by cwv-inp-interaction-profile"
    },
    {
      "flow_name": "cwv-cls-shift-sources",
      "relationship": "feeds_into",
      "description": "outputs diagnosis_plan consumed by cwv-cls-shift-sources"
    }
  ]
}
