{
  "name": "tsm-ts-allowjs-checkjs",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "typescript",
    "allowjs",
    "checkjs",
    "jsdoc",
    "tsconfig"
  ],
  "inputs": [
    "repo_path",
    "ts_error_baseline"
  ],
  "outputs": [
    "ts_allowjs_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Add a tsconfig that compiles JavaScript and TypeScript side by side with allowJs, then opt JavaScript files into checking one at a time with // @ts-check and JSDoc.",
  "related_flows": [
    {
      "flow_name": "tsm-migration-intake",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-error-baseline",
      "relationship": "fed_by",
      "description": "provides ts_error_baseline needed here"
    },
    {
      "flow_name": "tsm-ts-type-coverage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-conversion-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-declaration-files",
      "relationship": "feeds_into",
      "description": "outputs ts_allowjs_config consumed by tsm-ts-declaration-files"
    },
    {
      "flow_name": "tsm-ts-convert-file",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-noimplicitany",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-strictnullchecks",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
