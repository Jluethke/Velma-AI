{
  "name": "race-py-asyncio-debug",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "python",
    "asyncio",
    "debug-mode",
    "missing-await",
    "tracemalloc"
  ],
  "inputs": [
    "repo_path",
    "stress_command"
  ],
  "outputs": [
    "py_asyncio_debug_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Runs the asyncio code under asyncio debug mode and Python development mode with tracemalloc, turns `never awaited` warnings into errors, and collects every slow-callback, missing-await, destroyed-pending-task and unretrieved-exception message with its source location.",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "fed_by",
      "description": "provides stress_command needed here"
    },
    {
      "flow_name": "race-py-hang-dump",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-py-asyncio-blocking",
      "relationship": "feeds_into",
      "description": "outputs py_asyncio_debug_findings consumed by race-py-asyncio-blocking"
    },
    {
      "flow_name": "race-py-asyncio-cancellation",
      "relationship": "feeds_into",
      "description": "outputs py_asyncio_debug_findings consumed by race-py-asyncio-cancellation"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs py_asyncio_debug_findings consumed by race-findings-consolidate"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
