{
  "name": "enc-parametric-model",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "enclosure",
    "mechanical",
    "build123d",
    "cad",
    "parametric"
  ],
  "inputs": [
    "board_envelope",
    "board_spec",
    "enclosure_process",
    "project_dir"
  ],
  "outputs": [
    "enclosure_source"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a parametric build123d enclosure driven by the board envelope: process-correct walls, standoffs, connector cutouts with mating clearance, and vents sized from dissipation.",
  "related_flows": [
    {
      "flow_name": "enc-board-3d-export",
      "relationship": "fed_by",
      "description": "provides board_envelope needed here"
    },
    {
      "flow_name": "enc-fit-check",
      "relationship": "feeds_into",
      "description": "outputs enclosure_source consumed by enc-fit-check"
    },
    {
      "flow_name": "enc-manufacturing-export",
      "relationship": "feeds_into",
      "description": "outputs enclosure_source consumed by enc-manufacturing-export"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "fed_by",
      "description": "provides board_spec needed here"
    }
  ]
}
