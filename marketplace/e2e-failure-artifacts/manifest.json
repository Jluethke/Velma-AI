{
  "name": "e2e-failure-artifacts",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "e2e",
    "traces",
    "videos",
    "screenshots",
    "ci-artifacts"
  ],
  "inputs": [
    "repo_dir",
    "stack",
    "retry_policy"
  ],
  "outputs": [
    "artifact_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Keep traces, videos and screenshots for failing tests only, write them to one known directory, and upload it from CI even when tests fail.",
  "related_flows": [
    {
      "flow_name": "e2e-retries-policy",
      "relationship": "fed_by",
      "description": "provides retry_policy needed here"
    },
    {
      "flow_name": "e2e-flake-triage",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "e2e-journey-select",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "e2e-runner-select",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "e2e-selector-policy",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "e2e-mock-vs-real-decide",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "e2e-pw-trace-read",
      "relationship": "feeds_into",
      "description": "outputs artifact_config consumed by e2e-pw-trace-read"
    },
    {
      "flow_name": "e2e-ci-container-run",
      "relationship": "feeds_into",
      "description": "outputs artifact_config consumed by e2e-ci-container-run"
    }
  ]
}
