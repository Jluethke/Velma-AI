{
  "name": "mlp-split-time-based",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "time-series-split",
    "temporal-leakage",
    "scikit-learn"
  ],
  "inputs": [
    "data_version",
    "problem_frame",
    "time_column",
    "cutoff_dates"
  ],
  "outputs": [
    "time_split"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Splits data by prediction time into train, validation and test windows with a gap equal to the label window, and builds forward-chaining CV folds with scikit-learn `TimeSeriesSplit`, so no training label overlaps an evaluation period.",
  "related_flows": [
    {
      "flow_name": "mlp-frame-problem-metric",
      "relationship": "fed_by",
      "description": "provides problem_frame needed here"
    },
    {
      "flow_name": "mlp-dvc-version-raw-data",
      "relationship": "fed_by",
      "description": "provides data_version needed here"
    },
    {
      "flow_name": "mlp-leakage-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-split-random-stratified",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-split-grouped",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-split-integrity-check",
      "relationship": "feeds_into",
      "description": "outputs time_split consumed by mlp-split-integrity-check"
    },
    {
      "flow_name": "mlp-dvc-pipeline-stages",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
