{
  "name": "rel-py-api-break-griffe",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "python",
    "griffe",
    "api-diff",
    "semver"
  ],
  "inputs": [
    "repo_path",
    "last_tag",
    "package_name"
  ],
  "outputs": [
    "py_api_breaks"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Detect breaking changes in a Python package's public API between the last release tag and HEAD with griffe check.",
  "related_flows": [
    {
      "flow_name": "rel-commit-history-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-semver-bump-decision",
      "relationship": "feeds_into",
      "description": "outputs py_api_breaks consumed by rel-semver-bump-decision"
    },
    {
      "flow_name": "rel-changelog-git-cliff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-py-reproducible-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-py-publish-pypi-trusted",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-py-verify-install",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
