{
  "name": "rel-changelog-git-cliff",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "changelog",
    "git-cliff",
    "keep-a-changelog"
  ],
  "inputs": [
    "repo_path",
    "next_version",
    "last_tag"
  ],
  "outputs": [
    "cliff_config",
    "cliff_changelog"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Generate a Keep a Changelog style CHANGELOG.md section from Conventional Commits with git-cliff and cross-check its bumped version.",
  "related_flows": [
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "feeds_into",
      "description": "outputs cliff_changelog consumed by rel-tag-sign-git"
    },
    {
      "flow_name": "rel-commit-history-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-py-api-break-griffe",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-semver-bump-decision",
      "relationship": "fed_by",
      "description": "provides next_version needed here"
    },
    {
      "flow_name": "rel-py-reproducible-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-py-publish-pypi-trusted",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-py-verify-install",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
