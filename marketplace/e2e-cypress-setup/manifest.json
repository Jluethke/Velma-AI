{
  "name": "e2e-cypress-setup",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "e2e",
    "cypress",
    "javascript",
    "setup",
    "testing"
  ],
  "inputs": [
    "repo_dir",
    "app_url",
    "runner_decision",
    "start_command"
  ],
  "outputs": [
    "cypress_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Install Cypress, write cypress.config.ts with baseUrl, specPattern, retries and video set on purpose, and prove it with a smoke spec seen to pass and fail.",
  "related_flows": [
    {
      "flow_name": "e2e-journey-select",
