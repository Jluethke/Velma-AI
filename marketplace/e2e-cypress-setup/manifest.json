      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-runner-select",
      "relationship": "fed_by",
      "description": "provides runner_decision needed here"
    },
    {
      "flow_name": "e2e-selector-policy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-cypress-commands-pom",
      "relationship": "feeds_into",
      "description": "outputs cypress_config consumed by e2e-cypress-commands-pom"
    },
    {
      "flow_name": "e2e-cypress-data-seed",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-cypress-auth-session",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-mock-vs-real-decide",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-cypress-intercept",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
