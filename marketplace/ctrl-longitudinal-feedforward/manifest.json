      "description": "provides control_spec needed here"
    },
    {
      "flow_name": "ctrl-can-readonly-log",
      "relationship": "fed_by",
      "description": "provides drive_log needed here"
    },
    {
      "flow_name": "ctrl-bicycle-model-py",
      "relationship": "fed_by",
      "description": "provides plant_model needed here"
    },
    {
      "flow_name": "ctrl-model-fit-from-logs",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctrl-actuator-rate-saturation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctrl-pid-antiwindup",
      "relationship": "feeds_into",
      "description": "outputs feedforward_model consumed by ctrl-pid-antiwindup"
    },
    {
      "flow_name": "ctrl-pid-step-tuning",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctrl-tracking-metrics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
