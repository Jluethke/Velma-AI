{
  "name": "ctrl-longitudinal-feedforward",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feedforward",
    "road-load",
    "coast-down",
    "longitudinal"
  ],
  "inputs": [
    "plant_model",
    "control_spec",
    "drive_log"
  ],
  "outputs": [
    "feedforward_model"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Fit a road load model from coast-down data and build the longitudinal feedforward term with a measured inverse request map.",
  "related_flows": [
    {
      "flow_name": "ctrl-spec-intake",
