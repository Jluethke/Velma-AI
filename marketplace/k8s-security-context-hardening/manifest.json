{
  "name": "k8s-security-context-hardening",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "security-context",
    "pod-security-admission",
    "read-only-root-fs"
  ],
  "inputs": [
    "resourced_deployment",
    "py_runtime_settings",
    "node_runtime_settings",
    "go_runtime_settings",
    "jvm_runtime_settings",
    "namespace",
    "image_ref"
  ],
  "outputs": [
    "hardened_deployment",
    "namespace_manifest"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Bring the Deployment to the Pod Security restricted profile with a read-only root filesystem and label the namespace so admission enforces it.",
  "related_flows": [
    {
      "flow_name": "k8s-rolling-update-pdb",
      "relationship": "feeds_into",
      "description": "outputs hardened_deployment consumed by k8s-rolling-update-pdb"
    },
    {
      "flow_name": "k8s-network-policy-default-deny",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-kubeconform-validate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-kube-linter-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-requests-limits-from-usage",
      "relationship": "fed_by",
      "description": "provides resourced_deployment needed here"
    },
    {
      "flow_name": "k8s-py-gunicorn-worker-sizing",
      "relationship": "fed_by",
      "description": "provides py_runtime_settings needed here"
    },
    {
      "flow_name": "k8s-node-heap-sizing",
      "relationship": "fed_by",
      "description": "provides node_runtime_settings needed here"
    },
    {
      "flow_name": "k8s-go-gomaxprocs-gomemlimit",
      "relationship": "fed_by",
      "description": "provides go_runtime_settings needed here"
    }
  ]
}
