{
  "name": "rtl-cyclictest-baseline",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "realtime-linux",
    "cyclictest",
    "latency",
    "rt-tests"
  ],
  "inputs": [
    "kernel_report",
    "test_duration",
    "rt_priority"
  ],
  "outputs": [
