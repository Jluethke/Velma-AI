{
  "name": "pay-stripe-cli-local-webhooks",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "payments",
    "stripe-cli",
    "webhooks",
    "local-development"
  ],
  "inputs": [
    "test_env",
    "webhook_path",
    "local_port"
  ],
  "outputs": [
    "webhook_secret_local",
    "cli_trigger_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Forward Stripe test events to a local endpoint with stripe listen, trigger fixtures, and diagnose results from the listen output.",
  "related_flows": [
    {
      "flow_name": "pay-test-mode-setup",
      "relationship": "fed_by",
      "description": "provides test_env needed here"
    },
    {
      "flow_name": "pay-py-webhook-verify",
      "relationship": "feeds_into",
      "description": "outputs webhook_secret_local consumed by pay-py-webhook-verify"
    },
    {
      "flow_name": "pay-webhook-dedup-ordering",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "pay-money-minor-units",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pay-idempotency-keys",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pay-py-payment-intent",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pay-node-webhook-verify",
      "relationship": "feeds_into",
      "description": "outputs webhook_secret_local consumed by pay-node-webhook-verify"
    },
    {
      "flow_name": "pay-go-webhook-verify",
      "relationship": "feeds_into",
      "description": "outputs webhook_secret_local consumed by pay-go-webhook-verify"
    }
  ]
}
