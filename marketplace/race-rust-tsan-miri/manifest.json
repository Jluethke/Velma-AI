{
  "name": "race-rust-tsan-miri",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rust",
    "threadsanitizer",
    "miri",
    "unsafe",
    "data-race"
  ],
  "inputs": [
    "repo_path",
    "stress_command"
  ],
  "outputs": [
    "rust_tsan_reports"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Finds data races in Rust `unsafe` code, FFI and hand-written atomics by running tests under nightly ThreadSanitizer with `-Zbuild-std` and under Miri's race and weak-memory checks, and records each report as a pair of conflicting accesses.",
  "related_flows": [
    {
      "flow_name": "race-stress-harness",
      "relationship": "fed_by",
      "description": "provides stress_command needed here"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs rust_tsan_reports consumed by race-findings-consolidate"
    }
  ]
}
