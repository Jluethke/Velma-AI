{
  "name": "ival-sink-class-map",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "security",
    "input-validation",
    "sinks",
    "injection",
    "triage"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "entry_point_inventory"
  ],
  "outputs": [
    "sink_map"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Find every dangerous sink per vulnerability class, link it to the entry points that reach it, and list the classes that need fixes.",
  "related_flows": [
    {
      "flow_name": "ival-entry-point-inventory",
      "relationship": "fed_by",
      "description": "provides entry_point_inventory needed here"
    },
    {
      "flow_name": "ival-negative-test-suite",
      "relationship": "feeds_into",
      "description": "outputs sink_map consumed by ival-negative-test-suite"
    },
    {
      "flow_name": "ival-semgrep-taint-rules",
      "relationship": "feeds_into",
      "description": "outputs sink_map consumed by ival-semgrep-taint-rules"
    },
    {
      "flow_name": "ival-path-traversal-fix",
      "relationship": "feeds_into",
      "description": "outputs sink_map consumed by ival-path-traversal-fix"
    },
    {
      "flow_name": "ival-ssrf-egress-guard",
      "relationship": "feeds_into",
      "description": "outputs sink_map consumed by ival-ssrf-egress-guard"
    },
    {
      "flow_name": "ival-rejected-input-logging",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ival-ci-security-gate",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ival-xss-output-encoding",
      "relationship": "feeds_into",
      "description": "outputs sink_map consumed by ival-xss-output-encoding"
    }
  ]
}
