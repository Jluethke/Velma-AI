{
  "name": "race-apply-fix",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "concurrency",
    "bug-fix",
    "git",
    "race-condition",
    "code-change"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "sync_design",
    "lock_order_spec",
    "regression_test"
  ],
  "outputs": [
    "fix_patch"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Applies the chosen synchronization design and lock order to one race site per change, runs the regression test and the stack's detector after every edit, and refuses the fixes that only hide races (sleeps, retries, wider timeouts, skipped tests, disabled detectors).",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "fed_by",
      "description": "provides sync_design needed here"
    },
    {
      "flow_name": "race-deterministic-regression-test",
      "relationship": "fed_by",
      "description": "provides regression_test needed here"
    },
    {
      "flow_name": "race-stress-verify",
      "relationship": "feeds_into",
      "description": "outputs fix_patch consumed by race-stress-verify"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "fed_by",
      "description": "provides lock_order_spec needed here"
    }
  ]
}
