{
  "name": "cwv-rum-p75-analysis",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "web-performance",
    "rum",
    "p75",
    "sql"
  ],
  "inputs": [
    "rum_data_export",
    "rum_attribution_schema",
    "rum_min_samples"
  ],
  "outputs": [
    "rum_p75_report",
    "top_offenders"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Aggregate exported web-vitals beacons into p75 per metric, page template and device class with SQL, and rank the attribution targets that drive the p75.",
  "related_flows": [
    {
      "flow_name": "cwv-field-crux-baseline",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "cwv-rum-web-vitals-setup",
      "relationship": "fed_by",
      "description": "provides rum_attribution_schema needed here"
    },
    {
      "flow_name": "cwv-verify-field-improvement",
      "relationship": "feeds_into",
      "description": "outputs rum_p75_report consumed by cwv-verify-field-improvement"
    },
    {
      "flow_name": "cwv-inp-loaf-attribution",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cwv-inp-interaction-profile",
      "relationship": "feeds_into",
      "description": "outputs rum_p75_report consumed by cwv-inp-interaction-profile"
    },
    {
      "flow_name": "cwv-inp-yield-long-tasks",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cwv-inp-react-render-cost",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cwv-cls-shift-sources",
      "relationship": "feeds_into",
      "description": "outputs rum_p75_report consumed by cwv-cls-shift-sources"
    }
  ]
}
