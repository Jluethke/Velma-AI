{
  "name": "pft-py-hypothesis-strategies",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "python",
    "hypothesis",
    "strategies",
    "property-testing",
    "pytest"
  ],
  "inputs": [
    "property_catalog",
    "hypothesis_config",
    "repo_path"
  ],
  "outputs": [
    "py_property_tests"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write Hypothesis strategies and @given property tests for each cataloged Python property, choosing builds, composite, map and filter by explicit rules.",
  "related_flows": [
    {
      "flow_name": "pft-invariant-discovery",
      "relationship": "fed_by",
      "description": "provides property_catalog needed here"
    },
    {
      "flow_name": "pft-py-hypothesis-setup",
      "relationship": "fed_by",
      "description": "provides hypothesis_config needed here"
    },
    {
      "flow_name": "pft-py-hypothesis-stateful",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pft-py-hypothesis-health-checks",
      "relationship": "feeds_into",
      "description": "outputs py_property_tests consumed by pft-py-hypothesis-health-checks"
    },
    {
      "flow_name": "pft-shrinking-reproduction",
      "relationship": "feeds_into",
      "description": "outputs py_property_tests consumed by pft-shrinking-reproduction"
    },
    {
      "flow_name": "pft-fuzz-target-selection",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pft-sanitizer-builds",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pft-corpus-seeding",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
