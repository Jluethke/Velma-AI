{
  "name": "sigre-linux-canplayer-offline-replay",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "canplayer",
    "vcan",
    "replay",
    "linux"
  ],
  "inputs": [
    "capture_logs",
    "dbc_draft"
  ],
  "outputs": [
    "canplayer_replay_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Replay a CAN log onto vcan0 with physical interfaces down, prove the replay is identical, and confirm streaming DBC decode matches offline decode.",
  "related_flows": [
    {
      "flow_name": "sigre-log-normalize-convert",
      "relationship": "fed_by",
      "description": "provides capture_logs needed here"
    },
    {
      "flow_name": "sigre-dbc-entry-write",
      "relationship": "fed_by",
      "description": "provides dbc_draft needed here"
    },
    {
      "flow_name": "sigre-signal-confidence-report",
      "relationship": "feeds_into",
      "description": "outputs canplayer_replay_report consumed by sigre-signal-confidence-report"
    }
  ]
}
