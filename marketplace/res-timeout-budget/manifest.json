{
  "name": "res-timeout-budget",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "resilience",
    "timeouts",
    "deadline",
    "budget",
    "percentiles"
  ],
  "inputs": [
    "dependency_map",
    "latency_profile",
    "request_deadline_ms",
    "false_timeout_rate"
  ],
  "outputs": [
    "timeout_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Derive per-try and connect timeouts from measured latency percentiles and an accepted false-timeout rate, and check the call path fits the inbound deadline.",
  "related_flows": [
    {
      "flow_name": "res-dependency-map",
      "relationship": "fed_by",
      "description": "provides dependency_map needed here"
    },
    {
      "flow_name": "res-latency-percentiles",
      "relationship": "fed_by",
      "description": "provides latency_profile needed here"
    },
    {
      "flow_name": "res-retry-policy",
      "relationship": "feeds_into",
      "description": "outputs timeout_plan consumed by res-retry-policy"
    },
    {
      "flow_name": "res-breaker-policy",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "res-bulkhead-partition",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "res-toxiproxy-faults",
      "relationship": "feeds_into",
      "description": "outputs timeout_plan consumed by res-toxiproxy-faults"
    },
    {
      "flow_name": "res-resilience-verify",
      "relationship": "feeds_into",
      "description": "outputs timeout_plan consumed by res-resilience-verify"
    },
    {
      "flow_name": "res-py-timeouts",
      "relationship": "feeds_into",
      "description": "outputs timeout_plan consumed by res-py-timeouts"
    }
  ]
}
