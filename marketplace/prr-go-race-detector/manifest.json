{
  "name": "prr-go-race-detector",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "go",
    "race-detector",
    "concurrency",
    "testing"
  ],
  "inputs": [
    "repo_dir",
    "changed_files",
    "findings_dir",
    "race_count"
  ],
  "outputs": [
    "race_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run changed Go packages' tests uncached under go test -race, read each data race report's two stacks, and attribute each race to PR-changed or existing lines.",
  "related_flows": [
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides changed_files needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-correctness-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-go-static-checks",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-test-revert-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-go-gosec-govulncheck",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
