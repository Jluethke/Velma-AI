{
  "name": "trademark-risk-report",
  "version": "1.0.0",
  "domain": "legal",
  "tags": [
    "trademark",
    "clearance-opinion",
    "risk-report",
    "attorney-brief",
    "ip-clearance"
  ],
  "fabric": false,
  "inputs": [
    "exact_matches",
    "phonetic_neighbors",
    "visual_similarities",
    "common_law_conflict_candidates",
    "international_conflict_candidates",
    "likelihood_of_confusion_rating",
    "dupont_factor_table",
    "proposed_mark",
    "proposed_goods_services"
  ],
  "outputs": [
    "overall_risk_level",
    "per_conflict_risk_breakdown",
    "action_recommendations",
    "attorney_review_flags",
    "clearance_opinion_brief",
    "filing_strategy_notes"
  ],
  "execution_pattern": "linear",
  "price": "0",
  "license": "OPEN",
  "description": "Synthesizes USPTO, common-law, international, and DuPont-factor outputs into a single attorney-ready preliminary clearance opinion brief. Produces overall risk level (low/medium/high/blocker), per-conflict actions (proceed / modify / settle / abandon), and specific flags for attorney manual review. Explicitly NOT a substitute for a formal clearance opinion from a licensed trademark attorney.",
  "related_flows": [
    {
      "flow_name": "trademark-uspto-search",
      "relationship": "fed_by",
      "description": "provides phonetic_neighbors, visual_similarities, exact_matches needed here"
    },
    {
      "flow_name": "trademark-common-law-search",
      "relationship": "fed_by",
      "description": "provides common_law_conflict_candidates needed here"
    },
    {
      "flow_name": "trademark-international-search",
      "relationship": "fed_by",
      "description": "provides international_conflict_candidates needed here"
    },
    {
      "flow_name": "trademark-similarity-analysis",
      "relationship": "fed_by",
      "description": "provides likelihood_of_confusion_rating, dupont_factor_table needed here"
    }
  ]
}
