{
  "name": "bill-stripe-catalog-setup",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "billing",
    "stripe",
    "prices",
    "products",
    "stripe-cli"
  ],
  "inputs": [
    "pricing_spec",
    "stripe_api_version"
  ],
  "outputs": [
    "price_catalog"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Create Stripe Products and Prices with lookup keys from the pricing spec using the Stripe CLI and verify each price against the spec's worked examples.",
  "related_flows": [
    {
      "flow_name": "bill-pricing-model-spec",
      "relationship": "fed_by",
      "description": "provides pricing_spec needed here"
    },
    {
      "flow_name": "bill-py-webhook-endpoint",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "bill-node-webhook-endpoint",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "bill-subscription-trial",
      "relationship": "feeds_into",
      "description": "outputs price_catalog consumed by bill-subscription-trial"
    },
    {
      "flow_name": "bill-plan-change-proration",
      "relationship": "feeds_into",
      "description": "outputs price_catalog consumed by bill-plan-change-proration"
    },
    {
      "flow_name": "bill-stripe-tax-setup",
      "relationship": "feeds_into",
      "description": "outputs price_catalog consumed by bill-stripe-tax-setup"
    },
    {
      "flow_name": "bill-tax-avatax-branch",
      "relationship": "feeds_into",
      "description": "outputs price_catalog consumed by bill-tax-avatax-branch"
    },
    {
      "flow_name": "bill-customer-portal",
      "relationship": "feeds_into",
      "description": "outputs price_catalog consumed by bill-customer-portal"
    }
  ]
}
