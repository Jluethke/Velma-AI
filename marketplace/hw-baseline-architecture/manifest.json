{
  "name": "hw-baseline-architecture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "architecture",
    "baseline",
    "efficiency"
  ],
  "inputs": [
    "board_spec",
    "critical_circuits"
  ],
  "outputs": [
    "baseline_architecture",
    "baseline_metrics"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Assemble the conventional board design from cited vendor reference designs and compute its efficiency, dissipation, part count, cost, area, and layer count as the baseline to beat.",
  "related_flows": [
    {
      "flow_name": "hw-architecture-candidates",
      "relationship": "feeds_into",
      "description": "outputs baseline_architecture consumed by hw-architecture-candidates"
    },
    {
      "flow_name": "hw-architecture-scoring",
      "relationship": "feeds_into",
      "description": "outputs baseline_metrics, baseline_architecture consumed by hw-architecture-scoring"
    },
    {
      "flow_name": "hw-critical-circuit-flagging",
      "relationship": "fed_by",
      "description": "provides critical_circuits needed here"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "fed_by",
      "description": "provides board_spec needed here"
    },
    {
      "flow_name": "pcb-layout-metrics",
      "relationship": "feeds_into",
      "description": "outputs baseline_metrics consumed by pcb-layout-metrics"
    },
    {
      "flow_name": "hw-design-delta-report",
      "relationship": "feeds_into",
      "description": "outputs baseline_metrics consumed by hw-design-delta-report"
    }
  ]
}
