{
  "name": "dup-rollback-plan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rollback",
    "migrations",
    "release-safety",
    "dependencies"
  ],
  "inputs": [
    "upgrade_scope",
    "baseline_report",
    "upgrade_plan"
  ],
  "outputs": [
    "rollback_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write and rehearse the per-commit rollback for a dependency upgrade, including one-way changes such as database migrations, data formats and runtime images.",
  "related_flows": [
    {
      "flow_name": "dup-scope-intake",
      "relationship": "fed_by",
      "description": "provides upgrade_scope needed here"
    },
    {
      "flow_name": "dup-baseline-snapshot",
      "relationship": "fed_by",
      "description": "provides baseline_report needed here"
    },
    {
      "flow_name": "dup-changelog-triage",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dup-upgrade-order-plan",
      "relationship": "fed_by",
      "description": "provides upgrade_plan needed here"
    },
    {
      "flow_name": "dup-apply-one-bump",
      "relationship": "feeds_into",
      "description": "outputs rollback_plan consumed by dup-apply-one-bump"
    },
    {
      "flow_name": "dup-verify-and-pr",
      "relationship": "feeds_into",
      "description": "outputs rollback_plan consumed by dup-verify-and-pr"
    },
    {
      "flow_name": "dup-py-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "dup-node-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
