{
  "name": "perf-node-clinic-0x-flame",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "performance",
    "node",
    "0x",
    "clinic",
    "autocannon"
  ],
  "inputs": [
    "workload_spec",
    "repo_path"
  ],
  "outputs": [
    "node_flame_profile"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
