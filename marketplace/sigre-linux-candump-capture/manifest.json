{
  "name": "sigre-linux-candump-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "candump",
    "can-utils",
    "linux",
    "data-capture"
  ],
  "inputs": [
    "socketcan_interface",
    "capture_plan"
  ],
  "outputs": [
    "candump_logs"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Record the idle baseline and labeled action segments with candump -l on a listen-only SocketCAN interface and check logs for drops and gaps.",
  "related_flows": [
    {
      "flow_name": "sigre-scope-owned-vehicle-readonly",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sigre-capture-plan-labeled-actions",
      "relationship": "fed_by",
      "description": "provides capture_plan needed here"
    },
    {
      "flow_name": "sigre-linux-socketcan-listen-only-setup",
      "relationship": "fed_by",
      "description": "provides socketcan_interface needed here"
    },
    {
      "flow_name": "sigre-log-normalize-convert",
      "relationship": "feeds_into",
      "description": "outputs candump_logs consumed by sigre-log-normalize-convert"
    },
    {
      "flow_name": "sigre-baseline-idle-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sigre-linux-cansniffer-isolate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
