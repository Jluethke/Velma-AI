{
  "name": "mex-table-ownership-map",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "monolith-decomposition",
    "database",
    "data-ownership",
    "postgres",
    "mysql"
  ],
  "inputs": [
    "repo_path",
    "extraction_brief",
    "seam_map",
    "database_engine"
  ],
  "outputs": [
    "table_ownership",
    "shared_tables"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Assign every table the candidate touches to one owner from code references, statement statistics and the foreign key catalog, and list shared-table problems.",
  "related_flows": [
    {
      "flow_name": "mex-extraction-candidate-brief",
      "relationship": "fed_by",
      "description": "provides extraction_brief needed here"
    },
    {
      "flow_name": "mex-change-coupling-git-log",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "mex-seam-identification",
      "relationship": "fed_by",
      "description": "provides seam_map needed here"
    },
    {
      "flow_name": "mex-characterization-tests",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "mex-interface-boundary-contract",
      "relationship": "feeds_into",
      "description": "outputs table_ownership consumed by mex-interface-boundary-contract"
    },
    {
      "flow_name": "mex-in-process-or-service-decision",
      "relationship": "feeds_into",
      "description": "outputs shared_tables consumed by mex-in-process-or-service-decision"
    },
    {
      "flow_name": "mex-py-import-graph-pydeps",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mex-node-import-graph-madge",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
