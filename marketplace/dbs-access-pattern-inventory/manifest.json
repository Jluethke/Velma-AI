{
  "name": "dbs-access-pattern-inventory",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "database",
    "schema-design",
    "access-patterns",
    "requirements"
  ],
  "inputs": [
    "feature_spec",
    "repo_path",
    "query_log",
    "stack"
  ],
  "outputs": [
    "access_patterns",
    "entity_list"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Capture every read and write the application makes as a numbered access-pattern table with filters, sort, pagination, cardinality and frequency source, plus the candidate entity list.",
  "related_flows": [
    {
      "flow_name": "dbs-entity-relationship-model",
      "relationship": "feeds_into",
      "description": "outputs access_patterns, entity_list consumed by dbs-entity-relationship-model"
    },
    {
      "flow_name": "dbs-normalize-to-3nf",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-denormalize-decision",
      "relationship": "feeds_into",
      "description": "outputs access_patterns consumed by dbs-denormalize-decision"
    },
    {
      "flow_name": "dbs-primary-key-strategy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-constraints-foreign-keys",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-index-from-access-patterns",
      "relationship": "feeds_into",
      "description": "outputs access_patterns consumed by dbs-index-from-access-patterns"
    }
  ]
}
