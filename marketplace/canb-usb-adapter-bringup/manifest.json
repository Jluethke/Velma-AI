{
  "name": "canb-usb-adapter-bringup",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "socketcan",
    "gs_usb",
    "slcan",
    "linux"
  ],
  "inputs": [
    "adapter_type",
    "usb_device_hint"
  ],
  "outputs": [
    "can_netdev",
    "adapter_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Bring a USB CAN adapter up as a SocketCAN device with gs_usb or slcand and record its FD, error frame and timestamp support.",
  "related_flows": [
    {
      "flow_name": "canb-tx-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "canb-termination-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "canb-bit-timing-calc",
      "relationship": "feeds_into",
      "description": "outputs can_netdev, adapter_report consumed by canb-bit-timing-calc"
    },
    {
      "flow_name": "canb-socketcan-link-up",
      "relationship": "feeds_into",
      "description": "outputs can_netdev consumed by canb-socketcan-link-up"
    },
    {
      "flow_name": "canb-candump-capture",
      "relationship": "feeds_into",
      "description": "outputs can_netdev consumed by canb-candump-capture"
    },
    {
      "flow_name": "canb-error-frame-diagnosis",
      "relationship": "feeds_into",
      "description": "outputs can_netdev consumed by canb-error-frame-diagnosis"
    },
    {
      "flow_name": "canb-busoff-recovery",
      "relationship": "feeds_into",
      "description": "outputs can_netdev consumed by canb-busoff-recovery"
    },
    {
      "flow_name": "canb-canbusload-measure",
      "relationship": "feeds_into",
      "description": "outputs can_netdev consumed by canb-canbusload-measure"
    }
  ]
}
