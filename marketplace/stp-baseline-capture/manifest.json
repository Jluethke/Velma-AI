{
  "name": "stp-baseline-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "baseline",
    "verify-card",
    "preexisting-failures",
    "small-model"
  ],
  "inputs": [
    "py_verify_commands",
    "node_verify_commands",
    "go_verify_commands",
    "rust_verify_commands",
    "java_verify_commands",
    "goal_check",
    "scratch_log",
    "repo_path"
  ],
  "outputs": [
    "verify_card",
    "baseline_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run every verify command on the untouched tree, record exit codes and pre-existing failures, and confirm the goal check fails today.",
  "related_flows": [
    {
      "flow_name": "stp-goal-to-runnable-check",
      "relationship": "fed_by",
      "description": "provides goal_check needed here"
    },
    {
      "flow_name": "stp-scratch-log-start",
      "relationship": "fed_by",
      "description": "provides scratch_log needed here"
    },
    {
      "flow_name": "stp-rg-symbol-search",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "stp-context-read-budget",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "stp-decompose-small-edits",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "stp-edit-plan-write",
      "relationship": "feeds_into",
      "description": "outputs verify_card consumed by stp-edit-plan-write"
    },
    {
      "flow_name": "stp-cli-flag-exists-check",
      "relationship": "feeds_into",
      "description": "outputs verify_card consumed by stp-cli-flag-exists-check"
    },
    {
      "flow_name": "stp-edit-plan-lock",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
