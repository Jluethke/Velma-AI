{
  "name": "k8s-flux-kustomization",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "flux",
    "gitops",
    "helmrelease"
  ],
  "inputs": [
    "chart_dir",
    "kustomize_dir",
    "gitops_repo_url",
    "namespace",
    "app_name",
    "lint_report"
  ],
  "outputs": [
    "flux_resources"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Connect the overlay or chart to Flux with a GitRepository and a Kustomization or HelmRelease that waits for health, and prove readiness.",
  "related_flows": [
    {
      "flow_name": "k8s-helm-vs-kustomize-decision",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-helm-chart-build",
      "relationship": "fed_by",
      "description": "provides chart_dir needed here"
    },
    {
      "flow_name": "k8s-kustomize-overlays",
      "relationship": "fed_by",
      "description": "provides kustomize_dir needed here"
    },
    {
      "flow_name": "k8s-kubeconform-validate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-kube-linter-check",
      "relationship": "fed_by",
      "description": "provides lint_report needed here"
    },
    {
      "flow_name": "k8s-argocd-application",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-rollout-status-watch",
      "relationship": "feeds_into",
      "description": "outputs flux_resources consumed by k8s-rollout-status-watch"
    }
  ]
}
