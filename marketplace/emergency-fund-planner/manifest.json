{
  "name": "emergency-fund-planner",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "emergency",
    "fund",
    "planner"
  ],
  "inputs": [
    "current_emergency_fund_balance",
    "emergency_fund_target",
    "monthly_surplus_deficit",
    "total_monthly_expenses"
  ],
  "outputs": [
    "emergency_fund_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process current_emergency_fund_balance, emergency_fund_target, monthly_surplus_deficit to produce emergency_fund_plan.",
  "related_flows": [
    {
      "flow_name": "expense-analyzer",
      "relationship": "fed_by",
      "description": "provides monthly_surplus_deficit needed here"
    },
    {
      "flow_name": "zero-based-budget-builder",
      "relationship": "feeds_into",
      "description": "outputs emergency_fund_plan consumed by zero-based-budget-builder"
    },
    {
      "flow_name": "financial-timeline-report-generator",
      "relationship": "feeds_into",
      "description": "outputs emergency_fund_plan consumed by financial-timeline-report-generator"
    }
  ]
}
