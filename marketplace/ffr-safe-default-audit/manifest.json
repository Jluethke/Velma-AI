{
  "name": "ffr-safe-default-audit",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "safe-defaults",
    "fault-injection",
    "fail-safe",
    "audit"
  ],
  "inputs": [
    "flag_spec",
    "repo_path",
    "py_flag_wiring",
    "node_flag_wiring",
    "go_flag_wiring",
    "java_flag_wiring",
    "react_flag_wiring"
  ],
  "outputs": [
    "default_audit"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Find every evaluation of a flag, check each passes the type-correct safe default, and prove by fault injection that the default is served when the provider fails.",
  "related_flows": [
    {
      "flow_name": "ffr-flag-type-classify",
      "relationship": "fed_by",
      "description": "provides flag_spec needed here"
    },
    {
      "flow_name": "ffr-provider-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-flagd-local-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-py-openfeature-wire",
      "relationship": "fed_by",
      "description": "provides py_flag_wiring needed here"
    },
    {
      "flow_name": "ffr-both-paths-test",
      "relationship": "feeds_into",
      "description": "outputs default_audit consumed by ffr-both-paths-test"
    },
    {
      "flow_name": "ffr-node-openfeature-wire",
      "relationship": "fed_by",
      "description": "provides node_flag_wiring needed here"
    },
    {
      "flow_name": "ffr-go-openfeature-wire",
      "relationship": "fed_by",
      "description": "provides go_flag_wiring needed here"
    },
    {
      "flow_name": "ffr-java-openfeature-wire",
      "relationship": "fed_by",
      "description": "provides java_flag_wiring needed here"
    }
  ]
}
