{
  "name": "res-latency-percentiles",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "resilience",
    "latency",
    "percentiles",
    "prometheus",
    "k6"
  ],
  "inputs": [
    "dependency_map",
    "metrics_source",
    "measurement_window"
  ],
  "outputs": [
    "latency_profile"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure p50 to p99.9 latency, peak rate and error rate per dependency from Prometheus client histograms aggregated by bucket, or from a k6 run when no histogram exists.",
  "related_flows": [
    {
      "flow_name": "res-dependency-map",
      "relationship": "fed_by",
      "description": "provides dependency_map needed here"
    },
    {
      "flow_name": "res-timeout-budget",
      "relationship": "feeds_into",
      "description": "outputs latency_profile consumed by res-timeout-budget"
    },
    {
      "flow_name": "res-retry-policy",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "res-breaker-policy",
      "relationship": "feeds_into",
      "description": "outputs latency_profile consumed by res-breaker-policy"
    },
    {
      "flow_name": "res-bulkhead-partition",
      "relationship": "feeds_into",
      "description": "outputs latency_profile consumed by res-bulkhead-partition"
    },
    {
      "flow_name": "res-toxiproxy-faults",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "res-resilience-verify",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "res-py-timeouts",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
