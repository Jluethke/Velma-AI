{
  "name": "rel-go-reproducible-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "go",
    "reproducible-builds",
    "trimpath",
    "goreleaser"
  ],
  "inputs": [
    "repo_path",
    "release_tag",
    "target_platforms"
  ],
  "outputs": [
    "go_dist",
    "go_repro_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Cross-compile Go release binaries with -trimpath and a pinned toolchain twice and prove the binaries are bit-identical.",
  "related_flows": [
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "fed_by",
      "description": "provides release_tag needed here"
    },
    {
      "flow_name": "rel-container-image-build-push",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "feeds_into",
      "description": "outputs go_dist consumed by rel-slsa-provenance-attest"
    },
    {
      "flow_name": "rel-cosign-sign-verify",
      "relationship": "feeds_into",
      "description": "outputs go_dist consumed by rel-cosign-sign-verify"
    },
    {
      "flow_name": "rel-go-publish-module-proxy",
      "relationship": "feeds_into",
      "description": "outputs go_dist consumed by rel-go-publish-module-proxy"
    }
  ]
}
