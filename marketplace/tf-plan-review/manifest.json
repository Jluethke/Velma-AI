{
  "name": "tf-plan-review",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "terraform",
    "iac",
    "plan-review",
    "jq"
  ],
  "inputs": [
    "root_modules",
    "env_strategy",
    "target_environment"
  ],
  "outputs": [
    "plan_file",
    "plan_json",
    "plan_review"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Produce a saved plan and its JSON, extract every change with jq, run a fixed checklist for stateful deletes, IAM, exposure and drift, and return a rule-based verdict.",
