      "flow_name": "tf-fmt-validate",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tf-tflint",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tf-checkov",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tf-plan-policy-conftest",
      "relationship": "feeds_into",
      "description": "outputs plan_json consumed by tf-plan-policy-conftest"
    },
    {
      "flow_name": "tf-destroy-safeguards",
      "relationship": "feeds_into",
      "description": "outputs plan_review consumed by tf-destroy-safeguards"
    },
    {
      "flow_name": "tf-secrets-handling",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tf-trivy-config",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tf-import-existing",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
