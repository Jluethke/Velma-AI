{
  "name": "sqlo-pg-explain-analyze-read",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "postgresql",
    "explain-analyze",
    "query-plan",
    "performance"
  ],
  "inputs": [
    "tuning_scope",
    "slow_query_list",
    "captured_plans"
  ],
  "outputs": [
    "plan_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run EXPLAIN ANALYZE with BUFFERS safely on slow PostgreSQL queries and record findings from a fixed list with the proving plan line.",
  "related_flows": [
    {
      "flow_name": "sqlo-sargable-rewrite",
      "relationship": "feeds_into",
      "description": "outputs plan_findings consumed by sqlo-sargable-rewrite"
    },
    {
      "flow_name": "sqlo-keyset-pagination",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-btree-composite-order",
      "relationship": "feeds_into",
      "description": "outputs plan_findings consumed by sqlo-btree-composite-order"
    },
    {
      "flow_name": "sqlo-index-write-cost",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-prod-like-verify",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-baseline-scope",
      "relationship": "fed_by",
      "description": "provides tuning_scope needed here"
    },
    {
      "flow_name": "sqlo-pg-stat-statements-capture",
      "relationship": "fed_by",
      "description": "provides slow_query_list needed here"
    },
    {
      "flow_name": "sqlo-pg-auto-explain-capture",
      "relationship": "fed_by",
      "description": "provides captured_plans needed here"
    }
  ]
}
