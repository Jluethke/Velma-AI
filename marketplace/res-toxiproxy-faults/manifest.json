{
  "name": "res-toxiproxy-faults",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "resilience",
    "fault-injection",
    "toxiproxy",
    "testing",
    "verification"
  ],
  "inputs": [
    "dependency_map",
    "timeout_plan",
    "breaker_policy"
  ],
  "outputs": [
    "fault_results"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run a fixed Toxiproxy fault matrix per dependency under load and judge observed timeouts, retries, breakers and fallbacks against the plans.",
  "related_flows": [
    {
      "flow_name": "res-dependency-map",
      "relationship": "fed_by",
      "description": "provides dependency_map needed here"
    },
    {
      "flow_name": "res-latency-percentiles",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "res-timeout-budget",
      "relationship": "fed_by",
      "description": "provides timeout_plan needed here"
    },
    {
      "flow_name": "res-retry-policy",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "res-breaker-policy",
      "relationship": "fed_by",
      "description": "provides breaker_policy needed here"
    },
    {
      "flow_name": "res-resilience-verify",
      "relationship": "feeds_into",
      "description": "outputs fault_results consumed by res-resilience-verify"
    },
    {
      "flow_name": "res-bulkhead-partition",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "res-graceful-degradation",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
