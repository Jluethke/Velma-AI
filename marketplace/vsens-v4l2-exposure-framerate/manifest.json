{
  "name": "vsens-v4l2-exposure-framerate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "camera",
    "v4l2",
    "exposure",
    "frame-rate",
    "udev"
  ],
  "inputs": [
    "camera_device_report",
    "target_frame_rate",
    "max_exposure_us"
  ],
  "outputs": [
    "camera_control_settings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Set manual V4L2 exposure inside the frame period, disable dynamic frame rate, persist it with udev, and prove the rate holds in dark and bright scenes.",
  "related_flows": [
    {
      "flow_name": "vsens-sensor-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-gmsl-csi-bringup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-v4l2-camera-probe",
      "relationship": "fed_by",
      "description": "provides camera_device_report needed here"
    },
    {
      "flow_name": "vsens-gstreamer-capture-pipeline",
      "relationship": "feeds_into",
      "description": "outputs camera_control_settings consumed by vsens-gstreamer-capture-pipeline"
    },
    {
      "flow_name": "vsens-cpp-v4l2-mmap-capture",
      "relationship": "feeds_into",
      "description": "outputs camera_control_settings consumed by vsens-cpp-v4l2-mmap-capture"
    },
    {
      "flow_name": "vsens-py-opencv-intrinsics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-cpp-opencv-intrinsics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-ros2-camera-calibrator",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
