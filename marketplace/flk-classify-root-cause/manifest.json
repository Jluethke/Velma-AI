{
  "name": "flk-classify-root-cause",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "flaky-tests",
    "classification",
    "root-cause",
    "decision-table"
  ],
  "inputs": [
    "flake_evidence",
    "py_flake_rate_report",
    "node_flake_rate_report",
    "go_flake_rate_report",
    "py_order_report",
    "node_order_report",
    "go_order_report",
    "go_race_report",
    "tz_matrix_report",
    "stack"
  ],
  "outputs": [
    "flake_class",
    "root_cause_evidence",
    "baseline_command",
    "baseline_rate"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Classify a flaky test into exactly one failure class with a signature decision table, and fix the baseline command and rate the fix is verified against.",
  "related_flows": [
    {
      "flow_name": "flk-flake-evidence-intake",
      "relationship": "fed_by",
      "description": "provides flake_evidence needed here"
    },
    {
      "flow_name": "flk-run-count-derive",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "flk-verify-same-count",
      "relationship": "feeds_into",
      "description": "outputs baseline_command, baseline_rate consumed by flk-verify-same-count"
    },
    {
      "flow_name": "flk-tz-locale-matrix-detect",
      "relationship": "fed_by",
      "description": "provides tz_matrix_report needed here"
    },
    {
      "flow_name": "flk-random-seed-pin",
      "relationship": "feeds_into",
      "description": "outputs baseline_command, flake_class, root_cause_evidence consumed by flk-random-seed-pin"
    },
    {
      "flow_name": "flk-network-stub-isolate",
      "relationship": "feeds_into",
      "description": "outputs baseline_command, flake_class, root_cause_evidence consumed by flk-network-stub-isolate"
    },
    {
      "flow_name": "flk-ci-shuffle-guard",
      "relationship": "feeds_into",
      "description": "outputs baseline_command consumed by flk-ci-shuffle-guard"
    },
    {
      "flow_name": "flk-py-repeat-measure",
      "relationship": "fed_by",
      "description": "provides py_flake_rate_report needed here"
    }
  ]
}
