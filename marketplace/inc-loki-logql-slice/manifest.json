{
  "name": "inc-loki-logql-slice",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "incident-response",
    "loki",
    "logql",
    "logcli",
    "logs"
  ],
  "inputs": [
    "incident_record",
    "metric_findings",
    "loki_selector"
  ],
  "outputs": [
    "loki_log_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Use logcli and LogQL to count errors per minute, find error messages new since the onset, and extract trace IDs for correlation.",
  "related_flows": [
    {
      "flow_name": "inc-promql-red-triage",
      "relationship": "fed_by",
      "description": "provides metric_findings needed here"
    },
    {
      "flow_name": "inc-change-correlation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-cloudwatch-insights-slice",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-trace-tempo-traceql",
      "relationship": "feeds_into",
      "description": "outputs loki_log_findings consumed by inc-trace-tempo-traceql"
    },
    {
      "flow_name": "inc-hypothesis-draft",
      "relationship": "feeds_into",
      "description": "outputs loki_log_findings consumed by inc-hypothesis-draft"
    },
    {
      "flow_name": "inc-k8s-safe-debug-access",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-py-spy-dump",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-node-diagnostic-report",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
