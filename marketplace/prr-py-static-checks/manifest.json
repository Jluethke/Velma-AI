{
  "name": "prr-py-static-checks",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "python",
    "ruff",
    "mypy",
    "static-analysis"
  ],
  "inputs": [
    "repo_dir",
    "base_branch",
    "changed_files",
    "findings_dir"
  ],
  "outputs": [
    "py_static_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run the project's Ruff and mypy or Pyright config on PR head and merge base, report only new diagnostics on changed lines, and audit new type ignores.",
  "related_flows": [
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides changed_files needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-correctness-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-test-revert-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-py-diff-coverage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-py-mutmut-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
