{
  "name": "s2i-bcp14-keyword-scan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "spec",
    "rfc2119",
    "rfc8174",
    "bcp14",
    "requirements"
  ],
  "inputs": [
    "spec_bundle",
    "errata_log"
  ],
  "outputs": [
    "keyword_hits",
    "keyword_convention"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Determine the spec's requirement keyword convention and locate every normative keyword sentence by grep or RFCXML XPath.",
  "related_flows": [
    {
      "flow_name": "s2i-spec-acquire-pin",
      "relationship": "fed_by",
      "description": "provides spec_bundle needed here"
    },
    {
      "flow_name": "s2i-errata-check",
      "relationship": "fed_by",
      "description": "provides errata_log needed here"
    },
    {
      "flow_name": "s2i-requirements-table",
      "relationship": "feeds_into",
      "description": "outputs keyword_hits, keyword_convention consumed by s2i-requirements-table"
    },
    {
      "flow_name": "s2i-ambiguity-log",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "s2i-test-vectors-extract",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "s2i-iana-registry-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "s2i-state-machine-extract",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "s2i-conformance-test-design",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
