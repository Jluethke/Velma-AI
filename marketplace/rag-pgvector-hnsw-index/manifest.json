{
  "name": "rag-pgvector-hnsw-index",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rag",
    "pgvector",
    "postgresql",
    "hnsw",
    "vector-search"
  ],
  "inputs": [
    "chunk_config",
    "embedding_choice",
    "eval_harness",
    "database_url",
    "target_ann_recall"
  ],
  "outputs": [
    "vector_index",
    "ann_recall_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Load chunk embeddings into pgvector with binary COPY, build an HNSW index with the matching operator class, and tune hnsw.ef_search by recall against exact search.",
  "related_flows": [
    {
      "flow_name": "rag-retrieval-eval-harness",
      "relationship": "fed_by",
      "description": "provides eval_harness needed here"
    },
    {
      "flow_name": "rag-embedding-cache-content-hash",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-pg-fts-rrf-hybrid",
      "relationship": "feeds_into",
      "description": "outputs vector_index consumed by rag-pg-fts-rrf-hybrid"
    },
    {
      "flow_name": "rag-metadata-filter-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-cross-encoder-rerank",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-embedding-model-select",
      "relationship": "fed_by",
      "description": "provides embedding_choice needed here"
    },
    {
      "flow_name": "rag-chunk-size-select",
      "relationship": "fed_by",
      "description": "provides chunk_config needed here"
    },
    {
      "flow_name": "rag-py-bm25s-rrf-hybrid",
      "relationship": "feeds_into",
      "description": "outputs vector_index consumed by rag-py-bm25s-rrf-hybrid"
    }
  ]
}
