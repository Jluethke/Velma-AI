{
  "name": "a11y-axe-playwright-scan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "axe-core",
    "playwright",
    "automated-testing",
    "wcag"
  ],
  "inputs": [
    "page_inventory",
    "site_url",
    "auth_state"
  ],
  "outputs": [
    "axe_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Runs axe-core through `@axe-core/playwright` against every row of the page inventory with the WCAG 2.0, 2.1 and 2.2 A and AA rule tags, including pages reached through setup steps, and records violations and \"incomplete\" (needs review) results separately.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "fed_by",
      "description": "provides page_inventory needed here"
    },
    {
      "flow_name": "a11y-scan-merge-dedupe",
      "relationship": "feeds_into",
      "description": "outputs axe_findings consumed by a11y-scan-merge-dedupe"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "a11y-lighthouse-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-pa11y-ci-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-color-contrast-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-fix-plan-by-criterion",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-react-fix-and-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
