{
  "name": "evh-cost-latency-tracking",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "llm-evaluation",
    "cost",
    "latency",
    "tokens",
    "percentiles"
  ],
  "inputs": [
    "scored_results",
    "price_table",
    "project_dir"
  ],
  "outputs": [
    "cost_latency_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Price every eval request from returned token usage and report time to first token and total latency percentiles with method, n and concurrency.",
  "related_flows": [
    {
      "flow_name": "evh-results-normalize",
      "relationship": "fed_by",
      "description": "provides scored_results needed here"
    },
    {
      "flow_name": "evh-repeat-variance-epochs",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "evh-sample-size-confidence-intervals",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "evh-regression-diff-triage",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "evh-eval-report",
      "relationship": "feeds_into",
      "description": "outputs cost_latency_report consumed by evh-eval-report"
    },
    {
      "flow_name": "evh-task-rubric-spec",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "evh-trace-error-analysis",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "evh-test-set-stratify",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
