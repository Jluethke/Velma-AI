{
  "name": "tsp-coverage-parity-gate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "testing",
    "coverage",
    "quality-gate",
    "regression",
    "parity"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "coverage_baseline",
    "baseline_report",
    "parallel_command",
    "shard_config"
  ],
  "outputs": [
    "coverage_verdict"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Prove speed work kept coverage and test strength constant by comparing covered lines, tests, skips and assertions with the baseline.",
  "related_flows": [
    {
      "flow_name": "tsp-baseline-lock",
      "relationship": "fed_by",
      "description": "provides baseline_report, coverage_baseline needed here"
    },
    {
      "flow_name": "tsp-speedup-report",
      "relationship": "feeds_into",
      "description": "outputs coverage_verdict consumed by tsp-speedup-report"
    },
    {
      "flow_name": "tsp-hotspot-classify",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "tsp-pg-template-clone",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "tsp-pyramid-inventory",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsp-pyramid-push-down",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsp-order-isolation-check",
      "relationship": "fed_by",
      "description": "provides parallel_command needed here"
    },
    {
      "flow_name": "tsp-py-durations-report",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
