{
  "name": "canb-isotp-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "iso-tp",
    "isotpdump",
    "uds",
    "diagnostics"
  ],
  "inputs": [
    "can_netdev",
    "isotp_ids",
    "candump_log"
  ],
  "outputs": [
    "isotp_transcript"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Passively capture ISO-TP traffic with isotpdump, classify single, first, consecutive and flow control frames and reassemble payloads.",
  "related_flows": [
    {
      "flow_name": "canb-tx-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-usb-adapter-bringup",
      "relationship": "fed_by",
      "description": "provides can_netdev needed here"
    },
    {
      "flow_name": "canb-termination-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-bit-timing-calc",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-socketcan-link-up",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-candump-capture",
      "relationship": "fed_by",
      "description": "provides candump_log needed here"
    },
    {
      "flow_name": "canb-cansniffer-signal-hunt",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-dbc-lint-load",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
