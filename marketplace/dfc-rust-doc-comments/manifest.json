{
  "name": "dfc-rust-doc-comments",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rust",
    "rustdoc",
    "clippy",
    "missing-docs",
    "doc-comments"
  ],
  "inputs": [
    "repo_path"
  ],
  "outputs": [
    "docstring_config",
    "docstring_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Turn on missing_docs and Clippy doc-section lints for a Rust crate and write item and crate docs with Errors, Panics, Safety and Examples sections.",
  "related_flows": [
    {
      "flow_name": "dfc-audience-doctype-plan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-readme-structure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-rust-cargo-doc-reference",
      "relationship": "feeds_into",
      "description": "outputs docstring_report consumed by dfc-rust-cargo-doc-reference"
    },
    {
      "flow_name": "dfc-rust-doctest-samples",
      "relationship": "feeds_into",
      "description": "outputs docstring_report consumed by dfc-rust-doctest-samples"
    },
    {
      "flow_name": "dfc-lychee-link-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-py-sphinx-autodoc",
      "relationship": "feeds_into",
      "description": "outputs docstring_report consumed by dfc-py-sphinx-autodoc"
    },
    {
      "flow_name": "dfc-node-typedoc-reference",
      "relationship": "feeds_into",
      "description": "outputs docstring_report consumed by dfc-node-typedoc-reference"
    },
    {
      "flow_name": "dfc-go-pkgsite-reference",
      "relationship": "feeds_into",
      "description": "outputs docstring_report consumed by dfc-go-pkgsite-reference"
    }
  ]
}
