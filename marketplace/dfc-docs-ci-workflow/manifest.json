{
  "name": "dfc-docs-ci-workflow",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ci",
    "github-actions",
    "actionlint",
    "documentation",
    "quality-gate"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "site_generator",
    "link_report",
    "markdownlint_config"
  ],
  "outputs": [
    "docs_workflow_path",
    "docs_ci_run"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Wire all docs checks into one GitHub Actions workflow, lint it with actionlint, and prove each gate is live with a mutation run.",
  "related_flows": [
    {
      "flow_name": "dfc-markdownlint-config",
      "relationship": "fed_by",
      "description": "provides markdownlint_config needed here"
    },
    {
      "flow_name": "dfc-lychee-link-check",
      "relationship": "fed_by",
      "description": "provides link_report needed here"
    }
  ]
}
