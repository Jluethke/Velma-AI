{
  "name": "parity-divergence-triage",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "parity",
    "debugging",
    "triage",
    "numerics"
  ],
  "inputs": [
    "comparison_results",
    "reference_repo",
    "port_repo",
    "env_fingerprint"
  ],
  "outputs": [
    "triage_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Find the first divergent operation for a mismatching case with hex-float checkpoints on both sides and classify its root cause before fixing.",
  "related_flows": [
    {
      "flow_name": "parity-ulp-compare",
      "relationship": "fed_by",
      "description": "provides comparison_results needed here"
    },
    {
      "flow_name": "parity-report",
      "relationship": "feeds_into",
      "description": "outputs triage_findings consumed by parity-report"
    },
    {
      "flow_name": "parity-ci-gate-github",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "parity-env-fingerprint",
      "relationship": "fed_by",
      "description": "provides env_fingerprint needed here"
    }
  ]
}
