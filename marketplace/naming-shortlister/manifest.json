{
  "name": "naming-shortlister",
  "version": "1.0.0",
  "domain": "business",
  "tags": [
    "naming",
    "shortlist",
    "decision-support",
    "buy-readiness"
  ],
  "fabric": false,
  "inputs": [
    "availability_grid",
    "score_per_candidate",
    "conflict_report",
    "weighting_config"
  ],
  "outputs": [
    "ranked_shortlist",
    "recommendation_top3",
    "buy_readiness_score"
  ],
  "execution_pattern": "linear",
  "price": "0",
  "license": "OPEN",
  "description": "Combines domain-availability signals with brand-conflict severity into a single ranked shortlist. Emits a top-3 recommendation with a buy-readiness score per candidate and a rationale for each.",
  "related_flows": [
    {
      "flow_name": "domain-availability-checker",
      "relationship": "fed_by",
      "description": "provides score_per_candidate, availability_grid needed here"
    },
    {
      "flow_name": "brand-conflict-search",
      "relationship": "fed_by",
      "description": "provides conflict_report needed here"
    }
  ]
}
