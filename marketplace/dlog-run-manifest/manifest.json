{
  "name": "dlog-run-manifest",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "logging",
    "manifest",
    "metadata",
    "provenance"
  ],
  "inputs": [
    "log_dir",
    "run_context"
  ],
  "outputs": [
    "run_manifest"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a run manifest JSON with software version, calibration hashes, configuration and drive context, and embed it in each MCAP file as metadata.",
  "related_flows": [
    {
      "flow_name": "dlog-log-validate-recover",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dlog-file-integrity-hashes",
      "relationship": "feeds_into",
      "description": "outputs run_manifest consumed by dlog-file-integrity-hashes"
    },
    {
      "flow_name": "dlog-offload-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dlog-drive-index-sqlite",
      "relationship": "feeds_into",
      "description": "outputs run_manifest consumed by dlog-drive-index-sqlite"
    }
  ]
}
