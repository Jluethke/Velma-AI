{
  "name": "xarch-python-manylinux-wheel",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "cross-compile",
    "aarch64",
    "python",
    "manylinux",
    "auditwheel"
  ],
  "inputs": [
    "project_dir",
    "manylinux_tag",
    "binfmt_state"
  ],
  "outputs": [
    "manylinux_wheel",
    "manylinux_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build an aarch64 Python wheel in the manylinux_2_28_aarch64 container under qemu and repair it with auditwheel to a portable manylinux platform tag.",
  "related_flows": [
    {
      "flow_name": "xarch-qemu-binfmt-register",
      "relationship": "fed_by",
      "description": "provides binfmt_state needed here"
    },
    {
      "flow_name": "xarch-python-cibuildwheel",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-qemu-user-run-tests",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-elf-arch-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
