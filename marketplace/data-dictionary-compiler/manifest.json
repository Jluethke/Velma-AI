{
  "name": "data-dictionary-compiler",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "data",
    "dictionary",
    "compiler"
  ],
  "inputs": [
    "business_descriptions",
    "column_metadata",
    "data_quality_notes",
    "output_format",
    "pii_flags",
    "relationships_array",
    "sample_values",
    "valid_values"
  ],
  "outputs": [
    "data_dictionary",
    "output_file"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process business_descriptions, column_metadata, data_quality_notes to produce data_dictionary, output_file.",
  "related_flows": [
    {
      "flow_name": "schema-metadata-extractor",
      "relationship": "fed_by",
      "description": "provides column_metadata needed here"
    },
    {
      "flow_name": "relationship-graph-builder",
      "relationship": "fed_by",
      "description": "provides relationships_array needed here"
    },
    {
      "flow_name": "data-sampler-with-pii-detection",
      "relationship": "fed_by",
      "description": "provides pii_flags, sample_values, data_quality_notes needed here"
    },
    {
      "flow_name": "business-context-enricher",
      "relationship": "fed_by",
      "description": "provides business_descriptions, valid_values needed here"
    },
    {
      "flow_name": "dictionary-validator",
      "relationship": "feeds_into",
      "description": "outputs data_dictionary consumed by dictionary-validator"
    }
  ]
}
