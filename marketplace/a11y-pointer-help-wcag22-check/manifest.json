{
  "name": "a11y-pointer-help-wcag22-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "pointer",
    "dragging",
    "consistent-help",
    "wcag-2.2"
  ],
  "inputs": [
    "page_inventory",
    "component_inventory",
    "repo_dir"
  ],
  "outputs": [
    "pointer_help_issues"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Checks the pointer criteria SC 2.5.1 Pointer Gestures, 2.5.2 Pointer Cancellation, 2.5.3 Label in Name, 2.5.4 Motion Actuation and the WCAG 2.2 additions SC 2.5.7 Dragging Movements and SC 3.2.6 Consistent Help, with a source search for gesture, drag and motion handlers and a cross-page comparison of help mechanism order.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "fed_by",
      "description": "provides page_inventory, component_inventory needed here"
    },
    {
      "flow_name": "a11y-focus-order-visibility-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-forms-error-messaging-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-target-size-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "feeds_into",
      "description": "outputs pointer_help_issues consumed by a11y-impact-ranking"
    }
  ]
}
