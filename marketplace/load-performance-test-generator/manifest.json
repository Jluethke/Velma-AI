{
  "name": "load-performance-test-generator",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "load",
    "performance",
    "test"
  ],
  "inputs": [
    "dependency_graph",
    "endpoint_registry",
    "include_load_tests",
    "performance_sla_ms"
  ],
  "outputs": [
    "load_test_scenarios",
    "performance_assertions"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process dependency_graph, endpoint_registry, include_load_tests to produce load_test_scenarios, performance_assertions.",
  "related_flows": [
    {
      "flow_name": "endpoint-metadata-extractor",
      "relationship": "fed_by",
      "description": "provides endpoint_registry, dependency_graph needed here"
    },
    {
      "flow_name": "test-suite-compiler",
      "relationship": "feeds_into",
      "description": "outputs load_test_scenarios consumed by test-suite-compiler"
    },
    {
      "flow_name": "test-documentation-generator",
      "relationship": "feeds_into",
      "description": "outputs performance_assertions consumed by test-documentation-generator"
    }
  ]
}
