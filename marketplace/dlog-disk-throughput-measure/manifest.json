{
  "name": "dlog-disk-throughput-measure",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "logging",
    "fio",
    "nvme",
    "iostat",
    "disk"
  ],
  "inputs": [
    "log_volume_path",
    "measured_rates"
  ],
  "outputs": [
    "disk_throughput"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure sustained sequential write throughput of the logging volume with fio past the SSD cache and compare it to the measured sensor byte rate.",
  "related_flows": [
    {
      "flow_name": "dlog-format-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dlog-sensor-rate-inventory",
      "relationship": "fed_by",
      "description": "provides measured_rates needed here"
    },
    {
      "flow_name": "dlog-storage-budget",
      "relationship": "feeds_into",
      "description": "outputs disk_throughput consumed by dlog-storage-budget"
    },
    {
      "flow_name": "dlog-drop-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
