{
  "name": "rel-container-image-build-push",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "container",
    "buildx",
    "reproducible-builds",
    "oci"
  ],
  "inputs": [
    "repo_path",
    "release_tag",
    "image_repository"
  ],
  "outputs": [
    "image_digest",
    "container_repro_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a multi-platform OCI image with BuildKit timestamp rewriting from a digest-pinned base, check it rebuilds to the same digest, and push it recording the digest.",
  "related_flows": [
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "fed_by",
      "description": "provides release_tag needed here"
    },
    {
      "flow_name": "rel-go-reproducible-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "feeds_into",
      "description": "outputs image_digest consumed by rel-slsa-provenance-attest"
    },
    {
      "flow_name": "rel-cosign-sign-verify",
      "relationship": "feeds_into",
      "description": "outputs image_digest consumed by rel-cosign-sign-verify"
    }
  ]
}
