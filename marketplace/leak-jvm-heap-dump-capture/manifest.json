{
  "name": "leak-jvm-heap-dump-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "memory-leak",
    "jvm",
    "jcmd",
    "heap-dump",
    "class-histogram"
  ],
  "inputs": [
    "leak_brief",
    "load_recipe",
    "cause_hypotheses"
  ],
  "outputs": [
    "jvm_heap_dumps",
    "jvm_histograms"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Capture and diff jcmd class histograms and two live-object heap dumps from a running JVM to find classes whose instance count grows per operation.",
  "related_flows": [
    {
      "flow_name": "leak-intake-load-recipe",
      "relationship": "fed_by",
      "description": "provides leak_brief, load_recipe needed here"
    },
    {
      "flow_name": "leak-rss-growth-confirm",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-managed-vs-native-split",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-classic-causes-triage",
      "relationship": "fed_by",
      "description": "provides cause_hypotheses needed here"
    },
    {
      "flow_name": "leak-jvm-mat-dominator-tree",
      "relationship": "feeds_into",
      "description": "outputs jvm_histograms, jvm_heap_dumps consumed by leak-jvm-mat-dominator-tree"
    },
    {
      "flow_name": "leak-jvm-native-memory-tracking",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-native-malloc-fragmentation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-root-cause-confirm",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
