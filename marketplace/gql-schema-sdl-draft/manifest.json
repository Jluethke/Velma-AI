{
  "name": "gql-schema-sdl-draft",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "graphql",
    "sdl",
    "schema-first",
    "node-interface",
    "mutations"
  ],
  "inputs": [
    "operation_inventory",
    "operation_documents",
    "existing_data_model"
  ],
  "outputs": [
    "schema_sdl"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Derive a schema-first SDL from named client operations with the Node interface and input/payload mutations, validated against every operation with graphql-inspector.",
  "related_flows": [
    {
      "flow_name": "gql-use-case-inventory",
      "relationship": "fed_by",
      "description": "provides operation_documents, operation_inventory needed here"
    },
    {
      "flow_name": "gql-nullability-review",
      "relationship": "feeds_into",
      "description": "outputs schema_sdl consumed by gql-nullability-review"
    },
    {
      "flow_name": "gql-relay-connection-schema",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-schema-lint-graphql-eslint",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-schema-breaking-diff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
