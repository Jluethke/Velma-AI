{
  "name": "rel-rust-reproducible-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "rust",
    "reproducible-builds",
    "cargo",
    "remap-path-prefix"
  ],
  "inputs": [
    "repo_path",
    "release_tag"
  ],
  "outputs": [
    "rust_dist",
    "rust_repro_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build Rust release binaries and the .crate package twice in different directories with a pinned toolchain and path remapping, and prove they are bit-identical.",
  "related_flows": [
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "fed_by",
      "description": "provides release_tag needed here"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "feeds_into",
      "description": "outputs rust_dist consumed by rel-slsa-provenance-attest"
    },
    {
      "flow_name": "rel-cosign-sign-verify",
      "relationship": "feeds_into",
      "description": "outputs rust_dist consumed by rel-cosign-sign-verify"
    },
    {
      "flow_name": "rel-rust-publish-crates",
      "relationship": "feeds_into",
      "description": "outputs rust_dist consumed by rel-rust-publish-crates"
    }
  ]
}
