{
  "name": "mlp-torch-temperature-scaling",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "calibration",
    "temperature-scaling",
    "pytorch"
  ],
  "inputs": [
    "tuned_model",
    "split_manifest",
    "calibration_report"
  ],
  "outputs": [
    "torch_calibrated_model"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Learns one temperature on held-out validation logits by minimizing negative log-likelihood with L-BFGS (Guo et al., 2017, \"On Calibration of Modern Neural Networks\"), wraps the model so it returns calibrated probabilities, and proves accuracy is unchanged while NLL and ECE improve.",
  "related_flows": [
    {
      "flow_name": "mlp-torch-seed-determinism",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-wandb-tracking",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-optuna-search",
      "relationship": "fed_by",
      "description": "provides tuned_model needed here"
    },
    {
      "flow_name": "mlp-bootstrap-metric-ci",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-calibration-diagnose",
      "relationship": "fed_by",
      "description": "provides calibration_report needed here"
    },
    {
      "flow_name": "mlp-torch-onnx-export",
      "relationship": "feeds_into",
      "description": "outputs torch_calibrated_model consumed by mlp-torch-onnx-export"
    },
    {
      "flow_name": "mlp-inference-parity-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-split-integrity-check",
      "relationship": "fed_by",
      "description": "provides split_manifest needed here"
    }
  ]
}
