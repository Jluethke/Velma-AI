{
  "name": "rag-chunk-size-select",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rag",
    "chunking",
    "evaluation",
    "token-budget",
    "selection"
  ],
  "inputs": [
    "chunk_sets",
    "embedding_choice",
    "eval_harness",
    "context_token_budget",
    "work_dir"
  ],
  "outputs": [
    "chunk_config",
    "chunk_eval_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Select chunk strategy, size and overlap by measured hit rate and MRR at equal k and at equal context token budget with paired significance tests.",
  "related_flows": [
    {
      "flow_name": "rag-retrieval-eval-harness",
      "relationship": "fed_by",
      "description": "provides eval_harness needed here"
    },
    {
      "flow_name": "rag-chunk-candidates-build",
      "relationship": "fed_by",
      "description": "provides chunk_sets needed here"
    },
    {
      "flow_name": "rag-embedding-model-select",
      "relationship": "fed_by",
      "description": "provides embedding_choice needed here"
    },
    {
      "flow_name": "rag-cross-encoder-rerank",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-failure-analysis-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-embedding-cache-content-hash",
      "relationship": "feeds_into",
      "description": "outputs chunk_config consumed by rag-embedding-cache-content-hash"
    },
    {
      "flow_name": "rag-pgvector-hnsw-index",
      "relationship": "feeds_into",
      "description": "outputs chunk_config consumed by rag-pgvector-hnsw-index"
    },
    {
      "flow_name": "rag-faiss-index-build",
      "relationship": "feeds_into",
      "description": "outputs chunk_config consumed by rag-faiss-index-build"
    }
  ]
}
