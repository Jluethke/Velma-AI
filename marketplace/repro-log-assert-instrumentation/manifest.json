{
  "name": "repro-log-assert-instrumentation",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "debugging",
    "logging",
    "assertions",
    "instrumentation"
  ],
  "inputs": [
    "regression_test",
    "repo_path",
    "stack"
  ],
  "outputs": [
    "instrumentation_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Bracket where good state turns bad with tagged temporary log and assertion probes, one file at a time, then remove every probe.",
  "related_flows": [
    {
      "flow_name": "repro-red-test-gate",
      "relationship": "fed_by",
      "description": "provides regression_test needed here"
    },
    {
      "flow_name": "repro-root-cause-confirm",
      "relationship": "feeds_into",
      "description": "outputs instrumentation_findings consumed by repro-root-cause-confirm"
    },
    {
      "flow_name": "repro-minimal-fix",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-fix-revert-proof",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-neighbor-regression-sweep",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-intake-checklist",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "repro-env-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "repro-container-env-replica",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
