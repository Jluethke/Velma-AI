{
  "name": "ledg-pg-balance-snapshots",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ledger",
    "postgresql",
    "balance",
    "snapshot",
    "period-close"
  ],
  "inputs": [
    "ledger_schema",
    "locking_strategy"
  ],
  "outputs": [
    "balance_queries"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Compute balances from postings and take period-close snapshots that a recompute query proves correct.",
  "related_flows": [
    {
      "flow_name": "ledg-pg-audit-queries",
      "relationship": "feeds_into",
      "description": "outputs balance_queries consumed by ledg-pg-audit-queries"
    },
    {
      "flow_name": "ledg-pg-double-entry-schema",
      "relationship": "fed_by",
      "description": "provides ledger_schema needed here"
    },
    {
      "flow_name": "ledg-pg-immutable-reversals",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ledg-pg-idempotent-posting",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ledg-pg-balance-locking",
      "relationship": "fed_by",
      "description": "provides locking_strategy needed here"
    },
    {
      "flow_name": "ledg-stripe-payout-reconciliation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ledg-bank-statement-reconciliation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ledg-qbo-journal-sync",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
