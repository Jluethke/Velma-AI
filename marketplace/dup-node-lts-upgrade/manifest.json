      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dup-node-outdated-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dup-node-vuln-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dup-changelog-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dup-upgrade-order-plan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
