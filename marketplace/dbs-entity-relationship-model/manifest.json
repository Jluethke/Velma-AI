{
  "name": "dbs-entity-relationship-model",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "database",
    "schema-design",
    "er-model",
    "mermaid"
  ],
  "inputs": [
    "entity_list",
    "access_patterns"
  ],
  "outputs": [
    "er_model",
    "er_diagram"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build an entity-relationship model with typed attributes, explicit cardinality, optionality and ownership, rendered as a Mermaid erDiagram traced against every access pattern.",
  "related_flows": [
    {
      "flow_name": "dbs-access-pattern-inventory",
      "relationship": "fed_by",
      "description": "provides access_patterns, entity_list needed here"
    },
    {
      "flow_name": "dbs-normalize-to-3nf",
      "relationship": "feeds_into",
      "description": "outputs er_model consumed by dbs-normalize-to-3nf"
    },
    {
      "flow_name": "dbs-denormalize-decision",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-primary-key-strategy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-constraints-foreign-keys",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-index-from-access-patterns",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
