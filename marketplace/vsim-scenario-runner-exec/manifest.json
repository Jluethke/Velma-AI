{
  "name": "vsim-scenario-runner-exec",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "carla",
    "scenario-runner",
    "openscenario",
    "junit",
    "simulation"
  ],
  "inputs": [
    "scenario_library",
    "carla_server_cmd",
    "sim_seed",
    "determinism_report"
  ],
  "outputs": [
    "scenario_results",
    "recorder_files"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run a scenario library through CARLA scenario_runner in synchronous mode and classify results and infrastructure errors.",
  "related_flows": [
    {
      "flow_name": "vsim-carla-server-setup",
      "relationship": "fed_by",
      "description": "provides carla_server_cmd needed here"
    },
    {
      "flow_name": "vsim-carla-sync-mode",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-carla-sensor-rig",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-carla-seed-determinism",
      "relationship": "fed_by",
      "description": "provides determinism_report needed here"
    },
    {
      "flow_name": "vsim-openscenario-author",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-esmini-scenario-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-fault-scenario-library",
      "relationship": "fed_by",
      "description": "provides scenario_library needed here"
    },
    {
      "flow_name": "vsim-carla-recorder-replay",
      "relationship": "feeds_into",
      "description": "outputs recorder_files consumed by vsim-carla-recorder-replay"
    }
  ]
}
