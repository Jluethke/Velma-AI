{
  "name": "cache-invalidation-strategy-select",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "caching",
    "invalidation",
    "cache-aside",
    "write-through",
    "write-behind"
  ],
  "inputs": [
    "cache_plan",
    "ttl_table",
    "consistency_requirement"
  ],
  "outputs": [
    "invalidation_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Trace every writer of cached data and choose cache-aside, write-through, write-behind, event-based or TTL-only invalidation per entry type, with after-commit ordering.",
  "related_flows": [
    {
      "flow_name": "cache-read-hotspot-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cache-location-decide",
      "relationship": "fed_by",
      "description": "provides cache_plan needed here"
    },
    {
      "flow_name": "cache-key-schema-design",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cache-ttl-from-change-rate",
      "relationship": "fed_by",
      "description": "provides ttl_table needed here"
    },
    {
      "flow_name": "cache-py-cache-aside-redis",
      "relationship": "feeds_into",
      "description": "outputs invalidation_plan consumed by cache-py-cache-aside-redis"
    },
    {
      "flow_name": "cache-stale-set-race-fix",
      "relationship": "feeds_into",
      "description": "outputs invalidation_plan consumed by cache-stale-set-race-fix"
    },
    {
      "flow_name": "cache-stampede-risk-assess",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cache-stampede-redis-lock",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
