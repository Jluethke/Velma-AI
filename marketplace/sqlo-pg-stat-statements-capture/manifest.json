{
  "name": "sqlo-pg-stat-statements-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "postgresql",
    "pg_stat_statements",
    "slow-query",
    "performance"
  ],
  "inputs": [
    "tuning_scope",
    "capture_window"
  ],
  "outputs": [
    "slow_query_list"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Enable pg_stat_statements, capture a bounded window, and rank PostgreSQL statements by total time, mean time, disk reads and temp spill.",
  "related_flows": [
    {
      "flow_name": "sqlo-sargable-rewrite",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-keyset-pagination",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-btree-composite-order",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-index-write-cost",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-prod-like-verify",
      "relationship": "feeds_into",
      "description": "outputs slow_query_list consumed by sqlo-prod-like-verify"
    },
    {
      "flow_name": "sqlo-baseline-scope",
      "relationship": "fed_by",
      "description": "provides tuning_scope needed here"
    },
    {
      "flow_name": "sqlo-pg-auto-explain-capture",
      "relationship": "feeds_into",
      "description": "outputs slow_query_list consumed by sqlo-pg-auto-explain-capture"
    },
    {
      "flow_name": "sqlo-pg-explain-analyze-read",
      "relationship": "feeds_into",
      "description": "outputs slow_query_list consumed by sqlo-pg-explain-analyze-read"
    }
  ]
}
