{
  "name": "pft-go-native-fuzz",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "go",
    "go-test-fuzz",
    "fuzzing",
    "testdata",
    "coverage-guided"
  ],
  "inputs": [
    "fuzz_targets",
    "seed_corpus",
    "repo_path",
    "fuzz_time"
  ],
  "outputs": [
    "go_fuzz_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a Go native fuzz test with testing.F, seed it with f.Add and testdata, run go test -fuzz for a fixed time and collect failing inputs.",
  "related_flows": [
    {
      "flow_name": "pft-invariant-discovery",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pft-go-rapid-properties",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pft-shrinking-reproduction",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pft-fuzz-target-selection",
      "relationship": "fed_by",
      "description": "provides fuzz_targets needed here"
    },
    {
      "flow_name": "pft-corpus-seeding",
      "relationship": "fed_by",
      "description": "provides seed_corpus needed here"
    },
    {
      "flow_name": "pft-coverage-plateau-analysis",
      "relationship": "feeds_into",
      "description": "outputs go_fuzz_findings consumed by pft-coverage-plateau-analysis"
    },
    {
      "flow_name": "pft-crash-triage-dedup",
      "relationship": "feeds_into",
      "description": "outputs go_fuzz_findings consumed by pft-crash-triage-dedup"
    },
    {
      "flow_name": "pft-crash-regression-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
