{
  "name": "sqlo-sargable-rewrite",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "sql",
    "sargability",
    "query-rewrite",
    "postgresql",
    "mysql"
  ],
  "inputs": [
    "tuning_scope",
    "plan_findings",
    "schema_ddl"
  ],
  "outputs": [
    "rewritten_queries"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Rewrite predicates that block index use into index-friendly equivalents and prove each rewrite returns the same rows.",
  "related_flows": [
    {
      "flow_name": "sqlo-keyset-pagination",
      "relationship": "feeds_into",
      "description": "outputs rewritten_queries consumed by sqlo-keyset-pagination"
    },
    {
      "flow_name": "sqlo-btree-composite-order",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "sqlo-index-write-cost",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "sqlo-prod-like-verify",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "sqlo-baseline-scope",
      "relationship": "fed_by",
      "description": "provides tuning_scope needed here"
    },
    {
      "flow_name": "sqlo-pg-stat-statements-capture",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-pg-auto-explain-capture",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-pg-explain-analyze-read",
      "relationship": "fed_by",
      "description": "provides plan_findings needed here"
    }
  ]
}
