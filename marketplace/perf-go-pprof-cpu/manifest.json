{
  "name": "perf-go-pprof-cpu",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "performance",
    "go",
    "pprof",
    "cpu-profile",
    "flame-graph"
  ],
  "inputs": [
    "workload_spec",
    "repo_path",
    "bench_command"
  ],
  "outputs": [
    "go_cpu_profile"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Capture a Go CPU profile from a benchmark or net/http/pprof and read it with pprof top, list, peek and the flame graph view.",
  "related_flows": [
    {
      "flow_name": "perf-metric-workload-define",
      "relationship": "fed_by",
      "description": "provides workload_spec needed here"
    },
    {
      "flow_name": "perf-bench-env-stabilize",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-go-bench-benchstat-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-bench-baseline-normalize",
      "relationship": "fed_by",
      "description": "provides bench_command needed here"
    },
    {
      "flow_name": "perf-flame-graph-read",
      "relationship": "feeds_into",
      "description": "outputs go_cpu_profile consumed by perf-flame-graph-read"
    },
    {
      "flow_name": "perf-hotspot-classify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-fix-algorithmic-complexity",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-go-alloc-escape-analysis",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
