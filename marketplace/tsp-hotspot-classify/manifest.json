{
  "name": "tsp-hotspot-classify",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "testing",
    "performance",
    "triage",
    "planning"
  ],
  "inputs": [
    "stack",
    "repo_path",
    "baseline_report",
    "py_duration_report",
    "node_duration_report",
    "go_duration_report",
    "py_setup_cost",
    "node_setup_cost",
    "go_setup_cost"
  ],
  "outputs": [
    "hotspot_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Merge duration and setup-cost reports into one ordered work plan where every slow test has one cause class, traced seconds and one fix flow.",
  "related_flows": [
    {
      "flow_name": "tsp-baseline-lock",
      "relationship": "fed_by",
      "description": "provides baseline_report needed here"
    },
    {
      "flow_name": "tsp-pg-template-clone",
      "relationship": "feeds_into",
      "description": "outputs hotspot_plan consumed by tsp-pg-template-clone"
    },
    {
      "flow_name": "tsp-coverage-parity-gate",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "tsp-speedup-report",
      "relationship": "feeds_into",
      "description": "outputs hotspot_plan consumed by tsp-speedup-report"
    },
    {
      "flow_name": "tsp-pyramid-inventory",
      "relationship": "feeds_into",
      "description": "outputs hotspot_plan consumed by tsp-pyramid-inventory"
    },
    {
      "flow_name": "tsp-pyramid-push-down",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsp-order-isolation-check",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsp-py-durations-report",
      "relationship": "fed_by",
      "description": "provides py_duration_report needed here"
    }
  ]
}
