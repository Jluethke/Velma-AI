{
  "name": "pcb-gerber-export",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "fabrication",
    "gerber",
    "kicad"
  ],
  "inputs": [
    "kicad_pcb",
    "drc_report",
    "board_spec"
  ],
  "outputs": [
    "fab_package",
    "board_renders"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Export a DRC-clean board to Gerbers and Excellon drill, zip for the fab, verify layer and hole counts in a viewer, and render top and bottom for orientation checks.",
  "related_flows": [
    {
      "flow_name": "pcb-assembly-files",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "fed_by",
      "description": "provides board_spec needed here"
    },
    {
      "flow_name": "pcb-drc-closure",
      "relationship": "fed_by",
      "description": "provides drc_report, kicad_pcb needed here"
    }
  ]
}
