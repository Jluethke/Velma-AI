{
  "name": "dbs-expand-contract-plan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "database",
    "migrations",
    "zero-downtime",
    "expand-contract"
  ],
  "inputs": [
    "target_ddl",
    "current_schema_dump",
    "db_engine"
  ],
  "outputs": [
    "migration_plan",
    "backfill_specs"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Diff target and current schemas, classify each change, and order it into expand, data migration and contract steps tied to application releases for zero-downtime deploys.",
  "related_flows": [
    {
      "flow_name": "dbs-rollback-plan",
      "relationship": "feeds_into",
      "description": "outputs migration_plan consumed by dbs-rollback-plan"
    },
    {
      "flow_name": "dbs-post-migration-verify",
      "relationship": "feeds_into",
      "description": "outputs migration_plan, backfill_specs consumed by dbs-post-migration-verify"
    },
    {
      "flow_name": "dbs-py-alembic-migration",
      "relationship": "feeds_into",
      "description": "outputs migration_plan consumed by dbs-py-alembic-migration"
    },
    {
      "flow_name": "dbs-py-django-migration",
      "relationship": "feeds_into",
      "description": "outputs migration_plan consumed by dbs-py-django-migration"
    },
    {
      "flow_name": "dbs-pg-ddl-lock-safety",
      "relationship": "feeds_into",
      "description": "outputs migration_plan consumed by dbs-pg-ddl-lock-safety"
    },
    {
      "flow_name": "dbs-pg-squawk-lint",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-mysql-online-ddl",
      "relationship": "feeds_into",
      "description": "outputs migration_plan consumed by dbs-mysql-online-ddl"
    },
    {
      "flow_name": "dbs-seed-data",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
