{
  "name": "s2i-requirements-table",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "spec",
    "requirements",
    "rfc2119",
    "traceability",
    "conformance"
  ],
  "inputs": [
    "spec_bundle",
    "keyword_hits",
    "keyword_convention",
    "errata_log",
    "implementation_role"
  ],
  "outputs": [
    "requirements_table"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Split normative keyword sentences into atomic requirements with stable IDs, actor, condition, behavior and role applicability.",
  "related_flows": [
    {
      "flow_name": "s2i-spec-acquire-pin",
      "relationship": "fed_by",
      "description": "provides spec_bundle needed here"
    },
    {
      "flow_name": "s2i-errata-check",
      "relationship": "fed_by",
      "description": "provides errata_log needed here"
    },
    {
      "flow_name": "s2i-bcp14-keyword-scan",
      "relationship": "fed_by",
      "description": "provides keyword_hits, keyword_convention needed here"
    },
    {
      "flow_name": "s2i-ambiguity-log",
      "relationship": "feeds_into",
      "description": "outputs requirements_table consumed by s2i-ambiguity-log"
    },
    {
      "flow_name": "s2i-test-vectors-extract",
      "relationship": "feeds_into",
      "description": "outputs requirements_table consumed by s2i-test-vectors-extract"
    },
    {
      "flow_name": "s2i-iana-registry-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "s2i-state-machine-extract",
      "relationship": "feeds_into",
      "description": "outputs requirements_table consumed by s2i-state-machine-extract"
    },
    {
      "flow_name": "s2i-conformance-test-design",
      "relationship": "feeds_into",
      "description": "outputs requirements_table consumed by s2i-conformance-test-design"
    }
  ]
}
