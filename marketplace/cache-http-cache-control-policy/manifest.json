{
  "name": "cache-http-cache-control-policy",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "caching",
    "http",
    "cache-control",
    "rfc9111",
    "vary"
  ],
  "inputs": [
    "cache_plan",
    "ttl_table",
    "repo_path"
  ],
  "outputs": [
    "header_policy"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write Cache-Control and Vary headers per route from an RFC 9111, 5861 and 8246 decision table, apply them in one layer, and verify every route with curl.",
  "related_flows": [
    {
      "flow_name": "cache-read-hotspot-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cache-location-decide",
      "relationship": "fed_by",
      "description": "provides cache_plan needed here"
    },
    {
      "flow_name": "cache-ttl-from-change-rate",
      "relationship": "fed_by",
      "description": "provides ttl_table needed here"
    },
    {
      "flow_name": "cache-http-etag-conditional-get",
      "relationship": "feeds_into",
      "description": "outputs header_policy consumed by cache-http-etag-conditional-get"
    },
    {
      "flow_name": "cache-cdn-header-verify-purge",
      "relationship": "feeds_into",
      "description": "outputs header_policy consumed by cache-cdn-header-verify-purge"
    }
  ]
}
