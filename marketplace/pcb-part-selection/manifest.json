{
  "name": "pcb-part-selection",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "parts",
    "datasheets",
    "efficiency"
  ],
  "inputs": [
    "board_spec",
    "critical_circuits",
    "selected_architecture",
    "review_changes"
  ],
  "outputs": [
    "part_candidates"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Realize the selected architecture with datasheet-justified parts meeting voltage and current margins, preferring higher efficiency and smaller packages, and apply review changes.",
  "related_flows": [
    {
      "flow_name": "eda-toolchain-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-stock-sourcing",
      "relationship": "feeds_into",
      "description": "outputs part_candidates consumed by pcb-stock-sourcing"
    },
    {
      "flow_name": "pcb-skidl-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-erc-netlist",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "hw-critical-circuit-flagging",
      "relationship": "fed_by",
      "description": "provides critical_circuits needed here"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "fed_by",
      "description": "provides board_spec needed here"
    },
    {
      "flow_name": "hw-architecture-scoring",
      "relationship": "fed_by",
      "description": "provides selected_architecture needed here"
    },
    {
      "flow_name": "pcb-review-verdict",
      "relationship": "fed_by",
      "description": "provides review_changes needed here"
    }
  ]
}
