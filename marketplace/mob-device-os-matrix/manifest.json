{
  "name": "mob-device-os-matrix",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "mobile",
    "device-matrix",
    "firebase-test-lab",
    "gradle-managed-devices",
    "simulators"
  ],
  "inputs": [
    "app_profile",
    "usage_analytics"
  ],
  "outputs": [
    "device_matrix",
    "matrix_run_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a device and OS matrix from declared floors, targets and behavior-change releases plus settings rows, and run the UI suite across it.",
  "related_flows": [
    {
      "flow_name": "mob-app-profile",
      "relationship": "fed_by",
      "description": "provides app_profile needed here"
    },
    {
      "flow_name": "mob-screen-state-machine",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "mob-network-retry-policy",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "mob-ios-crash-reporting",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "mob-android-crash-reporting",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "mob-ios-app-store-release",
      "relationship": "feeds_into",
      "description": "outputs matrix_run_report consumed by mob-ios-app-store-release"
    },
    {
      "flow_name": "mob-android-play-release",
      "relationship": "feeds_into",
      "description": "outputs matrix_run_report consumed by mob-android-play-release"
    },
    {
      "flow_name": "mob-ios-swiftui-screen",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
