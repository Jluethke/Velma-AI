    },
    {
      "flow_name": "etl-dbt-sources-staging",
      "relationship": "fed_by",
      "description": "provides staging_models needed here"
    },
    {
      "flow_name": "etl-dbt-snapshot-scd2",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "etl-dbt-tests-contracts",
