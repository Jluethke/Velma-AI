{
  "name": "tsm-migration-intake",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "migration",
    "intake",
    "typescript",
    "python"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "python_checker",
    "test_command"
  ],
  "outputs": [
    "migration_profile"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Record the stack, tool versions, checker, package manager, test command and clean git state before any strict typing migration starts.",
  "related_flows": [
    {
      "flow_name": "tsm-ts-error-baseline",
      "relationship": "feeds_into",
      "description": "outputs migration_profile consumed by tsm-ts-error-baseline"
    },
    {
      "flow_name": "tsm-ts-type-coverage",
      "relationship": "feeds_into",
      "description": "outputs migration_profile consumed by tsm-ts-type-coverage"
    },
    {
      "flow_name": "tsm-ts-ci-gate",
      "relationship": "feeds_into",
      "description": "outputs migration_profile consumed by tsm-ts-ci-gate"
    },
    {
      "flow_name": "tsm-ts-noimplicitany",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-strictnullchecks",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-strict-family-flags",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-eliminate-any",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-py-error-baseline",
      "relationship": "feeds_into",
      "description": "outputs migration_profile consumed by tsm-py-error-baseline"
    }
  ]
}
