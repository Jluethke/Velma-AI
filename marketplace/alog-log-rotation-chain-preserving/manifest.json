{
  "name": "alog-log-rotation-chain-preserving",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "audit-log",
    "rotation",
    "segments",
    "chain-continuity",
    "checkpoint"
  ],
  "inputs": [
    "chain_link_spec",
    "checkpoint_spec",
    "rotation_trigger"
  ],
  "outputs": [
    "rotation_procedure"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Rotate log files into segments without breaking the chain by carrying the previous segment's final head and signed checkpoint into the next segment header, so verification spans segment boundaries.",
  "related_flows": [
    {
      "flow_name": "alog-hash-chain-link-design",
      "relationship": "fed_by",
      "description": "provides chain_link_spec needed here"
    },
    {
      "flow_name": "alog-checkpoint-signing",
      "relationship": "fed_by",
      "description": "provides checkpoint_spec needed here"
    },
    {
      "flow_name": "alog-tamper-detection-tests",
      "relationship": "feeds_into",
      "description": "outputs rotation_procedure consumed by alog-tamper-detection-tests"
    }
  ]
}
