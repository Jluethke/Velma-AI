{
  "name": "leak-py-tracemalloc-diff",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "memory-leak",
    "python",
    "tracemalloc",
    "snapshot-diff",
    "profiling"
  ],
  "inputs": [
    "leak_brief",
    "load_recipe",
    "cause_hypotheses"
  ],
  "outputs": [
    "py_alloc_diff",
    "py_suspect_sites"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Take three tracemalloc snapshots across equal load windows, diff them by traceback and keep only Python allocation sites that grow in both windows.",
  "related_flows": [
    {
      "flow_name": "leak-intake-load-recipe",
      "relationship": "fed_by",
      "description": "provides leak_brief, load_recipe needed here"
    },
    {
      "flow_name": "leak-rss-growth-confirm",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-managed-vs-native-split",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-classic-causes-triage",
      "relationship": "fed_by",
      "description": "provides cause_hypotheses needed here"
    },
    {
      "flow_name": "leak-py-objgraph-backrefs",
      "relationship": "feeds_into",
      "description": "outputs py_suspect_sites consumed by leak-py-objgraph-backrefs"
    },
    {
      "flow_name": "leak-py-gc-referrers",
      "relationship": "feeds_into",
      "description": "outputs py_suspect_sites consumed by leak-py-gc-referrers"
    },
    {
      "flow_name": "leak-py-memray-native",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-root-cause-confirm",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
