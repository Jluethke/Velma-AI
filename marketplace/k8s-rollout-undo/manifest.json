{
  "name": "k8s-rollout-undo",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "rollback",
    "rollout-undo",
    "gitops"
  ],
  "inputs": [
    "cluster_context",
    "namespace",
    "app_name",
    "deployed_revision",
    "triage_report",
    "gitops_tool"
  ],
  "outputs": [
    "undo_result"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Restore the last good version with the rollback method that matches the delivery tool and list the objects the rollback did not revert.",
  "related_flows": [
    {
      "flow_name": "k8s-rollout-status-watch",
      "relationship": "fed_by",
      "description": "provides deployed_revision needed here"
    },
    {
      "flow_name": "k8s-pod-debug-triage",
      "relationship": "fed_by",
      "description": "provides triage_report needed here"
    },
    {
      "flow_name": "k8s-crashloopbackoff-decision",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
