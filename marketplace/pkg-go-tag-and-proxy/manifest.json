{
  "name": "pkg-go-tag-and-proxy",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "go",
    "proxy.golang.org",
    "pkg.go.dev",
    "git-tag",
    "retract"
  ],
  "inputs": [
    "go_module_plan",
    "release_tag",
    "license_report"
  ],
  "outputs": [
    "go_publish_record"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Release a Go module by pushing an annotated semver tag, fetching it through proxy.golang.org, installing it into a clean consumer module, and using retract instead of moving tags.",
  "related_flows": [
    {
      "flow_name": "pkg-license-metadata",
      "relationship": "fed_by",
      "description": "provides license_report needed here"
    },
    {
      "flow_name": "pkg-release-version-lock",
      "relationship": "fed_by",
      "description": "provides release_tag needed here"
    },
    {
      "flow_name": "pkg-go-module-major-path",
      "relationship": "fed_by",
      "description": "provides go_module_plan needed here"
    },
    {
      "flow_name": "pkg-post-publish-verify",
      "relationship": "feeds_into",
      "description": "outputs go_publish_record consumed by pkg-post-publish-verify"
    }
  ]
}
