{
  "name": "e2e-cypress-data-seed",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "e2e",
    "cypress",
    "test-data",
    "cy-task",
    "isolation"
  ],
  "inputs": [
    "repo_dir",
    "cypress_command_layer",
    "seed_api"
  ],
  "outputs": [
    "cypress_data_tasks"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Seed Cypress test data with cy.task and cy.request, reset state in beforeEach, and prove isolation with consecutive and interrupted runs.",
  "related_flows": [
    {
      "flow_name": "e2e-journey-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-runner-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-cypress-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-selector-policy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-cypress-commands-pom",
      "relationship": "fed_by",
      "description": "provides cypress_command_layer needed here"
    },
    {
      "flow_name": "e2e-cypress-auth-session",
      "relationship": "feeds_into",
      "description": "outputs cypress_data_tasks consumed by e2e-cypress-auth-session"
    },
    {
      "flow_name": "e2e-mock-vs-real-decide",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-cypress-intercept",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
