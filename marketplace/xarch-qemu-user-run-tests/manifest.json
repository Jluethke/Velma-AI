    },
    {
      "flow_name": "xarch-elf-arch-verify",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "xarch-python-manylinux-wheel",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-python-cibuildwheel",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-docker-buildx-multiarch",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-sysroot-from-image",
      "relationship": "fed_by",
      "description": "provides sysroot needed here"
    }
  ]
}
