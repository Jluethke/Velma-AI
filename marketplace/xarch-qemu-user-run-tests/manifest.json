{
  "name": "xarch-qemu-user-run-tests",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "cross-compile",
    "aarch64",
    "qemu-user",
    "testing",
    "emulation"
  ],
  "inputs": [
    "binary_path",
    "sysroot",
    "binfmt_state"
  ],
  "outputs": [
    "qemu_test_report",
    "qemu_failures"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run an aarch64 test binary under qemu-user with QEMU_LD_PREFIX set to the sysroot, record pass and fail counts, and flag the emulation gaps that keep results advisory.",
