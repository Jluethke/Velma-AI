      "description": "provides interface_table needed here"
    },
    {
      "flow_name": "hw-power-tree",
      "relationship": "fed_by",
      "description": "provides power_tree needed here"
    },
    {
      "flow_name": "hw-critical-circuit-flagging",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "feeds_into",
      "description": "outputs layer_count, mechanical_envelope, fab_rules consumed by hw-spec-consolidate"
    }
  ]
}
