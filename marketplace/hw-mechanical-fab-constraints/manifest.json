    "mechanical",
    "fabrication",
    "requirements"
  ],
  "inputs": [
    "interface_table",
    "power_tree",
    "mechanical_limits",
    "fab_target"
  ],
  "outputs": [
    "mechanical_envelope",
    "fab_rules",
    "layer_count"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
