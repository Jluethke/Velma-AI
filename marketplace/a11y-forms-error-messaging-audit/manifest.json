{
  "name": "a11y-forms-error-messaging-audit",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "forms",
    "error-messages",
    "autocomplete",
    "wcag-2.2"
  ],
  "inputs": [
    "page_inventory",
    "component_inventory"
  ],
  "outputs": [
    "form_issues"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Audits every form field and every error state for labels and instructions (1.3.1, 3.3.2, 4.1.2), input purpose `autocomplete` tokens (1.3.5), error identification and suggestion (3.3.1, 3.3.3), error prevention for legal and financial data (3.3.4), redundant entry (3.3.7), accessible authentication (3.3.8) and announced status messages (4.1.3).",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "fed_by",
      "description": "provides page_inventory, component_inventory needed here"
    },
    {
      "flow_name": "a11y-focus-order-visibility-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-target-size-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-pointer-help-wcag22-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "feeds_into",
      "description": "outputs form_issues consumed by a11y-impact-ranking"
    }
  ]
}
