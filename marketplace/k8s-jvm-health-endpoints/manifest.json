{
  "name": "k8s-jvm-health-endpoints",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "java",
    "spring-boot",
    "quarkus",
    "probes"
  ],
  "inputs": [
    "repo_dir",
    "workload_profile"
  ],
  "outputs": [
    "jvm_health_endpoints"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Enable Spring Boot Actuator or Quarkus health probes with dependency checks only in readiness, configure graceful shutdown, and measure startup time.",
  "related_flows": [
    {
      "flow_name": "k8s-workload-inventory",
      "relationship": "fed_by",
      "description": "provides workload_profile needed here"
    },
    {
      "flow_name": "k8s-py-health-endpoints",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-node-health-endpoints",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-go-health-endpoints",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-probe-tuning",
      "relationship": "feeds_into",
      "description": "outputs jvm_health_endpoints consumed by k8s-probe-tuning"
    },
    {
      "flow_name": "k8s-rollout-status-watch",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-rolling-update-pdb",
      "relationship": "feeds_into",
      "description": "outputs jvm_health_endpoints consumed by k8s-rolling-update-pdb"
    }
  ]
}
