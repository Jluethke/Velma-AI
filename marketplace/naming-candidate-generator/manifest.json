{
  "name": "naming-candidate-generator",
  "version": "1.0.0",
  "domain": "business",
  "tags": [
    "naming",
    "branding",
    "enterprise-sales",
    "generator"
  ],
  "fabric": false,
  "inputs": [
    "company_purpose",
    "patent_theme_keywords",
    "vibe_categories",
    "include_roots",
    "prefix_candidates",
    "suffix_candidates",
    "blocked_words",
    "min_length",
    "max_length",
    "generate_count"
  ],
  "outputs": [
    "candidate_names",
    "generation_metadata"
  ],
  "execution_pattern": "linear",
  "price": "0",
  "license": "OPEN",
  "description": "Generates enterprise-ready company-name candidates from semantic roots drawn from the company's purpose and patent themes, combined with prefix/suffix templates, filtered by length and blocked-word rules.",
  "related_flows": [
    {
      "flow_name": "domain-availability-checker",
      "relationship": "feeds_into",
      "description": "outputs candidate_names consumed by domain-availability-checker"
    }
  ]
}
