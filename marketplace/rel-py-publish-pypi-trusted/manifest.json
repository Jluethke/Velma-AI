{
  "name": "rel-py-publish-pypi-trusted",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "python",
    "pypi",
    "trusted-publishing",
    "pep740"
  ],
  "inputs": [
    "py_dist",
    "package_name",
    "next_version",
    "provenance_verification"
  ],
  "outputs": [
    "pypi_release_url"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Publish a Python distribution to PyPI through Trusted Publishing with pypa/gh-action-pypi-publish, with a TestPyPI rehearsal and PEP 740 attestations.",
  "related_flows": [
    {
      "flow_name": "rel-commit-history-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-py-api-break-griffe",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-semver-bump-decision",
      "relationship": "fed_by",
      "description": "provides next_version needed here"
    },
    {
      "flow_name": "rel-changelog-git-cliff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-py-reproducible-build",
      "relationship": "fed_by",
      "description": "provides py_dist needed here"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "fed_by",
      "description": "provides provenance_verification needed here"
    },
    {
      "flow_name": "rel-py-verify-install",
      "relationship": "feeds_into",
      "description": "outputs pypi_release_url consumed by rel-py-verify-install"
    }
  ]
}
