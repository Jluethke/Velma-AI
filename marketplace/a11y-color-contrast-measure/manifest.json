{
  "name": "a11y-color-contrast-measure",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "contrast",
    "color",
    "low-vision",
    "wcag"
  ],
  "inputs": [
    "page_inventory",
    "needs_review_items"
  ],
  "outputs": [
    "contrast_issues"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measures text contrast (SC 1.4.3) and non-text contrast for UI component boundaries, states and meaningful graphics (SC 1.4.11) with the WCAG relative luminance formula, resolving every case axe-core marks \"incomplete\" (text over images, gradients, pseudo-elements, transparency), plus SC 1.4.1 Use of Color for links in text.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "fed_by",
      "description": "provides page_inventory needed here"
    },
    {
      "flow_name": "a11y-axe-playwright-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-lighthouse-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-pa11y-ci-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-scan-merge-dedupe",
      "relationship": "fed_by",
      "description": "provides needs_review_items needed here"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "feeds_into",
      "description": "outputs contrast_issues consumed by a11y-impact-ranking"
    }
  ]
}
