{
  "name": "rel-tag-sign-git",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "git-tag",
    "gpg",
    "ssh-signing",
    "gitsign"
  ],
  "inputs": [
    "repo_path",
    "next_version",
    "signing_method",
    "rp_changelog",
    "sr_changelog",
    "cliff_changelog"
  ],
  "outputs": [
    "release_tag",
    "tag_verification"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Create and push one signed annotated release tag with GPG, SSH or gitsign keyless signing, and verify the signature locally and on GitHub.",
  "related_flows": [
    {
      "flow_name": "rel-changelog-git-cliff",
      "relationship": "fed_by",
      "description": "provides cliff_changelog needed here"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "rel-commit-history-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-py-api-break-griffe",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-semver-bump-decision",
      "relationship": "fed_by",
      "description": "provides next_version needed here"
    },
    {
      "flow_name": "rel-py-reproducible-build",
      "relationship": "feeds_into",
      "description": "outputs release_tag consumed by rel-py-reproducible-build"
    },
    {
      "flow_name": "rel-go-reproducible-build",
      "relationship": "feeds_into",
      "description": "outputs release_tag consumed by rel-go-reproducible-build"
    },
    {
      "flow_name": "rel-container-image-build-push",
      "relationship": "feeds_into",
      "description": "outputs release_tag consumed by rel-container-image-build-push"
    }
  ]
}
