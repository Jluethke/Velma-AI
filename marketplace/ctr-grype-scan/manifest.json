{
  "name": "ctr-grype-scan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "containers",
    "security",
    "grype",
    "sbom",
    "vulnerabilities"
  ],
  "inputs": [
    "sbom_file",
    "image_name",
    "severity_threshold"
  ],
  "outputs": [
    "grype_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Scan the Syft SBOM with Grype against the user's threshold and list where Grype and Trivy disagree.",
  "related_flows": [
    {
      "flow_name": "ctr-syft-sbom",
      "relationship": "fed_by",
      "description": "provides sbom_file needed here"
    },
    {
      "flow_name": "ctr-trivy-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctr-vuln-triage",
      "relationship": "feeds_into",
      "description": "outputs grype_report consumed by ctr-vuln-triage"
    },
    {
      "flow_name": "ctr-reproducible-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
