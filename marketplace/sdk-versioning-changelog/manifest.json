{
  "name": "sdk-versioning-changelog",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "sdk",
    "semver",
    "changelog",
    "oasdiff",
    "release"
  ],
  "inputs": [
    "validated_spec",
    "base_spec_path",
    "current_sdk_version",
    "stack",
    "project_dir"
  ],
  "outputs": [
    "version_bump",
    "changelog_entry"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Decide the next SDK version from oasdiff and SDK surface diffs under Semantic Versioning, apply Go module path rules, and write a Keep a Changelog entry.",
  "related_flows": [
    {
      "flow_name": "sdk-spec-spectral-lint",
      "relationship": "fed_by",
      "description": "provides validated_spec needed here"
    },
    {
      "flow_name": "sdk-usage-docs",
      "relationship": "feeds_into",
      "description": "outputs version_bump consumed by sdk-usage-docs"
    }
  ]
}
