{
  "name": "ffr-stale-flag-detect",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "stale-flags",
    "flag-debt",
    "code-references",
    "cleanup"
  ],
  "inputs": [
    "repo_path",
    "provider_choice",
    "flag_inventory_export"
  ],
  "outputs": [
    "stale_flags"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Join code references, provider usage metadata, and flag expiry to classify every temporary flag as remove-now, dead config, orphan code, or active.",
  "related_flows": [
    {
      "flow_name": "ffr-flag-removal-pr",
      "relationship": "feeds_into",
      "description": "outputs stale_flags consumed by ffr-flag-removal-pr"
    },
    {
      "flow_name": "ffr-flag-type-classify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-targeting-rules",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-otel-flag-telemetry",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-guardrail-metrics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-ab-sample-size",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-srm-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-experiment-readout",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
