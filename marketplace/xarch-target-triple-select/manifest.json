{
  "name": "xarch-target-triple-select",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "cross-compile",
    "aarch64",
    "target-triple",
    "abi",
    "toolchain"
  ],
  "inputs": [
    "stack",
    "target_libc",
    "target_cpu"
  ],
  "outputs": [
    "target_triple",
    "triple_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Select the exact aarch64 Linux target triple and ABI from the target C library and map it to the toolchain package or target identifier the chosen build stack needs.",
  "related_flows": [
    {
      "flow_name": "xarch-gcc-toolchain-select",
      "relationship": "feeds_into",
      "description": "outputs target_triple consumed by xarch-gcc-toolchain-select"
    },
    {
      "flow_name": "xarch-sysroot-from-image",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-pkgconfig-cross",
      "relationship": "feeds_into",
      "description": "outputs target_triple consumed by xarch-pkgconfig-cross"
    },
    {
      "flow_name": "xarch-cmake-toolchain-file",
      "relationship": "feeds_into",
      "description": "outputs target_triple consumed by xarch-cmake-toolchain-file"
    },
    {
      "flow_name": "xarch-cmake-configure-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-elf-arch-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-clang-target-setup",
      "relationship": "feeds_into",
      "description": "outputs target_triple consumed by xarch-clang-target-setup"
    },
    {
      "flow_name": "xarch-meson-cross-file",
      "relationship": "feeds_into",
      "description": "outputs target_triple consumed by xarch-meson-cross-file"
    }
  ]
}
