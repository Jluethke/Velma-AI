{
  "name": "cache-ttl-from-change-rate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "caching",
    "ttl",
    "staleness",
    "expiry-jitter",
    "data-change-rate"
  ],
  "inputs": [
    "cache_plan",
    "staleness_tolerance",
    "db_engine"
  ],
  "outputs": [
    "ttl_table"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Set each cache entry's TTL from the stated staleness tolerance and the measured change rate, compute the expected stale-read fraction, and add expiry jitter.",
  "related_flows": [
    {
      "flow_name": "cache-read-hotspot-measure",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "cache-location-decide",
      "relationship": "fed_by",
      "description": "provides cache_plan needed here"
    },
    {
      "flow_name": "cache-key-schema-design",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cache-invalidation-strategy-select",
      "relationship": "feeds_into",
      "description": "outputs ttl_table consumed by cache-invalidation-strategy-select"
    },
    {
      "flow_name": "cache-py-cache-aside-redis",
      "relationship": "feeds_into",
      "description": "outputs ttl_table consumed by cache-py-cache-aside-redis"
    },
    {
      "flow_name": "cache-stale-set-race-fix",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cache-stampede-risk-assess",
      "relationship": "feeds_into",
      "description": "outputs ttl_table consumed by cache-stampede-risk-assess"
    },
    {
      "flow_name": "cache-stampede-redis-lock",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
