{
  "name": "pcb-isolation-review",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "design-review",
    "isolation",
    "creepage"
  ],
  "inputs": [
    "skidl_source",
    "bom",
    "board_spec",
    "critical_circuits"
  ],
  "outputs": [
    "isolation_findings",
    "creepage_constraints"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Review every isolation barrier: isolated power on the far side, zero nets crossing outside the isolator, rated working voltage, and the creepage distance layout must hold.",
  "related_flows": [
    {
      "flow_name": "pcb-power-input-review",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-interlock-fault-review",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-review-verdict",
      "relationship": "feeds_into",
      "description": "outputs creepage_constraints, isolation_findings consumed by pcb-review-verdict"
    },
    {
      "flow_name": "hw-critical-circuit-flagging",
      "relationship": "fed_by",
      "description": "provides critical_circuits needed here"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "fed_by",
      "description": "provides board_spec needed here"
    },
    {
      "flow_name": "pcb-stock-sourcing",
      "relationship": "fed_by",
      "description": "provides bom needed here"
    },
    {
      "flow_name": "pcb-skidl-capture",
      "relationship": "fed_by",
      "description": "provides skidl_source needed here"
    },
    {
      "flow_name": "pcb-board-setup",
      "relationship": "feeds_into",
      "description": "outputs creepage_constraints consumed by pcb-board-setup"
    }
  ]
}
