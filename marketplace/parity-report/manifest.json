{
  "name": "parity-report",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "parity",
    "report",
    "reproducibility"
  ],
  "inputs": [
    "comparison_results",
    "triage_findings",
    "env_fingerprint",
    "golden_manifest",
    "matrix_results",
    "cross_arch_results"
  ],
  "outputs": [
    "parity_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write the parity report of record with environments, policy, per-field results, open questions, commits, and hashes, and a verdict from a stated rule.",
  "related_flows": [
    {
      "flow_name": "parity-ulp-compare",
      "relationship": "fed_by",
      "description": "provides comparison_results needed here"
    },
    {
      "flow_name": "parity-divergence-triage",
      "relationship": "fed_by",
      "description": "provides triage_findings needed here"
    },
    {
      "flow_name": "parity-ci-gate-github",
      "relationship": "feeds_into",
      "description": "outputs parity_report consumed by parity-ci-gate-github"
    },
    {
      "flow_name": "parity-golden-manifest-lock",
      "relationship": "fed_by",
      "description": "provides golden_manifest needed here"
    },
    {
      "flow_name": "parity-env-fingerprint",
      "relationship": "fed_by",
      "description": "provides env_fingerprint needed here"
    },
    {
      "flow_name": "parity-compiler-flag-matrix",
      "relationship": "fed_by",
      "description": "provides matrix_results needed here"
    },
    {
      "flow_name": "parity-cross-arch-aarch64",
      "relationship": "fed_by",
      "description": "provides cross_arch_results needed here"
    }
  ]
}
