{
  "name": "gql-schema-breaking-diff",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "graphql",
    "schema-evolution",
    "graphql-inspector",
    "breaking-changes",
    "ci"
  ],
  "inputs": [
    "validated_schema",
    "project_dir",
    "base_ref"
  ],
  "outputs": [
    "schema_change_report",
    "breaking_changes"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Diff the proposed schema against the base branch with graphql-inspector, classify each change, check breaking changes against client usage, and gate CI.",
  "related_flows": [
    {
      "flow_name": "gql-use-case-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-schema-sdl-draft",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-nullability-review",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-relay-connection-schema",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-schema-lint-graphql-eslint",
      "relationship": "fed_by",
      "description": "provides validated_schema needed here"
    },
    {
      "flow_name": "gql-field-deprecation-rollout",
      "relationship": "feeds_into",
      "description": "outputs breaking_changes consumed by gql-field-deprecation-rollout"
    }
  ]
}
