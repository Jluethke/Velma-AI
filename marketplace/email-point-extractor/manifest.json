{
  "name": "email-point-extractor",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "email",
    "point",
    "extractor"
  ],
  "inputs": [
    "participant_map",
    "structured_thread"
  ],
  "outputs": [
    "action_items",
    "emotional_trajectory",
    "must_address_count",
    "unresolved_points"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process participant_map, structured_thread to produce action_items, emotional_trajectory, must_address_count.",
  "related_flows": [
    {
      "flow_name": "email-thread-parser",
      "relationship": "fed_by",
      "description": "provides participant_map, structured_thread needed here"
    },
    {
      "flow_name": "email-tone-analyzer",
      "relationship": "feeds_into",
      "description": "outputs unresolved_points, emotional_trajectory consumed by email-tone-analyzer"
    },
    {
      "flow_name": "response-mapper",
      "relationship": "feeds_into",
      "description": "outputs unresolved_points, must_address_count consumed by response-mapper"
    },
    {
      "flow_name": "email-response-drafter",
      "relationship": "feeds_into",
      "description": "outputs unresolved_points consumed by email-response-drafter"
    },
    {
      "flow_name": "response-validator",
      "relationship": "feeds_into",
      "description": "outputs unresolved_points, must_address_count, emotional_trajectory consumed by response-validator"
    },
    {
      "flow_name": "email-response-finalizer",
      "relationship": "feeds_into",
      "description": "outputs action_items consumed by email-response-finalizer"
    }
  ]
}
