{
  "name": "response-mapper",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "response",
    "mapper"
  ],
  "inputs": [
    "inferred_resolution_goal",
    "must_address_count",
    "tone_profile",
    "unresolved_points"
  ],
  "outputs": [
    "decision_points",
    "estimated_word_count",
    "length_flag",
    "response_outline",
    "response_structure"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process inferred_resolution_goal, must_address_count, tone_profile to produce decision_points, estimated_word_count, length_flag.",
  "related_flows": [
    {
      "flow_name": "email-point-extractor",
      "relationship": "fed_by",
      "description": "provides unresolved_points, must_address_count needed here"
    },
    {
      "flow_name": "email-tone-analyzer",
      "relationship": "fed_by",
      "description": "provides inferred_resolution_goal needed here"
    },
    {
      "flow_name": "email-response-drafter",
      "relationship": "feeds_into",
      "description": "outputs response_outline, response_structure, length_flag consumed by email-response-drafter"
    }
  ]
}
