{
  "name": "mex-flag-cutover",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "monolith-decomposition",
    "feature-flags",
    "openfeature",
    "rollout",
    "cutover"
  ],
  "inputs": [
    "routing_config",
    "acl_adapter",
    "parity_report",
    "latency_report",
    "reconciliation_report",
    "flag_provider",
    "ramp_plan"
  ],
  "outputs": [
    "cutover_flag",
    "rollout_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Ramp traffic to the new path behind a sticky feature flag with pre-written cohort rollback rules, then flip the writer all at once.",
  "related_flows": [
    {
      "flow_name": "mex-strangler-proxy-routing",
      "relationship": "fed_by",
      "description": "provides routing_config needed here"
    },
    {
      "flow_name": "mex-shadow-traffic-diff",
      "relationship": "fed_by",
      "description": "provides parity_report needed here"
    },
    {
      "flow_name": "mex-latency-comparison",
      "relationship": "fed_by",
      "description": "provides latency_report needed here"
    },
    {
      "flow_name": "mex-decommission-legacy-path",
      "relationship": "feeds_into",
      "description": "outputs rollout_log, cutover_flag consumed by mex-decommission-legacy-path"
    },
    {
      "flow_name": "mex-anti-corruption-layer",
      "relationship": "fed_by",
      "description": "provides acl_adapter needed here"
    },
    {
      "flow_name": "mex-backfill-and-reconcile",
      "relationship": "fed_by",
      "description": "provides reconciliation_report needed here"
    }
  ]
}
