{
  "name": "dup-apply-one-bump",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "dependencies",
    "upgrade",
    "one-commit",
    "testing",
    "bisect"
  ],
  "inputs": [
    "upgrade_scope",
    "upgrade_plan",
    "rollback_plan"
  ],
  "outputs": [
    "applied_bumps",
    "blocked_bumps"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Apply each planned dependency bump alone with the stack's exact command, prove it with the full test suite against the baseline, and commit or revert it.",
  "related_flows": [
    {
      "flow_name": "dup-scope-intake",
      "relationship": "fed_by",
      "description": "provides upgrade_scope needed here"
    },
    {
      "flow_name": "dup-baseline-snapshot",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dup-changelog-triage",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dup-upgrade-order-plan",
      "relationship": "fed_by",
      "description": "provides upgrade_plan needed here"
    },
    {
      "flow_name": "dup-rollback-plan",
      "relationship": "fed_by",
      "description": "provides rollback_plan needed here"
    },
    {
      "flow_name": "dup-verify-and-pr",
      "relationship": "feeds_into",
      "description": "outputs applied_bumps consumed by dup-verify-and-pr"
    },
    {
      "flow_name": "dup-py-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "dup-node-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
