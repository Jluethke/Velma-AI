{
  "name": "srf-py-characterization-tests",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "refactoring",
    "python",
    "pytest",
    "syrupy",
    "characterization-tests",
    "coverage"
  ],
  "inputs": [
    "repo_path",
    "target_paths",
    "test_command",
    "baseline_commit"
  ],
  "outputs": [
    "characterization_tests",
    "target_coverage"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Pin current Python behavior with syrupy snapshot tests and prove full line and branch coverage of the refactor target with coverage.py.",
  "related_flows": [
    {
      "flow_name": "srf-baseline-green-check",
      "relationship": "fed_by",
      "description": "provides baseline_commit needed here"
    },
    {
      "flow_name": "srf-verify-step-history",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "srf-node-characterization-tests",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "srf-go-golden-master-tests",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "srf-py-approval-tests-combinations",
      "relationship": "feeds_into",
      "description": "outputs characterization_tests consumed by srf-py-approval-tests-combinations"
    },
    {
      "flow_name": "srf-py-api-snapshot-griffe",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "srf-py-break-import-cycle",
      "relationship": "feeds_into",
      "description": "outputs characterization_tests consumed by srf-py-break-import-cycle"
    },
    {
      "flow_name": "srf-py-dead-code-vulture-coverage",
      "relationship": "feeds_into",
      "description": "outputs characterization_tests consumed by srf-py-dead-code-vulture-coverage"
    }
  ]
}
