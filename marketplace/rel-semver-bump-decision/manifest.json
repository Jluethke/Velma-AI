{
  "name": "rel-semver-bump-decision",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "semver",
    "pep440",
    "versioning",
    "prerelease"
  ],
  "inputs": [
    "commit_list",
    "noncompliant_commits",
    "current_version",
    "prerelease_id",
    "py_api_breaks",
    "node_api_breaks",
    "go_api_breaks",
    "rust_api_breaks",
    "deprecation_notices"
  ],
  "outputs": [
    "next_version",
    "bump_level",
    "bump_rationale"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Compute the next version from classified commits, API diff results and deprecations using SemVer 2.0.0 rules, with ecosystem-correct pre-release syntax.",
  "related_flows": [
    {
      "flow_name": "rel-commit-history-audit",
      "relationship": "fed_by",
      "description": "provides noncompliant_commits, commit_list needed here"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "rel-commitlint-gate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-py-api-break-griffe",
      "relationship": "fed_by",
      "description": "provides py_api_breaks needed here"
    },
    {
      "flow_name": "rel-node-api-break-extractor",
      "relationship": "fed_by",
      "description": "provides node_api_breaks needed here"
    },
    {
      "flow_name": "rel-changelog-semantic-release",
      "relationship": "feeds_into",
      "description": "outputs next_version consumed by rel-changelog-semantic-release"
    },
    {
      "flow_name": "rel-changelog-git-cliff",
      "relationship": "feeds_into",
      "description": "outputs next_version consumed by rel-changelog-git-cliff"
    },
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "feeds_into",
      "description": "outputs next_version consumed by rel-tag-sign-git"
    }
  ]
}
