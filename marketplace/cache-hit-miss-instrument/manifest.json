{
  "name": "cache-hit-miss-instrument",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "caching",
    "observability",
    "prometheus",
    "micrometer",
    "metrics"
  ],
  "inputs": [
    "repo_path",
    "key_schema",
    "stack"
  ],
  "outputs": [
    "cache_metrics"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Add per-namespace cache hit, miss, error and latency metrics with Prometheus or Micrometer clients, bounded labels, a unit test, and verified PromQL queries.",
  "related_flows": [
    {
      "flow_name": "cache-hit-rate-latency-measure",
      "relationship": "feeds_into",
      "description": "outputs cache_metrics consumed by cache-hit-rate-latency-measure"
    },
    {
      "flow_name": "cache-stampede-risk-assess",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "cache-stampede-redis-lock",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "cache-redis-maxmemory-eviction",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "cache-read-hotspot-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cache-location-decide",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cache-key-schema-design",
      "relationship": "fed_by",
      "description": "provides key_schema needed here"
    },
    {
      "flow_name": "cache-ttl-from-change-rate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
