{
  "name": "port-c-golden-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "porting",
    "c",
    "sanitizers",
    "golden-tests",
    "capture"
  ],
  "inputs": [
    "source_repo",
    "corpus_schema",
    "case_inputs",
    "nondeterminism_sources"
  ],
  "outputs": [
    "c_corpus"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Capture golden records from the original C library under ASan and UBSan, marking undefined-behavior inputs instead of recording them as truth.",
  "related_flows": [
    {
      "flow_name": "port-behavior-surface-inventory",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "port-nondeterminism-inventory",
      "relationship": "fed_by",
      "description": "provides nondeterminism_sources needed here"
    },
    {
      "flow_name": "port-error-model-mapping",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "port-golden-corpus-schema",
      "relationship": "fed_by",
      "description": "provides corpus_schema needed here"
    },
    {
      "flow_name": "port-edge-case-input-set",
      "relationship": "fed_by",
      "description": "provides case_inputs needed here"
    },
    {
      "flow_name": "port-golden-corpus-freeze",
      "relationship": "feeds_into",
      "description": "outputs c_corpus consumed by port-golden-corpus-freeze"
    },
    {
      "flow_name": "port-dependency-equivalence-map",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "port-integer-semantics-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
