    },
    {
      "flow_name": "dlog-disk-throughput-measure",
      "relationship": "feeds_into",
      "description": "outputs measured_rates consumed by dlog-disk-throughput-measure"
    },
    {
      "flow_name": "dlog-storage-budget",
      "relationship": "feeds_into",
      "description": "outputs measured_rates consumed by dlog-storage-budget"
    },
    {
      "flow_name": "dlog-drop-audit",
      "relationship": "feeds_into",
      "description": "outputs measured_rates consumed by dlog-drop-audit"
    }
  ]
