{
  "name": "ctr-reproducible-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "containers",
    "docker",
    "reproducible-builds",
    "buildkit",
    "diffoci"
  ],
  "inputs": [
    "project_dir",
    "image_name",
    "build_profile"
  ],
  "outputs": [
    "repro_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build an image twice with SOURCE_DATE_EPOCH and rewrite-timestamp, compare digests, and fix each nondeterministic file diffoci reports.",
  "related_flows": [
    {
      "flow_name": "ctr-syft-sbom",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctr-trivy-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctr-grype-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctr-vuln-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctr-stack-inventory",
      "relationship": "fed_by",
      "description": "provides build_profile needed here"
    },
    {
      "flow_name": "ctr-image-release-gate",
      "relationship": "feeds_into",
      "description": "outputs repro_report consumed by ctr-image-release-gate"
    }
  ]
}
