{
  "name": "race-stress-harness",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "concurrency",
    "stress-test",
    "reproduction",
    "flaky-tests",
    "testing"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "target_test",
    "failure_class",
    "stress_runs"
  ],
  "outputs": [
    "stress_command",
    "baseline_failure_rate"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Builds a stress test that starts many workers at the same instant on the suspect operation, runs it a user-chosen number of times with the stack's real repeat tooling, and records the measured baseline failure rate before any fix.",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "fed_by",
      "description": "provides failure_class needed here"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-deterministic-regression-test",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-apply-fix",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-stress-verify",
      "relationship": "feeds_into",
      "description": "outputs baseline_failure_rate, stress_command consumed by race-stress-verify"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
