{
  "name": "tkt-ci-check-triage",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ci",
    "github-actions",
    "gh-cli",
    "triage"
  ],
  "inputs": [
    "pr_url",
    "repo_profile"
  ],
  "outputs": [
    "ci_status"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Read pull request checks and failed logs, classify each failure, and reproduce caused failures locally with the exact CI command.",
  "related_flows": [
    {
      "flow_name": "tkt-review-comment-response",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-sync-strategy-choose",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-rebase-conflict-resolve",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-merge-conflict-resolve",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-post-merge-verify",
      "relationship": "feeds_into",
      "description": "outputs ci_status consumed by tkt-post-merge-verify"
    },
    {
      "flow_name": "tkt-repo-orient-detect",
      "relationship": "fed_by",
      "description": "provides repo_profile needed here"
    },
    {
      "flow_name": "tkt-pr-description",
      "relationship": "fed_by",
      "description": "provides pr_url needed here"
    }
  ]
}
