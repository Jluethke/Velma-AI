{
  "name": "canb-bit-timing-calc",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "can-fd",
    "bit-timing",
    "sample-point",
    "socketcan"
  ],
  "inputs": [
    "can_netdev",
    "bitrate",
    "data_bitrate",
    "sample_point",
    "adapter_report"
  ],
  "outputs": [
    "bit_timing"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
