{
  "name": "xarch-gcc-toolchain-select",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "cross-compile",
    "aarch64",
    "gcc",
    "binutils",
    "toolchain"
  ],
  "inputs": [
    "host_distro",
    "target_triple"
  ],
  "outputs": [
    "toolchain_prefix",
    "toolchain_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Install the gcc-aarch64-linux-gnu cross toolchain for the target triple and verify it emits AArch64 objects with a compiled probe read by file and readelf.",
  "related_flows": [
    {
      "flow_name": "xarch-target-triple-select",
      "relationship": "fed_by",
      "description": "provides target_triple needed here"
    },
    {
      "flow_name": "xarch-sysroot-from-image",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-pkgconfig-cross",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-cmake-toolchain-file",
      "relationship": "feeds_into",
      "description": "outputs toolchain_prefix consumed by xarch-cmake-toolchain-file"
    },
    {
      "flow_name": "xarch-cmake-configure-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-elf-arch-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-ldd-shared-deps-audit",
      "relationship": "feeds_into",
      "description": "outputs toolchain_prefix consumed by xarch-ldd-shared-deps-audit"
    },
    {
      "flow_name": "xarch-meson-cross-file",
      "relationship": "feeds_into",
      "description": "outputs toolchain_prefix consumed by xarch-meson-cross-file"
    }
  ]
}
