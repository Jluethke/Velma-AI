{
  "name": "rel-rust-verify-install",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "rust",
    "cargo",
    "install-verification",
    "docs-rs"
  ],
  "inputs": [
    "package_name",
    "next_version",
    "crates_release_url"
  ],
  "outputs": [
    "rust_install_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Depend on the just-published crate version from crates.io in a fresh Cargo project and prove it builds with default and no default features.",
  "related_flows": [
    {
      "flow_name": "rel-semver-bump-decision",
      "relationship": "fed_by",
      "description": "provides next_version needed here"
    },
    {
      "flow_name": "rel-rust-publish-crates",
      "relationship": "fed_by",
      "description": "provides crates_release_url needed here"
    },
    {
      "flow_name": "rel-yank-bad-release",
      "relationship": "feeds_into",
      "description": "outputs rust_install_report consumed by rel-yank-bad-release"
    }
  ]
}
