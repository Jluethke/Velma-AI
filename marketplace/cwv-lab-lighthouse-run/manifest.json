{
  "name": "cwv-lab-lighthouse-run",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "web-performance",
    "lighthouse",
    "lab-data",
    "lcp"
  ],
  "inputs": [
    "page_urls",
    "form_factor"
  ],
  "outputs": [
    "lab_report",
    "lab_lcp_element"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run Lighthouse from the CLI with fixed throttling for several runs, pick the median run, and extract the LCP element, phase breakdown, TBT and CLS audits from the JSON.",
  "related_flows": [
    {
      "flow_name": "cwv-field-crux-baseline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cwv-lcp-subparts-breakdown",
      "relationship": "feeds_into",
      "description": "outputs lab_lcp_element consumed by cwv-lcp-subparts-breakdown"
    },
    {
      "flow_name": "cwv-lcp-ttfb-reduce",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cwv-cache-headers-cdn",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cwv-lcp-priority-hints",
      "relationship": "feeds_into",
      "description": "outputs lab_lcp_element consumed by cwv-lcp-priority-hints"
    },
    {
      "flow_name": "cwv-nextjs-image-font",
      "relationship": "feeds_into",
      "description": "outputs lab_lcp_element consumed by cwv-nextjs-image-font"
    },
    {
      "flow_name": "cwv-image-encode-responsive",
      "relationship": "feeds_into",
      "description": "outputs lab_lcp_element consumed by cwv-image-encode-responsive"
    },
    {
      "flow_name": "cwv-font-loading-subset",
      "relationship": "feeds_into",
      "description": "outputs lab_report consumed by cwv-font-loading-subset"
    }
  ]
}
