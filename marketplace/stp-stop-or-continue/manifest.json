{
  "name": "stp-stop-or-continue",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "stop-rules",
    "retry",
    "decision-table",
    "small-model"
  ],
  "inputs": [
    "edit_outcome",
    "locked_plan",
    "scratch_log",
    "integrity_report",
    "max_attempts"
  ],
  "outputs": [
    "stop_decision"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Choose next edit, retry, done or stop from a fixed rule table covering repeated errors, attempt limits, scope and environment.",
  "related_flows": [
    {
      "flow_name": "stp-apply-one-edit",
      "relationship": "feeds_into",
      "description": "outputs stop_decision consumed by stp-apply-one-edit"
    },
    {
      "flow_name": "stp-run-verify-capture",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "stp-keep-or-revert-edit",
      "relationship": "fed_by",
      "description": "provides edit_outcome needed here"
    },
    {
      "flow_name": "stp-test-integrity-guard",
      "relationship": "fed_by",
      "description": "provides integrity_report needed here"
    },
    {
      "flow_name": "stp-final-evidence-report",
      "relationship": "feeds_into",
      "description": "outputs stop_decision consumed by stp-final-evidence-report"
    },
    {
      "flow_name": "stp-goal-to-runnable-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "stp-scratch-log-start",
      "relationship": "fed_by",
      "description": "provides scratch_log needed here"
    },
    {
      "flow_name": "stp-baseline-capture",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
