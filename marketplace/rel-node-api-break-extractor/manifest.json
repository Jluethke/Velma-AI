{
  "name": "rel-node-api-break-extractor",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "typescript",
    "api-extractor",
    "attw",
    "semver"
  ],
  "inputs": [
    "repo_path",
    "last_tag",
    "package_name"
  ],
  "outputs": [
    "node_api_breaks"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Detect breaking changes in a TypeScript or JavaScript package's public API by diffing API Extractor reports and package.json exports between the last tag and HEAD.",
  "related_flows": [
    {
      "flow_name": "rel-commitlint-gate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-commit-history-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-semver-bump-decision",
      "relationship": "feeds_into",
      "description": "outputs node_api_breaks consumed by rel-semver-bump-decision"
    },
    {
      "flow_name": "rel-changelog-semantic-release",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-node-reproducible-pack",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-node-publish-npm-provenance",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-node-verify-install",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
