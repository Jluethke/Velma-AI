{
  "name": "race-go-race-detector",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "go",
    "race-detector",
    "data-race",
    "gorace",
    "go-vet"
  ],
  "inputs": [
    "repo_path",
    "stress_command"
  ],
  "outputs": [
    "go_race_reports"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Runs the Go stress test under `-race` with GORACE options set for full history, then turns each `WARNING: DATA RACE` report into a pair of conflicting accesses with file, line, goroutine and creation site, plus `go vet` lock-copy findings.",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "fed_by",
      "description": "provides stress_command needed here"
    },
    {
      "flow_name": "race-go-goroutine-dump",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs go_race_reports consumed by race-findings-consolidate"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-deterministic-regression-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
