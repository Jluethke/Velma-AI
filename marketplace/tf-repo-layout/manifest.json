{
  "name": "tf-repo-layout",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "terraform",
    "iac",
    "repo-layout",
    "state-boundaries"
  ],
  "inputs": [
    "repo_dir",
    "cloud",
    "environments",
    "components"
  ],
  "outputs": [
    "repo_layout",
    "root_modules"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Lay out a Terraform repository as child modules plus one root module per environment and component, with fixed file names, a correct .gitignore, and state boundaries drawn by blast radius.",
  "related_flows": [
    {
      "flow_name": "tf-env-strategy",
      "relationship": "feeds_into",
      "description": "outputs repo_layout consumed by tf-env-strategy"
    },
    {
      "flow_name": "tf-version-pinning",
      "relationship": "feeds_into",
      "description": "outputs root_modules consumed by tf-version-pinning"
    },
    {
      "flow_name": "tf-state-s3-backend",
      "relationship": "feeds_into",
      "description": "outputs root_modules consumed by tf-state-s3-backend"
    },
    {
      "flow_name": "tf-fmt-validate",
      "relationship": "feeds_into",
      "description": "outputs root_modules consumed by tf-fmt-validate"
    },
    {
      "flow_name": "tf-tflint",
      "relationship": "feeds_into",
      "description": "outputs root_modules consumed by tf-tflint"
    },
    {
      "flow_name": "tf-state-gcs-backend",
      "relationship": "feeds_into",
      "description": "outputs root_modules consumed by tf-state-gcs-backend"
    },
    {
      "flow_name": "tf-state-azurerm-backend",
      "relationship": "feeds_into",
      "description": "outputs root_modules consumed by tf-state-azurerm-backend"
    },
    {
      "flow_name": "tf-state-hcp-terraform",
      "relationship": "feeds_into",
      "description": "outputs root_modules consumed by tf-state-hcp-terraform"
    }
  ]
}
