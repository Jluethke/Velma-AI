{
  "name": "xarch-pkgconfig-cross",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "cross-compile",
    "aarch64",
    "pkg-config",
    "sysroot",
    "dependencies"
  ],
  "inputs": [
    "sysroot",
    "target_triple"
  ],
  "outputs": [
    "pkgconfig_env",
    "pkgconfig_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Set PKG_CONFIG_LIBDIR and PKG_CONFIG_SYSROOT_DIR so pkg-config returns sysroot-prefixed cflags and libs for the aarch64 target instead of host paths.",
  "related_flows": [
    {
      "flow_name": "xarch-target-triple-select",
      "relationship": "fed_by",
      "description": "provides target_triple needed here"
    },
    {
      "flow_name": "xarch-gcc-toolchain-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-sysroot-from-image",
      "relationship": "fed_by",
      "description": "provides sysroot needed here"
    },
    {
      "flow_name": "xarch-cmake-toolchain-file",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-cmake-configure-build",
      "relationship": "feeds_into",
      "description": "outputs pkgconfig_env consumed by xarch-cmake-configure-build"
    },
    {
      "flow_name": "xarch-elf-arch-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
