{
  "name": "race-findings-consolidate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "concurrency",
    "root-cause",
    "triage",
    "deduplication",
    "evidence"
  ],
  "inputs": [
    "failure_class",
    "shared_state_inventory",
    "go_race_reports",
    "go_hang_report",
    "cpp_tsan_reports",
    "cpp_helgrind_reports",
    "rust_tsan_reports",
    "loom_results",
    "java_thread_dump_report",
    "jcstress_results",
    "py_thread_findings",
    "py_hang_report",
    "py_asyncio_debug_findings",
    "py_blocking_calls",
    "py_cancellation_findings",
    "node_rejection_findings",
    "node_interleaving_findings",
    "pg_anomaly_report",
    "mysql_anomaly_report",
    "idempotency_gaps"
  ],
  "outputs": [
    "race_sites",
    "root_cause"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Merges every detector, dump and audit report from the concurrency flows into one deduplicated list of race sites ranked by evidence strength, and writes a single root-cause statement naming the shared state, the conflicting accesses and the missing guarantee.",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "fed_by",
      "description": "provides failure_class needed here"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "fed_by",
      "description": "provides shared_state_inventory needed here"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "feeds_into",
      "description": "outputs race_sites consumed by race-sync-primitive-choice"
    },
    {
      "flow_name": "race-deterministic-regression-test",
      "relationship": "feeds_into",
      "description": "outputs race_sites, root_cause consumed by race-deterministic-regression-test"
    },
    {
      "flow_name": "race-apply-fix",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-stress-verify",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "feeds_into",
      "description": "outputs race_sites consumed by race-lock-ordering"
    }
  ]
}
