{
  "name": "cache-read-hotspot-measure",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "caching",
    "performance",
    "pg_stat_statements",
    "profiling",
    "baseline"
  ],
  "inputs": [
    "repo_path",
    "read_source",
    "db_engine"
  ],
  "outputs": [
    "read_hotspots",
    "baseline_metrics"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Find repeated expensive reads from database statement statistics or access logs, compute each one's repeat ratio, and record a repeatable latency baseline before caching.",
  "related_flows": [
    {
      "flow_name": "cache-location-decide",
      "relationship": "feeds_into",
      "description": "outputs read_hotspots consumed by cache-location-decide"
    },
    {
      "flow_name": "cache-ttl-from-change-rate",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "cache-key-schema-design",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cache-invalidation-strategy-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cache-py-cache-aside-redis",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cache-stale-set-race-fix",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cache-stampede-risk-assess",
      "relationship": "feeds_into",
      "description": "outputs read_hotspots consumed by cache-stampede-risk-assess"
    },
    {
      "flow_name": "cache-stampede-redis-lock",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
