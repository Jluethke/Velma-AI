{
  "name": "rag-chunk-candidates-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rag",
    "chunking",
    "tokenizer",
    "langchain-text-splitters",
    "offsets"
  ],
  "inputs": [
    "clean_records",
    "chunk_sizes",
    "tokenizer_name",
    "work_dir"
  ],
  "outputs": [
    "chunk_sets"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build fixed, recursive and heading-section chunk candidates measured in the embedding model's tokenizer, each chunk with exact offsets and full corpus coverage.",
  "related_flows": [
    {
      "flow_name": "rag-retrieval-eval-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-embedding-model-select",
      "relationship": "feeds_into",
      "description": "outputs chunk_sets consumed by rag-embedding-model-select"
    },
    {
      "flow_name": "rag-chunk-size-select",
      "relationship": "feeds_into",
      "description": "outputs chunk_sets consumed by rag-chunk-size-select"
    },
    {
      "flow_name": "rag-cross-encoder-rerank",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-failure-analysis-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-corpus-normalize-dedupe",
      "relationship": "fed_by",
      "description": "provides clean_records needed here"
    }
  ]
}
