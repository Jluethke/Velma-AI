{
  "name": "ros2-cpp-rclcpp-node",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ros2",
    "robotics",
    "rclcpp",
    "cpp",
    "node"
  ],
  "inputs": [
    "workspace_dir",
    "node_spec",
    "interface_package"
  ],
  "outputs": [
    "cpp_node_source",
    "cpp_build_result"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write an rclcpp node class with publishers, subscriptions and timers, wire its CMake link targets and install rule, and verify its graph connections with the ros2 CLI.",
  "related_flows": [
    {
      "flow_name": "ros2-workspace-colcon-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ros2-interface-definition",
      "relationship": "fed_by",
      "description": "provides interface_package needed here"
    },
    {
      "flow_name": "ros2-cpp-component-composition",
      "relationship": "feeds_into",
      "description": "outputs cpp_node_source consumed by ros2-cpp-component-composition"
    },
    {
      "flow_name": "ros2-param-yaml-file",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ros2-cpp-param-callback",
      "relationship": "feeds_into",
      "description": "outputs cpp_node_source consumed by ros2-cpp-param-callback"
    },
    {
      "flow_name": "ros2-cpp-lifecycle-node",
      "relationship": "feeds_into",
      "description": "outputs cpp_node_source consumed by ros2-cpp-lifecycle-node"
    },
    {
      "flow_name": "ros2-cpp-executors-callback-groups",
      "relationship": "feeds_into",
      "description": "outputs cpp_node_source consumed by ros2-cpp-executors-callback-groups"
    },
    {
      "flow_name": "ros2-realtime-linux-tuning",
      "relationship": "feeds_into",
      "description": "outputs cpp_node_source consumed by ros2-realtime-linux-tuning"
    }
  ]
}
