{
  "name": "gql-use-case-inventory",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "graphql",
    "schema-design",
    "use-cases",
    "operations",
    "api-design"
  ],
  "inputs": [
    "use_cases",
    "existing_data_model"
  ],
  "outputs": [
    "operation_inventory",
    "operation_documents"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Turn client use cases into a numbered inventory of named GraphQL operations written as parsing .graphql documents before any schema is designed.",
  "related_flows": [
    {
      "flow_name": "gql-schema-sdl-draft",
      "relationship": "feeds_into",
      "description": "outputs operation_documents, operation_inventory consumed by gql-schema-sdl-draft"
    },
    {
      "flow_name": "gql-nullability-review",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-relay-connection-schema",
      "relationship": "feeds_into",
      "description": "outputs operation_inventory consumed by gql-relay-connection-schema"
    },
    {
      "flow_name": "gql-schema-lint-graphql-eslint",
      "relationship": "feeds_into",
      "description": "outputs operation_documents consumed by gql-schema-lint-graphql-eslint"
    },
    {
      "flow_name": "gql-schema-breaking-diff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-n-plus-one-detect",
      "relationship": "feeds_into",
      "description": "outputs operation_documents consumed by gql-n-plus-one-detect"
    },
    {
      "flow_name": "gql-node-graphql-armor-limits",
      "relationship": "feeds_into",
      "description": "outputs operation_documents consumed by gql-node-graphql-armor-limits"
    },
    {
      "flow_name": "gql-py-strawberry-query-limits",
      "relationship": "feeds_into",
      "description": "outputs operation_documents consumed by gql-py-strawberry-query-limits"
    }
  ]
}
