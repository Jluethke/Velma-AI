{
  "name": "k8s-pod-debug-triage",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "debugging",
    "kubectl-debug",
    "events",
    "logs"
  ],
  "inputs": [
    "cluster_context",
    "namespace",
    "app_name",
    "rollout_result"
  ],
  "outputs": [
    "triage_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Capture describe, events, current and previous logs before rollback and sort the failure into one class with the evidence line that proves it.",
  "related_flows": [
    {
      "flow_name": "k8s-rollout-status-watch",
      "relationship": "fed_by",
      "description": "provides rollout_result needed here"
    },
    {
      "flow_name": "k8s-rollout-undo",
      "relationship": "feeds_into",
      "description": "outputs triage_report consumed by k8s-rollout-undo"
    },
    {
      "flow_name": "k8s-crashloopbackoff-decision",
      "relationship": "feeds_into",
      "description": "outputs triage_report consumed by k8s-crashloopbackoff-decision"
    }
  ]
}
