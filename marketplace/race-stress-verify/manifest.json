{
  "name": "race-stress-verify",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "concurrency",
    "verification",
    "stress-test",
    "rule-of-three",
    "testing"
  ],
  "inputs": [
    "repo_path",
    "stress_command",
    "baseline_failure_rate",
    "stress_runs",
    "regression_test",
    "fix_patch"
  ],
  "outputs": [
    "verification_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Proves a concurrency fix by rerunning the original stress harness the number of times the measured baseline failure rate requires, under the same and amplified conditions plus the stack detector, and reports the result with the rule-of-three upper bound instead of \"seems fixed\".",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "fed_by",
      "description": "provides baseline_failure_rate, stress_command needed here"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-deterministic-regression-test",
      "relationship": "fed_by",
      "description": "provides regression_test needed here"
    },
    {
      "flow_name": "race-apply-fix",
      "relationship": "fed_by",
      "description": "provides fix_patch needed here"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
