{
  "name": "rag-retrieval-eval-harness",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rag",
    "evaluation",
    "ranx",
    "recall",
    "mrr"
  ],
  "inputs": [
    "question_set",
    "qrels_spans",
    "k_values",
    "significance_alpha",
    "work_dir"
  ],
  "outputs": [
    "eval_harness",
    "harness_sanity_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a harness that maps span labels onto any chunking, scores TREC runs with ranx for recall, MRR, nDCG and hit rate, and passes oracle and random sanity runs.",
  "related_flows": [
    {
      "flow_name": "rag-cross-encoder-rerank",
      "relationship": "feeds_into",
      "description": "outputs eval_harness consumed by rag-cross-encoder-rerank"
    },
    {
      "flow_name": "rag-chunk-candidates-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-embedding-model-select",
      "relationship": "feeds_into",
      "description": "outputs eval_harness consumed by rag-embedding-model-select"
    },
    {
      "flow_name": "rag-chunk-size-select",
      "relationship": "feeds_into",
      "description": "outputs eval_harness consumed by rag-chunk-size-select"
    },
    {
      "flow_name": "rag-embedding-cache-content-hash",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-pgvector-hnsw-index",
      "relationship": "feeds_into",
      "description": "outputs eval_harness consumed by rag-pgvector-hnsw-index"
    },
    {
      "flow_name": "rag-pg-fts-rrf-hybrid",
      "relationship": "feeds_into",
      "description": "outputs eval_harness consumed by rag-pg-fts-rrf-hybrid"
    },
    {
      "flow_name": "rag-metadata-filter-verify",
      "relationship": "feeds_into",
      "description": "outputs eval_harness consumed by rag-metadata-filter-verify"
    }
  ]
}
