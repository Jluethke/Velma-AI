{
  "name": "gap-analyzer",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "gap",
    "analyzer"
  ],
  "inputs": [
    "capability_map",
    "requirements_list"
  ],
  "outputs": [
    "missing_skills_list"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process capability_map, requirements_list to produce missing_skills_list.",
  "related_flows": [
    {
      "flow_name": "requirement-extractor",
      "relationship": "fed_by",
      "description": "provides requirements_list needed here"
    },
    {
      "flow_name": "capability-mapper",
      "relationship": "fed_by",
      "description": "provides capability_map needed here"
    },
    {
      "flow_name": "output-synthesizer",
      "relationship": "feeds_into",
      "description": "outputs missing_skills_list consumed by output-synthesizer"
    }
  ]
}
