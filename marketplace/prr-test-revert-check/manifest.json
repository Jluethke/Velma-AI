{
  "name": "prr-test-revert-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "testing",
    "regression-test",
    "test-quality",
    "git-worktree"
  ],
  "inputs": [
    "repo_dir",
    "base_branch",
    "head_sha",
    "changed_files",
    "test_command",
    "findings_dir"
  ],
  "outputs": [
    "test_meaning_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run the PR's new tests against the base production code in a separate worktree to prove they detect the change, and audit deleted, skipped and loosened tests.",
  "related_flows": [
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides head_sha, changed_files needed here"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-correctness-pass",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-concurrency-pass",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-api-compat-pass",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-severity-comments",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
