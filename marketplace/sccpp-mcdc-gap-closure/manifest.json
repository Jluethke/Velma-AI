{
  "name": "sccpp-mcdc-gap-closure",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "mcdc",
    "coverage",
    "test-design",
    "requirements"
  ],
  "inputs": [
    "requirements",
    "gcov_coverage",
    "llvm_coverage",
    "coverage_target"
  ],
  "outputs": [
    "mcdc_test_cases",
    "coverage_gaps"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Classify uncovered branches and conditions, design MC/DC vectors traced to requirements, and report remaining gaps against the coverage target.",
  "related_flows": [
    {
      "flow_name": "sccpp-cmake-build-profiles",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-c-unity-req-tests",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-cpp-gtest-req-tests",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-gcc-gcov-coverage",
      "relationship": "fed_by",
      "description": "provides gcov_coverage needed here"
    },
    {
      "flow_name": "sccpp-llvm-cov-coverage",
      "relationship": "fed_by",
      "description": "provides llvm_coverage needed here"
    },
    {
      "flow_name": "sccpp-evidence-summary",
      "relationship": "feeds_into",
      "description": "outputs coverage_gaps consumed by sccpp-evidence-summary"
    }
  ]
}
