{
  "name": "ctr-hardened-run-smoke",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "containers",
    "docker",
    "smoke-test",
    "security",
    "shutdown"
  ],
  "inputs": [
    "image_name",
    "build_profile",
    "app_port",
    "user_report",
