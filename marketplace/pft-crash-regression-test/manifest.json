{
  "name": "pft-crash-regression-test",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "regression-test",
    "fuzzing",
    "property-testing",
    "crash",
    "red-green"
  ],
  "inputs": [
    "crash_clusters",
    "property_failures",
    "stack",
    "repo_path"
  ],
  "outputs": [
    "regression_tests",
    "fix_verification"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Turn every crash cluster and property counterexample into a committed regression test that fails before the fix and passes after it.",
  "related_flows": [
    {
      "flow_name": "pft-invariant-discovery",
