      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "pft-shrinking-reproduction",
      "relationship": "fed_by",
      "description": "provides property_failures needed here"
    },
    {
      "flow_name": "pft-fuzz-target-selection",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "pft-corpus-seeding",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "pft-coverage-plateau-analysis",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "pft-crash-triage-dedup",
      "relationship": "fed_by",
      "description": "provides crash_clusters needed here"
    },
    {
      "flow_name": "pft-ci-fuzz-integration",
      "relationship": "feeds_into",
      "description": "outputs regression_tests consumed by pft-ci-fuzz-integration"
    },
    {
      "flow_name": "pft-py-hypothesis-setup",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
