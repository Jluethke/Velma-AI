{
  "name": "ctr-vuln-triage",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "containers",
    "security",
    "triage",
    "vex",
    "patching"
  ],
  "inputs": [
    "trivy_report",
    "grype_report",
    "pinned_bases",
    "project_dir"
  ],
  "outputs": [
    "vuln_triage"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Classify each image vulnerability by origin, apply the matching fix, and record any remaining finding with a reasoned, expiring suppression.",
  "related_flows": [
    {
      "flow_name": "ctr-syft-sbom",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctr-trivy-scan",
      "relationship": "fed_by",
      "description": "provides trivy_report needed here"
    },
    {
      "flow_name": "ctr-grype-scan",
      "relationship": "fed_by",
      "description": "provides grype_report needed here"
    },
    {
      "flow_name": "ctr-reproducible-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctr-pin-base-digest",
      "relationship": "fed_by",
      "description": "provides pinned_bases needed here"
    },
    {
      "flow_name": "ctr-image-release-gate",
      "relationship": "feeds_into",
      "description": "outputs vuln_triage consumed by ctr-image-release-gate"
    }
  ]
}
