{
  "name": "dfc-audience-doctype-plan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "documentation",
    "diataxis",
    "audience",
    "information-architecture",
    "planning"
  ],
  "inputs": [
    "repo_path",
    "product_summary",
    "audience_notes"
  ],
  "outputs": [
    "audience_profile",
    "doc_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Name evidenced reader personas and assign every planned documentation page exactly one Diataxis type, persona, question and source of truth.",
  "related_flows": [
    {
      "flow_name": "dfc-readme-structure",
      "relationship": "feeds_into",
      "description": "outputs audience_profile, doc_plan consumed by dfc-readme-structure"
    },
    {
      "flow_name": "dfc-lychee-link-check",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dfc-docs-staleness-audit",
      "relationship": "feeds_into",
      "description": "outputs doc_plan consumed by dfc-docs-staleness-audit"
    },
    {
      "flow_name": "dfc-quickstart-clean-container-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-vale-prose-lint",
      "relationship": "feeds_into",
      "description": "outputs audience_profile consumed by dfc-vale-prose-lint"
    },
    {
      "flow_name": "dfc-py-docstring-conventions",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-node-tsdoc-conventions",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dfc-go-doc-comments",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
