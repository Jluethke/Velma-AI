{
  "name": "rtw-artillery-ws-load-test",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "realtime",
    "artillery",
    "load-testing",
    "websocket"
  ],
  "inputs": [
    "server_url",
    "protocol_spec",
    "target_connections",
    "slo_targets",
    "os_limits_report"
  ],
  "outputs": [
    "artillery_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write and run an Artillery WebSocket load test with an arrival rate derived by Little's law, ensure limits from the SLO and a JSON report.",
  "related_flows": [
    {
      "flow_name": "rtw-linux-connection-limits",
      "relationship": "fed_by",
      "description": "provides os_limits_report needed here"
    },
    {
      "flow_name": "rtw-k6-ws-load-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rtw-load-test-capacity-report",
      "relationship": "feeds_into",
      "description": "outputs artillery_report consumed by rtw-load-test-capacity-report"
    },
    {
      "flow_name": "rtw-message-envelope",
      "relationship": "fed_by",
      "description": "provides protocol_spec needed here"
    }
  ]
}
