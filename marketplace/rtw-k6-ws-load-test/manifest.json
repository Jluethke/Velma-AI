{
  "name": "rtw-k6-ws-load-test",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "realtime",
    "k6",
    "load-testing",
    "websocket"
  ],
  "inputs": [
    "server_url",
    "protocol_spec",
    "target_connections",
    "slo_targets",
    "os_limits_report"
  ],
  "outputs": [
    "k6_summary"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write and run a k6 WebSocket load test holding one connection per VU with SLO-derived thresholds and a JSON summary export.",
  "related_flows": [
    {
      "flow_name": "rtw-linux-connection-limits",
      "relationship": "fed_by",
      "description": "provides os_limits_report needed here"
    },
    {
      "flow_name": "rtw-artillery-ws-load-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rtw-load-test-capacity-report",
      "relationship": "feeds_into",
      "description": "outputs k6_summary consumed by rtw-load-test-capacity-report"
    },
    {
      "flow_name": "rtw-message-envelope",
      "relationship": "fed_by",
      "description": "provides protocol_spec needed here"
    }
  ]
}
