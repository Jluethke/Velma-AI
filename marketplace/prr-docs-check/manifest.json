{
  "name": "prr-docs-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "documentation",
    "changelog",
    "docstrings",
    "doctest"
  ],
  "inputs": [
    "diff_file",
    "changed_files",
    "compat_findings",
    "findings_dir"
  ],
  "outputs": [
    "docs_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Verify docstrings, README, CHANGELOG and migration notes cover the PR's changes, run doc examples and link checks, and flag stale documentation.",
  "related_flows": [
    {
      "flow_name": "prr-self-review-before-request",
      "relationship": "fed_by",
      "description": "provides diff_file, changed_files needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-test-revert-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-gitleaks-secrets-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-api-compat-pass",
      "relationship": "fed_by",
      "description": "provides compat_findings needed here"
    },
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides diff_file, changed_files needed here"
    }
  ]
}
