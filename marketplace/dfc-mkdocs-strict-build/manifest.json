{
  "name": "dfc-mkdocs-strict-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "mkdocs",
    "material",
    "docs-site",
    "strict-build",
    "mkdocstrings"
  ],
  "inputs": [
    "repo_path",
    "doc_plan"
  ],
  "outputs": [
    "site_dir",
    "site_build_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a MkDocs Material site with Diataxis navigation, Mermaid and link validation, and fix warnings until mkdocs build --strict exits 0.",
  "related_flows": [
    {
      "flow_name": "dfc-audience-doctype-plan",
      "relationship": "fed_by",
      "description": "provides doc_plan needed here"
    },
    {
      "flow_name": "dfc-lychee-link-check",
      "relationship": "feeds_into",
      "description": "outputs site_dir consumed by dfc-lychee-link-check"
    }
  ]
}
