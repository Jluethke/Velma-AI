{
  "name": "vsens-gnss-nmea-gpsd",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "gnss",
    "nmea",
    "gpsd",
    "pynmea2",
    "gps"
  ],
  "inputs": [
    "sensor_inventory",
    "gnss_device"
  ],
  "outputs": [
    "gnss_stream_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Read a GNSS receiver's NMEA stream through gpsd, validate checksums, decode GGA, RMC, GSA and GST fix fields, and measure NMEA arrival delay.",
  "related_flows": [
    {
      "flow_name": "vsens-sensor-inventory",
      "relationship": "fed_by",
      "description": "provides sensor_inventory needed here"
    },
    {
      "flow_name": "vsens-pps-chrony",
      "relationship": "feeds_into",
      "description": "outputs gnss_stream_report consumed by vsens-pps-chrony"
    },
    {
      "flow_name": "vsens-gnss-ubx-config",
      "relationship": "feeds_into",
      "description": "outputs gnss_stream_report consumed by vsens-gnss-ubx-config"
    },
    {
      "flow_name": "vsens-gnss-ntrip-rtk",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-ptp-linuxptp",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-ros2-stamp-latency",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-camera-led-latency",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
