{
  "name": "rtw-toxiproxy-disconnect-test",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "realtime",
    "toxiproxy",
    "chaos-testing",
    "network-faults"
  ],
  "inputs": [
    "server_url",
    "backpressure_policy",
    "heartbeat_config",
    "reconnect_client",
    "reconciliation_impl"
  ],
  "outputs": [
    "chaos_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run reset, black hole, bandwidth and latency faults through Toxiproxy and check heartbeat, reconnect, backpressure and reconciliation behavior.",
  "related_flows": [
    {
      "flow_name": "rtw-close-code-map",
