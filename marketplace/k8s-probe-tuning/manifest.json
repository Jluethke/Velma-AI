    },
    {
      "flow_name": "k8s-node-health-endpoints",
      "relationship": "fed_by",
      "description": "provides node_health_endpoints needed here"
    },
    {
      "flow_name": "k8s-go-health-endpoints",
      "relationship": "fed_by",
      "description": "provides go_health_endpoints needed here"
    },
    {
      "flow_name": "k8s-jvm-health-endpoints",
      "relationship": "fed_by",
      "description": "provides jvm_health_endpoints needed here"
    },
    {
      "flow_name": "k8s-rollout-status-watch",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-configmap-secret-wiring",
      "relationship": "fed_by",
