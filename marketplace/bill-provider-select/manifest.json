{
  "name": "bill-provider-select",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "billing",
    "stripe",
    "paddle",
    "lemon-squeezy",
    "merchant-of-record"
  ],
  "inputs": [
    "product_profile",
    "seller_jurisdictions",
    "sell_to_consumers"
  ],
  "outputs": [
    "billing_provider",
    "provider_rationale"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Choose between Stripe Billing and a merchant-of-record provider (Paddle or Lemon Squeezy) from tax, entity and product facts using a fixed decision table.",
  "related_flows": [
