      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "bill-mor-lemonsqueezy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "bill-entitlements-model",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "bill-revenue-metrics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
