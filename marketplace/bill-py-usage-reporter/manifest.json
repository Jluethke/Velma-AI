{
  "name": "bill-py-usage-reporter",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "billing",
    "stripe",
    "metering",
    "python",
    "workers"
  ],
  "inputs": [
    "usage_outbox_schema",
    "meter_config"
  ],
  "outputs": [
    "usage_reporter",
    "report_run_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run a Python worker that drains the usage outbox to Stripe meter events with idempotent identifiers, retry on transient errors and late-event handling.",
  "related_flows": [
    {
      "flow_name": "bill-stripe-meter-create",
      "relationship": "fed_by",
      "description": "provides meter_config needed here"
    },
    {
      "flow_name": "bill-usage-event-capture",
      "relationship": "fed_by",
      "description": "provides usage_outbox_schema needed here"
    },
    {
      "flow_name": "bill-node-usage-reporter",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "bill-usage-reconcile",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
