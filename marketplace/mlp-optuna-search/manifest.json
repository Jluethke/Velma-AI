{
  "name": "mlp-optuna-search",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "optuna",
    "hyperparameter-search"
  ],
  "inputs": [
    "feature_pipeline",
    "split_manifest",
    "primary_metric",
    "baseline_scores",
    "search_space",
    "n_trials",
    "stack",
    "tracker",
    "mlflow_run_ref",
    "wandb_run_ref"
  ],
  "outputs": [
    "best_params",
    "optuna_study_ref",
    "tuned_model"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Runs a seeded, resumable Optuna study (TPE sampler, SQLite storage, pruning for iterative models) whose objective scores only the saved CV folds, logs every trial to the project tracker, and refits the best configuration into `tuned_model` without touching test data.",
  "related_flows": [
    {
      "flow_name": "mlp-bootstrap-metric-ci",
      "relationship": "feeds_into",
      "description": "outputs tuned_model consumed by mlp-bootstrap-metric-ci"
    },
    {
      "flow_name": "mlp-calibration-diagnose",
      "relationship": "feeds_into",
      "description": "outputs tuned_model consumed by mlp-calibration-diagnose"
    },
    {
      "flow_name": "mlp-inference-parity-test",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "mlp-sklearn-seed-determinism",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-torch-seed-determinism",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-baseline-models",
      "relationship": "fed_by",
      "description": "provides baseline_scores needed here"
    },
    {
      "flow_name": "mlp-sklearn-feature-pipeline",
      "relationship": "fed_by",
      "description": "provides feature_pipeline needed here"
    },
    {
      "flow_name": "mlp-mlflow-tracking",
      "relationship": "fed_by",
      "description": "provides mlflow_run_ref needed here"
    }
  ]
}
