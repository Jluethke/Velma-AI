{
  "name": "rag-answer-cache-redis",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rag",
    "cache",
    "redis",
    "multi-tenant",
    "invalidation"
  ],
  "inputs": [
    "prompt_template",
    "redis_url",
    "cache_ttl_seconds",
    "work_dir"
  ],
  "outputs": [
    "answer_cache",
    "cache_test_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Cache validated RAG answers in Redis under a key holding the normalized question, access filters, index, prompt and generator versions, with a TTL.",
  "related_flows": [
    {
      "flow_name": "rag-prompt-citation-assembly",
      "relationship": "fed_by",
      "description": "provides prompt_template needed here"
    },
    {
      "flow_name": "rag-retrieved-injection-defense",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-answer-faithfulness-score",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-failure-analysis-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
