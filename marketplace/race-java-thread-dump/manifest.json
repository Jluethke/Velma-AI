{
  "name": "race-java-thread-dump",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "java",
    "jstack",
    "jcmd",
    "thread-dump",
    "deadlock"
  ],
  "inputs": [
    "repo_path",
    "stress_command",
    "failure_class"
  ],
  "outputs": [
    "java_thread_dump_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Takes repeated thread dumps of a hung JVM with `jcmd Thread.print -l` or `jstack -l`, reads the JVM's own `Found one Java-level deadlock` section, and for cases the JVM does not detect (ReentrantLock without owner, thread pool starvation, virtual thread pinning) builds the wait-for graph by hand.",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "fed_by",
      "description": "provides failure_class needed here"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "fed_by",
      "description": "provides stress_command needed here"
    },
    {
      "flow_name": "race-go-goroutine-dump",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-cpp-tsan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-py-hang-dump",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs java_thread_dump_report consumed by race-findings-consolidate"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
