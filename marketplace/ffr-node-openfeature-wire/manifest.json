{
  "name": "ffr-node-openfeature-wire",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "openfeature",
    "nodejs",
    "typescript",
    "sdk"
  ],
  "inputs": [
    "flag_spec",
    "provider_choice",
    "flagd_config",
    "unleash_config",
    "launchdarkly_config",
    "repo_path"
  ],
  "outputs": [
    "node_flag_wiring"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Register the OpenFeature server provider once with setProviderAndWait in a Node.js service and replace one decision with an awaited typed evaluation.",
  "related_flows": [
    {
      "flow_name": "ffr-flag-type-classify",
      "relationship": "fed_by",
      "description": "provides flag_spec needed here"
    },
    {
      "flow_name": "ffr-provider-select",
      "relationship": "fed_by",
      "description": "provides provider_choice needed here"
    },
    {
      "flow_name": "ffr-flagd-local-setup",
      "relationship": "fed_by",
      "description": "provides flagd_config needed here"
    },
    {
      "flow_name": "ffr-unleash-setup",
      "relationship": "fed_by",
      "description": "provides unleash_config needed here"
    },
    {
      "flow_name": "ffr-launchdarkly-setup",
      "relationship": "fed_by",
      "description": "provides launchdarkly_config needed here"
    },
    {
      "flow_name": "ffr-safe-default-audit",
      "relationship": "feeds_into",
      "description": "outputs node_flag_wiring consumed by ffr-safe-default-audit"
    }
  ]
}
