{
  "name": "brand-conflict-search",
  "version": "1.0.0",
  "domain": "business",
  "tags": [
    "naming",
    "branding",
    "trademark",
    "conflict-check",
    "linkedin",
    "uspto"
  ],
  "fabric": false,
  "inputs": [
    "shortlist_names",
    "conflict_depth",
    "search_domains_to_include"
  ],
  "outputs": [
    "conflict_report",
    "safe_names"
  ],
  "execution_pattern": "linear",
  "price": "0",
  "license": "OPEN",
  "description": "For each candidate name: runs WebSearch (web presence), USPTO TESS (trademark), and LinkedIn Company search (existing companies) to surface brand conflicts before registration.",
  "related_flows": [
    {
      "flow_name": "naming-shortlister",
      "relationship": "feeds_into",
      "description": "outputs conflict_report consumed by naming-shortlister"
    }
  ]
}
