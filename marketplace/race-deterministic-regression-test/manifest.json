{
  "name": "race-deterministic-regression-test",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "concurrency",
    "regression-test",
    "latch",
    "synctest",
    "testing"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "race_sites",
    "root_cause"
  ],
  "outputs": [
    "regression_test"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Writes one regression test per root cause that forces the bad interleaving every run with explicit gates (latches, events, controlled promises, test hooks, Go `testing/synctest`), proves it fails on the unfixed code, and keeps it in the suite without sleeps or retries.",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "fed_by",
      "description": "provides race_sites, root_cause needed here"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-apply-fix",
      "relationship": "feeds_into",
      "description": "outputs regression_test consumed by race-apply-fix"
    },
    {
      "flow_name": "race-stress-verify",
      "relationship": "feeds_into",
      "description": "outputs regression_test consumed by race-stress-verify"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
