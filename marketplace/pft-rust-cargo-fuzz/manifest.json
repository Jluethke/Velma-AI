{
  "name": "pft-rust-cargo-fuzz",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rust",
    "cargo-fuzz",
    "libfuzzer",
    "arbitrary",
    "fuzzing"
  ],
  "inputs": [
    "fuzz_targets",
    "seed_corpus",
    "fuzz_dictionary",
    "sanitizer_build_config",
    "repo_path",
    "fuzz_time"
  ],
  "outputs": [
    "rust_fuzz_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Create cargo-fuzz targets with libfuzzer-sys and the arbitrary crate, run them under a sanitizer for a fixed time and collect artifacts.",
  "related_flows": [
    {
      "flow_name": "pft-invariant-discovery",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pft-fuzz-target-selection",
      "relationship": "fed_by",
      "description": "provides fuzz_targets needed here"
    },
    {
      "flow_name": "pft-sanitizer-builds",
      "relationship": "fed_by",
      "description": "provides sanitizer_build_config needed here"
    },
    {
      "flow_name": "pft-corpus-seeding",
      "relationship": "fed_by",
      "description": "provides fuzz_dictionary, seed_corpus needed here"
    },
    {
      "flow_name": "pft-cpp-libfuzzer-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pft-coverage-plateau-analysis",
      "relationship": "feeds_into",
      "description": "outputs rust_fuzz_findings consumed by pft-coverage-plateau-analysis"
    },
    {
      "flow_name": "pft-crash-triage-dedup",
      "relationship": "feeds_into",
      "description": "outputs rust_fuzz_findings consumed by pft-crash-triage-dedup"
    },
    {
      "flow_name": "pft-crash-regression-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
