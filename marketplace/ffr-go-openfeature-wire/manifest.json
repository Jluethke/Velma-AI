{
  "name": "ffr-go-openfeature-wire",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "openfeature",
    "go",
    "sdk",
    "race-detector"
  ],
  "inputs": [
    "flag_spec",
    "provider_choice",
    "flagd_config",
    "unleash_config",
    "launchdarkly_config",
    "repo_path"
  ],
  "outputs": [
    "go_flag_wiring"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Set the OpenFeature provider once in a Go service main and replace one decision with a typed evaluation that falls back to the default on error.",
  "related_flows": [
    {
      "flow_name": "ffr-flag-type-classify",
      "relationship": "fed_by",
      "description": "provides flag_spec needed here"
    },
    {
      "flow_name": "ffr-provider-select",
      "relationship": "fed_by",
      "description": "provides provider_choice needed here"
    },
    {
      "flow_name": "ffr-flagd-local-setup",
      "relationship": "fed_by",
      "description": "provides flagd_config needed here"
    },
    {
      "flow_name": "ffr-unleash-setup",
      "relationship": "fed_by",
      "description": "provides unleash_config needed here"
    },
    {
      "flow_name": "ffr-launchdarkly-setup",
      "relationship": "fed_by",
      "description": "provides launchdarkly_config needed here"
    },
    {
      "flow_name": "ffr-safe-default-audit",
      "relationship": "feeds_into",
      "description": "outputs go_flag_wiring consumed by ffr-safe-default-audit"
    }
  ]
}
