{
  "name": "ledg-pg-double-entry-schema",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ledger",
    "double-entry",
    "postgresql",
    "schema",
    "constraint-trigger"
  ],
  "inputs": [
    "database_url",
    "money_representation_spec"
  ],
  "outputs": [
    "ledger_schema"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Create a PostgreSQL double-entry ledger schema with a deferred trigger that rejects unbalanced journal entries per currency.",
  "related_flows": [
    {
      "flow_name": "ledg-pg-immutable-reversals",
      "relationship": "feeds_into",
      "description": "outputs ledger_schema consumed by ledg-pg-immutable-reversals"
    },
    {
      "flow_name": "ledg-pg-idempotent-posting",
      "relationship": "feeds_into",
      "description": "outputs ledger_schema consumed by ledg-pg-idempotent-posting"
    },
    {
      "flow_name": "ledg-pg-balance-locking",
      "relationship": "feeds_into",
      "description": "outputs ledger_schema consumed by ledg-pg-balance-locking"
    },
    {
      "flow_name": "ledg-float-money-audit",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "ledg-money-representation-decision",
      "relationship": "fed_by",
      "description": "provides money_representation_spec needed here"
    },
    {
      "flow_name": "ledg-rounding-policy",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "ledg-allocate-remainder",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "ledg-py-decimal-money",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
