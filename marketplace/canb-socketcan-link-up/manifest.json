{
  "name": "canb-socketcan-link-up",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "socketcan",
    "iproute2",
    "can-fd",
    "listen-only"
  ],
  "inputs": [
    "can_netdev",
    "bit_timing",
    "tx_permission",
    "restart_ms"
  ],
  "outputs": [
    "link_state"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Configure and bring up a SocketCAN interface with ip link and verify bit rate, FD, listen-only and controller state from the detailed statistics.",
  "related_flows": [
    {
      "flow_name": "canb-tx-scope-check",
      "relationship": "fed_by",
      "description": "provides tx_permission needed here"
    },
    {
      "flow_name": "canb-usb-adapter-bringup",
      "relationship": "fed_by",
      "description": "provides can_netdev needed here"
    },
    {
      "flow_name": "canb-termination-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "canb-bit-timing-calc",
      "relationship": "fed_by",
      "description": "provides bit_timing needed here"
    },
    {
      "flow_name": "canb-candump-capture",
      "relationship": "feeds_into",
      "description": "outputs link_state consumed by canb-candump-capture"
    },
    {
      "flow_name": "canb-error-frame-diagnosis",
      "relationship": "feeds_into",
      "description": "outputs link_state consumed by canb-error-frame-diagnosis"
    },
    {
      "flow_name": "canb-busoff-recovery",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-canbusload-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
