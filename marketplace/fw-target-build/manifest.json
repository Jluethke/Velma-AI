    },
    {
      "flow_name": "fw-project-scaffold",
      "relationship": "fed_by",
      "description": "provides firmware_source needed here"
    },
    {
      "flow_name": "fw-drivers-logic",
      "relationship": "fed_by",
      "description": "provides firmware_tests needed here"
    },
    {
      "flow_name": "pcb-stock-sourcing",
      "relationship": "fed_by",
      "description": "provides bom needed here"
    },
    {
      "flow_name": "fw-flash-verify",
      "relationship": "feeds_into",
      "description": "outputs flash_procedure, firmware_build consumed by fw-flash-verify"
    }
  ]
}
