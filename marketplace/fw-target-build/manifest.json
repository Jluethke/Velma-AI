    "embedded",
    "build",
    "flash"
  ],
  "inputs": [
    "firmware_source",
    "firmware_tests",
    "bom"
  ],
  "outputs": [
    "firmware_build",
    "flash_procedure"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build tested firmware for the target with warnings as errors, keep flash and RAM under 80%, and write a flash procedure ending in a check that proves the exact artifact runs.",
  "related_flows": [
    {
      "flow_name": "fw-pin-map",
