{
  "name": "parity-cpp-vector-harness",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "parity",
    "cpp",
    "test-harness",
    "golden-vectors"
  ],
  "inputs": [
    "port_repo",
    "serialization_spec",
    "golden_manifest",
    "fp_flags"
  ],
  "outputs": [
    "harness_binary"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a standalone C++ harness that reads golden vectors, calls the port with production flags, and writes outputs as IEEE 754 bit patterns.",
  "related_flows": [
    {
      "flow_name": "parity-contract-scope",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "parity-canonical-serialization",
      "relationship": "fed_by",
      "description": "provides serialization_spec needed here"
    },
    {
      "flow_name": "parity-py-golden-vectors",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "parity-golden-manifest-lock",
      "relationship": "fed_by",
      "description": "provides golden_manifest needed here"
    },
    {
      "flow_name": "parity-ulp-compare",
      "relationship": "feeds_into",
      "description": "outputs harness_binary consumed by parity-ulp-compare"
    },
    {
      "flow_name": "parity-fp-flag-baseline",
      "relationship": "fed_by",
      "description": "provides fp_flags needed here"
    }
  ]
}
