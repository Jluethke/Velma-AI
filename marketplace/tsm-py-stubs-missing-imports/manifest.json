{
  "name": "tsm-py-stubs-missing-imports",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "python",
    "typeshed",
    "stubs",
    "py.typed"
  ],
  "inputs": [
    "repo_path",
    "py_error_baseline"
  ],
  "outputs": [
    "py_stub_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Resolve every import-untyped and import-not-found error with a version-matched types- stub package, a py.typed upgrade, a stubgen stub, or a scoped ignore override.",
  "related_flows": [
    {
      "flow_name": "tsm-migration-intake",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-error-baseline",
      "relationship": "fed_by",
      "description": "provides py_error_baseline needed here"
    },
    {
      "flow_name": "tsm-py-type-coverage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-conversion-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-mypy-module-strict",
      "relationship": "feeds_into",
      "description": "outputs py_stub_report consumed by tsm-py-mypy-module-strict"
    },
    {
      "flow_name": "tsm-py-pyright-strict",
      "relationship": "feeds_into",
      "description": "outputs py_stub_report consumed by tsm-py-pyright-strict"
    },
    {
      "flow_name": "tsm-py-annotate-module",
      "relationship": "feeds_into",
      "description": "outputs py_stub_report consumed by tsm-py-annotate-module"
    },
    {
      "flow_name": "tsm-py-typeddict-protocol",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
