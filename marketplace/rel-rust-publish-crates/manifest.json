{
  "name": "rel-rust-publish-crates",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "rust",
    "crates-io",
    "cargo-publish",
    "trusted-publishing"
  ],
  "inputs": [
    "repo_path",
    "package_name",
    "next_version",
    "rust_dist",
    "provenance_verification"
  ],
  "outputs": [
    "crates_release_url"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Publish a Rust crate to crates.io after a packaged dry run, using crates.io trusted publishing or a scoped token, in workspace dependency order.",
  "related_flows": [
    {
      "flow_name": "rel-semver-bump-decision",
      "relationship": "fed_by",
      "description": "provides next_version needed here"
    },
    {
      "flow_name": "rel-rust-reproducible-build",
      "relationship": "fed_by",
      "description": "provides rust_dist needed here"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "fed_by",
      "description": "provides provenance_verification needed here"
    },
    {
      "flow_name": "rel-rust-verify-install",
      "relationship": "feeds_into",
      "description": "outputs crates_release_url consumed by rel-rust-verify-install"
    }
  ]
}
