{
  "name": "pkg-public-api-inventory",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "api-design",
    "packaging",
    "public-api",
    "library"
  ],
  "inputs": [
    "package_profile",
    "project_dir"
  ],
  "outputs": [
    "public_api",
    "api_leaks"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "List every symbol a library currently exposes, classify each as intended public API or accidental leak with a decision table, and record the leaks to close before release.",
  "related_flows": [
    {
      "flow_name": "pkg-scope-intake",
      "relationship": "fed_by",
      "description": "provides package_profile needed here"
    },
    {
      "flow_name": "pkg-license-metadata",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "pkg-py-dunder-all-exports",
      "relationship": "feeds_into",
      "description": "outputs public_api consumed by pkg-py-dunder-all-exports"
    },
    {
      "flow_name": "pkg-node-exports-map",
      "relationship": "feeds_into",
      "description": "outputs public_api consumed by pkg-node-exports-map"
    },
    {
      "flow_name": "pkg-rust-pub-surface",
      "relationship": "feeds_into",
      "description": "outputs public_api consumed by pkg-rust-pub-surface"
    },
    {
      "flow_name": "pkg-go-internal-packages",
      "relationship": "feeds_into",
      "description": "outputs public_api consumed by pkg-go-internal-packages"
    },
    {
      "flow_name": "pkg-py-griffe-api-diff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-node-api-extractor-diff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
