{
  "name": "sqlo-mysql-perf-schema-digest",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "mysql",
    "performance_schema",
    "sys-schema",
    "index-usage"
  ],
  "inputs": [
    "tuning_scope",
    "slow_query_list"
  ],
  "outputs": [
    "digest_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Classify MySQL statement digests by full scans, disk temp tables and sort merges, and list unused and redundant indexes.",
  "related_flows": [
    {
      "flow_name": "sqlo-baseline-scope",
      "relationship": "fed_by",
      "description": "provides tuning_scope needed here"
    },
    {
      "flow_name": "sqlo-mysql-slow-log-capture",
      "relationship": "fed_by",
      "description": "provides slow_query_list needed here"
    },
    {
      "flow_name": "sqlo-sargable-rewrite",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-keyset-pagination",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-btree-composite-order",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-index-write-cost",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-prod-like-verify",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-mysql-explain-analyze-read",
      "relationship": "feeds_into",
      "description": "outputs digest_findings consumed by sqlo-mysql-explain-analyze-read"
    }
  ]
}
