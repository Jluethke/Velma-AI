{
  "name": "enc-fit-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "enclosure",
    "mechanical",
    "fit-check",
    "interference",
    "build123d"
  ],
  "inputs": [
    "enclosure_source",
    "board_step",
    "board_envelope"
  ],
  "outputs": [
    "fit_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Prove an enclosure fits its board: zero interference volume, clearance above the tallest part, every mating plug clearing its cutout, and walls meeting process minimums.",
  "related_flows": [
    {
      "flow_name": "enc-board-3d-export",
      "relationship": "fed_by",
      "description": "provides board_envelope, board_step needed here"
    },
    {
      "flow_name": "enc-parametric-model",
      "relationship": "fed_by",
      "description": "provides enclosure_source needed here"
    },
    {
      "flow_name": "enc-manufacturing-export",
      "relationship": "feeds_into",
      "description": "outputs fit_report consumed by enc-manufacturing-export"
    },
    {
      "flow_name": "hw-system-acceptance",
      "relationship": "feeds_into",
      "description": "outputs fit_report consumed by hw-system-acceptance"
    }
  ]
}
