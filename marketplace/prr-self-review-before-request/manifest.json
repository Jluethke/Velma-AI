{
  "name": "prr-self-review-before-request",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "self-review",
    "pull-request",
    "git",
    "author"
  ],
  "inputs": [
    "repo_dir",
    "base_branch",
    "test_command"
  ],
  "outputs": [
    "self_review_report",
    "pr_description_draft",
    "diff_file",
    "changed_files",
    "diff_stat"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Author-side self-review of a branch diff: remove leftovers, run the CI checks locally, clean history and draft the PR description before requesting review.",
  "related_flows": [
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "feeds_into",
      "description": "outputs changed_files consumed by prr-intent-scope-check"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "feeds_into",
      "description": "outputs diff_stat consumed by prr-large-pr-split"
    },
    {
      "flow_name": "prr-test-revert-check",
      "relationship": "feeds_into",
      "description": "outputs changed_files consumed by prr-test-revert-check"
    },
    {
      "flow_name": "prr-gitleaks-secrets-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-api-compat-pass",
      "relationship": "feeds_into",
      "description": "outputs diff_file, changed_files consumed by prr-api-compat-pass"
    },
    {
      "flow_name": "prr-docs-check",
      "relationship": "feeds_into",
      "description": "outputs diff_file, changed_files consumed by prr-docs-check"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "feeds_into",
      "description": "outputs changed_files consumed by prr-diff-reading-order"
    },
    {
      "flow_name": "prr-correctness-pass",
      "relationship": "feeds_into",
      "description": "outputs diff_file consumed by prr-correctness-pass"
    }
  ]
}
