{
  "name": "xarch-go-cross-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "cross-compile",
    "aarch64",
    "go",
    "cgo",
    "goarch"
  ],
  "inputs": [
    "target_triple",
    "toolchain_prefix",
    "project_dir",
    "cgo_enabled"
  ],
  "outputs": [
    "go_binary",
    "go_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Cross-build a Go program for aarch64 with GOOS=linux GOARCH=arm64, set CC for cgo when required, and verify the output ELF and its linkage.",
  "related_flows": [
    {
      "flow_name": "xarch-target-triple-select",
      "relationship": "fed_by",
      "description": "provides target_triple needed here"
    },
    {
      "flow_name": "xarch-gcc-toolchain-select",
      "relationship": "fed_by",
      "description": "provides toolchain_prefix needed here"
    }
  ]
}
