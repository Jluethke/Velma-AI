{
  "name": "tsm-ts-ci-gate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "typescript",
    "ci",
    "github-actions",
    "ratchet"
  ],
  "inputs": [
    "repo_path",
    "migration_profile",
    "ts_type_coverage",
    "ts_boundary_validators",
    "ci_platform"
  ],
  "outputs": [
    "ts_ci_gate"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Add a required CI job that fails on any tsc error, any typed-lint warning, or a type-coverage drop below the recorded baseline, with the TypeScript version pinned.",
  "related_flows": [
    {
      "flow_name": "tsm-migration-intake",
      "relationship": "fed_by",
      "description": "provides migration_profile needed here"
    },
    {
      "flow_name": "tsm-ts-error-baseline",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tsm-ts-type-coverage",
      "relationship": "fed_by",
      "description": "provides ts_type_coverage needed here"
    },
    {
      "flow_name": "tsm-ts-noimplicitany",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-strictnullchecks",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-strict-family-flags",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-eliminate-any",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-conversion-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
