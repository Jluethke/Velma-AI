{
  "name": "uic-component-docs",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "documentation",
    "storybook",
    "mdx",
    "docgen",
    "frontend"
  ],
  "inputs": [
    "component_contract",
    "keyboard_map",
    "story_files",
    "component_path"
  ],
  "outputs": [
    "component_docs"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a Storybook MDX docs page with docgen prop tables, real story examples, the keyboard map, accessibility and i18n notes, compiled by the Storybook build.",
  "related_flows": [
    {
      "flow_name": "uic-props-state-events-contract",
      "relationship": "fed_by",
      "description": "provides component_contract, component_path needed here"
    },
    {
      "flow_name": "uic-aria-pattern-select",
      "relationship": "fed_by",
      "description": "provides keyboard_map needed here"
    },
    {
      "flow_name": "uic-storybook-stories",
      "relationship": "fed_by",
      "description": "provides story_files needed here"
    },
    {
      "flow_name": "uic-visual-regression",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-bundle-size-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-component-ship-gate",
      "relationship": "feeds_into",
      "description": "outputs component_docs consumed by uic-component-ship-gate"
    }
  ]
}
