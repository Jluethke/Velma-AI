{
  "name": "tsm-py-ci-gate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "python",
    "ci",
    "pre-commit",
    "ratchet"
  ],
  "inputs": [
    "repo_path",
    "migration_profile",
    "py_type_coverage",
    "py_boundary_validators",
    "ci_platform"
  ],
  "outputs": [
    "py_ci_gate"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Add a required CI job that fails on any mypy or pyright error, unused ignore, or type-coverage drop below baseline, with the checker version pinned.",
  "related_flows": [
    {
      "flow_name": "tsm-migration-intake",
      "relationship": "fed_by",
      "description": "provides migration_profile needed here"
    },
    {
      "flow_name": "tsm-py-error-baseline",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-py-type-coverage",
      "relationship": "fed_by",
      "description": "provides py_type_coverage needed here"
    },
    {
      "flow_name": "tsm-ts-error-baseline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-type-coverage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-ci-gate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-conversion-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-stubs-missing-imports",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
