{
  "name": "fusa-fta-scram-cut-sets",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "functional-safety",
    "fault-tree-analysis",
    "scram",
    "open-psa",
    "cut-sets"
  ],
  "inputs": [
    "safety_goals",
    "dfmea_worksheet",
    "failure_probabilities"
  ],
  "outputs": [
    "fault_tree_xml",
    "cut_set_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a fault tree for one safety goal in Open-PSA MEF XML, run SCRAM for minimal cut sets, and report single-point failures and common-cause candidates.",
  "related_flows": [
    {
      "flow_name": "fusa-dfmea-worksheet",
      "relationship": "fed_by",
      "description": "provides dfmea_worksheet needed here"
    },
    {
      "flow_name": "fusa-sw-fmea-interface-guidewords",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "fusa-dependent-failure-analysis",
      "relationship": "feeds_into",
      "description": "outputs cut_set_report consumed by fusa-dependent-failure-analysis"
    },
    {
      "flow_name": "fusa-fault-injection-campaign-plan",
      "relationship": "feeds_into",
      "description": "outputs cut_set_report consumed by fusa-fault-injection-campaign-plan"
    },
    {
      "flow_name": "fusa-fault-injection-mcu-gdb",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "fusa-fault-injection-linux",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "fusa-safety-goals-safe-states",
      "relationship": "fed_by",
      "description": "provides safety_goals needed here"
    }
  ]
}
