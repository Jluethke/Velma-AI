{
  "name": "s2i-test-vectors-extract",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "spec",
    "test-vectors",
    "wycheproof",
    "openssl",
    "conformance"
  ],
  "inputs": [
    "spec_bundle",
    "errata_log",
    "requirements_table",
    "project_dir"
  ],
  "outputs": [
    "test_vectors"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Transcribe every spec test vector into cited machine-readable JSON and verify it with length checks and independent tools.",
  "related_flows": [
    {
      "flow_name": "s2i-spec-acquire-pin",
      "relationship": "fed_by",
      "description": "provides spec_bundle needed here"
    },
    {
      "flow_name": "s2i-errata-check",
      "relationship": "fed_by",
      "description": "provides errata_log needed here"
    },
    {
      "flow_name": "s2i-bcp14-keyword-scan",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "s2i-requirements-table",
      "relationship": "fed_by",
      "description": "provides requirements_table needed here"
    },
    {
      "flow_name": "s2i-ambiguity-log",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "s2i-conformance-test-design",
      "relationship": "feeds_into",
      "description": "outputs test_vectors consumed by s2i-conformance-test-design"
    },
    {
      "flow_name": "s2i-go-test-conformance",
      "relationship": "feeds_into",
      "description": "outputs test_vectors consumed by s2i-go-test-conformance"
    },
    {
      "flow_name": "s2i-public-test-suite-run",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
