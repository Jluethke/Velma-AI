{
  "name": "sigre-savvycan-sniffer-isolate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "savvycan",
    "flow-view",
    "reverse-engineering",
    "offline-analysis"
  ],
  "inputs": [
    "capture_logs",
    "capture_plan"
  ],
  "outputs": [
    "savvycan_candidates"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Load logs into SavvyCAN with no hardware connection and use Flow View, Frame Info and Sniffer to find bytes that change only during actions.",
  "related_flows": [
    {
      "flow_name": "sigre-capture-plan-labeled-actions",
      "relationship": "fed_by",
      "description": "provides capture_plan needed here"
    },
    {
      "flow_name": "sigre-log-normalize-convert",
      "relationship": "fed_by",
      "description": "provides capture_logs needed here"
    },
    {
      "flow_name": "sigre-byte-change-count-diff",
      "relationship": "feeds_into",
      "description": "outputs savvycan_candidates consumed by sigre-byte-change-count-diff"
    }
  ]
}
