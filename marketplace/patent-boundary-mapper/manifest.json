{
  "name": "patent-boundary-mapper",
  "version": "1.0.0",
  "domain": "legal",
  "description": "Maps boundaries between related patent families to prevent claim overlap, generate cross-references, and delineate scope. Essential for multi-family patent portfolios where inventions interface with each other.",
  "tags": [
    "patent",
    "boundary",
    "portfolio",
    "intellectual-property",
    "legal",
    "cross-reference",
    "claim-scope",
    "family"
  ],
  "inputs": [
    "families",
    "family_claims",
    "known_interfaces"
  ],
  "outputs": [
    "boundary_map",
    "conflicts",
    "cross_references",
    "boundary_document"
  ],
  "execution_pattern": "linear",
  "price": 0,
  "license": "PRIVATE",
  "min_shadow_count": 3,
  "graduation_threshold": 0.75,
  "related_flows": [
    {
      "flow_name": "patent-claims-drafter",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "patent-spec-writer",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
