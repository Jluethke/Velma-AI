{
  "name": "tf-version-pinning",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "terraform",
    "iac",
    "providers",
    "lock-file",
    "versioning"
  ],
  "inputs": [
    "root_modules",
    "terraform_version",
    "lock_platforms"
  ],
  "outputs": [
    "version_constraints",
    "lock_file_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Pin Terraform and provider versions with the right constraint operator for root and child modules, generate a multi-platform dependency lock file, and pin the CLI in CI.",
  "related_flows": [
    {
      "flow_name": "tf-repo-layout",
