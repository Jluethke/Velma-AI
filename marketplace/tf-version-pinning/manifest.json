      "description": "provides root_modules needed here"
    },
    {
      "flow_name": "tf-env-strategy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tf-state-s3-backend",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tf-fmt-validate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tf-tflint",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tf-provider-upgrade",
      "relationship": "feeds_into",
      "description": "outputs version_constraints consumed by tf-provider-upgrade"
    }
  ]
}
