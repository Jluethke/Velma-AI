{
  "name": "ci0-flaky-detect-junit",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ci",
    "flaky-tests",
    "junit",
    "reruns"
  ],
  "inputs": [
    "ci_platform",
    "repo_slug",
    "gitlab_project_path",
    "junit_report_globs",
    "rerun_count"
  ],
  "outputs": [
    "flaky_tests"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Find flaky tests from same-commit pass and fail evidence in CI JUnit history and confirm each with isolated reruns.",
  "related_flows": [
    {
      "flow_name": "ci0-py-flaky-quarantine",
      "relationship": "feeds_into",
      "description": "outputs flaky_tests consumed by ci0-py-flaky-quarantine"
    },
    {
      "flow_name": "ci0-node-flaky-quarantine",
      "relationship": "feeds_into",
      "description": "outputs flaky_tests consumed by ci0-node-flaky-quarantine"
    },
    {
      "flow_name": "ci0-go-flaky-quarantine",
      "relationship": "feeds_into",
      "description": "outputs flaky_tests consumed by ci0-go-flaky-quarantine"
    },
    {
      "flow_name": "ci0-jvm-flaky-quarantine",
      "relationship": "feeds_into",
      "description": "outputs flaky_tests consumed by ci0-jvm-flaky-quarantine"
    },
    {
      "flow_name": "ci0-clean-room-command-check",
      "relationship": "fed_by",
      "description": "provides junit_report_globs needed here"
    }
  ]
}
