{
  "name": "pricing-model-writer",
  "version": "1.0.0",
  "domain": "business",
  "tags": [
    "pricing",
    "commercial-model",
    "business-plan",
    "investor-overview",
    "risk-register",
    "three-component-pricing",
    "licensing"
  ],
  "inputs": [
    "vertical",
    "product_brief",
    "voice_sample",
    "case_studies",
    "past_deals",
    "archetype_pack_registry",
    "target_intel_registry",
    "portfolio_proof",
    "credibility_line",
    "sender_signature"
  ],
  "outputs": [
    "pricing_business_plan_md",
    "investor_overview_md",
    "risk_register_md",
    "archetype_pricing_one_pagers",
    "provenance_map"
  ],
  "execution_pattern": "linear",
  "price": "20",
  "license": "COMMERCIAL",
  "min_shadow_count": 3,
  "graduation_threshold": 0.75,
  "description": "Produces a 3-component pricing document (Base License + Scale Royalty bps + Performance Share) per vertical, sized from past_deals and case_studies with every dollar figure provenanced to a real source. Baseline template + Claude refinement pattern with a fabrication gate that rejects unsourced claims.",
  "related_flows": [
    {
      "flow_name": "marketing-outreach-architect",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "outreach-engine",
      "relationship": "fed_by",
      "description": "provides archetype_pack_registry, target_intel_registry needed here"
    }
  ]
}
