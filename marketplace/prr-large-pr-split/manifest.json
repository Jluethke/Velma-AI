{
  "name": "prr-large-pr-split",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "large-pr",
    "stacked-pr",
    "git",
    "review-units"
  ],
  "inputs": [
    "repo_dir",
    "base_branch",
    "head_sha",
    "diff_stat",
    "intent_statement",
    "max_review_lines",
    "findings_dir"
  ],
  "outputs": [
    "review_units",
    "split_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure reviewable PR size excluding generated files and lockfiles and split an oversized PR into ordered review units by commit, layer or mechanical versus behavioral change.",
  "related_flows": [
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "fed_by",
      "description": "provides intent_statement needed here"
    },
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides head_sha, diff_stat needed here"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "feeds_into",
      "description": "outputs review_units consumed by prr-diff-reading-order"
    },
    {
      "flow_name": "prr-severity-comments",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-approval-decision",
      "relationship": "feeds_into",
      "description": "outputs review_units consumed by prr-approval-decision"
    },
    {
      "flow_name": "prr-gh-post-review",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-glab-post-review",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-test-revert-check",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
