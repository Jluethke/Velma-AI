{
  "name": "pcb-review-verdict",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "design-review",
    "verdict"
  ],
  "inputs": [
    "power_input_findings",
    "isolation_findings",
    "interlock_findings",
    "creepage_constraints"
  ],
  "outputs": [
    "review_report",
    "review_changes",
    "review_verdict"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Merge power-input, isolation, and interlock findings into one report, write the exact change for each failure, and set PASS or CHANGES_REQUIRED, looping back to part selection at most 3 times.",
  "related_flows": [
    {
      "flow_name": "pcb-power-input-review",
      "relationship": "fed_by",
      "description": "provides power_input_findings needed here"
    },
    {
      "flow_name": "pcb-isolation-review",
      "relationship": "fed_by",
      "description": "provides creepage_constraints, isolation_findings needed here"
    },
    {
      "flow_name": "pcb-interlock-fault-review",
      "relationship": "fed_by",
      "description": "provides interlock_findings needed here"
    },
    {
      "flow_name": "pcb-part-selection",
      "relationship": "feeds_into",
      "description": "outputs review_changes consumed by pcb-part-selection"
    },
    {
      "flow_name": "pcb-board-setup",
      "relationship": "feeds_into",
      "description": "outputs review_verdict consumed by pcb-board-setup"
    },
    {
      "flow_name": "fw-pin-map",
      "relationship": "feeds_into",
      "description": "outputs review_verdict consumed by fw-pin-map"
    },
    {
      "flow_name": "harness-connector-selection",
      "relationship": "feeds_into",
      "description": "outputs review_verdict consumed by harness-connector-selection"
    },
    {
      "flow_name": "hw-bringup-plan",
      "relationship": "feeds_into",
      "description": "outputs review_report consumed by hw-bringup-plan"
    }
  ]
}
