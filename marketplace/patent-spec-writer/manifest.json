{
  "name": "patent-spec-writer",
  "version": "1.0.0",
  "domain": "legal",
  "description": "Writes complete patent specification documents from claims and source code. Produces all USPTO-required sections: Title, Field, Background, Summary, Detailed Description, Abstract. Ensures enablement of every claim element and prior art differentiation.",
  "tags": [
    "patent",
    "specification",
    "USPTO",
    "intellectual-property",
    "legal",
    "enablement",
    "prior-art",
    "drafting"
  ],
  "inputs": [
    "claims",
    "invention_description",
    "source_code_paths",
    "prior_art",
    "related_families",
    "domain"
  ],
  "outputs": [
    "specification",
    "abstract",
    "figure_descriptions",
    "enablement_map",
    "completeness_report"
  ],
  "execution_pattern": "linear",
  "price": 0,
  "license": "PRIVATE",
  "min_shadow_count": 3,
  "graduation_threshold": 0.75,
  "related_flows": [
    {
      "flow_name": "patent-claims-drafter",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "data-extractor",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prior-art-searcher",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "patent-boundary-mapper",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "patent-drawing-generator",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "patent-spec-aligner",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "checklist-builder",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
