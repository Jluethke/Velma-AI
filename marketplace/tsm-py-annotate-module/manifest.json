{
  "name": "tsm-py-annotate-module",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "python",
    "annotations",
    "monkeytype",
    "reveal_type"
  ],
  "inputs": [
    "repo_path",
    "py_conversion_order",
    "py_stub_report",
    "migration_profile"
  ],
  "outputs": [
    "py_annotated_modules"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Annotate one Python module at a time in conversion order, drafting signatures from MonkeyType traces and confirming each with the checker and the test suite.",
  "related_flows": [
    {
      "flow_name": "tsm-migration-intake",
      "relationship": "fed_by",
      "description": "provides migration_profile needed here"
    },
    {
      "flow_name": "tsm-py-error-baseline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-type-coverage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-conversion-order",
      "relationship": "fed_by",
      "description": "provides py_conversion_order needed here"
    },
    {
      "flow_name": "tsm-py-stubs-missing-imports",
      "relationship": "fed_by",
      "description": "provides py_stub_report needed here"
    },
    {
      "flow_name": "tsm-py-mypy-module-strict",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-pyright-strict",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-typeddict-protocol",
      "relationship": "feeds_into",
      "description": "outputs py_annotated_modules consumed by tsm-py-typeddict-protocol"
    }
  ]
}
