{
  "name": "test-suite-compiler",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "test",
    "suite",
    "compiler"
  ],
  "inputs": [
    "dependency_graph",
    "edge_case_tests",
    "endpoint_registry",
    "error_path_tests",
    "happy_path_tests",
    "load_test_scenarios",
    "security_tests"
  ],
  "outputs": [
    "test_execution_plan",
    "test_suite"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process dependency_graph, edge_case_tests, endpoint_registry to produce test_execution_plan, test_suite.",
  "related_flows": [
    {
      "flow_name": "endpoint-metadata-extractor",
      "relationship": "fed_by",
      "description": "provides endpoint_registry, dependency_graph needed here"
    },
    {
      "flow_name": "happy-path-test-generator",
      "relationship": "fed_by",
      "description": "provides happy_path_tests needed here"
    },
    {
      "flow_name": "edge-case-test-generator",
      "relationship": "fed_by",
      "description": "provides edge_case_tests needed here"
    },
    {
      "flow_name": "error-security-test-generator",
      "relationship": "fed_by",
      "description": "provides security_tests, error_path_tests needed here"
    },
    {
      "flow_name": "load-performance-test-generator",
      "relationship": "fed_by",
      "description": "provides load_test_scenarios needed here"
    },
    {
      "flow_name": "test-code-generator",
      "relationship": "feeds_into",
      "description": "outputs test_execution_plan, test_suite consumed by test-code-generator"
    },
    {
      "flow_name": "test-documentation-generator",
      "relationship": "feeds_into",
      "description": "outputs test_execution_plan, test_suite consumed by test-documentation-generator"
    }
  ]
}
