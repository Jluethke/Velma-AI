{
  "name": "perf-py-spy-flamegraph",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "performance",
    "python",
    "py-spy",
    "flame-graph",
    "sampling-profiler"
  ],
  "inputs": [
    "workload_spec",
    "repo_path"
  ],
  "outputs": [
    "py_spy_profile"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Record a py-spy sampling profile of a launched or attached Python process in CPU or wall-clock mode and read the widest frames from its flame graph.",
  "related_flows": [
    {
      "flow_name": "perf-metric-workload-define",
      "relationship": "fed_by",
      "description": "provides workload_spec needed here"
    },
    {
      "flow_name": "perf-bench-env-stabilize",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-py-pytest-benchmark-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-bench-baseline-normalize",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-py-cprofile-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-flame-graph-read",
      "relationship": "feeds_into",
      "description": "outputs py_spy_profile consumed by perf-flame-graph-read"
    },
    {
      "flow_name": "perf-hotspot-classify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-fix-algorithmic-complexity",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
