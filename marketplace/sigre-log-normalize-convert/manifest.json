    },
    {
      "flow_name": "sigre-linux-candump-capture",
      "relationship": "fed_by",
      "description": "provides candump_logs needed here"
    },
    {
      "flow_name": "sigre-py-python-can-listen-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sigre-py-python-can-capture",
      "relationship": "fed_by",
      "description": "provides python_can_logs needed here"
    },
    {
