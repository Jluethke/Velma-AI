{
  "name": "ffr-py-openfeature-wire",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "openfeature",
    "python",
    "sdk",
    "evaluation-context"
  ],
  "inputs": [
    "flag_spec",
    "provider_choice",
    "flagd_config",
    "unleash_config",
    "launchdarkly_config",
    "repo_path"
  ],
  "outputs": [
    "py_flag_wiring"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Register the OpenFeature provider once in a Python service and replace one decision with a typed evaluation using the shared safe default and a stable targeting key.",
  "related_flows": [
