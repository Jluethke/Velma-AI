{
  "name": "prr-intent-scope-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "scope",
    "intent",
    "acceptance-criteria",
    "pull-request"
  ],
  "inputs": [
    "pr_description",
    "changed_files",
    "findings_dir",
    "linked_issue",
    "role"
  ],
  "outputs": [
    "intent_statement",
    "scope_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Turn the PR description and linked issue into an intent statement with checkable criteria and classify every changed file as in scope, supporting or out of scope.",
  "related_flows": [
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "feeds_into",
      "description": "outputs intent_statement consumed by prr-large-pr-split"
    },
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides pr_description, changed_files needed here"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-severity-comments",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-approval-decision",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-gh-post-review",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-glab-post-review",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-test-revert-check",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
