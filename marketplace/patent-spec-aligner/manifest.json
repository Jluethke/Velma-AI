{
  "name": "patent-spec-aligner",
  "version": "1.0.0",
  "domain": "legal",
  "description": "Aligns patent specifications, claims, and drawings by ensuring reference numerals are consistent across all three documents. Generates 'Detailed Description of the Drawings' sections with inline reference numerals matching the drawing labels. Validates claim terms appear in both spec and drawings.",
  "tags": [
    "patent",
    "specification",
    "claims",
    "drawings",
    "reference-numerals",
    "alignment",
    "USPTO",
    "consistency"
  ],
  "inputs": [
    "claims_text",
    "specification_text",
    "drawings_json",
    "patent_family"
  ],
  "outputs": [
    "detailed_description_section",
    "alignment_report",
    "updated_figure_descriptions",
    "consistency_violations"
  ],
  "execution_pattern": "linear",
  "price": 0,
  "license": "PRIVATE",
  "min_shadow_count": 3,
  "graduation_threshold": 0.75,
  "related_flows": [
    {
      "flow_name": "data-extractor",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "patent-drawing-generator",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "checklist-builder",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "patent-claims-drafter",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "patent-spec-writer",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
