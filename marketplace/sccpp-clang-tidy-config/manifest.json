{
  "name": "sccpp-clang-tidy-config",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "clang-tidy",
    "static-analysis",
    "misra",
    "lint"
  ],
  "inputs": [
    "codebase_dir",
    "build_profiles",
    "guideline_plan"
  ],
  "outputs": [
    "clang_tidy_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a .clang-tidy traced to the guideline plan, run run-clang-tidy on the compile database, and report findings by check.",
  "related_flows": [
    {
      "flow_name": "sccpp-standard-select",
      "relationship": "fed_by",
      "description": "provides guideline_plan needed here"
    },
    {
      "flow_name": "sccpp-cmake-build-profiles",
      "relationship": "fed_by",
      "description": "provides build_profiles needed here"
    },
    {
      "flow_name": "sccpp-gcc-warning-set",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-clang-warning-set",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-cppcheck-misra-c",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-findings-triage",
      "relationship": "feeds_into",
      "description": "outputs clang_tidy_findings consumed by sccpp-findings-triage"
    },
    {
      "flow_name": "sccpp-deviation-record",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
