{
  "name": "stp-apply-one-edit",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "single-edit",
    "git-diff",
    "small-model",
    "coding-loop"
  ],
  "inputs": [
    "locked_plan",
    "stop_decision",
    "start_commit",
    "scratch_log",
    "repo_path"
  ],
  "outputs": [
    "applied_edit"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Apply exactly one locked edit as an exact string replacement and prove with git diff that only one hunk in one file changed.",
  "related_flows": [
    {
      "flow_name": "stp-run-verify-capture",
      "relationship": "feeds_into",
      "description": "outputs applied_edit consumed by stp-run-verify-capture"
    },
    {
      "flow_name": "stp-keep-or-revert-edit",
      "relationship": "feeds_into",
      "description": "outputs applied_edit consumed by stp-keep-or-revert-edit"
    },
    {
      "flow_name": "stp-test-integrity-guard",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "stp-stop-or-continue",
      "relationship": "fed_by",
      "description": "provides stop_decision needed here"
    },
    {
      "flow_name": "stp-final-evidence-report",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "stp-goal-to-runnable-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "stp-scratch-log-start",
      "relationship": "fed_by",
      "description": "provides scratch_log, start_commit needed here"
    },
    {
      "flow_name": "stp-baseline-capture",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
