{
  "name": "k8s-configmap-secret-wiring",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "configmap",
    "secrets",
    "external-secrets",
    "sops"
  ],
  "inputs": [
    "workload_profile",
    "deployment_manifest",
    "secret_backend",
    "packaging_choice"
  ],
  "outputs": [
    "config_manifests",
    "wired_deployment"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Deliver environment variables through a ConfigMap and a backend-managed Secret, wire them into the Deployment, and make config changes trigger rollouts.",
  "related_flows": [
    {
      "flow_name": "k8s-workload-inventory",
      "relationship": "fed_by",
      "description": "provides workload_profile needed here"
    },
    {
      "flow_name": "k8s-helm-vs-kustomize-decision",
      "relationship": "fed_by",
      "description": "provides packaging_choice needed here"
    },
    {
      "flow_name": "k8s-deployment-manifest",
      "relationship": "fed_by",
      "description": "provides deployment_manifest needed here"
    },
    {
      "flow_name": "k8s-probe-tuning",
      "relationship": "feeds_into",
      "description": "outputs wired_deployment consumed by k8s-probe-tuning"
    },
    {
      "flow_name": "k8s-helm-chart-build",
      "relationship": "feeds_into",
      "description": "outputs config_manifests consumed by k8s-helm-chart-build"
    },
    {
      "flow_name": "k8s-kustomize-overlays",
      "relationship": "feeds_into",
      "description": "outputs config_manifests consumed by k8s-kustomize-overlays"
    }
  ]
}
