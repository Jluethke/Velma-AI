{
  "name": "prr-node-audit-semgrep",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "javascript",
    "typescript",
    "npm-audit",
    "semgrep"
  ],
  "inputs": [
    "repo_dir",
    "base_branch",
    "changed_files",
    "findings_dir"
  ],
  "outputs": [
    "node_sast_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Compare npm, pnpm or Yarn audit between merge base and PR head, review the lockfile diff for install scripts and odd sources, and run Semgrep with a baseline.",
