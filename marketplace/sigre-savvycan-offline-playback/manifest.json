{
  "name": "sigre-savvycan-offline-playback",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "savvycan",
    "dbc",
    "playback",
    "offline-analysis"
  ],
  "inputs": [
    "capture_logs",
    "dbc_draft"
  ],
  "outputs": [
    "savvycan_replay_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Play a CAN log back in SavvyCAN with no connection open and spot-check DBC-decoded values against cantools.",
  "related_flows": [
    {
      "flow_name": "sigre-log-normalize-convert",
      "relationship": "fed_by",
      "description": "provides capture_logs needed here"
    },
    {
      "flow_name": "sigre-dbc-entry-write",
      "relationship": "fed_by",
      "description": "provides dbc_draft needed here"
    },
    {
      "flow_name": "sigre-signal-confidence-report",
      "relationship": "feeds_into",
      "description": "outputs savvycan_replay_report consumed by sigre-signal-confidence-report"
    }
  ]
}
