{
  "name": "mlp-frame-problem-metric",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "problem-framing",
    "metrics",
    "scikit-learn"
  ],
  "inputs": [
    "problem_statement",
    "label_definition",
    "decision_costs"
  ],
  "outputs": [
    "problem_frame",
    "primary_metric",
    "recommended_split"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Turns a business request into a written ML problem frame (unit of prediction, prediction time, label window, action taken) and picks one primary metric and one split strategy from decision tables, so every later step optimizes and evaluates the same thing.",
  "related_flows": [
    {
      "flow_name": "mlp-dvc-version-raw-data",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-leakage-audit",
      "relationship": "feeds_into",
      "description": "outputs primary_metric, problem_frame consumed by mlp-leakage-audit"
    },
    {
      "flow_name": "mlp-split-random-stratified",
      "relationship": "feeds_into",
      "description": "outputs problem_frame consumed by mlp-split-random-stratified"
    },
    {
      "flow_name": "mlp-split-time-based",
      "relationship": "feeds_into",
      "description": "outputs problem_frame consumed by mlp-split-time-based"
    },
    {
      "flow_name": "mlp-split-grouped",
      "relationship": "feeds_into",
      "description": "outputs problem_frame consumed by mlp-split-grouped"
    },
    {
      "flow_name": "mlp-split-integrity-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-dvc-pipeline-stages",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-baseline-models",
      "relationship": "feeds_into",
      "description": "outputs primary_metric, problem_frame consumed by mlp-baseline-models"
    }
  ]
}
