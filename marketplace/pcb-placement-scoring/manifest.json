{
  "name": "pcb-placement-scoring",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "placement",
    "optimization",
    "scoring"
  ],
  "inputs": [
    "placement_candidates",
    "board_spec"
  ],
  "outputs": [
    "placed_board",
    "placement_scorecard",
    "layout_notes"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Score placement candidates on ratsnest length, switching hot-loop area, hotspot temperature rise, and board area, then select by stated priority with recorded margins.",
  "related_flows": [
    {
      "flow_name": "pcb-board-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-placement-candidates",
      "relationship": "fed_by",
      "description": "provides placement_candidates needed here"
    },
    {
      "flow_name": "pcb-critical-routing",
      "relationship": "feeds_into",
      "description": "outputs placed_board consumed by pcb-critical-routing"
    },
    {
      "flow_name": "pcb-autoroute",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-drc-closure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-layout-metrics",
      "relationship": "feeds_into",
      "description": "outputs placement_scorecard consumed by pcb-layout-metrics"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "fed_by",
      "description": "provides board_spec needed here"
    },
    {
      "flow_name": "hw-bringup-plan",
      "relationship": "feeds_into",
      "description": "outputs layout_notes consumed by hw-bringup-plan"
    }
  ]
}
