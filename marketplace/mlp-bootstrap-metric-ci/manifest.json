{
  "name": "mlp-bootstrap-metric-ci",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "bootstrap",
    "confidence-interval",
    "scipy"
  ],
  "inputs": [
    "tuned_model",
    "split_manifest",
    "primary_metric",
    "confidence_level"
  ],
  "outputs": [
    "test_predictions",
    "metric_ci"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Scores the tuned model on the held-out test split exactly once, saves the predictions, and reports the primary metric with a bootstrap confidence interval from `scipy.stats.bootstrap`, resampling clusters for grouped data and blocks for time-ordered data.",
  "related_flows": [
    {
      "flow_name": "mlp-calibration-diagnose",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "mlp-optuna-search",
      "relationship": "fed_by",
      "description": "provides tuned_model needed here"
    },
    {
      "flow_name": "mlp-paired-model-comparison",
      "relationship": "feeds_into",
      "description": "outputs test_predictions consumed by mlp-paired-model-comparison"
    },
    {
      "flow_name": "mlp-inference-parity-test",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "mlp-sklearn-seed-determinism",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-torch-seed-determinism",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-baseline-models",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-sklearn-feature-pipeline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
