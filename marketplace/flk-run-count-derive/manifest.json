{
  "name": "flk-run-count-derive",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "flaky-tests",
    "statistics",
    "sample-size"
  ],
  "inputs": [
    "flake_evidence",
    "detection_confidence",
    "target_flake_rate"
  ],
  "outputs": [
    "repeat_count",
    "run_count_derivation"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Derive the number of repeated runs needed to see a flaky failure at a stated confidence, from the binomial zero-failure formula.",
  "related_flows": [
    {
      "flow_name": "flk-flake-evidence-intake",
      "relationship": "fed_by",
      "description": "provides flake_evidence needed here"
    },
    {
      "flow_name": "flk-classify-root-cause",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "flk-verify-same-count",
      "relationship": "feeds_into",
      "description": "outputs repeat_count consumed by flk-verify-same-count"
    },
    {
      "flow_name": "flk-tz-locale-matrix-detect",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-random-seed-pin",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-network-stub-isolate",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-ci-shuffle-guard",
      "relationship": "feeds_into",
      "description": "outputs repeat_count consumed by flk-ci-shuffle-guard"
    },
    {
      "flow_name": "flk-py-repeat-measure",
      "relationship": "feeds_into",
      "description": "outputs repeat_count consumed by flk-py-repeat-measure"
    }
  ]
}
