    "pagination",
    "keyset",
    "query-rewrite"
  ],
  "inputs": [
    "tuning_scope",
    "rewritten_queries",
    "schema_ddl"
  ],
  "outputs": [
    "query_rewrites"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Replace deep OFFSET pagination with keyset pagination on a unique indexed sort key and prove no row is skipped or repeated.",
  "related_flows": [
