{
  "name": "inc-trace-tempo-traceql",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "incident-response",
    "tracing",
    "tempo",
    "traceql",
    "opentelemetry"
  ],
  "inputs": [
    "incident_record",
    "metric_findings",
    "loki_log_findings",
    "cloudwatch_log_findings",
    "tempo_url",
    "service_name"
  ],
  "outputs": [
    "trace_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Search Tempo with TraceQL for failing and slow traces, find the deepest error span and self-time leader, and compare against healthy traces before the onset.",
  "related_flows": [
    {
      "flow_name": "inc-promql-red-triage",
      "relationship": "fed_by",
      "description": "provides metric_findings needed here"
    },
    {
      "flow_name": "inc-change-correlation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-loki-logql-slice",
      "relationship": "fed_by",
      "description": "provides loki_log_findings needed here"
    },
    {
      "flow_name": "inc-cloudwatch-insights-slice",
      "relationship": "fed_by",
      "description": "provides cloudwatch_log_findings needed here"
    },
    {
      "flow_name": "inc-hypothesis-draft",
      "relationship": "feeds_into",
      "description": "outputs trace_findings consumed by inc-hypothesis-draft"
    },
    {
      "flow_name": "inc-k8s-safe-debug-access",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-py-spy-dump",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-node-diagnostic-report",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
