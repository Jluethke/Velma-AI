{
  "name": "a11y-focus-order-visibility-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "focus",
    "css",
    "wcag-2.2",
    "manual-testing"
  ],
  "inputs": [
    "page_inventory",
    "keyboard_issues",
    "repo_dir"
  ],
  "outputs": [
    "focus_issues"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Checks SC 2.4.3 Focus Order, 2.4.7 Focus Visible and 2.4.11 Focus Not Obscured (Minimum) on every page state, finds the CSS and markup causes (`outline: none`, positive `tabindex`, sticky headers, CSS reordering, focus lost after DOM changes), and measures focus indicator contrast against SC 1.4.11.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "fed_by",
      "description": "provides page_inventory needed here"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "feeds_into",
      "description": "outputs focus_issues consumed by a11y-impact-ranking"
    },
    {
      "flow_name": "a11y-keyboard-operability-pass",
      "relationship": "fed_by",
      "description": "provides keyboard_issues needed here"
    },
    {
      "flow_name": "a11y-nvda-screen-reader-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-voiceover-macos-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-voiceover-ios-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-forms-error-messaging-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-target-size-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
