{
  "name": "ctrl-spec-intake",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "vehicle",
    "control",
    "requirements",
    "safety"
  ],
  "inputs": [
    "vehicle_params",
    "motion_limits",
    "test_site",
    "estop_description",
    "stack"
  ],
  "outputs": [
    "control_spec",
    "open_questions"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Collect vehicle parameters, user-supplied motion limits, site and hardware emergency-stop facts into one unit-checked control spec with open questions for missing values.",
  "related_flows": [
    {
      "flow_name": "ctrl-tracking-metrics",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "ctrl-bicycle-model-py",
      "relationship": "feeds_into",
      "description": "outputs control_spec consumed by ctrl-bicycle-model-py"
    },
    {
      "flow_name": "ctrl-actuator-rate-saturation",
      "relationship": "feeds_into",
      "description": "outputs control_spec consumed by ctrl-actuator-rate-saturation"
    },
    {
      "flow_name": "ctrl-path-spline-smoothing",
      "relationship": "feeds_into",
      "description": "outputs control_spec consumed by ctrl-path-spline-smoothing"
    },
    {
      "flow_name": "ctrl-speed-profile-jerk-limited",
      "relationship": "feeds_into",
      "description": "outputs control_spec consumed by ctrl-speed-profile-jerk-limited"
    },
    {
      "flow_name": "ctrl-closed-loop-sim-py",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "ctrl-can-readonly-log",
      "relationship": "feeds_into",
      "description": "outputs control_spec consumed by ctrl-can-readonly-log"
    },
    {
      "flow_name": "ctrl-model-fit-from-logs",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
