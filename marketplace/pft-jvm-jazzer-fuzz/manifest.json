{
  "name": "pft-jvm-jazzer-fuzz",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "java",
    "kotlin",
    "jazzer",
    "junit5",
    "fuzzing"
  ],
  "inputs": [
    "fuzz_targets",
    "seed_corpus",
    "fuzz_dictionary",
    "repo_path",
    "fuzz_time"
  ],
  "outputs": [
    "jvm_fuzz_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a Jazzer @FuzzTest for a JVM target, run it in fuzzing mode with JAZZER_FUZZ=1 and collect findings with their DEDUP_TOKEN.",
  "related_flows": [
    {
      "flow_name": "pft-fuzz-target-selection",
      "relationship": "fed_by",
      "description": "provides fuzz_targets needed here"
    },
    {
      "flow_name": "pft-corpus-seeding",
      "relationship": "fed_by",
      "description": "provides fuzz_dictionary, seed_corpus needed here"
    },
    {
      "flow_name": "pft-coverage-plateau-analysis",
      "relationship": "feeds_into",
      "description": "outputs jvm_fuzz_findings consumed by pft-coverage-plateau-analysis"
    },
    {
      "flow_name": "pft-crash-triage-dedup",
      "relationship": "feeds_into",
      "description": "outputs jvm_fuzz_findings consumed by pft-crash-triage-dedup"
    }
  ]
}
