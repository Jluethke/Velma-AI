{
  "name": "rel-go-publish-module-proxy",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "go",
    "module-proxy",
    "sumdb",
    "github-release"
  ],
  "inputs": [
    "repo_path",
    "release_tag",
    "go_dist",
    "provenance_verification"
  ],
  "outputs": [
    "go_module_version_check"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Publish a Go module version by pushing its tag, force the module proxy and checksum database to record it, and attach binaries to a GitHub release.",
  "related_flows": [
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "fed_by",
      "description": "provides release_tag needed here"
    },
    {
      "flow_name": "rel-go-reproducible-build",
      "relationship": "fed_by",
      "description": "provides go_dist needed here"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "fed_by",
      "description": "provides provenance_verification needed here"
    },
    {
      "flow_name": "rel-go-verify-install",
      "relationship": "feeds_into",
      "description": "outputs go_module_version_check consumed by rel-go-verify-install"
    }
  ]
}
