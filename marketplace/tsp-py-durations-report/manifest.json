{
  "name": "tsp-py-durations-report",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "testing",
    "python",
    "pytest",
    "durations",
    "profiling"
  ],
  "inputs": [
    "repo_path",
    "test_command",
    "baseline_report"
  ],
  "outputs": [
    "py_duration_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Produce a ranked per-test pytest timing table split into setup, call and teardown from --durations=0 and JUnit XML, with a cause signal per row.",
  "related_flows": [
    {
      "flow_name": "tsp-baseline-lock",
      "relationship": "fed_by",
      "description": "provides baseline_report needed here"
    },
    {
      "flow_name": "tsp-py-setup-import-cost",
      "relationship": "feeds_into",
      "description": "outputs py_duration_report consumed by tsp-py-setup-import-cost"
    },
    {
      "flow_name": "tsp-hotspot-classify",
      "relationship": "feeds_into",
      "description": "outputs py_duration_report consumed by tsp-hotspot-classify"
    },
    {
      "flow_name": "tsp-py-db-transaction-rollback",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsp-pg-template-clone",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsp-coverage-parity-gate",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsp-speedup-report",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsp-node-durations-report",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
