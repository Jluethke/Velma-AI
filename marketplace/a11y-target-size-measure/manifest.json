{
  "name": "a11y-target-size-measure",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "target-size",
    "wcag-2.2",
    "playwright",
    "mobile"
  ],
  "inputs": [
    "page_inventory",
    "site_url",
    "viewports"
  ],
  "outputs": [
    "target_size_issues"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measures every pointer target on every page at mobile and desktop viewports against WCAG 2.2 SC 2.5.8 Target Size (Minimum), 24 by 24 CSS pixels, with a Playwright script that applies the spacing exception's 24 px circle test exactly, then classifies remaining candidates against the inline, equivalent, user agent control and essential exceptions.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "fed_by",
      "description": "provides page_inventory needed here"
    },
    {
      "flow_name": "a11y-focus-order-visibility-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-forms-error-messaging-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-pointer-help-wcag22-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "feeds_into",
      "description": "outputs target_size_issues consumed by a11y-impact-ranking"
    }
  ]
}
