{
  "name": "a11y-pa11y-ci-scan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "pa11y",
    "html-codesniffer",
    "automated-testing",
    "wcag"
  ],
  "inputs": [
    "page_inventory",
    "site_url"
  ],
  "outputs": [
    "pa11y_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Runs pa11y-ci over the page inventory with both the HTML_CodeSniffer and axe runners, scripting non-default states with Pa11y `actions`, so a second rule engine catches failures axe-core alone misses.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "fed_by",
      "description": "provides page_inventory needed here"
    },
    {
      "flow_name": "a11y-axe-playwright-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-lighthouse-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-scan-merge-dedupe",
      "relationship": "feeds_into",
      "description": "outputs pa11y_findings consumed by a11y-scan-merge-dedupe"
    },
    {
      "flow_name": "a11y-color-contrast-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
