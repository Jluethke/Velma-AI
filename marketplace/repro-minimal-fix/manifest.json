{
  "name": "repro-minimal-fix",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "bug-fix",
    "minimal-change",
    "testing"
  ],
  "inputs": [
    "root_cause",
    "regression_test",
    "repo_path",
    "stack"
  ],
  "outputs": [
    "fix_diff",
    "green_run_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Make the smallest source change at the defect link that turns the regression test green without touching tests or swallowing errors.",
  "related_flows": [
    {
      "flow_name": "repro-fix-revert-proof",
      "relationship": "feeds_into",
      "description": "outputs fix_diff consumed by repro-fix-revert-proof"
    },
    {
      "flow_name": "repro-neighbor-regression-sweep",
      "relationship": "feeds_into",
      "description": "outputs fix_diff consumed by repro-neighbor-regression-sweep"
    },
    {
      "flow_name": "repro-red-test-gate",
      "relationship": "fed_by",
      "description": "provides regression_test needed here"
    },
    {
      "flow_name": "repro-log-assert-instrumentation",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-root-cause-confirm",
      "relationship": "fed_by",
      "description": "provides root_cause needed here"
    },
    {
      "flow_name": "repro-root-cause-note",
      "relationship": "feeds_into",
      "description": "outputs fix_diff consumed by repro-root-cause-note"
    },
    {
      "flow_name": "repro-intake-checklist",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "repro-env-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
