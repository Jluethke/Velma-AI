{
  "name": "inc-timeline-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "incident-response",
    "timeline",
    "scribe",
    "postmortem",
    "sre"
  ],
  "inputs": [
    "incident_record",
    "role_assignments"
  ],
  "outputs": [
    "timeline_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Capture the incident timeline live in UTC and backfill it from deploy, event and audit history so detect, mitigate and resolve times can be measured.",
  "related_flows": [
    {
      "flow_name": "inc-declare-severity",
      "relationship": "fed_by",
      "description": "provides incident_record needed here"
    },
    {
      "flow_name": "inc-assign-incident-roles",
      "relationship": "fed_by",
      "description": "provides role_assignments needed here"
    },
    {
      "flow_name": "inc-status-page-update",
      "relationship": "feeds_into",
      "description": "outputs timeline_log consumed by inc-status-page-update"
    },
    {
      "flow_name": "inc-promql-red-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-change-correlation",
      "relationship": "feeds_into",
      "description": "outputs timeline_log consumed by inc-change-correlation"
    },
    {
      "flow_name": "inc-stabilize-decision-table",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-k8s-rollout-undo",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-feature-flag-off",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
