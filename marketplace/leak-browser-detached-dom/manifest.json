{
  "name": "leak-browser-detached-dom",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "memory-leak",
    "browser",
    "detached-dom",
    "chrome-devtools",
    "puppeteer"
  ],
  "inputs": [
    "leak_brief",
    "load_recipe",
    "cause_hypotheses"
  ],
  "outputs": [
    "detached_dom_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure DOM node and listener counts per repeated UI action, find detached DOM trees in Chrome heap snapshots, and trace each to the JavaScript holder in source.",
  "related_flows": [
    {
      "flow_name": "leak-intake-load-recipe",
      "relationship": "fed_by",
      "description": "provides leak_brief, load_recipe needed here"
    },
    {
      "flow_name": "leak-rss-growth-confirm",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-managed-vs-native-split",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-classic-causes-triage",
      "relationship": "fed_by",
      "description": "provides cause_hypotheses needed here"
    },
    {
      "flow_name": "leak-node-heap-snapshot-compare",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-node-emitter-listener-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-root-cause-confirm",
      "relationship": "feeds_into",
      "description": "outputs detached_dom_report consumed by leak-root-cause-confirm"
    },
    {
      "flow_name": "leak-fix-minimal-change",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
