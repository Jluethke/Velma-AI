{
  "name": "vsens-v4l2-camera-probe",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "camera",
    "v4l2",
    "v4l2-ctl",
    "uvc",
    "linux"
  ],
  "inputs": [
    "sensor_inventory",
    "camera_device",
    "csi_link_report"
  ],
  "outputs": [
    "camera_device_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Survey a V4L2 camera node's capabilities, formats, intervals and controls with v4l2-ctl and measure its real streaming rate per needed mode.",
  "related_flows": [
    {
      "flow_name": "vsens-sensor-inventory",
      "relationship": "fed_by",
      "description": "provides sensor_inventory needed here"
    },
    {
      "flow_name": "vsens-gmsl-csi-bringup",
      "relationship": "fed_by",
      "description": "provides csi_link_report needed here"
    },
    {
      "flow_name": "vsens-v4l2-exposure-framerate",
      "relationship": "feeds_into",
      "description": "outputs camera_device_report consumed by vsens-v4l2-exposure-framerate"
    },
    {
      "flow_name": "vsens-gstreamer-capture-pipeline",
      "relationship": "feeds_into",
      "description": "outputs camera_device_report consumed by vsens-gstreamer-capture-pipeline"
    },
    {
      "flow_name": "vsens-cpp-v4l2-mmap-capture",
      "relationship": "feeds_into",
      "description": "outputs camera_device_report consumed by vsens-cpp-v4l2-mmap-capture"
    },
    {
      "flow_name": "vsens-py-opencv-intrinsics",
      "relationship": "feeds_into",
      "description": "outputs camera_device_report consumed by vsens-py-opencv-intrinsics"
    },
    {
      "flow_name": "vsens-cpp-opencv-intrinsics",
      "relationship": "feeds_into",
      "description": "outputs camera_device_report consumed by vsens-cpp-opencv-intrinsics"
    },
    {
      "flow_name": "vsens-ros2-camera-calibrator",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
