{
  "name": "e2e-cypress-commands-pom",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "e2e",
    "cypress",
    "custom-commands",
    "app-actions",
    "page-objects"
  ],
  "inputs": [
    "repo_dir",
    "cypress_config",
    "selector_policy",
    "critical_journeys"
  ],
  "outputs": [
    "cypress_command_layer"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Decide per interaction between typed custom commands, API app actions and selector modules in Cypress, and convert specs one at a time.",
  "related_flows": [
    {
      "flow_name": "e2e-journey-select",
      "relationship": "fed_by",
      "description": "provides critical_journeys needed here"
    },
    {
      "flow_name": "e2e-runner-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-cypress-setup",
      "relationship": "fed_by",
      "description": "provides cypress_config needed here"
    },
    {
      "flow_name": "e2e-selector-policy",
      "relationship": "fed_by",
      "description": "provides selector_policy needed here"
    },
    {
      "flow_name": "e2e-cypress-data-seed",
      "relationship": "feeds_into",
      "description": "outputs cypress_command_layer consumed by e2e-cypress-data-seed"
    },
    {
      "flow_name": "e2e-cypress-auth-session",
      "relationship": "feeds_into",
      "description": "outputs cypress_command_layer consumed by e2e-cypress-auth-session"
    },
    {
      "flow_name": "e2e-mock-vs-real-decide",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-cypress-intercept",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
