{
  "name": "res-breaker-policy",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "resilience",
    "circuit-breaker",
    "policy",
    "thresholds",
    "failure-rate"
  ],
  "inputs": [
    "dependency_map",
    "latency_profile",
    "retry_policy"
  ],
  "outputs": [
    "breaker_policy"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Specify each dependency's circuit breaker from named library defaults or user inputs and check it against the measured baseline error rate.",
  "related_flows": [
    {
      "flow_name": "res-dependency-map",
      "relationship": "fed_by",
      "description": "provides dependency_map needed here"
    },
    {
      "flow_name": "res-latency-percentiles",
      "relationship": "fed_by",
      "description": "provides latency_profile needed here"
    },
    {
      "flow_name": "res-timeout-budget",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "res-retry-policy",
      "relationship": "fed_by",
      "description": "provides retry_policy needed here"
    },
    {
      "flow_name": "res-bulkhead-partition",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "res-toxiproxy-faults",
      "relationship": "feeds_into",
      "description": "outputs breaker_policy consumed by res-toxiproxy-faults"
    },
    {
      "flow_name": "res-resilience-verify",
      "relationship": "feeds_into",
      "description": "outputs breaker_policy consumed by res-resilience-verify"
    },
    {
      "flow_name": "res-py-timeouts",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
