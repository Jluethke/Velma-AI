{
  "name": "flk-network-stub-isolate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "flaky-tests",
    "network",
    "pytest-socket",
    "nock",
    "httptest"
  ],
  "inputs": [
    "root_cause_evidence",
    "flake_class",
    "baseline_command",
    "repo_path",
    "stack"
  ],
  "outputs": [
    "network_fix_diff"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Block real network access in tests and replace it with local stubs using pytest-socket and responses or respx, nock or msw, and httptest.",
  "related_flows": [
    {
      "flow_name": "flk-flake-evidence-intake",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-run-count-derive",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-tz-locale-matrix-detect",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-classify-root-cause",
      "relationship": "fed_by",
      "description": "provides baseline_command, flake_class, root_cause_evidence needed here"
    },
    {
      "flow_name": "flk-random-seed-pin",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-verify-same-count",
      "relationship": "feeds_into",
      "description": "outputs network_fix_diff consumed by flk-verify-same-count"
    },
    {
      "flow_name": "flk-ci-shuffle-guard",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-py-repeat-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
