{
  "name": "prr-go-static-checks",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "go",
    "go-vet",
    "staticcheck",
    "golangci-lint"
  ],
  "inputs": [
    "repo_dir",
    "base_branch",
    "changed_files",
    "findings_dir"
  ],
  "outputs": [
    "go_static_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build the PR and run gofmt, go vet, staticcheck or golangci-lint with new-from-rev and a go mod tidy check, auditing nolint directives and ignored errors.",
  "related_flows": [
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides changed_files needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-correctness-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-test-revert-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-go-gosec-govulncheck",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-concurrency-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
