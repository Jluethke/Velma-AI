{
  "name": "repro-neighbor-regression-sweep",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "testing",
    "regression",
    "test-selection",
    "verification"
  ],
  "inputs": [
    "fix_diff",
    "regression_test",
    "repo_path",
    "stack",
    "base_ref"
  ],
  "outputs": [
    "neighbor_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run tests related to the change and the full suite on fix and base, and report new failures by test ID.",
  "related_flows": [
    {
      "flow_name": "repro-minimal-fix",
      "relationship": "fed_by",
      "description": "provides fix_diff needed here"
    },
    {
      "flow_name": "repro-fix-revert-proof",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "repro-red-test-gate",
      "relationship": "fed_by",
      "description": "provides regression_test needed here"
    },
    {
      "flow_name": "repro-log-assert-instrumentation",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-root-cause-confirm",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-root-cause-note",
      "relationship": "feeds_into",
      "description": "outputs neighbor_report consumed by repro-root-cause-note"
    },
    {
      "flow_name": "repro-intake-checklist",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "repro-env-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
