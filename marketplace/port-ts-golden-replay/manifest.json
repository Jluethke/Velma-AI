{
  "name": "port-ts-golden-replay",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "porting",
    "typescript",
    "vitest",
    "golden-tests",
    "replay"
  ],
  "inputs": [
    "target_repo",
    "golden_corpus",
    "corpus_schema"
  ],
  "outputs": [
    "ts_replay_command"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a Vitest replay harness that runs every golden record as a named test in the TypeScript target.",
  "related_flows": [
    {
      "flow_name": "port-golden-corpus-schema",
      "relationship": "fed_by",
      "description": "provides corpus_schema needed here"
    },
    {
      "flow_name": "port-golden-corpus-freeze",
      "relationship": "fed_by",
      "description": "provides golden_corpus needed here"
    },
    {
      "flow_name": "port-porting-rulebook",
      "relationship": "feeds_into",
      "description": "outputs ts_replay_command consumed by port-porting-rulebook"
    }
  ]
}
