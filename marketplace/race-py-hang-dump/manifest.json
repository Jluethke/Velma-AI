{
  "name": "race-py-hang-dump",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "python",
    "py-spy",
    "faulthandler",
    "deadlock",
    "hang"
  ],
  "inputs": [
    "repo_path",
    "stress_command",
    "failure_class"
  ],
  "outputs": [
    "py_hang_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Captures every thread's stack (and asyncio tasks) from a hung Python process using `py-spy dump`, `faulthandler` and `asyncio` task introspection, then identifies the lock, queue, join or awaited future each thread is stuck on.",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "fed_by",
      "description": "provides failure_class needed here"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "fed_by",
      "description": "provides stress_command needed here"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs py_hang_report consumed by race-findings-consolidate"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "race-deterministic-regression-test",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "race-apply-fix",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "race-stress-verify",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
