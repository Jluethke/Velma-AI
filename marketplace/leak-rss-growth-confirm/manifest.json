{
  "name": "leak-rss-growth-confirm",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "memory-leak",
    "rss",
    "heap",
    "sampling",
    "regression-fit"
  ],
  "inputs": [
    "leak_brief",
    "load_recipe",
    "sample_interval_s"
  ],
  "outputs": [
    "growth_series",
    "growth_verdict",
    "bytes_per_op"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Sample RSS and the runtime heap metric under a fixed load, fit the post-GC floor against completed operations, and return a growth verdict with bytes per operation.",
  "related_flows": [
    {
      "flow_name": "leak-intake-load-recipe",
      "relationship": "fed_by",
      "description": "provides leak_brief, load_recipe needed here"
    },
    {
      "flow_name": "leak-managed-vs-native-split",
      "relationship": "feeds_into",
      "description": "outputs growth_verdict, growth_series consumed by leak-managed-vs-native-split"
    },
    {
      "flow_name": "leak-classic-causes-triage",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "leak-root-cause-confirm",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "leak-fix-minimal-change",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "leak-regression-guard-test",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "leak-soak-flat-proof",
      "relationship": "feeds_into",
      "description": "outputs bytes_per_op consumed by leak-soak-flat-proof"
    },
    {
      "flow_name": "leak-native-malloc-fragmentation",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
