{
  "name": "email-tone-analyzer",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "email",
    "tone",
    "analyzer"
  ],
  "inputs": [
    "emotional_trajectory",
    "responder_relationship_to_sender",
    "responder_role",
    "structured_thread",
    "tone_override",
    "unresolved_points"
  ],
  "outputs": [
    "communication_style",
    "formality_level",
    "inferred_resolution_goal",
    "responder_relationship_clarity",
    "tone_analysis",
    "tone_override_applied",
    "urgency"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process emotional_trajectory, responder_relationship_to_sender, responder_role to produce communication_style, formality_level, inferred_resolution_goal.",
  "related_flows": [
    {
      "flow_name": "email-thread-parser",
      "relationship": "fed_by",
      "description": "provides structured_thread needed here"
    },
    {
      "flow_name": "email-point-extractor",
      "relationship": "fed_by",
      "description": "provides unresolved_points, emotional_trajectory needed here"
    },
    {
      "flow_name": "response-mapper",
      "relationship": "feeds_into",
      "description": "outputs inferred_resolution_goal consumed by response-mapper"
    },
    {
      "flow_name": "email-response-drafter",
      "relationship": "feeds_into",
      "description": "outputs communication_style, formality_level, responder_relationship_clarity consumed by email-response-drafter"
    },
    {
      "flow_name": "response-validator",
      "relationship": "feeds_into",
      "description": "outputs inferred_resolution_goal consumed by response-validator"
    },
    {
      "flow_name": "email-response-finalizer",
      "relationship": "feeds_into",
      "description": "outputs tone_analysis consumed by email-response-finalizer"
    }
  ]
}
