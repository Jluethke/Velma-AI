{
  "name": "loc-can-wheel-odometry",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "localization",
    "can",
    "cantools",
    "wheel-odometry",
    "bicycle-model"
  ],
  "inputs": [
    "dbc_file",
    "sensor_bag",
    "vehicle_spec"
  ],
  "outputs": [
    "wheel_odom_signals",
    "wheel_odom_model"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Decode wheel speed and steering from read-only CAN logs and build planar odometry with bicycle and differential models cross-checked against the gyro.",
  "related_flows": [
    {
      "flow_name": "loc-frame-convention-audit",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "loc-rosbag2-drive-logging",
      "relationship": "fed_by",
      "description": "provides sensor_bag needed here"
    },
    {
      "flow_name": "loc-wheel-odom-calibration",
      "relationship": "feeds_into",
      "description": "outputs wheel_odom_model consumed by loc-wheel-odom-calibration"
    },
    {
      "flow_name": "loc-sensor-time-sync-check",
      "relationship": "feeds_into",
      "description": "outputs wheel_odom_signals consumed by loc-sensor-time-sync-check"
    },
    {
      "flow_name": "loc-py-geodetic-conversions",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "loc-imu-allan-variance",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "loc-gnss-fix-quality-model",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "loc-ekf-model-design",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
