{
  "name": "fw-project-scaffold",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "firmware",
    "embedded",
    "scaffold",
    "zephyr",
    "esp-idf"
  ],
  "inputs": [
    "pin_map",
    "board_spec",
    "critical_circuits",
    "project_dir",
    "firmware_framework"
  ],
  "outputs": [
    "firmware_source"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Create a firmware project with one generated board definition from the pin map, logic separated from hardware access, one driver per interface, a watchdog, and no path overriding a hardware interlock.",
  "related_flows": [
    {
      "flow_name": "fw-pin-map",
      "relationship": "fed_by",
      "description": "provides pin_map needed here"
    },
    {
      "flow_name": "fw-drivers-logic",
      "relationship": "feeds_into",
      "description": "outputs firmware_source consumed by fw-drivers-logic"
    },
    {
      "flow_name": "fw-target-build",
      "relationship": "feeds_into",
      "description": "outputs firmware_source consumed by fw-target-build"
    },
    {
      "flow_name": "hw-critical-circuit-flagging",
      "relationship": "fed_by",
      "description": "provides critical_circuits needed here"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "fed_by",
      "description": "provides board_spec needed here"
    }
  ]
}
