{
  "name": "alog-record-schema-design",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "audit-log",
    "schema",
    "append-only",
    "record",
    "hash-chain"
  ],
  "inputs": [
    "log_requirements",
    "hash_algorithm_spec",
    "event_fields"
  ],
  "outputs": [
    "record_schema"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Design the append-only log record so the signed and hashed payload is separated from the integrity fields, with sequence number, timestamp, prev_hash, and content_hash placed without circular hashing.",
  "related_flows": [
    {
      "flow_name": "alog-canonical-serialization-jcs",
      "relationship": "feeds_into",
      "description": "outputs record_schema consumed by alog-canonical-serialization-jcs"
    },
    {
      "flow_name": "alog-hash-chain-link-design",
      "relationship": "feeds_into",
      "description": "outputs record_schema consumed by alog-hash-chain-link-design"
    },
    {
      "flow_name": "alog-verifier-tool-spec",
      "relationship": "feeds_into",
      "description": "outputs record_schema consumed by alog-verifier-tool-spec"
    },
    {
      "flow_name": "alog-threat-model-requirements",
      "relationship": "fed_by",
      "description": "provides log_requirements needed here"
    },
    {
      "flow_name": "alog-hash-algorithm-select",
      "relationship": "fed_by",
      "description": "provides hash_algorithm_spec needed here"
    },
    {
      "flow_name": "alog-py-canonical-hash",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "alog-go-canonical-hash",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "alog-py-crash-safe-append",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
