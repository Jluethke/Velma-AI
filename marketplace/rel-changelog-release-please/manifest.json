{
  "name": "rel-changelog-release-please",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "changelog",
    "release-please",
    "github-actions",
    "conventional-commits"
  ],
  "inputs": [
    "repo_path",
    "branching_model",
    "next_version",
    "release_type"
  ],
  "outputs": [
    "release_please_config",
    "rp_changelog"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Configure release-please in manifest mode with the v4 GitHub Action so merged Conventional Commits produce a release PR, CHANGELOG.md entry, tag and GitHub release.",
  "related_flows": [
    {
      "flow_name": "rel-branching-model-select",
      "relationship": "fed_by",
      "description": "provides branching_model needed here"
    },
    {
      "flow_name": "rel-semver-bump-decision",
      "relationship": "fed_by",
      "description": "provides next_version needed here"
    },
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "feeds_into",
      "description": "outputs rp_changelog consumed by rel-tag-sign-git"
    }
  ]
}
