{
  "name": "flk-go-count-measure",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "flaky-tests",
    "go",
    "go-test"
  ],
  "inputs": [
    "flake_evidence",
    "repeat_count",
    "repo_path"
  ],
  "outputs": [
    "go_flake_rate_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure a Go test's flake rate with go test -count and -json, counting fail events per test at the derived run count.",
  "related_flows": [
    {
      "flow_name": "flk-flake-evidence-intake",
      "relationship": "fed_by",
      "description": "provides flake_evidence needed here"
    },
    {
      "flow_name": "flk-run-count-derive",
      "relationship": "fed_by",
      "description": "provides repeat_count needed here"
    },
    {
      "flow_name": "flk-classify-root-cause",
      "relationship": "feeds_into",
      "description": "outputs go_flake_rate_report consumed by flk-classify-root-cause"
    },
    {
      "flow_name": "flk-verify-same-count",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "flk-py-repeat-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-node-jest-loop-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-go-shuffle-order-detect",
      "relationship": "feeds_into",
      "description": "outputs go_flake_rate_report consumed by flk-go-shuffle-order-detect"
    },
    {
      "flow_name": "flk-go-race-detect",
      "relationship": "feeds_into",
      "description": "outputs go_flake_rate_report consumed by flk-go-race-detect"
    }
  ]
}
