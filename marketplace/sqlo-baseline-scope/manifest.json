    "acceptance_criteria"
  ],
  "outputs": [
    "tuning_scope"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Record the database engine, server version, settings, table sizes, environment class and acceptance criteria before SQL tuning starts.",
  "related_flows": [
