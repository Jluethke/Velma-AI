    },
    {
      "flow_name": "sqlo-btree-composite-order",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "sqlo-index-write-cost",
      "relationship": "feeds_into",
      "description": "outputs tuning_scope consumed by sqlo-index-write-cost"
    },
    {
      "flow_name": "sqlo-prod-like-verify",
      "relationship": "feeds_into",
      "description": "outputs tuning_scope consumed by sqlo-prod-like-verify"
    },
    {
      "flow_name": "sqlo-mysql-slow-log-capture",
      "relationship": "feeds_into",
      "description": "outputs tuning_scope consumed by sqlo-mysql-slow-log-capture"
    },
    {
      "flow_name": "sqlo-mysql-perf-schema-digest",
      "relationship": "feeds_into",
      "description": "outputs tuning_scope consumed by sqlo-mysql-perf-schema-digest"
    },
    {
      "flow_name": "sqlo-pg-stat-statements-capture",
      "relationship": "feeds_into",
      "description": "outputs tuning_scope consumed by sqlo-pg-stat-statements-capture"
    }
  ]
}
