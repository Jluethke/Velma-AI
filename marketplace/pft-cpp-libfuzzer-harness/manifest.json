{
  "name": "pft-cpp-libfuzzer-harness",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "c",
    "cpp",
    "libfuzzer",
    "clang",
    "fuzzing"
  ],
  "inputs": [
    "fuzz_targets",
    "seed_corpus",
    "fuzz_dictionary",
    "sanitizer_build_config",
    "repo_path",
    "fuzz_time"
  ],
  "outputs": [
    "cpp_fuzz_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write an LLVMFuzzerTestOneInput harness with FuzzedDataProvider, build it with clang -fsanitize=fuzzer plus sanitizers, run it and read the libFuzzer status lines.",
  "related_flows": [
    {
      "flow_name": "pft-invariant-discovery",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pft-fuzz-target-selection",
      "relationship": "fed_by",
      "description": "provides fuzz_targets needed here"
    },
    {
      "flow_name": "pft-sanitizer-builds",
      "relationship": "fed_by",
      "description": "provides sanitizer_build_config needed here"
    },
    {
      "flow_name": "pft-corpus-seeding",
      "relationship": "fed_by",
      "description": "provides fuzz_dictionary, seed_corpus needed here"
    },
    {
      "flow_name": "pft-rust-cargo-fuzz",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pft-coverage-plateau-analysis",
      "relationship": "feeds_into",
      "description": "outputs cpp_fuzz_findings consumed by pft-coverage-plateau-analysis"
    },
    {
      "flow_name": "pft-crash-triage-dedup",
      "relationship": "feeds_into",
      "description": "outputs cpp_fuzz_findings consumed by pft-crash-triage-dedup"
    },
    {
      "flow_name": "pft-crash-regression-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
