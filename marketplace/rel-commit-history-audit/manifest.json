{
  "name": "rel-commit-history-audit",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "conventional-commits",
    "git-log",
    "audit"
  ],
  "inputs": [
    "repo_path",
    "last_tag"
  ],
  "outputs": [
    "commit_list",
    "noncompliant_commits"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Parse every commit since the last release tag against the Conventional Commits 1.0.0 grammar and classify each by type, scope and breaking marker.",
  "related_flows": [
    {
      "flow_name": "rel-semver-bump-decision",
      "relationship": "feeds_into",
      "description": "outputs noncompliant_commits, commit_list consumed by rel-semver-bump-decision"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "rel-commitlint-gate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-py-api-break-griffe",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-node-api-break-extractor",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-changelog-semantic-release",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-changelog-git-cliff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
