{
  "name": "rag-embedding-model-select",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rag",
    "embeddings",
    "sentence-transformers",
    "evaluation",
    "model-selection"
  ],
  "inputs": [
    "chunk_sets",
    "eval_harness",
    "candidate_models",
    "work_dir"
  ],
  "outputs": [
    "embedding_choice",
    "embedding_eval_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Select the embedding model by exact-search retrieval on your labeled questions with correct prefixes and normalization, breaking ties by significance and cost.",
  "related_flows": [
    {
      "flow_name": "rag-retrieval-eval-harness",
      "relationship": "fed_by",
      "description": "provides eval_harness needed here"
    },
    {
      "flow_name": "rag-chunk-candidates-build",
      "relationship": "fed_by",
      "description": "provides chunk_sets needed here"
    },
    {
      "flow_name": "rag-chunk-size-select",
      "relationship": "feeds_into",
      "description": "outputs embedding_choice consumed by rag-chunk-size-select"
    },
    {
      "flow_name": "rag-cross-encoder-rerank",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-failure-analysis-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-embedding-cache-content-hash",
      "relationship": "feeds_into",
      "description": "outputs embedding_choice consumed by rag-embedding-cache-content-hash"
    },
    {
      "flow_name": "rag-pgvector-hnsw-index",
      "relationship": "feeds_into",
      "description": "outputs embedding_choice consumed by rag-pgvector-hnsw-index"
    },
    {
      "flow_name": "rag-faiss-index-build",
      "relationship": "feeds_into",
      "description": "outputs embedding_choice consumed by rag-faiss-index-build"
    }
  ]
}
