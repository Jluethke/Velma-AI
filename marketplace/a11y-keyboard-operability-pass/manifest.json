{
  "name": "a11y-keyboard-operability-pass",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "keyboard",
    "manual-testing",
    "aria-governance engine",
    "wcag"
  ],
  "inputs": [
    "page_inventory",
    "component_inventory"
  ],
  "outputs": [
    "keyboard_issues"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Walks every inventory page and every interactive component with the keyboard only, checking each control against its WAI-ARIA Authoring Practices key map, and records failures of SC 2.1.1 Keyboard, 2.1.2 No Keyboard Trap, 2.1.4 Character Key Shortcuts, 2.4.1 Bypass Blocks, 3.2.1 On Focus and 3.2.2 On Input.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "fed_by",
      "description": "provides page_inventory, component_inventory needed here"
    },
    {
      "flow_name": "a11y-focus-order-visibility-check",
      "relationship": "feeds_into",
      "description": "outputs keyboard_issues consumed by a11y-focus-order-visibility-check"
    },
    {
      "flow_name": "a11y-nvda-screen-reader-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-voiceover-macos-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-voiceover-ios-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "feeds_into",
      "description": "outputs keyboard_issues consumed by a11y-impact-ranking"
    }
  ]
}
