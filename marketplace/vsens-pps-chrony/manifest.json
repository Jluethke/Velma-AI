{
  "name": "vsens-pps-chrony",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pps",
    "chrony",
    "gnss",
    "time-sync",
    "ppstest"
  ],
  "inputs": [
    "gnss_stream_report",
    "pps_device",
    "ptp_sync_report"
  ],
  "outputs": [
    "clock_discipline_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Discipline the host clock from GNSS PPS with chrony refclocks, verify pulses with ppstest, and prove PPS is the selected source with chronyc.",
  "related_flows": [
    {
      "flow_name": "vsens-sensor-inventory",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "vsens-gnss-nmea-gpsd",
      "relationship": "fed_by",
      "description": "provides gnss_stream_report needed here"
    },
    {
      "flow_name": "vsens-gnss-ubx-config",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-gnss-ntrip-rtk",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-ptp-linuxptp",
      "relationship": "fed_by",
      "description": "provides ptp_sync_report needed here"
    },
    {
      "flow_name": "vsens-ros2-stamp-latency",
      "relationship": "feeds_into",
      "description": "outputs clock_discipline_report consumed by vsens-ros2-stamp-latency"
    },
    {
      "flow_name": "vsens-camera-led-latency",
      "relationship": "feeds_into",
      "description": "outputs clock_discipline_report consumed by vsens-camera-led-latency"
    },
    {
      "flow_name": "vsens-integration-acceptance",
      "relationship": "feeds_into",
      "description": "outputs clock_discipline_report consumed by vsens-integration-acceptance"
    }
  ]
}
