{
  "name": "edge-unified-memory-budget",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "jetson",
    "unified-memory",
    "memory",
    "oom",
    "tensorrt"
  ],
  "inputs": [
    "device_host",
    "platform_report",
    "container_run_spec"
  ],
  "outputs": [
    "memory_budget"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure real shared CPU and GPU memory use on Jetson and set TensorRT workspace and container limits from measured numbers.",
  "related_flows": [
    {
      "flow_name": "edge-jetpack-l4t-version-check",
      "relationship": "fed_by",
      "description": "provides platform_report needed here"
    },
    {
      "flow_name": "edge-cuda-cudnn-aarch64-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-nvpmodel-power-mode",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-jetson-clocks-lock",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-tegrastats-thermal-log",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-container-nvidia-runtime",
      "relationship": "fed_by",
      "description": "provides container_run_spec needed here"
    },
    {
      "flow_name": "edge-trtexec-engine-build",
      "relationship": "feeds_into",
      "description": "outputs memory_budget consumed by edge-trtexec-engine-build"
    }
  ]
}
