{
  "name": "errh-error-taxonomy",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "error-handling",
    "taxonomy",
    "retryable",
    "http-status",
    "classification"
  ],
  "inputs": [
    "boundary_map",
    "catch_inventory",
    "semgrep_findings"
  ],
  "outputs": [
    "error_taxonomy"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Classify every error type into fixed classes (expected or unexpected, retryable or not) with one HTTP status, log level and alert rule per class.",
  "related_flows": [
    {
      "flow_name": "errh-boundary-map",
      "relationship": "fed_by",
      "description": "provides boundary_map needed here"
    },
    {
      "flow_name": "errh-rg-swallowed-catch-inventory",
      "relationship": "fed_by",
      "description": "provides catch_inventory needed here"
    },
    {
      "flow_name": "errh-semgrep-swallowed-catch-scan",
      "relationship": "fed_by",
      "description": "provides semgrep_findings needed here"
    },
    {
      "flow_name": "errh-retryability-table",
      "relationship": "feeds_into",
      "description": "outputs error_taxonomy consumed by errh-retryability-table"
    },
    {
      "flow_name": "errh-catch-site-triage",
      "relationship": "feeds_into",
      "description": "outputs error_taxonomy consumed by errh-catch-site-triage"
    },
    {
      "flow_name": "errh-rfc9457-problem-type-registry",
      "relationship": "feeds_into",
      "description": "outputs error_taxonomy consumed by errh-rfc9457-problem-type-registry"
    },
    {
      "flow_name": "errh-user-message-catalog",
      "relationship": "feeds_into",
      "description": "outputs error_taxonomy consumed by errh-user-message-catalog"
    },
    {
      "flow_name": "errh-context-and-correlation-id",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
