{
  "name": "ctr-stack-inventory",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "containers",
    "docker",
    "inventory",
    "lockfile",
    "entrypoint"
  ],
  "inputs": [
    "project_dir",
    "stack"
  ],
  "outputs": [
    "build_profile"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Record a project's exact runtime version, package manager, lockfile, entrypoint, port, native dependencies and test command from repo files before containerizing it.",
  "related_flows": [
    {
      "flow_name": "ctr-dockerignore",
      "relationship": "feeds_into",
      "description": "outputs build_profile consumed by ctr-dockerignore"
    },
    {
      "flow_name": "ctr-base-image-select",
      "relationship": "feeds_into",
      "description": "outputs build_profile consumed by ctr-base-image-select"
    },
    {
      "flow_name": "ctr-alpine-musl-check",
      "relationship": "feeds_into",
      "description": "outputs build_profile consumed by ctr-alpine-musl-check"
    },
    {
      "flow_name": "ctr-pin-base-digest",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ctr-layer-cache-order",
      "relationship": "feeds_into",
      "description": "outputs build_profile consumed by ctr-layer-cache-order"
    },
    {
      "flow_name": "ctr-build-args-secrets",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ctr-nonroot-user",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ctr-healthcheck",
      "relationship": "feeds_into",
      "description": "outputs build_profile consumed by ctr-healthcheck"
    }
  ]
}
