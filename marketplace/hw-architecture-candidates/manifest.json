{
  "name": "hw-architecture-candidates",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "architecture",
    "design-exploration",
    "efficiency"
  ],
  "inputs": [
    "board_spec",
    "critical_circuits",
    "baseline_architecture"
  ],
  "outputs": [
    "architecture_candidates"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Generate at least four alternative board architectures, two or more unconventional, each built on a named design lever with a stated mechanism for beating the baseline.",
  "related_flows": [
    {
      "flow_name": "hw-baseline-architecture",
      "relationship": "fed_by",
      "description": "provides baseline_architecture needed here"
    },
    {
      "flow_name": "hw-architecture-scoring",
      "relationship": "feeds_into",
      "description": "outputs architecture_candidates consumed by hw-architecture-scoring"
    },
    {
      "flow_name": "hw-critical-circuit-flagging",
      "relationship": "fed_by",
      "description": "provides critical_circuits needed here"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "fed_by",
      "description": "provides board_spec needed here"
    }
  ]
}
