{
  "name": "ffr-flag-expiry-ci-gate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "ci",
    "flag-registry",
    "expiry",
    "code-references"
  ],
  "inputs": [
    "repo_path",
    "provider_choice",
    "stale_flags"
  ],
  "outputs": [
    "ci_gate_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Add a CI job that fails on expired, unregistered, or dynamically built flag keys using a checked-in registry, ripgrep, and jq.",
  "related_flows": [
    {
      "flow_name": "ffr-stale-flag-detect",
      "relationship": "fed_by",
      "description": "provides stale_flags needed here"
    },
    {
      "flow_name": "ffr-flag-removal-pr",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-flag-archive-in-service",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-provider-select",
      "relationship": "fed_by",
      "description": "provides provider_choice needed here"
    }
  ]
}
