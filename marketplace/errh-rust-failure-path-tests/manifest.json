{
  "name": "errh-rust-failure-path-tests",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "error-handling",
    "rust",
    "testing",
    "tracing-test",
    "failure-path-tests"
  ],
  "inputs": [
    "repo_path",
    "rust_error_changes",
    "rust_http_error_mapping",
    "retry_policy_table",
    "test_command"
  ],
  "outputs": [
    "rust_failure_tests"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write Rust failure-path tests that assert variants with matches!, prove sources are kept, check oneshot problem responses and count logs, each proven live.",
  "related_flows": [
    {
      "flow_name": "errh-retryability-table",
      "relationship": "fed_by",
      "description": "provides retry_policy_table needed here"
    },
    {
      "flow_name": "errh-rust-thiserror-anyhow",
      "relationship": "fed_by",
      "description": "provides rust_error_changes needed here"
    },
    {
      "flow_name": "errh-rust-axum-problem-details",
      "relationship": "fed_by",
      "description": "provides rust_http_error_mapping needed here"
    },
    {
      "flow_name": "errh-rust-clippy-unwrap-gate",
      "relationship": "feeds_into",
      "description": "outputs rust_failure_tests consumed by errh-rust-clippy-unwrap-gate"
    }
  ]
}
