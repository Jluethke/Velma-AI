{
  "name": "sqlo-mysql-innodb-index-design",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "mysql",
    "innodb",
    "index-design",
    "invisible-index"
  ],
  "inputs": [
    "plan_findings",
    "btree_index_proposal",
    "digest_findings",
    "schema_ddl"
  ],
  "outputs": [
    "index_candidates"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Adapt index candidates to InnoDB rules, remove redundant prefixes, and test each candidate as an invisible index.",
  "related_flows": [
    {
      "flow_name": "sqlo-sargable-rewrite",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-keyset-pagination",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-btree-composite-order",
      "relationship": "fed_by",
      "description": "provides btree_index_proposal needed here"
    },
    {
      "flow_name": "sqlo-index-write-cost",
      "relationship": "feeds_into",
      "description": "outputs index_candidates consumed by sqlo-index-write-cost"
    },
    {
      "flow_name": "sqlo-prod-like-verify",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-baseline-scope",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sqlo-mysql-slow-log-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sqlo-mysql-perf-schema-digest",
      "relationship": "fed_by",
      "description": "provides digest_findings needed here"
    }
  ]
}
