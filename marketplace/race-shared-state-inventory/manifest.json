{
  "name": "race-shared-state-inventory",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "concurrency",
    "shared-state",
    "ripgrep",
    "thread-safety",
    "audit"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "suspect_paths"
  ],
  "outputs": [
    "shared_state_inventory"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Builds a table of every piece of mutable state reachable from more than one thread, goroutine, task or request in the suspect code, with its writers, readers and the guard that protects it, using stack-specific ripgrep searches.",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "fed_by",
      "description": "provides suspect_paths needed here"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs shared_state_inventory consumed by race-findings-consolidate"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "feeds_into",
      "description": "outputs shared_state_inventory consumed by race-sync-primitive-choice"
    },
    {
      "flow_name": "race-deterministic-regression-test",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-apply-fix",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-stress-verify",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
