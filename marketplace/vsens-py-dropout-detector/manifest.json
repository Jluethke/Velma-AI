{
  "name": "vsens-py-dropout-detector",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "python",
    "dropout",
    "health-monitoring",
    "watchdog",
    "timestamps"
  ],
  "inputs": [
    "timing_requirements",
    "stream_log_path"
  ],
  "outputs": [
    "dropout_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Detect missed samples, stalls and bad timestamps in sensor streams without ROS using counters, a period-rounding rule and a monotonic-clock watchdog.",
  "related_flows": [
    {
      "flow_name": "vsens-sensor-inventory",
      "relationship": "fed_by",
      "description": "provides timing_requirements needed here"
    },
    {
      "flow_name": "vsens-ros2-stamp-latency",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-ros2-diagnostics-health",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-integration-acceptance",
      "relationship": "feeds_into",
      "description": "outputs dropout_report consumed by vsens-integration-acceptance"
    }
  ]
}
