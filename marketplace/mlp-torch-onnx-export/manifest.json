{
  "name": "mlp-torch-onnx-export",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "onnx",
    "onnxruntime",
    "pytorch"
  ],
  "inputs": [
    "torch_calibrated_model",
    "tuned_model",
    "feature_pipeline",
    "split_manifest"
  ],
  "outputs": [
    "onnx_model_package"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Exports the calibrated PyTorch model to ONNX with named inputs and a dynamic batch axis, validates it with `onnx.checker`, runs it in ONNX Runtime against eager PyTorch on a golden set, and packages preprocessing alongside it so serving takes the same raw inputs as training.",
  "related_flows": [
    {
      "flow_name": "mlp-torch-seed-determinism",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-wandb-tracking",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-optuna-search",
      "relationship": "fed_by",
      "description": "provides tuned_model needed here"
    },
    {
      "flow_name": "mlp-bootstrap-metric-ci",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-calibration-diagnose",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-torch-temperature-scaling",
      "relationship": "fed_by",
      "description": "provides torch_calibrated_model needed here"
    },
    {
      "flow_name": "mlp-inference-parity-test",
      "relationship": "feeds_into",
      "description": "outputs onnx_model_package consumed by mlp-inference-parity-test"
    },
    {
      "flow_name": "mlp-split-integrity-check",
      "relationship": "fed_by",
      "description": "provides split_manifest needed here"
    }
  ]
}
