{
  "name": "uic-react-component-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "react",
    "typescript",
    "components",
    "useId",
    "frontend"
  ],
  "inputs": [
    "repo_dir",
    "component_path",
    "component_contract",
    "state_ownership_spec",
    "styling_decision",
    "aria_spec"
  ],
  "outputs": [
    "react_build_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Implement one typed React function component from its contract with version-correct ref handling, useId ids, controllable state and clean tsc and ESLint runs.",
  "related_flows": [
    {
      "flow_name": "uic-props-state-events-contract",
      "relationship": "fed_by",
      "description": "provides component_contract, component_path needed here"
    },
    {
      "flow_name": "uic-controlled-uncontrolled-decision",
      "relationship": "fed_by",
      "description": "provides state_ownership_spec needed here"
    },
    {
      "flow_name": "uic-styling-approach-decision",
      "relationship": "fed_by",
      "description": "provides styling_decision needed here"
    },
    {
      "flow_name": "uic-aria-pattern-select",
      "relationship": "fed_by",
      "description": "provides aria_spec needed here"
    },
    {
      "flow_name": "uic-react-hooks-lint",
      "relationship": "feeds_into",
      "description": "outputs react_build_report consumed by uic-react-hooks-lint"
    },
    {
      "flow_name": "uic-react-effect-cleanup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-react-memo-profile",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-keyboard-handler-implement",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
