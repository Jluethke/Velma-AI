{
  "name": "rag-corpus-normalize-dedupe",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rag",
    "unicode",
    "dedupe",
    "minhash",
    "datasketch"
  ],
  "inputs": [
    "corpus_manifest",
    "record_schema",
    "work_dir",
    "near_dup_threshold"
  ],
  "outputs": [
    "clean_records",
    "dedupe_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Merge extractor records per document, apply NFKC and invisible-character removal with offset recompute, and drop exact and MinHash near-duplicate documents.",
  "related_flows": [
    {
      "flow_name": "rag-corpus-inventory",
      "relationship": "fed_by",
      "description": "provides corpus_manifest, record_schema needed here"
    },
    {
      "flow_name": "rag-py-pdf-extract-pymupdf",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-ocr-scanned-pdf-ocrmypdf",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-py-html-extract-trafilatura",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-gold-question-set-label",
      "relationship": "feeds_into",
      "description": "outputs clean_records consumed by rag-gold-question-set-label"
    },
    {
      "flow_name": "rag-chunk-candidates-build",
      "relationship": "feeds_into",
      "description": "outputs clean_records consumed by rag-chunk-candidates-build"
    },
    {
      "flow_name": "rag-retrieved-injection-defense",
      "relationship": "feeds_into",
      "description": "outputs clean_records consumed by rag-retrieved-injection-defense"
    }
  ]
}
