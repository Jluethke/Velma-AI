{
    "name": "srf-verify-step-history",
    "version": "1.0.0",
    "domain": "engineering",
    "tags": [
        "refactoring",
        "git",
        "bisect",
        "verification"
    ],
    "inputs": [
        "repo_path",
        "test_command",
        "baseline_commit",
        "refactor_branch",
        "api_check_command"
    ],
    "outputs": [
        "verification_report",
        "red_commits"
    ],
    "execution_pattern": "phase_pipeline",
    "price": "0",
    "license": "OPEN",
    "description": "Run the test suite and API check at every commit since the baseline in a separate worktree, flag changed test expectations, and bisect any red commit."
}
