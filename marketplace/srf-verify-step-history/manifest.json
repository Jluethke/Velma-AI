{
  "name": "srf-verify-step-history",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "refactoring",
    "git",
    "bisect",
    "verification"
  ],
  "inputs": [
    "repo_path",
    "test_command",
    "baseline_commit",
    "refactor_branch",
    "api_check_command"
  ],
  "outputs": [
    "verification_report",
    "red_commits"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run the test suite and API check at every commit since the baseline in a separate worktree, flag changed test expectations, and bisect any red commit.",
  "related_flows": [
    {
      "flow_name": "srf-baseline-green-check",
      "relationship": "fed_by",
      "description": "provides baseline_commit, refactor_branch needed here"
    },
    {
      "flow_name": "srf-py-characterization-tests",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "srf-node-characterization-tests",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "srf-go-golden-master-tests",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "srf-js-codemod-jscodeshift",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "srf-go-rewrite-gofmt-r",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "srf-py-approval-tests-combinations",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "srf-py-api-snapshot-griffe",
      "relationship": "fed_by",
      "description": "provides api_check_command needed here"
    }
  ]
}
