{
  "name": "pcb-layout-metrics",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "metrics",
    "efficiency",
    "optimization"
  ],
  "inputs": [
    "kicad_pcb",
    "placement_scorecard",
    "baseline_metrics"
  ],
  "outputs": [
    "layout_scorecard"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure the finished board's via count, trace length, hot-loop areas, power path I2R loss, area, and layers, and compare against placement prediction and the conventional baseline.",
  "related_flows": [
    {
      "flow_name": "pcb-board-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-placement-candidates",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-placement-scoring",
      "relationship": "fed_by",
      "description": "provides placement_scorecard needed here"
    },
    {
      "flow_name": "pcb-critical-routing",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-autoroute",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-drc-closure",
      "relationship": "fed_by",
      "description": "provides kicad_pcb needed here"
    },
    {
      "flow_name": "hw-baseline-architecture",
      "relationship": "fed_by",
      "description": "provides baseline_metrics needed here"
    },
    {
      "flow_name": "hw-design-delta-report",
      "relationship": "feeds_into",
      "description": "outputs layout_scorecard consumed by hw-design-delta-report"
    }
  ]
}
