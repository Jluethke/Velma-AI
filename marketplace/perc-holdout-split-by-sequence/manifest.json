{
  "name": "perc-holdout-split-by-sequence",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "perception",
    "dataset",
    "holdout",
    "leakage",
    "split"
  ],
  "inputs": [
    "coco_annotations",
    "sequence_key",
    "holdout_fraction"
  ],
  "outputs": [
    "train_annotations",
    "val_annotations",
    "holdout_annotations",
    "split_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Split a COCO dataset into train, validation and holdout sets by recording sequence and prove there is no cross-set leakage.",
  "related_flows": [
    {
      "flow_name": "perc-label-format-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perc-kitti-to-coco-convert",
      "relationship": "fed_by",
      "description": "provides coco_annotations needed here"
    },
    {
      "flow_name": "perc-train-vs-finetune-decision",
      "relationship": "feeds_into",
      "description": "outputs split_report consumed by perc-train-vs-finetune-decision"
    },
    {
      "flow_name": "perc-py-ultralytics-finetune",
      "relationship": "feeds_into",
      "description": "outputs val_annotations, train_annotations consumed by perc-py-ultralytics-finetune"
    },
    {
      "flow_name": "perc-onnx-export-verify",
      "relationship": "feeds_into",
      "description": "outputs holdout_annotations consumed by perc-onnx-export-verify"
    },
    {
      "flow_name": "perc-py-gpu-preprocess",
      "relationship": "feeds_into",
      "description": "outputs holdout_annotations consumed by perc-py-gpu-preprocess"
    },
    {
      "flow_name": "perc-cpp-cuda-preprocess",
      "relationship": "feeds_into",
      "description": "outputs holdout_annotations consumed by perc-cpp-cuda-preprocess"
    },
    {
      "flow_name": "perc-detection-map-eval",
      "relationship": "feeds_into",
      "description": "outputs holdout_annotations consumed by perc-detection-map-eval"
    }
  ]
}
