{
  "name": "tsm-py-conversion-order",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "python",
    "grimp",
    "import-graph",
    "ordering"
  ],
  "inputs": [
    "repo_path",
    "migration_profile"
  ],
  "outputs": [
    "py_conversion_order"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Compute a leaf-first module annotation order from the package import graph with grimp, reporting import cycles as single units.",
  "related_flows": [
    {
      "flow_name": "tsm-migration-intake",
      "relationship": "fed_by",
      "description": "provides migration_profile needed here"
    },
    {
      "flow_name": "tsm-py-error-baseline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-type-coverage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-stubs-missing-imports",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-py-mypy-module-strict",
      "relationship": "feeds_into",
      "description": "outputs py_conversion_order consumed by tsm-py-mypy-module-strict"
    },
    {
      "flow_name": "tsm-py-pyright-strict",
      "relationship": "feeds_into",
      "description": "outputs py_conversion_order consumed by tsm-py-pyright-strict"
    },
    {
      "flow_name": "tsm-py-annotate-module",
      "relationship": "feeds_into",
      "description": "outputs py_conversion_order consumed by tsm-py-annotate-module"
    },
    {
      "flow_name": "tsm-py-typeddict-protocol",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
