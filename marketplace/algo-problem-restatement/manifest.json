{
  "name": "algo-problem-restatement",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "algorithms",
    "problem-analysis",
    "constraints",
    "complexity",
    "competitive-programming"
  ],
  "inputs": [
    "problem_statement",
    "time_limit_seconds",
    "memory_limit_mb",
    "stack"
  ],
  "outputs": [
    "problem_spec",
    "complexity_target"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Restate an algorithmic problem as a precise specification and derive the required time and memory complexity from input sizes and a measured operation budget.",
  "related_flows": [
    {
      "flow_name": "algo-brute-force-reference",
      "relationship": "feeds_into",
      "description": "outputs problem_spec consumed by algo-brute-force-reference"
    },
    {
      "flow_name": "algo-pattern-select",
      "relationship": "feeds_into",
      "description": "outputs complexity_target, problem_spec consumed by algo-pattern-select"
    },
    {
      "flow_name": "algo-edge-case-enumeration",
      "relationship": "feeds_into",
      "description": "outputs problem_spec consumed by algo-edge-case-enumeration"
    },
    {
      "flow_name": "algo-correctness-proof-sketch",
      "relationship": "feeds_into",
      "description": "outputs problem_spec consumed by algo-correctness-proof-sketch"
    },
    {
      "flow_name": "algo-py-runtime-pitfalls",
      "relationship": "feeds_into",
      "description": "outputs problem_spec consumed by algo-py-runtime-pitfalls"
    },
    {
      "flow_name": "algo-cpp-overflow-ub-audit",
      "relationship": "feeds_into",
      "description": "outputs problem_spec consumed by algo-cpp-overflow-ub-audit"
    },
    {
      "flow_name": "algo-java-runtime-pitfalls",
      "relationship": "feeds_into",
      "description": "outputs problem_spec consumed by algo-java-runtime-pitfalls"
    },
    {
      "flow_name": "algo-py-differential-stress-test",
      "relationship": "feeds_into",
      "description": "outputs problem_spec consumed by algo-py-differential-stress-test"
    }
  ]
}
