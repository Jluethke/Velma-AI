{
  "name": "uic-bundle-size-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "bundle-size",
    "size-limit",
    "tree-shaking",
    "publint",
    "performance"
  ],
  "inputs": [
    "repo_dir",
    "component_path",
    "size_budget"
  ],
  "outputs": [
    "size_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure a component's tree-shaken cost with size-limit, explain heavy modules, fix packaging with publint and sideEffects, and gate on a user-supplied budget.",
  "related_flows": [
    {
      "flow_name": "uic-props-state-events-contract",
