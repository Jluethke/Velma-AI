    },
    {
      "flow_name": "uic-aria-pattern-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-storybook-stories",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-visual-regression",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-component-docs",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-component-ship-gate",
      "relationship": "feeds_into",
      "description": "outputs size_report consumed by uic-component-ship-gate"
    }
  ]
