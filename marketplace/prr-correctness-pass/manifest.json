{
  "name": "prr-correctness-pass",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "correctness",
    "edge-cases",
    "bugs",
    "testing"
  ],
  "inputs": [
    "repo_dir",
    "diff_file",
    "reading_plan",
    "intent_statement",
    "findings_dir"
  ],
  "outputs": [
    "correctness_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Check every changed function against a fixed correctness checklist, trace its callers, and prove each suspected bug with a scratch test in a separate worktree.",
  "related_flows": [
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides diff_file needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "fed_by",
      "description": "provides intent_statement needed here"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "fed_by",
      "description": "provides reading_plan needed here"
    },
    {
      "flow_name": "prr-test-revert-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-concurrency-pass",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-severity-comments",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-approval-decision",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
