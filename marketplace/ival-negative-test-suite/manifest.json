{
  "name": "ival-negative-test-suite",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "security",
    "negative-testing",
    "pytest",
    "vitest",
    "mutation-check"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "sink_map"
  ],
  "outputs": [
    "negative_tests"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build one negative test module per vulnerability class through the real HTTP stack with side-effect oracles, and mutation-check each module.",
  "related_flows": [
    {
      "flow_name": "ival-entry-point-inventory",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "ival-sink-class-map",
      "relationship": "fed_by",
      "description": "provides sink_map needed here"
    },
    {
      "flow_name": "ival-semgrep-taint-rules",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "ival-path-traversal-fix",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ival-ssrf-egress-guard",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ival-rejected-input-logging",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ival-ci-security-gate",
      "relationship": "feeds_into",
      "description": "outputs negative_tests consumed by ival-ci-security-gate"
    },
    {
      "flow_name": "ival-xss-output-encoding",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
