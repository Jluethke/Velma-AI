{
  "name": "pkg-post-publish-verify",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "verification",
    "registry",
    "install-test"
  ],
  "inputs": [
    "stack",
    "package_name",
    "release_version",
    "changelog_entry",
    "py_publish_record",
    "npm_publish_record",
    "go_publish_record",
    "crate_publish_record"
  ],
  "outputs": [
    "release_verification"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Confirm the published version exists on the public registry, installs from it into a clean environment, carries its attestation, and matches the changelog, with a fix-forward rule for defects.",
  "related_flows": [
    {
      "flow_name": "pkg-release-version-lock",
      "relationship": "fed_by",
      "description": "provides release_version needed here"
    },
    {
      "flow_name": "pkg-changelog-entry",
      "relationship": "fed_by",
      "description": "provides changelog_entry needed here"
    },
    {
      "flow_name": "pkg-py-trusted-publishing",
      "relationship": "fed_by",
      "description": "provides py_publish_record needed here"
    },
    {
      "flow_name": "pkg-node-provenance-publish",
      "relationship": "fed_by",
      "description": "provides npm_publish_record needed here"
    },
    {
      "flow_name": "pkg-go-tag-and-proxy",
      "relationship": "fed_by",
      "description": "provides go_publish_record needed here"
    },
    {
      "flow_name": "pkg-rust-cargo-publish",
      "relationship": "fed_by",
      "description": "provides crate_publish_record needed here"
    }
  ]
}
