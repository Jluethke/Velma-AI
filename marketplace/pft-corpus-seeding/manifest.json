{
  "name": "pft-corpus-seeding",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "fuzzing",
    "corpus",
    "dictionary",
    "cmin",
    "seeds"
  ],
  "inputs": [
    "fuzz_targets",
    "stack",
    "repo_path",
    "sample_inputs"
  ],
  "outputs": [
    "seed_corpus",
    "fuzz_dictionary"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a minimized seed corpus and a fuzzing dictionary for each fuzz target in the layout its fuzzer expects.",
  "related_flows": [
    {
      "flow_name": "pft-invariant-discovery",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "pft-fuzz-target-selection",
      "relationship": "fed_by",
      "description": "provides fuzz_targets needed here"
    },
    {
      "flow_name": "pft-coverage-plateau-analysis",
      "relationship": "feeds_into",
      "description": "outputs seed_corpus consumed by pft-coverage-plateau-analysis"
    },
    {
      "flow_name": "pft-crash-triage-dedup",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "pft-crash-regression-test",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "pft-ci-fuzz-integration",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "pft-shrinking-reproduction",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "pft-sanitizer-builds",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
