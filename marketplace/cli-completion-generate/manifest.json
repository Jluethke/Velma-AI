{
  "name": "cli-completion-generate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "cli",
    "completion",
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "inputs": [
    "cli_spec",
    "tool_name",
    "project_dir",
    "stack"
  ],
  "outputs": [
    "completion_scripts",
    "completion_install_paths"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Generate bash, zsh, fish and PowerShell completion scripts with each parser's own mechanism and record install locations.",
  "related_flows": [
    {
      "flow_name": "cli-spec-commands-flags-exits",
      "relationship": "fed_by",
      "description": "provides cli_spec needed here"
    },
    {
      "flow_name": "cli-help-usage-text",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "cli-stdio-stream-discipline",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "cli-signal-sigint-handling",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "cli-config-env-precedence",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "cli-tty-color-detection",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "cli-completion-verify-shells",
      "relationship": "feeds_into",
      "description": "outputs completion_install_paths, completion_scripts consumed by cli-completion-verify-shells"
    },
    {
      "flow_name": "cli-homebrew-formula",
      "relationship": "feeds_into",
      "description": "outputs completion_scripts consumed by cli-homebrew-formula"
    }
  ]
}
