{
  "name": "dbs-index-from-access-patterns",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "database",
    "schema-design",
    "indexes",
    "explain"
  ],
  "inputs": [
    "constrained_schema",
    "access_patterns",
    "db_engine"
  ],
  "outputs": [
    "index_plan",
    "target_ddl"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Derive the minimum B-tree index set from access patterns using equality, sort, range ordering and prove each index with EXPLAIN on realistic generated data.",
  "related_flows": [
    {
      "flow_name": "dbs-access-pattern-inventory",
      "relationship": "fed_by",
      "description": "provides access_patterns needed here"
    },
    {
      "flow_name": "dbs-entity-relationship-model",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-normalize-to-3nf",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-denormalize-decision",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-primary-key-strategy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-constraints-foreign-keys",
      "relationship": "fed_by",
      "description": "provides constrained_schema needed here"
    },
    {
      "flow_name": "dbs-expand-contract-plan",
      "relationship": "feeds_into",
      "description": "outputs target_ddl consumed by dbs-expand-contract-plan"
    }
  ]
}
