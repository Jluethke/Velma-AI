{
  "name": "rel-node-publish-npm-provenance",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "node",
    "npm",
    "provenance",
    "dist-tag"
  ],
  "inputs": [
    "node_dist",
    "package_name",
    "next_version",
    "prerelease_id",
    "provenance_verification"
  ],
  "outputs": [
    "npm_release_url"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
