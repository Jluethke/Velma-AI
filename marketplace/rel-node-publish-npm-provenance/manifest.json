      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-commit-history-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-node-api-break-extractor",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-semver-bump-decision",
      "relationship": "fed_by",
      "description": "provides next_version needed here"
    },
    {
      "flow_name": "rel-changelog-semantic-release",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-node-reproducible-pack",
      "relationship": "fed_by",
      "description": "provides node_dist needed here"
    },
    {
      "flow_name": "rel-slsa-provenance-attest",
      "relationship": "fed_by",
