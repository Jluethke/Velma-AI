{
  "name": "k8s-workload-inventory",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "inventory",
    "container-image",
    "workload"
  ],
  "inputs": [
    "repo_dir",
    "app_name",
    "image_ref",
    "stack"
  ],
  "outputs": [
    "workload_profile"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Record every fact a Kubernetes manifest needs from the repository and image: workload kind, port, entrypoint form, user, platforms, env vars, writable paths and dependencies.",
  "related_flows": [
    {
      "flow_name": "k8s-py-health-endpoints",
      "relationship": "feeds_into",
      "description": "outputs workload_profile consumed by k8s-py-health-endpoints"
    },
    {
      "flow_name": "k8s-node-health-endpoints",
      "relationship": "feeds_into",
      "description": "outputs workload_profile consumed by k8s-node-health-endpoints"
    },
    {
      "flow_name": "k8s-go-health-endpoints",
      "relationship": "feeds_into",
      "description": "outputs workload_profile consumed by k8s-go-health-endpoints"
    },
    {
      "flow_name": "k8s-jvm-health-endpoints",
      "relationship": "feeds_into",
      "description": "outputs workload_profile consumed by k8s-jvm-health-endpoints"
    },
    {
      "flow_name": "k8s-probe-tuning",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-rollout-status-watch",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-helm-vs-kustomize-decision",
      "relationship": "feeds_into",
      "description": "outputs workload_profile consumed by k8s-helm-vs-kustomize-decision"
    },
    {
      "flow_name": "k8s-deployment-manifest",
      "relationship": "feeds_into",
      "description": "outputs workload_profile consumed by k8s-deployment-manifest"
    }
  ]
}
