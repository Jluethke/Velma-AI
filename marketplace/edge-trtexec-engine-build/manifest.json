{
  "name": "edge-trtexec-engine-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "tensorrt",
    "trtexec",
    "engine",
    "jetson"
  ],
  "inputs": [
    "device_host",
    "onnx_model",
    "input_shapes",
    "precision",
    "memory_budget",
    "calibration_cache",
    "dla_core"
  ],
  "outputs": [
    "engine_file",
    "build_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a TensorRT engine on the target device with trtexec and classify the build log.",
  "related_flows": [
    {
      "flow_name": "edge-onnx-export-validate",
      "relationship": "fed_by",
      "description": "provides onnx_model needed here"
    },
    {
      "flow_name": "edge-quantization-accuracy-check",
      "relationship": "feeds_into",
      "description": "outputs engine_file consumed by edge-quantization-accuracy-check"
    },
    {
      "flow_name": "edge-jetpack-l4t-version-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-py-pytorch-aarch64-wheel",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-int8-calibration-cache",
      "relationship": "fed_by",
      "description": "provides calibration_cache needed here"
    },
    {
      "flow_name": "edge-trt-engine-cache-key",
      "relationship": "feeds_into",
      "description": "outputs engine_file consumed by edge-trt-engine-cache-key"
    },
    {
      "flow_name": "edge-py-trt-inference-runtime",
      "relationship": "feeds_into",
      "description": "outputs engine_file consumed by edge-py-trt-inference-runtime"
    },
    {
      "flow_name": "edge-latency-throughput-benchmark",
      "relationship": "feeds_into",
      "description": "outputs engine_file consumed by edge-latency-throughput-benchmark"
    }
  ]
}
