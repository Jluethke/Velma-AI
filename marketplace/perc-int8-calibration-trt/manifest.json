{
  "name": "perc-int8-calibration-trt",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "perception",
    "tensorrt",
    "int8",
    "calibration",
    "polygraphy"
  ],
  "inputs": [
    "onnx_model",
    "preprocess_spec",
    "calibration_dir",
    "input_shape",
    "gpu_target"
  ],
  "outputs": [
    "int8_engine",
    "calibration_cache",
    "int8_build_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build an INT8 TensorRT engine by calibrating on training-distribution images that exclude holdout, with measured FP16 fallbacks recorded.",
  "related_flows": [
    {
      "flow_name": "perc-onnx-export-verify",
      "relationship": "fed_by",
      "description": "provides onnx_model needed here"
    },
    {
      "flow_name": "perc-preprocess-spec-extract",
      "relationship": "fed_by",
      "description": "provides preprocess_spec needed here"
    },
    {
      "flow_name": "perc-trtexec-fp16-engine",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "perc-detection-map-eval",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "perc-model-select-pareto",
      "relationship": "feeds_into",
      "description": "outputs int8_build_report consumed by perc-model-select-pareto"
    },
    {
      "flow_name": "perc-nsys-profile-pipeline",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "perc-e2e-latency-budget",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "perc-py-gpu-preprocess",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
