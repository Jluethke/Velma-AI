{
  "name": "mob-ios-crash-reporting",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "mobile",
    "ios",
    "crashlytics",
    "sentry",
    "dsym"
  ],
  "inputs": [
    "app_profile",
    "crash_backend"
  ],
  "outputs": [
    "ios_crash_setup"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Wire Crashlytics or Sentry on iOS, upload dSYMs automatically, verify matching UUIDs, and prove a symbolicated crash and a non-fatal in the console.",
  "related_flows": [
    {
      "flow_name": "mob-app-profile",
      "relationship": "fed_by",
      "description": "provides app_profile needed here"
    },
    {
      "flow_name": "mob-device-os-matrix",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "mob-ios-app-store-release",
      "relationship": "feeds_into",
      "description": "outputs ios_crash_setup consumed by mob-ios-app-store-release"
    },
    {
      "flow_name": "mob-screen-state-machine",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mob-ios-swiftui-screen",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mob-network-retry-policy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mob-ios-urlsession-offline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mob-ios-local-store",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
