{
  "name": "response-validator",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "response",
    "validator"
  ],
  "inputs": [
    "emotional_trajectory",
    "inferred_resolution_goal",
    "must_address_count",
    "response_draft",
    "tone_profile",
    "unresolved_points"
  ],
  "outputs": [
    "addressed_points",
    "clarity_check",
    "iteration_needed",
    "resolution_status",
    "tone_match",
    "validation_notes"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process emotional_trajectory, inferred_resolution_goal, must_address_count to produce addressed_points, clarity_check, iteration_needed.",
  "related_flows": [
    {
      "flow_name": "email-point-extractor",
      "relationship": "fed_by",
      "description": "provides unresolved_points, must_address_count, emotional_trajectory needed here"
    },
    {
      "flow_name": "email-tone-analyzer",
      "relationship": "fed_by",
      "description": "provides inferred_resolution_goal needed here"
    },
    {
      "flow_name": "email-response-drafter",
      "relationship": "fed_by",
      "description": "provides response_draft needed here"
    },
    {
      "flow_name": "email-response-finalizer",
      "relationship": "feeds_into",
      "description": "outputs iteration_needed, validation_notes, resolution_status consumed by email-response-finalizer"
    }
  ]
}
