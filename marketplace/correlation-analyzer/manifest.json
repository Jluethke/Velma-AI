    },
    {
      "flow_name": "hypothesis-generator",
      "relationship": "feeds_into",
      "description": "outputs correlation_plan consumed by hypothesis-generator"
    },
    {
      "flow_name": "eda-execution-planner",
      "relationship": "feeds_into",
      "description": "outputs correlation_plan consumed by eda-execution-planner"
