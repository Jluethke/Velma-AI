{
  "name": "k8s-resource-usage-measure",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "prometheus",
    "metrics",
    "vpa",
    "capacity"
  ],
  "inputs": [
    "cluster_context",
    "namespace",
    "app_name",
    "measurement_window",
    "load_test_command",
    "probed_deployment"
  ],
  "outputs": [
    "usage_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure container CPU and memory percentiles, throttling and OOM kills over a stated window with Prometheus or kubectl top, plus a VPA recommendation.",
  "related_flows": [
    {
      "flow_name": "k8s-requests-limits-from-usage",
      "relationship": "feeds_into",
      "description": "outputs usage_report consumed by k8s-requests-limits-from-usage"
    },
    {
      "flow_name": "k8s-py-gunicorn-worker-sizing",
      "relationship": "feeds_into",
      "description": "outputs usage_report consumed by k8s-py-gunicorn-worker-sizing"
    },
    {
      "flow_name": "k8s-node-heap-sizing",
      "relationship": "feeds_into",
      "description": "outputs usage_report consumed by k8s-node-heap-sizing"
    },
    {
      "flow_name": "k8s-go-gomaxprocs-gomemlimit",
      "relationship": "feeds_into",
      "description": "outputs usage_report consumed by k8s-go-gomaxprocs-gomemlimit"
    },
    {
      "flow_name": "k8s-jvm-container-heap",
      "relationship": "feeds_into",
      "description": "outputs usage_report consumed by k8s-jvm-container-heap"
    },
    {
      "flow_name": "k8s-hpa-autoscaling",
      "relationship": "feeds_into",
      "description": "outputs usage_report consumed by k8s-hpa-autoscaling"
    },
    {
      "flow_name": "k8s-probe-tuning",
      "relationship": "fed_by",
      "description": "provides probed_deployment needed here"
    }
  ]
}
