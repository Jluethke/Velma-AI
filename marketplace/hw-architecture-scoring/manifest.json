{
  "name": "hw-architecture-scoring",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "architecture",
    "pareto",
    "efficiency"
  ],
  "inputs": [
    "architecture_candidates",
    "baseline_architecture",
    "baseline_metrics",
    "critical_circuits"
  ],
  "outputs": [
    "selected_architecture",
    "architecture_scorecard",
    "design_deltas"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Score candidate architectures by the baseline's method, reject any that weaken a critical circuit, pick from the Pareto front, and record every delta against baseline.",
  "related_flows": [
    {
      "flow_name": "hw-baseline-architecture",
      "relationship": "fed_by",
      "description": "provides baseline_metrics, baseline_architecture needed here"
    },
    {
      "flow_name": "hw-architecture-candidates",
      "relationship": "fed_by",
      "description": "provides architecture_candidates needed here"
    },
    {
      "flow_name": "hw-critical-circuit-flagging",
      "relationship": "fed_by",
      "description": "provides critical_circuits needed here"
    },
    {
      "flow_name": "pcb-part-selection",
      "relationship": "feeds_into",
      "description": "outputs selected_architecture consumed by pcb-part-selection"
    },
    {
      "flow_name": "hw-design-delta-report",
      "relationship": "feeds_into",
      "description": "outputs design_deltas, architecture_scorecard consumed by hw-design-delta-report"
    }
  ]
}
