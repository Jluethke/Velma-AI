{
  "name": "uic-storybook-stories",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "storybook",
    "csf3",
    "play-function",
    "stories",
    "frontend"
  ],
  "inputs": [
    "repo_dir",
    "component_path",
    "component_contract",
    "stack"
  ],
  "outputs": [
    "story_files"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write CSF3 stories for every component state with typed meta, args, play-function assertions and the a11y addon, and pass the Storybook build and story tests.",
  "related_flows": [
    {
      "flow_name": "uic-props-state-events-contract",
      "relationship": "fed_by",
      "description": "provides component_contract, component_path needed here"
    },
    {
      "flow_name": "uic-aria-pattern-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-visual-regression",
      "relationship": "feeds_into",
      "description": "outputs story_files consumed by uic-visual-regression"
    },
    {
      "flow_name": "uic-bundle-size-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "uic-component-docs",
      "relationship": "feeds_into",
      "description": "outputs story_files consumed by uic-component-docs"
    }
  ]
}
