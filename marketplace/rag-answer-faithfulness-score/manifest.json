      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-failure-analysis-triage",
      "relationship": "feeds_into",
      "description": "outputs faithfulness_report consumed by rag-failure-analysis-triage"
    },
    {
      "flow_name": "rag-answer-cache-redis",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-gold-question-set-label",
      "relationship": "fed_by",
      "description": "provides question_set needed here"
    }
  ]
