    "evaluation",
    "faithfulness",
    "llm-judge",
    "nli"
  ],
  "inputs": [
    "question_set",
    "prompt_template",
    "judge_model",
    "work_dir"
  ],
  "outputs": [
    "faithfulness_report",
    "judge_agreement"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
