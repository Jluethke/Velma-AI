      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-managed-vs-native-split",
      "relationship": "fed_by",
      "description": "provides leak_layer needed here"
    },
    {
      "flow_name": "leak-classic-causes-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-py-tracemalloc-diff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-py-objgraph-backrefs",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-py-gc-referrers",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "leak-root-cause-confirm",
      "relationship": "feeds_into",
      "description": "outputs py_native_leak_report consumed by leak-root-cause-confirm"
    }
  ]
