{
  "name": "gql-n-plus-one-detect",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "graphql",
    "n-plus-one",
    "performance",
    "sql",
    "orm"
  ],
  "inputs": [
    "project_dir",
    "stack",
    "operation_documents"
  ],
  "outputs": [
    "query_count_report",
    "n_plus_one_fields"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Count SQL statements per GraphQL operation at two result sizes and name every field whose query count grows with the number of parent items.",
  "related_flows": [
    {
      "flow_name": "gql-otel-resolver-tracing",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "gql-py-strawberry-dataloader",
      "relationship": "feeds_into",
      "description": "outputs n_plus_one_fields consumed by gql-py-strawberry-dataloader"
    },
    {
      "flow_name": "gql-go-dataloadgen",
      "relationship": "feeds_into",
      "description": "outputs n_plus_one_fields consumed by gql-go-dataloadgen"
    },
    {
      "flow_name": "gql-input-validation-rules",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "gql-error-extensions",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "gql-py-strawberry-resolvers",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-go-gqlgen-resolvers",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-connection-keyset-resolver",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
