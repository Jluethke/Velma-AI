{
  "name": "tsm-ts-declaration-files",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "typescript",
    "definitelytyped",
    "d.ts",
    "module-augmentation"
  ],
  "inputs": [
    "repo_path",
    "ts_allowjs_config"
  ],
  "outputs": [
    "ts_declarations"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Resolve every TS7016 missing declaration by installing a version-matched @types package or writing a minimal typed .d.ts, never a bare declare module shorthand.",
  "related_flows": [
    {
      "flow_name": "tsm-migration-intake",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-error-baseline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-type-coverage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-conversion-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-allowjs-checkjs",
      "relationship": "fed_by",
      "description": "provides ts_allowjs_config needed here"
    },
    {
      "flow_name": "tsm-ts-convert-file",
      "relationship": "feeds_into",
      "description": "outputs ts_declarations consumed by tsm-ts-convert-file"
    },
    {
      "flow_name": "tsm-ts-noimplicitany",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsm-ts-strictnullchecks",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
