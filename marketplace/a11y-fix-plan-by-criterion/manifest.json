{
  "name": "a11y-fix-plan-by-criterion",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "remediation",
    "planning",
    "wcag-techniques",
    "wcag"
  ],
  "inputs": [
    "ranked_issues",
    "component_inventory",
    "repo_dir",
    "stack"
  ],
  "outputs": [
    "fix_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Turns the ranked issue register into an ordered list of small fix tasks, one root cause per task, each with the source file located, the W3C technique to apply, the failing check that proves the bug, and the test that will prove the fix, so the stack-specific fix flow changes one thing at a time.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "fed_by",
      "description": "provides component_inventory needed here"
    },
    {
      "flow_name": "a11y-axe-playwright-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-scan-merge-dedupe",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "fed_by",
      "description": "provides ranked_issues needed here"
    },
    {
      "flow_name": "a11y-react-fix-and-test",
      "relationship": "feeds_into",
      "description": "outputs fix_plan consumed by a11y-react-fix-and-test"
    },
    {
      "flow_name": "a11y-retest-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-ci-regression-gate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-vue-fix-and-test",
      "relationship": "feeds_into",
      "description": "outputs fix_plan consumed by a11y-vue-fix-and-test"
    }
  ]
}
