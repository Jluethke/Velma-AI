{
  "name": "prr-severity-comments",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "review-comments",
    "conventional-comments",
    "severity",
    "feedback"
  ],
  "inputs": [
    "findings_dir",
    "diff_file",
    "head_sha"
  ],
  "outputs": [
    "review_comments",
    "blocking_count"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Merge all review findings into deduplicated line-anchored comments in Conventional Comments format with blocking, nit, question or suggestion severity and a concrete fix.",
  "related_flows": [
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides head_sha, diff_file needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-approval-decision",
      "relationship": "feeds_into",
      "description": "outputs review_comments, blocking_count consumed by prr-approval-decision"
    },
    {
      "flow_name": "prr-gh-post-review",
      "relationship": "feeds_into",
      "description": "outputs review_comments consumed by prr-gh-post-review"
    },
    {
      "flow_name": "prr-glab-post-review",
      "relationship": "feeds_into",
      "description": "outputs review_comments consumed by prr-glab-post-review"
    },
    {
      "flow_name": "prr-concurrency-pass",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
