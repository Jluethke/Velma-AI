{
  "name": "prr-approval-decision",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "approval",
    "ci-status",
    "merge",
    "decision-table"
  ],
  "inputs": [
    "repo_dir",
    "pr_number",
    "forge",
    "head_sha",
    "review_comments",
    "blocking_count",
    "review_units",
    "findings_dir"
  ],
  "outputs": [
    "review_verdict",
    "verdict_rationale"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Decide approve, request changes or comment from explicit criteria verified with forge commands, and write the rationale for the verdict.",
  "related_flows": [
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides head_sha needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "fed_by",
      "description": "provides review_units needed here"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-severity-comments",
      "relationship": "fed_by",
      "description": "provides review_comments, blocking_count needed here"
    },
    {
      "flow_name": "prr-gh-post-review",
      "relationship": "feeds_into",
      "description": "outputs review_verdict, verdict_rationale consumed by prr-gh-post-review"
    },
    {
      "flow_name": "prr-glab-post-review",
      "relationship": "feeds_into",
      "description": "outputs review_verdict, verdict_rationale consumed by prr-glab-post-review"
    },
    {
      "flow_name": "prr-concurrency-pass",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
