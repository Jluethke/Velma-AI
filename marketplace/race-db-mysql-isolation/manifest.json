{
  "name": "race-db-mysql-isolation",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "mysql",
    "innodb",
    "gap-locks",
    "transaction-isolation",
    "deadlock"
  ],
  "inputs": [
    "repo_path",
    "suspect_paths",
    "db_connection"
  ],
  "outputs": [
    "mysql_anomaly_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Reproduces lost updates, gap-lock and next-key-lock deadlocks and lock wait timeouts in MySQL InnoDB with two scripted `mysql` sessions at the application's real isolation level, reads `SHOW ENGINE INNODB STATUS` and `performance_schema.data_locks`, and picks the fix.",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "fed_by",
      "description": "provides suspect_paths needed here"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-db-postgres-isolation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-idempotency-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs mysql_anomaly_report consumed by race-findings-consolidate"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
