{
  "name": "rtl-hw-noise-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "realtime-linux",
    "hwlat",
    "osnoise",
    "smi"
  ],
  "inputs": [
    "kernel_report",
    "test_duration"
  ],
  "outputs": [
    "hw_noise_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure hardware and firmware induced latency (SMIs, NMIs, platform stalls) with hwlatdetect, rtla hwnoise and rtla osnoise.",
  "related_flows": [
    {
      "flow_name": "rtl-kernel-rt-check",
      "relationship": "fed_by",
      "description": "provides kernel_report needed here"
    },
    {
      "flow_name": "rtl-cyclictest-histogram-read",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "rtl-cyclictest-baseline",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "rtl-power-cstate-tuning",
      "relationship": "feeds_into",
      "description": "outputs hw_noise_report consumed by rtl-power-cstate-tuning"
    },
    {
      "flow_name": "rtl-rtla-timerlat",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "rtl-cpu-isolation-bootargs",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rtl-cpuset-partition",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rtl-irq-affinity",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
