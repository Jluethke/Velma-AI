{
  "name": "srf-go-api-snapshot-apidiff",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "refactoring",
    "go",
    "apidiff",
    "public-api",
    "api-snapshot"
  ],
  "inputs": [
    "repo_path",
    "go_packages",
    "baseline_commit"
  ],
  "outputs": [
    "api_snapshot",
    "api_check_command"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write baseline export data for Go packages with apidiff -w and rerun apidiff -incompatible after each step to catch exported API changes.",
  "related_flows": [
    {
      "flow_name": "srf-baseline-green-check",
      "relationship": "fed_by",
      "description": "provides baseline_commit needed here"
    },
    {
      "flow_name": "srf-go-golden-master-tests",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "srf-go-dead-code-deadcode",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "srf-go-rename-gopls",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "srf-go-inline-call-gopls",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "srf-go-rewrite-gofmt-r",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "srf-verify-step-history",
      "relationship": "feeds_into",
      "description": "outputs api_check_command consumed by srf-verify-step-history"
    }
  ]
}
