{
  "name": "perc-py-ultralytics-finetune",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "perception",
    "python",
    "ultralytics",
    "yolo",
    "training"
  ],
  "inputs": [
    "training_plan",
    "train_annotations",
    "val_annotations",
    "dataset_dir"
  ],
  "outputs": [
    "trained_checkpoint",
    "training_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Convert COCO splits to the YOLO layout, run each planned fine-tune with the yolo CLI, and select the best run by validation mAP.",
  "related_flows": [
    {
      "flow_name": "perc-label-format-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perc-kitti-to-coco-convert",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perc-holdout-split-by-sequence",
      "relationship": "fed_by",
      "description": "provides val_annotations, train_annotations needed here"
    },
    {
      "flow_name": "perc-train-vs-finetune-decision",
      "relationship": "fed_by",
      "description": "provides training_plan needed here"
    },
    {
      "flow_name": "perc-onnx-export-verify",
      "relationship": "feeds_into",
      "description": "outputs trained_checkpoint consumed by perc-onnx-export-verify"
    },
    {
      "flow_name": "perc-preprocess-spec-extract",
      "relationship": "feeds_into",
      "description": "outputs trained_checkpoint, training_log consumed by perc-preprocess-spec-extract"
    }
  ]
}
