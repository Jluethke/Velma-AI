{
  "name": "ffr-unleash-setup",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "unleash",
    "admin-api",
    "tokens",
    "self-hosted"
  ],
  "inputs": [
    "flag_spec",
    "provider_choice",
    "repo_path"
  ],
  "outputs": [
    "unleash_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Create one Unleash flag with the correct flag type through the Admin API, issue the right token type per consumer, and verify it through the Client API.",
  "related_flows": [
    {
      "flow_name": "ffr-flag-type-classify",
      "relationship": "fed_by",
      "description": "provides flag_spec needed here"
    },
    {
      "flow_name": "ffr-provider-select",
      "relationship": "fed_by",
      "description": "provides provider_choice needed here"
    },
    {
      "flow_name": "ffr-py-openfeature-wire",
      "relationship": "feeds_into",
      "description": "outputs unleash_config consumed by ffr-py-openfeature-wire"
    },
    {
      "flow_name": "ffr-node-openfeature-wire",
      "relationship": "feeds_into",
      "description": "outputs unleash_config consumed by ffr-node-openfeature-wire"
    },
    {
      "flow_name": "ffr-go-openfeature-wire",
      "relationship": "feeds_into",
      "description": "outputs unleash_config consumed by ffr-go-openfeature-wire"
    },
    {
      "flow_name": "ffr-java-openfeature-wire",
      "relationship": "feeds_into",
      "description": "outputs unleash_config consumed by ffr-java-openfeature-wire"
    },
    {
      "flow_name": "ffr-react-openfeature-wire",
      "relationship": "feeds_into",
      "description": "outputs unleash_config consumed by ffr-react-openfeature-wire"
    }
  ]
}
