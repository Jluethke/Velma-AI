{
  "name": "obs-otel-collector-pipeline",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "observability",
    "opentelemetry",
    "collector",
    "otlp",
    "pipeline"
  ],
  "inputs": [
    "signal_plan",
    "collector_config_path",
    "trace_backend_endpoint"
  ],
  "outputs": [
    "collector_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write and validate an OpenTelemetry Collector config with OTLP receivers, memory_limiter and batch processors, trace and Prometheus exporters, and prove flow with the collector's own counters.",
  "related_flows": [
    {
      "flow_name": "obs-signal-inventory",
      "relationship": "fed_by",
      "description": "provides signal_plan needed here"
    },
    {
      "flow_name": "obs-py-otel-sdk-setup",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "obs-signal-emission-verify",
      "relationship": "feeds_into",
      "description": "outputs collector_config consumed by obs-signal-emission-verify"
    },
    {
      "flow_name": "obs-log-level-policy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "obs-py-structlog-correlation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "obs-node-otel-sdk-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "obs-go-otel-sdk-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "obs-java-otel-agent-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
