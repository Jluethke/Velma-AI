{
  "name": "alog-ed25519-keygen",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "audit-log",
    "ed25519",
    "key-generation",
    "libsodium",
    "signing"
  ],
  "inputs": [
    "log_requirements",
    "key_output_dir"
  ],
  "outputs": [
    "signing_keypair"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Generate an Ed25519 signing keypair for the log, derive a stable key_id from the public key, and set file permissions and a public-key distribution path so verifiers can trust future signatures.",
  "related_flows": [
    {
      "flow_name": "alog-threat-model-requirements",
      "relationship": "fed_by",
      "description": "provides log_requirements needed here"
    },
    {
      "flow_name": "alog-py-ed25519-sign-verify",
      "relationship": "feeds_into",
      "description": "outputs signing_keypair consumed by alog-py-ed25519-sign-verify"
    },
    {
      "flow_name": "alog-node-ed25519-sign-verify",
      "relationship": "feeds_into",
      "description": "outputs signing_keypair consumed by alog-node-ed25519-sign-verify"
    },
    {
      "flow_name": "alog-go-ed25519-sign-verify",
      "relationship": "feeds_into",
      "description": "outputs signing_keypair consumed by alog-go-ed25519-sign-verify"
    },
    {
      "flow_name": "alog-key-storage-rotation",
      "relationship": "feeds_into",
      "description": "outputs signing_keypair consumed by alog-key-storage-rotation"
    },
    {
      "flow_name": "alog-checkpoint-signing",
      "relationship": "feeds_into",
      "description": "outputs signing_keypair consumed by alog-checkpoint-signing"
    }
  ]
}
