{
  "name": "vsim-fault-scenario-library",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "scenario-library",
    "edge-cases",
    "fault-injection",
    "odd",
    "simulation"
  ],
  "inputs": [
    "xosc_file",
    "scenario_check_report",
    "odd_description"
  ],
  "outputs": [
    "scenario_library"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a versioned library of seeded fault and edge-case scenario variants with expected behavior and KPIs.",
  "related_flows": [
    {
      "flow_name": "vsim-openscenario-author",
      "relationship": "fed_by",
      "description": "provides xosc_file needed here"
    },
    {
      "flow_name": "vsim-esmini-scenario-check",
      "relationship": "fed_by",
      "description": "provides scenario_check_report needed here"
    },
    {
      "flow_name": "vsim-scenario-kpis",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "vsim-carla-server-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-carla-sync-mode",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-carla-sensor-rig",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-carla-seed-determinism",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-scenario-runner-exec",
      "relationship": "feeds_into",
      "description": "outputs scenario_library consumed by vsim-scenario-runner-exec"
    }
  ]
}
