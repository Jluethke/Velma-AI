{
  "name": "ctrl-model-fit-from-logs",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "system-identification",
    "scipy",
    "bicycle-model",
    "delay"
  ],
  "inputs": [
    "plant_model",
    "drive_log"
  ],
  "outputs": [
    "model_fit_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Fit steering ratio, offset and delay from a read-only drive log and map where the kinematic model departs from measured yaw rate.",
  "related_flows": [
    {
      "flow_name": "ctrl-spec-intake",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctrl-can-readonly-log",
      "relationship": "fed_by",
      "description": "provides drive_log needed here"
    },
    {
      "flow_name": "ctrl-bicycle-model-py",
      "relationship": "fed_by",
      "description": "provides plant_model needed here"
    },
    {
      "flow_name": "ctrl-actuator-rate-saturation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctrl-longitudinal-feedforward",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctrl-pid-antiwindup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctrl-pid-step-tuning",
      "relationship": "feeds_into",
      "description": "outputs model_fit_report consumed by ctrl-pid-step-tuning"
    },
    {
      "flow_name": "ctrl-tracking-metrics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
