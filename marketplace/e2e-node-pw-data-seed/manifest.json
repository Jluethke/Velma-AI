{
  "name": "e2e-node-pw-data-seed",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "e2e",
    "playwright",
    "test-data",
    "fixtures",
    "isolation"
  ],
  "inputs": [
    "repo_dir",
    "node_fixture_layer",
    "seed_api"
  ],
  "outputs": [
    "node_data_fixtures"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Give every Playwright Node test unique data through fixtures that create records before use and delete them after, and prove isolation with two parallel runs.",
  "related_flows": [
    {
      "flow_name": "e2e-journey-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-runner-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-node-pw-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-selector-policy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-node-pw-fixtures-pom",
      "relationship": "fed_by",
      "description": "provides node_fixture_layer needed here"
    },
    {
      "flow_name": "e2e-node-pw-auth-state",
      "relationship": "feeds_into",
      "description": "outputs node_data_fixtures consumed by e2e-node-pw-auth-state"
    },
    {
      "flow_name": "e2e-mock-vs-real-decide",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "e2e-pw-network-mock",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
