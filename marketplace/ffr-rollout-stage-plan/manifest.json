{
  "name": "ffr-rollout-stage-plan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "progressive-delivery",
    "rollout-plan",
    "dwell-time",
    "rollback"
  ],
  "inputs": [
    "flag_spec",
    "targeting_rules",
    "guardrail_metrics",
    "stage_percentages"
  ],
  "outputs": [
    "rollout_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a stage-by-stage rollout plan with owner-chosen percentages, dwell times derived from guardrail alert windows, runnable go checks, and one tested rollback command.",
  "related_flows": [
    {
      "flow_name": "ffr-otel-flag-telemetry",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-guardrail-metrics",
      "relationship": "fed_by",
      "description": "provides guardrail_metrics needed here"
    },
    {
      "flow_name": "ffr-argo-rollouts-canary",
      "relationship": "feeds_into",
      "description": "outputs rollout_plan consumed by ffr-argo-rollouts-canary"
    },
    {
      "flow_name": "ffr-flagger-canary",
      "relationship": "feeds_into",
      "description": "outputs rollout_plan consumed by ffr-flagger-canary"
    },
    {
      "flow_name": "ffr-canary-mann-whitney-judge",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-auto-rollback-trigger",
      "relationship": "feeds_into",
      "description": "outputs rollout_plan consumed by ffr-auto-rollback-trigger"
    },
    {
      "flow_name": "ffr-kill-switch-drill",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-flag-type-classify",
      "relationship": "fed_by",
      "description": "provides flag_spec needed here"
    }
  ]
}
