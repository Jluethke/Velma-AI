{
  "name": "pcb-power-input-review",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "design-review",
    "power",
    "protection"
  ],
  "inputs": [
    "skidl_source",
    "bom",
    "board_spec",
    "critical_circuits"
  ],
  "outputs": [
    "power_input_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Review power-input protection at worst case against datasheets: reverse polarity, TVS standoff and clamp, and fusing, with PASS or FAIL and the numbers behind each.",
  "related_flows": [
    {
      "flow_name": "pcb-isolation-review",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-interlock-fault-review",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-review-verdict",
      "relationship": "feeds_into",
      "description": "outputs power_input_findings consumed by pcb-review-verdict"
    },
    {
      "flow_name": "hw-critical-circuit-flagging",
      "relationship": "fed_by",
      "description": "provides critical_circuits needed here"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "fed_by",
      "description": "provides board_spec needed here"
    },
    {
      "flow_name": "pcb-stock-sourcing",
      "relationship": "fed_by",
      "description": "provides bom needed here"
    },
    {
      "flow_name": "pcb-skidl-capture",
      "relationship": "fed_by",
      "description": "provides skidl_source needed here"
    }
  ]
}
