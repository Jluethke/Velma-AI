{
  "name": "perf-hotspot-classify",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "performance",
    "hotspots",
    "complexity",
    "classification",
    "profiling"
  ],
  "inputs": [
    "hotspot_list",
    "stack",
    "baseline_results"
  ],
  "outputs": [
    "bottleneck_class",
    "classified_hotspots"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Classify each hotspot as algorithmic, allocation, I/O, contention or other using frame rules and the measured growth exponent, and pick the dominant class.",
  "related_flows": [
    {
      "flow_name": "perf-metric-workload-define",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "perf-bench-env-stabilize",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "perf-bench-baseline-normalize",
      "relationship": "fed_by",
      "description": "provides baseline_results needed here"
    },
    {
      "flow_name": "perf-flame-graph-read",
      "relationship": "fed_by",
      "description": "provides hotspot_list needed here"
    },
    {
      "flow_name": "perf-fix-algorithmic-complexity",
      "relationship": "feeds_into",
      "description": "outputs classified_hotspots consumed by perf-fix-algorithmic-complexity"
    },
    {
      "flow_name": "perf-fix-allocation-reduction",
      "relationship": "feeds_into",
      "description": "outputs classified_hotspots consumed by perf-fix-allocation-reduction"
    },
    {
      "flow_name": "perf-fix-io-batching",
      "relationship": "feeds_into",
      "description": "outputs classified_hotspots consumed by perf-fix-io-batching"
    },
    {
      "flow_name": "perf-one-change-apply",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    }
  ]
}
