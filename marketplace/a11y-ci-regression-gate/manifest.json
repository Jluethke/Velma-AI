{
  "name": "a11y-ci-regression-gate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "ci",
    "github-actions",
    "axe-core",
    "lighthouse-ci"
  ],
  "inputs": [
    "retest_results",
    "page_inventory",
    "site_url",
    "repo_dir"
  ],
  "outputs": [
    "ci_gate_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Adds a CI job that fails a pull request when it introduces new WCAG A or AA violations, using a Playwright plus `@axe-core/playwright` spec over the page inventory with a reviewed baseline of known open issues, an optional pa11y-ci step, and Lighthouse CI assertions on specific audits rather than on a score.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "fed_by",
      "description": "provides page_inventory needed here"
    },
    {
      "flow_name": "a11y-axe-playwright-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-scan-merge-dedupe",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-fix-plan-by-criterion",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-react-fix-and-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-retest-verify",
      "relationship": "fed_by",
      "description": "provides retest_results needed here"
    }
  ]
}
