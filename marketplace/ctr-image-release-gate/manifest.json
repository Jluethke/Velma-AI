{
  "name": "ctr-image-release-gate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "containers",
    "release",
    "gate",
    "verification",
    "supply-chain"
  ],
  "inputs": [
    "image_name",
    "image_test_report",
    "smoke_report",
    "size_report",
    "sbom_file",
    "vuln_triage",
    "repro_report",
    "build_config_report"
  ],
  "outputs": [
    "release_verdict"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Re-check every containerization result against the exact candidate image and return a single PASS or FAIL verdict with owners for each failure.",
  "related_flows": [
    {
      "flow_name": "ctr-build-args-secrets",
      "relationship": "fed_by",
      "description": "provides build_config_report needed here"
    },
    {
      "flow_name": "ctr-test-in-image",
      "relationship": "fed_by",
      "description": "provides image_test_report needed here"
    },
    {
      "flow_name": "ctr-hardened-run-smoke",
      "relationship": "fed_by",
      "description": "provides smoke_report needed here"
    },
    {
      "flow_name": "ctr-image-size-measure",
      "relationship": "fed_by",
      "description": "provides size_report needed here"
    },
    {
      "flow_name": "ctr-syft-sbom",
      "relationship": "fed_by",
      "description": "provides sbom_file needed here"
    },
    {
      "flow_name": "ctr-vuln-triage",
      "relationship": "fed_by",
      "description": "provides vuln_triage needed here"
    },
    {
      "flow_name": "ctr-reproducible-build",
      "relationship": "fed_by",
      "description": "provides repro_report needed here"
    }
  ]
}
