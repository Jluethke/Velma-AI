{
    "name": "ctr-image-release-gate",
    "version": "1.0.0",
    "domain": "engineering",
    "tags": [
        "containers",
        "release",
        "gate",
        "verification",
        "supply-chain"
    ],
    "inputs": [
        "image_name",
        "image_test_report",
        "smoke_report",
        "size_report",
        "sbom_file",
        "vuln_triage",
        "repro_report",
        "build_config_report"
    ],
    "outputs": [
        "release_verdict"
    ],
    "execution_pattern": "phase_pipeline",
    "price": "0",
    "license": "OPEN",
    "description": "Re-check every containerization result against the exact candidate image and return a single PASS or FAIL verdict with owners for each failure."
