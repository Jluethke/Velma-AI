      "flow_name": "tkt-review-comment-response",
      "relationship": "fed_by",
      "description": "provides review_resolution needed here"
    },
    {
      "flow_name": "tkt-sync-strategy-choose",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-rebase-conflict-resolve",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-merge-conflict-resolve",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-acceptance-criteria-gwt",
      "relationship": "fed_by",
      "description": "provides acceptance_criteria needed here"
    },
    {
      "flow_name": "tkt-pr-description",
      "relationship": "fed_by",
      "description": "provides pr_url needed here"
    }
