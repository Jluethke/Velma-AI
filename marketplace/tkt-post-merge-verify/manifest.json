{
  "name": "tkt-post-merge-verify",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "post-merge",
    "verification",
    "deployment",
    "ci"
  ],
  "inputs": [
    "pr_url",
    "base_branch",
    "acceptance_criteria",
    "ticket_id",
    "ci_status",
    "review_resolution"
  ],
  "outputs": [
    "post_merge_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
