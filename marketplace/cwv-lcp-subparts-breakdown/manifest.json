{
  "name": "cwv-lcp-subparts-breakdown",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "web-performance",
    "lcp",
    "subparts",
    "devtools"
  ],
  "inputs": [
    "page_urls",
    "diagnosis_plan",
    "lab_lcp_element",
    "rum_p75_report"
  ],
  "outputs": [
    "lcp_subparts",
    "lcp_bottleneck"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Split LCP into TTFB, resource load delay, resource load duration and element render delay from lab and field sources and name the sub-part that dominates.",
  "related_flows": [
    {
      "flow_name": "cwv-field-crux-baseline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cwv-lab-lighthouse-run",
      "relationship": "fed_by",
      "description": "provides lab_lcp_element needed here"
    },
    {
      "flow_name": "cwv-lcp-ttfb-reduce",
      "relationship": "feeds_into",
      "description": "outputs lcp_subparts, lcp_bottleneck consumed by cwv-lcp-ttfb-reduce"
    },
    {
      "flow_name": "cwv-cache-headers-cdn",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cwv-lcp-priority-hints",
      "relationship": "feeds_into",
      "description": "outputs lcp_bottleneck consumed by cwv-lcp-priority-hints"
    },
    {
      "flow_name": "cwv-nextjs-image-font",
      "relationship": "feeds_into",
      "description": "outputs lcp_bottleneck consumed by cwv-nextjs-image-font"
    },
    {
      "flow_name": "cwv-image-encode-responsive",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "cwv-font-loading-subset",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
