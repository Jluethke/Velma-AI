{
  "name": "enc-board-3d-export",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "enclosure",
    "mechanical",
    "step",
    "kicad",
    "pcb"
  ],
  "inputs": [
    "kicad_pcb",
    "bom",
    "project_dir"
  ],
  "outputs": [
    "board_step",
    "board_envelope"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Export a board as STEP and extract the geometry an enclosure must fit: outline, holes, heights per side, connector positions with mating faces, and indicator positions.",
  "related_flows": [
    {
      "flow_name": "enc-parametric-model",
      "relationship": "feeds_into",
      "description": "outputs board_envelope consumed by enc-parametric-model"
    },
    {
      "flow_name": "enc-fit-check",
      "relationship": "feeds_into",
      "description": "outputs board_envelope, board_step consumed by enc-fit-check"
    },
    {
      "flow_name": "enc-manufacturing-export",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-stock-sourcing",
      "relationship": "fed_by",
      "description": "provides bom needed here"
    },
    {
      "flow_name": "pcb-drc-closure",
      "relationship": "fed_by",
      "description": "provides kicad_pcb needed here"
    }
  ]
}
