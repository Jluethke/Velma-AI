{
  "name": "flk-tz-locale-matrix-detect",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "flaky-tests",
    "timezone",
    "locale",
    "clock"
  ],
  "inputs": [
    "flake_evidence",
    "stack",
    "repo_path"
  ],
  "outputs": [
    "tz_matrix_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run a flaky test under a matrix of TZ and locale values chosen to cross date boundaries, half-hour offsets and DST, to expose clock and locale dependence.",
  "related_flows": [
    {
      "flow_name": "flk-flake-evidence-intake",
      "relationship": "fed_by",
      "description": "provides flake_evidence needed here"
    },
    {
      "flow_name": "flk-run-count-derive",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-classify-root-cause",
      "relationship": "feeds_into",
      "description": "outputs tz_matrix_report consumed by flk-classify-root-cause"
    },
    {
      "flow_name": "flk-random-seed-pin",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-network-stub-isolate",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-verify-same-count",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-ci-shuffle-guard",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-py-repeat-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
