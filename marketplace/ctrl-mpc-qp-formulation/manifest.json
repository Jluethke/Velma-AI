    },
    {
      "flow_name": "ctrl-speed-profile-jerk-limited",
      "relationship": "fed_by",
      "description": "provides reference_trajectory needed here"
    },
    {
      "flow_name": "ctrl-actuator-rate-saturation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ctrl-mpc-osqp-py",
      "relationship": "feeds_into",
