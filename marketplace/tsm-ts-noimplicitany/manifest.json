      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-type-coverage",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-strictnullchecks",
      "relationship": "feeds_into",
      "description": "outputs ts_noimplicitany_result consumed by tsm-ts-strictnullchecks"
    },
    {
      "flow_name": "tsm-ts-strict-family-flags",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-eliminate-any",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-ci-gate",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tsm-ts-conversion-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
