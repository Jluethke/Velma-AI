{
  "name": "tsm-ts-noimplicitany",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "typescript",
    "noimplicitany",
    "tsconfig",
    "strict"
  ],
  "inputs": [
    "repo_path",
    "ts_converted_files"
  ],
  "outputs": [
    "ts_noimplicitany_result"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
