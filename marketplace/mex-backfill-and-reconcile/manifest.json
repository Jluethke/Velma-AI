{
  "name": "mex-backfill-and-reconcile",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "monolith-decomposition",
    "backfill",
    "reconciliation",
    "checksum",
    "data-migration"
  ],
  "inputs": [
    "schema_split_plan",
    "sync_strategy",
    "database_engine",
    "outbox_implementation",
    "pg_cdc_pipeline",
    "mysql_cdc_pipeline"
  ],
  "outputs": [
    "reconciliation_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Backfill history in resumable keyset batches and prove both stores agree with counts and per-range checksums bisected to differing rows.",
  "related_flows": [
    {
      "flow_name": "mex-schema-ownership-split",
      "relationship": "fed_by",
      "description": "provides schema_split_plan needed here"
    },
    {
      "flow_name": "mex-dual-write-or-cdc-decision",
      "relationship": "fed_by",
      "description": "provides sync_strategy needed here"
    },
    {
      "flow_name": "mex-transactional-outbox",
      "relationship": "fed_by",
      "description": "provides outbox_implementation needed here"
    },
    {
      "flow_name": "mex-cdc-debezium-postgres",
      "relationship": "fed_by",
      "description": "provides pg_cdc_pipeline needed here"
    },
    {
      "flow_name": "mex-cdc-debezium-mysql",
      "relationship": "fed_by",
      "description": "provides mysql_cdc_pipeline needed here"
    },
    {
      "flow_name": "mex-flag-cutover",
      "relationship": "feeds_into",
      "description": "outputs reconciliation_report consumed by mex-flag-cutover"
    }
  ]
}
