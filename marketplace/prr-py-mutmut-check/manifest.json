{
  "name": "prr-py-mutmut-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "python",
    "mutation-testing",
    "mutmut",
    "testing"
  ],
  "inputs": [
    "repo_dir",
    "changed_files",
    "findings_dir"
  ],
  "outputs": [
    "mutation_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run mutmut on the PR's changed Python modules in an isolated worktree and turn surviving mutants on changed lines into findings with the test that kills them.",
  "related_flows": [
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides changed_files needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-correctness-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-py-static-checks",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-test-revert-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-py-diff-coverage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
