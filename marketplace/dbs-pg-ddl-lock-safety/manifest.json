{
  "name": "dbs-pg-ddl-lock-safety",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "database",
    "postgresql",
    "ddl",
    "locks",
    "zero-downtime"
  ],
  "inputs": [
    "migration_plan",
    "repo_path",
    "db_version"
  ],
  "outputs": [
    "lock_review"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Classify every PostgreSQL migration statement by lock mode and rewrite risk, apply the online recipe and lock_timeout, and prove fail-fast and no-rewrite on scratch.",
  "related_flows": [
    {
      "flow_name": "dbs-expand-contract-plan",
      "relationship": "fed_by",
      "description": "provides migration_plan needed here"
    },
    {
      "flow_name": "dbs-pg-squawk-lint",
      "relationship": "feeds_into",
      "description": "outputs lock_review consumed by dbs-pg-squawk-lint"
    },
    {
      "flow_name": "dbs-rollback-plan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-pg-batched-backfill",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "dbs-post-migration-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
