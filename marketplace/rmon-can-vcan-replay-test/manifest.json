{
  "name": "rmon-can-vcan-replay-test",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can",
    "socketcan",
    "can-utils",
    "vcan",
    "replay"
  ],
  "inputs": [
    "fault_injection_plan",
    "can_log",
    "dbc_file"
  ],
  "outputs": [
    "can_replay_results"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
