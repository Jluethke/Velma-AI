{
  "name": "etl-target-schema-contract",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "etl",
    "data-contract",
    "schema",
    "yaml"
  ],
  "inputs": [
    "source_profile",
    "extraction_keys",
    "consumer_requirements"
  ],
  "outputs": [
    "data_contract"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write the target table's YAML data contract (grain, key, types, nullability, accepted values, freshness, owner) from the measured profile and consumer needs.",
  "related_flows": [
    {
      "flow_name": "etl-source-profile-sql",
      "relationship": "fed_by",
      "description": "provides source_profile needed here"
    },
    {
      "flow_name": "etl-source-key-watermark-discovery",
      "relationship": "fed_by",
      "description": "provides extraction_keys needed here"
    },
    {
      "flow_name": "etl-freshness-failure-alerts",
      "relationship": "feeds_into",
      "description": "outputs data_contract consumed by etl-freshness-failure-alerts"
    },
    {
      "flow_name": "etl-late-arriving-data-policy",
      "relationship": "feeds_into",
      "description": "outputs data_contract consumed by etl-late-arriving-data-policy"
    },
    {
      "flow_name": "etl-extract-watermark-incremental",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "etl-cdc-debezium-postgres",
      "relationship": "feeds_into",
      "description": "outputs data_contract consumed by etl-cdc-debezium-postgres"
    },
    {
      "flow_name": "etl-cdc-debezium-mysql",
      "relationship": "feeds_into",
      "description": "outputs data_contract consumed by etl-cdc-debezium-mysql"
    },
    {
      "flow_name": "etl-cdc-merge-apply",
      "relationship": "feeds_into",
      "description": "outputs data_contract consumed by etl-cdc-merge-apply"
    }
  ]
}
