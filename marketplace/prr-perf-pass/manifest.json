{
  "name": "prr-perf-pass",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "performance",
    "n-plus-one",
    "async",
    "database"
  ],
  "inputs": [
    "diff_file",
    "reading_plan",
    "findings_dir",
    "database"
  ],
  "outputs": [
    "perf_findings",
    "new_queries"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Check changed code for N+1 queries, unbounded reads, quadratic loops, blocking async calls and unbounded caches, and extract every new query for plan review.",
  "related_flows": [
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides diff_file needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "fed_by",
      "description": "provides reading_plan needed here"
    },
    {
      "flow_name": "prr-pg-explain-new-queries",
      "relationship": "feeds_into",
      "description": "outputs new_queries consumed by prr-pg-explain-new-queries"
    },
    {
      "flow_name": "prr-pg-migration-lock-review",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-concurrency-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-severity-comments",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
