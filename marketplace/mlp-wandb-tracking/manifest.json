{
  "name": "mlp-wandb-tracking",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "weights-and-biases",
    "experiment-tracking"
  ],
  "inputs": [
    "repo_path",
    "wandb_project",
    "data_version",
    "sklearn_determinism",
    "torch_determinism"
  ],
  "outputs": [
    "wandb_run_ref"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Logs every training run to Weights & Biases with its config, seed and determinism record, DVC data hashes as a dataset artifact reference, per-step and per-fold metrics, and the git state, so any reported number traces to one run.",
  "related_flows": [
    {
      "flow_name": "mlp-torch-seed-determinism",
      "relationship": "fed_by",
      "description": "provides torch_determinism needed here"
    },
    {
      "flow_name": "mlp-optuna-search",
      "relationship": "feeds_into",
      "description": "outputs wandb_run_ref consumed by mlp-optuna-search"
    },
    {
      "flow_name": "mlp-bootstrap-metric-ci",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-calibration-diagnose",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-torch-temperature-scaling",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-torch-onnx-export",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-inference-parity-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-dvc-version-raw-data",
      "relationship": "fed_by",
      "description": "provides data_version needed here"
    }
  ]
}
