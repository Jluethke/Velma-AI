{
    "name": "flk-quarantine-release",
    "version": "1.0.0",
    "domain": "engineering",
    "tags": [
        "flaky-tests",
        "quarantine",
        "ci"
    ],
    "inputs": [
        "quarantine_record",
        "verification_verdict",
        "post_fix_rate_report",
        "repo_path"
    ],
    "outputs": [
        "release_diff"
    ],
    "execution_pattern": "phase_pipeline",
    "price": "0",
    "license": "OPEN",
    "description": "Return a fixed test from quarantine to the blocking CI job only after a PASS verdict, and close its tracking issue with the evidence."
}
