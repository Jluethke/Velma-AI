      "description": "provides bom needed here"
    },
    {
      "flow_name": "pcb-skidl-capture",
      "relationship": "fed_by",
      "description": "provides skidl_source needed here"
    },
    {
      "flow_name": "pcb-board-setup",
      "relationship": "feeds_into",
      "description": "outputs netlist consumed by pcb-board-setup"
    },
    {
      "flow_name": "fw-pin-map",
      "relationship": "feeds_into",
      "description": "outputs netlist consumed by fw-pin-map"
    },
    {
      "flow_name": "harness-pinout-wiring",
      "relationship": "feeds_into",
      "description": "outputs netlist consumed by harness-pinout-wiring"
    }
  ]
}
