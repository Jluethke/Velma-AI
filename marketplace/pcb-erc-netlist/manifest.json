{
  "name": "pcb-erc-netlist",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "erc",
    "netlist",
    "skidl"
  ],
  "inputs": [
    "skidl_source",
    "bom"
  ],
  "outputs": [
    "netlist",
    "erc_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
