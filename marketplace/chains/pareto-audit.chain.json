{
  "name": "pareto-audit",
  "description": "Run a Pareto audit on any system: find the 20% of inputs producing 80% of outputs, then reallocate resources from the unproductive 80% to the productive 20%. Works for revenue, time, relationships, features, and customers.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "input-output-data-collection",
      "inputs": {
        "system-to-audit": "from_user_input",
        "time-period": "from_user_input"
      },
      "outputs": {
        "input-output-data": "input-output-data",
        "total-output": "total-output"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "pareto-distribution-analysis",
      "inputs": {
        "input-output-data": "step_1.input-output-data",
        "total-output": "step_1.total-output"
      },
      "outputs": {
        "pareto-curve": "pareto-curve",
        "pareto-ratio": "pareto-ratio"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "vital-few-deep-dive",
      "inputs": {
        "pareto-curve": "step_2.pareto-curve",
        "pareto-ratio": "step_2.pareto-ratio"
      },
      "outputs": {
        "vital-few-profile": "vital-few-profile",
        "replication-strategy": "replication-strategy"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "trivial-many-triage",
      "inputs": {
        "vital-few-profile": "step_3.vital-few-profile",
        "input-output-data": "step_1.input-output-data"
      },
      "outputs": {
        "cut-list": "cut-list",
        "maintain-list": "maintain-list",
        "upgrade-candidates": "upgrade-candidates"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "resource-reallocation-plan",
      "inputs": {
        "vital-few": "from_context.vital-few",
        "trivial-many": "from_context.trivial-many"
      },
      "outputs": {
        "reallocation-plan": "reallocation-plan",
        "expected-impact": "expected-impact"
      },
      "parallel_group": 5
    }
  ],
