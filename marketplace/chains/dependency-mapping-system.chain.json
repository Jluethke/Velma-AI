{
  "name": "dependency-mapping-system",
  "description": "Map every critical dependency (people, systems, vendors, resources) that your operation cannot function without. For each: what happens if it fails, how long until impact, what is the workaround. Single dependencies with no workaround are the highest-priority risks. An untested workaround is not a workaround.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "critical-function-inventory",
      "inputs": {
        "operation-description": "from_user_input",
        "tolerable-downtime": "from_user_input"
      },
      "outputs": {
        "critical-function-list": "critical-function-list",
        "non-critical-functions": "non-critical-functions"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "dependency-tree-builder",
      "inputs": {
        "critical-function-list": "step_1.critical-function-list",
        "operation-description": "from_context.operation-description"
      },
      "outputs": {
        "dependency-tree": "dependency-tree",
        "single-dependency-list": "single-dependency-list"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "failure-impact-estimator",
      "inputs": {
        "single-dependency-list": "step_2.single-dependency-list",
        "critical-function-list": "step_1.critical-function-list"
      },
      "outputs": {
        "failure-impact-table": "failure-impact-table",
        "most-fragile-dependencies": "most-fragile-dependencies"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "workaround-designer",
      "inputs": {
        "most-fragile-dependencies": "step_3.most-fragile-dependencies",
        "dependency-tree": "step_2.dependency-tree"
      },
      "outputs": {
        "workaround-plans": "workaround-plans",
        "workaround-gaps": "workaround-gaps"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "workaround-test-runner",
      "inputs": {
        "workaround-plans": "step_4.workaround-plans",
        "critical-function-list": "step_1.critical-function-list"
      },
      "outputs": {
        "test-results": "test-results",
        "revised-workaround-plans": "revised-workaround-plans"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "dependency-map-document",
      "inputs": {
        "dependency-tree": "step_2.dependency-tree",
        "revised-workaround-plans": "step_5.revised-workaround-plans"
      },
      "outputs": {
        "dependency-map-document": "dependency-map-document",
        "crisis-quick-reference": "crisis-quick-reference"
      },
      "parallel_group": 6
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
