{
  "name": "database-hardening-protocol",
  "description": "Harden a database server by applying patches, restricting access, enabling encryption, and configuring audit logging.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "database-patch-applier",
      "inputs": {
        "database-type": "from_user_input",
        "current-patch-level": "from_user_input"
      },
      "outputs": {
        "patch-report": "patch-report",
        "updated-version": "updated-version"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "database-default-remover",
      "inputs": {
        "database-type": "from_context.database-type",
        "updated-version": "step_1.updated-version"
      },
      "outputs": {
        "removed-defaults": "removed-defaults",
        "remaining-objects": "remaining-objects"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "database-access-configurator",
      "inputs": {
        "database-type": "from_context.database-type",
        "remaining-objects": "step_2.remaining-objects"
      },
      "outputs": {
        "access-config": "access-config",
        "privilege-matrix": "privilege-matrix"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "database-encryption-enabler",
      "inputs": {
        "database-type": "from_context.database-type",
        "access-config": "step_3.access-config"
      },
      "outputs": {
        "encryption-config": "encryption-config",
        "certificate-info": "certificate-info"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "database-audit-logger",
      "inputs": {
        "database-type": "from_context.database-type",
        "privilege-matrix": "step_3.privilege-matrix"
      },
      "outputs": {
        "audit-config": "audit-config",
        "audit-test-results": "audit-test-results"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "database-network-restrictor",
      "inputs": {
        "database-type": "from_context.database-type",
        "access-config": "step_3.access-config"
      },
      "outputs": {
        "network-config": "network-config",
        "connectivity-test": "connectivity-test"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "database-hardening-reporter",
      "inputs": {
        "database-type": "from_context.database-type",
        "patch-report": "step_1.patch-report"
      },
      "outputs": {
        "hardening-report": "hardening-report",
        "compliance-status": "compliance-status"
      },
      "parallel_group": 7
    }
  ],
