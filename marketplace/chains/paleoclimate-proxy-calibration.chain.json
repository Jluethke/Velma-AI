{
  "name": "paleoclimate-proxy-calibration",
  "description": "Calibrate a paleoclimate proxy from modern calibration data through transfer function construction, validation, fossil record application, and uncertainty estimation to a paleoclimate reconstruction.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "proxy-calibration-collector",
      "inputs": {
        "modern-proxy-data": "from_user_input",
        "instrumental-climate": "from_user_input"
      },
      "outputs": {
        "calibration-dataset": "calibration-dataset",
        "data-coverage-summary": "data-coverage-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "transfer-function-builder",
      "inputs": {
        "calibration-dataset": "step_1.calibration-dataset",
        "method-choice": "from_context.method-choice"
      },
      "outputs": {
        "transfer-function": "transfer-function",
        "calibration-statistics": "calibration-statistics"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "proxy-validation-tester",
      "inputs": {
        "transfer-function": "step_2.transfer-function",
        "calibration-dataset": "step_1.calibration-dataset"
      },
      "outputs": {
        "validation-results": "validation-results",
        "residual-diagnostics": "residual-diagnostics"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "fossil-record-applicator",
      "inputs": {
        "transfer-function": "step_2.transfer-function",
        "fossil-proxy-data": "from_context.fossil-proxy-data"
      },
      "outputs": {
        "climate-reconstruction": "climate-reconstruction",
        "analogue-quality": "analogue-quality"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "reconstruction-uncertainty-estimator",
      "inputs": {
        "climate-reconstruction": "step_4.climate-reconstruction",
        "calibration-statistics": "step_2.calibration-statistics",
        "analogue-quality": "step_4.analogue-quality"
      },
      "outputs": {
        "uncertainty-envelope": "uncertainty-envelope",
        "uncertainty-decomposition": "uncertainty-decomposition"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "paleoclimate-report-generator",
      "inputs": {
        "climate-reconstruction": "step_4.climate-reconstruction",
        "validation-results": "step_3.validation-results",
        "uncertainty-decomposition": "step_5.uncertainty-decomposition"
      },
      "outputs": {
        "paleoclimate-report": "paleoclimate-report",
        "reconstruction-data": "reconstruction-data"
      },
      "parallel_group": 6
    }
