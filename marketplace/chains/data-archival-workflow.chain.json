{
  "name": "data-archival-workflow",
  "description": "Archive old data from active systems: define criteria, identify records, export to archive storage, verify integrity, remove from active, and produce the archival record.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "archival-criteria-definer",
      "inputs": {
        "system-description": "from_user_input",
        "retention-requirements": "from_user_input"
      },
      "outputs": {
        "archival-criteria": "archival-criteria",
        "exclusion-rules": "exclusion-rules"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "archival-record-identifier",
      "inputs": {
        "archival-criteria": "step_1.archival-criteria",
        "exclusion-rules": "step_1.exclusion-rules"
      },
      "outputs": {
        "archival-candidate-list": "archival-candidate-list",
        "archival-size-estimate": "archival-size-estimate"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "archival-export-runner",
      "inputs": {
        "archival-candidate-list": "step_2.archival-candidate-list",
        "archival-size-estimate": "step_2.archival-size-estimate"
      },
      "outputs": {
        "archive-location": "archive-location",
        "export-manifest": "export-manifest"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "archival-integrity-verifier",
      "inputs": {
        "archive-location": "step_3.archive-location",
        "export-manifest": "step_3.export-manifest"
      },
      "outputs": {
        "integrity-results": "integrity-results",
        "removal-authorization": "removal-authorization"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "archival-active-removal",
      "inputs": {
        "removal-authorization": "step_4.removal-authorization",
        "integrity-results": "step_4.integrity-results"
      },
      "outputs": {
        "removal-log": "removal-log",
        "archival-record": "archival-record"
      },
      "parallel_group": 5
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
