{
  "name": "cloud-infrastructure-audit",
  "description": "Audit cloud infrastructure security across IAM, networking, storage, logging, and compliance with CIS benchmarks.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "cloud-resource-inventory",
      "inputs": {
        "cloud-account-access": "from_user_input",
        "cloud-provider": "from_user_input"
      },
      "outputs": {
        "resource-inventory": "resource-inventory",
        "resource-tags": "resource-tags"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "iam-policy-audit",
      "inputs": {
        "resource-inventory": "step_1.resource-inventory",
        "cloud-provider": "from_context.cloud-provider"
      },
      "outputs": {
        "iam-findings": "iam-findings",
        "unused-credentials": "unused-credentials"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "network-segmentation-audit",
      "inputs": {
        "resource-inventory": "step_1.resource-inventory",
        "iam-findings": "step_2.iam-findings"
      },
      "outputs": {
        "network-findings": "network-findings",
        "open-ports-report": "open-ports-report"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cloud-storage-permissions-check",
      "inputs": {
        "resource-inventory": "step_1.resource-inventory",
        "network-findings": "step_3.network-findings"
      },
      "outputs": {
        "storage-findings": "storage-findings",
        "sensitive-data-exposure": "sensitive-data-exposure"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "cloud-logging-review",
      "inputs": {
        "resource-inventory": "step_1.resource-inventory",
        "storage-findings": "step_4.storage-findings"
      },
      "outputs": {
        "logging-gaps": "logging-gaps",
        "monitoring-assessment": "monitoring-assessment"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "cis-benchmark-testing",
      "inputs": {
        "iam-findings": "step_2.iam-findings",
        "network-findings": "step_3.network-findings",
        "logging-gaps": "step_5.logging-gaps"
      },
      "outputs": {
        "benchmark-results": "benchmark-results",
        "compliance-score": "compliance-score"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "cloud-security-report",
      "inputs": {
        "benchmark-results": "step_6.benchmark-results",
        "compliance-score": "step_6.compliance-score"
      },
      "outputs": {
        "cloud-audit-report": "cloud-audit-report",
        "remediation-roadmap": "remediation-roadmap"
      },
      "parallel_group": 7
    }
  ],
