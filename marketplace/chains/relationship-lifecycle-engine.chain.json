        "relationship-context": "from_user_input",
        "contact-inventory-sample": "from_user_input"
      },
      "outputs": {
        "stage-definitions": "stage-definitions",
        "stage-indicators": "stage-indicators"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "transition-signal-mapper",
