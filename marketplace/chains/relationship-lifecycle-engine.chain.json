      },
      "outputs": {
        "upward-transitions": "upward-transitions",
        "downward-transitions": "downward-transitions"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "decay-rule-calibrator",
      "inputs": {
        "upward-transitions": "step_2.upward-transitions",
        "downward-transitions": "step_2.downward-transitions"
      },
      "outputs": {
        "decay-schedule": "decay-schedule",
        "decay-modifiers": "decay-modifiers"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "re-engagement-trigger-designer",
      "inputs": {
        "decay-schedule": "step_3.decay-schedule",
        "decay-modifiers": "step_3.decay-modifiers"
      },
      "outputs": {
        "trigger-rules": "trigger-rules",
        "re-engagement-actions": "re-engagement-actions"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "lifecycle-field-mapping",
      "inputs": {
        "trigger-rules": "step_4.trigger-rules",
