{
  "name": "enzyme-kinetics-characterization",
  "description": "Characterize an enzyme's kinetics: collect initial rate data, fit the Michaelis-Menten model, determine Km and Vmax, identify inhibition type, test for cooperativity, and produce the kinetic profile.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "initial-rate-extractor",
      "inputs": {
        "progress-curves": "from_user_input",
        "assay-conditions": "from_user_input"
      },
      "outputs": {
        "rate-table": "rate-table",
        "linearity-report": "linearity-report"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "michaelis-menten-fitter",
      "inputs": {
        "velocity-data": "from_context.velocity-data"
      },
      "outputs": {
        "km-vmax": "km-vmax",
        "fit-quality": "fit-quality"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "inhibition-type-identifier",
      "inputs": {
        "rate-table": "step_1.rate-table",
        "mm-parameters": "from_context.mm-parameters"
      },
      "outputs": {
        "inhibition-type": "inhibition-type",
        "inhibition-evidence": "inhibition-evidence"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cooperativity-tester",
      "inputs": {
        "specific-binding": "from_context.specific-binding",
        "fit-results": "from_context.fit-results"
      },
      "outputs": {
        "cooperativity-assessment": "cooperativity-assessment",
        "scatchard-plot": "scatchard-plot"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "kinetic-profile-compiler",
      "inputs": {
        "mm-parameters": "from_context.mm-parameters",
        "inhibition-type": "step_3.inhibition-type",
        "hill-parameters": "from_context.hill-parameters"
      },
      "outputs": {
        "kinetic-profile": "kinetic-profile",
        "comparison-table": "comparison-table"
      },
      "parallel_group": 5
    }
  ],
