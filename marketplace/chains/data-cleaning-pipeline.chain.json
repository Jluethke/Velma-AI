{
  "name": "data-cleaning-pipeline",
  "description": "Clean raw research data for analysis: profile the dataset, handle missing values, treat outliers, check distributions, reconcile coding, document all transformations, and produce an analysis-ready dataset.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "dataset-profiler",
      "inputs": {
        "dataset_description": "from_user_input",
        "domain_context": "from_user_input"
      },
      "outputs": {
        "dataset_profile": "dataset_profile"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "missing-value-handler",
      "inputs": {
        "raw-dataset": "from_context.raw-dataset",
        "quality-flags": "from_context.quality-flags"
      },
      "outputs": {
        "missingness-analysis": "missingness-analysis",
        "imputed-dataset": "imputed-dataset"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "outlier-treatment-engine",
      "inputs": {
        "imputed-dataset": "step_2.imputed-dataset",
        "codebook": "from_context.codebook"
      },
      "outputs": {
        "outlier-catalog": "outlier-catalog",
        "treated-dataset": "treated-dataset"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "distribution-checker",
      "inputs": {
        "treated-dataset": "step_3.treated-dataset",
        "analysis-plan": "from_context.analysis-plan"
      },
      "outputs": {
        "assumption-check-report": "assumption-check-report",
        "transformation-recommendations": "transformation-recommendations"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "coding-reconciler",
      "inputs": {
        "treated-dataset": "step_3.treated-dataset",
        "codebook": "from_context.codebook"
      },
      "outputs": {
        "reconciled-dataset": "reconciled-dataset",
        "reconciliation-log": "reconciliation-log"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "transformation-audit-logger",
      "inputs": {
        "reconciled-dataset": "step_5.reconciled-dataset",
        "reconciliation-log": "step_5.reconciliation-log",
        "missingness-analysis": "step_2.missingness-analysis",
        "outlier-catalog": "step_3.outlier-catalog"
      },
      "outputs": {
        "analysis-ready-dataset": "analysis-ready-dataset",
        "cleaning-audit-trail": "cleaning-audit-trail"
      },
      "parallel_group": 6
    }
  ],
