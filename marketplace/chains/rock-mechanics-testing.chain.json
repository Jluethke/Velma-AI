{
  "name": "rock-mechanics-testing",
  "description": "Analyze rock mechanics test data from stress-strain import through strength determination, failure envelope construction, and rock mass classification to a geomechanics report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "rock-stress-strain-importer",
      "inputs": {
        "test-data-files": "from_user_input",
        "specimen-log": "from_user_input"
      },
      "outputs": {
        "stress-strain-data": "stress-strain-data",
        "specimen-metadata": "specimen-metadata"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "ucs-modulus-calculator",
      "inputs": {
        "stress-strain-data": "step_1.stress-strain-data",
        "specimen-metadata": "step_1.specimen-metadata"
      },
      "outputs": {
        "ucs-values": "ucs-values",
        "elastic-properties": "elastic-properties"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "mohr-coulomb-constructor",
      "inputs": {
        "stress-strain-data": "step_1.stress-strain-data",
        "ucs-values": "step_2.ucs-values"
      },
      "outputs": {
        "mohr-circles": "mohr-circles",
        "failure-envelope-fit": "failure-envelope-fit"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cohesion-friction-computer",
      "inputs": {
        "failure-envelope-fit": "step_3.failure-envelope-fit",
        "mohr-circles": "step_3.mohr-circles"
      },
      "outputs": {
        "strength-parameters": "strength-parameters",
        "parameter-comparison": "parameter-comparison"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "rock-mass-classifier",
      "inputs": {
        "ucs-values": "step_2.ucs-values",
        "field-observations": "from_context.field-observations"
      },
      "outputs": {
        "rmr-rating": "rmr-rating",
        "q-value": "q-value"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "geomechanics-report-generator",
      "inputs": {
        "strength-parameters": "step_4.strength-parameters",
        "rmr-rating": "step_5.rmr-rating",
        "elastic-properties": "step_2.elastic-properties"
      },
      "outputs": {
        "geomechanics-report": "geomechanics-report",
        "test-data-archive": "test-data-archive"
      },
      "parallel_group": 6
    }
  ],
