{
  "name": "gravity-survey-analysis",
  "description": "Reduce and interpret gravity survey data from raw readings through Bouguer anomaly computation, regional-residual separation, forward modeling, and inversion to produce a subsurface density interpretation.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "gravity-raw-reduction",
      "inputs": {
        "raw-gravity-readings": "from_user_input",
        "base-station-ties": "from_user_input",
        "station-elevations": "from_user_input"
      },
      "outputs": {
        "reduced-gravity-values": "reduced-gravity-values",
        "reduction-log": "reduction-log"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "bouguer-anomaly-computation",
      "inputs": {
        "reduced-gravity-values": "step_1.reduced-gravity-values",
        "terrain-model": "from_context.terrain-model"
      },
      "outputs": {
        "bouguer-anomaly-map": "bouguer-anomaly-map",
        "terrain-correction-values": "terrain-correction-values"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "regional-residual-separation",
      "inputs": {
        "bouguer-anomaly-map": "step_2.bouguer-anomaly-map",
        "separation-parameters": "from_context.separation-parameters"
      },
      "outputs": {
        "regional-field": "regional-field",
        "residual-anomaly": "residual-anomaly"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "gravity-forward-model",
      "inputs": {
        "residual-anomaly": "step_3.residual-anomaly",
        "geological-constraints": "from_context.geological-constraints"
      },
      "outputs": {
        "forward-model-geometry": "forward-model-geometry",
        "predicted-anomaly": "predicted-anomaly"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "gravity-inversion",
      "inputs": {
        "residual-anomaly": "step_3.residual-anomaly",
        "forward-model-geometry": "step_4.forward-model-geometry"
      },
      "outputs": {
        "inverted-density-model": "inverted-density-model",
        "misfit-report": "misfit-report"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "gravity-interpretation-report",
      "inputs": {
        "inverted-density-model": "step_5.inverted-density-model",
        "misfit-report": "step_5.misfit-report",
        "bouguer-anomaly-map": "step_2.bouguer-anomaly-map"
      },
      "outputs": {
        "gravity-report": "gravity-report",
        "data-archive": "data-archive"
      },
      "parallel_group": 6
    }
  ],
