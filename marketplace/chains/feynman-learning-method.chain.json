{
  "name": "feynman-learning-method",
  "description": "Learn a concept deeply by explaining it in plain language to a beginner, finding the gaps where you fall back on jargon, studying those gaps, and simplifying again.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "concept-scoper",
      "inputs": {
        "concept-name": "from_user_input",
        "current-understanding": "from_user_input"
      },
      "outputs": {
        "concept-scope": "concept-scope",
        "prior-knowledge-notes": "prior-knowledge-notes"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "plain-explanation-writer",
      "inputs": {
        "concept-scope": "step_1.concept-scope",
        "prior-knowledge-notes": "step_1.prior-knowledge-notes"
      },
      "outputs": {
        "plain-explanation": "plain-explanation",
        "analogy-list": "analogy-list"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "jargon-gap-detector",
      "inputs": {
        "plain-explanation": "step_2.plain-explanation",
        "analogy-list": "step_2.analogy-list"
      },
      "outputs": {
        "jargon-flags": "jargon-flags",
        "knowledge-gaps": "knowledge-gaps"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "gap-study-planner",
      "inputs": {
        "jargon-flags": "step_3.jargon-flags",
        "knowledge-gaps": "step_3.knowledge-gaps"
      },
      "outputs": {
        "gap-research-notes": "gap-research-notes",
        "resolved-questions": "resolved-questions"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "explanation-simplifier",
      "inputs": {
        "gap-research-notes": "step_4.gap-research-notes",
        "resolved-questions": "step_4.resolved-questions"
      },
      "outputs": {
        "simplified-explanation": "simplified-explanation",
        "refined-analogies": "refined-analogies"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "understanding-verifier",
      "inputs": {
        "simplified-explanation": "step_5.simplified-explanation",
        "refined-analogies": "step_5.refined-analogies"
      },
      "outputs": {
        "verified-explanation": "verified-explanation",
        "remaining-gaps": "remaining-gaps"
      },
      "parallel_group": 6
    }
  ],
