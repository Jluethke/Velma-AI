{
  "name": "ocean-current-analysis",
  "description": "Analyze ocean current data from ADCP or drifter measurements through quality control, tidal decomposition, circulation pattern identification, validation, and reporting.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "ocean-current-qc",
      "inputs": {
        "raw-current-data": "from_user_input",
        "magnetic-declination": "from_user_input"
      },
      "outputs": {
        "qc-current-data": "qc-current-data",
        "qc-report": "qc-report"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "tidal-current-decomposition",
      "inputs": {
        "qc-current-data": "step_1.qc-current-data",
        "tidal-constituents": "from_context.tidal-constituents"
      },
      "outputs": {
        "tidal-current": "tidal-current",
        "residual-current": "residual-current",
        "tidal-ellipse-parameters": "tidal-ellipse-parameters"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "circulation-pattern-analysis",
      "inputs": {
        "residual-current": "step_2.residual-current",
        "wind-and-pressure-data": "from_context.wind-and-pressure-data"
      },
      "outputs": {
        "circulation-patterns": "circulation-patterns",
        "forcing-correlations": "forcing-correlations"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "satellite-altimetry-validation",
      "inputs": {
        "qc-current-data": "step_1.qc-current-data",
        "altimetry-data": "from_context.altimetry-data"
      },
      "outputs": {
        "validation-statistics": "validation-statistics",
        "validation-figures": "validation-figures"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "ocean-current-report",
      "inputs": {
        "tidal-ellipse-parameters": "step_2.tidal-ellipse-parameters",
        "circulation-patterns": "step_3.circulation-patterns",
        "validation-statistics": "step_4.validation-statistics"
      },
      "outputs": {
        "current-report": "current-report",
        "current-data-archive": "current-data-archive"
      },
      "parallel_group": 5
    }
  ],
