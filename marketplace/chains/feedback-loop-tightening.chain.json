{
  "name": "feedback-loop-tightening",
  "description": "Shorten the time between an action and learning whether it worked, so fewer mistakes accumulate before correction. Maps the current loop, measures the delay at each stage, classifies the delays, replaces periodic steps with continuous ones, checks that the faster signal still tells the truth, and rolls out a tighter loop with a target time.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "loop-mapping",
      "inputs": {
        "process-to-improve": "from_user_input",
        "current-review-cadence": "from_user_input"
      },
      "outputs": {
        "loop-map": "loop-map",
        "loop-stages": "loop-stages"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "delay-measurement",
      "inputs": {
        "loop-map": "step_1.loop-map",
        "loop-stages": "step_1.loop-stages"
      },
      "outputs": {
        "stage-delays": "stage-delays",
        "total-loop-time": "total-loop-time"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "delay-source-classification",
      "inputs": {
        "stage-delays": "step_2.stage-delays",
        "total-loop-time": "step_2.total-loop-time"
      },
      "outputs": {
        "delay-sources": "delay-sources",
        "biggest-delay": "biggest-delay"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "continuous-redesign",
      "inputs": {
        "delay-sources": "step_3.delay-sources",
        "biggest-delay": "step_3.biggest-delay"
      },
      "outputs": {
        "redesigned-loop": "redesigned-loop",
        "batching-removed": "batching-removed"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "signal-quality-check",
      "inputs": {
        "redesigned-loop": "step_4.redesigned-loop",
        "batching-removed": "step_4.batching-removed"
      },
      "outputs": {
        "signal-validity": "signal-validity",
        "false-signal-risks": "false-signal-risks"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "tightened-loop-rollout",
      "inputs": {
        "redesigned-loop": "step_4.redesigned-loop",
        "signal-validity": "step_5.signal-validity",
        "false-signal-risks": "step_5.false-signal-risks"
      },
      "outputs": {
