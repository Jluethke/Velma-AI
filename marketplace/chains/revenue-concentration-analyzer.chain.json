{
  "name": "revenue-concentration-analyzer",
  "description": "Measure how concentrated your income is using the Herfindahl-Hirschman Index. Below 0.15 is diversified. Above 0.25 is concentrated. Above 0.50 is dangerously dependent. Build a mitigation plan for each concentrated source. Works for personal income and business revenue.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "revenue-stream-inventory",
      "inputs": {
        "revenue-data": "from_user_input",
        "revenue-context": "from_user_input"
      },
      "outputs": {
        "stream-inventory": "stream-inventory",
        "stream-count": "stream-count"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "hhi-concentration-scorer",
      "inputs": {
        "stream-inventory": "step_1.stream-inventory"
      },
      "outputs": {
        "hhi-score": "hhi-score",
        "concentration-assessment": "concentration-assessment"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "dependency-vulnerability-mapper",
      "inputs": {
        "stream-inventory": "step_1.stream-inventory",
        "hhi-score": "step_2.hhi-score"
      },
      "outputs": {
        "vulnerability-map": "vulnerability-map",
        "loss-scenario-table": "loss-scenario-table"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "concentration-mitigation-planner",
      "inputs": {
        "vulnerability-map": "step_3.vulnerability-map",
        "loss-scenario-table": "step_3.loss-scenario-table",
        "concentration-assessment": "step_2.concentration-assessment"
      },
      "outputs": {
        "mitigation-plan": "mitigation-plan",
        "revenue-concentration-report": "revenue-concentration-report"
      },
      "parallel_group": 4
    }
  ],
