{
  "name": "api-client-sdk-resilience",
  "description": "Harden an existing client SDK's failure behavior: error hierarchy, stack-specific timeouts, retries with backoff and Retry-After, idempotency keys, and WireMock fault-injection verification.",
  "steps": [
