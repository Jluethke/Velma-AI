{
  "name": "difficult-conversation-protocol",
  "description": "Structure for delivering hard news or raising uncomfortable topics. Uses the Observation-Impact-Request-Silence framework. Works for firing someone, ending a relationship, raising a performance issue, or delivering bad news to a client. The silence at the end is where the real conversation happens.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "conversation-stakes-assessment",
      "inputs": {
        "situation-description": "from_user_input",
        "relationship-context": "from_user_input"
      },
      "outputs": {
        "your-stakes": "your-stakes",
        "their-stakes": "their-stakes",
        "conversation-goal": "conversation-goal"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "observation-statement-writer",
      "inputs": {
        "situation-description": "from_context.situation-description",
        "conversation-goal": "step_1.conversation-goal"
      },
      "outputs": {
        "observation-statement": "observation-statement",
        "removed-interpretations": "removed-interpretations"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "impact-statement-writer",
      "inputs": {
        "observation-statement": "step_2.observation-statement",
        "their-stakes": "step_1.their-stakes"
      },
      "outputs": {
        "impact-statement": "impact-statement",
        "emotional-impact-note": "emotional-impact-note"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "request-statement-writer",
      "inputs": {
        "conversation-goal": "step_1.conversation-goal",
        "impact-statement": "step_3.impact-statement"
      },
      "outputs": {
        "request-statement": "request-statement",
        "measurable-check": "measurable-check"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "silence-and-response-protocol",
      "inputs": {
        "request-statement": "step_4.request-statement",
        "their-stakes": "step_1.their-stakes"
      },
      "outputs": {
        "silence-plan": "silence-plan",
        "response-paths": "response-paths"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "conversation-rehearsal",
      "inputs": {
        "observation-statement": "step_2.observation-statement",
        "impact-statement": "step_3.impact-statement",
        "request-statement": "step_4.request-statement",
        "silence-plan": "step_5.silence-plan"
      },
      "outputs": {
        "rehearsal-notes": "rehearsal-notes",
        "final-conversation-script": "final-conversation-script"
      },
      "parallel_group": 6
    }
  ],
