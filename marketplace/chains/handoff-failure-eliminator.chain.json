{
  "name": "handoff-failure-eliminator",
  "description": "Design handoffs between people, teams, or shifts so nothing falls through. Every handoff failure comes from one of three gaps: information (the receiver does not know what the sender knows), responsibility (nobody owns the item during transition), or timing (the handoff happens too early or too late). Close all three.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "handoff-inventory-mapper",
      "inputs": {
        "process-name": "from_user_input",
        "failure-examples": "from_user_input"
      },
      "outputs": {
        "handoff-map": "handoff-map",
        "failure-prone-handoffs": "failure-prone-handoffs"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "information-gap-closer",
      "inputs": {
        "handoff-map": "step_1.handoff-map",
        "failure-prone-handoffs": "step_1.failure-prone-handoffs"
      },
      "outputs": {
        "information-requirements": "information-requirements",
        "information-delivery-method": "information-delivery-method"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "responsibility-gap-closer",
      "inputs": {
        "handoff-map": "step_1.handoff-map",
        "information-requirements": "step_2.information-requirements"
      },
      "outputs": {
        "ownership-protocol": "ownership-protocol",
        "orphan-prevention-rules": "orphan-prevention-rules"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "timing-gap-closer",
