{
  "name": "break-even-analysis-system",
  "description": "Calculate the break-even point for any investment or decision. Go beyond the basic formula: calculate break-even time, break-even probability under uncertainty, and sensitivity analysis to identify which variable matters most. Apply to a gym membership or a capital expenditure.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "cost-revenue-structure-definer",
      "inputs": {
        "investment-description": "from_user_input",
        "cost-estimates": "from_user_input"
      },
      "outputs": {
        "cost-structure": "cost-structure",
        "break-even-units": "break-even-units"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "break-even-time-calculator",
      "inputs": {
        "break-even-units": "step_1.break-even-units",
        "expected-volume": "from_context.expected-volume"
      },
      "outputs": {
        "break-even-time": "break-even-time",
        "cumulative-cash-flow-curve": "cumulative-cash-flow-curve"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "break-even-probability-estimator",
      "inputs": {
        "cost-structure": "step_1.cost-structure",
        "break-even-units": "step_1.break-even-units",
        "expected-volume": "from_context.expected-volume"
      },
      "outputs": {
        "break-even-probability": "break-even-probability",
        "scenario-range": "scenario-range"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "sensitivity-analysis-runner",
      "inputs": {
        "causal-estimate": "from_context.causal-estimate",
        "identifying-assumptions": "from_context.identifying-assumptions"
      },
      "outputs": {
        "sensitivity-results": "sensitivity-results",
        "robustness-verdict": "robustness-verdict"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "break-even-decision-report",
      "inputs": {
        "break-even-units": "step_1.break-even-units",
        "break-even-time": "step_2.break-even-time",
        "break-even-probability": "step_3.break-even-probability",
        "key-sensitivity-variable": "from_context.key-sensitivity-variable"
      },
      "outputs": {
        "break-even-verdict": "break-even-verdict",
        "break-even-report": "break-even-report"
      },
      "parallel_group": 5
    }
  ],
