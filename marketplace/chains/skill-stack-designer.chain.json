      },
      "outputs": {
        "skill-inventory": "skill-inventory",
        "top-quartile-skills": "top-quartile-skills"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "combination-rarity-scorer",
      "inputs": {
        "top-quartile-skills": "step_1.top-quartile-skills",
        "skill-inventory": "step_1.skill-inventory"
      },
      "outputs": {
        "combination-scores": "combination-scores",
        "market-value-notes": "market-value-notes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "stack-selection-decision",
