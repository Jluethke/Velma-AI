{
  "name": "pre-mortem-analysis",
  "description": "Run a pre-mortem using the Gary Klein method: imagine the project has already failed, work backward to identify the most likely causes, then address them before they happen. Prevention is cheaper than recovery.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "project-snapshot-capture",
      "inputs": {
        "project-plan": "from_user_input",
        "success-criteria": "from_user_input"
      },
      "outputs": {
        "plan-snapshot": "plan-snapshot",
        "assumption-list": "assumption-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "failure-imagination-session",
      "inputs": {
        "plan-snapshot": "step_1.plan-snapshot",
        "assumption-list": "step_1.assumption-list"
      },
      "outputs": {
        "failure-stories": "failure-stories",
        "raw-failure-causes": "raw-failure-causes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "failure-cause-clustering",
      "inputs": {
        "raw-failure-causes": "step_2.raw-failure-causes",
        "assumption-list": "step_1.assumption-list"
      },
      "outputs": {
        "failure-themes": "failure-themes",
        "ranked-risks": "ranked-risks"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "prevention-action-design",
      "inputs": {
        "ranked-risks": "step_3.ranked-risks",
        "plan-snapshot": "step_1.plan-snapshot"
      },
      "outputs": {
        "prevention-actions": "prevention-actions",
        "plan-modifications": "plan-modifications"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "early-warning-monitor-setup",
      "inputs": {
        "prevention-actions": "step_4.prevention-actions",
        "plan-modifications": "step_4.plan-modifications"
      },
      "outputs": {
        "monitoring-plan": "monitoring-plan",
        "escalation-protocol": "escalation-protocol"
      },
      "parallel_group": 5
    }
  ],
