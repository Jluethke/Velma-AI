{
  "name": "vacation-planner",
  "description": "Plan the whole trip end-to-end: budget it, build the itinerary, set up pet care while you're gone, prep the house, and write out-of-office emails. From 'we should go somewhere' to packed bags.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "budget-builder",
      "inputs": {
        "income": "from_user_input",
        "fixed_expenses": "from_user_input",
        "variable_spending": "from_user_input",
        "financial_situation": "from_user_input",
        "goals": "from_user_input"
      },
      "outputs": {
        "spending_snapshot": "spending_snapshot_data",
        "monthly_budget": "monthly_budget_data",
        "bleed_points": "bleed_points_data",
        "action_plan": "action_plan_data",
        "monthly_checkup": "monthly_checkup_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "travel-planner",
      "inputs": {
        "destination": "step_1.spending_snapshot",
        "dates": "step_1.spending_snapshot",
        "budget": "step_1.spending_snapshot",
        "travelers": "step_1.spending_snapshot",
        "style": "step_1.spending_snapshot",
        "interests": "step_1.spending_snapshot",
        "constraints": "step_1.spending_snapshot"
      },
      "outputs": {
        "itinerary": "itinerary_data",
        "logistics": "logistics_data",
        "budget_plan": "budget_plan_data",
        "packing_list": "packing_list_data",
        "practical_guide": "practical_guide_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "pet-care-guide",
      "inputs": {
        "pet": "from_user_input",
        "living_situation": "from_user_input",
        "experience": "from_user_input",
        "concerns": "from_user_input",
        "history": "from_user_input"
      },
      "outputs": {
        "care_schedule": "care_schedule_data",
        "feeding_plan": "feeding_plan_data",
        "health_roadmap": "health_roadmap_data",
        "behavior_guide": "behavior_guide_data",
        "emergency_reference": "emergency_reference_data"
      },
      "parallel_group": 1
    },
    {
