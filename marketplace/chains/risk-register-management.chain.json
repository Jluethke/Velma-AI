{
  "name": "risk-register-management",
  "description": "Manage a security risk register from risk identification through scoring, treatment planning, and quarterly review.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "risk-identification-engine",
      "inputs": {
        "system-inventory": "from_user_input",
        "threat-landscape": "from_user_input"
      },
      "outputs": {
        "risk-list": "risk-list",
        "risk-context": "risk-context"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "risk-scoring-calculator",
      "inputs": {
        "risk-list": "step_1.risk-list",
        "risk-context": "step_1.risk-context"
      },
      "outputs": {
        "scored-risks": "scored-risks",
        "risk-matrix": "risk-matrix"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "risk-owner-assigner",
      "inputs": {
        "scored-risks": "step_2.scored-risks",
        "organization-profile": "from_context.organization-profile"
      },
      "outputs": {
        "owned-risks": "owned-risks",
        "owner-notifications": "owner-notifications"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "risk-treatment-planner",
      "inputs": {
        "owned-risks": "step_3.owned-risks",
        "risk-matrix": "step_2.risk-matrix"
      },
      "outputs": {
        "treatment-plans": "treatment-plans",
        "residual-risk-estimates": "residual-risk-estimates"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "mitigation-progress-tracker",
      "inputs": {
        "treatment-plans": "step_4.treatment-plans",
        "owner-notifications": "step_3.owner-notifications"
      },
      "outputs": {
        "progress-report": "progress-report",
        "overdue-actions": "overdue-actions"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "quarterly-risk-reviewer",
      "inputs": {
        "progress-report": "step_5.progress-report",
        "residual-risk-estimates": "step_4.residual-risk-estimates"
      },
      "outputs": {
        "updated-risk-register": "updated-risk-register",
        "risk-register-report": "risk-register-report"
      },
      "parallel_group": 6
    }
  ],
