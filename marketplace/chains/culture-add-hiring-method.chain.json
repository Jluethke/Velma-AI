{
  "name": "culture-add-hiring-method",
  "description": "Hire for culture ADD instead of culture FIT. Culture fit produces homogeneous teams that agree on everything and miss blind spots. Culture add produces teams with diverse perspectives that challenge each other. Define what is MISSING from the team, screen for those missing elements, and change the interview question from 'would I enjoy working with this person?' to 'what does this person bring that nobody on the team currently has?'",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "team-composition-auditor",
      "inputs": {
        "team-roster": "from_user_input",
        "team-purpose": "from_user_input"
      },
      "outputs": {
        "composition-profile": "composition-profile",
        "homogeneity-flags": "homogeneity-flags"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "missing-perspective-definer",
      "inputs": {
        "composition-profile": "step_1.composition-profile",
        "homogeneity-flags": "step_1.homogeneity-flags"
      },
      "outputs": {
        "missing-perspectives": "missing-perspectives",
        "blind-spot-examples": "blind-spot-examples"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "culture-add-criteria-builder",
      "inputs": {
        "missing-perspectives": "step_2.missing-perspectives",
        "blind-spot-examples": "step_2.blind-spot-examples"
      },
      "outputs": {
        "culture-add-criteria": "culture-add-criteria",
        "screening-questions": "screening-questions"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "interview-reframe-trainer",
      "inputs": {
        "culture-add-criteria": "step_3.culture-add-criteria",
        "screening-questions": "step_3.screening-questions"
      },
      "outputs": {
        "interviewer-guide": "interviewer-guide",
        "bias-checklist": "bias-checklist"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "add-impact-tracker",
      "inputs": {
        "interviewer-guide": "step_4.interviewer-guide",
        "bias-checklist": "step_4.bias-checklist"
      },
      "outputs": {
        "add-impact-log": "add-impact-log",
        "method-assessment": "method-assessment"
      },
      "parallel_group": 5
    }
  ],
