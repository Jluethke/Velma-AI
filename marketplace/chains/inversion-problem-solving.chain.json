{
  "name": "inversion-problem-solving",
  "description": "Solve a problem by inverting it: instead of asking how to succeed, list every way to guarantee failure, then remove those paths from the plan.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "inversion-state-the-goal",
      "inputs": {
        "problem-statement": "from_user_input",
        "desired-outcome": "from_user_input"
      },
      "outputs": {
        "goal-definition": "goal-definition",
        "success-markers": "success-markers"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "inversion-flip-to-failure",
      "inputs": {
        "goal-definition": "step_1.goal-definition",
        "success-markers": "step_1.success-markers"
      },
      "outputs": {
        "failure-question": "failure-question",
        "failure-frame": "failure-frame"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "inversion-list-failure-paths",
      "inputs": {
        "failure-question": "step_2.failure-question",
        "failure-frame": "step_2.failure-frame"
      },
      "outputs": {
        "failure-paths": "failure-paths",
        "failure-ranked": "failure-ranked"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "inversion-test-current-plan",
      "inputs": {
        "failure-paths": "step_3.failure-paths",
        "failure-ranked": "step_3.failure-ranked"
      },
      "outputs": {
        "plan-exposure": "plan-exposure",
        "vulnerable-points": "vulnerable-points"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "inversion-find-exposure",
      "inputs": {
        "plan-exposure": "step_4.plan-exposure",
        "vulnerable-points": "step_4.vulnerable-points"
      },
      "outputs": {
        "exposure-summary": "exposure-summary",
        "priority-gaps": "priority-gaps"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "inversion-eliminate-modes",
      "inputs": {
        "exposure-summary": "step_5.exposure-summary",
        "priority-gaps": "step_5.priority-gaps"
      },
      "outputs": {
        "plan-changes": "plan-changes",
        "removed-modes": "removed-modes"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "inversion-confirm-avoidance",
      "inputs": {
        "plan-changes": "step_6.plan-changes",
        "removed-modes": "step_6.removed-modes"
      },
      "outputs": {
        "revised-plan": "revised-plan",
        "residual-risks": "residual-risks"
      },
      "parallel_group": 7
    }
  ],
