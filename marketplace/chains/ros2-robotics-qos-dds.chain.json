      "outputs": {
        "cyclonedds_config": "cyclonedds_config",
        "cyclonedds_check": "cyclonedds_check"
      },
      "condition": "rmw_choice == 'rmw_cyclonedds_cpp'",
      "parallel_group": 2
    }
  ],
  "edges": [
