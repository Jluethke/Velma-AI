        "node_spec": "from_user_input"
      },
      "outputs": {
        "qos_table": "qos_table",
        "qos_mismatches": "qos_mismatches"
      },
      "parallel_group": 1
    },
    {
      "id": "s03_ros2_qos_incompatibility_debug",
      "skill_name": "ros2-qos-incompatibility-debug",
      "inputs": {
