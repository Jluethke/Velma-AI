      },
      "outputs": {
        "rmw_choice": "rmw_choice",
        "rmw_env": "rmw_env"
      },
      "parallel_group": 1
    },
    {
      "id": "s05_ros2_fastdds_xml_tuning",
      "skill_name": "ros2-fastdds-xml-tuning",
      "inputs": {
        "rmw_env": "s04_ros2_dds_rmw_selection.rmw_env",
        "network_topology": "from_user_input"
      },
      "outputs": {
        "fastdds_profile": "fastdds_profile",
        "fastdds_check": "fastdds_check"
      },
      "condition": "rmw_choice == 'rmw_fastrtps_cpp'",
      "parallel_group": 2
    },
    {
      "id": "s06_ros2_cyclonedds_xml_tuning",
      "skill_name": "ros2-cyclonedds-xml-tuning",
