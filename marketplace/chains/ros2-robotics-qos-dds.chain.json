{
  "name": "ros2-robotics-qos-dds",
  "description": "Diagnose and fix ROS 2 communication: introspect the graph, select QoS by decision table, fix incompatible endpoints, choose one RMW, and tune Fast DDS or Cyclone DDS with measured proof.",
  "steps": [
    {
      "id": "s01_ros2_doctor_introspection",
      "skill_name": "ros2-doctor-introspection",
      "inputs": {
        "topic_list": "from_user_input",
        "node_spec": "from_user_input"
      },
      "outputs": {
        "introspection_report": "introspection_report"
      },
      "parallel_group": 1
    },
    {
