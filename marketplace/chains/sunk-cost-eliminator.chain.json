{
  "name": "sunk-cost-eliminator",
  "description": "Systematically find and eliminate commitments that no longer earn their keep. Subscriptions, projects, relationships, habits, and investments that persist through inertia rather than value. The method: inventory everything, calculate the forward-looking value, and terminate anything where continuing costs more than stopping.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "commitment-inventory",
      "inputs": {
        "scope": "from_user_input",
        "time-period": "from_user_input"
      },
      "outputs": {
        "commitment-list": "commitment-list",
        "auto-renewal-flags": "auto-renewal-flags"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "forward-value-assessor",
      "inputs": {
        "commitment-list": "step_1.commitment-list",
        "scope": "from_context.scope"
      },
      "outputs": {
        "value-assessments": "value-assessments",
        "elimination-candidates": "elimination-candidates"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "termination-executor",
      "inputs": {
        "elimination-candidates": "step_2.elimination-candidates",
        "commitment-list": "step_1.commitment-list"
      },
      "outputs": {
        "termination-plan": "termination-plan",
        "total-savings": "total-savings"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "inertia-prevention-system",
      "inputs": {
        "termination-plan": "step_3.termination-plan",
        "total-savings": "step_3.total-savings"
      },
      "outputs": {
        "commitment-review-calendar": "commitment-review-calendar",
        "new-commitment-rules": "new-commitment-rules"
      },
      "parallel_group": 4
    }
  ],
