{
  "name": "presentation-structure-method",
  "description": "Structure a presentation with the Minto Pyramid: state the answer first, then the three supporting arguments, then the evidence under each. Your audience is there to be convinced, not confused, so lead with the conclusion. Each slide carries one idea, one visual, and one spoken explanation.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "psm-governing-answer-writer",
      "inputs": {
        "presentation-goal": "from_user_input",
        "audience": "from_user_input"
      },
      "outputs": {
        "governing-answer": "governing-answer",
        "audience-question": "audience-question"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "psm-three-argument-builder",
      "inputs": {
        "governing-answer": "step_1.governing-answer",
        "audience-question": "step_1.audience-question"
      },
      "outputs": {
        "supporting-arguments": "supporting-arguments",
        "mece-check": "mece-check"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "psm-evidence-mapper",
      "inputs": {
        "supporting-arguments": "step_2.supporting-arguments"
      },
      "outputs": {
        "evidence-map": "evidence-map",
        "evidence-gaps": "evidence-gaps"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "psm-slide-decomposer",
      "inputs": {
        "supporting-arguments": "step_2.supporting-arguments",
        "evidence-map": "step_3.evidence-map"
      },
      "outputs": {
        "slide-outline": "slide-outline",
        "slide-idea-count": "slide-idea-count"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "psm-storyline-sequencer",
      "inputs": {
        "governing-answer": "step_1.governing-answer",
        "slide-outline": "step_4.slide-outline"
      },
      "outputs": {
        "storyline-sequence": "storyline-sequence",
        "opening-slide": "opening-slide"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "psm-dry-run-tightener",
      "inputs": {
