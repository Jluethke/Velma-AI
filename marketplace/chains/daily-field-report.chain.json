        "equipment-log": "step_3.equipment-log"
      },
      "outputs": {
        "work-description": "work-description",
        "progress-notes": "progress-notes"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "delays-and-issues-noter",
      "inputs": {
        "weather-impact-note": "step_1.weather-impact-note",
        "equipment-issues": "step_3.equipment-issues"
      },
      "outputs": {
        "delay-log": "delay-log",
        "issue-actions": "issue-actions"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "safety-observation-recorder",
      "inputs": {
        "project-name": "from_context.project-name",
        "report-date": "from_context.report-date"
      },
      "outputs": {
        "safety-observations": "safety-observations",
        "safety-actions": "safety-actions"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "daily-report-compiler",
      "inputs": {
        "weather-record": "step_1.weather-record",
        "crew-log": "step_2.crew-log",
        "work-description": "step_4.work-description",
        "delay-log": "step_5.delay-log"
      },
      "outputs": {
        "daily-field-report": "daily-field-report",
        "report-distribution-list": "report-distribution-list"
      },
      "parallel_group": 7
    }
  ],
