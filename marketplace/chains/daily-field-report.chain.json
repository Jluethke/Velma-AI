{
  "name": "daily-field-report",
  "description": "Produce a daily construction field report covering weather, crew, equipment, work completed, delays, and safety.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "weather-conditions-recorder",
      "inputs": {
        "project-name": "from_user_input",
        "report-date": "from_user_input"
      },
      "outputs": {
        "weather-record": "weather-record",
        "weather-impact-note": "weather-impact-note"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "crew-and-hours-logger",
      "inputs": {
        "project-name": "from_context.project-name",
        "report-date": "from_context.report-date"
      },
      "outputs": {
        "crew-log": "crew-log",
        "labor-summary": "labor-summary"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "equipment-on-site-logger",
      "inputs": {
        "project-name": "from_context.project-name",
        "report-date": "from_context.report-date"
      },
      "outputs": {
        "equipment-log": "equipment-log",
        "equipment-issues": "equipment-issues"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "work-completed-describer",
      "inputs": {
