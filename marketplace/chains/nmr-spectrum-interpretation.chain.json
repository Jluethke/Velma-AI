{
  "name": "nmr-spectrum-interpretation",
  "description": "Interpret an NMR spectrum from raw data to structure: process the FID, pick peaks, assign chemical shifts, analyze multiplicity and coupling, integrate for ratios, and propose or confirm the molecular structure.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "fid-processor",
      "inputs": {
        "raw-fid": "from_user_input",
        "processing-parameters": "from_user_input"
      },
      "outputs": {
        "processed-spectrum": "processed-spectrum",
        "processing-log": "processing-log"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "peak-picker-nmr",
      "inputs": {
        "processed-spectrum": "step_1.processed-spectrum",
        "picking-parameters": "from_context.picking-parameters"
      },
      "outputs": {
        "peak-list-nmr": "peak-list-nmr",
        "solvent-exclusion-log": "solvent-exclusion-log"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "chemical-shift-assigner",
      "inputs": {
        "peak-list-nmr": "step_2.peak-list-nmr",
        "molecular-formula": "from_context.molecular-formula"
      },
      "outputs": {
        "shift-assignments": "shift-assignments",
        "degrees-of-unsaturation": "degrees-of-unsaturation"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "multiplicity-coupling-analyzer",
      "inputs": {
        "peak-list-nmr": "step_2.peak-list-nmr",
        "shift-assignments": "step_3.shift-assignments"
      },
      "outputs": {
        "multiplicity-table": "multiplicity-table",
        "connectivity-constraints": "connectivity-constraints"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "integration-ratio-calculator",
      "inputs": {
        "processed-spectrum": "step_1.processed-spectrum",
        "peak-list-nmr": "step_2.peak-list-nmr"
      },
      "outputs": {
        "integration-table": "integration-table",
        "integral-consistency": "integral-consistency"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "structure-proposer",
      "inputs": {
        "shift-assignments": "step_3.shift-assignments",
        "connectivity-constraints": "step_4.connectivity-constraints",
        "integration-table": "step_5.integration-table"
      },
      "outputs": {
        "proposed-structure": "proposed-structure",
        "assignment-table": "assignment-table"
      },
      "parallel_group": 6
    }
  ],
