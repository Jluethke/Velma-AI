    {
      "id": "step_1",
      "skill_name": "load-impedance-characterization",
      "inputs": {
        "load-description": "from_user_input",
        "frequency-requirements": "from_user_input"
      },
      "outputs": {
        "load-impedance-data": "load-impedance-data",
        "smith-chart-position": "smith-chart-position"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "matching-topology-selection",
      "inputs": {
        "load-impedance-data": "step_1.load-impedance-data",
        "smith-chart-position": "step_1.smith-chart-position",
        "frequency-requirements": "from_context.frequency-requirements"
      },
      "outputs": {
        "selected-topology": "selected-topology",
        "q-budget": "q-budget"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "matching-element-calculation",
      "inputs": {
        "load-impedance-data": "step_1.load-impedance-data",
