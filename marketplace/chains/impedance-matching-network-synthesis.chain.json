      "skill_name": "matching-parasitic-absorption",
      "inputs": {
        "element-values": "step_3.element-values",
        "network-schematic": "step_3.network-schematic"
      },
      "outputs": {
        "adjusted-element-values": "adjusted-element-values",
        "parasitic-model": "parasitic-model"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "matching-network-verification",
