{
  "name": "ecological-diversity-metrics",
  "description": "Compute and compare ecological diversity metrics from species abundance data through alpha and beta diversity, PERMANOVA, and rarefaction to a diversity report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "species-abundance-tabulator",
      "inputs": {
        "observation-records": "from_user_input",
        "taxonomic-key": "from_user_input"
      },
      "outputs": {
        "abundance-matrix": "abundance-matrix",
        "sampling-effort": "sampling-effort"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "alpha-diversity-calculator",
      "inputs": {
        "abundance-matrix": "step_1.abundance-matrix",
        "diversity-indices": "from_context.diversity-indices"
      },
      "outputs": {
        "alpha-diversity-table": "alpha-diversity-table",
        "confidence-intervals": "confidence-intervals"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "beta-diversity-calculator",
      "inputs": {
        "abundance-matrix": "step_1.abundance-matrix",
        "distance-metric": "from_context.distance-metric"
      },
      "outputs": {
        "distance-matrix": "distance-matrix",
        "ordination-coordinates": "ordination-coordinates"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "permanova-tester",
      "inputs": {
        "distance-matrix": "step_3.distance-matrix",
        "group-assignments": "from_context.group-assignments"
      },
      "outputs": {
        "permanova-results": "permanova-results",
        "dispersion-test": "dispersion-test"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "rarefaction-curve-generator",
      "inputs": {
        "abundance-matrix": "step_1.abundance-matrix",
        "sampling-effort": "step_1.sampling-effort"
      },
      "outputs": {
        "rarefaction-curves": "rarefaction-curves",
        "estimated-richness": "estimated-richness"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "diversity-report-generator",
      "inputs": {
        "alpha-diversity-table": "step_2.alpha-diversity-table",
        "permanova-results": "step_4.permanova-results",
        "rarefaction-curves": "step_5.rarefaction-curves"
      },
      "outputs": {
        "diversity-report": "diversity-report",
        "analysis-archive": "analysis-archive"
      },
      "parallel_group": 6
    }
  ],
