{
  "name": "luminescence-dating",
  "description": "Date sediments by optically stimulated luminescence (OSL) or thermoluminescence (TL) from sample collection through mineral preparation, equivalent dose measurement, dose rate determination, age computation, and reporting.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "luminescence-sample-collection",
      "inputs": {
        "sampling-site": "from_user_input",
        "sampling-protocol": "from_user_input"
      },
      "outputs": {
        "collected-samples": "collected-samples",
        "field-dosimetry-data": "field-dosimetry-data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "mineral-grain-preparation",
      "inputs": {
        "collected-samples": "step_1.collected-samples",
        "target-mineral": "from_context.target-mineral"
      },
      "outputs": {
        "prepared-aliquots": "prepared-aliquots",
        "preparation-log": "preparation-log"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "equivalent-dose-measurement",
      "inputs": {
        "prepared-aliquots": "step_2.prepared-aliquots",
        "sar-protocol": "from_context.sar-protocol"
      },
      "outputs": {
        "de-distribution": "de-distribution",
        "sar-diagnostics": "sar-diagnostics"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "environmental-dose-rate",
      "inputs": {
        "field-dosimetry-data": "step_1.field-dosimetry-data",
        "sediment-chemistry": "from_context.sediment-chemistry"
      },
      "outputs": {
        "total-dose-rate": "total-dose-rate",
        "dose-rate-components": "dose-rate-components"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "luminescence-age-calculation",
      "inputs": {
        "de-distribution": "step_3.de-distribution",
        "total-dose-rate": "step_4.total-dose-rate"
      },
      "outputs": {
        "luminescence-age": "luminescence-age",
        "age-model-assessment": "age-model-assessment"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "luminescence-dating-report",
      "inputs": {
        "luminescence-age": "step_5.luminescence-age",
        "age-model-assessment": "step_5.age-model-assessment",
        "sar-diagnostics": "step_3.sar-diagnostics"
      },
      "outputs": {
