{
  "name": "teaching-to-learn-method",
  "description": "Use teaching to deepen your own learning: teach what you are studying, note where your explanation breaks, study those gaps, and let your audience's questions reveal blind spots.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "teach-topic-selector",
      "inputs": {
        "learning-topic": "from_user_input",
        "audience-context": "from_user_input"
      },
      "outputs": {
        "teach-topic": "teach-topic",
        "audience-profile": "audience-profile"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "explanation-organizer",
      "inputs": {
        "teach-topic": "step_1.teach-topic",
        "audience-profile": "step_1.audience-profile"
      },
      "outputs": {
        "lesson-outline": "lesson-outline",
        "key-points": "key-points"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "gap-surfacer",
      "inputs": {
        "lesson-outline": "step_2.lesson-outline",
        "key-points": "step_2.key-points"
      },
      "outputs": {
        "explanation-draft": "explanation-draft",
        "breakdown-points": "breakdown-points"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "gap-study-session",
      "inputs": {
        "explanation-draft": "step_3.explanation-draft",
        "breakdown-points": "step_3.breakdown-points"
      },
      "outputs": {
        "gap-fill-notes": "gap-fill-notes",
        "repaired-explanation": "repaired-explanation"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "live-teaching-session",
      "inputs": {
        "gap-fill-notes": "step_4.gap-fill-notes",
        "repaired-explanation": "step_4.repaired-explanation"
      },
      "outputs": {
        "teaching-record": "teaching-record",
        "audience-questions": "audience-questions"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "blind-spot-integrator",
      "inputs": {
        "teaching-record": "step_5.teaching-record",
        "audience-questions": "step_5.audience-questions"
      },
      "outputs": {
        "blind-spot-list": "blind-spot-list",
        "next-study-plan": "next-study-plan"
      },
      "parallel_group": 6
    }
  ],
