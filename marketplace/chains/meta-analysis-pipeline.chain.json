        "study-results-table": "from_user_input",
        "target-effect-measure": "from_user_input"
      },
      "outputs": {
        "effect-size-table": "effect-size-table",
        "conversion-notes": "conversion-notes"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "heterogeneity-assessor",
      "inputs": {
        "effect-size-table": "step_1.effect-size-table"
      },
      "outputs": {
        "heterogeneity-report": "heterogeneity-report",
        "model-recommendation": "model-recommendation"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "pooled-analysis-runner",
      "inputs": {
        "effect-size-table": "step_1.effect-size-table",
        "model-recommendation": "step_2.model-recommendation"
      },
      "outputs": {
        "pooled-result": "pooled-result",
        "study-weights": "study-weights"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "forest-funnel-plot-generator",
      "inputs": {
        "effect-size-table": "step_1.effect-size-table",
        "pooled-result": "step_3.pooled-result",
        "study-weights": "step_3.study-weights"
      },
      "outputs": {
        "forest-plot": "forest-plot",
        "funnel-plot": "funnel-plot"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "publication-bias-tester",
      "inputs": {
        "effect-size-table": "step_1.effect-size-table",
        "funnel-plot": "step_4.funnel-plot"
      },
      "outputs": {
        "bias-test-results": "bias-test-results",
        "bias-interpretation": "bias-interpretation"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "meta-analysis-reporter",
      "inputs": {
        "pooled-result": "step_3.pooled-result",
        "heterogeneity-report": "step_2.heterogeneity-report",
        "forest-plot": "step_4.forest-plot",
        "bias-test-results": "step_5.bias-test-results"
      },
      "outputs": {
        "meta-analysis-report": "meta-analysis-report",
        "grade-assessment": "grade-assessment"
      },
      "parallel_group": 6
    }
