{
  "name": "policy-administration-lifecycle",
  "description": "Administer an insurance policy through its lifecycle: issuance, endorsements, renewals, cancellations, and archival.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "policy-issuance-processor",
      "inputs": {
        "bound-policy-details": "from_user_input",
        "policy-forms": "from_user_input"
      },
      "outputs": {
        "issued-policy": "issued-policy",
        "billing-setup": "billing-setup"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "endorsement-processor",
      "inputs": {
        "issued-policy": "step_1.issued-policy",
        "change-request": "from_context.change-request"
      },
      "outputs": {
        "endorsed-policy": "endorsed-policy",
        "premium-adjustment": "premium-adjustment"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "renewal-offer-generator",
      "inputs": {
        "endorsed-policy": "step_2.endorsed-policy",
        "renewal-underwriting-notes": "from_context.renewal-underwriting-notes"
      },
      "outputs": {
        "renewal-offer": "renewal-offer",
        "renewal-deadline": "renewal-deadline"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cancellation-reinstatement-handler",
      "inputs": {
        "renewal-offer": "step_3.renewal-offer",
        "cancellation-request": "from_context.cancellation-request"
      },
      "outputs": {
        "cancellation-notice": "cancellation-notice",
        "policy-status-update": "policy-status-update"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "policy-archive-manager",
      "inputs": {
        "cancellation-notice": "step_4.cancellation-notice",
        "policy-status-update": "step_4.policy-status-update"
      },
      "outputs": {
        "archived-policy-record": "archived-policy-record",
        "policy-administration-record": "policy-administration-record"
      },
      "parallel_group": 5
    }
  ],
