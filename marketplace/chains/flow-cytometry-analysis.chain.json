{
  "name": "flow-cytometry-analysis",
  "description": "Analyze flow cytometry data from FCS file import through compensation, gating, population statistics, cross-sample comparison, and visualization.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "fcs-file-importer",
      "inputs": {
        "fcs-files": "from_user_input",
        "panel-definition": "from_user_input"
      },
      "outputs": {
        "parsed-events": "parsed-events",
        "acquisition-summary": "acquisition-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "spectral-compensation-applier",
      "inputs": {
        "parsed-events": "step_1.parsed-events",
        "panel-definition": "from_context.panel-definition"
      },
      "outputs": {
        "compensated-events": "compensated-events",
        "compensation-matrix": "compensation-matrix"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "population-gating-engine",
      "inputs": {
        "compensated-events": "step_2.compensated-events",
        "panel-definition": "from_context.panel-definition"
      },
      "outputs": {
        "gated-populations": "gated-populations",
        "gating-report": "gating-report"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cytometry-statistics-extractor",
      "inputs": {
        "gated-populations": "step_3.gated-populations"
      },
      "outputs": {
        "population-statistics": "population-statistics",
        "statistics-table": "statistics-table"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "cross-sample-cytometry-comparator",
      "inputs": {
        "statistics-table": "step_4.statistics-table",
        "experimental-design": "from_context.experimental-design"
      },
      "outputs": {
        "comparison-results": "comparison-results",
        "significant-differences": "significant-differences"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "cytometry-visualization-builder",
      "inputs": {
        "compensated-events": "step_2.compensated-events",
        "gated-populations": "step_3.gated-populations",
        "comparison-results": "step_5.comparison-results"
      },
      "outputs": {
        "visualization-panel": "visualization-panel",
        "cytometry-report": "cytometry-report"
      },
      "parallel_group": 6
    }
