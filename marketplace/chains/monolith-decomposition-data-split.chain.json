{
  "name": "monolith-decomposition-data-split",
  "description": "Split the candidate's data: move owned tables into their own schema with revoked grants, choose outbox or CDC per stage, stand up the PostgreSQL or MySQL Debezium pipeline or the outbox, then backfill and reconcile.",
  "steps": [
    {
      "id": "s01_mex_schema_ownership_split",
      "skill_name": "mex-schema-ownership-split",
      "inputs": {
        "table_ownership": "from_user_input",
        "shared_tables": "from_user_input",
        "database_engine": "from_user_input",
        "module_interface": "from_user_input",
        "deployment_decision": "from_user_input"
      },
      "outputs": {
        "schema_split_plan": "schema_split_plan",
        "migration_scripts": "migration_scripts"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_mex_dual_write_or_cdc_decision",
      "skill_name": "mex-dual-write-or-cdc-decision",
      "inputs": {
        "schema_split_plan": "s01_mex_schema_ownership_split.schema_split_plan",
        "database_engine": "from_user_input",
        "deployment_decision": "from_user_input"
      },
      "outputs": {
        "sync_strategy": "sync_strategy"
      },
      "parallel_group": 2
    },
    {
      "id": "s03_mex_transactional_outbox",
      "skill_name": "mex-transactional-outbox",
      "inputs": {
        "schema_split_plan": "s01_mex_schema_ownership_split.schema_split_plan",
        "sync_strategy": "s02_mex_dual_write_or_cdc_decision.sync_strategy",
        "stack": "from_user_input",
        "database_engine": "from_user_input"
      },
      "outputs": {
        "outbox_implementation": "outbox_implementation"
      },
      "condition": "sync_strategy == 'outbox'",
      "parallel_group": 3
    },
    {
      "id": "s04_mex_cdc_debezium_postgres",
      "skill_name": "mex-cdc-debezium-postgres",
      "inputs": {
        "schema_split_plan": "s01_mex_schema_ownership_split.schema_split_plan",
        "sync_strategy": "s02_mex_dual_write_or_cdc_decision.sync_strategy"
      },
      "outputs": {
        "pg_cdc_pipeline": "pg_cdc_pipeline"
      },
      "condition": "database_engine == 'postgres' && sync_strategy == 'cdc'",
      "parallel_group": 3
    },
    {
      "id": "s05_mex_cdc_debezium_mysql",
      "skill_name": "mex-cdc-debezium-mysql",
