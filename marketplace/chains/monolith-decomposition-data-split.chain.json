      },
      "outputs": {
        "mysql_cdc_pipeline": "mysql_cdc_pipeline"
      },
      "condition": "database_engine == 'mysql' && sync_strategy == 'cdc'",
      "parallel_group": 3
    },
    {
      "id": "s06_mex_backfill_and_reconcile",
