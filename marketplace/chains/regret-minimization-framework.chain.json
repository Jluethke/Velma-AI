{
  "name": "regret-minimization-framework",
  "description": "Apply the regret minimization framework to a life or career decision. Project yourself to age 80 and ask which choice you would regret not making. Separate regret of action (tried and failed) from regret of inaction (never tried). Research consistently shows people regret inaction far more than action. This framework outperforms expected-value calculations for personal decisions because it accounts for the asymmetry of regret.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "regret-decision-framer",
      "inputs": {
        "decision-description": "from_user_input",
        "current-situation": "from_user_input"
      },
      "outputs": {
        "action-option": "action-option",
        "inaction-option": "inaction-option"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "age-80-projection",
      "inputs": {
        "action-option": "step_1.action-option",
        "inaction-option": "step_1.inaction-option"
      },
      "outputs": {
        "action-best-case": "action-best-case",
        "action-worst-case": "action-worst-case",
        "inaction-story": "inaction-story"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "regret-type-separator",
      "inputs": {
        "action-best-case": "step_2.action-best-case",
        "action-worst-case": "step_2.action-worst-case",
        "inaction-story": "step_2.inaction-story"
      },
      "outputs": {
        "action-regret-estimate": "action-regret-estimate",
        "inaction-regret-estimate": "inaction-regret-estimate"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "regret-asymmetry-adjuster",
      "inputs": {
        "action-regret-estimate": "step_3.action-regret-estimate",
        "inaction-regret-estimate": "step_3.inaction-regret-estimate"
      },
      "outputs": {
        "adjusted-regret-comparison": "adjusted-regret-comparison",
        "regret-verdict": "regret-verdict"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "regret-minimized-decision",
      "inputs": {
        "regret-verdict": "step_4.regret-verdict",
        "adjusted-regret-comparison": "step_4.adjusted-regret-comparison"
      },
      "outputs": {
        "decision": "decision",
        "accepted-regret": "accepted-regret"
      },
      "parallel_group": 5
    }
  ],
