{
  "name": "email-security-assessment",
  "description": "Assess email infrastructure security by checking authentication records, testing relay and spoofing controls, and reviewing encryption and access.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "email-spf-dkim-dmarc-check",
      "inputs": {
        "target-domains": "from_user_input",
        "email-system-info": "from_user_input"
      },
      "outputs": {
        "auth-record-findings": "auth-record-findings",
        "sending-source-map": "sending-source-map"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "email-relay-test",
      "inputs": {
        "email-system-info": "from_context.email-system-info",
        "target-domains": "from_context.target-domains"
      },
      "outputs": {
        "relay-findings": "relay-findings",
        "smtp-config-findings": "smtp-config-findings"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "email-spoofing-controls",
      "inputs": {
        "auth-record-findings": "step_1.auth-record-findings",
        "target-domains": "from_context.target-domains"
      },
      "outputs": {
        "spoofing-results": "spoofing-results",
        "header-analysis": "header-analysis"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "email-attachment-filter-test",
      "inputs": {
        "email-system-info": "from_context.email-system-info",
        "spoofing-results": "step_3.spoofing-results"
      },
      "outputs": {
        "filter-bypass-findings": "filter-bypass-findings",
        "filter-coverage-assessment": "filter-coverage-assessment"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "email-encryption-transit-check",
      "inputs": {
        "email-system-info": "from_context.email-system-info",
        "target-domains": "from_context.target-domains"
      },
      "outputs": {
        "encryption-findings": "encryption-findings",
        "downgrade-risk": "downgrade-risk"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "email-access-controls-review",
      "inputs": {
        "email-system-info": "from_context.email-system-info",
        "filter-bypass-findings": "step_4.filter-bypass-findings"
      },
      "outputs": {
        "access-findings": "access-findings",
        "delegation-map": "delegation-map"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "email-security-report",
      "inputs": {
        "auth-record-findings": "step_1.auth-record-findings",
        "spoofing-results": "step_3.spoofing-results",
        "filter-bypass-findings": "step_4.filter-bypass-findings",
        "encryption-findings": "step_5.encryption-findings"
      },
      "outputs": {
        "email-security-report": "email-security-report",
        "remediation-plan": "remediation-plan"
      },
      "parallel_group": 7
    }
  ],
