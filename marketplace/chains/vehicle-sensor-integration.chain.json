        "camera_device_report": "s03_vsens_v4l2_camera_probe.camera_device_report"
      },
      "outputs": {
        "v4l2_capture_log": "v4l2_capture_log"
      },
      "condition": "has_camera == true and stack == 'cpp'",
      "parallel_group": 5
    },
    {
      "id": "s07_vsens_py_opencv_intrinsics",
