{
  "name": "signal-extraction-workflow",
  "description": "Extract a signal from noisy measurements: characterize the noise, select and apply filters, validate the extraction, quantify improvement, and document the full processing chain.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "noise-floor-characterizer",
      "inputs": {
        "raw-signal-data": "from_user_input",
        "acquisition-metadata": "from_user_input"
      },
      "outputs": {
        "noise-profile": "noise-profile",
        "signal-band-estimate": "signal-band-estimate"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "filter-method-selector",
      "inputs": {
        "noise-profile": "step_1.noise-profile",
        "signal-band-estimate": "step_1.signal-band-estimate"
      },
      "outputs": {
        "filter-specification": "filter-specification",
        "filter-tradeoffs": "filter-tradeoffs"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "filter-application-engine",
      "inputs": {
        "raw-signal-data": "from_context.raw-signal-data",
        "filter-specification": "step_2.filter-specification"
      },
      "outputs": {
        "filtered-signal": "filtered-signal",
        "residual-noise": "residual-noise"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "extraction-validator",
      "inputs": {
        "filtered-signal": "step_3.filtered-signal",
        "residual-noise": "step_3.residual-noise"
      },
      "outputs": {
        "validation-report": "validation-report",
        "artifact-flags": "artifact-flags"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "snr-improvement-quantifier",
      "inputs": {
        "raw-signal-data": "from_context.raw-signal-data",
        "filtered-signal": "step_3.filtered-signal",
        "noise-profile": "step_1.noise-profile"
      },
      "outputs": {
        "snr-before": "snr-before",
        "snr-after": "snr-after",
        "improvement-factor": "improvement-factor"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "processing-chain-documenter",
      "inputs": {
        "filter-specification": "step_2.filter-specification",
        "validation-report": "step_4.validation-report",
        "improvement-factor": "step_5.improvement-factor"
      },
      "outputs": {
        "processing-chain-record": "processing-chain-record",
        "parameter-table": "parameter-table"
      },
      "parallel_group": 6
    }
  ],
