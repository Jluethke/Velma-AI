{
  "name": "stakeholder-influence-mapping",
  "description": "Map the people who affect a decision or project. For each: their position (supportive, neutral, or opposed), what they actually care about, what would move them, and who influences them. Then sequence your effort: convert the neutrals first (they are cheapest to move and shift the center of gravity), and only then address the opposed. Most people either ignore stakeholder dynamics entirely or spend all their energy arguing with the most vocal opponent, which is usually the worst allocation of effort.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "stake-stakeholder-identification",
      "inputs": {
        "decision-or-project": "from_user_input",
        "scope-notes": "from_user_input"
      },
      "outputs": {
        "stakeholder-list": "stakeholder-list",
        "stakeholder-roles": "stakeholder-roles"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "stake-position-classification",
      "inputs": {
        "stakeholder-list": "step_1.stakeholder-list",
        "stakeholder-roles": "step_1.stakeholder-roles"
      },
      "outputs": {
        "position-map": "position-map",
        "position-confidence": "position-confidence"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "stake-interest-mapping",
      "inputs": {
        "position-map": "step_2.position-map",
        "position-confidence": "step_2.position-confidence"
      },
      "outputs": {
        "interest-map": "interest-map",
        "stated-vs-real-interests": "stated-vs-real-interests"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "stake-lever-identification",
      "inputs": {
        "interest-map": "step_3.interest-map",
        "stated-vs-real-interests": "step_3.stated-vs-real-interests"
      },
      "outputs": {
        "movement-levers": "movement-levers",
        "lever-evidence": "lever-evidence"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
