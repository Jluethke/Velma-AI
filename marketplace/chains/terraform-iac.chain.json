        "environments": "from_user_input",
        "components": "from_user_input"
      },
      "outputs": {
        "repo_layout": "repo_layout",
        "root_modules": "root_modules"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_tf_env_strategy",
