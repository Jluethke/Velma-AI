{
  "name": "molecular-dynamics-simulation",
  "description": "Run and analyze a molecular dynamics simulation: build the system, minimize energy, equilibrate, run production, analyze trajectories, validate against experiment, and produce the MD report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "md-system-builder",
      "inputs": {
        "molecule-structure": "from_user_input",
        "simulation-goal": "from_user_input",
        "solvent-conditions": "from_user_input"
      },
      "outputs": {
        "system-topology": "system-topology",
        "force-field-selection": "force-field-selection",
        "initial-coordinates": "initial-coordinates"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "md-energy-minimization",
      "inputs": {
        "system-topology": "step_1.system-topology",
        "initial-coordinates": "step_1.initial-coordinates"
      },
      "outputs": {
        "minimized-coordinates": "minimized-coordinates",
        "minimization-log": "minimization-log"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "md-equilibration-protocol",
      "inputs": {
        "minimized-coordinates": "step_2.minimized-coordinates",
        "system-topology": "step_1.system-topology",
        "target-conditions": "from_context.target-conditions"
      },
      "outputs": {
        "equilibrated-coordinates": "equilibrated-coordinates",
        "equilibration-metrics": "equilibration-metrics"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "md-production-run",
      "inputs": {
        "equilibrated-coordinates": "step_3.equilibrated-coordinates",
        "system-topology": "step_1.system-topology",
        "simulation-goal": "from_context.simulation-goal"
      },
      "outputs": {
        "trajectory-file": "trajectory-file",
        "energy-log": "energy-log",
        "run-parameters": "run-parameters"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "md-trajectory-analysis",
      "inputs": {
        "trajectory-file": "step_4.trajectory-file",
        "system-topology": "step_1.system-topology",
        "simulation-goal": "from_context.simulation-goal"
      },
      "outputs": {
        "structural-metrics": "structural-metrics",
        "interaction-analysis": "interaction-analysis",
        "dynamic-properties": "dynamic-properties"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "md-experimental-validation",
      "inputs": {
        "structural-metrics": "step_5.structural-metrics",
        "interaction-analysis": "step_5.interaction-analysis",
        "experimental-data": "from_context.experimental-data"
      },
      "outputs": {
        "validation-report": "validation-report",
        "md-summary-report": "md-summary-report"
      },
      "parallel_group": 6
    }
  ],
