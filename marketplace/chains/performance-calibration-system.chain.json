{
  "name": "performance-calibration-system",
  "description": "Calibrate performance ratings across managers to remove bias and inconsistency. Without calibration, ratings reflect the manager more than the employee. Some managers rate everyone high. Some rate everyone low. Calibration forces managers to justify ratings with specific examples and adjusts for systematic bias.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "rating-distribution-analyzer",
      "inputs": {
        "performance-ratings-data": "from_user_input",
        "company-rating-scale": "from_user_input"
      },
      "outputs": {
        "manager-distributions": "manager-distributions",
        "systematic-bias-flags": "systematic-bias-flags"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "calibration-session-facilitator",
      "inputs": {
        "manager-distributions": "step_1.manager-distributions",
        "systematic-bias-flags": "step_1.systematic-bias-flags"
      },
      "outputs": {
        "calibrated-ratings": "calibrated-ratings",
        "calibration-notes": "calibration-notes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "bias-pattern-documenter",
      "inputs": {
        "calibrated-ratings": "step_2.calibrated-ratings",
        "calibration-notes": "step_2.calibration-notes"
      },
      "outputs": {
        "bias-pattern-report": "bias-pattern-report",
        "coaching-recommendations": "coaching-recommendations"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "calibration-cycle-improver",
      "inputs": {
        "bias-pattern-report": "step_3.bias-pattern-report",
        "coaching-recommendations": "step_3.coaching-recommendations"
      },
      "outputs": {
        "cycle-metrics": "cycle-metrics",
        "process-improvements": "process-improvements"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
