{
  "name": "invisible-cost-detector",
  "description": "Find the costs that never appear on a statement. Convert commute and upkeep time into dollars, price the opportunity cost of tied-up capital, estimate the cognitive load of complexity, and count the switching costs of lock-in. Some cheap options are expensive once every cost is counted.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "icd-decision-framer",
      "inputs": {
