      },
      "outputs": {
        "cost-ranking": "cost-ranking",
        "sticker-gap-table": "sticker-gap-table"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "icd-cost-report-writer",
      "inputs": {
        "cost-ranking": "step_6.cost-ranking",
        "sticker-gap-table": "step_6.sticker-gap-table"
      },
      "outputs": {
        "invisible-cost-report": "invisible-cost-report",
        "cheapest-true-option": "cheapest-true-option"
      },
      "parallel_group": 7
    }
