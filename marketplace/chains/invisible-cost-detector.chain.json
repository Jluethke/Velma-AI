        "options-to-compare": "from_user_input",
        "your-hourly-value": "from_user_input"
      },
      "outputs": {
        "option-set": "option-set",
        "visible-cost-table": "visible-cost-table"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "icd-time-cost-calculator",
      "inputs": {
        "option-set": "step_1.option-set",
        "visible-cost-table": "step_1.visible-cost-table",
        "your-hourly-value": "from_context.your-hourly-value"
      },
      "outputs": {
        "running-cost-with-time": "running-cost-with-time",
        "time-cost-detail": "time-cost-detail"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "icd-opportunity-cost-calculator",
      "inputs": {
        "option-set": "step_1.option-set",
        "running-cost-with-time": "step_2.running-cost-with-time"
      },
      "outputs": {
        "running-cost-with-opportunity": "running-cost-with-opportunity",
        "opportunity-cost-detail": "opportunity-cost-detail"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "icd-complexity-cost-estimator",
      "inputs": {
        "option-set": "step_1.option-set",
        "running-cost-with-opportunity": "step_3.running-cost-with-opportunity"
      },
      "outputs": {
        "running-cost-with-complexity": "running-cost-with-complexity",
        "complexity-cost-detail": "complexity-cost-detail"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "icd-switching-cost-estimator",
      "inputs": {
        "option-set": "step_1.option-set",
        "running-cost-with-complexity": "step_4.running-cost-with-complexity"
      },
      "outputs": {
        "true-cost-table": "true-cost-table",
        "switching-cost-detail": "switching-cost-detail"
      },
      "parallel_group": 5
    },
    {
