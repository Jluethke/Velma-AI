{
  "name": "diagnostic-session",
  "description": "Symptom-based vehicle diagnosis: troubleshoot the problem, analyze CAN traffic for intermittent issues, then find the parts needed for the fix.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "troubleshooter",
      "inputs": {
        "symptom": "from_user_input",
        "vehicle": "from_user_input",
        "conditions": "from_user_input"
      },
      "outputs": {
        "diagnosis": "diagnosis",
        "test_results": "test_results",
        "root_cause": "root_cause",
        "fix_plan": "fix_plan"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "can-detective",
      "inputs": {
        "baseline": "from_context.baseline",
        "vehicle": "from_context.vehicle",
        "symptom": "from_context.symptom",
        "bus": "from_context.bus"
      },
      "outputs": {
        "traffic_diff": "traffic_diff",
        "anomaly_list": "anomaly_list",
        "signal_forensics": "signal_forensics",
        "suspect_modules": "suspect_modules"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "parts-finder",
      "inputs": {
        "vehicle": "from_context.vehicle",
        "dtc_or_symptom": "from_context.dtc_or_symptom",
        "component": "from_context.component"
      },
      "outputs": {
        "component_id": "component_id",
        "oem_parts": "oem_parts",
