        "depth-method-comparison": "depth-method-comparison"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "magnetic-body-modeling",
      "inputs": {
        "rtp-anomaly": "step_2.rtp-anomaly",
        "depth-estimates": "step_4.depth-estimates",
        "geological-context": "from_context.geological-context"
      },
      "outputs": {
        "magnetic-model": "magnetic-model",
        "model-fit-report": "model-fit-report"
      },
