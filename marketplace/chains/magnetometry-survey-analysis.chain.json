      },
      "outputs": {
        "corrected-magnetic-anomaly": "corrected-magnetic-anomaly",
        "processing-log": "processing-log"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "reduction-to-pole",
      "inputs": {
        "corrected-magnetic-anomaly": "step_1.corrected-magnetic-anomaly",
        "field-parameters": "from_context.field-parameters"
      },
      "outputs": {
        "rtp-anomaly": "rtp-anomaly",
        "rtp-quality-check": "rtp-quality-check"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "magnetic-source-identification",
      "inputs": {
        "rtp-anomaly": "step_2.rtp-anomaly",
        "geological-context": "from_context.geological-context"
      },
      "outputs": {
        "source-catalog": "source-catalog",
        "derivative-maps": "derivative-maps"
      },
      "parallel_group": 3
    },
    {
