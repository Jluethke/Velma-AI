      "inputs": {
        "upgrade_scope": "s01_dup_scope_intake.upgrade_scope",
        "baseline_report": "s02_dup_baseline_snapshot.baseline_report",
        "upgrade_plan": "from_user_input_optional"
      },
      "outputs": {
        "bot_config": "bot_config"
      },
      "condition": "bot == 'renovate'",
      "parallel_group": 4
    },
    {
      "id": "s08_dup_dependabot_config",
      "skill_name": "dup-dependabot-config",
