{
  "name": "dependency-upgrades-bot-setup",
  "description": "Set up Renovate or Dependabot on a repository after a baseline and lockfile hygiene pass, with validated configuration and user-chosen schedules and limits.",
  "steps": [
    {
      "id": "s01_dup_scope_intake",
      "skill_name": "dup-scope-intake",
      "inputs": {
        "repo_path": "from_user_input",
        "stack": "from_user_input",
        "upgrade_goal": "from_user_input",
        "framework": "from_user_input_optional",
        "bot": "from_user_input_optional",
        "target_packages": "from_user_input_optional",
        "test_command": "from_user_input_optional"
      },
      "outputs": {
        "upgrade_scope": "upgrade_scope"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_dup_baseline_snapshot",
      "skill_name": "dup-baseline-snapshot",
      "inputs": {
        "upgrade_scope": "s01_dup_scope_intake.upgrade_scope"
      },
      "outputs": {
        "baseline_report": "baseline_report"
      },
      "parallel_group": 2
    },
    {
      "id": "s03_dup_py_lockfile_hygiene",
      "skill_name": "dup-py-lockfile-hygiene",
      "inputs": {
        "upgrade_scope": "s01_dup_scope_intake.upgrade_scope",
        "baseline_report": "s02_dup_baseline_snapshot.baseline_report"
      },
      "outputs": {
        "lockfile_status": "lockfile_status"
      },
      "condition": "stack == 'python'",
      "parallel_group": 3
    },
    {
      "id": "s04_dup_node_lockfile_hygiene",
      "skill_name": "dup-node-lockfile-hygiene",
      "inputs": {
        "upgrade_scope": "s01_dup_scope_intake.upgrade_scope",
        "baseline_report": "s02_dup_baseline_snapshot.baseline_report"
      },
      "outputs": {
        "lockfile_status": "lockfile_status"
      },
      "condition": "stack == 'node'",
      "parallel_group": 3
    },
    {
      "id": "s05_dup_go_module_hygiene",
      "skill_name": "dup-go-module-hygiene",
      "inputs": {
        "upgrade_scope": "s01_dup_scope_intake.upgrade_scope",
        "baseline_report": "s02_dup_baseline_snapshot.baseline_report"
      },
      "outputs": {
        "lockfile_status": "lockfile_status"
      },
      "condition": "stack == 'go'",
      "parallel_group": 3
    },
    {
      "id": "s06_dup_rust_lockfile_hygiene",
      "skill_name": "dup-rust-lockfile-hygiene",
      "inputs": {
        "upgrade_scope": "s01_dup_scope_intake.upgrade_scope",
        "baseline_report": "s02_dup_baseline_snapshot.baseline_report"
      },
      "outputs": {
        "lockfile_status": "lockfile_status"
      },
      "condition": "stack == 'rust'",
      "parallel_group": 3
    },
    {
      "id": "s07_dup_renovate_config",
