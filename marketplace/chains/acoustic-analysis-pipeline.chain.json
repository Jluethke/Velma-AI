{
  "name": "acoustic-analysis-pipeline",
  "description": "Analyze acoustic recordings: import audio, generate spectrograms, detect and classify events, extract features, compute activity indices, and produce the report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "acoustic-importer",
      "inputs": {
        "audio-files": "from_user_input",
        "deployment-log": "from_user_input"
      },
      "outputs": {
        "validated-recordings": "validated-recordings",
        "quality-flags": "quality-flags"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "acoustic-spectrogram-generator",
      "inputs": {
        "validated-recordings": "step_1.validated-recordings"
      },
      "outputs": {
        "spectrograms": "spectrograms",
        "spectrogram-parameters": "spectrogram-parameters"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "acoustic-event-detector",
      "inputs": {
        "spectrograms": "step_2.spectrograms",
        "target-species-templates": "from_context.target-species-templates"
      },
      "outputs": {
        "detected-events": "detected-events",
        "detection-summary": "detection-summary"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "acoustic-feature-extractor",
      "inputs": {
        "detected-events": "step_3.detected-events",
        "validated-recordings": "step_1.validated-recordings"
      },
      "outputs": {
        "acoustic-features": "acoustic-features",
        "feature-distributions": "feature-distributions"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "acoustic-occupancy-index",
      "inputs": {
        "detection-summary": "step_3.detection-summary",
        "acoustic-features": "step_4.acoustic-features"
      },
      "outputs": {
        "acoustic-indices": "acoustic-indices",
        "temporal-patterns": "temporal-patterns"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "acoustic-report-writer",
      "inputs": {
        "acoustic-indices": "step_5.acoustic-indices",
        "temporal-patterns": "step_5.temporal-patterns"
      },
      "outputs": {
        "acoustic-report": "acoustic-report",
        "detection-database": "detection-database"
      },
      "parallel_group": 6
    }
