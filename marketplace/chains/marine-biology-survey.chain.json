{
  "name": "marine-biology-survey",
  "description": "Conduct a marine biology survey from dive transect planning through species identification, water quality sampling, coral assessment, biodiversity indexing, and ecosystem reporting.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "dive-transect-planner",
      "inputs": {
        "study-site": "from_user_input",
        "survey-objectives": "from_user_input",
        "dive-constraints": "from_user_input"
      },
      "outputs": {
        "transect-map": "transect-map",
        "dive-plan": "dive-plan",
        "sampling-schedule": "sampling-schedule"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "species-identification-protocol",
      "inputs": {
        "transect-map": "step_1.transect-map",
        "target-taxa": "from_context.target-taxa",
        "identification-resources": "from_context.identification-resources"
      },
      "outputs": {
        "species-list": "species-list",
        "photo-vouchers": "photo-vouchers",
        "unidentified-specimens": "unidentified-specimens"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "water-quality-sampler",
      "inputs": {
        "sampling-schedule": "step_1.sampling-schedule",
        "instrument-list": "from_context.instrument-list",
        "parameter-targets": "from_context.parameter-targets"
      },
      "outputs": {
        "water-quality-data": "water-quality-data",
        "nutrient-samples": "nutrient-samples",
        "calibration-log": "calibration-log"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "coral-health-assessor",
      "inputs": {
        "transect-map": "step_1.transect-map",
        "species-list": "step_2.species-list",
        "baseline-data": "from_context.baseline-data"
      },
      "outputs": {
        "bleaching-assessment": "bleaching-assessment",
        "disease-prevalence": "disease-prevalence",
        "recruitment-counts": "recruitment-counts"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "biodiversity-index-calculator",
      "inputs": {
        "species-list": "step_2.species-list",
        "site-metadata": "from_context.site-metadata",
        "comparison-datasets": "from_context.comparison-datasets"
      },
      "outputs": {
        "diversity-indices": "diversity-indices",
        "beta-diversity": "beta-diversity",
        "rarefaction-curves": "rarefaction-curves"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "marine-ecosystem-reporter",
      "inputs": {
        "diversity-indices": "step_5.diversity-indices",
        "water-quality-data": "step_3.water-quality-data",
        "coral-health-data": "from_context.coral-health-data"
      },
      "outputs": {
        "ecosystem-report": "ecosystem-report",
        "data-archive": "data-archive",
        "management-brief": "management-brief"
      },
      "parallel_group": 6
    }
  ],
