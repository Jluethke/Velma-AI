{
  "name": "contract-review-process",
  "description": "Review a business contract from initial read through redline to review memo.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "contract-full-read",
      "inputs": {
        "contract-text": "from_user_input",
        "party-name": "from_user_input"
      },
      "outputs": {
        "section-inventory": "section-inventory",
        "contract-summary": "contract-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "key-terms-identifier",
      "inputs": {
        "contract-text": "from_context.contract-text",
        "section-inventory": "step_1.section-inventory"
      },
      "outputs": {
        "key-terms-summary": "key-terms-summary",
        "commercial-terms": "commercial-terms"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "risk-clause-flagger",
      "inputs": {
        "contract-text": "from_context.contract-text",
        "key-terms-summary": "step_2.key-terms-summary"
      },
      "outputs": {
        "risk-flags": "risk-flags",
        "risk-score": "risk-score"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "missing-protections-checker",
      "inputs": {
        "section-inventory": "step_1.section-inventory",
        "risk-flags": "step_3.risk-flags"
      },
      "outputs": {
        "missing-protections": "missing-protections",
        "gap-priority": "gap-priority"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "standard-terms-comparator",
      "inputs": {
        "key-terms-summary": "step_2.key-terms-summary",
        "risk-flags": "step_3.risk-flags",
        "missing-protections": "step_4.missing-protections"
      },
      "outputs": {
        "deviation-list": "deviation-list",
        "negotiation-priorities": "negotiation-priorities"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "contract-redline-drafter",
      "inputs": {
        "deviation-list": "step_5.deviation-list",
        "negotiation-priorities": "step_5.negotiation-priorities"
      },
      "outputs": {
        "redline-document": "redline-document",
        "change-rationale": "change-rationale"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "contract-review-memo-writer",
      "inputs": {
        "key-terms-summary": "step_2.key-terms-summary",
        "risk-flags": "step_3.risk-flags",
        "redline-document": "step_6.redline-document"
      },
      "outputs": {
        "review-memo": "review-memo",
        "approval-recommendation": "approval-recommendation"
      },
      "parallel_group": 7
    }
  ],
