{
  "name": "retention-lever-finder",
  "description": "Find the real levers of retention. Exit interviews are unreliable because people leaving soften the real reason. Survey current employees anonymously, cross-reference with departure data, and separate the stated reason from the real driver. Compensation is the stated reason roughly 70 percent of the time but the real driver only about 30 percent of the time, so fix the real drivers.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "departure-data-assembler",
      "inputs": {
        "departure-records": "from_user_input",
        "analysis-window": "from_user_input"
      },
      "outputs": {
        "coded-departure-data": "coded-departure-data",
        "departure-clusters": "departure-clusters"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "anonymous-pulse-survey-designer",
      "inputs": {
        "coded-departure-data": "step_1.coded-departure-data",
        "departure-clusters": "step_1.departure-clusters"
      },
      "outputs": {
        "pulse-survey": "pulse-survey",
        "anonymity-protocol": "anonymity-protocol"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "stated-reason-vs-real-driver-separator",
      "inputs": {
        "pulse-survey": "step_2.pulse-survey",
        "anonymity-protocol": "step_2.anonymity-protocol"
      },
      "outputs": {
        "stated-vs-driver-table": "stated-vs-driver-table",
        "driver-hypotheses": "driver-hypotheses"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "driver-impact-ranker",
      "inputs": {
        "stated-vs-driver-table": "step_3.stated-vs-driver-table",
        "driver-hypotheses": "step_3.driver-hypotheses"
      },
      "outputs": {
        "ranked-drivers": "ranked-drivers",
        "cost-of-inaction": "cost-of-inaction"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "retention-lever-selector",
      "inputs": {
        "ranked-drivers": "step_4.ranked-drivers",
        "cost-of-inaction": "step_4.cost-of-inaction"
      },
      "outputs": {
        "selected-levers": "selected-levers",
        "feasibility-notes": "feasibility-notes"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "lever-intervention-planner",
      "inputs": {
        "selected-levers": "step_5.selected-levers",
        "feasibility-notes": "step_5.feasibility-notes"
      },
      "outputs": {
        "intervention-plan": "intervention-plan",
        "success-metrics": "success-metrics"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "retention-outcome-tracker",
      "inputs": {
        "intervention-plan": "step_6.intervention-plan",
        "success-metrics": "step_6.success-metrics"
      },
      "outputs": {
        "outcome-report": "outcome-report",
        "revised-driver-hypotheses": "revised-driver-hypotheses"
      },
      "parallel_group": 7
    }
  ],
