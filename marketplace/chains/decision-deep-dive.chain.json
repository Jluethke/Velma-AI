      "field_mapping": "contradiction_report -> decision_statement; contradiction_report -> options; contradiction_report -> criteria; contradiction_report -> constraints; contradiction_report -> context; contradiction_report -> past_decisions"
    },
    {
      "from_step": "step_3",
      "to_step": "step_4",
      "data_type": "filtered_feed",
      "field_mapping": "filtered_feed -> input"
    },
    {
      "from_step": "step_4",
