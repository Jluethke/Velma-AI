      "field_mapping": "decision_matrix -> swot_inputs; decision_matrix -> business_context; decision_matrix -> resource_constraints; decision_matrix -> strategic_goals"
    }
  ],
  "entry_inputs": [
    "input"
  ],
  "terminal_outputs": [
