{
  "name": "decision-deep-dive",
  "description": "Make a major decision with full analysis: research the topic, find contradictions, filter signal from noise, analyze the decision, and build a SWOT action plan.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "research-synthesizer",
      "inputs": {
        "research_question": "from_context.research_question",
        "source_types": "from_context.source_types",
        "depth_level": "from_context.depth_level",
        "existing_knowledge": "from_context.existing_knowledge",
        "constraints": "from_context.constraints"
      },
      "outputs": {
        "executive_summary": "object",
        "detailed_findings": "object",
        "source_credibility_scores": "object",
        "confidence_levels": "object",
        "knowledge_gaps": "object",
        "contradiction_report": "object"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "contradiction-finder",
      "inputs": {
        "claims": "step_1.executive_summary",
        "documents": "step_1.executive_summary",
        "context": "step_1.executive_summary",
        "resolution_history": "step_1.executive_summary"
      },
      "outputs": {
        "contradiction_report": "contradiction_report_data",
        "conflict_scores": "conflict_scores_data",
        "conflicting_pairs": "conflicting_pairs_data",
        "shared_context": "shared_context_data",
        "resolution_suggestions": "resolution_suggestions_data",
        "consistency_score": "consistency_score_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "signal-noise-filter",
      "inputs": {
        "information_stream": "step_1.executive_summary",
        "user_context": "step_1.executive_summary",
        "priority_framework": "step_1.executive_summary",
        "signal_history": "step_1.executive_summary",
        "source_reliability_map": "step_1.executive_summary"
      },
      "outputs": {
        "filtered_feed": "filtered_feed_data",
        "signal_list": "signal_list_data",
        "noise_list": "noise_list_data",
        "weak_signals": "weak_signals_data",
        "priority_rankings": "priority_rankings_data",
        "filter_adaptation_log": "filter_adaptation_log_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_4",
      "skill_name": "decision-analyzer",
      "inputs": {
        "decision_statement": "step_2.contradiction_report",
        "options": "step_2.contradiction_report",
        "criteria": "step_2.contradiction_report",
        "constraints": "step_2.contradiction_report",
        "context": "step_2.contradiction_report",
        "past_decisions": "step_2.contradiction_report"
      },
      "outputs": {
        "decision_matrix": "decision_matrix_data",
        "tradeoff_visualization": "tradeoff_visualization_data",
        "recommended_action": "recommended_action_data",
        "confidence_level": "confidence_level_data",
        "risk_assessment": "risk_assessment_data",
        "decision_journal_entry": "decision_journal_entry_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_5",
      "skill_name": "swot-action-planner",
      "inputs": {
        "swot_inputs": "step_4.decision_matrix",
        "business_context": "step_4.decision_matrix",
        "resource_constraints": "step_4.decision_matrix",
        "strategic_goals": "step_4.decision_matrix"
      },
      "outputs": {
        "swot_matrix": "swot_matrix_data",
        "tows_strategies": "tows_strategies_data",
        "prioritized_actions": "prioritized_actions_data",
        "action_plan": "action_plan_data"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "result",
      "field_mapping": "result -> claims; result -> documents; result -> context; result -> resolution_history"
    },
    {
      "from_step": "step_1",
      "to_step": "step_3",
