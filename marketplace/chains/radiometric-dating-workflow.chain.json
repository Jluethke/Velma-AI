{
  "name": "radiometric-dating-workflow",
  "description": "Date a geological or archaeological sample using radiometric methods from system selection through measurement, correction, age calculation, and quality assessment.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "dating-system-selector",
      "inputs": {
        "sample-description": "from_user_input",
        "expected-age-range": "from_user_input",
        "available-material": "from_user_input"
      },
      "outputs": {
        "dating-system": "dating-system",
        "system-rationale": "system-rationale"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "radiometric-sample-preparer",
      "inputs": {
        "dating-system": "step_1.dating-system",
        "sample-description": "from_context.sample-description"
      },
      "outputs": {
        "prepared-aliquot": "prepared-aliquot",
        "preparation-log": "preparation-log"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "isotope-ratio-measurer",
      "inputs": {
        "prepared-aliquot": "step_2.prepared-aliquot",
        "dating-system": "step_1.dating-system"
      },
      "outputs": {
        "measured-ratios": "measured-ratios",
        "measurement-conditions": "measurement-conditions"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "radiometric-correction-applier",
      "inputs": {
        "measured-ratios": "step_3.measured-ratios",
        "preparation-log": "step_2.preparation-log"
      },
      "outputs": {
        "corrected-ratios": "corrected-ratios",
        "correction-summary": "correction-summary"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "radiometric-age-calculator",
      "inputs": {
        "corrected-ratios": "step_4.corrected-ratios",
        "dating-system": "step_1.dating-system"
      },
      "outputs": {
        "calculated-age": "calculated-age",
        "concordance-assessment": "concordance-assessment"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "open-system-assessor",
      "inputs": {
        "calculated-age": "step_5.calculated-age",
        "concordance-assessment": "step_5.concordance-assessment",
        "sample-description": "from_context.sample-description"
      },
      "outputs": {
        "system-integrity-verdict": "system-integrity-verdict",
        "geochronology-report": "geochronology-report"
      },
      "parallel_group": 6
    }
  ],
