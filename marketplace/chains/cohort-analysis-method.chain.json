{
  "name": "cohort-analysis-method",
  "description": "Track groups over time instead of looking at aggregate averages. Aggregate averages hide everything: improving cohorts can produce a flat average if the mix shifts. This chain teaches the cohort method that reveals the trends averages obscure.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "cohort-dimension-selector",
      "inputs": {
        "analysis-question": "from_user_input",
        "available-data": "from_user_input"
      },
      "outputs": {
        "cohort-dimension": "cohort-dimension",
        "cohort-metric": "cohort-metric"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "cohort-table-builder",
      "inputs": {
        "cohort-dimension": "step_1.cohort-dimension",
        "cohort-metric": "step_1.cohort-metric"
      },
      "outputs": {
        "cohort-table": "cohort-table",
        "cohort-sizes": "cohort-sizes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "cohort-curve-comparison",
      "inputs": {
        "cohort-table": "step_2.cohort-table",
        "cohort-sizes": "step_2.cohort-sizes"
      },
      "outputs": {
        "cohort-comparison": "cohort-comparison",
        "inflection-points": "inflection-points"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cohort-insight-extractor",
      "inputs": {
        "cohort-comparison": "step_3.cohort-comparison",
        "inflection-points": "step_3.inflection-points"
      },
      "outputs": {
        "cohort-insights": "cohort-insights",
        "recommended-actions": "recommended-actions"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "aggregate-vs-cohort-reconciler",
      "inputs": {
        "cohort-insights": "step_4.cohort-insights",
        "analysis-question": "from_context.analysis-question"
      },
      "outputs": {
        "reconciled-narrative": "reconciled-narrative",
        "cohort-analysis-report": "cohort-analysis-report"
      },
      "parallel_group": 5
    }
  ],
  "edges": [
