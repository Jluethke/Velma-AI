{
  "name": "culture-add-not-culture-fit",
  "description": "Hire for what the team is missing, not for who already fits. Culture fit produces teams that agree on everything and share the same blind spots. Culture add produces teams that challenge each other. Map the team's strengths and gaps, define the culture-add profile, and evaluate candidates on what they bring that the team is short on.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "team-strength-gap-mapper",
      "inputs": {
        "team-roster": "from_user_input",
        "team-mission": "from_user_input"
      },
      "outputs": {
        "strength-gap-map": "strength-gap-map",
        "uniformity-flags": "uniformity-flags"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "culture-add-profile-definer",
      "inputs": {
        "strength-gap-map": "step_1.strength-gap-map",
        "uniformity-flags": "step_1.uniformity-flags"
      },
      "outputs": {
