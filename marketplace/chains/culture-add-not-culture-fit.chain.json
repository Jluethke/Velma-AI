        "blind-spot-examples": "blind-spot-examples"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "add-based-screening-criteria-builder",
      "inputs": {
        "culture-add-profile": "step_2.culture-add-profile",
        "blind-spot-examples": "step_2.blind-spot-examples"
      },
      "outputs": {
        "add-criteria": "add-criteria",
        "add-screening-questions": "add-screening-questions"
      },
      "parallel_group": 3
    },
    {
