{
  "name": "design-for-manufacturability-review",
  "description": "Run a design-for-manufacturability review from a structured checklist through tolerance stackup and process-capability assessment to cost-driver and supplier feedback, so a design is cheap and repeatable to make before it is released.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "dfm-checklist-review",
      "inputs": {
        "design-package": "from_user_input",
        "process-constraints": "from_user_input"
      },
      "outputs": {
        "dfm-findings": "dfm-findings",
        "standardization-opportunities": "standardization-opportunities"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "mechanical-tolerance-stackup",
      "inputs": {
        "dfm-findings": "step_1.dfm-findings",
        "assembly-definition": "from_context.assembly-definition"
      },
      "outputs": {
        "stackup-result": "stackup-result",
        "tolerance-allocation": "tolerance-allocation"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "manufacturing-process-capability",
      "inputs": {
        "tolerance-allocation": "step_2.tolerance-allocation",
        "process-data": "from_context.process-data"
      },
      "outputs": {
        "capability-assessment": "capability-assessment",
        "process-controls": "process-controls"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cost-driver-and-supplier-feedback",
      "inputs": {
        "capability-assessment": "step_3.capability-assessment",
        "supplier-input": "from_context.supplier-input"
      },
      "outputs": {
        "cost-drivers": "cost-drivers",
        "design-changes": "design-changes"
      },
      "parallel_group": 4
    }
  ],
