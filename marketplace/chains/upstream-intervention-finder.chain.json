{
  "name": "upstream-intervention-finder",
  "description": "Find the upstream intervention point where a small change prevents a large downstream problem. Most firefighting happens because nobody fixed the upstream cause. Map the causal chain from symptom to root, then intervene at the highest leverage point.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "symptom-inventory",
      "inputs": {
        "current-problems": "from_user_input",
        "frequency-data": "from_user_input"
      },
      "outputs": {
        "symptom-list": "symptom-list",
        "total-firefighting-cost": "total-firefighting-cost"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "causal-chain-mapping",
      "inputs": {
        "symptom-list": "step_1.symptom-list",
        "total-firefighting-cost": "step_1.total-firefighting-cost"
      },
      "outputs": {
        "causal-chains": "causal-chains",
        "common-roots": "common-roots"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "leverage-point-scoring",
      "inputs": {
        "causal-chains": "step_2.causal-chains",
        "common-roots": "step_2.common-roots"
      },
      "outputs": {
        "scored-interventions": "scored-interventions",
        "top-intervention": "top-intervention"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "upstream-fix-implementation",
      "inputs": {
        "top-intervention": "step_3.top-intervention",
        "symptom-list": "step_1.symptom-list"
      },
      "outputs": {
        "fix-implementation": "fix-implementation",
        "symptom-tracking-plan": "symptom-tracking-plan"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "next-intervention-cycle",
      "inputs": {
        "fix-implementation": "step_4.fix-implementation",
        "symptom-tracking-plan": "step_4.symptom-tracking-plan"
      },
      "outputs": {
        "updated-symptom-list": "updated-symptom-list",
        "next-intervention": "next-intervention"
      },
      "parallel_group": 5
    }
  ],
