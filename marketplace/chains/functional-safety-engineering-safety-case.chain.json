      "inputs": {
        "safety_goals": "from_user_input",
        "safety_requirements": "from_user_input",
        "repo_dir": "from_user_input"
      },
      "outputs": {
        "doorstop_trace_report": "doorstop_trace_report"
      },
      "condition": "trace_tool == 'doorstop'",
      "parallel_group": 1
    },
    {
      "id": "s02_fusa_trace_sphinx_needs",
      "skill_name": "fusa-trace-sphinx-needs",
      "inputs": {
        "safety_goals": "from_user_input",
        "safety_requirements": "from_user_input",
        "repo_dir": "from_user_input"
      },
      "outputs": {
        "needs_trace_report": "needs_trace_report"
      },
      "condition": "trace_tool == 'sphinx-needs'",
      "parallel_group": 1
    },
    {
      "id": "s03_fusa_gsn_safety_case_gsn2x",
      "skill_name": "fusa-gsn-safety-case-gsn2x",
      "inputs": {
