{
  "name": "web-server-hardening",
  "description": "Harden a web server by disabling unnecessary modules, setting security headers, and configuring TLS.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "web-module-disabler",
      "inputs": {
        "web-server-type": "from_user_input",
        "application-requirements": "from_user_input"
      },
      "outputs": {
        "module-config": "module-config",
        "module-change-log": "module-change-log"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "web-security-header-configurator",
      "inputs": {
        "web-server-type": "from_context.web-server-type",
        "application-requirements": "from_context.application-requirements"
      },
      "outputs": {
        "header-config": "header-config",
        "header-test-results": "header-test-results"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "web-tls-configurator",
      "inputs": {
        "web-server-type": "from_context.web-server-type",
        "header-config": "step_2.header-config"
      },
      "outputs": {
        "tls-config": "tls-config",
        "tls-test-results": "tls-test-results"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "web-version-disclosure-remover",
      "inputs": {
        "web-server-type": "from_context.web-server-type",
        "tls-config": "step_3.tls-config"
      },
      "outputs": {
        "disclosure-config": "disclosure-config",
        "disclosure-test": "disclosure-test"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "web-request-limit-setter",
      "inputs": {
        "web-server-type": "from_context.web-server-type",
        "application-requirements": "from_context.application-requirements"
      },
      "outputs": {
        "limit-config": "limit-config",
        "limit-test-results": "limit-test-results"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "web-file-permission-setter",
      "inputs": {
        "web-server-type": "from_context.web-server-type",
        "module-config": "step_1.module-config"
      },
      "outputs": {
        "permission-config": "permission-config",
        "permission-change-log": "permission-change-log"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "web-server-hardening-reporter",
      "inputs": {
        "web-server-type": "from_context.web-server-type",
        "tls-test-results": "step_3.tls-test-results"
      },
      "outputs": {
        "hardening-report": "hardening-report",
        "compliance-score": "compliance-score"
      },
      "parallel_group": 7
    }
  ],
