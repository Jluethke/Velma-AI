{
  "name": "something-went-wrong",
  "description": "Something broke, failed, or went sideways. Run a blameless post-mortem, identify the risks you missed, build a prevention checklist, and draft the communication to stakeholders. For project failures, lost deals, outages, missed deadlines, and events that didn't go as planned.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "post-mortem-runner",
      "inputs": {
        "event_description": "from_user_input",
        "event_outcome": "from_user_input",
        "timeline": "from_user_input",
        "people_involved": "from_user_input",
        "severity": "from_user_input",
        "event_type": "from_user_input"
      },
      "outputs": {
        "post_mortem_report": "post_mortem_report_data",
        "root_cause_chain": "root_cause_chain_data",
        "action_items": "action_items_data",
        "stakeholder_summary": "stakeholder_summary_data",
        "prevention_checklist": "prevention_checklist_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "risk-assessor",
      "inputs": {
        "plan_description": "step_1.post_mortem_report",
        "plan_type": "step_1.post_mortem_report",
        "stakeholders": "step_1.post_mortem_report",
        "time_horizon": "step_1.post_mortem_report",
        "risk_appetite": "step_1.post_mortem_report",
        "known_risks": "step_1.post_mortem_report"
      },
      "outputs": {
        "risk_register": "risk_register_data",
        "risk_matrix": "risk_matrix_data",
        "top_risks": "top_risks_data",
        "monitoring_plan": "monitoring_plan_data",
        "hidden_risks": "hidden_risks_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "checklist-builder",
      "inputs": {
        "goal_or_event": "step_1.post_mortem_report",
        "deadline": "step_1.post_mortem_report",
        "constraints": "step_1.post_mortem_report",
        "experience_level": "step_1.post_mortem_report"
      },
      "outputs": {
        "checklist": "checklist_data",
        "timeline": "timeline_data",
        "dont_forget": "dont_forget_data",
        "dependencies": "dependencies_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "email-writer",
      "inputs": {
        "situation": "step_1.post_mortem_report",
        "recipient": "step_1.post_mortem_report",
        "goal": "step_1.post_mortem_report",
        "tone": "step_1.post_mortem_report",
        "constraints": "step_1.post_mortem_report"
      },
      "outputs": {
        "email_draft": "email_draft_data",
        "tone_check": "tone_check_data",
        "alternatives": "alternatives_data",
        "follow_up_suggestion": "follow_up_suggestion_data"
      },
      "parallel_group": 2
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "post_mortem_report",
      "field_mapping": "post_mortem_report -> plan_description; post_mortem_report -> plan_type; post_mortem_report -> stakeholders; post_mortem_report -> time_horizon; post_mortem_report -> risk_appetite; post_mortem_report -> known_risks"
