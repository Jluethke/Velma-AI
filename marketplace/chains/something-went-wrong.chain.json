    },
    {
      "from_step": "step_2",
      "to_step": "step_3",
      "data_type": "risk_register",
      "field_mapping": "risk_register -> input"
    },
    {
      "from_step": "step_1",
      "to_step": "step_4",
      "data_type": "post_mortem_report",
      "field_mapping": "post_mortem_report -> situation; post_mortem_report -> recipient; post_mortem_report -> goal; post_mortem_report -> tone; post_mortem_report -> constraints"
    }
  ],
  "entry_inputs": [
    "event_description",
    "event_outcome",
    "event_type",
    "people_involved",
    "severity",
    "timeline"
  ],
  "terminal_outputs": [
