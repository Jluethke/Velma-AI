{
  "name": "windows-server-hardening",
  "description": "Apply security hardening to a Windows Server following CIS benchmarks or STIG guidelines.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "cis-benchmark-selector",
      "inputs": {
        "server-version": "from_user_input",
        "server-role": "from_user_input"
      },
      "outputs": {
        "benchmark-profile": "benchmark-profile",
        "baseline-scan": "baseline-scan"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "windows-service-disabler",
      "inputs": {
        "benchmark-profile": "step_1.benchmark-profile",
        "server-role": "from_context.server-role"
      },
      "outputs": {
        "disabled-services-list": "disabled-services-list",
        "service-change-log": "service-change-log"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "windows-firewall-configurator",
      "inputs": {
        "server-role": "from_context.server-role",
        "benchmark-profile": "step_1.benchmark-profile"
      },
      "outputs": {
        "firewall-ruleset": "firewall-ruleset",
        "firewall-change-log": "firewall-change-log"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "windows-account-policy-setter",
      "inputs": {
        "benchmark-profile": "step_1.benchmark-profile",
        "baseline-scan": "step_1.baseline-scan"
      },
      "outputs": {
        "account-policy-config": "account-policy-config",
        "policy-change-log": "policy-change-log"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "windows-audit-logger",
      "inputs": {
        "benchmark-profile": "step_1.benchmark-profile",
        "server-role": "from_context.server-role"
      },
      "outputs": {
        "audit-policy-config": "audit-policy-config",
        "log-retention-config": "log-retention-config"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "windows-default-account-remover",
      "inputs": {
        "account-policy-config": "step_4.account-policy-config",
