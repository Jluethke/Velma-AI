      },
      "outputs": {
        "account-remediation-log": "account-remediation-log",
        "remaining-accounts": "remaining-accounts"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "windows-hardening-reporter",
      "inputs": {
        "baseline-scan": "step_1.baseline-scan",
        "benchmark-profile": "step_1.benchmark-profile"
