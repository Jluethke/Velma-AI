{
  "name": "compound-effect-modeler",
  "description": "Model the compound effect of small changes over time. A 1% daily improvement compounds to 37x in a year. Build the model for any metric, show 1, 5, and 10 year projections, and identify which small improvements have the highest absolute impact.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "metric-baseline-capturer",
      "inputs": {
        "metric-to-model": "from_user_input",
        "metric-history": "from_user_input"
      },
      "outputs": {
        "baseline-value": "baseline-value",
        "current-growth-rate": "current-growth-rate",
        "compounding-frequency": "compounding-frequency"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "scenario-projector",
      "inputs": {
        "baseline-value": "step_1.baseline-value",
        "current-growth-rate": "step_1.current-growth-rate",
        "compounding-frequency": "step_1.compounding-frequency"
      },
      "outputs": {
        "projection-table": "projection-table",
        "divergence-points": "divergence-points"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "improvement-lever-finder",
      "inputs": {
        "metric-to-model": "from_context.metric-to-model",
        "projection-table": "step_2.projection-table"
      },
      "outputs": {
        "lever-ranking": "lever-ranking",
        "highest-impact-lever": "highest-impact-lever"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "compound-effect-report-builder",
      "inputs": {
        "projection-table": "step_2.projection-table",
        "lever-ranking": "step_3.lever-ranking",
        "divergence-points": "step_2.divergence-points"
      },
      "outputs": {
        "compound-effect-report": "compound-effect-report",
        "tracking-protocol": "tracking-protocol"
      },
      "parallel_group": 4
    }
  ],
