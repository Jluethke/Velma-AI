      "skill_name": "mda-spend-inventory-builder",
      "inputs": {
        "spending-context": "from_user_input",
        "time-period": "from_user_input"
      },
      "outputs": {
        "spend-inventory": "spend-inventory",
        "baseline-totals": "baseline-totals"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "mda-add-dollar-tester",
      "inputs": {
        "spend-inventory": "step_1.spend-inventory"
      },
      "outputs": {
        "add-value-scores": "add-value-scores",
        "high-add-lines": "high-add-lines"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "mda-cut-dollar-tester",
      "inputs": {
        "spend-inventory": "step_1.spend-inventory",
        "baseline-totals": "step_1.baseline-totals"
      },
      "outputs": {
        "cut-pain-scores": "cut-pain-scores",
        "low-pain-lines": "low-pain-lines"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "mda-priority-ranker",
      "inputs": {
        "add-value-scores": "step_2.add-value-scores",
        "cut-pain-scores": "step_3.cut-pain-scores"
      },
      "outputs": {
        "priority-ranking": "priority-ranking",
        "reallocation-candidates": "reallocation-candidates"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "mda-reallocation-planner",
