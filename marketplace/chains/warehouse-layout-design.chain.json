      },
      "outputs": {
        "pick-path-design": "pick-path-design",
        "pick-time-estimate": "pick-time-estimate"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "returns-staging-allocator",
      "inputs": {
        "zone-definitions": "step_2.zone-definitions",
        "zone-adjacency-map": "step_2.zone-adjacency-map"
      },
      "outputs": {
        "returns-layout": "returns-layout",
        "staging-plan": "staging-plan"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "warehouse-layout-finalizer",
      "inputs": {
        "rack-plan": "step_3.rack-plan",
        "pick-path-design": "step_4.pick-path-design",
        "returns-layout": "step_5.returns-layout"
      },
      "outputs": {
        "warehouse-layout-plan": "warehouse-layout-plan",
        "capacity-summary": "capacity-summary"
      },
      "parallel_group": 6
    }
