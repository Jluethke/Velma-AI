      "outputs": {
        "abc-classification": "abc-classification",
        "movement-patterns": "movement-patterns"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "storage-zone-designer",
      "inputs": {
        "abc-classification": "step_1.abc-classification",
        "movement-patterns": "step_1.movement-patterns"
      },
      "outputs": {
        "zone-definitions": "zone-definitions",
        "zone-adjacency-map": "zone-adjacency-map"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "rack-aisle-configurator",
      "inputs": {
        "zone-definitions": "step_2.zone-definitions",
        "product-catalog": "from_context.product-catalog"
      },
      "outputs": {
        "rack-plan": "rack-plan",
        "aisle-specifications": "aisle-specifications"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "pick-path-optimizer",
      "inputs": {
        "zone-definitions": "step_2.zone-definitions",
