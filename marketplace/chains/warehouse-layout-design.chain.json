{
  "name": "warehouse-layout-design",
  "description": "Design a warehouse layout from product analysis through zone definition to pick path optimization.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "product-velocity-analyzer",
      "inputs": {
        "product-catalog": "from_user_input",
        "order-history": "from_user_input"
