{
  "name": "financial-stress-test-simulator",
  "description": "Model your finances under 3 adverse scenarios: income shock (largest source drops 50%), expense shock (major unexpected cost at 3x your largest monthly expense), and rate shock (all variable rates increase 200 basis points). Calculate months to zero, required cuts, and recovery timeline. Identical methodology for personal and enterprise.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "financial-baseline-builder",
      "inputs": {
        "financial-snapshot": "from_user_input",
        "entity-type": "from_user_input"
      },
      "outputs": {
        "baseline-model": "baseline-model",
        "baseline-runway": "baseline-runway"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "income-shock-simulator",
      "inputs": {
        "baseline-model": "step_1.baseline-model"
      },
      "outputs": {
        "income-shock-result": "income-shock-result",
        "income-shock-cut-list": "income-shock-cut-list"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "expense-shock-simulator",
      "inputs": {
        "baseline-model": "step_1.baseline-model"
      },
      "outputs": {
        "expense-shock-result": "expense-shock-result",
        "expense-shock-funding-plan": "expense-shock-funding-plan"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "rate-shock-simulator",
      "inputs": {
        "baseline-model": "step_1.baseline-model"
      },
      "outputs": {
        "rate-shock-result": "rate-shock-result",
        "rate-shock-exposure": "rate-shock-exposure"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "combined-stress-scenario",
      "inputs": {
        "income-shock-result": "step_2.income-shock-result",
        "expense-shock-result": "step_3.expense-shock-result",
        "rate-shock-result": "step_4.rate-shock-result"
      },
      "outputs": {
        "combined-stress-result": "combined-stress-result",
        "financial-resilience-score": "financial-resilience-score"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "stress-test-action-plan",
      "inputs": {
        "combined-stress-result": "step_5.combined-stress-result",
        "financial-resilience-score": "step_5.financial-resilience-score",
        "income-shock-cut-list": "step_2.income-shock-cut-list"
      },
      "outputs": {
        "resilience-improvement-plan": "resilience-improvement-plan",
        "stress-test-report": "stress-test-report"
      },
      "parallel_group": 6
    }
  ],
