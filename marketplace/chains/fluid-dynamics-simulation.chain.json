{
  "name": "fluid-dynamics-simulation",
  "description": "Set up and analyze a computational fluid dynamics simulation from geometry definition through validation against experimental data.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "cfd-geometry-mesher",
      "inputs": {
        "geometry-definition": "from_user_input",
        "flow-conditions": "from_user_input"
      },
      "outputs": {
        "computational-mesh": "computational-mesh",
        "mesh-quality-report": "mesh-quality-report"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "turbulence-model-selector",
      "inputs": {
        "flow-conditions": "from_context.flow-conditions",
        "mesh-quality-report": "step_1.mesh-quality-report"
      },
      "outputs": {
        "turbulence-model-config": "turbulence-model-config",
        "model-justification": "model-justification"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "cfd-boundary-condition-setter",
      "inputs": {
        "computational-mesh": "step_1.computational-mesh",
        "flow-conditions": "from_context.flow-conditions"
      },
      "outputs": {
        "boundary-setup": "boundary-setup",
        "initial-conditions": "initial-conditions"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cfd-solver-runner",
      "inputs": {
        "computational-mesh": "step_1.computational-mesh",
        "boundary-setup": "step_3.boundary-setup",
        "turbulence-model-config": "step_2.turbulence-model-config"
      },
      "outputs": {
        "converged-solution": "converged-solution",
        "convergence-history": "convergence-history"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "flow-quantity-extractor",
      "inputs": {
        "converged-solution": "step_4.converged-solution",
        "extraction-plan": "from_context.extraction-plan"
      },
      "outputs": {
        "extracted-quantities": "extracted-quantities",
        "flow-visualizations": "flow-visualizations"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "cfd-experimental-validator",
      "inputs": {
        "extracted-quantities": "step_5.extracted-quantities",
        "experimental-data": "from_context.experimental-data"
      },
      "outputs": {
        "validation-metrics": "validation-metrics",
        "discrepancy-analysis": "discrepancy-analysis"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "cfd-simulation-report-writer",
      "inputs": {
        "validation-metrics": "step_6.validation-metrics",
        "flow-visualizations": "step_5.flow-visualizations",
        "convergence-history": "step_4.convergence-history"
      },
      "outputs": {
        "simulation-report": "simulation-report",
        "lessons-learned": "lessons-learned"
      },
      "parallel_group": 7
    }
