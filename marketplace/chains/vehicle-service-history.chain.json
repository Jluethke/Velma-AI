{
  "name": "vehicle-service-history",
  "description": "Maintain vehicle service history records, track the manufacturer maintenance schedule, and generate upcoming service reminders.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "service-visit-recorder",
      "inputs": {
        "vehicle-identifier": "from_user_input",
        "service-details": "from_user_input"
      },
      "outputs": {
        "service-record": "service-record",
        "updated-history": "updated-history"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "maintenance-schedule-tracker",
      "inputs": {
        "updated-history": "step_1.updated-history",
        "vehicle-identifier": "from_context.vehicle-identifier"
      },
      "outputs": {
        "schedule-status": "schedule-status",
        "next-services": "next-services"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "service-reminder-generator",
      "inputs": {
        "schedule-status": "step_2.schedule-status",
        "next-services": "step_2.next-services"
      },
      "outputs": {
        "reminder-list": "reminder-list",
        "reminder-messages": "reminder-messages"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "vehicle-history-report-builder",
      "inputs": {
        "updated-history": "step_1.updated-history",
        "schedule-status": "step_2.schedule-status"
      },
      "outputs": {
        "history-report": "history-report",
        "vehicle-health-summary": "vehicle-health-summary"
      },
      "parallel_group": 4
    }
  ],
