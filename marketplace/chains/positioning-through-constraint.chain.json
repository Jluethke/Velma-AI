{
  "name": "positioning-through-constraint",
  "description": "Position by what you refuse to do. A subtractive claim is more memorable than an additive one. State the tradeoffs you chose on purpose, which repels the bad-fit buyer and earns trust with the good-fit buyer who was tired of vendors promising everything.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "tradeoff-inventory",
      "inputs": {
        "product-description": "from_user_input",
        "roadmap-notes": "from_user_input"
      },
      "outputs": {
        "tradeoff-list": "tradeoff-list",
        "constraint-candidates": "constraint-candidates"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "deliberate-constraint-selection",
      "inputs": {
        "tradeoff-list": "step_1.tradeoff-list",
        "constraint-candidates": "step_1.constraint-candidates"
      },
      "outputs": {
        "owned-constraints": "owned-constraints",
        "rejected-constraints": "rejected-constraints"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "refusal-statement-writing",
      "inputs": {
        "owned-constraints": "step_2.owned-constraints"
      },
      "outputs": {
        "refusal-statements": "refusal-statements",
        "rationale-notes": "rationale-notes"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "audience-sorting",
      "inputs": {
        "refusal-statements": "step_3.refusal-statements",
        "rationale-notes": "step_3.rationale-notes"
      },
      "outputs": {
        "repelled-segments": "repelled-segments",
        "attracted-segments": "attracted-segments"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "positioning-statement-assembly",
      "inputs": {
        "refusal-statements": "step_3.refusal-statements",
        "attracted-segments": "step_4.attracted-segments"
      },
      "outputs": {
        "positioning-statement": "positioning-statement",
        "messaging-pillars": "messaging-pillars"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "constraint-consistency-check",
      "inputs": {
        "positioning-statement": "step_5.positioning-statement",
        "messaging-pillars": "step_5.messaging-pillars"
      },
      "outputs": {
        "consistency-report": "consistency-report",
        "alignment-fixes": "alignment-fixes"
      },
      "parallel_group": 6
    }
