{
  "name": "auto-shop-work-order",
  "description": "Process an automotive repair work order from vehicle intake through diagnostic, estimate, authorization, repair, quality check, and invoicing.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "vehicle-intake-logging",
      "inputs": {
        "customer-complaint": "from_user_input",
        "vehicle-info": "from_user_input"
      },
      "outputs": {
        "intake-record": "intake-record",
        "work-order-number": "work-order-number"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "diagnostic-inspection",
      "inputs": {
        "intake-record": "step_1.intake-record",
        "work-order-number": "step_1.work-order-number"
      },
      "outputs": {
        "diagnostic-findings": "diagnostic-findings",
        "recommended-repairs": "recommended-repairs"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "repair-estimate-builder",
      "inputs": {
        "diagnostic-findings": "step_2.diagnostic-findings",
        "recommended-repairs": "step_2.recommended-repairs"
      },
      "outputs": {
        "repair-estimate": "repair-estimate",
        "parts-list": "parts-list"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "customer-authorization-handler",
      "inputs": {
        "repair-estimate": "step_3.repair-estimate",
        "work-order-number": "step_1.work-order-number"
      },
      "outputs": {
        "authorization-record": "authorization-record",
        "approved-repairs": "approved-repairs"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "repair-execution-tracking",
      "inputs": {
        "approved-repairs": "step_4.approved-repairs",
        "parts-list": "step_3.parts-list"
      },
      "outputs": {
        "repair-log": "repair-log",
        "completion-status": "completion-status"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "post-repair-quality-check",
      "inputs": {
        "repair-log": "step_5.repair-log",
        "diagnostic-findings": "step_2.diagnostic-findings"
      },
      "outputs": {
        "quality-check-result": "quality-check-result",
        "road-test-notes": "road-test-notes"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "work-order-close-and-invoice",
      "inputs": {
        "quality-check-result": "step_6.quality-check-result",
        "repair-log": "step_5.repair-log"
      },
      "outputs": {
        "final-invoice": "final-invoice",
        "work-order-record": "work-order-record"
      },
      "parallel_group": 7
    }
  ],
