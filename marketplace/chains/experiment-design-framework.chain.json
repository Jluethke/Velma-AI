{
  "name": "experiment-design-framework",
  "description": "Design an experiment (A/B test, habit trial, process change) that will produce a conclusive result. Define the hypothesis, calculate the sample size, set the runtime before starting, and commit to not peeking. This prevents the most common experiment failure: declaring victory too early on noisy data.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "hypothesis-formulator",
      "inputs": {
        "experiment-idea": "from_user_input",
        "current-metric-value": "from_user_input"
      },
      "outputs": {
        "hypothesis-statement": "hypothesis-statement",
        "null-hypothesis": "null-hypothesis"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "experiment-sample-sizer",
      "inputs": {
        "hypothesis-statement": "step_1.hypothesis-statement",
        "current-metric-value": "from_context.current-metric-value"
      },
      "outputs": {
        "required-observations": "required-observations",
        "estimated-runtime": "estimated-runtime"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "experiment-controls-designer",
      "inputs": {
        "hypothesis-statement": "step_1.hypothesis-statement",
        "estimated-runtime": "step_2.estimated-runtime"
      },
      "outputs": {
        "confound-list": "confound-list",
        "experiment-design": "experiment-design"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "peeking-prevention-protocol",
      "inputs": {
        "required-observations": "step_2.required-observations",
        "estimated-runtime": "step_2.estimated-runtime"
      },
      "outputs": {
        "analysis-schedule": "analysis-schedule",
        "early-stopping-rules": "early-stopping-rules"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "result-analyzer",
      "inputs": {
        "hypothesis-statement": "step_1.hypothesis-statement",
        "analysis-schedule": "step_4.analysis-schedule"
      },
      "outputs": {
        "experiment-result": "experiment-result",
        "decision-recommendation": "decision-recommendation"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "experiment-learnings-recorder",
      "inputs": {
        "experiment-result": "step_5.experiment-result",
        "experiment-idea": "from_context.experiment-idea"
      },
      "outputs": {
        "experiment-record": "experiment-record",
        "experiment-portfolio": "experiment-portfolio"
      },
      "parallel_group": 6
    }
  ],
