{
  "name": "e2e-testing-flake-triage",
  "description": "Stabilize an existing E2E suite: fix the retry policy, keep failure artifacts, read Playwright traces, and reproduce, classify and fix or quarantine each flaky test.",
  "steps": [
    {
      "id": "s01_e2e_retries_policy",
      "skill_name": "e2e-retries-policy",
      "inputs": {
        "repo_dir": "from_user_input",
        "stack": "from_user_input"
      },
      "outputs": {
        "retry_policy": "retry_policy"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_e2e_failure_artifacts",
      "skill_name": "e2e-failure-artifacts",
      "inputs": {
        "repo_dir": "from_user_input",
        "stack": "from_user_input",
        "retry_policy": "s01_e2e_retries_policy.retry_policy"
      },
      "outputs": {
        "artifact_config": "artifact_config"
      },
      "parallel_group": 2
    },
    {
      "id": "s03_e2e_pw_trace_read",
      "skill_name": "e2e-pw-trace-read",
      "inputs": {
        "trace_path": "from_user_input_optional",
        "artifact_config": "s02_e2e_failure_artifacts.artifact_config"
      },
      "outputs": {
        "failure_diagnosis": "failure_diagnosis"
      },
      "condition": "stack != 'cypress'",
      "parallel_group": 3
    },
    {
      "id": "s04_e2e_flake_triage",
      "skill_name": "e2e-flake-triage",
      "inputs": {
        "repo_dir": "from_user_input",
        "stack": "from_user_input",
        "retry_policy": "s01_e2e_retries_policy.retry_policy",
        "failure_diagnosis": "s03_e2e_pw_trace_read.failure_diagnosis",
        "flaky_tests": "from_user_input_optional",
        "repeat_count": "from_user_input_optional"
      },
      "outputs": {
        "flake_report": "flake_report"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
    {
      "from_step": "s01_e2e_retries_policy",
      "to_step": "s02_e2e_failure_artifacts",
      "data_type": "e2e-retries-policy",
      "field_mapping": {
        "retry_policy": "retry_policy"
      }
    },
    {
      "from_step": "s02_e2e_failure_artifacts",
      "to_step": "s03_e2e_pw_trace_read",
      "data_type": "e2e-failure-artifacts",
      "field_mapping": {
        "artifact_config": "artifact_config"
      }
    },
    {
      "from_step": "s01_e2e_retries_policy",
      "to_step": "s04_e2e_flake_triage",
      "data_type": "e2e-retries-policy",
      "field_mapping": {
        "retry_policy": "retry_policy"
      }
    },
    {
      "from_step": "s03_e2e_pw_trace_read",
      "to_step": "s04_e2e_flake_triage",
      "data_type": "e2e-pw-trace-read",
      "field_mapping": {
        "failure_diagnosis": "failure_diagnosis"
      }
    }
  ],
  "entry_inputs": [
    "repo_dir",
    "stack",
    "trace_path",
    "flaky_tests",
    "repeat_count"
  ],
  "terminal_outputs": [
    "flake_report"
  ],
  "parallel_groups": [
    [
      "s01_e2e_retries_policy"
    ],
    [
      "s02_e2e_failure_artifacts"
    ],
    [
      "s03_e2e_pw_trace_read"
    ],
    [
      "s04_e2e_flake_triage"
    ]
  ],
  "estimated_cost": 4,
  "critical_path": [
    "s01_e2e_retries_policy",
    "s02_e2e_failure_artifacts",
    "s03_e2e_pw_trace_read",
    "s04_e2e_flake_triage"
  ]
}
