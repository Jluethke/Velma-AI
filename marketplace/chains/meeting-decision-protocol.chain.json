{
  "name": "meeting-decision-protocol",
  "description": "Run meetings that produce decisions. Every meeting names its decision in advance, states the options, and ships a pre-read 24 hours ahead. In the room: option advocacy, then objections, then the decision. At the end: what was decided, who owns what, by when. Minutes go out within the hour, while memory is still accurate.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "mdp-decision-namer",
      "inputs": {
        "meeting-request": "from_user_input",
        "attendees": "from_user_input"
      },
      "outputs": {
        "decision-statement": "decision-statement",
        "decision-owner": "decision-owner"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "mdp-options-framer",
      "inputs": {
        "decision-statement": "step_1.decision-statement"
      },
      "outputs": {
        "options-set": "options-set",
        "option-tradeoffs": "option-tradeoffs"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "mdp-preread-composer",
      "inputs": {
        "decision-statement": "step_1.decision-statement",
        "options-set": "step_2.options-set",
        "option-tradeoffs": "step_2.option-tradeoffs"
      },
      "outputs": {
        "preread-document": "preread-document",
        "distribution-timing": "distribution-timing"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "mdp-agenda-sequencer",
      "inputs": {
        "options-set": "step_2.options-set",
        "decision-owner": "step_1.decision-owner"
      },
      "outputs": {
        "meeting-agenda": "meeting-agenda",
        "timebox-plan": "timebox-plan"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "mdp-decision-capture",
      "inputs": {
        "meeting-agenda": "step_4.meeting-agenda",
        "decision-owner": "step_1.decision-owner"
      },
      "outputs": {
        "decision-record": "decision-record",
        "action-owners": "action-owners"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "mdp-minutes-dispatcher",
      "inputs": {
        "decision-record": "step_5.decision-record",
        "action-owners": "step_5.action-owners"
      },
      "outputs": {
        "meeting-minutes": "meeting-minutes",
        "dispatch-checklist": "dispatch-checklist"
      },
      "parallel_group": 6
    }
  ],
