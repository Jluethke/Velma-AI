{
  "name": "network-device-hardening",
  "description": "Harden network devices (routers, switches, firewalls) against unauthorized access and misconfiguration.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "network-port-disabler",
      "inputs": {
        "device-inventory": "from_user_input",
        "port-usage-map": "from_user_input"
      },
      "outputs": {
        "disabled-ports-log": "disabled-ports-log",
        "active-port-list": "active-port-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "network-snmpv3-configurator",
      "inputs": {
        "device-inventory": "from_context.device-inventory",
        "active-port-list": "step_1.active-port-list"
      },
      "outputs": {
        "snmp-config": "snmp-config",
        "snmp-change-log": "snmp-change-log"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "network-management-acl-setter",
      "inputs": {
        "device-inventory": "from_context.device-inventory",
        "snmp-config": "step_2.snmp-config"
      },
      "outputs": {
        "management-acl": "management-acl",
        "acl-change-log": "acl-change-log"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "network-syslog-configurator",
      "inputs": {
        "device-inventory": "from_context.device-inventory",
        "management-acl": "step_3.management-acl"
      },
      "outputs": {
        "syslog-config": "syslog-config",
        "log-verification": "log-verification"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "network-insecure-protocol-disabler",
      "inputs": {
        "device-inventory": "from_context.device-inventory",
        "syslog-config": "step_4.syslog-config"
      },
      "outputs": {
        "protocol-changes": "protocol-changes",
        "secure-protocol-config": "secure-protocol-config"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "network-ntp-configurator",
      "inputs": {
        "device-inventory": "from_context.device-inventory",
        "secure-protocol-config": "step_5.secure-protocol-config"
      },
      "outputs": {
        "ntp-config": "ntp-config",
        "time-sync-status": "time-sync-status"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "network-hardening-reporter",
      "inputs": {
        "device-inventory": "from_context.device-inventory",
        "disabled-ports-log": "step_1.disabled-ports-log"
      },
      "outputs": {
        "hardening-report": "hardening-report",
        "exception-list": "exception-list"
      },
      "parallel_group": 7
    }
  ],
