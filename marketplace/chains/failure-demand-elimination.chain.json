{
  "name": "failure-demand-elimination",
  "description": "Cut the work created by failing to do it right the first time. Samples incoming work, separates value demand from failure demand, categorizes the failure demand, traces each category to its first-time-right failure, fixes the source, and sequences the fixes by released capacity. In many operations, failure demand is a large share of the total load.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "demand-sampling",
      "inputs": {
        "work-intake-source": "from_user_input",
        "sampling-period": "from_user_input"
      },
      "outputs": {
        "demand-sample": "demand-sample",
        "sample-window": "sample-window"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "value-vs-failure-classification",
      "inputs": {
        "demand-sample": "step_1.demand-sample",
        "sample-window": "step_1.sample-window"
      },
      "outputs": {
        "value-demand": "value-demand",
        "failure-demand": "failure-demand",
        "failure-demand-ratio": "failure-demand-ratio"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "failure-demand-categorization",
      "inputs": {
        "failure-demand": "step_2.failure-demand",
        "failure-demand-ratio": "step_2.failure-demand-ratio"
      },
      "outputs": {
        "failure-categories": "failure-categories",
        "category-volumes": "category-volumes"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "root-cause-tracing",
      "inputs": {
        "failure-categories": "step_3.failure-categories",
        "category-volumes": "step_3.category-volumes"
      },
      "outputs": {
        "root-causes": "root-causes",
        "cause-to-category-map": "cause-to-category-map"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "source-fix-design",
      "inputs": {
        "root-causes": "step_4.root-causes",
        "cause-to-category-map": "step_4.cause-to-category-map"
      },
      "outputs": {
        "source-fixes": "source-fixes",
        "fix-effort-estimate": "fix-effort-estimate"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "prevented-demand-projection",
      "inputs": {
        "source-fixes": "step_5.source-fixes",
        "fix-effort-estimate": "step_5.fix-effort-estimate"
      },
      "outputs": {
        "prevented-demand": "prevented-demand",
        "capacity-released": "capacity-released"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "implementation-sequencing",
      "inputs": {
        "source-fixes": "step_5.source-fixes",
        "prevented-demand": "step_6.prevented-demand",
        "capacity-released": "step_6.capacity-released"
      },
      "outputs": {
        "fix-sequence": "fix-sequence",
        "monitoring-metric": "monitoring-metric"
      },
      "parallel_group": 7
    }
  ],
