{
  "name": "wind-tunnel-data-analysis",
  "description": "Analyze wind tunnel test data from raw force measurements through corrections, coefficient computation, CFD comparison, and flow feature identification to an aerodynamic report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "wind-tunnel-force-importer",
      "inputs": {
        "balance-data-files": "from_user_input",
        "model-reference": "from_user_input"
      },
      "outputs": {
        "raw-forces-moments": "raw-forces-moments",
        "freestream-conditions": "freestream-conditions"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "wind-tunnel-correction-applier",
      "inputs": {
        "raw-forces-moments": "step_1.raw-forces-moments",
        "tunnel-geometry": "from_context.tunnel-geometry"
      },
      "outputs": {
        "corrected-forces-moments": "corrected-forces-moments",
        "correction-breakdown": "correction-breakdown"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "aerodynamic-coefficient-calculator",
      "inputs": {
        "corrected-forces-moments": "step_2.corrected-forces-moments",
        "model-reference": "from_context.model-reference"
      },
      "outputs": {
        "aero-coefficients": "aero-coefficients",
        "derived-quantities": "derived-quantities"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "polar-plot-generator",
      "inputs": {
        "aero-coefficients": "step_3.aero-coefficients",
        "comparison-data": "from_context.comparison-data"
      },
      "outputs": {
        "aerodynamic-plots": "aerodynamic-plots",
        "stall-characteristics": "stall-characteristics"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "cfd-comparison-analyzer",
      "inputs": {
        "aero-coefficients": "step_3.aero-coefficients",
        "cfd-predictions": "from_context.cfd-predictions"
      },
      "outputs": {
        "comparison-plots": "comparison-plots",
        "discrepancy-analysis": "discrepancy-analysis"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "flow-feature-identifier",
      "inputs": {
        "aero-coefficients": "step_3.aero-coefficients",
        "flow-visualization-data": "from_context.flow-visualization-data"
      },
      "outputs": {
        "flow-features": "flow-features",
        "feature-evidence": "feature-evidence"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "aerodynamic-report-generator",
      "inputs": {
        "aerodynamic-plots": "step_4.aerodynamic-plots",
        "discrepancy-analysis": "step_5.discrepancy-analysis",
        "flow-features": "step_6.flow-features"
      },
      "outputs": {
        "aerodynamic-report": "aerodynamic-report",
        "data-package": "data-package"
      },
      "parallel_group": 7
    }
  ],
