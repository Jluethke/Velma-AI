{
  "name": "toxicology-risk-assessment",
  "description": "Assess toxicological risk from hazard identification through dose-response analysis, exposure characterization, and risk quantification.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "tox-hazard-identification",
      "inputs": {
        "agent-name": "from_user_input",
        "exposure-context": "from_user_input"
      },
      "outputs": {
        "hazard-profile": "hazard-profile",
        "evidence-table": "evidence-table"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "dose-response-compiler",
      "inputs": {
        "evidence-table": "step_1.evidence-table",
        "hazard-profile": "step_1.hazard-profile"
      },
      "outputs": {
        "dose-response-dataset": "dose-response-dataset",
        "critical-effect-summary": "critical-effect-summary"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "reference-dose-derivation",
      "inputs": {
        "dose-response-dataset": "step_2.dose-response-dataset",
        "critical-effect-summary": "step_2.critical-effect-summary"
      },
      "outputs": {
        "reference-dose": "reference-dose",
        "uncertainty-factor-table": "uncertainty-factor-table"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "exposure-pathway-characterizer",
      "inputs": {
        "agent-name": "from_context.agent-name",
        "exposure-context": "from_context.exposure-context"
      },
      "outputs": {
        "exposure-estimate": "exposure-estimate",
        "exposure-scenario": "exposure-scenario"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "risk-quotient-calculator",
      "inputs": {
        "exposure-estimate": "step_4.exposure-estimate",
        "reference-dose": "step_3.reference-dose"
      },
      "outputs": {
        "risk-characterization": "risk-characterization",
        "risk-drivers": "risk-drivers"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "tox-uncertainty-assessment",
      "inputs": {
        "risk-characterization": "step_5.risk-characterization",
        "uncertainty-factor-table": "step_3.uncertainty-factor-table"
      },
      "outputs": {
        "uncertainty-narrative": "uncertainty-narrative",
        "confidence-rating": "confidence-rating"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "tox-risk-report-writer",
      "inputs": {
        "risk-characterization": "step_5.risk-characterization",
        "uncertainty-narrative": "step_6.uncertainty-narrative",
        "confidence-rating": "step_6.confidence-rating"
      },
      "outputs": {
        "risk-assessment-report": "risk-assessment-report",
        "executive-summary": "executive-summary"
      },
      "parallel_group": 7
    }
  ],
