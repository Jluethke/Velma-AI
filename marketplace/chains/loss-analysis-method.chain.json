{
  "name": "loss-analysis-method",
  "description": "Study lost deals on purpose. Winners tell you what you want to hear, but losses tell you the truth. For every loss, record the stage it died at, who actually decided, the stated reason, and the real reason. The pattern across losses reveals the objection you keep losing to.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "loss-deal-inventory",
      "inputs": {
        "crm-export": "from_user_input",
        "time-window": "from_user_input"
      },
      "outputs": {
        "lost-deal-list": "lost-deal-list",
        "loss-metadata": "loss-metadata"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "loss-stage-tagging",
      "inputs": {
        "lost-deal-list": "step_1.lost-deal-list",
        "loss-metadata": "step_1.loss-metadata"
      },
      "outputs": {
        "stage-tagged-losses": "stage-tagged-losses",
        "stage-distribution": "stage-distribution"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "decision-maker-identification",
      "inputs": {
        "stage-tagged-losses": "step_2.stage-tagged-losses"
      },
      "outputs": {
        "decision-map": "decision-map",
        "authority-gaps": "authority-gaps"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "stated-vs-real-reason-capture",
      "inputs": {
