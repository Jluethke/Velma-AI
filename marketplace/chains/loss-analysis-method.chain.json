      },
      "outputs": {
        "reason-pairs": "reason-pairs",
        "reason-confidence": "reason-confidence"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "loss-pattern-synthesis",
      "inputs": {
        "reason-pairs": "step_4.reason-pairs",
        "reason-confidence": "step_4.reason-confidence",
        "stage-distribution": "step_2.stage-distribution"
      },
      "outputs": {
        "loss-patterns": "loss-patterns",
        "dominant-objection": "dominant-objection"
      },
      "parallel_group": 5
    },
    {
