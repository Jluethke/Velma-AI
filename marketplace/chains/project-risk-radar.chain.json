{
  "name": "project-risk-radar",
  "description": "Continuous risk scanning for projects and initiatives. A one-time risk assessment decays as the project evolves. The risk radar runs weekly: scan for new risks, re-assess changed risks, flag approaching risks, and retire expired risks.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "weekly-risk-scan",
      "inputs": {
        "current-risk-register": "from_user_input",
        "weekly-events": "from_user_input"
      },
      "outputs": {
        "new-risks-identified": "new-risks-identified",
        "changed-risks": "changed-risks"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "risk-proximity-tracker",
      "inputs": {
        "current-risk-register": "from_context.current-risk-register",
        "project-timeline": "from_context.project-timeline"
      },
      "outputs": {
        "risk-proximity-map": "risk-proximity-map",
        "approaching-risk-alerts": "approaching-risk-alerts"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "risk-radar-dashboard",
      "inputs": {
        "risk-proximity-map": "step_2.risk-proximity-map",
        "approaching-risk-alerts": "step_2.approaching-risk-alerts"
      },
      "outputs": {
        "risk-radar-report": "risk-radar-report",
        "mitigation-action-items": "mitigation-action-items"
      },
      "parallel_group": 3
    }
  ],
  "edges": [
