{
  "name": "x-ray-diffraction-analysis",
  "description": "Analyze X-ray diffraction data from raw diffractogram through peak identification, phase matching, Rietveld refinement, and crystallite size estimation to a final XRD report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "xrd-diffractogram-importer",
      "inputs": {
        "raw-data-files": "from_user_input",
        "instrument-parameters": "from_user_input"
      },
      "outputs": {
        "diffractogram": "diffractogram",
        "acquisition-metadata": "acquisition-metadata"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "xrd-background-stripper",
      "inputs": {
        "diffractogram": "step_1.diffractogram",
        "background-method": "from_context.background-method"
      },
      "outputs": {
        "stripped-diffractogram": "stripped-diffractogram",
        "background-curve": "background-curve"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "xrd-peak-identifier",
      "inputs": {
        "stripped-diffractogram": "step_2.stripped-diffractogram",
        "peak-detection-threshold": "from_context.peak-detection-threshold"
      },
      "outputs": {
        "peak-list": "peak-list",
        "peak-fit-residuals": "peak-fit-residuals"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "xrd-phase-matcher",
      "inputs": {
        "peak-list": "step_3.peak-list",
        "candidate-phases": "from_context.candidate-phases"
      },
      "outputs": {
        "phase-identification": "phase-identification",
        "unmatched-peaks": "unmatched-peaks"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "xrd-rietveld-refiner",
      "inputs": {
        "diffractogram": "step_1.diffractogram",
        "phase-identification": "step_4.phase-identification"
      },
      "outputs": {
        "refined-parameters": "refined-parameters",
        "phase-fractions": "phase-fractions"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "xrd-crystallite-sizer",
      "inputs": {
        "peak-list": "step_3.peak-list",
        "instrument-broadening": "from_context.instrument-broadening"
      },
      "outputs": {
        "crystallite-size": "crystallite-size",
        "microstrain-estimate": "microstrain-estimate"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "xrd-report-generator",
      "inputs": {
        "phase-identification": "step_4.phase-identification",
        "refined-parameters": "step_5.refined-parameters",
        "crystallite-size": "step_6.crystallite-size"
      },
      "outputs": {
        "xrd-report": "xrd-report",
        "supplementary-data": "supplementary-data"
      },
      "parallel_group": 7
    }
  ],
