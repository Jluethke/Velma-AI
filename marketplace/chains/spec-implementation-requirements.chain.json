      "skill_name": "s2i-spec-acquire-pin",
      "inputs": {
        "spec_id": "from_user_input",
        "project_dir": "from_user_input"
      },
      "outputs": {
        "spec_bundle": "spec_bundle"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_s2i_errata_check",
      "skill_name": "s2i-errata-check",
      "inputs": {
