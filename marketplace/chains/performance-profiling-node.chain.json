      "skill_name": "perf-metric-workload-define",
      "inputs": {
        "target_description": "from_user_input",
        "stack": "from_user_input",
        "workload_kind": "from_user_input",
        "run_command": "from_user_input",
        "perf_goal": "from_user_input_optional"
      },
      "outputs": {
        "perf_spec": "perf_spec",
        "workload_spec": "workload_spec"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_perf_bench_env_stabilize",
      "skill_name": "perf-bench-env-stabilize",
      "inputs": {
        "perf_spec": "s01_perf_metric_workload_define.perf_spec",
        "repo_path": "from_user_input"
      },
      "outputs": {
        "bench_env_report": "bench_env_report"
      },
      "parallel_group": 2
    },
    {
      "id": "s03_perf_node_tinybench_harness",
      "skill_name": "perf-node-tinybench-harness",
      "inputs": {
