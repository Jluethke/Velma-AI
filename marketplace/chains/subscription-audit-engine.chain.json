{
  "name": "subscription-audit-engine",
  "description": "Audit every recurring charge using value-per-dollar and cost-per-use analysis. Score each subscription. Kill the bottom quartile. Renegotiate the middle. Works for personal subscriptions and enterprise SaaS sprawl.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "subscription-inventory-builder",
      "inputs": {
        "payment-sources": "from_user_input",
        "audit-scope": "from_user_input"
      },
      "outputs": {
        "subscription-inventory": "subscription-inventory",
        "total-recurring-cost": "total-recurring-cost"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "usage-data-collector",
      "inputs": {
        "subscription-inventory": "step_1.subscription-inventory"
      },
      "outputs": {
        "usage-data": "usage-data",
        "zombie-subscriptions": "zombie-subscriptions"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "value-per-dollar-scorer",
      "inputs": {
        "subscription-inventory": "step_1.subscription-inventory",
        "usage-data": "step_2.usage-data"
      },
      "outputs": {
        "scored-subscriptions": "scored-subscriptions",
        "quartile-ranking": "quartile-ranking"
      },
      "parallel_group": 3
    },
    {
