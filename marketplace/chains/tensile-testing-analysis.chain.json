{
  "name": "tensile-testing-analysis",
  "description": "Analyze tensile test data from raw stress-strain curves through yield, UTS, elongation, and modulus extraction to a mechanical testing report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "tensile-curve-importer",
      "inputs": {
        "raw-test-files": "from_user_input",
        "specimen-dimensions": "from_user_input"
      },
      "outputs": {
        "stress-strain-curves": "stress-strain-curves",
        "test-metadata": "test-metadata"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "tensile-yield-strength-calculator",
      "inputs": {
        "stress-strain-curves": "step_1.stress-strain-curves",
        "yield-method": "from_context.yield-method"
      },
      "outputs": {
        "yield-strengths": "yield-strengths",
        "elastic-region-fit": "elastic-region-fit"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "tensile-uts-elongation-analyzer",
      "inputs": {
        "stress-strain-curves": "step_1.stress-strain-curves",
        "test-metadata": "step_1.test-metadata"
      },
      "outputs": {
        "uts-values": "uts-values",
        "elongation-at-break": "elongation-at-break"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "tensile-modulus-extractor",
      "inputs": {
        "stress-strain-curves": "step_1.stress-strain-curves",
        "elastic-region-fit": "step_2.elastic-region-fit"
      },
      "outputs": {
        "elastic-moduli": "elastic-moduli",
        "modulus-statistics": "modulus-statistics"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "tensile-specimen-comparator",
      "inputs": {
        "yield-strengths": "step_2.yield-strengths",
        "uts-values": "step_3.uts-values",
        "elastic-moduli": "step_4.elastic-moduli"
      },
      "outputs": {
        "comparison-table": "comparison-table",
        "property-distributions": "property-distributions"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "tensile-necking-assessor",
      "inputs": {
        "stress-strain-curves": "step_1.stress-strain-curves",
        "uts-values": "step_3.uts-values"
      },
      "outputs": {
        "necking-assessment": "necking-assessment",
        "true-stress-strain": "true-stress-strain"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "tensile-report-generator",
      "inputs": {
        "comparison-table": "step_5.comparison-table",
        "necking-assessment": "step_6.necking-assessment",
        "test-metadata": "step_1.test-metadata"
      },
      "outputs": {
        "tensile-report": "tensile-report",
        "raw-data-archive": "raw-data-archive"
      },
      "parallel_group": 7
    }
  ],
