      "inputs": {
        "data_sources": "from_user_input",
        "stack": "from_user_input",
        "replay_target": "from_user_input_optional"
      },
      "outputs": {
        "log_format_decision": "log_format_decision"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_dlog_sensor_rate_inventory",
      "skill_name": "dlog-sensor-rate-inventory",
