      "skill_name": "blameless-timeline-builder",
      "inputs": {
        "incident-or-project": "from_user_input",
        "participants": "from_user_input"
      },
      "outputs": {
        "event-timeline": "event-timeline",
        "decision-points": "decision-points"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "five-whys-root-cause-analysis",
      "inputs": {
        "event-timeline": "step_1.event-timeline",
        "decision-points": "step_1.decision-points"
      },
      "outputs": {
        "root-cause-chains": "root-cause-chains",
        "systemic-root-causes": "systemic-root-causes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "systemic-fix-designer",
      "inputs": {
        "systemic-root-causes": "step_2.systemic-root-causes",
        "event-timeline": "step_1.event-timeline"
      },
      "outputs": {
        "systemic-fixes": "systemic-fixes",
        "fix-verification-plan": "fix-verification-plan"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "post-mortem-follow-through-tracker",
