{
  "name": "reproducibility-audit",
  "description": "Audit a published study for reproducibility: catalog the computational environment, trace data provenance, re-execute the analysis, compare against published results, classify discrepancies, and write the audit report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "environment-cataloger",
      "inputs": {
        "published-paper": "from_user_input",
        "supplementary-materials": "from_user_input"
      },
      "outputs": {
        "environment-specification": "environment-specification",
        "availability-assessment": "availability-assessment"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "data-provenance-tracer",
      "inputs": {
        "supplementary-materials": "from_context.supplementary-materials",
        "published-paper": "from_context.published-paper"
      },
      "outputs": {
        "provenance-chain": "provenance-chain",
        "provenance-gaps": "provenance-gaps"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "pipeline-re-executor",
      "inputs": {
        "environment-specification": "step_1.environment-specification",
        "provenance-chain": "step_2.provenance-chain"
      },
      "outputs": {
        "reproduced-outputs": "reproduced-outputs",
        "execution-log": "execution-log"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "result-comparator",
      "inputs": {
        "reproduced-outputs": "step_3.reproduced-outputs",
        "published-paper": "from_context.published-paper"
      },
      "outputs": {
        "comparison-table": "comparison-table",
        "discrepancy-list": "discrepancy-list"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "discrepancy-classifier",
      "inputs": {
        "discrepancy-list": "step_4.discrepancy-list",
        "execution-log": "step_3.execution-log",
        "provenance-gaps": "step_2.provenance-gaps"
      },
      "outputs": {
        "classified-discrepancies": "classified-discrepancies",
        "severity-summary": "severity-summary"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "reproducibility-report-writer",
      "inputs": {
        "comparison-table": "step_4.comparison-table",
        "classified-discrepancies": "step_5.classified-discrepancies",
        "availability-assessment": "step_1.availability-assessment"
      },
      "outputs": {
        "audit-report": "audit-report",
        "reproducibility-score": "reproducibility-score"
      },
      "parallel_group": 6
    }
  ],
