        "scratch_log": "from_user_input",
        "repo_path": "from_user_input"
      },
      "outputs": {
        "applied_edit": "applied_edit"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_stp_run_verify_capture",
      "skill_name": "stp-run-verify-capture",
