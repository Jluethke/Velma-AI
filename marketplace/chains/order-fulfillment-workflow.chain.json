{
  "name": "order-fulfillment-workflow",
  "description": "Fulfill customer orders from payment verification through carrier handoff.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "order-verification-processor",
      "inputs": {
        "order-details": "from_user_input",
        "inventory-status": "from_user_input"
      },
      "outputs": {
        "verified-order": "verified-order",
        "hold-list": "hold-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "pick-pack-coordinator",
      "inputs": {
        "verified-order": "step_1.verified-order",
        "inventory-status": "from_context.inventory-status"
      },
      "outputs": {
        "packed-order": "packed-order",
        "pick-accuracy-log": "pick-accuracy-log"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "shipping-label-generator",
      "inputs": {
        "packed-order": "step_2.packed-order",
        "verified-order": "step_1.verified-order"
      },
      "outputs": {
        "shipping-label": "shipping-label",
        "shipping-cost": "shipping-cost"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "carrier-handoff-notifier",
      "inputs": {
