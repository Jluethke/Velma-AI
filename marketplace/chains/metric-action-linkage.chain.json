{
  "name": "metric-action-linkage",
  "description": "Build a measurement system where every metric has a defined response. A metric without a linked action is decoration. A dashboard where every number has a response protocol is a control system. This chain converts monitoring into managing.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "metric-inventory-collector",
      "inputs": {
        "data-sources": "from_user_input",
        "scope-boundary": "from_user_input"
      },
      "outputs": {
        "metric-inventory": "metric-inventory",
        "inventory-count": "inventory-count"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "action-linkage-auditor",
      "inputs": {
        "metric-inventory": "step_1.metric-inventory"
      },
      "outputs": {
        "linked-metrics": "linked-metrics",
        "unlinked-metrics": "unlinked-metrics"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "unlinked-metric-triage",
      "inputs": {
        "unlinked-metrics": "step_2.unlinked-metrics",
        "scope-boundary": "from_context.scope-boundary"
      },
      "outputs": {
        "metrics-to-link": "metrics-to-link",
        "metrics-to-retire": "metrics-to-retire"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "threshold-calibrator",
      "inputs": {
        "metrics-to-link": "step_3.metrics-to-link",
        "linked-metrics": "step_2.linked-metrics"
      },
      "outputs": {
        "calibrated-thresholds": "calibrated-thresholds",
        "threshold-rationale": "threshold-rationale"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "response-action-designer",
      "inputs": {
        "calibrated-thresholds": "step_4.calibrated-thresholds",
        "scope-boundary": "from_context.scope-boundary"
      },
      "outputs": {
        "response-actions": "response-actions",
        "escalation-rules": "escalation-rules"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "control-system-assembler",
      "inputs": {
        "linked-metrics": "step_2.linked-metrics",
        "response-actions": "step_5.response-actions",
        "escalation-rules": "step_5.escalation-rules"
      },
      "outputs": {
        "control-system-document": "control-system-document",
        "retired-metrics-log": "retired-metrics-log"
      },
      "parallel_group": 6
    }
  ],
