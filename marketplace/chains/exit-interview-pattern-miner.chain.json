{
  "name": "exit-interview-pattern-miner",
  "description": "Analyze exit interview data to find the systemic causes of turnover. The stated reason for leaving is often not the real reason. Code each exit by stated reason, tenure at departure, team, manager, and role, then look for clusters. If departures cluster under a specific manager, the problem is the manager. If they cluster at a specific tenure, there is a growth ceiling. The pattern reveals the lever.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "exit-data-codifier",
      "inputs": {
        "exit-interview-records": "from_user_input",
        "analysis-period": "from_user_input"
      },
      "outputs": {
        "coded-exit-data": "coded-exit-data",
        "data-quality-notes": "data-quality-notes"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "cluster-detector",
      "inputs": {
        "coded-exit-data": "step_1.coded-exit-data",
        "data-quality-notes": "step_1.data-quality-notes"
      },
      "outputs": {
        "cluster-report": "cluster-report",
        "base-rate-comparison": "base-rate-comparison"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "stated-vs-real-reason-prober",
      "inputs": {
        "cluster-report": "step_2.cluster-report",
        "base-rate-comparison": "step_2.base-rate-comparison"
      },
      "outputs": {
        "real-reason-hypotheses": "real-reason-hypotheses",
        "validation-suggestions": "validation-suggestions"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "retention-lever-ranker",
      "inputs": {
        "real-reason-hypotheses": "step_3.real-reason-hypotheses",
        "validation-suggestions": "step_3.validation-suggestions"
      },
      "outputs": {
        "ranked-retention-levers": "ranked-retention-levers",
        "intervention-plan": "intervention-plan"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "retention-intervention-tracker",
      "inputs": {
        "ranked-retention-levers": "step_4.ranked-retention-levers",
        "intervention-plan": "step_4.intervention-plan"
      },
      "outputs": {
        "intervention-results": "intervention-results",
        "revised-hypotheses": "revised-hypotheses"
      },
      "parallel_group": 5
    }
  ],
