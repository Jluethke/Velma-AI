{
  "name": "codebase-takeover",
  "description": "Inherit a codebase you've never seen and get productive fast. Map it, assess health, review critical paths, document what's missing, and plan what to refactor first.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "codebase-mapper",
      "inputs": {
        "repo_path": "from_user_input",
        "language_filter": "from_user_input",
        "depth": "from_user_input",
        "previous_map": "from_user_input"
      },
      "outputs": {
        "architecture_map": "architecture_map_data",
        "dependency_graph": "dependency_graph_data",
        "file_index": "file_index_data",
        "tech_stack_summary": "tech_stack_summary_data",
        "drift_report": "drift_report_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "repo-health",
      "inputs": {
        "task_description": "step_1.architecture_map"
      },
      "outputs": {
        "guidance": "guidance_data",
        "code_patterns": "code_patterns_data",
        "implementation_example": "implementation_example_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "code-review",
      "inputs": {
        "diff": "step_1.architecture_map",
        "pr_description": "step_1.architecture_map",
        "codebase_context": "step_1.architecture_map",
        "task_description": "step_1.architecture_map"
      },
      "outputs": {
        "review_comments": "review_comments_data",
        "approval_decision": "approval_decision_data",
        "summary": "summary_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_4",
      "skill_name": "technical-writing",
      "inputs": {
        "subject_matter": "step_1.architecture_map",
        "audience": "step_1.architecture_map",
        "doc_type": "step_1.architecture_map",
        "task_description": "step_1.architecture_map"
      },
      "outputs": {
        "documentation": "documentation_data",
        "templates": "templates_data",
        "style_feedback": "style_feedback_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_5",
      "skill_name": "refactor-planner",
      "inputs": {
        "source_code": "step_2.guidance",
        "target_area": "step_2.guidance",
        "constraints": "step_2.guidance",
        "test_coverage_info": "step_2.guidance",
        "refactoring_history": "step_2.guidance"
      },
      "outputs": {
        "smell_report": "smell_report_data",
        "refactoring_plan": "refactoring_plan_data",
        "step_sequence": "step_sequence_data",
        "execution_instructions": "execution_instructions_data",
        "verification_checklist": "verification_checklist_data"
      },
      "parallel_group": 3
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "architecture_map",
      "field_mapping": "architecture_map -> task_description"
    },
    {
      "from_step": "step_1",
      "to_step": "step_3",
      "data_type": "architecture_map",
      "field_mapping": "architecture_map -> diff; architecture_map -> pr_description; architecture_map -> codebase_context; architecture_map -> task_description"
    },
    {
      "from_step": "step_1",
      "to_step": "step_4",
      "data_type": "architecture_map",
      "field_mapping": "architecture_map -> subject_matter; architecture_map -> audience; architecture_map -> doc_type; architecture_map -> task_description"
    },
    {
      "from_step": "step_3",
      "to_step": "step_4",
      "data_type": "review_comments",
      "field_mapping": "review_comments -> input"
    },
    {
      "from_step": "step_2",
      "to_step": "step_5",
      "data_type": "guidance",
      "field_mapping": "guidance -> source_code; guidance -> target_area; guidance -> constraints; guidance -> test_coverage_info; guidance -> refactoring_history"
    },
    {
      "from_step": "step_3",
      "to_step": "step_5",
      "data_type": "review_comments",
      "field_mapping": "review_comments -> input"
    }
  ],
  "entry_inputs": [
    "depth",
    "language_filter",
    "previous_map",
    "repo_path"
  ],
  "terminal_outputs": [
    "documentation",
    "templates",
    "style_feedback",
    "smell_report",
    "refactoring_plan",
    "step_sequence",
    "execution_instructions",
    "verification_checklist"
  ],
  "parallel_groups": [
    [
      "step_1"
    ],
    [
      "step_2",
      "step_3"
    ],
    [
      "step_4",
      "step_5"
    ]
  ],
  "estimated_cost": 0,
  "critical_path": [
    "step_1",
    "step_3",
    "step_4"
  ],
  "chain_links": {
    "prerequisites": [],
    "next_chains": [],
    "related_chains": [
