{
  "name": "decision-matrix-with-weights",
  "description": "Build a weighted decision matrix the right way: define criteria before seeing the options, weight criteria using pairwise comparison, score options independently, calculate weighted totals, and then run the override test. The override test is the step most people skip: if the matrix says X but your gut says Y, that gap contains information you have not made explicit. Investigate it before deciding.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "criteria-definition-before-options",
      "inputs": {
        "decision-description": "from_user_input",
        "must-haves": "from_user_input"
      },
      "outputs": {
        "evaluation-criteria": "evaluation-criteria",
        "must-have-filters": "must-have-filters"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "pairwise-weight-assignment",
      "inputs": {
        "evaluation-criteria": "step_1.evaluation-criteria"
      },
      "outputs": {
        "weighted-criteria": "weighted-criteria",
        "weight-rationale": "weight-rationale"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "option-scoring-independent",
      "inputs": {
        "weighted-criteria": "step_2.weighted-criteria",
        "must-have-filters": "step_1.must-have-filters",
        "decision-description": "from_context.decision-description"
      },
      "outputs": {
        "score-matrix": "score-matrix",
        "eliminated-options": "eliminated-options"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "weighted-total-calculator",
      "inputs": {
        "score-matrix": "step_3.score-matrix",
        "weighted-criteria": "step_2.weighted-criteria"
      },
      "outputs": {
        "weighted-totals": "weighted-totals",
        "matrix-recommendation": "matrix-recommendation"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "override-test-and-gut-check",
      "inputs": {
        "matrix-recommendation": "step_4.matrix-recommendation",
        "weighted-totals": "step_4.weighted-totals"
      },
      "outputs": {
        "gut-check-result": "gut-check-result",
        "final-decision": "final-decision"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "matrix-decision-record",
      "inputs": {
        "final-decision": "step_5.final-decision",
        "gut-check-result": "step_5.gut-check-result",
        "weighted-totals": "step_4.weighted-totals"
      },
      "outputs": {
        "matrix-record": "matrix-record",
        "outcome-check-date": "outcome-check-date"
      },
      "parallel_group": 6
    }
  ],
