{
  "name": "sunk-cost-detector",
  "description": "Build a system for detecting sunk cost fallacy in real time. For any ongoing commitment (project, relationship, investment, subscription, career path), apply the fresh-start test: if you were starting from zero today with no history, would you choose this? If no, you are being held by sunk costs. This chain makes the test systematic and applies it to all active commitments.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "active-commitment-inventory",
      "inputs": {
        "commitment-categories": "from_user_input",
        "time-window": "from_user_input"
      },
      "outputs": {
        "commitment-inventory": "commitment-inventory",
        "oldest-commitments": "oldest-commitments"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "fresh-start-test-applier",
      "inputs": {
        "commitment-inventory": "step_1.commitment-inventory"
      },
      "outputs": {
        "fresh-start-results": "fresh-start-results",
        "sunk-cost-suspects": "sunk-cost-suspects"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "switching-cost-calculator",
      "inputs": {
        "sunk-cost-suspects": "step_2.sunk-cost-suspects"
      },
      "outputs": {
        "switching-cost-analysis": "switching-cost-analysis",
        "stop-now-list": "stop-now-list"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "emotional-attachment-auditor",
      "inputs": {
        "sunk-cost-suspects": "step_2.sunk-cost-suspects",
        "switching-cost-analysis": "step_3.switching-cost-analysis"
      },
      "outputs": {
        "emotional-drivers": "emotional-drivers",
        "reframed-narratives": "reframed-narratives"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "exit-plan-builder",
      "inputs": {
        "stop-now-list": "step_3.stop-now-list",
        "reframed-narratives": "step_4.reframed-narratives"
      },
      "outputs": {
        "exit-plans": "exit-plans",
        "freed-resources": "freed-resources"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "sunk-cost-audit-schedule",
      "inputs": {
        "exit-plans": "step_5.exit-plans",
        "freed-resources": "step_5.freed-resources"
      },
      "outputs": {
        "audit-schedule": "audit-schedule",
        "sunk-cost-audit-report": "sunk-cost-audit-report"
      },
      "parallel_group": 6
    }
  ],
