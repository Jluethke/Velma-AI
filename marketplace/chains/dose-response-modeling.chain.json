{
  "name": "dose-response-modeling",
  "description": "Fit dose-response curves from experimental data: organize the data, select candidate models, fit curves, extract potency parameters (EC50/IC50), assess model adequacy, and compare treatments.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "dose-data-organizer",
      "inputs": {
        "raw-dose-response-data": "from_user_input",
        "assay-metadata": "from_user_input"
      },
      "outputs": {
        "organized-data": "organized-data",
        "normalization-record": "normalization-record"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "sigmoid-model-selector",
      "inputs": {
        "organized-data": "step_1.organized-data",
        "prior-knowledge": "from_context.prior-knowledge"
      },
      "outputs": {
        "candidate-models": "candidate-models",
        "initial-guesses": "initial-guesses"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "curve-fitter",
      "inputs": {
        "organized-data": "step_1.organized-data",
        "candidate-models": "step_2.candidate-models"
      },
      "outputs": {
        "fit-results": "fit-results",
        "convergence-log": "convergence-log"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "potency-parameter-extractor",
      "inputs": {
        "fit-results": "step_3.fit-results",
        "organized-data": "step_1.organized-data"
      },
      "outputs": {
        "potency-table": "potency-table",
        "dose-at-effect": "dose-at-effect"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "model-adequacy-checker",
      "inputs": {
        "fit-results": "step_3.fit-results",
        "organized-data": "step_1.organized-data"
      },
      "outputs": {
        "adequacy-report": "adequacy-report",
        "selected-model": "selected-model"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "treatment-comparator",
      "inputs": {
        "potency-table": "step_4.potency-table",
        "fit-results": "step_3.fit-results"
      },
      "outputs": {
        "comparison-results": "comparison-results",
        "potency-ratios": "potency-ratios"
      },
      "parallel_group": 6
    }
  ],
