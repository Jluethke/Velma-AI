{
  "name": "towing-prep",
  "description": "Towing preparation: full vehicle scan for tow readiness, maintenance check for fluid levels and tire pressure, pre-drive safety with towing profile, budget for fuel cost increase (towing drops MPG 30-50%).",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "vehicle-health",
      "inputs": {
        "vehicle": "from_user_input",
        "scan_scope": "from_user_input",
        "history": "from_user_input"
      },
      "outputs": {
        "module_status": "module_status",
        "dtc_report": "dtc_report",
        "signal_health": "signal_health",
        "trend_analysis": "trend_analysis",
        "action_plan": "action_plan"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "maintenance-schedule",
      "inputs": {
        "vehicle": "from_context.vehicle",
        "mileage": "from_context.mileage",
        "service_history": "from_context.service_history",
        "driving_conditions": "from_context.driving_conditions"
      },
      "outputs": {
        "interval_map": "interval_map",
        "current_status": "current_status",
        "calendar": "calendar",
        "cost_forecast": "cost_forecast"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "pre-drive-check",
      "inputs": {
        "vehicle": "from_context.vehicle",
        "trip_type": "from_context.trip_type",
        "weather": "from_context.weather"
      },
      "outputs": {
        "readiness_status": "readiness_status",
        "safety_checks": "safety_checks",
        "fluid_levels": "fluid_levels",
        "tire_status": "tire_status",
        "go_no_go": "go_no_go"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "budget-builder",
      "inputs": {
        "income": "from_context.income",
        "fixed_expenses": "from_context.fixed_expenses",
        "variable_spending": "from_context.variable_spending",
        "financial_situation": "from_context.financial_situation",
        "goals": "from_context.goals"
      },
      "outputs": {
        "spending_snapshot": "spending_snapshot",
        "monthly_budget": "monthly_budget",
        "bleed_points": "bleed_points",
        "action_plan": "action_plan",
        "monthly_checkup": "monthly_checkup"
      },
      "parallel_group": 4
    }
  ],
