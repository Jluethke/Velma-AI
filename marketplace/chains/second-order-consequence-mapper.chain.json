{
  "name": "second-order-consequence-mapper",
  "description": "Map the first, second, and third-order consequences of a decision or action. Most bad decisions happen because people optimize for first-order effects and get blindsided by second-order ones. This chain builds a consequence tree that surfaces the downstream effects before committing to the decision.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "decision-option-definer",
      "inputs": {
        "decision-description": "from_user_input",
        "options-list": "from_user_input"
      },
      "outputs": {
        "defined-options": "defined-options",
        "status-quo-option": "status-quo-option"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "first-order-consequence-mapper",
      "inputs": {
        "defined-options": "step_1.defined-options",
        "status-quo-option": "step_1.status-quo-option"
      },
      "outputs": {
        "first-order-map": "first-order-map",
        "first-order-tradeoffs": "first-order-tradeoffs"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "second-order-consequence-mapper",
      "inputs": {
        "first-order-map": "step_2.first-order-map"
      },
      "outputs": {
        "second-order-map": "second-order-map",
        "reversal-alerts": "reversal-alerts"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "third-order-and-tail-risk-scanner",
      "inputs": {
        "second-order-map": "step_3.second-order-map",
        "reversal-alerts": "step_3.reversal-alerts"
      },
      "outputs": {
        "third-order-flags": "third-order-flags",
        "tail-risk-list": "tail-risk-list"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "consequence-tree-comparison",
      "inputs": {
        "first-order-map": "step_2.first-order-map",
        "second-order-map": "step_3.second-order-map",
        "third-order-flags": "step_4.third-order-flags",
        "tail-risk-list": "step_4.tail-risk-list"
      },
      "outputs": {
        "consequence-comparison": "consequence-comparison",
        "ranking-shifts": "ranking-shifts"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "consequence-informed-recommendation",
      "inputs": {
        "consequence-comparison": "step_5.consequence-comparison",
        "ranking-shifts": "step_5.ranking-shifts"
      },
      "outputs": {
        "recommendation": "recommendation",
        "monitoring-plan": "monitoring-plan"
      },
      "parallel_group": 6
    }
  ],
