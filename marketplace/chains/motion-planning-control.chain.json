        "control_spec": "s01_ctrl_spec_intake.control_spec",
        "can_interface": "from_user_input",
        "dbc_file": "from_user_input"
      },
      "outputs": {
        "drive_log": "drive_log"
      },
      "condition": "collect_vehicle_logs == true",
      "parallel_group": 2
    },
    {
