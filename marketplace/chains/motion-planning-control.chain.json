        "test_site": "from_user_input",
        "estop_description": "from_user_input",
        "stack": "from_user_input"
      },
      "outputs": {
        "control_spec": "control_spec",
        "open_questions": "open_questions"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_ctrl_can_readonly_log",
      "skill_name": "ctrl-can-readonly-log",
