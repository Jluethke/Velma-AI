{
  "name": "warm-introduction-engine",
  "description": "Replace cold outreach (1 to 3 percent response) with warm introductions (40 to 60 percent response) by finding a mutual connection, crafting a blurb the connector can forward without editing, framing the introduction so it benefits both sides, tracking the chain, and following up with the connector whether or not the introduction converts. The follow-up is what keeps the connector willing to introduce you again.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "warm-intro-target-definition",
      "inputs": {
        "outreach-goal": "from_user_input",
        "target-criteria": "from_user_input"
      },
      "outputs": {
        "target-profile": "target-profile",
        "target-shortlist": "target-shortlist"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "warm-intro-mutual-connection-finder",
      "inputs": {
        "target-profile": "step_1.target-profile",
        "target-shortlist": "step_1.target-shortlist"
      },
      "outputs": {
        "mutual-connection-map": "mutual-connection-map",
        "connection-strength-notes": "connection-strength-notes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "warm-intro-connector-selection",
      "inputs": {
        "mutual-connection-map": "step_2.mutual-connection-map",
        "connection-strength-notes": "step_2.connection-strength-notes"
      },
      "outputs": {
        "selected-connectors": "selected-connectors",
        "connector-fit-rationale": "connector-fit-rationale"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "warm-intro-forwardable-blurb-writer",
