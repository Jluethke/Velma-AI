        "blurb-variants": "blurb-variants"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "warm-intro-double-benefit-framing",
      "inputs": {
        "forwardable-blurb": "step_4.forwardable-blurb",
        "blurb-variants": "step_4.blurb-variants"
      },
      "outputs": {
        "mutual-benefit-statement": "mutual-benefit-statement",
