{
  "name": "serverless-security-review",
  "description": "Review serverless function security across IAM roles, event triggers, environment handling, and function-to-function trust boundaries.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "serverless-function-inventory",
      "inputs": {
        "cloud-account-access": "from_user_input",
        "review-scope": "from_user_input"
      },
      "outputs": {
        "function-inventory": "function-inventory",
        "trigger-map": "trigger-map"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "serverless-iam-reviewer",
      "inputs": {
        "function-inventory": "step_1.function-inventory",
        "trigger-map": "step_1.trigger-map"
      },
      "outputs": {
        "iam-findings": "iam-findings",
        "least-privilege-recommendations": "least-privilege-recommendations"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "serverless-event-injection-tester",
      "inputs": {
        "trigger-map": "step_1.trigger-map",
        "function-inventory": "step_1.function-inventory"
      },
      "outputs": {
        "injection-test-results": "injection-test-results",
        "input-validation-gaps": "input-validation-gaps"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "serverless-env-var-reviewer",
      "inputs": {
        "function-inventory": "step_1.function-inventory",
        "cloud-account-access": "from_context.cloud-account-access"
      },
      "outputs": {
        "env-var-findings": "env-var-findings",
        "secrets-handling-status": "secrets-handling-status"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "serverless-abuse-potential-tester",
      "inputs": {
        "function-inventory": "step_1.function-inventory",
        "trigger-map": "step_1.trigger-map"
      },
      "outputs": {
        "abuse-test-results": "abuse-test-results",
        "concurrency-limits-status": "concurrency-limits-status"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "serverless-trust-boundary-tester",
      "inputs": {
        "function-inventory": "step_1.function-inventory",
        "injection-test-results": "step_3.injection-test-results"
      },
      "outputs": {
        "trust-boundary-findings": "trust-boundary-findings",
        "inter-function-map": "inter-function-map"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "serverless-security-report-writer",
      "inputs": {
        "iam-findings": "step_2.iam-findings",
        "injection-test-results": "step_3.injection-test-results",
        "trust-boundary-findings": "step_6.trust-boundary-findings",
        "abuse-test-results": "step_5.abuse-test-results"
      },
      "outputs": {
        "serverless-security-report": "serverless-security-report",
        "remediation-actions": "remediation-actions"
      },
      "parallel_group": 7
    }
  ],
