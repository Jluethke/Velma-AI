{
  "name": "second-order-thinking-template",
  "description": "Apply second-order thinking to any decision: map the immediate consequences, then the consequences of those consequences, then the consequences of those. Most people stop at first order and get surprised by second-order effects.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "decision-and-options-framing",
      "inputs": {
        "decision-description": "from_user_input",
        "options": "from_user_input"
      },
      "outputs": {
        "framed-decision": "framed-decision",
        "option-list": "option-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "first-order-consequence-map",
      "inputs": {
        "framed-decision": "step_1.framed-decision",
        "option-list": "step_1.option-list"
      },
      "outputs": {
        "first-order-consequences": "first-order-consequences",
        "first-order-confidence": "first-order-confidence"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "second-order-consequence-map",
      "inputs": {
        "first-order-consequences": "step_2.first-order-consequences",
        "first-order-confidence": "step_2.first-order-confidence"
      },
      "outputs": {
        "second-order-consequences": "second-order-consequences",
        "second-order-surprises": "second-order-surprises"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "third-order-and-feedback-loops",
      "inputs": {
        "second-order-consequences": "step_3.second-order-consequences",
        "second-order-surprises": "step_3.second-order-surprises"
      },
      "outputs": {
        "third-order-effects": "third-order-effects",
        "feedback-loops": "feedback-loops"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "multi-order-decision-synthesis",
      "inputs": {
        "first-order-consequences": "step_2.first-order-consequences",
        "second-order-consequences": "step_3.second-order-consequences",
        "third-order-effects": "step_4.third-order-effects",
        "feedback-loops": "step_4.feedback-loops"
      },
      "outputs": {
        "option-trajectories": "option-trajectories",
        "recommended-option": "recommended-option"
      },
      "parallel_group": 5
    }
  ],
