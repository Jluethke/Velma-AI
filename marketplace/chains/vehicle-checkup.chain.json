{
  "name": "vehicle-checkup",
  "description": "Full vehicle diagnostic session: health scan across all modules, pre-drive safety check, then maintenance schedule review with upcoming service items.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "vehicle-health",
      "inputs": {
        "vehicle": "from_user_input",
        "scan_scope": "from_user_input",
        "history": "from_user_input"
      },
      "outputs": {
        "module_status": "module_status",
        "dtc_report": "dtc_report",
        "signal_health": "signal_health",
        "trend_analysis": "trend_analysis",
        "action_plan": "action_plan"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "pre-drive-check",
      "inputs": {
        "vehicle": "from_context.vehicle",
        "trip_type": "from_context.trip_type",
        "weather": "from_context.weather"
      },
      "outputs": {
        "readiness_status": "readiness_status",
        "safety_checks": "safety_checks",
        "fluid_levels": "fluid_levels",
        "tire_status": "tire_status",
        "go_no_go": "go_no_go"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "maintenance-schedule",
      "inputs": {
        "vehicle": "from_context.vehicle",
        "mileage": "from_context.mileage",
        "service_history": "from_context.service_history",
        "driving_conditions": "from_context.driving_conditions"
      },
      "outputs": {
        "interval_map": "interval_map",
        "current_status": "current_status",
        "calendar": "calendar",
        "cost_forecast": "cost_forecast"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "velma-maintenance-schedule",
      "inputs": {
        "vehicle": "from_context.vehicle",
        "current_mileage": "from_context.current_mileage",
        "service_history": "from_context.service_history",
        "driving_style": "from_context.driving_style"
      },
      "outputs": {
        "upcoming_services": "upcoming_services",
        "overdue_items": "overdue_items",
        "fluid_status": "fluid_status",
        "wear_estimates": "wear_estimates",
        "annual_plan": "annual_plan"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "troubleshooter",
      "inputs": {
        "symptom": "from_context.symptom",
