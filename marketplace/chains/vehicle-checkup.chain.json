        "conditions": "from_context.conditions"
      },
      "outputs": {
        "diagnosis": "diagnosis",
        "test_results": "test_results",
        "root_cause": "root_cause",
        "fix_plan": "fix_plan"
      },
      "parallel_group": 5
    }
