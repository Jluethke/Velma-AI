{
  "name": "sbom-generation-pipeline",
  "description": "Generate and manage a Software Bill of Materials from dependency inventory through CI/CD integration to vulnerability alerting.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "dependency-inventory-builder",
      "inputs": {
        "project-source": "from_user_input",
        "package-managers": "from_user_input"
      },
      "outputs": {
        "dependency-tree": "dependency-tree",
        "dependency-metadata": "dependency-metadata"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "sbom-format-generator",
      "inputs": {
        "dependency-tree": "step_1.dependency-tree",
        "dependency-metadata": "step_1.dependency-metadata"
      },
      "outputs": {
        "sbom-document": "sbom-document",
        "sbom-validation-result": "sbom-validation-result"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "sbom-enrichment-engine",
      "inputs": {
        "sbom-document": "step_2.sbom-document",
        "dependency-metadata": "step_1.dependency-metadata"
      },
      "outputs": {
        "enriched-sbom": "enriched-sbom",
        "risk-summary": "risk-summary"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "sbom-cicd-integrator",
      "inputs": {
        "enriched-sbom": "step_3.enriched-sbom",
        "project-source": "from_context.project-source"
      },
      "outputs": {
        "pipeline-config": "pipeline-config",
        "integration-test-result": "integration-test-result"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "sbom-version-store",
      "inputs": {
        "enriched-sbom": "step_3.enriched-sbom",
        "pipeline-config": "step_4.pipeline-config"
      },
      "outputs": {
        "sbom-archive": "sbom-archive",
        "archive-access-policy": "archive-access-policy"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "sbom-vulnerability-alerter",
      "inputs": {
        "sbom-archive": "step_5.sbom-archive",
        "risk-summary": "step_3.risk-summary"
      },
      "outputs": {
        "alert-configuration": "alert-configuration",
        "sbom-management-plan": "sbom-management-plan"
      },
      "parallel_group": 6
    }
  ],
