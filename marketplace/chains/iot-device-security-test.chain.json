{
  "name": "iot-device-security-test",
  "description": "Test IoT device security by analyzing firmware, testing network interfaces, checking default credentials, and assessing physical debug access.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "iot-firmware-analysis",
      "inputs": {
        "firmware-image": "from_user_input",
        "device-documentation": "from_user_input"
      },
      "outputs": {
        "firmware-contents": "firmware-contents",
        "embedded-secrets": "embedded-secrets"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "iot-network-protocol-test",
      "inputs": {
        "device-documentation": "from_context.device-documentation",
        "firmware-contents": "step_1.firmware-contents"
      },
      "outputs": {
        "network-findings": "network-findings",
        "protocol-map": "protocol-map"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "iot-default-credentials-check",
      "inputs": {
        "protocol-map": "step_2.protocol-map",
        "embedded-secrets": "step_1.embedded-secrets"
      },
      "outputs": {
        "credential-findings": "credential-findings",
        "auth-mechanism-assessment": "auth-mechanism-assessment"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "iot-ota-update-integrity",
      "inputs": {
        "firmware-contents": "step_1.firmware-contents",
        "network-findings": "step_2.network-findings"
      },
      "outputs": {
        "update-findings": "update-findings",
        "tamper-test-results": "tamper-test-results"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "iot-physical-debug-assessment",
      "inputs": {
        "device-documentation": "from_context.device-documentation",
        "firmware-contents": "step_1.firmware-contents"
      },
      "outputs": {
        "debug-interface-findings": "debug-interface-findings",
        "physical-access-risk": "physical-access-risk"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "iot-data-transmission-review",
      "inputs": {
        "network-findings": "step_2.network-findings",
        "credential-findings": "step_3.credential-findings"
      },
      "outputs": {
        "data-findings": "data-findings",
        "data-flow-map": "data-flow-map"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "iot-security-report",
      "inputs": {
        "embedded-secrets": "step_1.embedded-secrets",
        "network-findings": "step_2.network-findings",
        "update-findings": "step_4.update-findings",
        "debug-interface-findings": "step_5.debug-interface-findings"
      },
      "outputs": {
        "iot-security-report": "iot-security-report",
        "remediation-plan": "remediation-plan"
      },
      "parallel_group": 7
    }
  ],
