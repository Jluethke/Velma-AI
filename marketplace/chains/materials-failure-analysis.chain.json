{
  "name": "materials-failure-analysis",
  "description": "Analyze a materials failure from visual documentation through fractography, root cause determination, and corrective action.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "failure-scene-documenter",
      "inputs": {
        "failed-component": "from_user_input",
        "failure-circumstances": "from_user_input"
      },
      "outputs": {
        "visual-documentation": "visual-documentation",
        "service-history-summary": "service-history-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "fracture-surface-examiner",
      "inputs": {
        "failed-component": "from_context.failed-component",
        "visual-documentation": "step_1.visual-documentation"
      },
      "outputs": {
        "fractographic-record": "fractographic-record",
        "fracture-features": "fracture-features"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "failure-mode-classifier",
      "inputs": {
        "fracture-features": "step_2.fracture-features",
        "service-history-summary": "step_1.service-history-summary"
      },
      "outputs": {
        "failure-mode": "failure-mode",
        "mode-evidence": "mode-evidence"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "material-property-verifier",
      "inputs": {
        "failed-component": "from_context.failed-component",
        "material-specification": "from_context.material-specification"
      },
      "outputs": {
        "material-test-results": "material-test-results",
        "specification-compliance": "specification-compliance"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "root-cause-determiner",
      "inputs": {
        "failure-mode": "step_3.failure-mode",
        "specification-compliance": "step_4.specification-compliance",
        "service-history-summary": "step_1.service-history-summary"
      },
      "outputs": {
        "root-cause": "root-cause",
        "contributing-factors": "contributing-factors"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "failure-analysis-report-writer",
      "inputs": {
        "root-cause": "step_5.root-cause",
        "fractographic-record": "step_2.fractographic-record",
        "material-test-results": "step_4.material-test-results"
      },
      "outputs": {
        "failure-analysis-report": "failure-analysis-report",
        "corrective-actions": "corrective-actions"
      },
      "parallel_group": 6
    }
  ],
