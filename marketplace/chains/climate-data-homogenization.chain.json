{
  "name": "climate-data-homogenization",
  "description": "Detect and correct inhomogeneities in climate station records: compare against neighbors, detect breakpoints, classify causes, adjust the record, and validate corrections.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "neighbor-series-assembler",
      "inputs": {
        "target-station-data": "from_user_input",
        "station-network": "from_user_input"
      },
      "outputs": {
        "reference-series": "reference-series",
        "reference-composite": "reference-composite"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "breakpoint-detector",
      "inputs": {
        "target-station-data": "from_context.target-station-data",
        "reference-composite": "step_1.reference-composite"
      },
      "outputs": {
        "breakpoint-list": "breakpoint-list",
        "difference-series": "difference-series"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "cause-classifier",
      "inputs": {
        "breakpoint-list": "step_2.breakpoint-list",
        "target-station-data": "from_context.target-station-data"
      },
      "outputs": {
        "classified-breakpoints": "classified-breakpoints",
        "undocumented-breaks": "undocumented-breaks"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "adjustment-calculator",
      "inputs": {
        "classified-breakpoints": "step_3.classified-breakpoints",
        "difference-series": "step_2.difference-series"
      },
      "outputs": {
        "adjustment-values": "adjustment-values",
        "homogenized-record": "homogenized-record"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "homogenization-validator",
      "inputs": {
        "homogenized-record": "step_4.homogenized-record",
        "reference-composite": "step_1.reference-composite"
      },
      "outputs": {
        "validation-result": "validation-result",
        "quality-flag": "quality-flag"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "homogenization-report-writer",
      "inputs": {
        "classified-breakpoints": "step_3.classified-breakpoints",
        "adjustment-values": "step_4.adjustment-values",
        "validation-result": "step_5.validation-result"
      },
      "outputs": {
        "homogenization-report": "homogenization-report",
        "homogenized-dataset": "homogenized-dataset"
      },
      "parallel_group": 6
    }
