{
  "name": "secrets-config-least-privilege",
  "description": "Replace stored CI cloud keys with OIDC federation, narrow the cloud role to observed use, split database logins into least-privilege roles, and gate pushes with a secret scan.",
  "steps": [
    {
      "id": "s01_cfg_github_actions_oidc_cloud_auth",
      "skill_name": "cfg-github-actions-oidc-cloud-auth",
      "inputs": {
        "repo_path": "from_user_input",
        "cloud_provider": "from_user_input",
        "github_repo": "from_user_input"
      },
      "outputs": {
        "oidc_role": "oidc_role",
        "workflow_auth_change": "workflow_auth_change"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_cfg_aws_iam_least_privilege_policy",
      "skill_name": "cfg-aws-iam-least-privilege-policy",
      "inputs": {
        "principal_arn": "from_user_input",
        "aws_profile": "from_user_input"
      },
      "outputs": {
        "scoped_policy": "scoped_policy",
        "access_analyzer_findings": "access_analyzer_findings"
      },
      "condition": "cloud_provider == 'aws'",
      "parallel_group": 1
    },
    {
      "id": "s03_cfg_postgres_least_privilege_roles",
      "skill_name": "cfg-postgres-least-privilege-roles",
      "inputs": {
        "pg_admin_conn": "from_user_input_optional",
        "app_schema": "from_user_input_optional",
        "database_name": "from_user_input_optional"
      },
      "outputs": {
        "role_ddl": "role_ddl",
        "privilege_audit": "privilege_audit"
      },
      "condition": "pg_admin_conn != null",
      "parallel_group": 1
    },
    {
      "id": "s04_cfg_ci_secret_scan_gate",
      "skill_name": "cfg-ci-secret-scan-gate",
      "inputs": {
        "repo_path": "from_user_input",
        "ci_platform": "from_user_input",
        "allowlist_changes": "from_user_input_optional"
      },
      "outputs": {
        "ci_scan_job": "ci_scan_job"
      },
      "parallel_group": 1
    }
  ],
  "edges": [],
  "entry_inputs": [
    "repo_path",
    "cloud_provider",
    "github_repo",
    "principal_arn",
    "aws_profile",
    "pg_admin_conn",
    "app_schema",
    "database_name",
    "ci_platform",
    "allowlist_changes"
  ],
  "terminal_outputs": [
    "oidc_role",
    "workflow_auth_change",
    "scoped_policy",
    "access_analyzer_findings",
    "role_ddl",
    "privilege_audit",
    "ci_scan_job"
  ],
  "parallel_groups": [
    [
      "s01_cfg_github_actions_oidc_cloud_auth",
      "s02_cfg_aws_iam_least_privilege_policy",
      "s03_cfg_postgres_least_privilege_roles",
      "s04_cfg_ci_secret_scan_gate"
    ]
  ],
  "estimated_cost": 4,
  "critical_path": [
    "s04_cfg_ci_secret_scan_gate"
  ]
}
