{
  "name": "inversion-problem-solver",
  "description": "Solve problems by inversion: instead of asking how to succeed, ask how you would guarantee failure, then avoid those things. Produces better results than direct optimization because failure modes are more concrete than success paths.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "problem-statement-capture",
      "inputs": {
        "problem-description": "from_user_input",
        "context": "from_user_input"
      },
      "outputs": {
        "positive-statement": "positive-statement",
        "inverted-statement": "inverted-statement"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "failure-guarantee-brainstorm",
      "inputs": {
        "inverted-statement": "step_1.inverted-statement",
        "context": "from_context.context"
      },
      "outputs": {
        "failure-methods": "failure-methods",
        "categorized-failures": "categorized-failures"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "current-behavior-comparison",
      "inputs": {
        "failure-methods": "step_2.failure-methods",
        "categorized-failures": "step_2.categorized-failures"
      },
      "outputs": {
        "overlap-list": "overlap-list",
        "severity-ranking": "severity-ranking"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "anti-failure-action-plan",
      "inputs": {
        "overlap-list": "step_3.overlap-list",
        "severity-ranking": "step_3.severity-ranking"
      },
      "outputs": {
        "anti-failure-actions": "anti-failure-actions",
        "success-indicators": "success-indicators"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "inversion-recheck",
      "inputs": {
        "anti-failure-actions": "step_4.anti-failure-actions",
        "success-indicators": "step_4.success-indicators"
      },
      "outputs": {
        "remaining-overlaps": "remaining-overlaps",
        "new-failure-modes": "new-failure-modes"
      },
      "parallel_group": 5
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
