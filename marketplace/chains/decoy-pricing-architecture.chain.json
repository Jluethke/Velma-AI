      "skill_name": "pricing-page-layout",
      "inputs": {
        "decoy-tier": "step_3.decoy-tier",
        "feature-allocation": "step_4.feature-allocation"
      },
      "outputs": {
        "page-layout": "page-layout",
        "visual-emphasis-plan": "visual-emphasis-plan"
      },
      "parallel_group": 5
    },
    {
