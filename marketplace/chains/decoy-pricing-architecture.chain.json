        "tier-map": "step_1.tier-map",
        "value-gaps": "step_1.value-gaps"
      },
      "outputs": {
        "value-metric": "value-metric",
        "willingness-to-pay-notes": "willingness-to-pay-notes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "decoy-tier-construction",
      "inputs": {
        "tier-map": "step_1.tier-map",
        "value-metric": "step_2.value-metric"
      },
      "outputs": {
