{
  "name": "restaurant-inventory-management",
  "description": "Manage restaurant inventory from par levels through ordering, receiving, and cost analysis.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "par-level-setter",
      "inputs": {
        "ingredient-list": "from_user_input",
        "usage-history": "from_user_input"
      },
      "outputs": {
        "par-levels": "par-levels",
        "reorder-points": "reorder-points"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "usage-waste-tracker",
      "inputs": {
        "par-levels": "step_1.par-levels",
        "daily-production-log": "from_context.daily-production-log"
      },
      "outputs": {
        "usage-report": "usage-report",
        "waste-log": "waste-log"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "purchase-order-generator",
      "inputs": {
        "reorder-points": "step_1.reorder-points",
        "scenario-results": "from_context.scenario-results"
      },
      "outputs": {
        "purchase-orders": "purchase-orders",
        "inventory-forecast": "inventory-forecast"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "delivery-inspector",
      "inputs": {
        "purchase-orders": "step_3.purchase-orders",
        "delivery-documents": "from_context.delivery-documents"
      },
      "outputs": {
        "receiving-log": "receiving-log",
        "discrepancy-report": "discrepancy-report"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "physical-count-reconciler",
      "inputs": {
        "receiving-log": "step_4.receiving-log",
        "usage-report": "step_2.usage-report"
      },
      "outputs": {
        "count-reconciliation": "count-reconciliation",
        "inventory-variance": "inventory-variance"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "food-cost-analyzer",
      "inputs": {
        "inventory-variance": "step_5.inventory-variance",
        "waste-log": "step_2.waste-log"
      },
      "outputs": {
        "food-cost-report": "food-cost-report",
        "inventory-management-report": "inventory-management-report"
      },
      "parallel_group": 6
    }
