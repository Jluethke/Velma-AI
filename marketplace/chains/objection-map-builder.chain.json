{
  "name": "objection-map-builder",
  "description": "Map every possible objection to any proposal, plan, or ask. For each objection, find the stated concern, the real concern underneath it, and the honest response. Group by underlying concern and pre-empt the top three in your initial message. Works for sales, negotiations, internal proposals, and personal requests.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "proposal-surface-scan",
      "inputs": {
        "proposal-description": "from_user_input",
        "stakeholder-list": "from_user_input"
      },
      "outputs": {
        "objection-surfaces": "objection-surfaces",
        "stakeholder-exposure-map": "stakeholder-exposure-map"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "stated-objection-collector",
      "inputs": {
        "objection-surfaces": "step_1.objection-surfaces",
        "stakeholder-exposure-map": "step_1.stakeholder-exposure-map"
      },
      "outputs": {
        "stated-objections": "stated-objections",
        "frequency-ranking": "frequency-ranking"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "real-concern-excavator",
      "inputs": {
        "stated-objections": "step_2.stated-objections",
        "stakeholder-exposure-map": "step_1.stakeholder-exposure-map"
      },
      "outputs": {
        "concern-pairs": "concern-pairs",
        "concern-clusters": "concern-clusters"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "honest-response-drafter",
      "inputs": {
        "concern-pairs": "step_3.concern-pairs",
        "proposal-description": "from_context.proposal-description"
      },
      "outputs": {
        "response-map": "response-map",
        "unresolvable-concerns": "unresolvable-concerns"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "pre-emption-sequencer",
      "inputs": {
        "response-map": "step_4.response-map",
        "frequency-ranking": "step_2.frequency-ranking",
        "concern-clusters": "step_3.concern-clusters"
      },
      "outputs": {
        "pre-emption-statements": "pre-emption-statements",
        "remaining-response-playbook": "remaining-response-playbook"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "objection-map-stress-test",
      "inputs": {
        "pre-emption-statements": "step_5.pre-emption-statements",
        "remaining-response-playbook": "step_5.remaining-response-playbook"
      },
      "outputs": {
        "stress-test-results": "stress-test-results",
        "final-objection-map": "final-objection-map"
      },
      "parallel_group": 6
    }
  ],
