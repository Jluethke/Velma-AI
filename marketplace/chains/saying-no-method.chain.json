        "request-summary": "step_1.request-summary",
        "cost-of-yes": "step_1.cost-of-yes"
      },
      "outputs": {
        "alternative-offer": "alternative-offer",
        "no-alternative-note": "no-alternative-note"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "snm-message-assembler",
      "inputs": {
