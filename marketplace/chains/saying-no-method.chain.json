{
  "name": "saying-no-method",
  "description": "Decline a request cleanly without burning the relationship. Acknowledge the request, state the no clearly, give one brief real reason rather than an excuse, and offer an alternative if a real one exists. One apology is polite, three is submissive. Saying yes when you mean no usually costs more social capital than the honest no would have.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "snm-request-and-cost-assessor",
      "inputs": {
        "request-received": "from_user_input",
        "relationship-context": "from_user_input"
      },
      "outputs": {
        "request-summary": "request-summary",
        "cost-of-yes": "cost-of-yes"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "snm-no-decision-check",
      "inputs": {
        "cost-of-yes": "step_1.cost-of-yes",
        "request-summary": "step_1.request-summary"
      },
      "outputs": {
        "no-decision": "no-decision",
        "decision-rationale": "decision-rationale"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "snm-acknowledgment-writer",
      "inputs": {
        "request-summary": "step_1.request-summary"
      },
      "outputs": {
        "acknowledgment-line": "acknowledgment-line",
        "tone-note": "tone-note"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "snm-clear-no-and-reason",
      "inputs": {
        "no-decision": "step_2.no-decision",
        "decision-rationale": "step_2.decision-rationale"
      },
      "outputs": {
        "no-statement": "no-statement",
        "brief-reason": "brief-reason"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "snm-alternative-offer",
