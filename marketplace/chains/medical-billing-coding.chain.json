{
  "name": "medical-billing-coding",
  "description": "Process medical billing and coding from encounter documentation through claim submission, tracking, and denial management.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "encounter-documentation-intake",
      "inputs": {
        "encounter-notes": "from_user_input",
        "patient-demographics": "from_user_input"
      },
      "outputs": {
        "encounter-summary": "encounter-summary",
        "documentation-gaps": "documentation-gaps"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "diagnosis-procedure-coding",
      "inputs": {
        "encounter-summary": "step_1.encounter-summary",
        "documentation-gaps": "step_1.documentation-gaps"
      },
      "outputs": {
        "coded-encounter": "coded-encounter",
        "coding-notes": "coding-notes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "coding-compliance-review",
      "inputs": {
        "coded-encounter": "step_2.coded-encounter",
        "coding-notes": "step_2.coding-notes"
      },
      "outputs": {
        "compliant-encounter": "compliant-encounter",
        "compliance-flags": "compliance-flags"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "claim-submission",
      "inputs": {
        "compliant-encounter": "step_3.compliant-encounter",
        "patient-demographics": "from_context.patient-demographics"
      },
      "outputs": {
        "submitted-claim": "submitted-claim",
        "submission-errors": "submission-errors"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "claim-status-tracking",
      "inputs": {
        "submitted-claim": "step_4.submitted-claim"
      },
      "outputs": {
        "adjudicated-claim": "adjudicated-claim",
        "denial-list": "denial-list"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "denial-appeal-management",
      "inputs": {
        "denial-list": "step_5.denial-list",
        "adjudicated-claim": "step_5.adjudicated-claim"
      },
      "outputs": {
        "billing-record": "billing-record",
        "denial-trends": "denial-trends"
      },
      "parallel_group": 6
    }
