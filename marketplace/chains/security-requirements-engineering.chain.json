{
  "name": "security-requirements-engineering",
  "description": "Gather and validate security requirements from abuse case analysis through threat-driven requirements, acceptance criteria, and traceability.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "system-context-analyzer",
      "inputs": {
        "system-description": "from_user_input",
        "data-sensitivity-profile": "from_user_input"
      },
      "outputs": {
        "system-context-model": "system-context-model",
        "trust-boundary-map": "trust-boundary-map"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "abuse-case-developer",
      "inputs": {
        "system-context-model": "step_1.system-context-model",
        "trust-boundary-map": "step_1.trust-boundary-map"
      },
      "outputs": {
        "abuse-cases": "abuse-cases",
        "misuse-scenarios": "misuse-scenarios"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "threat-driven-requirement-deriver",
      "inputs": {
        "abuse-cases": "step_2.abuse-cases",
        "trust-boundary-map": "step_1.trust-boundary-map"
      },
      "outputs": {
        "security-requirements": "security-requirements",
        "requirement-rationale": "requirement-rationale"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "requirement-acceptance-criteria-writer",
      "inputs": {
        "security-requirements": "step_3.security-requirements",
        "misuse-scenarios": "step_2.misuse-scenarios"
      },
      "outputs": {
        "acceptance-criteria": "acceptance-criteria",
        "verification-methods": "verification-methods"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "requirement-prioritizer",
      "inputs": {
        "security-requirements": "step_3.security-requirements",
        "requirement-rationale": "step_3.requirement-rationale"
      },
      "outputs": {
        "prioritized-requirements": "prioritized-requirements",
        "priority-rationale": "priority-rationale"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "requirement-traceability-builder",
      "inputs": {
        "prioritized-requirements": "step_5.prioritized-requirements",
        "acceptance-criteria": "step_4.acceptance-criteria"
      },
      "outputs": {
        "traceability-matrix": "traceability-matrix",
        "requirements-baseline": "requirements-baseline"
      },
      "parallel_group": 6
    }
  ],
