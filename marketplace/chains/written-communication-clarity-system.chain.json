{
  "name": "written-communication-clarity-system",
  "description": "Build a revision system for written communication. First draft: write everything. Second pass: cut what does not advance the reader toward action. Third pass: replace abstract words with concrete ones. Fourth pass: conclusion first. The test: can the reader act after the first paragraph?",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "reader-action-definer",
      "inputs": {
        "draft-or-topic": "from_user_input",
        "reader-description": "from_user_input"
      },
      "outputs": {
        "reader-action": "reader-action",
        "reader-questions": "reader-questions"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "first-draft-dump",
      "inputs": {
        "reader-action": "step_1.reader-action",
        "reader-questions": "step_1.reader-questions"
      },
      "outputs": {
        "raw-draft": "raw-draft",
        "word-count": "word-count"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "action-relevance-cutter",
      "inputs": {
        "raw-draft": "step_2.raw-draft",
        "reader-action": "step_1.reader-action"
      },
      "outputs": {
        "trimmed-draft": "trimmed-draft",
        "cut-log": "cut-log"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "concrete-word-replacer",
      "inputs": {
        "trimmed-draft": "step_3.trimmed-draft"
      },
      "outputs": {
        "concrete-draft": "concrete-draft",
        "abstraction-log": "abstraction-log"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "inverted-pyramid-restructurer",
      "inputs": {
        "concrete-draft": "step_4.concrete-draft",
        "reader-action": "step_1.reader-action"
      },
      "outputs": {
        "final-draft": "final-draft",
        "one-paragraph-test-result": "one-paragraph-test-result"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "final-readability-check",
      "inputs": {
        "final-draft": "step_5.final-draft"
      },
      "outputs": {
        "published-message": "published-message",
        "word-count-reduction": "word-count-reduction"
      },
      "parallel_group": 6
    }
  ],
