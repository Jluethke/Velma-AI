{
  "name": "privilege-escalation-assessment",
  "description": "Assess privilege escalation paths by mapping roles and permissions, testing horizontal and vertical escalation, and reviewing permission inheritance.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "privesc-role-permission-map",
      "inputs": {
        "application-access": "from_user_input",
        "scope-definition": "from_user_input"
      },
      "outputs": {
        "role-permission-matrix": "role-permission-matrix",
        "admin-surface-map": "admin-surface-map"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "privesc-horizontal-test",
      "inputs": {
        "role-permission-matrix": "step_1.role-permission-matrix",
        "application-access": "from_context.application-access"
      },
      "outputs": {
        "horizontal-findings": "horizontal-findings",
        "data-isolation-assessment": "data-isolation-assessment"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "privesc-vertical-test",
      "inputs": {
        "role-permission-matrix": "step_1.role-permission-matrix",
        "admin-surface-map": "step_1.admin-surface-map"
      },
      "outputs": {
        "vertical-findings": "vertical-findings",
        "admin-bypass-findings": "admin-bypass-findings"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "privesc-idor-check",
      "inputs": {
        "application-access": "from_context.application-access",
        "horizontal-findings": "step_2.horizontal-findings"
      },
      "outputs": {
        "idor-findings": "idor-findings",
        "id-scheme-assessment": "id-scheme-assessment"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "privesc-token-elevation-test",
      "inputs": {
        "vertical-findings": "step_3.vertical-findings",
        "role-permission-matrix": "step_1.role-permission-matrix"
      },
      "outputs": {
        "token-elevation-findings": "token-elevation-findings",
        "token-validation-assessment": "token-validation-assessment"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "privesc-permission-chain-review",
      "inputs": {
        "role-permission-matrix": "step_1.role-permission-matrix",
        "token-elevation-findings": "step_5.token-elevation-findings"
      },
      "outputs": {
        "inheritance-findings": "inheritance-findings",
        "delegation-findings": "delegation-findings"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "privesc-assessment-report",
      "inputs": {
        "horizontal-findings": "step_2.horizontal-findings",
        "vertical-findings": "step_3.vertical-findings",
        "idor-findings": "step_4.idor-findings",
        "token-elevation-findings": "step_5.token-elevation-findings"
      },
      "outputs": {
        "privesc-report": "privesc-report",
        "remediation-plan": "remediation-plan"
      },
      "parallel_group": 7
    }
