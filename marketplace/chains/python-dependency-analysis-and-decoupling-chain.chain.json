        "stack": "from_context.stack",
        "repo_path": "from_context.repo_path"
      },
      "outputs": {
        "coverage_report": "coverage_report",
        "harness_improvements": "harness_improvements"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "shs-port-to-python",
      "inputs": {
        "existing_script": "from_context.existing_script",
        "script_requirements": "from_context.script_requirements",
        "decision_evidence": "from_context.decision_evidence"
      },
      "outputs": {
        "python_port": "python_port"
      },
      "parallel_group": 5
    }
  ],
