{
  "name": "python-dependency-analysis-and-decoupling-chain",
  "description": "Analyze a Python codebase to extract module dependencies, detect circular imports, identify coupling hotspots, and generate decoupling recommendations with visual dependency graphs.",
  "steps": [
    {
      "id": "step_1_discovery",
      "skill_name": "dependency-mapper",
      "inputs": {
        "codebase_root": "from_context.codebase_root",
        "exclude_patterns": "from_context.exclude_patterns",
        "include_stdlib": "from_context.include_stdlib",
        "include_third_party": "from_context.include_third_party",
        "output_format": "from_context.output_format",
        "coupling_threshold": "from_context.coupling_threshold"
      },
      "outputs": {
        "modules_discovered": "modules_discovered",
        "import_graph": "import_graph",
        "circular_dependencies": "circular_dependencies",
        "coupling_metrics": "coupling_metrics",
        "high_coupling_modules": "high_coupling_modules",
        "decoupling_recommendations": "decoupling_recommendations",
        "graph_visualization": "graph_visualization",
        "report_summary": "report_summary"
      },
      "parallel_group": 1,
      "description": "Execute the Dependency Mapper skill to analyze the codebase and produce all analysis outputs."
    },
    {
      "id": "step_2",
      "skill_name": "mex-node-boundary-dependency-cruiser",
      "inputs": {
        "repo_path": "from_context.repo_path",
        "module_interface": "from_context.module_interface"
      },
      "outputs": {
        "node_boundary_rules": "node_boundary_rules"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "phase-2-design-project-concept-and-real-world-context",
      "inputs": {
        "available_resources": "from_context.available_resources",
        "learner_motivation": "from_context.learner_motivation",
        "learning_objective": "from_context.learning_objective"
      },
      "outputs": {
        "project_brief": "project_brief"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "pft-coverage-plateau-analysis",
      "inputs": {
        "go_fuzz_findings": "from_context.go_fuzz_findings",
        "rust_fuzz_findings": "from_context.rust_fuzz_findings",
        "cpp_fuzz_findings": "from_context.cpp_fuzz_findings",
        "py_fuzz_findings": "from_context.py_fuzz_findings",
        "jvm_fuzz_findings": "from_context.jvm_fuzz_findings",
