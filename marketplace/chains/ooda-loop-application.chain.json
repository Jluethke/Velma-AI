{
  "name": "ooda-loop-application",
  "description": "Apply John Boyd's OODA loop (Observe, Orient, Decide, Act) to a competitive situation where speed of decision matters. Map each stage of your loop, measure its latency, find the slowest stage, and shrink it. The side that cycles faster acts on newer information while rivals react to moves already changed.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "ooda-loop-context-capture",
      "inputs": {
        "situation-description": "from_user_input",
        "decision-cadence": "from_user_input",
        "competitor-tempo": "from_user_input"
      },
      "outputs": {
        "loop-context": "loop-context",
        "decision-inventory": "decision-inventory"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "ooda-observe-stage-mapping",
      "inputs": {
        "loop-context": "step_1.loop-context",
        "decision-inventory": "step_1.decision-inventory"
      },
      "outputs": {
        "observe-map": "observe-map",
        "observe-latency": "observe-latency"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "ooda-orient-stage-mapping",
      "inputs": {
        "loop-context": "step_1.loop-context",
        "observe-map": "step_2.observe-map"
      },
      "outputs": {
        "orient-map": "orient-map",
        "orient-latency": "orient-latency"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "ooda-decide-stage-mapping",
      "inputs": {
        "loop-context": "step_1.loop-context",
        "orient-map": "step_3.orient-map"
      },
      "outputs": {
        "decide-map": "decide-map",
        "decide-latency": "decide-latency"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "ooda-act-stage-mapping",
      "inputs": {
        "loop-context": "step_1.loop-context",
        "decide-map": "step_4.decide-map"
      },
      "outputs": {
        "act-map": "act-map",
        "act-latency": "act-latency"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "ooda-bottleneck-identification",
      "inputs": {
        "observe-latency": "step_2.observe-latency",
        "orient-latency": "step_3.orient-latency",
        "decide-latency": "step_4.decide-latency",
        "act-latency": "step_5.act-latency"
      },
      "outputs": {
        "loop-bottleneck": "loop-bottleneck",
        "cycle-time-total": "cycle-time-total"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "ooda-cycle-compression-plan",
      "inputs": {
        "loop-bottleneck": "step_6.loop-bottleneck",
        "cycle-time-total": "step_6.cycle-time-total"
      },
      "outputs": {
        "compression-plan": "compression-plan",
        "target-cycle-time": "target-cycle-time"
      },
      "parallel_group": 7
    }
  ],
