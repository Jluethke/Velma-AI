{
  "name": "capacity-planning-model",
  "description": "Calculate the capacity of any system before it degrades. Measure maximum sustainable throughput, current load as a percentage, and the lead time to add capacity. Start capacity additions before you need them, not after.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "max-sustainable-throughput-measurer",
      "inputs": {
        "system-description": "from_user_input",
        "throughput-unit": "from_user_input"
      },
      "outputs": {
        "max-sustainable-throughput": "max-sustainable-throughput",
        "degradation-indicators": "degradation-indicators"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "current-load-profiler",
      "inputs": {
        "system-description": "from_context.system-description",
        "throughput-unit": "from_context.throughput-unit"
      },
      "outputs": {
        "current-load": "current-load",
        "load-growth-rate": "load-growth-rate"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "capacity-addition-lead-time-estimator",
      "inputs": {
        "system-description": "from_context.system-description",
        "current-load": "step_2.current-load",
        "load-growth-rate": "step_2.load-growth-rate"
      },
      "outputs": {
        "capacity-options": "capacity-options",
        "critical-date": "critical-date"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "capacity-plan-builder",
      "inputs": {
        "capacity-options": "step_3.capacity-options",
        "critical-date": "step_3.critical-date",
        "load-growth-rate": "step_2.load-growth-rate"
      },
      "outputs": {
        "capacity-plan": "capacity-plan",
        "review-triggers": "review-triggers"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
