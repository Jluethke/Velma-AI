{
  "name": "90-day-goal-planner-chain",
  "description": "Convert an ambiguous goal into a concrete, executable 90-day action plan with milestones, task dependencies, resource allocation, and weekly checkpoints.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "goal-clarifier",
      "inputs": {
        "goal_context": "from_user_input_optional",
        "goal_statement": "from_user_input",
        "known_risks": "from_user_input_optional"
      },
      "outputs": {
        "clarified_goal": "clarified_goal_object"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "kra-decomposer",
      "inputs": {
        "clarified_goal": "step_1.clarified_goal",
        "goal_context": "from_user_input_optional"
      },
      "outputs": {
        "key_result_areas": "kra_array"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "milestone-designer",
      "inputs": {
        "clarified_goal": "step_1.clarified_goal",
        "key_result_areas": "step_2.key_result_areas"
      },
      "outputs": {
        "milestones": "milestone_array"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "task-breakdown-engine",
      "inputs": {
        "key_result_areas": "step_2.key_result_areas",
        "milestones": "step_3.milestones"
      },
      "outputs": {
        "weekly_tasks": "task_array"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "dependency-mapper",
      "inputs": {
        "codebase_root": "from_context.codebase_root",
        "exclude_patterns": "from_context.exclude_patterns",
        "include_stdlib": "from_context.include_stdlib",
        "include_third_party": "from_context.include_third_party",
        "output_format": "from_context.output_format",
        "coupling_threshold": "from_context.coupling_threshold"
      },
      "outputs": {
        "modules_discovered": "object",
        "import_graph": "object",
        "circular_dependencies": "object",
        "coupling_metrics": "object",
        "high_coupling_modules": "object",
        "decoupling_recommendations": "object",
        "graph_visualization": "object",
        "report_summary": "object"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "resource-allocator",
      "inputs": {
        "available_resources": "from_user_input_optional",
        "dependency_graph": "step_5.modules_discovered",
        "weekly_tasks": "step_4.weekly_tasks"
      },
      "outputs": {
        "resource_plan": "resource_plan_object"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "checkpoint-designer",
      "inputs": {
        "key_result_areas": "step_2.key_result_areas",
        "milestones": "step_3.milestones",
        "weekly_tasks": "step_4.weekly_tasks"
      },
      "outputs": {
        "checkpoint_template": "checkpoint_template_object"
      },
      "parallel_group": 7
    },
    {
      "id": "step_8",
      "skill_name": "risk-register-builder",
      "inputs": {
        "scope_document": "from_context.scope_document",
        "project_type": "from_context.project_type",
        "risk_assessment_scale": "from_context.risk_assessment_scale",
        "historical_data": "from_context.historical_data",
        "stakeholder_input": "from_context.stakeholder_input",
        "risk_appetite": "from_context.risk_appetite"
      },
      "outputs": {
        "risk_register": "risk_register_array",
        "risk_heatmap": "object",
        "mitigation_plan": "object",
        "early_warning_indicators": "object"
      },
      "parallel_group": 7
    },
    {
      "id": "step_9",
      "skill_name": "plan-assembler",
      "inputs": {
        "checkpoint_template": "step_7.checkpoint_template",
        "clarified_goal": "step_1.clarified_goal",
        "dependency_graph": "step_5.modules_discovered",
        "key_result_areas": "step_2.key_result_areas",
        "milestones": "step_3.milestones",
        "resource_plan": "step_6.resource_plan",
        "risk_register": "step_8.risk_register",
        "weekly_tasks": "step_4.weekly_tasks"
      },
      "outputs": {
        "action_plan_document": "markdown_string"
      },
      "parallel_group": 8
    }
  ],
