{
  "name": "cash-flow-timing-optimizer",
  "description": "Optimize the timing of cash inflows and outflows. The total amount matters less than when it arrives and when it leaves. A business (or household) that collects before it pays has free float. One that pays before it collects needs financing. Map every inflow and outflow to a calendar, find the gaps, and close them.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "cash-flow-calendar-builder",
      "inputs": {
        "income-sources": "from_user_input",
        "expense-obligations": "from_user_input"
      },
      "outputs": {
        "cash-flow-calendar": "cash-flow-calendar",
        "negative-balance-days": "negative-balance-days"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "gap-closer",
      "inputs": {
        "negative-balance-days": "step_1.negative-balance-days",
        "cash-flow-calendar": "step_1.cash-flow-calendar"
      },
      "outputs": {
        "timing-adjustments": "timing-adjustments",
        "revised-calendar": "revised-calendar"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "float-maximizer",
      "inputs": {
        "revised-calendar": "step_2.revised-calendar",
        "income-sources": "from_context.income-sources"
      },
      "outputs": {
        "float-analysis": "float-analysis",
        "float-improvement-plan": "float-improvement-plan"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cash-flow-stress-tester",
      "inputs": {
        "revised-calendar": "step_2.revised-calendar",
        "float-analysis": "step_3.float-analysis"
      },
      "outputs": {
        "stress-scenarios": "stress-scenarios",
        "contingency-triggers": "contingency-triggers"
      },
      "parallel_group": 4
    }
  ],
