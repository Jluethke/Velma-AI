        "prior-specification": "prior-specification",
        "prior-justification": "prior-justification"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "likelihood-model-builder",
      "inputs": {
        "observed-data": "from_context.observed-data",
        "prior-specification": "step_1.prior-specification"
      },
      "outputs": {
        "generative-model": "generative-model",
        "model-dag": "model-dag"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "posterior-sampler",
      "inputs": {
        "generative-model": "step_2.generative-model",
        "observed-data": "from_context.observed-data"
      },
      "outputs": {
        "posterior-samples": "posterior-samples",
        "sampling-metadata": "sampling-metadata"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "convergence-checker",
      "inputs": {
        "posterior-samples": "step_3.posterior-samples",
        "sampling-metadata": "step_3.sampling-metadata"
      },
      "outputs": {
        "convergence-report": "convergence-report",
        "convergence-verdict": "convergence-verdict"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "posterior-summary-builder",
      "inputs": {
        "posterior-samples": "step_3.posterior-samples",
        "observed-data": "from_context.observed-data"
      },
      "outputs": {
        "posterior-summary-table": "posterior-summary-table",
        "posterior-predictive-check": "posterior-predictive-check",
        "model-comparison": "model-comparison"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "frequentist-comparator",
      "inputs": {
        "observed-data": "from_context.observed-data",
        "posterior-summary-table": "step_5.posterior-summary-table"
      },
      "outputs": {
        "frequentist-estimates": "frequentist-estimates",
        "comparison-table": "comparison-table"
      },
      "parallel_group": 6
    }
