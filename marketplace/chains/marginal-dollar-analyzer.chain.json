{
  "name": "marginal-dollar-analyzer",
  "description": "Determine where the next dollar produces the most value. Marginal analysis asks: given that I am already spending X, what is the return on one more dollar in each category? The answer is almost never the same as the average return. Use for household spending decisions, marketing budget allocation, hiring decisions, and investment choices.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "current-allocation-snapshot",
      "inputs": {
        "spending-categories": "from_user_input",
        "return-metrics": "from_user_input"
      },
      "outputs": {
        "allocation-snapshot": "allocation-snapshot",
        "average-returns": "average-returns"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "marginal-return-estimator",
      "inputs": {
        "allocation-snapshot": "step_1.allocation-snapshot",
        "average-returns": "step_1.average-returns"
      },
      "outputs": {
        "marginal-returns": "marginal-returns",
        "diminishing-return-flags": "diminishing-return-flags"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "reallocation-opportunity-finder",
      "inputs": {
        "marginal-returns": "step_2.marginal-returns",
        "allocation-snapshot": "step_1.allocation-snapshot"
      },
      "outputs": {
        "reallocation-opportunities": "reallocation-opportunities",
        "reallocation-constraints": "reallocation-constraints"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "marginal-decision-framework",
      "inputs": {
        "reallocation-opportunities": "step_3.reallocation-opportunities",
        "marginal-returns": "step_2.marginal-returns"
      },
      "outputs": {
        "spending-decisions": "spending-decisions",
        "marginal-analysis-document": "marginal-analysis-document"
      },
      "parallel_group": 4
    }
  ],
