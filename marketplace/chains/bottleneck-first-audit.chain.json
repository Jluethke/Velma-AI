{
  "name": "bottleneck-first-audit",
  "description": "Apply the Theory of Constraints: find the ONE bottleneck in any system, improve only that bottleneck, then find the new bottleneck. Improving anything other than the bottleneck is waste because the system throughput is limited by its constraint.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "system-throughput-mapping",
      "inputs": {
        "system-description": "from_user_input",
        "throughput-goal": "from_user_input"
      },
      "outputs": {
        "step-sequence": "step-sequence",
        "current-throughput": "current-throughput"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "bottleneck-identification",
      "inputs": {
        "step-sequence": "step_1.step-sequence",
        "current-throughput": "step_1.current-throughput"
      },
      "outputs": {
        "bottleneck-step": "bottleneck-step",
        "bottleneck-cost": "bottleneck-cost"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "exploit-the-bottleneck",
      "inputs": {
        "bottleneck-step": "step_2.bottleneck-step",
        "bottleneck-cost": "step_2.bottleneck-cost"
      },
      "outputs": {
        "exploitation-actions": "exploitation-actions",
        "capacity-after-exploitation": "capacity-after-exploitation"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "subordinate-other-steps",
      "inputs": {
        "exploitation-actions": "step_3.exploitation-actions",
        "step-sequence": "step_1.step-sequence"
      },
      "outputs": {
        "subordination-plan": "subordination-plan",
        "waste-reduction": "waste-reduction"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "elevate-the-bottleneck",
      "inputs": {
        "capacity-after-exploitation": "step_3.capacity-after-exploitation",
        "bottleneck-cost": "step_2.bottleneck-cost"
      },
      "outputs": {
        "elevation-options": "elevation-options",
        "elevation-roi": "elevation-roi"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "new-bottleneck-detection",
      "inputs": {
        "elevation-options": "step_5.elevation-options",
        "step-sequence": "step_1.step-sequence"
      },
      "outputs": {
        "new-system-throughput": "new-system-throughput",
        "new-bottleneck": "new-bottleneck"
      },
      "parallel_group": 6
    }
  ],
  "edges": [
