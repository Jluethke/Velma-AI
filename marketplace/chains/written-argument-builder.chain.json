{
  "name": "written-argument-builder",
  "description": "Build a written argument using the Minto Pyramid: conclusion first, then supporting arguments, then evidence. The reader gets the answer in the first sentence, not the last.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "conclusion-first-statement",
      "inputs": {
        "topic": "from_user_input",
        "audience": "from_user_input"
      },
      "outputs": {
        "conclusion-statement": "conclusion-statement",
        "reader-question": "reader-question"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "supporting-argument-structure",
      "inputs": {
        "conclusion-statement": "step_1.conclusion-statement",
        "reader-question": "step_1.reader-question"
      },
      "outputs": {
        "argument-structure": "argument-structure",
        "argument-order": "argument-order"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "evidence-layer",
      "inputs": {
        "argument-structure": "step_2.argument-structure",
        "topic": "from_context.topic"
      },
      "outputs": {
        "evidence-map": "evidence-map",
        "evidence-gaps": "evidence-gaps"
      },
      "parallel_group": 3
    },
    {
