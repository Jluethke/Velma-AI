      "outputs": {
        "likely-objections": "likely-objections",
        "preemptive-responses": "preemptive-responses"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "document-assembly",
      "inputs": {
        "conclusion-statement": "step_1.conclusion-statement",
        "argument-structure": "step_2.argument-structure",
        "evidence-map": "step_3.evidence-map",
        "preemptive-responses": "step_4.preemptive-responses"
      },
      "outputs": {
