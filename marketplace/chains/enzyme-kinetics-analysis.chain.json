{
  "name": "enzyme-kinetics-analysis",
  "description": "Characterize enzyme kinetics from assay design through data collection, Michaelis-Menten fitting, inhibition testing, and kinetic parameter reporting.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "kinetic-assay-designer",
      "inputs": {
        "enzyme-info": "from_user_input",
        "substrate-info": "from_user_input",
        "detection-method": "from_user_input"
      },
      "outputs": {
        "assay-protocol": "assay-protocol",
        "substrate-range": "substrate-range"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "initial-velocity-collector",
      "inputs": {
        "assay-protocol": "step_1.assay-protocol",
        "substrate-range": "step_1.substrate-range"
      },
      "outputs": {
        "velocity-data": "velocity-data",
        "progress-curves": "progress-curves"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "michaelis-menten-fitter",
      "inputs": {
        "velocity-data": "step_2.velocity-data"
      },
      "outputs": {
        "km-vmax": "km-vmax",
        "fit-quality": "fit-quality"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "inhibition-type-tester",
      "inputs": {
        "velocity-data": "step_2.velocity-data",
        "km-vmax": "step_3.km-vmax"
      },
      "outputs": {
        "inhibition-type": "inhibition-type",
        "ki-value": "ki-value"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "kinetics-parameter-reporter",
      "inputs": {
        "km-vmax": "step_3.km-vmax",
        "inhibition-type": "step_4.inhibition-type",
        "ki-value": "step_4.ki-value",
        "fit-quality": "step_3.fit-quality"
      },
      "outputs": {
        "kinetics-report": "kinetics-report",
        "parameter-table": "parameter-table"
      },
      "parallel_group": 5
    }
  ],
