{
  "name": "reciprocity-mapping",
  "description": "Map the flow of value in your network: for each key relationship, what you give, what they give, and whether the exchange is balanced. Imbalanced relationships are unstable (chronic over-givers burn out, chronic under-givers get quietly dropped), so the map identifies where you over-give and where you under-give and produces a plan to rebalance before the instability forces the issue.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "recip-relationship-selection",
      "inputs": {
        "network-list": "from_user_input",
        "value-lens": "from_user_input"
      },
      "outputs": {
        "focus-relationships": "focus-relationships",
        "lens-definition": "lens-definition"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "recip-give-inventory",
      "inputs": {
        "focus-relationships": "step_1.focus-relationships",
        "lens-definition": "step_1.lens-definition"
      },
      "outputs": {
        "give-inventory": "give-inventory",
        "give-frequency-notes": "give-frequency-notes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "recip-receive-inventory",
      "inputs": {
        "give-inventory": "step_2.give-inventory",
        "give-frequency-notes": "step_2.give-frequency-notes"
      },
      "outputs": {
        "receive-inventory": "receive-inventory",
        "receive-frequency-notes": "receive-frequency-notes"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "recip-balance-assessor",
      "inputs": {
        "receive-inventory": "step_3.receive-inventory",
        "receive-frequency-notes": "step_3.receive-frequency-notes"
      },
      "outputs": {
        "balance-ratios": "balance-ratios",
        "flow-direction-map": "flow-direction-map"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "recip-imbalance-classifier",
      "inputs": {
        "balance-ratios": "step_4.balance-ratios",
        "flow-direction-map": "step_4.flow-direction-map"
      },
      "outputs": {
        "over-give-list": "over-give-list",
        "under-give-list": "under-give-list"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "recip-rebalance-planner",
      "inputs": {
        "over-give-list": "step_5.over-give-list",
        "under-give-list": "step_5.under-give-list"
      },
      "outputs": {
        "rebalance-actions": "rebalance-actions",
        "rebalance-cautions": "rebalance-cautions"
      },
      "parallel_group": 6
    }
  ],
