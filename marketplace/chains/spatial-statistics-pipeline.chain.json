{
  "name": "spatial-statistics-pipeline",
  "description": "Analyze spatial data: map point patterns, test for clustering, estimate spatial autocorrelation, interpolate with kriging, and produce spatial prediction maps with uncertainty.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "spatial-data-mapper",
      "inputs": {
        "spatial-dataset": "from_user_input",
        "region-definition": "from_user_input"
      },
      "outputs": {
        "projected-dataset": "projected-dataset",
        "spatial-summary": "spatial-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "clustering-tester",
      "inputs": {
        "projected-dataset": "step_1.projected-dataset",
        "spatial-summary": "step_1.spatial-summary"
      },
      "outputs": {
        "clustering-result": "clustering-result",
        "scale-dependence": "scale-dependence"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "autocorrelation-estimator",
      "inputs": {
        "projected-dataset": "step_1.projected-dataset",
        "lag-parameters": "from_context.lag-parameters"
      },
      "outputs": {
        "empirical-variogram": "empirical-variogram",
        "fitted-variogram": "fitted-variogram"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "kriging-interpolator",
      "inputs": {
        "projected-dataset": "step_1.projected-dataset",
        "fitted-variogram": "step_3.fitted-variogram"
      },
      "outputs": {
        "prediction-surface": "prediction-surface",
        "kriging-variance": "kriging-variance"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "spatial-validation-runner",
      "inputs": {
        "projected-dataset": "step_1.projected-dataset",
        "fitted-variogram": "step_3.fitted-variogram"
      },
      "outputs": {
        "cv-metrics": "cv-metrics",
        "cv-diagnostics": "cv-diagnostics"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "spatial-report-producer",
      "inputs": {
        "prediction-surface": "step_4.prediction-surface",
        "kriging-variance": "step_4.kriging-variance",
        "cv-metrics": "step_5.cv-metrics"
      },
      "outputs": {
        "spatial-report": "spatial-report",
        "data-collection-guidance": "data-collection-guidance"
      },
      "parallel_group": 6
    }
