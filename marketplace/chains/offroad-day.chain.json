{
  "name": "offroad-day",
  "description": "Off-road day trip: pre-drive check with offroad profile, vehicle health baseline before trail, drive analysis after for suspension/underbody stress review, CAN detective for any new anomalies, maintenance schedule update for accelerated intervals.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "pre-drive-check",
      "inputs": {
        "vehicle": "from_user_input",
        "trip_type": "from_user_input",
        "weather": "from_user_input"
      },
      "outputs": {
        "readiness_status": "readiness_status",
        "safety_checks": "safety_checks",
        "fluid_levels": "fluid_levels",
        "tire_status": "tire_status",
        "go_no_go": "go_no_go"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "vehicle-health",
      "inputs": {
        "vehicle": "from_context.vehicle",
        "scan_scope": "from_context.scan_scope",
        "history": "from_context.history"
      },
      "outputs": {
        "module_status": "module_status",
        "dtc_report": "dtc_report",
        "signal_health": "signal_health",
        "trend_analysis": "trend_analysis",
        "action_plan": "action_plan"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "drive-analysis",
      "inputs": {
        "trip_log": "from_context.trip_log",
        "vehicle": "from_context.vehicle",
        "driver_profile": "from_context.driver_profile"
      },
      "outputs": {
        "speed_profile": "speed_profile",
        "braking_events": "braking_events",
        "fuel_estimate": "fuel_estimate",
        "fault_log": "fault_log",
        "drive_score": "drive_score"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "can-detective",
      "inputs": {
        "baseline": "from_context.baseline",
        "vehicle": "from_context.vehicle",
        "symptom": "from_context.symptom",
        "bus": "from_context.bus"
      },
      "outputs": {
        "traffic_diff": "traffic_diff",
        "anomaly_list": "anomaly_list",
        "signal_forensics": "signal_forensics",
        "suspect_modules": "suspect_modules"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "vehicle-health",
      "inputs": {
        "vehicle": "from_context.vehicle",
        "scan_scope": "from_context.scan_scope",
