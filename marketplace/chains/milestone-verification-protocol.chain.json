{
  "name": "milestone-verification-protocol",
  "description": "Design milestones that verify outcomes, not activities. 'Code is written' is an activity milestone. 'Ten users completed the workflow without error' is an outcome milestone. Activity milestones give false confidence because they measure effort, not results.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "outcome-milestone-designer",
      "inputs": {
        "initiative-description": "from_user_input",
        "current-milestones": "from_user_input"
      },
      "outputs": {
        "outcome-milestones": "outcome-milestones",
        "verification-methods": "verification-methods"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "milestone-gate-builder",
      "inputs": {
        "outcome-milestones": "step_1.outcome-milestones",
        "initiative-description": "from_context.initiative-description"
      },
      "outputs": {
        "milestone-gates": "milestone-gates",
        "gate-schedule": "gate-schedule"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "milestone-tracking-dashboard",
      "inputs": {
        "milestone-gates": "step_2.milestone-gates",
        "gate-schedule": "step_2.gate-schedule"
      },
      "outputs": {
        "milestone-dashboard": "milestone-dashboard",
        "milestone-trends": "milestone-trends"
      },
      "parallel_group": 3
    }
  ],
