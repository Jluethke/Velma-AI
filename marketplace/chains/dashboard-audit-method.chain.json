{
  "name": "dashboard-audit-method",
  "description": "Audit an existing dashboard for usefulness. Most dashboards are graveyards of metrics nobody acts on. For each metric: when was the last time someone took action because of it? If never, remove it. A good dashboard has 5-7 metrics that drive decisions, not 40 that decorate a screen.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "dashboard-census",
      "inputs": {
        "dashboard-list": "from_user_input",
        "audience-description": "from_user_input"
      },
      "outputs": {
        "metric-census": "metric-census",
        "total-metric-count": "total-metric-count"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "last-action-test",
      "inputs": {
        "metric-census": "step_1.metric-census",
        "audience-description": "from_context.audience-description"
      },
      "outputs": {
        "action-linked-metrics": "action-linked-metrics",
        "no-action-metrics": "no-action-metrics"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "frequency-match-check",
      "inputs": {
        "action-linked-metrics": "step_2.action-linked-metrics"
      },
      "outputs": {
        "frequency-matched": "frequency-matched",
        "frequency-mismatched": "frequency-mismatched"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "visualization-fitness-review",
      "inputs": {
        "frequency-matched": "step_3.frequency-matched"
      },
      "outputs": {
        "visualization-assessment": "visualization-assessment",
        "layout-recommendations": "layout-recommendations"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "dashboard-rebuild-plan",
      "inputs": {
        "visualization-assessment": "step_4.visualization-assessment",
        "no-action-metrics": "step_2.no-action-metrics",
        "layout-recommendations": "step_4.layout-recommendations"
      },
      "outputs": {
        "dashboard-rebuild-spec": "dashboard-rebuild-spec",
        "removed-metrics-archive": "removed-metrics-archive"
      },
      "parallel_group": 5
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "object",
      "field_mapping": {}
    },
