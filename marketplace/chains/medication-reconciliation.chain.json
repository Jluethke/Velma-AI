{
  "name": "medication-reconciliation",
  "description": "Reconcile medications at a care transition to prevent errors.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "medication-source-collector",
      "inputs": {
        "patient-id": "from_user_input",
        "care-transition-type": "from_user_input"
      },
      "outputs": {
        "source-med-lists": "source-med-lists",
        "source-discrepancies": "source-discrepancies"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "medication-order-comparator",
      "inputs": {
        "source-med-lists": "step_1.source-med-lists",
        "current-orders": "from_context.current-orders"
      },
      "outputs": {
        "discrepancy-list": "discrepancy-list",
        "matched-medications": "matched-medications"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "drug-interaction-checker",
      "inputs": {
        "source-med-lists": "step_1.source-med-lists",
        "allergy-list": "from_context.allergy-list"
      },
      "outputs": {
        "interaction-alerts": "interaction-alerts",
        "allergy-conflicts": "allergy-conflicts"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "prescriber-discrepancy-resolver",
      "inputs": {
        "discrepancy-list": "step_2.discrepancy-list",
        "interaction-alerts": "step_3.interaction-alerts"
      },
      "outputs": {
        "resolved-actions": "resolved-actions",
        "clinical-rationale": "clinical-rationale"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "reconciled-list-updater",
      "inputs": {
        "resolved-actions": "step_4.resolved-actions",
        "matched-medications": "step_2.matched-medications"
      },
      "outputs": {
        "reconciled-med-list": "reconciled-med-list",
        "change-summary": "change-summary"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "patient-medication-communicator",
      "inputs": {
        "reconciled-med-list": "step_5.reconciled-med-list",
        "change-summary": "step_5.change-summary"
      },
      "outputs": {
        "patient-med-card": "patient-med-card",
        "communication-record": "communication-record"
      },
      "parallel_group": 6
    }
  ],
  "edges": [
