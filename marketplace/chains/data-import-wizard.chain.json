{
  "name": "data-import-wizard",
  "description": "Import data from external files into a system: validate the file, map columns, preview, run the import with error handling, and verify the result.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "import-file-validator",
      "inputs": {
        "import-file": "from_user_input",
        "target-system-schema": "from_user_input"
      },
      "outputs": {
        "file-profile": "file-profile",
        "structural-issues": "structural-issues"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "import-column-mapper",
      "inputs": {
        "file-profile": "step_1.file-profile",
        "target-system-schema": "from_context.target-system-schema"
      },
      "outputs": {
        "import-mapping": "import-mapping",
        "unmapped-columns": "unmapped-columns"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "import-preview-runner",
      "inputs": {
        "import-mapping": "step_2.import-mapping",
        "import-file": "from_context.import-file"
      },
      "outputs": {
        "preview-results": "preview-results",
        "preview-errors": "preview-errors"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "import-executor",
      "inputs": {
        "import-mapping": "step_2.import-mapping",
        "preview-results": "step_3.preview-results"
      },
      "outputs": {
        "import-summary": "import-summary",
        "error-log": "error-log"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "import-verification-checker",
      "inputs": {
        "import-summary": "step_4.import-summary",
        "error-log": "step_4.error-log"
      },
      "outputs": {
        "verification-report": "verification-report",
        "import-record": "import-record"
      },
      "parallel_group": 5
    }
  ],
