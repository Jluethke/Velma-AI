{
  "name": "security-tool-evaluation",
  "description": "Evaluate a security tool for deployment from criteria definition through testing against known targets to comparative analysis.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "eval-criteria-definition",
      "inputs": {
        "tool-candidates": "from_user_input",
        "use-case-requirements": "from_user_input"
      },
      "outputs": {
        "eval-criteria": "eval-criteria",
        "test-plan": "test-plan"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "test-environment-deployment",
      "inputs": {
        "tool-candidates": "from_context.tool-candidates",
        "eval-criteria": "step_1.eval-criteria"
      },
      "outputs": {
        "deployed-tools": "deployed-tools",
        "deployment-notes": "deployment-notes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "known-target-testing",
      "inputs": {
        "deployed-tools": "step_2.deployed-tools",
        "test-plan": "step_1.test-plan"
      },
      "outputs": {
        "detection-results": "detection-results",
        "false-positive-log": "false-positive-log"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "detection-rate-measurement",
      "inputs": {
        "phishing-metrics": "from_context.phishing-metrics",
        "phone-test-results": "from_context.phone-test-results",
        "physical-test-results": "from_context.physical-test-results"
      },
      "outputs": {
        "detection-rates": "detection-rates",
        "response-time-metrics": "response-time-metrics"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "integration-assessment",
      "inputs": {
        "deployed-tools": "step_2.deployed-tools",
        "deployment-notes": "step_2.deployment-notes"
      },
      "outputs": {
        "integration-scores": "integration-scores",
        "compatibility-notes": "compatibility-notes"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "tool-comparison",
      "inputs": {
        "accuracy-metrics": "from_context.accuracy-metrics",
        "integration-scores": "step_5.integration-scores",
        "eval-criteria": "step_1.eval-criteria"
      },
      "outputs": {
        "comparison-matrix": "comparison-matrix",
        "weighted-scores": "weighted-scores"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "tool-eval-report",
      "inputs": {
        "comparison-matrix": "step_6.comparison-matrix",
        "weighted-scores": "step_6.weighted-scores",
        "compatibility-notes": "step_5.compatibility-notes"
      },
      "outputs": {
        "evaluation-report": "evaluation-report",
        "recommendation": "recommendation"
      },
      "parallel_group": 7
    }
  ],
