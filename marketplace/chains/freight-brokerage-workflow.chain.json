      "skill_name": "carrier-matcher",
      "inputs": {
        "validated-load": "step_1.validated-load",
        "rate-estimate": "step_1.rate-estimate"
      },
      "outputs": {
        "carrier-options": "carrier-options",
        "carrier-scores": "carrier-scores"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "rate-negotiator-booker",
      "inputs": {
        "carrier-options": "step_2.carrier-options",
        "carrier-scores": "step_2.carrier-scores"
      },
      "outputs": {
        "booking-confirmation": "booking-confirmation",
