{
  "name": "devsecops-maturity-assessment",
  "description": "Assess DevSecOps maturity across the SDLC: static analysis coverage, dynamic testing integration, security training, vulnerability management SLAs, and security champion program effectiveness.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "sdlc-security-integration-review",
      "inputs": {
        "sdlc-documentation": "from_user_input",
        "team-structure": "from_user_input"
      },
      "outputs": {
        "integration-gaps": "integration-gaps",
        "sdlc-security-map": "sdlc-security-map"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "sast-coverage-evaluator",
      "inputs": {
        "sdlc-security-map": "step_1.sdlc-security-map",
        "sast-tool-config": "from_context.sast-tool-config"
      },
      "outputs": {
        "sast-findings": "sast-findings",
        "false-positive-rate": "false-positive-rate"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "dast-integration-evaluator",
      "inputs": {
        "sdlc-security-map": "step_1.sdlc-security-map",
        "sast-findings": "step_2.sast-findings"
      },
      "outputs": {
        "dast-findings": "dast-findings",
        "dast-coverage-map": "dast-coverage-map"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "security-training-awareness-review",
      "inputs": {
        "team-structure": "from_context.team-structure",
        "integration-gaps": "step_1.integration-gaps"
      },
      "outputs": {
        "training-findings": "training-findings",
        "training-metrics": "training-metrics"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "vulnerability-management-sla-check",
      "inputs": {
        "dast-findings": "step_3.dast-findings",
        "sast-findings": "step_2.sast-findings"
      },
      "outputs": {
        "sla-compliance-report": "sla-compliance-report",
        "overdue-vulnerability-list": "overdue-vulnerability-list"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "security-champion-program-audit",
      "inputs": {
        "team-structure": "from_context.team-structure",
        "training-findings": "step_4.training-findings"
      },
      "outputs": {
        "champion-program-findings": "champion-program-findings",
        "champion-coverage-map": "champion-coverage-map"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "devsecops-maturity-report-compiler",
      "inputs": {
        "sla-compliance-report": "step_5.sla-compliance-report",
        "champion-program-findings": "step_6.champion-program-findings",
        "training-metrics": "step_4.training-metrics",
        "integration-gaps": "step_1.integration-gaps"
      },
      "outputs": {
        "devsecops-maturity-report": "devsecops-maturity-report",
        "improvement-roadmap": "improvement-roadmap"
      },
      "parallel_group": 7
    }
  ],
