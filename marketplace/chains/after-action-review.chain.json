{
  "name": "after-action-review",
  "description": "Run a structured after-action review (US Army AAR method): what was supposed to happen, what actually happened, why the difference, and what will be done differently. More rigorous than 'lessons learned' because it forces comparison against a stated plan.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "plan-vs-actual-comparison",
      "inputs": {
        "event-description": "from_user_input",
        "original-plan": "from_user_input"
      },
      "outputs": {
        "plan-column": "plan-column",
        "actual-column": "actual-column",
        "delta-list": "delta-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "root-cause-analysis-per-delta",
      "inputs": {
        "delta-list": "step_1.delta-list",
        "event-description": "from_context.event-description"
      },
      "outputs": {
        "root-causes": "root-causes",
        "controllable-causes": "controllable-causes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "lesson-extraction",
      "inputs": {
        "root-causes": "step_2.root-causes",
        "controllable-causes": "step_2.controllable-causes"
      },
      "outputs": {
        "lessons": "lessons",
        "lesson-owners": "lesson-owners"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "integration-into-process",
      "inputs": {
        "lessons": "step_3.lessons",
        "lesson-owners": "step_3.lesson-owners"
      },
      "outputs": {
        "process-changes": "process-changes",
        "verification-plan": "verification-plan"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "object",
      "field_mapping": {}
    },
    {
      "from_step": "step_2",
