{
  "name": "batch-vs-flow-optimizer",
  "description": "Determine whether a process should run in batches or as continuous flow. Calculate the optimal batch size using setup cost, holding cost, and demand rate. Most operations are over-batched because setup costs have dropped but batch sizes have not been recalculated.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "setup-and-holding-cost-measurer",
      "inputs": {
        "process-name": "from_user_input",
        "current-batch-size": "from_user_input"
      },
      "outputs": {
        "setup-cost": "setup-cost",
        "holding-cost-per-item": "holding-cost-per-item"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "optimal-batch-size-calculator",
      "inputs": {
        "setup-cost": "step_1.setup-cost",
        "holding-cost-per-item": "step_1.holding-cost-per-item",
        "current-batch-size": "from_context.current-batch-size"
      },
      "outputs": {
        "optimal-batch-size": "optimal-batch-size",
        "cost-comparison": "cost-comparison"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "flow-conversion-feasibility",
      "inputs": {
        "optimal-batch-size": "step_2.optimal-batch-size",
        "setup-cost": "step_1.setup-cost"
      },
      "outputs": {
        "flow-feasibility": "flow-feasibility",
        "setup-reduction-plan": "setup-reduction-plan"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "batch-flow-implementation-plan",
      "inputs": {
        "optimal-batch-size": "step_2.optimal-batch-size",
        "flow-feasibility": "step_3.flow-feasibility",
        "setup-reduction-plan": "step_3.setup-reduction-plan"
      },
      "outputs": {
        "implementation-plan": "implementation-plan",
        "measurement-plan": "measurement-plan"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "object",
      "field_mapping": {}
    },
    {
      "from_step": "step_2",
