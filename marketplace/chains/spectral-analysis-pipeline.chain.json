{
  "name": "spectral-analysis-pipeline",
  "description": "Decompose a signal into its frequency components: window and transform the data, identify spectral peaks, estimate power spectral density, filter target bands, and validate against the time-domain signal.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "signal-preprocessor",
      "inputs": {
        "raw-signal": "from_user_input",
        "sampling-metadata": "from_user_input"
      },
      "outputs": {
        "windowed-signal": "windowed-signal",
        "preprocessing-log": "preprocessing-log"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "fourier-transformer",
      "inputs": {
        "windowed-signal": "step_1.windowed-signal",
        "transform-parameters": "from_context.transform-parameters"
      },
      "outputs": {
        "amplitude-spectrum": "amplitude-spectrum",
        "phase-spectrum": "phase-spectrum"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "spectral-peak-finder",
      "inputs": {
        "amplitude-spectrum": "step_2.amplitude-spectrum",
        "noise-floor-estimate": "from_context.noise-floor-estimate"
      },
      "outputs": {
        "peak-table": "peak-table",
        "noise-floor": "noise-floor"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "power-density-estimator",
      "inputs": {
        "windowed-signal": "step_1.windowed-signal",
        "estimation-parameters": "from_context.estimation-parameters"
      },
      "outputs": {
        "psd-estimate": "psd-estimate",
        "spectral-resolution": "spectral-resolution"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "band-filter-extractor",
      "inputs": {
        "windowed-signal": "step_1.windowed-signal",
        "target-band": "from_context.target-band"
      },
      "outputs": {
        "filtered-signal": "filtered-signal",
        "filter-specification": "filter-specification"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "spectral-report-assembler",
      "inputs": {
        "peak-table": "step_3.peak-table",
        "psd-estimate": "step_4.psd-estimate",
        "filtered-signal": "step_5.filtered-signal"
      },
      "outputs": {
        "spectral-report": "spectral-report",
        "frequency-summary": "frequency-summary"
      },
      "parallel_group": 6
    }
  ],
