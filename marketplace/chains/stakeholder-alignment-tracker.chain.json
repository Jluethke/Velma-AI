{
  "name": "stakeholder-alignment-tracker",
  "description": "Track alignment across stakeholders on scope, timeline, priorities, and success criteria. Misalignment is invisible until delivery, when it becomes expensive. The tracker surfaces disagreements early by explicitly recording each stakeholder's expectations and comparing them.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "expectation-collector",
      "inputs": {
        "initiative-description": "from_user_input",
        "key-stakeholders": "from_user_input"
      },
      "outputs": {
        "expectation-records": "expectation-records",
        "alignment-matrix": "alignment-matrix"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "divergence-resolver",
      "inputs": {
        "alignment-matrix": "step_1.alignment-matrix",
        "key-stakeholders": "from_context.key-stakeholders"
      },
      "outputs": {
        "resolved-expectations": "resolved-expectations",
        "unresolved-divergences": "unresolved-divergences"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "alignment-maintenance-check",
      "inputs": {
        "resolved-expectations": "step_2.resolved-expectations",
        "initiative-description": "from_context.initiative-description"
      },
      "outputs": {
        "alignment-check-protocol": "alignment-check-protocol",
        "alignment-drift-log": "alignment-drift-log"
      },
      "parallel_group": 3
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "object",
      "field_mapping": {}
    },
    {
      "from_step": "step_2",
      "to_step": "step_3",
      "data_type": "object",
      "field_mapping": {}
    }
  ],
  "entry_inputs": [
    "initiative-description",
    "key-stakeholders"
  ],
  "terminal_outputs": [
    "alignment-check-protocol",
    "alignment-drift-log"
  ],
  "parallel_groups": [
    [
      "step_1"
    ],
    [
      "step_2"
    ],
    [
      "step_3"
    ]
  ],
  "estimated_cost": "low",
  "critical_path": [
    "step_1",
    "step_2",
    "step_3"
  ],
