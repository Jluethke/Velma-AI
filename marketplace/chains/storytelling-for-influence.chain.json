{
  "name": "storytelling-for-influence",
  "description": "Turn a message into a story so it is remembered and acted on. Use the four-part structure of protagonist, problem, struggle, and resolution. Facts delivered inside a story are far more memorable than facts delivered alone, a result Jerome Bruner put at roughly twenty times. Story is not decoration on the message, it is how people process and retain it.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "sfi-core-message-extractor",
      "inputs": {
        "influence-goal": "from_user_input",
        "audience": "from_user_input"
      },
      "outputs": {
        "core-message": "core-message",
        "change-sought": "change-sought"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "sfi-protagonist-selector",
      "inputs": {
        "core-message": "step_1.core-message",
        "change-sought": "step_1.change-sought"
      },
      "outputs": {
        "protagonist": "protagonist",
        "audience-identification-note": "audience-identification-note"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "sfi-problem-stakes-definer",
      "inputs": {
        "protagonist": "step_2.protagonist",
        "core-message": "step_1.core-message"
      },
      "outputs": {
        "problem-statement": "problem-statement",
        "stakes": "stakes"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "sfi-struggle-builder",
      "inputs": {
        "problem-statement": "step_3.problem-statement",
        "protagonist": "step_2.protagonist"
      },
      "outputs": {
        "struggle-arc": "struggle-arc",
        "turning-point": "turning-point"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "sfi-resolution-to-message-mapper",
      "inputs": {
        "struggle-arc": "step_4.struggle-arc",
        "turning-point": "step_4.turning-point",
        "core-message": "step_1.core-message"
      },
      "outputs": {
        "resolution": "resolution",
        "message-landing": "message-landing"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "sfi-delivery-packager",
      "inputs": {
        "protagonist": "step_2.protagonist",
        "problem-statement": "step_3.problem-statement",
        "struggle-arc": "step_4.struggle-arc",
        "resolution": "step_5.resolution"
      },
      "outputs": {
        "story-script": "story-script",
        "memorability-check": "memorability-check"
      },
      "parallel_group": 6
    }
  ],
