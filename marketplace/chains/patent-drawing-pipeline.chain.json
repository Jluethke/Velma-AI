{
  "name": "patent-drawing-pipeline",
  "description": "Full patent drawing pipeline: extract figures from spec, generate claim-aligned Mermaid diagrams, render to PNG/SVG, align reference numerals across claims/spec/drawings, generate Detailed Description of Drawings section, and produce filing checklist. Feed it a patent family and get back everything needed for filing.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "data-extractor",
      "inputs": {
        "raw_text": "from_user_input",
        "target_fields": "from_user_input",
        "source_hint": "from_user_input",
        "examples": "from_user_input"
      },
      "outputs": {
        "extracted_data": "extracted_data_data",
        "confidence_scores": "confidence_scores_data",
        "extraction_notes": "extraction_notes_data",
        "raw_matches": "raw_matches_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "patent-drawing-generator",
      "inputs": {
        "figure_description": "step_1.extracted_data",
        "figure_number": "step_1.extracted_data",
        "patent_family": "step_1.extracted_data",
        "drawing_type": "step_1.extracted_data"
      },
      "outputs": {
        "mermaid_code": "mermaid_code_data",
        "drawing_specification": "drawing_specification_data",
        "compliance_notes": "compliance_notes_data",
        "reference_numerals": "reference_numerals_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "patent-spec-aligner",
      "inputs": {
        "claims_text": "step_2.mermaid_code",
        "specification_text": "step_2.mermaid_code",
        "drawings_json": "step_2.mermaid_code",
        "patent_family": "step_2.mermaid_code"
      },
      "outputs": {
        "detailed_description_section": "detailed_description_section_data",
        "alignment_report": "alignment_report_data",
        "updated_figure_descriptions": "updated_figure_descriptions_data",
        "consistency_violations": "consistency_violations_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "checklist-builder",
      "inputs": {
        "goal_or_event": "step_3.detailed_description_section",
        "deadline": "step_3.detailed_description_section",
        "constraints": "step_3.detailed_description_section",
        "experience_level": "step_3.detailed_description_section"
      },
      "outputs": {
        "checklist": "checklist_data",
        "timeline": "timeline_data",
        "dont_forget": "dont_forget_data",
        "dependencies": "dependencies_data"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "extracted_data",
      "field_mapping": "extracted_data -> figure_description; extracted_data -> figure_number; extracted_data -> patent_family; extracted_data -> drawing_type"
    },
    {
      "from_step": "step_2",
      "to_step": "step_3",
      "data_type": "mermaid_code",
      "field_mapping": "mermaid_code -> claims_text; mermaid_code -> specification_text; mermaid_code -> drawings_json; mermaid_code -> patent_family"
    },
    {
      "from_step": "step_3",
      "to_step": "step_4",
      "data_type": "detailed_description_section",
      "field_mapping": "detailed_description_section -> goal_or_event; detailed_description_section -> deadline; detailed_description_section -> constraints; detailed_description_section -> experience_level"
    }
  ],
  "entry_inputs": [
    "examples",
    "raw_text",
    "source_hint",
    "target_fields"
  ],
  "terminal_outputs": [
    "checklist",
    "timeline",
    "dont_forget",
    "dependencies"
  ],
  "parallel_groups": [
    [
      "step_1"
    ],
    [
      "step_2"
    ],
    [
      "step_3"
    ],
    [
      "step_4"
    ]
  ],
  "estimated_cost": 0,
  "critical_path": [
    "step_1",
    "step_2",
    "step_3",
    "step_4"
  ],
  "chain_links": {
    "next_chains": [],
    "related_chains": [
      {
        "chain_name": "patent-filing-pipeline",
        "relationship": "complement"
      },
      {
        "chain_name": "trademark-clearance-pipeline",
        "relationship": "complement"
      }
    ],
    "prerequisites": []
  }
}
