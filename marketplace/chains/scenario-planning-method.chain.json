{
  "name": "scenario-planning-method",
  "description": "Build scenario plans for strategic uncertainty using the 2x2 matrix method. Identify the two most impactful uncertainties, create four scenarios, name them, write the narratives, identify early warning signals, and define strategic responses. You do not predict which scenario happens. You prepare for all four.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "uncertainty-identifier",
      "inputs": {
        "strategic-context": "from_user_input",
        "time-horizon": "from_user_input"
      },
      "outputs": {
        "uncertainty-long-list": "uncertainty-long-list",
        "top-two-uncertainties": "top-two-uncertainties"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "scenario-matrix-builder",
      "inputs": {
        "top-two-uncertainties": "step_1.top-two-uncertainties",
        "strategic-context": "from_context.strategic-context"
      },
      "outputs": {
        "scenario-matrix": "scenario-matrix",
        "scenario-narratives": "scenario-narratives"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "early-warning-signal-mapper",
      "inputs": {
        "scenario-matrix": "step_2.scenario-matrix",
        "scenario-narratives": "step_2.scenario-narratives"
      },
      "outputs": {
        "signal-map": "signal-map",
        "signal-monitoring-plan": "signal-monitoring-plan"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "strategic-response-designer",
      "inputs": {
        "scenario-matrix": "step_2.scenario-matrix",
        "strategic-context": "from_context.strategic-context"
      },
      "outputs": {
        "scenario-responses": "scenario-responses",
        "common-actions": "common-actions"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "scenario-plan-document",
      "inputs": {
        "scenario-responses": "step_4.scenario-responses",
        "signal-monitoring-plan": "step_3.signal-monitoring-plan"
      },
      "outputs": {
        "scenario-plan-document": "scenario-plan-document",
        "immediate-action-list": "immediate-action-list"
      },
      "parallel_group": 5
    }
  ],
