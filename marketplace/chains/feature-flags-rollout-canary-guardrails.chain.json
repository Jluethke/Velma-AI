{
  "name": "feature-flags-rollout-canary-guardrails",
  "description": "Guard a progressive rollout on Kubernetes: instrument flag variants, define SLO burn-rate guardrails, plan stages, run an Argo Rollouts or Flagger canary, judge it statistically, and wire automatic flag rollback.",
  "steps": [
