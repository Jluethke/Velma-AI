{
  "name": "signal-noise-separator",
  "description": "Determine the minimum sample size and time window needed to distinguish real signal from random noise in any dataset. Most people make decisions on insufficient data because they do not know how many observations they need. This chain calculates that number.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "effect-size-definer",
      "inputs": {
        "metric-name": "from_user_input",
        "current-value": "from_user_input"
      },
      "outputs": {
        "minimum-detectable-effect": "minimum-detectable-effect",
        "effect-rationale": "effect-rationale"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "variance-estimator",
      "inputs": {
        "metric-name": "from_context.metric-name",
        "current-value": "from_context.current-value"
      },
      "outputs": {
        "estimated-variance": "estimated-variance",
        "variance-source": "variance-source"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "confidence-level-selector",
      "inputs": {
        "minimum-detectable-effect": "step_1.minimum-detectable-effect",
        "effect-rationale": "step_1.effect-rationale"
      },
      "outputs": {
        "alpha-level": "alpha-level",
        "beta-level": "beta-level"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "sample-size-calculator",
      "inputs": {
        "target-effect-size": "from_context.target-effect-size",
        "selected-test": "from_context.selected-test"
      },
      "outputs": {
        "minimum-sample-size": "minimum-sample-size",
        "power-curve": "power-curve"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "data-collection-commitment",
      "inputs": {
        "required-sample-size": "from_context.required-sample-size",
        "required-duration": "from_context.required-duration"
      },
      "outputs": {
        "measurement-commitment": "measurement-commitment",
        "interim-check-rules": "interim-check-rules"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "conclusion-evaluator",
      "inputs": {
        "measurement-commitment": "step_5.measurement-commitment",
        "metric-name": "from_context.metric-name"
      },
      "outputs": {
        "conclusion": "conclusion",
        "measurement-report": "measurement-report"
      },
      "parallel_group": 6
    }
  ],
