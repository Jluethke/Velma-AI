{
  "name": "clinical-biomarker-validation",
  "description": "Validate a candidate biomarker from cohort assembly through ROC analysis, cutoff determination, and independent validation.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "biomarker-clinical-question-definer",
      "inputs": {
        "candidate-biomarker": "from_user_input",
        "clinical-context": "from_user_input"
      },
      "outputs": {
        "clinical-question": "clinical-question",
        "performance-targets": "performance-targets"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "biomarker-cohort-assembler",
      "inputs": {
        "clinical-question": "step_1.clinical-question",
        "sample-source": "from_context.sample-source"
      },
      "outputs": {
        "study-cohort": "study-cohort",
        "cohort-characteristics": "cohort-characteristics"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "roc-curve-constructor",
      "inputs": {
        "study-cohort": "step_2.study-cohort",
        "performance-targets": "step_1.performance-targets"
      },
      "outputs": {
        "roc-curve-data": "roc-curve-data",
        "auc-comparison": "auc-comparison"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "optimal-cutoff-determiner",
      "inputs": {
        "roc-curve-data": "step_3.roc-curve-data",
        "performance-targets": "step_1.performance-targets"
      },
      "outputs": {
        "optimal-cutoff": "optimal-cutoff",
        "classification-table": "classification-table"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "validation-cohort-tester",
      "inputs": {
        "optimal-cutoff": "step_4.optimal-cutoff",
        "validation-cohort-data": "from_context.validation-cohort-data"
      },
      "outputs": {
        "validation-performance": "validation-performance",
        "calibration-assessment": "calibration-assessment"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "biomarker-validation-report-writer",
      "inputs": {
        "validation-performance": "step_5.validation-performance",
        "roc-curve-data": "step_3.roc-curve-data",
        "cohort-characteristics": "step_2.cohort-characteristics"
      },
      "outputs": {
        "biomarker-report": "biomarker-report",
        "clinical-recommendation": "clinical-recommendation"
      },
      "parallel_group": 6
    }
  ],
