{
  "name": "salary-review",
  "description": "Prepare for a raise conversation. Research market rates, build your comparison matrix, plan the negotiation, and draft the ask. Walk in with data, not feelings.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "research-synthesizer",
      "inputs": {
        "research_question": "from_context.research_question",
        "source_types": "from_context.source_types",
        "depth_level": "from_context.depth_level",
        "existing_knowledge": "from_context.existing_knowledge",
        "constraints": "from_context.constraints"
      },
      "outputs": {
        "executive_summary": "object",
        "detailed_findings": "object",
        "source_credibility_scores": "object",
        "confidence_levels": "object",
        "knowledge_gaps": "object",
        "contradiction_report": "object"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "comparison-matrix",
      "inputs": {
        "options": "step_1.executive_summary",
        "criteria": "step_1.executive_summary",
        "context": "step_1.executive_summary",
        "dealbreakers": "step_1.executive_summary"
      },
      "outputs": {
        "comparison_matrix": "comparison_matrix_data",
        "ranking": "ranking_data",
        "tradeoff_summary": "tradeoff_summary_data",
        "recommendation": "recommendation_data",
        "sensitivity_flags": "sensitivity_flags_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "salary-negotiator",
      "inputs": {
        "offer": "step_1.executive_summary",
        "role_details": "step_1.executive_summary",
        "your_profile": "step_1.executive_summary",
        "competing_offers": "step_1.executive_summary",
        "constraints": "step_1.executive_summary",
        "comfort_level": "step_1.executive_summary"
      },
      "outputs": {
        "market_analysis": "market_analysis_data",
        "negotiation_strategy": "negotiation_strategy_data",
        "scripts": "scripts_data",
        "tactics_guide": "tactics_guide_data",
        "decision_framework": "decision_framework_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "email-writer",
      "inputs": {
        "situation": "step_3.market_analysis",
        "recipient": "step_3.market_analysis",
        "goal": "step_3.market_analysis",
        "tone": "step_3.market_analysis",
        "constraints": "step_3.market_analysis"
      },
      "outputs": {
        "email_draft": "email_draft_data",
        "tone_check": "tone_check_data",
        "alternatives": "alternatives_data",
        "follow_up_suggestion": "follow_up_suggestion_data"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "result",
      "field_mapping": "result -> options; result -> criteria; result -> context; result -> dealbreakers"
    },
    {
      "from_step": "step_1",
      "to_step": "step_3",
      "data_type": "result",
      "field_mapping": "result -> offer; result -> role_details; result -> your_profile; result -> competing_offers; result -> constraints; result -> comfort_level"
    },
    {
      "from_step": "step_2",
      "to_step": "step_3",
      "data_type": "comparison_matrix",
      "field_mapping": "comparison_matrix -> input"
    },
    {
      "from_step": "step_3",
      "to_step": "step_4",
      "data_type": "market_analysis",
      "field_mapping": "market_analysis -> situation; market_analysis -> recipient; market_analysis -> goal; market_analysis -> tone; market_analysis -> constraints"
    }
  ],
  "entry_inputs": [
    "input"
  ],
  "terminal_outputs": [
    "email_draft",
    "tone_check",
    "alternatives",
    "follow_up_suggestion"
  ],
  "parallel_groups": [
    [
      "step_1"
    ],
    [
      "step_2"
    ],
    [
      "step_3"
    ],
    [
      "step_4"
    ]
  ],
  "estimated_cost": 0,
