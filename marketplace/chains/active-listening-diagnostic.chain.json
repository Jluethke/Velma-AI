        "failure-frequency": "failure-frequency"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "ald-external-feedback-collector",
      "inputs": {
        "failure-definitions": "step_1.failure-definitions",
        "self-suspected-failures": "step_1.self-suspected-failures"
      },
      "outputs": {
