      },
      "outputs": {
        "vendor-concentration-table": "vendor-concentration-table",
        "high-concentration-functions": "high-concentration-functions"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "switching-cost-estimator",
      "inputs": {
        "high-concentration-functions": "step_1.high-concentration-functions",
