      },
      "outputs": {
        "switching-analysis": "switching-analysis",
        "concentration-risk-scores": "concentration-risk-scores"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "vendor-diversification-plan",
      "inputs": {
        "concentration-risk-scores": "step_2.concentration-risk-scores",
        "switching-analysis": "step_2.switching-analysis"
      },
      "outputs": {
