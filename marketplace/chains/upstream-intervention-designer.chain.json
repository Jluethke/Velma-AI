{
  "name": "upstream-intervention-designer",
  "description": "Trace recurring problems to where a small change prevents them entirely, instead of fixing them where they surface. Map the causal chain backward from symptom to root. Intervene as far upstream as possible. One upstream fix prevents multiple downstream symptoms.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "recurring-problem-profiler",
      "inputs": {
        "problem-description": "from_user_input",
        "occurrence-data": "from_user_input"
      },
      "outputs": {
        "problem-profile": "problem-profile",
        "surface-point": "surface-point"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "causal-chain-mapper",
      "inputs": {
        "problem-profile": "step_1.problem-profile",
        "surface-point": "step_1.surface-point"
      },
      "outputs": {
        "causal-chain": "causal-chain",
        "intervention-candidates": "intervention-candidates"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "intervention-point-ranker",
      "inputs": {
        "causal-chain": "step_2.causal-chain",
        "intervention-candidates": "step_2.intervention-candidates"
      },
      "outputs": {
        "ranked-interventions": "ranked-interventions",
        "selected-intervention": "selected-intervention"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "upstream-fix-designer",
      "inputs": {
        "selected-intervention": "step_3.selected-intervention",
        "causal-chain": "step_2.causal-chain"
      },
      "outputs": {
        "intervention-design": "intervention-design",
        "verification-method": "verification-method"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "downstream-retirement-planner",
      "inputs": {
        "intervention-design": "step_4.intervention-design",
        "surface-point": "step_1.surface-point"
      },
      "outputs": {
        "retired-workarounds": "retired-workarounds",
        "freed-capacity": "freed-capacity"
      },
      "parallel_group": 5
    }
  ],
