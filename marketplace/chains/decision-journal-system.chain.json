        "outcome-check-date": "outcome-check-date"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "outcome-comparison-reviewer",
      "inputs": {
        "journal-entry": "step_2.journal-entry",
        "outcome-check-date": "step_2.outcome-check-date"
      },
      "outputs": {
