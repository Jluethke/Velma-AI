        "journal-scope": "from_user_input",
        "review-cadence": "from_user_input"
      },
      "outputs": {
        "journal-template": "journal-template",
        "threshold-criteria": "threshold-criteria"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "decision-entry-recorder",
