{
  "name": "pareto-analysis-engine",
  "description": "Find the 20% of inputs producing 80% of outputs in any domain. Products, customers, activities, expenses, features, habits. Sort by output, draw the cumulative curve, and find where diminishing returns begin. Everything above the knee gets more resources. Everything below gets automated, delegated, or eliminated.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "input-output-mapper",
      "inputs": {
        "domain-description": "from_user_input",
        "output-metric": "from_user_input"
      },
      "outputs": {
        "input-list": "input-list",
        "output-per-input": "output-per-input"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "pareto-sort-and-curve",
      "inputs": {
        "input-list": "step_1.input-list",
        "output-per-input": "step_1.output-per-input"
      },
      "outputs": {
        "sorted-inputs": "sorted-inputs",
        "concentration-ratio": "concentration-ratio"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "vital-few-identifier",
      "inputs": {
        "sorted-inputs": "step_2.sorted-inputs",
        "concentration-ratio": "step_2.concentration-ratio"
      },
      "outputs": {
        "vital-few": "vital-few",
        "trivial-many": "trivial-many"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "resource-reallocation-plan",
      "inputs": {
        "vital-few": "step_3.vital-few",
        "trivial-many": "step_3.trivial-many"
      },
      "outputs": {
        "reallocation-plan": "reallocation-plan",
        "expected-impact": "expected-impact"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "pareto-recheck-schedule",
      "inputs": {
        "reallocation-plan": "step_4.reallocation-plan",
        "domain-description": "from_context.domain-description"
      },
      "outputs": {
        "recheck-schedule": "recheck-schedule",
        "pareto-analysis-report": "pareto-analysis-report"
      },
      "parallel_group": 5
    }
  ],
