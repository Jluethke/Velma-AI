{
  "name": "team-skill-matrix-builder",
  "description": "Map the team's skills and find the single points of failure. Any skill with only one person at competent level or above is a vulnerability. The matrix reveals both cross-training priorities and hiring priorities: hire for the skills where you have no backup, not the skills where you already have depth.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "skill-inventory-builder",
      "inputs": {
        "team-name": "from_user_input",
        "recent-task-log": "from_user_input"
      },
      "outputs": {
        "skill-inventory": "skill-inventory",
        "skill-categories": "skill-categories"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "proficiency-assessor",
      "inputs": {
        "skill-inventory": "step_1.skill-inventory",
        "skill-categories": "step_1.skill-categories"
      },
      "outputs": {
        "proficiency-matrix": "proficiency-matrix",
        "assessment-confidence": "assessment-confidence"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "single-point-failure-finder",
      "inputs": {
        "proficiency-matrix": "step_2.proficiency-matrix",
        "assessment-confidence": "step_2.assessment-confidence"
      },
      "outputs": {
        "single-points-of-failure": "single-points-of-failure",
        "risk-score": "risk-score"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cross-training-planner",
      "inputs": {
        "single-points-of-failure": "step_3.single-points-of-failure",
        "risk-score": "step_3.risk-score"
      },
      "outputs": {
        "cross-training-plan": "cross-training-plan",
        "training-priority-sequence": "training-priority-sequence"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "hiring-priority-deriver",
      "inputs": {
        "cross-training-plan": "step_4.cross-training-plan",
        "training-priority-sequence": "step_4.training-priority-sequence"
      },
      "outputs": {
        "hiring-priorities": "hiring-priorities",
        "hire-vs-train-decision": "hire-vs-train-decision"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "matrix-maintenance-cadence",
      "inputs": {
        "hiring-priorities": "step_5.hiring-priorities",
        "hire-vs-train-decision": "step_5.hire-vs-train-decision"
      },
      "outputs": {
        "maintenance-schedule": "maintenance-schedule",
        "change-trigger-list": "change-trigger-list"
      },
      "parallel_group": 6
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
