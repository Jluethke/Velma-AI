{
  "name": "lidar-point-cloud-analysis",
  "description": "Analyze a lidar point cloud: import and register the scan, classify points, generate terrain and surface models, extract features, validate, and produce the analysis report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "lidar-import-registration",
      "inputs": {
        "raw-lidar-files": "from_user_input",
        "survey-metadata": "from_user_input"
      },
      "outputs": {
        "registered-point-cloud": "registered-point-cloud",
        "registration-quality": "registration-quality"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "lidar-point-classification",
      "inputs": {
        "registered-point-cloud": "step_1.registered-point-cloud",
        "classification-scheme": "from_context.classification-scheme"
      },
      "outputs": {
        "classified-point-cloud": "classified-point-cloud",
        "classification-statistics": "classification-statistics"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "lidar-terrain-surface-models",
      "inputs": {
        "classified-point-cloud": "step_2.classified-point-cloud"
      },
      "outputs": {
        "digital-terrain-model": "digital-terrain-model",
        "digital-surface-model": "digital-surface-model",
        "normalized-height-model": "normalized-height-model"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "lidar-feature-extraction",
      "inputs": {
        "classified-point-cloud": "step_2.classified-point-cloud",
        "normalized-height-model": "step_3.normalized-height-model",
        "survey-metadata": "from_context.survey-metadata"
      },
      "outputs": {
        "extracted-features": "extracted-features",
        "feature-statistics": "feature-statistics"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "lidar-ground-truth-validation",
      "inputs": {
        "digital-terrain-model": "step_3.digital-terrain-model",
        "extracted-features": "step_4.extracted-features",
        "ground-truth-data": "from_context.ground-truth-data"
      },
      "outputs": {
        "validation-results": "validation-results",
        "error-map": "error-map"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "lidar-analysis-report",
      "inputs": {
        "validation-results": "step_5.validation-results",
        "extracted-features": "step_4.extracted-features",
        "classification-statistics": "step_2.classification-statistics"
      },
      "outputs": {
        "lidar-report": "lidar-report",
        "deliverable-package": "deliverable-package"
      },
      "parallel_group": 6
    }
