{
  "name": "discharge-planning-protocol",
  "description": "Plan and execute a patient discharge with care coordination.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "discharge-readiness-assessor",
      "inputs": {
        "patient-record": "from_user_input",
        "discharge-criteria": "from_user_input"
      },
      "outputs": {
        "readiness-status": "readiness-status",
        "barriers-list": "barriers-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "post-discharge-care-arranger",
      "inputs": {
        "readiness-status": "step_1.readiness-status",
        "patient-record": "from_context.patient-record"
      },
      "outputs": {
        "followup-appointments": "followup-appointments",
        "service-referrals": "service-referrals"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "discharge-medication-reconciler",
      "inputs": {
        "patient-record": "from_context.patient-record",
        "service-referrals": "step_2.service-referrals"
      },
      "outputs": {
        "discharge-med-list": "discharge-med-list",
        "prescription-set": "prescription-set"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "patient-education-provider",
      "inputs": {
        "discharge-med-list": "step_3.discharge-med-list",
        "followup-appointments": "step_2.followup-appointments"
      },
      "outputs": {
        "education-materials": "education-materials",
        "understanding-confirmation": "understanding-confirmation"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "caregiver-coordinator",
      "inputs": {
        "service-referrals": "step_2.service-referrals",
        "barriers-list": "step_1.barriers-list"
      },
      "outputs": {
        "caregiver-plan": "caregiver-plan",
        "support-resources": "support-resources"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "followup-communication-scheduler",
      "inputs": {
        "caregiver-plan": "step_5.caregiver-plan",
        "understanding-confirmation": "step_4.understanding-confirmation"
      },
      "outputs": {
        "communication-schedule": "communication-schedule",
        "discharge-plan-document": "discharge-plan-document"
      },
      "parallel_group": 6
    }
  ],
  "edges": [
