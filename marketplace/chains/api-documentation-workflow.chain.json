        "example-responses": "step_2.example-responses"
      },
      "outputs": {
        "api-reference": "api-reference",
        "getting-started-guide": "getting-started-guide"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "api-doc-publisher",
      "inputs": {
        "api-reference": "step_3.api-reference",
        "getting-started-guide": "step_3.getting-started-guide"
      },
      "outputs": {
