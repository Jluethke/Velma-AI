{
  "name": "api-documentation-workflow",
  "description": "Create and maintain API documentation from endpoint inventory through publishing.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "api-endpoint-inventory",
      "inputs": {
        "api-specification": "from_user_input",
        "api-base-url": "from_user_input"
      },
      "outputs": {
        "endpoint-map": "endpoint-map",
        "auth-requirements": "auth-requirements"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "api-example-generator",
      "inputs": {
        "endpoint-catalog": "from_context.endpoint-catalog"
      },
      "outputs": {
        "example-requests": "example-requests",
        "example-responses": "example-responses"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "api-doc-writer",
      "inputs": {
        "endpoint-catalog": "from_context.endpoint-catalog",
