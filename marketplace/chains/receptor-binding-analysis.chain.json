{
  "name": "receptor-binding-analysis",
  "description": "Analyze receptor-ligand binding data from raw binding curves through model fitting, Kd and Bmax extraction, competition analysis, and cooperativity testing to a binding report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "binding-curve-importer",
      "inputs": {
        "binding-data-files": "from_user_input",
        "experiment-design": "from_user_input"
      },
      "outputs": {
        "specific-binding": "specific-binding",
        "experiment-metadata": "experiment-metadata"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "binding-model-fitter",
      "inputs": {
        "specific-binding": "step_1.specific-binding",
        "model-candidates": "from_context.model-candidates"
      },
      "outputs": {
        "fit-results": "fit-results",
        "model-selection": "model-selection"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "kd-bmax-extractor",
      "inputs": {
        "fit-results": "step_2.fit-results",
        "experiment-metadata": "step_1.experiment-metadata"
      },
      "outputs": {
        "kd-values": "kd-values",
        "bmax-values": "bmax-values"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "competition-assay-analyzer",
      "inputs": {
        "competition-data": "from_context.competition-data",
        "kd-values": "step_3.kd-values"
      },
      "outputs": {
        "ic50-values": "ic50-values",
        "ki-values": "ki-values"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "cooperativity-tester",
      "inputs": {
        "specific-binding": "step_1.specific-binding",
        "fit-results": "step_2.fit-results"
      },
      "outputs": {
        "cooperativity-assessment": "cooperativity-assessment",
        "scatchard-plot": "scatchard-plot"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "binding-report-generator",
      "inputs": {
        "kd-values": "step_3.kd-values",
        "ki-values": "step_4.ki-values",
        "cooperativity-assessment": "step_5.cooperativity-assessment"
      },
      "outputs": {
        "binding-report": "binding-report",
        "pharmacology-data": "pharmacology-data"
      },
      "parallel_group": 6
    }
  ],
