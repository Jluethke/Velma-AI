        "task-inventory": "from_user_input",
        "time-log": "from_user_input"
      },
      "outputs": {
        "scored-task-grid": "scored-task-grid",
        "delegation-candidates": "delegation-candidates"
      },
      "parallel_group": 1
    },
    {
