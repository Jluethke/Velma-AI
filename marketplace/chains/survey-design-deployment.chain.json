      },
      "outputs": {
        "survey-design": "survey-design",
        "sampling-plan": "sampling-plan"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "survey-question-writer",
      "inputs": {
        "research-question": "step_1.research-question",
        "survey-method": "from_context.survey-method"
      },
      "outputs": {
        "question-list": "question-list",
        "skip-logic-rules": "skip-logic-rules"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "survey-pilot-tester",
      "inputs": {
        "question-list": "step_3.question-list",
        "skip-logic-rules": "step_3.skip-logic-rules"
      },
      "outputs": {
        "pilot-findings": "pilot-findings",
        "revised-survey": "revised-survey"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "survey-launch-monitor",
      "inputs": {
        "revised-survey": "step_4.revised-survey",
        "distribution-plan": "from_context.distribution-plan",
        "success-criteria": "step_1.success-criteria"
      },
      "outputs": {
        "response-data": "response-data",
        "response-rate-report": "response-rate-report"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "survey-results-analyzer",
      "inputs": {
        "response-data": "step_5.response-data",
        "research-question": "step_1.research-question"
      },
      "outputs": {
        "survey-findings": "survey-findings",
        "survey-design-document": "survey-design-document"
      },
      "parallel_group": 6
    }
