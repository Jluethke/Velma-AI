{
  "name": "kubernetes-security-audit",
  "description": "Audit the security posture of a Kubernetes cluster from control plane configuration through RBAC, pod security, network policies, and runtime protections.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "k8s-control-plane-auditor",
      "inputs": {
        "cluster-access": "from_user_input",
        "cluster-version": "from_user_input",
        "audit-scope": "from_user_input"
      },
      "outputs": {
        "control-plane-findings": "control-plane-findings",
        "cluster-inventory": "cluster-inventory"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "k8s-rbac-reviewer",
      "inputs": {
        "cluster-inventory": "step_1.cluster-inventory",
        "cluster-access": "from_context.cluster-access"
      },
      "outputs": {
        "rbac-findings": "rbac-findings",
        "privilege-map": "privilege-map"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "k8s-pod-security-checker",
      "inputs": {
        "cluster-inventory": "step_1.cluster-inventory",
        "control-plane-findings": "step_1.control-plane-findings"
      },
      "outputs": {
        "pod-security-findings": "pod-security-findings",
        "admission-controller-status": "admission-controller-status"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "k8s-network-policy-tester",
      "inputs": {
        "cluster-inventory": "step_1.cluster-inventory",
        "cluster-access": "from_context.cluster-access"
      },
      "outputs": {
        "network-policy-findings": "network-policy-findings",
        "network-reachability-map": "network-reachability-map"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "k8s-secrets-encryption-verifier",
      "inputs": {
        "control-plane-findings": "step_1.control-plane-findings",
        "cluster-access": "from_context.cluster-access"
      },
      "outputs": {
        "secrets-findings": "secrets-findings",
        "secrets-management-status": "secrets-management-status"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "k8s-runtime-security-reviewer",
      "inputs": {
        "pod-security-findings": "step_3.pod-security-findings",
        "cluster-inventory": "step_1.cluster-inventory"
      },
      "outputs": {
        "runtime-security-findings": "runtime-security-findings",
        "image-policy-status": "image-policy-status"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "k8s-hardening-report-writer",
      "inputs": {
        "control-plane-findings": "step_1.control-plane-findings",
        "rbac-findings": "step_2.rbac-findings",
        "network-policy-findings": "step_4.network-policy-findings",
        "runtime-security-findings": "step_6.runtime-security-findings"
      },
      "outputs": {
        "k8s-security-report": "k8s-security-report",
        "hardening-checklist": "hardening-checklist"
      },
      "parallel_group": 7
    }
  ],
