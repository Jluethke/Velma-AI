{
  "name": "migration-planner",
  "description": "Plan a system migration without losing your mind. Map the current system, design the data pipeline, plan integrations, assess risks, and produce a migration checklist with rollback strategy.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "codebase-mapper",
      "inputs": {
        "repo_path": "from_user_input",
        "language_filter": "from_user_input",
        "depth": "from_user_input",
        "previous_map": "from_user_input"
      },
      "outputs": {
        "architecture_map": "architecture_map_data",
        "dependency_graph": "dependency_graph_data",
        "file_index": "file_index_data",
        "tech_stack_summary": "tech_stack_summary_data",
        "drift_report": "drift_report_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "data-pipeline",
      "inputs": {
        "data_sources": "step_1.architecture_map",
        "destination": "step_1.architecture_map",
        "freshness_requirements": "step_1.architecture_map",
        "volume_estimate": "step_1.architecture_map",
        "task_description": "step_1.architecture_map"
      },
      "outputs": {
        "pipeline_architecture": "pipeline_architecture_data",
        "pipeline_code": "pipeline_code_data",
        "quality_checks": "quality_checks_data",
        "monitoring_config": "monitoring_config_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "api-integration-planner",
      "inputs": {
        "api_docs": "step_1.architecture_map",
        "integration_requirements": "step_1.architecture_map",
        "tech_stack": "step_1.architecture_map",
        "existing_integrations": "step_1.architecture_map",
        "api_schema_cache": "step_1.architecture_map"
      },
      "outputs": {
        "api_discovery_report": "api_discovery_report_data",
        "integration_design": "integration_design_data",
        "client_code": "client_code_data",
        "validation_results": "validation_results_data",
        "hardening_plan": "hardening_plan_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_4",
      "skill_name": "risk-assessor",
      "inputs": {
        "plan_description": "step_2.pipeline_architecture",
        "plan_type": "step_2.pipeline_architecture",
        "stakeholders": "step_2.pipeline_architecture",
        "time_horizon": "step_2.pipeline_architecture",
        "risk_appetite": "step_2.pipeline_architecture",
        "known_risks": "step_2.pipeline_architecture"
      },
      "outputs": {
        "risk_register": "risk_register_data",
        "risk_matrix": "risk_matrix_data",
        "top_risks": "top_risks_data",
        "monitoring_plan": "monitoring_plan_data",
        "hidden_risks": "hidden_risks_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_5",
      "skill_name": "checklist-builder",
      "inputs": {
        "goal_or_event": "step_4.risk_register",
        "deadline": "step_4.risk_register",
        "constraints": "step_4.risk_register",
        "experience_level": "step_4.risk_register"
      },
      "outputs": {
        "checklist": "checklist_data",
        "timeline": "timeline_data",
        "dont_forget": "dont_forget_data",
        "dependencies": "dependencies_data"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "architecture_map",
      "field_mapping": "architecture_map -> data_sources; architecture_map -> destination; architecture_map -> freshness_requirements; architecture_map -> volume_estimate; architecture_map -> task_description"
    },
    {
      "from_step": "step_1",
      "to_step": "step_3",
      "data_type": "architecture_map",
      "field_mapping": "architecture_map -> api_docs; architecture_map -> integration_requirements; architecture_map -> tech_stack; architecture_map -> existing_integrations; architecture_map -> api_schema_cache"
    },
    {
      "from_step": "step_2",
      "to_step": "step_4",
      "data_type": "pipeline_architecture",
      "field_mapping": "pipeline_architecture -> plan_description; pipeline_architecture -> plan_type; pipeline_architecture -> stakeholders; pipeline_architecture -> time_horizon; pipeline_architecture -> risk_appetite; pipeline_architecture -> known_risks"
    },
    {
      "from_step": "step_3",
      "to_step": "step_4",
      "data_type": "api_discovery_report",
      "field_mapping": "api_discovery_report -> input"
    },
    {
      "from_step": "step_4",
      "to_step": "step_5",
      "data_type": "risk_register",
      "field_mapping": "risk_register -> goal_or_event; risk_register -> deadline; risk_register -> constraints; risk_register -> experience_level"
    }
  ],
  "entry_inputs": [
    "depth",
    "language_filter",
    "previous_map",
    "repo_path"
  ],
  "terminal_outputs": [
    "checklist",
    "timeline",
    "dont_forget",
    "dependencies"
  ],
  "parallel_groups": [
    [
      "step_1"
    ],
    [
      "step_2",
      "step_3"
    ],
    [
      "step_4"
    ],
    [
      "step_5"
    ]
  ],
  "estimated_cost": 0,
  "critical_path": [
    "step_1",
    "step_2",
    "step_4",
    "step_5"
  ],
  "chain_links": {
    "next_chains": [],
    "related_chains": [
      {
        "chain_name": "fabric-system-modernization",
        "relationship": "complement"
      },
      {
        "chain_name": "monolith-decomposition",
        "relationship": "complement"
      }
    ],
    "prerequisites": []
  }
}
