{
  "name": "stakeholder-influence-mapper",
  "description": "Map stakeholders on influence and interest to design communication strategy for each group. Most communication failures happen when you treat a high-influence stakeholder like a low-interest one. Works for any project, proposal, or initiative with multiple people who can affect the outcome.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "stakeholder-roster-builder",
      "inputs": {
        "initiative-description": "from_user_input",
        "known-stakeholders": "from_user_input"
      },
      "outputs": {
        "full-roster": "full-roster",
        "hidden-stakeholder-notes": "hidden-stakeholder-notes"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "influence-interest-scorer",
      "inputs": {
        "full-roster": "step_1.full-roster",
        "initiative-description": "from_context.initiative-description"
      },
      "outputs": {
        "scored-roster": "scored-roster",
        "quadrant-assignment": "quadrant-assignment"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "quadrant-communication-designer",
      "inputs": {
        "quadrant-assignment": "step_2.quadrant-assignment",
        "initiative-description": "from_context.initiative-description"
      },
      "outputs": {
        "communication-plan-per-quadrant": "communication-plan-per-quadrant",
        "individual-plans": "individual-plans"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "stakeholder-map-maintenance",
      "inputs": {
        "scored-roster": "step_2.scored-roster",
        "communication-plan-per-quadrant": "step_3.communication-plan-per-quadrant"
      },
      "outputs": {
        "review-schedule": "review-schedule",
        "shift-indicators": "shift-indicators"
      },
      "parallel_group": 4
    }
  ],
