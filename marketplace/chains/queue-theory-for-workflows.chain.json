{
  "name": "queue-theory-for-workflows",
  "description": "Apply queuing theory to any system with a backlog. Measure arrival rate, service rate, and utilization. When utilization exceeds 80%, wait times grow exponentially. This is the math, not an opinion. The fix is either reduce arrivals or increase service capacity.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "arrival-rate-calculator",
      "inputs": {
        "queue-name": "from_user_input",
        "measurement-period": "from_user_input"
      },
      "outputs": {
        "arrival-rate": "arrival-rate",
        "arrival-variability": "arrival-variability"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "service-rate-calculator",
      "inputs": {
        "queue-name": "from_context.queue-name",
        "measurement-period": "from_context.measurement-period"
      },
      "outputs": {
        "service-rate": "service-rate",
        "service-variability": "service-variability"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "utilization-and-wait-time-modeler",
      "inputs": {
        "arrival-rate": "step_1.arrival-rate",
        "service-rate": "step_2.service-rate",
        "arrival-variability": "step_1.arrival-variability",
        "service-variability": "step_2.service-variability"
      },
      "outputs": {
        "utilization-percent": "utilization-percent",
        "expected-wait-time": "expected-wait-time"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "arrival-reduction-strategies",
      "inputs": {
        "queue-name": "from_context.queue-name",
        "utilization-percent": "step_3.utilization-percent"
      },
      "outputs": {
        "deflection-opportunities": "deflection-opportunities",
        "projected-arrival-reduction": "projected-arrival-reduction"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "service-capacity-expander",
      "inputs": {
        "service-rate": "step_2.service-rate",
        "service-variability": "step_2.service-variability",
        "utilization-percent": "step_3.utilization-percent"
      },
      "outputs": {
        "capacity-expansion-options": "capacity-expansion-options",
        "target-utilization-plan": "target-utilization-plan"
      },
      "parallel_group": 5
    }
  ],
