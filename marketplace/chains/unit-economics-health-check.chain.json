{
  "name": "unit-economics-health-check",
  "description": "Check whether one transaction makes money after variable costs. Compute contribution margin, customer acquisition cost, lifetime value, and the ratio between them. A ratio below three to one signals a structural problem and a payback beyond twelve months signals a cash flow problem.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "ueh-transaction-definer",
      "inputs": {
        "business-context": "from_user_input",
        "unit-definition": "from_user_input"
      },
      "outputs": {
        "unit-model": "unit-model",
        "variable-cost-list": "variable-cost-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "ueh-contribution-calculator",
      "inputs": {
        "unit-model": "step_1.unit-model",
        "variable-cost-list": "step_1.variable-cost-list"
      },
      "outputs": {
        "unit-revenue": "unit-revenue",
        "contribution-margin": "contribution-margin"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "ueh-cac-calculator",
      "inputs": {
        "business-context": "from_context.business-context",
        "unit-model": "step_1.unit-model"
      },
      "outputs": {
        "cac-value": "cac-value",
        "acquisition-cost-breakdown": "acquisition-cost-breakdown"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "ueh-ltv-calculator",
      "inputs": {
        "contribution-margin": "step_2.contribution-margin",
        "unit-model": "step_1.unit-model"
      },
      "outputs": {
        "ltv-value": "ltv-value",
        "retention-assumptions": "retention-assumptions"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "ueh-ratio-analyzer",
      "inputs": {
        "ltv-value": "step_4.ltv-value",
        "cac-value": "step_3.cac-value"
      },
      "outputs": {
        "ltv-cac-ratio": "ltv-cac-ratio",
        "cac-payback-months": "cac-payback-months"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "ueh-diagnosis-builder",
      "inputs": {
        "ltv-cac-ratio": "step_5.ltv-cac-ratio",
        "cac-payback-months": "step_5.cac-payback-months"
      },
      "outputs": {
        "health-diagnosis": "health-diagnosis",
        "problem-flags": "problem-flags"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "ueh-health-report-writer",
      "inputs": {
        "health-diagnosis": "step_6.health-diagnosis",
        "ltv-cac-ratio": "step_5.ltv-cac-ratio"
      },
      "outputs": {
        "unit-economics-report": "unit-economics-report",
        "improvement-levers": "improvement-levers"
      },
      "parallel_group": 7
    }
  ],
