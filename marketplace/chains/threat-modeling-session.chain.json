{
  "name": "threat-modeling-session",
  "description": "Conduct a structured threat modeling session for a system using STRIDE or LINDDUN, from architecture documentation through ranked threats to remediation assignments.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "system-architecture-documenter",
      "inputs": {
        "system-name": "from_user_input",
        "architecture-sources": "from_user_input",
        "scope-boundaries": "from_user_input"
      },
      "outputs": {
        "architecture-diagram": "architecture-diagram",
        "data-flow-inventory": "data-flow-inventory",
        "external-interfaces": "external-interfaces"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "trust-boundary-identifier",
      "inputs": {
        "architecture-diagram": "step_1.architecture-diagram",
        "data-flow-inventory": "step_1.data-flow-inventory",
        "external-interfaces": "step_1.external-interfaces"
      },
      "outputs": {
        "trust-boundary-map": "trust-boundary-map",
        "boundary-crossing-inventory": "boundary-crossing-inventory",
        "privilege-level-map": "privilege-level-map"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "stride-threat-enumerator",
      "inputs": {
        "trust-boundary-map": "step_2.trust-boundary-map",
        "boundary-crossing-inventory": "step_2.boundary-crossing-inventory",
        "privilege-level-map": "step_2.privilege-level-map"
      },
      "outputs": {
        "threat-catalog": "threat-catalog",
        "attack-trees": "attack-trees"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "threat-risk-ranker",
      "inputs": {
        "threat-catalog": "step_3.threat-catalog",
        "attack-trees": "step_3.attack-trees"
      },
      "outputs": {
        "ranked-threat-list": "ranked-threat-list",
        "risk-matrix": "risk-matrix"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "existing-mitigation-mapper",
      "inputs": {
        "ranked-threat-list": "step_4.ranked-threat-list",
        "architecture-diagram": "step_1.architecture-diagram"
      },
      "outputs": {
        "mitigation-coverage-map": "mitigation-coverage-map",
        "gap-list": "gap-list"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "remediation-assignment-planner",
      "inputs": {
        "gap-list": "step_5.gap-list",
        "ranked-threat-list": "step_4.ranked-threat-list"
      },
      "outputs": {
        "remediation-plan": "remediation-plan",
        "residual-risk-summary": "residual-risk-summary"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "threat-model-document-writer",
      "inputs": {
        "architecture-diagram": "step_1.architecture-diagram",
        "trust-boundary-map": "step_2.trust-boundary-map",
        "risk-matrix": "step_4.risk-matrix",
        "remediation-plan": "step_6.remediation-plan"
      },
      "outputs": {
        "threat-model-document": "threat-model-document",
        "executive-summary": "executive-summary"
      },
      "parallel_group": 7
    }
  ],
