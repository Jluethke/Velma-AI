{
  "name": "sensor-fusion-pipeline",
  "description": "Combine data from multiple sensors into a single estimate: align sensor timelines, characterize each sensor's noise, compute optimal fusion weights, fuse with a Kalman-style approach, and validate the fused output.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "sensor-timeline-aligner",
      "inputs": {
        "multi-sensor-data": "from_user_input",
        "sensor-specifications": "from_user_input"
      },
      "outputs": {
        "aligned-data": "aligned-data",
        "alignment-log": "alignment-log"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "sensor-noise-characterizer",
      "inputs": {
        "aligned-data": "step_1.aligned-data",
        "reference-data": "from_context.reference-data"
      },
      "outputs": {
        "noise-profiles": "noise-profiles",
        "correlation-matrix": "correlation-matrix"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "fusion-weight-calculator",
      "inputs": {
        "noise-profiles": "step_2.noise-profiles",
        "correlation-matrix": "step_2.correlation-matrix"
      },
      "outputs": {
        "fusion-weights": "fusion-weights",
        "expected-fused-variance": "expected-fused-variance"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "kalman-fuser",
      "inputs": {
        "aligned-data": "step_1.aligned-data",
        "fusion-weights": "step_3.fusion-weights"
      },
      "outputs": {
        "fused-estimate": "fused-estimate",
        "fused-uncertainty": "fused-uncertainty"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "fusion-output-validator",
      "inputs": {
        "fused-estimate": "step_4.fused-estimate",
        "reference-data": "from_context.reference-data"
      },
      "outputs": {
        "validation-metrics": "validation-metrics",
        "improvement-summary": "improvement-summary"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "fusion-report-assembler",
      "inputs": {
        "noise-profiles": "step_2.noise-profiles",
        "fused-estimate": "step_4.fused-estimate",
        "validation-metrics": "step_5.validation-metrics"
      },
      "outputs": {
        "fusion-report": "fusion-report",
        "deployment-config": "deployment-config"
      },
      "parallel_group": 6
    }
  ],
  "edges": [
    {
