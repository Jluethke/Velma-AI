      "skill_name": "rtl-c-mlockall-prefault",
      "inputs": {
        "app_source_dir": "from_user_input",
        "stack": "from_user_input"
      },
      "outputs": {
        "memory_lock_patch": "memory_lock_patch"
      },
      "condition": "stack == 'c' || stack == 'cpp'",
      "parallel_group": 1
    },
    {
      "id": "s17_rtl_cpp_alloc_free_loop",
      "skill_name": "rtl-cpp-alloc-free-loop",
      "inputs": {
