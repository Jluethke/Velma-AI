{
  "name": "realtime-linux",
  "description": "Bring a Linux machine to a measured real-time state for control software: PREEMPT_RT kernel, latency baseline, hardware noise, power, CPU and IRQ isolation, loaded latency, tracing, stack-specific application changes, and a measured control loop jitter verdict.",
  "steps": [
    {
      "id": "s01_rtl_kernel_rt_check",
      "skill_name": "rtl-kernel-rt-check",
      "inputs": {
        "target_host": "from_user_input"
      },
      "outputs": {
        "kernel_report": "kernel_report"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_rtl_kernel_rt_install",
      "skill_name": "rtl-kernel-rt-install",
      "inputs": {
        "kernel_report": "s01_rtl_kernel_rt_check.kernel_report",
        "distro": "from_user_input"
      },
      "outputs": {
        "rt_kernel_status": "rt_kernel_status"
      },
      "condition": "kernel_report.preempt_rt == false",
      "parallel_group": 2
    },
    {
      "id": "s03_rtl_cyclictest_baseline",
      "skill_name": "rtl-cyclictest-baseline",
      "inputs": {
        "kernel_report": "s01_rtl_kernel_rt_check.kernel_report",
        "test_duration": "from_user_input",
        "rt_priority": "from_user_input"
      },
      "outputs": {
        "baseline_histogram": "baseline_histogram",
        "baseline_summary": "baseline_summary"
      },
      "parallel_group": 2
    },
    {
      "id": "s04_rtl_hw_noise_check",
      "skill_name": "rtl-hw-noise-check",
      "inputs": {
        "kernel_report": "s01_rtl_kernel_rt_check.kernel_report",
        "test_duration": "from_user_input"
      },
      "outputs": {
        "hw_noise_report": "hw_noise_report"
      },
      "parallel_group": 2
    },
    {
      "id": "s05_rtl_power_cstate_tuning",
      "skill_name": "rtl-power-cstate-tuning",
      "inputs": {
        "hw_noise_report": "s04_rtl_hw_noise_check.hw_noise_report",
        "rt_cpus": "from_user_input"
      },
      "outputs": {
        "power_config": "power_config"
      },
      "parallel_group": 3
    },
    {
      "id": "s06_rtl_cpu_isolation_bootargs",
      "skill_name": "rtl-cpu-isolation-bootargs",
      "inputs": {
        "kernel_report": "s01_rtl_kernel_rt_check.kernel_report",
        "rt_cpus": "from_user_input",
        "housekeeping_cpus": "from_user_input"
      },
      "outputs": {
        "isolation_config": "isolation_config"
      },
      "parallel_group": 2
    },
    {
      "id": "s07_rtl_cpuset_partition",
      "skill_name": "rtl-cpuset-partition",
      "inputs": {
        "isolation_config": "s06_rtl_cpu_isolation_bootargs.isolation_config",
        "rt_cpus": "from_user_input",
        "housekeeping_cpus": "from_user_input"
      },
      "outputs": {
        "cpuset_config": "cpuset_config"
      },
      "condition": "use_cpuset_partition == true",
      "parallel_group": 3
    },
    {
      "id": "s08_rtl_irq_affinity",
      "skill_name": "rtl-irq-affinity",
      "inputs": {
        "isolation_config": "s06_rtl_cpu_isolation_bootargs.isolation_config",
        "housekeeping_cpus": "from_user_input",
        "rt_device_irqs": "from_user_input_optional"
      },
      "outputs": {
        "irq_affinity_map": "irq_affinity_map"
      },
      "parallel_group": 3
    },
    {
      "id": "s09_rtl_threaded_irq_priority",
      "skill_name": "rtl-threaded-irq-priority",
      "inputs": {
        "irq_affinity_map": "s08_rtl_irq_affinity.irq_affinity_map",
        "rt_priority": "from_user_input",
        "rt_device_irqs": "from_user_input_optional"
      },
      "outputs": {
        "irq_thread_priorities": "irq_thread_priorities"
      },
      "parallel_group": 4
    },
    {
      "id": "s10_rtl_cyclictest_under_load",
      "skill_name": "rtl-cyclictest-under-load",
      "inputs": {
        "baseline_summary": "s03_rtl_cyclictest_baseline.baseline_summary",
        "isolation_config": "s06_rtl_cpu_isolation_bootargs.isolation_config",
        "power_config": "s05_rtl_power_cstate_tuning.power_config",
        "irq_thread_priorities": "s09_rtl_threaded_irq_priority.irq_thread_priorities",
        "test_duration": "from_user_input",
        "rt_priority": "from_user_input",
        "rt_cpus": "from_user_input"
      },
      "outputs": {
        "loaded_histogram": "loaded_histogram",
        "loaded_summary": "loaded_summary"
      },
      "parallel_group": 5
    },
    {
      "id": "s11_rtl_cyclictest_histogram_read",
      "skill_name": "rtl-cyclictest-histogram-read",
      "inputs": {
        "cyclictest_histogram": "s10_rtl_cyclictest_under_load.loaded_histogram",
        "jitter_budget_us": "from_user_input"
      },
      "outputs": {
        "latency_findings": "latency_findings"
      },
      "parallel_group": 6
    },
    {
      "id": "s12_rtl_rtla_timerlat",
      "skill_name": "rtl-rtla-timerlat",
      "inputs": {
        "latency_findings": "s11_rtl_cyclictest_histogram_read.latency_findings",
        "rt_cpus": "from_user_input",
        "jitter_budget_us": "from_user_input"
      },
      "outputs": {
        "timerlat_report": "timerlat_report"
      },
      "parallel_group": 7
    },
    {
      "id": "s13_rtl_ftrace_latency_trace",
      "skill_name": "rtl-ftrace-latency-trace",
      "inputs": {
        "latency_findings": "s11_rtl_cyclictest_histogram_read.latency_findings",
        "rt_cpus": "from_user_input",
        "jitter_budget_us": "from_user_input"
      },
      "outputs": {
        "trace_findings": "trace_findings"
      },
      "condition": "latency_findings.exceeds_budget == true",
      "parallel_group": 7
    },
    {
      "id": "s14_rtl_sched_fifo_chrt",
      "skill_name": "rtl-sched-fifo-chrt",
      "inputs": {
        "app_command": "from_user_input",
        "rt_priority": "from_user_input",
        "rt_cpus": "from_user_input",
        "isolation_config": "s06_rtl_cpu_isolation_bootargs.isolation_config"
      },
      "outputs": {
        "sched_config": "sched_config"
      },
      "condition": "scheduler == 'fifo'",
      "parallel_group": 3
    },
    {
