        "app_command": "from_user_input",
        "loop_period_us": "from_user_input",
        "runtime_us": "from_user_input_optional",
        "isolation_config": "s06_rtl_cpu_isolation_bootargs.isolation_config"
      },
      "outputs": {
        "deadline_config": "deadline_config"
      },
      "condition": "scheduler == 'deadline'",
      "parallel_group": 3
    },
    {
