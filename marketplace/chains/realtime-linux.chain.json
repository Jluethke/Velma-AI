        "memory_lock_patch": "s16_rtl_c_mlockall_prefault.memory_lock_patch"
      },
      "outputs": {
        "alloc_audit": "alloc_audit"
      },
      "condition": "stack == 'cpp'",
      "parallel_group": 2
    },
    {
      "id": "s18_rtl_c_abs_deadline_loop",
      "skill_name": "rtl-c-abs-deadline-loop",
      "inputs": {
        "app_source_dir": "from_user_input",
        "loop_period_us": "from_user_input"
      },
      "outputs": {
        "loop_patch": "loop_patch"
      },
      "condition": "stack == 'c' || stack == 'cpp'",
      "parallel_group": 1
    },
    {
      "id": "s19_rtl_c_pi_mutex",
      "skill_name": "rtl-c-pi-mutex",
      "inputs": {
        "app_source_dir": "from_user_input"
      },
      "outputs": {
        "pi_mutex_report": "pi_mutex_report"
      },
      "condition": "stack == 'c' || stack == 'cpp'",
      "parallel_group": 1
    },
    {
      "id": "s20_rtl_rust_rt_loop",
      "skill_name": "rtl-rust-rt-loop",
      "inputs": {
        "app_source_dir": "from_user_input",
        "loop_period_us": "from_user_input",
        "rt_priority": "from_user_input"
      },
      "outputs": {
        "rust_rt_patch": "rust_rt_patch"
      },
      "condition": "stack == 'rust'",
      "parallel_group": 1
    },
    {
      "id": "s21_rtl_py_rt_loop",
      "skill_name": "rtl-py-rt-loop",
      "inputs": {
        "app_source_dir": "from_user_input",
        "loop_period_us": "from_user_input",
        "rt_priority": "from_user_input"
      },
      "outputs": {
        "py_rt_patch": "py_rt_patch"
      },
      "condition": "stack == 'python'",
      "parallel_group": 1
    },
    {
