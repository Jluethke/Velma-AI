{
  "name": "incident-notification-workflow",
  "description": "Notify stakeholders during an incident: detect the incident, classify severity, determine the audience, send notifications at defined intervals, and produce the notification record.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "incident-severity-classifier",
      "inputs": {
        "incident-details": "from_user_input",
        "severity-criteria": "from_user_input"
      },
      "outputs": {
        "severity-level": "severity-level",
        "notification-audience": "notification-audience"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "initial-notification-sender",
      "inputs": {
        "severity-level": "step_1.severity-level",
        "notification-audience": "step_1.notification-audience"
      },
      "outputs": {
        "initial-notification": "initial-notification",
        "delivery-confirmation": "delivery-confirmation"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "periodic-update-sender",
      "inputs": {
        "initial-notification": "step_2.initial-notification",
        "delivery-confirmation": "step_2.delivery-confirmation"
      },
      "outputs": {
        "update-log": "update-log",
        "stakeholder-questions": "stakeholder-questions"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "resolution-notification-sender",
      "inputs": {
        "update-log": "step_3.update-log",
        "stakeholder-questions": "step_3.stakeholder-questions"
      },
      "outputs": {
