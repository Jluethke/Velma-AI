{
  "name": "relationship-segmentation-engine",
  "description": "Segment contacts by behavior patterns (communication style, response latency, topic affinity, seasonal patterns, preferred channel) instead of demographics. Behavioral segments tell you how to engage. Demographics tell you what they look like.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "behavioral-signal-extractor",
      "inputs": {
        "interaction-history": "from_user_input",
        "channel-list": "from_user_input"
      },
      "outputs": {
        "behavioral-profiles": "behavioral-profiles",
        "signal-confidence": "signal-confidence"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "behavior-cluster-builder",
      "inputs": {
        "behavioral-profiles": "step_1.behavioral-profiles",
        "signal-confidence": "step_1.signal-confidence"
      },
      "outputs": {
        "behavioral-segments": "behavioral-segments",
        "segment-sizes": "segment-sizes"
      },
      "parallel_group": 2
    },
    {
