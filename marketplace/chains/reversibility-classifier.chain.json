{
  "name": "reversibility-classifier",
  "description": "Classify decisions by reversibility (one-way door vs two-way door) and match the decision process to the type. One-way doors (irreversible: signing a lease, accepting a job, shipping a public API) deserve slow, multi-perspective deliberation. Two-way doors (easily reversed: trying a new tool, running an experiment, changing a process) should be made fast. Most people treat every decision as a one-way door, which creates analysis paralysis and missed opportunities.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "decision-inventory-builder",
      "inputs": {
        "pending-decisions": "from_user_input",
        "context-notes": "from_user_input"
      },
      "outputs": {
        "decision-inventory": "decision-inventory",
        "deferred-decisions": "deferred-decisions"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "reversibility-assessment",
      "inputs": {
        "decision-inventory": "step_1.decision-inventory"
      },
      "outputs": {
        "classified-decisions": "classified-decisions",
        "sliding-door-deadlines": "sliding-door-deadlines"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "two-way-door-fast-decider",
      "inputs": {
        "classified-decisions": "step_2.classified-decisions"
      },
      "outputs": {
        "two-way-decisions-made": "two-way-decisions-made",
        "time-recovered": "time-recovered"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "one-way-door-deep-analyzer",
      "inputs": {
        "classified-decisions": "step_2.classified-decisions"
      },
      "outputs": {
        "one-way-analysis": "one-way-analysis",
        "missing-information": "missing-information"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "sliding-door-urgency-handler",
      "inputs": {
        "classified-decisions": "step_2.classified-decisions",
        "sliding-door-deadlines": "step_2.sliding-door-deadlines"
      },
      "outputs": {
        "sliding-door-schedule": "sliding-door-schedule",
        "urgent-sliding-doors": "urgent-sliding-doors"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "reversibility-review-schedule",
      "inputs": {
        "two-way-decisions-made": "step_3.two-way-decisions-made",
        "one-way-analysis": "step_4.one-way-analysis",
        "sliding-door-schedule": "step_5.sliding-door-schedule"
      },
      "outputs": {
        "review-calendar": "review-calendar",
        "classification-habit": "classification-habit"
      },
      "parallel_group": 6
    }
  ],
