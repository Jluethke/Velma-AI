      },
      "outputs": {
        "user-role": "user-role",
        "user-industry": "user-industry",
        "experience-level": "experience-level",
        "current-situation": "current-situation"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "needs-and-goals-mapping",
      "inputs": {
        "user-role": "step_2.user-role",
        "user-industry": "step_2.user-industry",
        "experience-level": "step_2.experience-level",
        "current-situation": "step_2.current-situation"
      },
      "outputs": {
        "identified-needs": "identified-needs",
        "matched-domains": "matched-domains",
        "matched-chains": "matched-chains"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "personalized-path-builder",
      "inputs": {
        "identified-needs": "step_3.identified-needs",
        "matched-domains": "step_3.matched-domains",
        "matched-chains": "step_3.matched-chains",
        "experience-level": "step_2.experience-level"
      },
      "outputs": {
        "recommended-first-chain": "recommended-first-chain",
        "recommended-path": "recommended-path",
        "path-rationale": "path-rationale"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "first-chain-launcher",
      "inputs": {
        "recommended-first-chain": "step_4.recommended-first-chain",
        "recommended-path": "step_4.recommended-path"
      },
      "outputs": {
        "chain-entry-inputs": "chain-entry-inputs",
        "first-step-output": "first-step-output"
      },
      "parallel_group": 5
    }
