{
  "name": "performance-calibration-method",
  "description": "Calibrate performance ratings across managers so the rating reflects the employee, not the rater. Bring managers together with anonymized rated examples, have them rate independently, and compare. Where they diverge, discuss the criteria until they agree, and document the calibrated criteria with concrete examples for next time.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "anonymized-example-assembler",
      "inputs": {
        "rating-cycle-scope": "from_user_input",
        "work-samples": "from_user_input"
      },
      "outputs": {
        "example-set": "example-set",
        "example-answer-key": "example-answer-key"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "independent-rating-collector",
      "inputs": {
        "example-set": "step_1.example-set",
        "example-answer-key": "step_1.example-answer-key"
      },
      "outputs": {
        "independent-ratings": "independent-ratings",
        "rating-spread": "rating-spread"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "rating-divergence-detector",
      "inputs": {
        "independent-ratings": "step_2.independent-ratings",
        "rating-spread": "step_2.rating-spread"
      },
      "outputs": {
        "divergence-cases": "divergence-cases",
        "systematic-lean-flags": "systematic-lean-flags"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "criteria-discussion-facilitator",
      "inputs": {
        "divergence-cases": "step_3.divergence-cases",
        "systematic-lean-flags": "step_3.systematic-lean-flags"
      },
      "outputs": {
        "discussion-record": "discussion-record",
        "resolved-ratings": "resolved-ratings"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "calibrated-criteria-documenter",
      "inputs": {
        "discussion-record": "step_4.discussion-record",
        "resolved-ratings": "step_4.resolved-ratings"
      },
      "outputs": {
        "calibrated-criteria": "calibrated-criteria",
        "anchor-examples": "anchor-examples"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "calibration-drift-monitor",
      "inputs": {
        "calibrated-criteria": "step_5.calibrated-criteria",
        "anchor-examples": "step_5.anchor-examples"
      },
      "outputs": {
        "drift-report": "drift-report",
        "criteria-updates": "criteria-updates"
      },
      "parallel_group": 6
    }
  ],
