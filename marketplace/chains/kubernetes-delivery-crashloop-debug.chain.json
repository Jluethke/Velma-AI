    },
    {
      "from_step": "s02_k8s_pod_debug_triage",
      "to_step": "s04_k8s_crashloopbackoff_decision",
      "data_type": "k8s-pod-debug-triage",
      "field_mapping": {
        "triage_report": "triage_report"
      }
    }
  ],
  "entry_inputs": [
    "cluster_context",
    "namespace",
    "app_name",
    "lint_report",
    "helm_rendered_manifests",
    "kustomize_rendered_manifests",
