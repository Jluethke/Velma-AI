{
  "name": "negotiation-preparation-method",
  "description": "Prepare for a negotiation before you are in the room. Define your BATNA and estimate theirs, because a weak BATNA means less power and should be improved first. Set your reservation price and your target, open more ambitiously than your target, and prepare three things that cost you little but are worth a lot to them.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "npm-batna-definer",
      "inputs": {
        "negotiation-context": "from_user_input",
        "counterparty": "from_user_input"
      },
      "outputs": {
        "your-batna": "your-batna",
        "their-batna-estimate": "their-batna-estimate"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "npm-batna-strengthener",
      "inputs": {
        "your-batna": "step_1.your-batna",
        "their-batna-estimate": "step_1.their-batna-estimate"
      },
      "outputs": {
        "batna-strength-rating": "batna-strength-rating",
        "batna-improvement-actions": "batna-improvement-actions"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "npm-reservation-target-setter",
      "inputs": {
        "your-batna": "step_1.your-batna",
        "batna-strength-rating": "step_2.batna-strength-rating"
      },
      "outputs": {
        "reservation-price": "reservation-price",
        "target-price": "target-price"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "npm-opening-position-builder",
      "inputs": {
        "target-price": "step_3.target-price",
        "their-batna-estimate": "step_1.their-batna-estimate"
      },
      "outputs": {
        "opening-position": "opening-position",
        "opening-justification": "opening-justification"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "npm-tradeables-inventory",
      "inputs": {
        "negotiation-context": "from_context.negotiation-context",
        "their-batna-estimate": "step_1.their-batna-estimate"
      },
      "outputs": {
        "low-cost-high-value-offers": "low-cost-high-value-offers",
        "their-likely-asks": "their-likely-asks"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "npm-concession-plan",
      "inputs": {
        "opening-position": "step_4.opening-position",
        "reservation-price": "step_3.reservation-price",
        "low-cost-high-value-offers": "step_5.low-cost-high-value-offers"
      },
      "outputs": {
        "concession-ladder": "concession-ladder",
        "walk-away-triggers": "walk-away-triggers"
      },
      "parallel_group": 6
    }
  ],
