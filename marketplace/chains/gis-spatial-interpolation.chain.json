      },
      "outputs": {
        "variogram-model": "variogram-model",
        "spatial-correlation-summary": "spatial-correlation-summary"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "interpolation-method-selector",
      "inputs": {
        "variogram-model": "step_2.variogram-model",
        "projected-point-dataset": "step_1.projected-point-dataset"
      },
      "outputs": {
        "selected-method": "selected-method",
        "method-justification": "method-justification"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "interpolation-execution",
      "inputs": {
        "selected-method": "step_3.selected-method",
        "projected-point-dataset": "step_1.projected-point-dataset",
        "study-area-boundary": "from_context.study-area-boundary"
      },
