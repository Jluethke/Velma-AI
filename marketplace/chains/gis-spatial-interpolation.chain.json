        "selected-method": "step_3.selected-method",
        "projected-point-dataset": "step_1.projected-point-dataset"
      },
      "outputs": {
        "cross-validation-metrics": "cross-validation-metrics",
        "residual-map": "residual-map"
      },
      "parallel_group": 5
    },
    {
