{
  "name": "anomaly-detection-investigation",
  "description": "Investigate an anomaly in scientific data: characterize the signal, rule out instrument and processing artifacts, compare against known mechanisms, test statistical significance, and classify the finding.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "anomaly-characterizer",
      "inputs": {
        "raw-dataset": "from_user_input",
        "anomaly-description": "from_user_input"
      },
      "outputs": {
        "anomaly-profile": "anomaly-profile",
        "context-summary": "context-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "instrument-error-checker",
      "inputs": {
        "anomaly-profile": "step_1.anomaly-profile",
        "instrument-metadata": "from_context.instrument-metadata"
      },
      "outputs": {
        "instrument-verdict": "instrument-verdict",
        "instrument-evidence": "instrument-evidence"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "data-artifact-detector",
      "inputs": {
        "anomaly-profile": "step_1.anomaly-profile",
        "processing-pipeline-description": "from_context.processing-pipeline-description"
      },
      "outputs": {
        "processing-verdict": "processing-verdict",
        "processing-evidence": "processing-evidence"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "anomaly-mechanism-comparator",
      "inputs": {
        "anomaly-profile": "step_1.anomaly-profile",
        "domain-knowledge-base": "from_context.domain-knowledge-base"
      },
      "outputs": {
        "mechanism-candidates": "mechanism-candidates",
        "mechanism-fit-scores": "mechanism-fit-scores"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "signal-significance-tester",
      "inputs": {
        "anomaly-profile": "step_1.anomaly-profile",
        "context-summary": "step_1.context-summary"
      },
      "outputs": {
        "significance-result": "significance-result",
        "test-details": "test-details"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "anomaly-classifier",
      "inputs": {
        "instrument-verdict": "step_2.instrument-verdict",
        "processing-verdict": "step_3.processing-verdict",
        "mechanism-candidates": "step_4.mechanism-candidates",
        "significance-result": "step_5.significance-result"
      },
      "outputs": {
        "anomaly-classification": "anomaly-classification",
        "classification-rationale": "classification-rationale"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "anomaly-documentation-writer",
      "inputs": {
        "anomaly-classification": "step_6.anomaly-classification",
        "classification-rationale": "step_6.classification-rationale"
      },
      "outputs": {
        "anomaly-report": "anomaly-report",
        "next-steps": "next-steps"
      },
      "parallel_group": 7
    }
  ],
