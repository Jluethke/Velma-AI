{
  "name": "systematic-review-protocol",
  "description": "Run a PRISMA-style systematic literature review from question definition through search, screening, data extraction, bias assessment, quantitative synthesis, and final report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "review-question-definer",
      "inputs": {
        "research-topic": "from_user_input",
        "preliminary-readings": "from_user_input"
      },
      "outputs": {
        "structured-question": "structured-question",
        "inclusion-criteria": "inclusion-criteria",
        "review-scope": "review-scope"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "search-strategy-builder",
      "inputs": {
        "structured-question": "step_1.structured-question",
        "inclusion-criteria": "step_1.inclusion-criteria"
      },
      "outputs": {
        "search-strings": "search-strings",
        "database-list": "database-list",
        "search-log": "search-log"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "title-abstract-screener",
      "inputs": {
        "search-log": "step_2.search-log",
        "inclusion-criteria": "step_1.inclusion-criteria"
      },
      "outputs": {
        "screened-set": "screened-set",
        "exclusion-log": "exclusion-log",
        "screening-agreement-rate": "screening-agreement-rate"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "data-extraction-form",
      "inputs": {
        "screened-set": "step_3.screened-set",
        "structured-question": "step_1.structured-question"
      },
      "outputs": {
        "extraction-table": "extraction-table",
        "extraction-discrepancies": "extraction-discrepancies"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "bias-risk-assessor",
      "inputs": {
        "extraction-table": "step_4.extraction-table",
        "review-scope": "step_1.review-scope"
      },
      "outputs": {
        "bias-assessment-table": "bias-assessment-table",
        "overall-bias-summary": "overall-bias-summary"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "quantitative-synthesis-runner",
      "inputs": {
        "extraction-table": "step_4.extraction-table",
        "bias-assessment-table": "step_5.bias-assessment-table"
      },
      "outputs": {
        "pooled-estimate": "pooled-estimate",
        "heterogeneity-statistics": "heterogeneity-statistics",
        "forest-plot": "forest-plot"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "systematic-review-reporter",
      "inputs": {
        "structured-question": "step_1.structured-question",
        "pooled-estimate": "step_6.pooled-estimate",
        "bias-assessment-table": "step_5.bias-assessment-table",
        "forest-plot": "step_6.forest-plot"
      },
      "outputs": {
        "review-manuscript": "review-manuscript",
        "prisma-checklist": "prisma-checklist",
        "supplementary-materials": "supplementary-materials"
      },
      "parallel_group": 7
    }
  ],
