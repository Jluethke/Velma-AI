{
  "name": "zero-based-allocation-engine",
  "description": "Zero-based budgeting done right. Start every category at zero, justify every dollar forward. Do not use last month as a baseline because that is how bloat survives. Compare the zero-based result against actual spending to find the gap. The gap is the bloat.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "income-baseline-setter",
      "inputs": {
        "income-sources": "from_user_input",
        "non-negotiable-obligations": "from_user_input"
      },
      "outputs": {
        "allocatable-income": "allocatable-income",
        "obligation-ratio": "obligation-ratio"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "need-category-justifier",
      "inputs": {
        "allocatable-income": "step_1.allocatable-income",
        "spending-categories": "from_context.spending-categories"
      },
      "outputs": {
        "justified-allocations": "justified-allocations",
        "allocation-total": "allocation-total"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "actual-vs-justified-gap-finder",
      "inputs": {
        "justified-allocations": "step_2.justified-allocations",
        "actual-spending": "from_context.actual-spending"
      },
      "outputs": {
        "bloat-table": "bloat-table",
        "total-bloat": "total-bloat"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "bloat-source-diagnoser",
      "inputs": {
        "bloat-table": "step_3.bloat-table",
        "actual-spending": "from_context.actual-spending"
      },
      "outputs": {
        "bloat-diagnoses": "bloat-diagnoses",
        "reversibility-assessment": "reversibility-assessment"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "zero-based-reallocation-plan",
      "inputs": {
        "bloat-diagnoses": "step_4.bloat-diagnoses",
        "reversibility-assessment": "step_4.reversibility-assessment",
        "justified-allocations": "step_2.justified-allocations"
      },
      "outputs": {
        "reallocation-actions": "reallocation-actions",
        "freed-capital-destination": "freed-capital-destination"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "zero-based-refresh-schedule",
      "inputs": {
        "reallocation-actions": "step_5.reallocation-actions",
        "total-bloat": "step_3.total-bloat"
      },
      "outputs": {
        "refresh-calendar": "refresh-calendar",
        "zero-based-allocation-report": "zero-based-allocation-report"
      },
      "parallel_group": 6
    }
  ],
  "edges": [
    {
