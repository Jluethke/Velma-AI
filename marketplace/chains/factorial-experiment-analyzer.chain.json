{
  "name": "factorial-experiment-analyzer",
  "description": "Analyze a factorial experiment: encode the design matrix, compute main effects and interactions, test significance, generate response surface plots, and identify optimal factor settings.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "design-matrix-encoder",
      "inputs": {
        "factor-definitions": "from_user_input",
        "experimental-results": "from_user_input"
      },
      "outputs": {
        "design-matrix": "design-matrix",
        "design-properties": "design-properties"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "effect-calculator",
      "inputs": {
        "design-matrix": "step_1.design-matrix",
        "design-properties": "step_1.design-properties"
      },
      "outputs": {
        "effect-estimates": "effect-estimates",
        "effect-ranking": "effect-ranking"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "significance-tester-factorial",
      "inputs": {
        "effect-estimates": "step_2.effect-estimates",
        "design-properties": "step_1.design-properties"
      },
      "outputs": {
        "anova-table": "anova-table",
        "significant-effects": "significant-effects"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "response-surface-plotter",
      "inputs": {
        "design-matrix": "step_1.design-matrix",
        "significant-effects": "step_3.significant-effects"
      },
      "outputs": {
        "surface-plots": "surface-plots",
        "response-model": "response-model"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "optimum-finder",
      "inputs": {
        "response-model": "step_4.response-model",
        "factor-definitions": "from_context.factor-definitions"
      },
      "outputs": {
        "optimal-settings": "optimal-settings",
        "predicted-optimum": "predicted-optimum"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "factorial-report-compiler",
      "inputs": {
        "effect-ranking": "step_2.effect-ranking",
        "anova-table": "step_3.anova-table",
        "optimal-settings": "step_5.optimal-settings"
      },
      "outputs": {
        "factorial-report": "factorial-report",
        "next-experiment-recommendation": "next-experiment-recommendation"
      },
      "parallel_group": 6
    }
  ],
