        "maintaining-conditions": "maintaining-conditions"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "replacement-designer",
      "inputs": {
        "pattern-origin": "step_2.pattern-origin",
        "maintaining-conditions": "step_2.maintaining-conditions"
      },
      "outputs": {
