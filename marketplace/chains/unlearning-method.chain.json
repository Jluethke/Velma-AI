        "unlearning-target": "unlearning-target",
        "evidence-of-staleness": "evidence-of-staleness"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "old-pattern-analyzer",
      "inputs": {
        "unlearning-target": "step_1.unlearning-target",
