{
  "name": "threat-driven-development",
  "description": "Apply threat-driven development to a feature by decomposing it into components, identifying threats, writing security tests, and verifying mitigations.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "feature-threat-decomposer",
      "inputs": {
        "feature-specification": "from_user_input",
        "system-architecture": "from_user_input"
      },
      "outputs": {
        "component-map": "component-map",
        "attack-surface": "attack-surface"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "stride-threat-enumerator",
      "inputs": {
        "trust-boundary-map": "from_context.trust-boundary-map",
        "boundary-crossing-inventory": "from_context.boundary-crossing-inventory",
        "privilege-level-map": "from_context.privilege-level-map"
      },
      "outputs": {
        "threat-catalog": "threat-catalog",
        "attack-trees": "attack-trees"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "security-test-case-writer",
      "inputs": {
        "threat-list": "from_context.threat-list",
        "risk-priorities": "from_context.risk-priorities"
      },
      "outputs": {
        "security-test-cases": "security-test-cases",
        "test-coverage-matrix": "test-coverage-matrix"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "mitigation-implementer",
      "inputs": {
        "security-test-cases": "step_3.security-test-cases",
        "feature-specification": "from_context.feature-specification"
      },
      "outputs": {
        "mitigation-implementations": "mitigation-implementations",
        "implementation-notes": "implementation-notes"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "mitigation-verification-runner",
      "inputs": {
        "mitigation-implementations": "step_4.mitigation-implementations",
        "security-test-cases": "step_3.security-test-cases"
      },
      "outputs": {
        "test-results": "test-results",
        "remaining-risks": "remaining-risks"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "threat-dev-report-compiler",
      "inputs": {
        "test-results": "step_5.test-results",
        "remaining-risks": "step_5.remaining-risks"
      },
      "outputs": {
        "tdd-report": "tdd-report",
        "residual-risk-acceptance": "residual-risk-acceptance"
      },
      "parallel_group": 6
    }
  ],
