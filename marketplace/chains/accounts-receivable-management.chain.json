{
  "name": "accounts-receivable-management",
  "description": "Manage accounts receivable from invoice generation through collection and aging reporting.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "invoice-generator",
      "inputs": {
        "billing-data": "from_user_input",
        "invoice-template": "from_user_input"
      },
      "outputs": {
        "issued-invoices": "issued-invoices",
        "invoice-ledger-entries": "invoice-ledger-entries"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "payment-status-tracker",
      "inputs": {
        "issued-invoices": "step_1.issued-invoices",
        "bank-deposits": "from_context.bank-deposits"
      },
      "outputs": {
        "aging-report": "aging-report",
        "overdue-list": "overdue-list"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "collections-follow-up-runner",
      "inputs": {
        "overdue-list": "step_2.overdue-list",
        "collection-policy": "from_context.collection-policy"
      },
      "outputs": {
        "collection-actions": "collection-actions",
        "payment-commitments": "payment-commitments"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "payment-reconciler",
      "inputs": {
        "bank-deposits": "from_context.bank-deposits",
        "issued-invoices": "step_1.issued-invoices"
      },
      "outputs": {
        "applied-payments": "applied-payments",
        "unapplied-cash": "unapplied-cash"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "bad-debt-assessor",
      "inputs": {
        "aging-report": "step_2.aging-report",
        "collection-actions": "step_3.collection-actions"
      },
      "outputs": {
        "bad-debt-estimate": "bad-debt-estimate",
        "write-off-recommendations": "write-off-recommendations"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "ar-metrics-reporter",
      "inputs": {
        "aging-report": "step_2.aging-report",
        "applied-payments": "step_4.applied-payments"
      },
      "outputs": {
        "ar-metrics-report": "ar-metrics-report",
        "trend-comparison": "trend-comparison"
      },
      "parallel_group": 6
    }
