{
  "name": "automation-roi-calculator",
  "description": "Decide whether a repetitive task is worth automating using a rigorous payback test. Measures time per occurrence and frequency, computes the annual manual cost, estimates build and maintenance cost, calculates the break-even horizon against a two-year rule, and adjusts for maintenance, opportunity cost, and the value of human judgment before recording the decision.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "task-time-frequency-capture",
      "inputs": {
        "task-description": "from_user_input",
        "measurement-window": "from_user_input"
      },
      "outputs": {
        "time-per-occurrence": "time-per-occurrence",
        "occurrence-frequency": "occurrence-frequency"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "annual-manual-cost",
      "inputs": {
        "time-per-occurrence": "step_1.time-per-occurrence",
        "occurrence-frequency": "step_1.occurrence-frequency"
      },
      "outputs": {
        "annual-manual-hours": "annual-manual-hours",
        "manual-cost-basis": "manual-cost-basis"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "automation-build-estimate",
      "inputs": {
        "annual-manual-hours": "step_2.annual-manual-hours",
        "manual-cost-basis": "step_2.manual-cost-basis"
      },
      "outputs": {
        "build-hours": "build-hours",
        "build-assumptions": "build-assumptions"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "maintenance-cost-estimate",
      "inputs": {
        "build-hours": "step_3.build-hours",
        "build-assumptions": "step_3.build-assumptions"
      },
      "outputs": {
        "annual-maintenance-hours": "annual-maintenance-hours",
        "maintenance-assumptions": "maintenance-assumptions"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "breakeven-calculator",
      "inputs": {
        "annual-manual-hours": "step_2.annual-manual-hours",
        "build-hours": "step_3.build-hours",
        "annual-maintenance-hours": "step_4.annual-maintenance-hours"
      },
      "outputs": {
        "breakeven-months": "breakeven-months",
        "two-year-verdict": "two-year-verdict"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "judgment-and-opportunity-adjustment",
      "inputs": {
        "breakeven-months": "step_5.breakeven-months",
        "two-year-verdict": "step_5.two-year-verdict"
      },
      "outputs": {
        "adjusted-verdict": "adjusted-verdict",
        "judgment-risk-notes": "judgment-risk-notes"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "automation-decision-record",
      "inputs": {
        "adjusted-verdict": "step_6.adjusted-verdict",
        "judgment-risk-notes": "step_6.judgment-risk-notes"
      },
      "outputs": {
        "automation-decision": "automation-decision",
        "decision-rationale": "decision-rationale"
      },
      "parallel_group": 7
    }
  ],
