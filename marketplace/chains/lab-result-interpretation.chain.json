      },
      "outputs": {
        "clinical-correlation": "clinical-correlation",
        "trending-data": "trending-data"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "additional-testing-recommender",
      "inputs": {
        "clinical-correlation": "step_4.clinical-correlation",
        "trending-data": "step_4.trending-data"
      },
      "outputs": {
        "recommended-tests": "recommended-tests",
        "action-plan": "action-plan"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "result-patient-communicator",
      "inputs": {
        "action-plan": "step_5.action-plan",
        "clinical-correlation": "step_4.clinical-correlation"
      },
      "outputs": {
