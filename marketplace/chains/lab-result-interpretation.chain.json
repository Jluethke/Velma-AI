{
  "name": "lab-result-interpretation",
  "description": "Interpret laboratory results and communicate findings to the patient.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "lab-report-receiver",
      "inputs": {
        "lab-order-id": "from_user_input",
        "patient-id": "from_user_input"
      },
      "outputs": {
        "parsed-results": "parsed-results",
        "report-metadata": "report-metadata"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "reference-range-comparator",
      "inputs": {
        "parsed-results": "step_1.parsed-results",
        "report-metadata": "step_1.report-metadata"
      },
      "outputs": {
        "flagged-values": "flagged-values",
        "normal-values": "normal-values"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "critical-value-handler",
      "inputs": {
        "flagged-values": "step_2.flagged-values",
        "patient-id": "from_context.patient-id"
      },
      "outputs": {
