      "field_mapping": "four_week_plan -> input"
    },
    {
      "from_step": "step_4",
      "to_step": "step_5",
      "data_type": "room_plan",
      "field_mapping": "room_plan -> input"
    },
    {
      "from_step": "step_5",
      "to_step": "step_6",
      "data_type": "time_blocked_schedule",
      "field_mapping": "time_blocked_schedule -> target_habit; time_blocked_schedule -> current_habits; time_blocked_schedule -> goals; time_blocked_schedule -> available_time; time_blocked_schedule -> barriers"
    }
  ],
