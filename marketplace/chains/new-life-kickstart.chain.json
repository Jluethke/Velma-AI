{
  "name": "new-life-kickstart",
  "description": "Starting fresh? Moving to a new city, post-divorce, empty nest, or just want a reset? This flow builds your new daily structure from the ground up: plan meals, build a fitness routine, organize your home, set a budget, and plan your weeks.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "budget-builder",
      "inputs": {
        "income": "from_user_input",
        "fixed_expenses": "from_user_input",
        "variable_spending": "from_user_input",
        "financial_situation": "from_user_input",
        "goals": "from_user_input"
      },
      "outputs": {
        "spending_snapshot": "spending_snapshot_data",
        "monthly_budget": "monthly_budget_data",
        "bleed_points": "bleed_points_data",
        "action_plan": "action_plan_data",
        "monthly_checkup": "monthly_checkup_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "meal-planner",
      "inputs": {
        "household": "step_1.spending_snapshot",
        "budget": "step_1.spending_snapshot",
        "pantry": "step_1.spending_snapshot",
        "preferences": "step_1.spending_snapshot",
        "schedule": "step_1.spending_snapshot"
      },
      "outputs": {
        "weekly_menu": "weekly_menu_data",
        "grocery_list": "grocery_list_data",
        "prep_instructions": "prep_instructions_data",
        "leftover_plan": "leftover_plan_data",
        "cost_estimate": "cost_estimate_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "fitness-starter",
      "inputs": {
        "age_range": "from_user_input",
        "current_activity": "from_user_input",
        "limitations": "from_user_input",
        "equipment": "from_user_input",
        "time_commitment": "from_user_input",
        "goals": "from_user_input"
      },
      "outputs": {
        "four_week_plan": "four_week_plan_data",
        "exercise_library": "exercise_library_data",
        "warm_up_routine": "warm_up_routine_data",
        "cool_down_routine": "cool_down_routine_data",
        "progress_milestones": "progress_milestones_data",
        "what_comes_next": "what_comes_next_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_4",
      "skill_name": "declutter-coach",
      "inputs": {
        "space": "from_user_input",
        "goal": "from_user_input",
        "timeline": "from_user_input",
        "emotional_factors": "from_user_input",
        "constraints": "from_user_input"
      },
      "outputs": {
        "room_plan": "room_plan_data",
        "sorting_guide": "sorting_guide_data",
        "disposal_map": "disposal_map_data",
        "organization_plan": "organization_plan_data",
        "maintenance_system": "maintenance_system_data",
        "progress_tracker": "progress_tracker_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_5",
      "skill_name": "daily-planner",
      "inputs": {
        "calendar_events": "step_2.weekly_menu",
        "task_list": "step_2.weekly_menu",
        "energy_profile": "step_2.weekly_menu",
        "goals": "step_2.weekly_menu",
        "deadlines": "step_2.weekly_menu"
      },
      "outputs": {
        "time_blocked_schedule": "time_blocked_schedule_data",
        "top_priorities": "top_priorities_data",
        "evening_review_prompts": "evening_review_prompts_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_6",
      "skill_name": "habit-builder",
      "inputs": {
        "target_habit": "step_5.time_blocked_schedule",
        "current_habits": "step_5.time_blocked_schedule",
        "goals": "step_5.time_blocked_schedule",
        "available_time": "step_5.time_blocked_schedule",
        "barriers": "step_5.time_blocked_schedule"
      },
      "outputs": {
        "habit_stack_design": "habit_stack_design_data",
        "thirty_day_plan": "thirty_day_plan_data",
        "daily_checkin": "daily_checkin_data",
        "adjustment_recommendations": "adjustment_recommendations_data"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "spending_snapshot",
      "field_mapping": "spending_snapshot -> household; spending_snapshot -> budget; spending_snapshot -> pantry; spending_snapshot -> preferences; spending_snapshot -> schedule"
