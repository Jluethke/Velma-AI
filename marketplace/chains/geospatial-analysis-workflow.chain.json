{
  "name": "geospatial-analysis-workflow",
  "description": "Analyze spatially distributed data through coordinate projection, autocorrelation testing, interpolation, layer overlay, hotspot detection, and spatial validation.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "coordinate-projector",
      "inputs": {
        "spatial-data-files": "from_user_input",
        "target-crs": "from_user_input"
      },
      "outputs": {
        "projected-data": "projected-data",
        "projection-log": "projection-log"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "spatial-autocorrelation-tester",
      "inputs": {
        "projected-data": "step_1.projected-data",
        "spatial-weights": "from_context.spatial-weights"
      },
      "outputs": {
        "global-autocorrelation": "global-autocorrelation",
        "local-indicators": "local-indicators"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "spatial-interpolator",
      "inputs": {
        "projected-data": "step_1.projected-data",
        "interpolation-method": "from_context.interpolation-method",
        "prediction-grid": "from_context.prediction-grid"
      },
      "outputs": {
        "interpolated-surface": "interpolated-surface",
        "prediction-uncertainty": "prediction-uncertainty"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "contextual-layer-overlay",
      "inputs": {
        "interpolated-surface": "step_3.interpolated-surface",
        "context-layers": "from_context.context-layers"
      },
      "outputs": {
        "enriched-surface": "enriched-surface",
        "overlay-summary": "overlay-summary"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "hotspot-detector",
      "inputs": {
        "enriched-surface": "step_4.enriched-surface",
        "hotspot-method": "from_context.hotspot-method"
      },
      "outputs": {
        "hotspot-map": "hotspot-map",
        "hotspot-table": "hotspot-table"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "spatial-validation",
      "inputs": {
        "interpolated-surface": "step_3.interpolated-surface",
        "holdout-points": "from_context.holdout-points"
      },
      "outputs": {
        "validation-metrics": "validation-metrics",
        "residual-map": "residual-map"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "spatial-report-writer",
      "inputs": {
        "hotspot-map": "step_5.hotspot-map",
        "validation-metrics": "step_6.validation-metrics",
        "global-autocorrelation": "step_2.global-autocorrelation"
      },
      "outputs": {
        "spatial-analysis-report": "spatial-analysis-report",
        "spatial-figures": "spatial-figures"
      },
      "parallel_group": 7
    }
  ],
