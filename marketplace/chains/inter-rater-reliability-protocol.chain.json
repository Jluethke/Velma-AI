{
  "name": "inter-rater-reliability-protocol",
  "description": "Establish inter-rater reliability for qualitative coding: define the scheme, train raters, run independent coding, compute agreement coefficients, identify disagreement patterns, refine the codebook, and produce the final assessment.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "coding-scheme-definer",
      "inputs": {
        "research-question": "from_user_input",
        "sample-data": "from_user_input"
      },
      "outputs": {
        "codebook-draft": "codebook-draft",
        "ambiguity-notes": "ambiguity-notes"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "rater-trainer",
      "inputs": {
        "codebook-draft": "step_1.codebook-draft",
        "training-dataset": "from_context.training-dataset"
      },
      "outputs": {
        "training-log": "training-log",
        "rater-readiness-assessment": "rater-readiness-assessment"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "independent-coding-runner",
      "inputs": {
        "codebook-draft": "step_1.codebook-draft",
        "reliability-dataset": "from_context.reliability-dataset"
      },
      "outputs": {
        "rater-code-matrix": "rater-code-matrix",
        "coding-process-notes": "coding-process-notes"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "reliability-coefficient-calculator",
      "inputs": {
        "rater-code-matrix": "step_3.rater-code-matrix",
        "code-measurement-level": "from_context.code-measurement-level"
      },
      "outputs": {
        "agreement-coefficient": "agreement-coefficient",
        "coefficient-interpretation": "coefficient-interpretation"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "disagreement-analyzer",
      "inputs": {
        "rater-code-matrix": "step_3.rater-code-matrix",
        "agreement-coefficient": "step_4.agreement-coefficient"
      },
      "outputs": {
        "confusion-matrix": "confusion-matrix",
        "disagreement-patterns": "disagreement-patterns"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "codebook-refiner",
      "inputs": {
        "codebook-draft": "step_1.codebook-draft",
        "disagreement-patterns": "step_5.disagreement-patterns",
        "confusion-matrix": "step_5.confusion-matrix"
      },
      "outputs": {
        "codebook-revised": "codebook-revised",
        "revision-changelog": "revision-changelog"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "reliability-assessment-report",
      "inputs": {
        "agreement-coefficient": "step_4.agreement-coefficient",
        "disagreement-patterns": "step_5.disagreement-patterns",
        "codebook-revised": "step_6.codebook-revised"
      },
      "outputs": {
        "reliability-report": "reliability-report",
        "proceed-recommendation": "proceed-recommendation"
      },
      "parallel_group": 7
    }
  ],
