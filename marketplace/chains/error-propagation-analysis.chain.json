{
  "name": "error-propagation-analysis",
  "description": "Trace how measurement errors propagate through a calculation: catalog inputs and uncertainties, classify error types, propagate analytically or by Monte Carlo, identify dominant sources, and produce the uncertainty budget.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "measurement-cataloger",
      "inputs": {
        "calculation-description": "from_user_input",
        "measurement-sources": "from_user_input"
      },
      "outputs": {
        "measurement-table": "measurement-table",
        "calculation-formula": "calculation-formula"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "uncertainty-classifier",
      "inputs": {
        "measurement-table": "step_1.measurement-table"
      },
      "outputs": {
        "classified-uncertainties": "classified-uncertainties",
        "correlation-notes": "correlation-notes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "error-propagator",
      "inputs": {
        "calculation-formula": "step_1.calculation-formula",
        "classified-uncertainties": "step_2.classified-uncertainties",
        "correlation-notes": "step_2.correlation-notes"
      },
      "outputs": {
        "combined-uncertainty": "combined-uncertainty",
        "sensitivity-coefficients": "sensitivity-coefficients"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "dominant-error-identifier",
      "inputs": {
        "sensitivity-coefficients": "step_3.sensitivity-coefficients",
        "classified-uncertainties": "step_2.classified-uncertainties"
      },
      "outputs": {
        "uncertainty-ranking": "uncertainty-ranking",
        "improvement-targets": "improvement-targets"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "uncertainty-budget-compiler",
      "inputs": {
        "measurement-table": "step_1.measurement-table",
        "sensitivity-coefficients": "step_3.sensitivity-coefficients",
        "combined-uncertainty": "step_3.combined-uncertainty"
      },
      "outputs": {
        "uncertainty-budget": "uncertainty-budget",
        "expanded-uncertainty": "expanded-uncertainty"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "error-report-writer",
      "inputs": {
        "uncertainty-budget": "step_5.uncertainty-budget",
        "improvement-targets": "step_4.improvement-targets",
        "expanded-uncertainty": "step_5.expanded-uncertainty"
      },
      "outputs": {
        "uncertainty-report": "uncertainty-report",
        "measurement-result-statement": "measurement-result-statement"
      },
      "parallel_group": 6
    }
  ],
