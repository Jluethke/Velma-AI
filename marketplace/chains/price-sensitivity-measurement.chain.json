      "skill_name": "psm-survey-designer",
      "inputs": {
        "product-description": "from_user_input",
        "target-respondents": "from_user_input"
      },
      "outputs": {
        "psm-survey": "psm-survey",
        "sample-plan": "sample-plan"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "psm-data-collector",
