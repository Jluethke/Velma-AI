        "pricing-scenarios": "pricing-scenarios"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "pss-decision-recorder",
      "inputs": {
        "context-adjusted-prices": "step_6.context-adjusted-prices",
        "method-comparison": "step_5.method-comparison"
      },
      "outputs": {
        "price-recommendation": "price-recommendation",
        "price-sensitivity-report": "price-sensitivity-report"
      },
      "parallel_group": 7
    }
  ],
