      },
      "outputs": {
        "clean-responses": "clean-responses",
        "response-quality-report": "response-quality-report"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "psm-curve-plotter",
      "inputs": {
        "clean-responses": "step_2.clean-responses"
      },
      "outputs": {
        "psm-curves": "psm-curves",
        "intersection-points": "intersection-points"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "pss-gabor-granger-tester",
      "inputs": {
        "clean-responses": "step_2.clean-responses"
      },
      "outputs": {
        "gabor-granger-schedule": "gabor-granger-schedule",
        "revenue-maximizing-price": "revenue-maximizing-price"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "pss-method-reconciler",
      "inputs": {
        "intersection-points": "step_3.intersection-points",
