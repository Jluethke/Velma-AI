{
  "name": "terms-of-service-creation",
  "description": "Create terms of service for a product from scope definition through regulatory review.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "tos-scope-definer",
      "inputs": {
        "product-description": "from_user_input",
        "target-audience": "from_user_input"
      },
      "outputs": {
        "service-scope": "service-scope",
        "account-terms": "account-terms"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "acceptable-use-policy-drafter",
      "inputs": {
        "service-scope": "step_1.service-scope",
        "product-description": "from_context.product-description"
      },
      "outputs": {
        "aup-text": "aup-text",
        "prohibited-conduct": "prohibited-conduct"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "ip-and-content-license-drafter",
      "inputs": {
        "service-scope": "step_1.service-scope",
        "product-description": "from_context.product-description"
      },
      "outputs": {
        "ip-ownership-clause": "ip-ownership-clause",
        "user-content-license": "user-content-license"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "liability-disclaimer-drafter",
      "inputs": {
        "service-scope": "step_1.service-scope",
        "ip-ownership-clause": "step_3.ip-ownership-clause"
      },
      "outputs": {
        "liability-section": "liability-section",
        "warranty-disclaimers": "warranty-disclaimers"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "dispute-resolution-drafter",
      "inputs": {
        "liability-section": "step_4.liability-section",
        "target-audience": "from_context.target-audience"
      },
      "outputs": {
        "dispute-section": "dispute-section",
        "governing-law": "governing-law"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "tos-regulatory-reviewer",
      "inputs": {
        "aup-text": "step_2.aup-text",
        "dispute-section": "step_5.dispute-section",
        "liability-section": "step_4.liability-section"
      },
      "outputs": {
        "compliance-notes": "compliance-notes",
        "tos-final-draft": "tos-final-draft"
      },
      "parallel_group": 6
    }
