{
  "name": "negotiation-anchor-strategy",
  "description": "Set the anchor that pulls a negotiation toward your target. Define the target and walk-away, research the realistic range, place the anchor twenty to forty percent beyond the target with supporting reasoning, and plan the concession path. Works for salary, vendor, real estate, and freelance talks.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "nas-target-setter",
      "inputs": {
        "negotiation-context": "from_user_input",
        "your-objective": "from_user_input"
      },
      "outputs": {
        "target-outcome": "target-outcome",
        "walk-away-point": "walk-away-point"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "nas-range-researcher",
      "inputs": {
        "negotiation-context": "from_context.negotiation-context",
        "target-outcome": "step_1.target-outcome"
      },
      "outputs": {
        "market-range": "market-range",
        "counterpart-profile": "counterpart-profile"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "nas-anchor-builder",
      "inputs": {
        "target-outcome": "step_1.target-outcome",
        "market-range": "step_2.market-range"
      },
      "outputs": {
        "anchor-value": "anchor-value",
        "anchor-justification": "anchor-justification"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "nas-concession-planner",
      "inputs": {
        "anchor-value": "step_3.anchor-value",
        "walk-away-point": "step_1.walk-away-point"
      },
      "outputs": {
        "concession-ladder": "concession-ladder",
        "trade-list": "trade-list"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "nas-script-writer",
      "inputs": {
        "anchor-justification": "step_3.anchor-justification",
        "concession-ladder": "step_4.concession-ladder"
      },
      "outputs": {
        "opening-script": "opening-script",
        "response-playbook": "response-playbook"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "nas-strategy-report-writer",
      "inputs": {
        "opening-script": "step_5.opening-script",
        "trade-list": "step_4.trade-list"
      },
      "outputs": {
        "negotiation-plan": "negotiation-plan",
        "anchor-strategy-report": "anchor-strategy-report"
      },
      "parallel_group": 6
    }
