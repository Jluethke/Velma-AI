{
  "name": "scope-management-method",
  "description": "Define scope by what is excluded, not just what is included. Every addition is evaluated against the constraint triangle (time, cost, quality): if you add scope, something else must give. Scope creep is not a mysterious force. It is the accumulation of unvetted additions.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "scope-boundary-setter",
      "inputs": {
        "initiative-description": "from_user_input",
        "constraints": "from_user_input"
      },
      "outputs": {
        "in-scope-list": "in-scope-list",
        "out-of-scope-list": "out-of-scope-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "change-request-evaluator",
      "inputs": {
        "in-scope-list": "step_1.in-scope-list",
        "constraints": "from_context.constraints",
        "change-request": "from_context.change-request"
      },
      "outputs": {
        "impact-assessment": "impact-assessment",
        "trade-off-options": "trade-off-options"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "scope-creep-detector",
      "inputs": {
        "in-scope-list": "step_1.in-scope-list",
        "change-request": "from_context.change-request"
      },
      "outputs": {
        "scope-drift-report": "scope-drift-report",
        "scope-creep-alerts": "scope-creep-alerts"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "scope-review-checkpoint",
      "inputs": {
        "scope-drift-report": "step_3.scope-drift-report",
        "constraints": "from_context.constraints"
      },
      "outputs": {
        "scope-vs-constraints-assessment": "scope-vs-constraints-assessment",
        "scope-adjustment-recommendation": "scope-adjustment-recommendation"
      },
      "parallel_group": 4
    }
  ],
