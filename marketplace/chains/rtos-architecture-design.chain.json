      },
      "outputs": {
        "stack-allocation-table": "stack-allocation-table",
        "memory-budget": "memory-budget"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "rtos-timing-verification",
      "inputs": {
        "stack-allocation-table": "step_4.stack-allocation-table",
        "schedulability-result": "step_2.schedulability-result"
      },
      "outputs": {
        "timing-report": "timing-report",
