      },
      "outputs": {
        "task-list": "task-list",
        "isr-list": "isr-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "rtos-priority-assignment",
      "inputs": {
        "task-list": "step_1.task-list",
        "isr-list": "step_1.isr-list"
      },
      "outputs": {
        "priority-table": "priority-table",
        "schedulability-result": "schedulability-result"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "rtos-ipc-design",
      "inputs": {
        "priority-table": "step_2.priority-table",
        "task-list": "step_1.task-list"
      },
      "outputs": {
        "ipc-architecture": "ipc-architecture",
        "blocking-analysis": "blocking-analysis"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "rtos-stack-sizing",
      "inputs": {
        "ipc-architecture": "step_3.ipc-architecture",
