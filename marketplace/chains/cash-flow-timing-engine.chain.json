{
  "name": "cash-flow-timing-engine",
  "description": "Build a cash flow system focused on timing, not just amounts. Map every inflow and outflow by day of month, find the valleys where your balance hits its lowest, calculate float, and shift controllable outflows away from valleys. Works identically for a checking account or a corporate AP department.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "inflow-outflow-day-mapper",
      "inputs": {
        "account-transactions": "from_user_input",
        "account-context": "from_user_input"
      },
      "outputs": {
        "daily-flow-calendar": "daily-flow-calendar",
        "flow-classification": "flow-classification"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "cash-valley-identifier",
      "inputs": {
        "daily-flow-calendar": "step_1.daily-flow-calendar",
        "starting-balance": "from_context.starting-balance"
      },
      "outputs": {
        "daily-balance-curve": "daily-balance-curve",
        "valley-days": "valley-days"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "float-calculator",
      "inputs": {
        "daily-balance-curve": "step_2.daily-balance-curve",
        "valley-days": "step_2.valley-days"
      },
      "outputs": {
        "float-windows": "float-windows",
        "total-float-days": "total-float-days"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "controllable-outflow-ranker",
      "inputs": {
        "daily-flow-calendar": "step_1.daily-flow-calendar",
        "flow-classification": "step_1.flow-classification"
      },
      "outputs": {
        "timing-control-ranking": "timing-control-ranking",
        "movable-outflows": "movable-outflows"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "valley-avoidance-optimizer",
      "inputs": {
        "valley-days": "step_2.valley-days",
        "movable-outflows": "step_4.movable-outflows",
        "daily-balance-curve": "step_2.daily-balance-curve"
      },
      "outputs": {
        "shift-recommendations": "shift-recommendations",
        "optimized-balance-curve": "optimized-balance-curve"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "cash-flow-timing-implementation-plan",
      "inputs": {
        "shift-recommendations": "step_5.shift-recommendations",
        "optimized-balance-curve": "step_5.optimized-balance-curve",
        "float-windows": "step_3.float-windows"
      },
      "outputs": {
        "implementation-checklist": "implementation-checklist",
        "cash-flow-timing-report": "cash-flow-timing-report"
      },
      "parallel_group": 6
    }
  ],
