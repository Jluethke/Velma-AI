{
  "name": "work-breakdown-decomposer",
  "description": "Decompose any initiative into estimable work packages using recursive decomposition. Keep breaking each item into smaller pieces until every piece can be estimated by one person and completed in one week or less. If you cannot decompose it, you do not understand it well enough to estimate it.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "deliverable-level-decomposer",
      "inputs": {
        "initiative-description": "from_user_input",
        "acceptance-criteria": "from_user_input"
      },
      "outputs": {
        "deliverable-list": "deliverable-list",
        "deliverable-dependencies": "deliverable-dependencies"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "task-level-decomposer",
      "inputs": {
        "deliverable-list": "step_1.deliverable-list",
        "deliverable-dependencies": "step_1.deliverable-dependencies"
      },
      "outputs": {
        "task-list": "task-list",
        "uncertainty-flags": "uncertainty-flags"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "estimation-validation",
      "inputs": {
        "task-list": "step_2.task-list",
        "initiative-description": "from_context.initiative-description"
      },
      "outputs": {
        "bottom-up-total": "bottom-up-total",
        "top-down-estimate": "top-down-estimate",
        "estimation-gap-analysis": "estimation-gap-analysis"
      },
      "parallel_group": 3
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "object",
      "field_mapping": {}
    },
    {
      "from_step": "step_2",
      "to_step": "step_3",
      "data_type": "object",
      "field_mapping": {}
    }
  ],
  "entry_inputs": [
    "initiative-description",
    "acceptance-criteria"
  ],
  "terminal_outputs": [
    "bottom-up-total",
    "top-down-estimate",
    "estimation-gap-analysis"
  ],
  "parallel_groups": [
