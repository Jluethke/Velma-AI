{
  "name": "sensitivity-analysis-workflow",
  "description": "Test how sensitive a model's output is to its inputs through parameter identification, method selection, range definition, analysis execution, influence ranking, and interaction detection.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "model-parameter-identifier",
      "inputs": {
        "model-description": "from_user_input",
        "domain-knowledge": "from_user_input"
      },
      "outputs": {
        "parameter-catalog": "parameter-catalog",
        "parameter-count": "parameter-count"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "sensitivity-method-selector",
      "inputs": {
        "parameter-catalog": "step_1.parameter-catalog",
        "computational-budget": "from_context.computational-budget"
      },
      "outputs": {
        "selected-sa-method": "selected-sa-method",
        "sample-design": "sample-design"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "parameter-range-definer",
      "inputs": {
        "parameter-catalog": "step_1.parameter-catalog",
        "selected-sa-method": "step_2.selected-sa-method"
      },
      "outputs": {
        "parameter-distributions": "parameter-distributions",
        "sample-matrix": "sample-matrix"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "sensitivity-runner",
      "inputs": {
        "sample-matrix": "step_3.sample-matrix",
        "model-description": "from_context.model-description"
      },
      "outputs": {
        "model-outputs": "model-outputs",
        "run-log": "run-log"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "parameter-influence-ranker",
      "inputs": {
        "model-outputs": "step_4.model-outputs",
        "sample-matrix": "step_3.sample-matrix",
        "selected-sa-method": "step_2.selected-sa-method"
      },
      "outputs": {
        "sensitivity-indices": "sensitivity-indices",
        "influence-ranking": "influence-ranking"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "interaction-effect-detector",
      "inputs": {
        "sensitivity-indices": "step_5.sensitivity-indices",
        "model-outputs": "step_4.model-outputs"
      },
      "outputs": {
        "interaction-pairs": "interaction-pairs",
        "interaction-plots": "interaction-plots"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "sensitivity-report-writer",
      "inputs": {
        "influence-ranking": "step_5.influence-ranking",
        "interaction-pairs": "step_6.interaction-pairs",
        "run-log": "step_4.run-log"
      },
      "outputs": {
        "sensitivity-report": "sensitivity-report",
        "sensitivity-figures": "sensitivity-figures"
      },
      "parallel_group": 7
    }
  ],
