{
  "name": "constraint-based-allocator",
  "description": "Apply the Theory of Constraints to resource allocation. Find the bottleneck that limits the system's output. Allocate resources to exploit the bottleneck first, then subordinate everything else to it. Adding resources anywhere except the bottleneck is waste.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "bottleneck-identifier",
      "inputs": {
        "utilization-data": "from_user_input",
        "resource-catalog": "from_user_input"
      },
      "outputs": {
        "bottleneck-report": "bottleneck-report",
        "headroom-analysis": "headroom-analysis"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "bottleneck-exploiter",
      "inputs": {
        "bottleneck-identification": "from_context.bottleneck-identification",
        "system-flow-map": "from_context.system-flow-map"
      },
      "outputs": {
        "exploitation-plan": "exploitation-plan",
        "expected-throughput-gain": "expected-throughput-gain"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "system-subordinator",
      "inputs": {
        "exploitation-plan": "step_2.exploitation-plan",
        "system-flow-map": "from_context.system-flow-map"
      },
      "outputs": {
        "subordination-rules": "subordination-rules",
        "resource-liberation": "resource-liberation"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "bottleneck-elevator",
      "inputs": {
        "exploitation-plan": "step_2.exploitation-plan",
        "subordination-rules": "step_3.subordination-rules"
      },
      "outputs": {
        "elevation-options": "elevation-options",
        "elevation-decision": "elevation-decision"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "constraint-cycle-tracker",
      "inputs": {
        "elevation-decision": "step_4.elevation-decision",
        "system-flow-map": "from_context.system-flow-map"
      },
      "outputs": {
        "constraint-cycle-log": "constraint-cycle-log",
        "current-bottleneck-report": "current-bottleneck-report"
      },
      "parallel_group": 5
    }
  ],
