      },
      "outputs": {
        "mechanism-comparison": "mechanism-comparison",
        "best-mechanism": "best-mechanism"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "kinetics-model-report",
      "inputs": {
        "best-mechanism": "step_6.best-mechanism",
        "mechanism-comparison": "step_6.mechanism-comparison",
        "sensitivity-coefficients": "step_5.sensitivity-coefficients"
      },
      "outputs": {
        "kinetics-report": "kinetics-report",
        "model-files": "model-files"
      },
      "parallel_group": 7
    }
  ],
