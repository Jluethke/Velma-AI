{
  "name": "chemical-kinetics-modeling",
  "description": "Model a chemical reaction system: write rate equations, estimate rate constants, integrate numerically, validate against measurements, test sensitivity, and produce the report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "kinetics-rate-equation-writer",
      "inputs": {
        "reaction-mechanism": "from_user_input",
        "species-list": "from_user_input"
      },
      "outputs": {
        "ode-system": "ode-system",
        "parameter-list": "parameter-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "kinetics-constant-estimator",
      "inputs": {
        "ode-system": "step_1.ode-system",
        "experimental-data": "from_context.experimental-data"
      },
      "outputs": {
        "estimated-constants": "estimated-constants",
        "fit-quality": "fit-quality"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "kinetics-ode-integrator",
      "inputs": {
        "ode-system": "step_1.ode-system",
        "estimated-constants": "step_2.estimated-constants",
        "initial-conditions": "from_context.initial-conditions"
      },
      "outputs": {
        "concentration-profiles": "concentration-profiles",
        "integration-diagnostics": "integration-diagnostics"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "kinetics-profile-validator",
      "inputs": {
