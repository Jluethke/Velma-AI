      },
      "outputs": {
        "validation-results": "validation-results",
        "model-adequacy-verdict": "model-adequacy-verdict"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "kinetics-sensitivity-analyzer",
      "inputs": {
        "ode-system": "step_1.ode-system",
        "estimated-constants": "step_2.estimated-constants"
      },
      "outputs": {
        "sensitivity-coefficients": "sensitivity-coefficients",
        "parameter-ranking": "parameter-ranking"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "kinetics-mechanism-tester",
      "inputs": {
        "validation-results": "step_4.validation-results",
