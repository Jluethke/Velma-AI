      "skill_name": "brief-revision-and-approval",
      "inputs": {
        "draft-brief": "step_2.draft-brief",
        "consolidated-feedback": "step_3.consolidated-feedback"
      },
      "outputs": {
        "approved-brief": "approved-brief",
        "approval-record": "approval-record"
