        "requestor-context": "from_user_input"
      },
      "outputs": {
        "intake-summary": "intake-summary",
        "clarification-log": "clarification-log"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "creative-brief-drafting",
      "inputs": {
        "intake-summary": "step_1.intake-summary",
        "brand-guidelines": "from_context.brand-guidelines"
