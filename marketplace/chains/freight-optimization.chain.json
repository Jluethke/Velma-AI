{
  "name": "freight-optimization",
  "description": "Optimize freight shipping from shipment data collection through carrier selection to delivery tracking.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "shipment-data-collector",
      "inputs": {
        "shipment-list": "from_user_input",
        "delivery-deadlines": "from_user_input"
      },
      "outputs": {
        "shipment-profiles": "shipment-profiles",
        "constraint-summary": "constraint-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "carrier-rate-evaluator",
      "inputs": {
        "shipment-profiles": "step_1.shipment-profiles",
        "constraint-summary": "step_1.constraint-summary"
      },
      "outputs": {
        "carrier-comparison": "carrier-comparison",
        "mode-recommendations": "mode-recommendations"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "shipment-consolidator",
      "inputs": {
        "shipment-profiles": "step_1.shipment-profiles",
        "mode-recommendations": "step_2.mode-recommendations"
      },
      "outputs": {
        "consolidated-plan": "consolidated-plan",
        "savings-estimate": "savings-estimate"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "carrier-booking-agent",
      "inputs": {
        "consolidated-plan": "step_3.consolidated-plan",
        "carrier-comparison": "step_2.carrier-comparison"
      },
      "outputs": {
        "booking-confirmations": "booking-confirmations",
        "pickup-schedule": "pickup-schedule"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "delivery-tracker",
      "inputs": {
        "booking-confirmations": "step_4.booking-confirmations",
        "pickup-schedule": "step_4.pickup-schedule"
      },
      "outputs": {
        "delivery-status-report": "delivery-status-report",
        "exception-log": "exception-log"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "freight-optimization-reporter",
      "inputs": {
        "delivery-status-report": "step_5.delivery-status-report",
        "savings-estimate": "step_3.savings-estimate"
      },
      "outputs": {
        "freight-report": "freight-report",
        "improvement-recommendations": "improvement-recommendations"
      },
      "parallel_group": 6
    }
