{
  "name": "home-maintenance-calendar",
  "description": "Build a seasonal home maintenance calendar with checklists, contractor vetting, repair budgeting, and warranty tracking.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "home-systems-inventory",
      "inputs": {
        "home_age": "from_user_input",
        "home_type": "from_user_input",
        "known_systems": "from_user_input"
      },
      "outputs": {
        "systems_inventory": "systems_inventory",
        "replacement_timeline": "replacement_timeline",
        "warranty_status": "warranty_status"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "seasonal-maintenance-checklist",
      "inputs": {
        "systems_inventory": "step_1.systems_inventory",
        "climate_zone": "from_context.climate_zone",
        "home_type": "from_context.home_type"
      },
      "outputs": {
        "spring_checklist": "spring_checklist",
        "summer_checklist": "summer_checklist",
        "fall_checklist": "fall_checklist",
        "winter_checklist": "winter_checklist"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "contractor-vetting-system",
      "inputs": {
        "repair_needs": "from_context.repair_needs",
        "location": "from_context.location"
      },
      "outputs": {
        "contractor_checklist": "contractor_checklist",
        "bid_comparison_template": "bid_comparison_template",
        "red_flags": "red_flags"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "home-repair-budget",
      "inputs": {
        "home_value": "from_context.home_value",
        "systems_inventory": "step_1.systems_inventory",
        "replacement_timeline": "step_1.replacement_timeline"
      },
      "outputs": {
        "annual_budget": "annual_budget",
        "reserve_fund_target": "reserve_fund_target",
        "major_expense_timeline": "major_expense_timeline"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "warranty-and-appliance-tracker",
      "inputs": {
        "systems_inventory": "step_1.systems_inventory",
        "warranty_status": "step_1.warranty_status"
