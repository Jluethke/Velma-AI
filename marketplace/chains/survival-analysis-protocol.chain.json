{
  "name": "survival-analysis-protocol",
  "description": "Analyze time-to-event data: prepare the dataset with censoring indicators, estimate survival curves, compare groups, fit regression models, check assumptions, and report results.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "survival-data-preparer",
      "inputs": {
        "raw-dataset": "from_user_input",
        "study-design": "from_user_input"
      },
      "outputs": {
        "survival-dataset": "survival-dataset",
        "censoring-summary": "censoring-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "kaplan-meier-estimator",
      "inputs": {
        "survival-dataset": "step_1.survival-dataset",
        "confidence-level": "from_context.confidence-level"
      },
      "outputs": {
        "km-curves": "km-curves",
        "km-summary": "km-summary"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "logrank-test-runner",
      "inputs": {
        "survival-dataset": "step_1.survival-dataset",
        "test-variant": "from_context.test-variant"
      },
      "outputs": {
        "logrank-result": "logrank-result",
        "hazard-ratio-estimate": "hazard-ratio-estimate"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cox-model-fitter",
      "inputs": {
        "survival-dataset": "step_1.survival-dataset",
        "covariate-list": "from_context.covariate-list"
      },
      "outputs": {
        "cox-model": "cox-model",
        "cox-summary": "cox-summary"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "proportional-hazards-checker",
      "inputs": {
        "cox-model": "step_4.cox-model",
        "survival-dataset": "step_1.survival-dataset"
      },
      "outputs": {
        "ph-test-results": "ph-test-results",
        "diagnostic-plots": "diagnostic-plots"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "survival-report-writer",
      "inputs": {
        "km-estimates": "from_context.km-estimates",
        "prognostic-factors": "from_context.prognostic-factors",
        "diagnostic-plots": "step_5.diagnostic-plots"
      },
      "outputs": {
        "survival-report": "survival-report",
        "survival-figures": "survival-figures"
      },
      "parallel_group": 6
    }
  ],
