{
  "name": "big-decision",
  "description": "Any major life decision  --  buying a house, moving cities, changing careers, getting married, having kids, going back to school. Full decision framework: compare options, weigh pros/cons, assess risks, build a checklist for the winning path.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "comparison-matrix",
      "inputs": {
        "options": "from_user_input",
        "criteria": "from_user_input",
        "context": "from_user_input",
        "dealbreakers": "from_user_input"
      },
      "outputs": {
        "comparison_matrix": "comparison_matrix",
        "ranking": "ranking",
        "tradeoff_summary": "tradeoff_summary",
        "recommendation": "recommendation",
        "sensitivity_flags": "sensitivity_flags"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "pros-cons-analyzer",
      "inputs": {
        "proposed_action": "from_context.proposed_action",
        "context": "from_context.context",
        "stakeholders": "from_context.stakeholders",
        "risk_tolerance": "from_context.risk_tolerance"
      },
      "outputs": {
        "pros": "pros",
        "cons": "cons",
        "hidden_factors": "hidden_factors",
        "recommendation": "recommendation",
        "reversibility_assessment": "reversibility_assessment"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "risk-assessor",
      "inputs": {
        "plan_description": "from_context.plan_description",
        "plan_type": "from_context.plan_type",
        "stakeholders": "from_context.stakeholders",
        "time_horizon": "from_context.time_horizon",
        "risk_appetite": "from_context.risk_appetite",
        "known_risks": "from_context.known_risks"
      },
      "outputs": {
        "risk_register": "risk_register",
        "risk_matrix": "risk_matrix",
        "top_risks": "top_risks",
        "monitoring_plan": "monitoring_plan",
        "hidden_risks": "hidden_risks"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "checklist-builder",
      "inputs": {
        "goal_or_event": "from_context.goal_or_event",
        "deadline": "from_context.deadline",
        "constraints": "from_context.constraints",
        "experience_level": "from_context.experience_level"
      },
      "outputs": {
        "checklist": "checklist",
        "timeline": "timeline",
        "dont_forget": "dont_forget",
        "dependencies": "dependencies"
      },
      "parallel_group": 4
    }
  ],
