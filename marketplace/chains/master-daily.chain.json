{
  "name": "master-daily",
  "description": "Master daily chain. Morning: home status + market brief + pre-drive check run in parallel, then morning brief aggregates them. Evening: drive analysis + workout log + home status run in parallel, then weekly scorecard compiles. The full day loop.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "home-status",
      "inputs": {
        "devices": "from_user_input",
        "schedule": "from_user_input",
        "preferences": "from_user_input",
        "recent_alerts": "from_user_input"
      },
      "outputs": {
        "status_board": "status_board",
        "anomalies": "anomalies",
        "action_items": "action_items",
        "efficiency_note": "efficiency_note"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "market-brief",
      "inputs": {
        "interests": "from_context.interests",
        "portfolio_context": "from_context.portfolio_context",
        "period": "from_context.period"
      },
      "outputs": {
        "index_summary": "index_summary",
        "sector_rotation": "sector_rotation",
        "notable_events": "notable_events",
        "crypto_overview": "crypto_overview",
        "relevance_notes": "relevance_notes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "pre-drive-check",
      "inputs": {
        "vehicle": "from_context.vehicle",
        "trip_type": "from_context.trip_type",
        "weather": "from_context.weather"
      },
      "outputs": {
        "readiness_status": "readiness_status",
        "safety_checks": "safety_checks",
        "fluid_levels": "fluid_levels",
        "tire_status": "tire_status",
        "go_no_go": "go_no_go"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "morning-brief",
      "inputs": {
        "location:string": "from_context.location:string",
        "commute_distance_miles:number": "from_context.commute_distance_miles:number",
        "calendar_source:string": "from_context.calendar_source:string"
      },
      "outputs": {
        "briefing:object": "briefing:object",
        "action_items:array": "action_items:array",
        "alert_level:string": "alert_level:string"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "drive-analysis",
      "inputs": {
        "trip_log": "from_context.trip_log",
        "vehicle": "from_context.vehicle",
        "driver_profile": "from_context.driver_profile"
      },
      "outputs": {
        "speed_profile": "speed_profile",
        "braking_events": "braking_events",
        "fuel_estimate": "fuel_estimate",
        "fault_log": "fault_log",
        "drive_score": "drive_score"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "workout-log",
      "inputs": {
        "exercise_data": "from_context.exercise_data",
        "body_metrics": "from_context.body_metrics",
        "goals": "from_context.goals"
      },
      "outputs": {
        "workout_record": "workout_record",
        "weekly_volume": "weekly_volume",
        "progressive_overload_check": "progressive_overload_check",
        "recovery_signal": "recovery_signal"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "home-status",
      "inputs": {
        "devices": "from_context.devices",
        "schedule": "from_context.schedule",
        "preferences": "from_context.preferences",
        "recent_alerts": "from_context.recent_alerts"
      },
      "outputs": {
        "status_board": "status_board",
        "anomalies": "anomalies",
        "action_items": "action_items",
        "efficiency_note": "efficiency_note"
      },
      "parallel_group": 7
    },
    {
      "id": "step_8",
      "skill_name": "budget-builder",
      "inputs": {
        "income": "from_context.income",
        "fixed_expenses": "from_context.fixed_expenses",
        "variable_spending": "from_context.variable_spending",
        "financial_situation": "from_context.financial_situation",
        "goals": "from_context.goals"
      },
      "outputs": {
        "spending_snapshot": "spending_snapshot",
        "monthly_budget": "monthly_budget",
        "bleed_points": "bleed_points",
        "action_plan": "action_plan",
        "monthly_checkup": "monthly_checkup"
      },
      "parallel_group": 8
    },
    {
      "id": "step_9",
      "skill_name": "weekly-scorecard",
