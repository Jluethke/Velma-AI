{
  "name": "api-security-assessment",
  "description": "Assess the security of a REST or GraphQL API covering authentication, authorization, rate limiting, input validation, and information disclosure.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "api-endpoint-inventory",
      "inputs": {
        "api-specification": "from_user_input",
        "api-base-url": "from_user_input"
      },
      "outputs": {
        "endpoint-map": "endpoint-map",
        "auth-requirements": "auth-requirements"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "api-auth-mechanism-testing",
      "inputs": {
        "endpoint-map": "step_1.endpoint-map",
        "auth-requirements": "step_1.auth-requirements"
      },
      "outputs": {
        "auth-weaknesses": "auth-weaknesses",
        "token-analysis": "token-analysis"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "api-authorization-testing",
      "inputs": {
        "endpoint-map": "step_1.endpoint-map",
        "auth-weaknesses": "step_2.auth-weaknesses"
      },
      "outputs": {
        "authorization-findings": "authorization-findings",
        "idor-evidence": "idor-evidence"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "api-rate-limit-testing",
      "inputs": {
        "endpoint-map": "step_1.endpoint-map",
        "authorization-findings": "step_3.authorization-findings"
      },
      "outputs": {
        "rate-limit-findings": "rate-limit-findings",
        "abuse-scenarios": "abuse-scenarios"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "api-input-validation-testing",
      "inputs": {
        "endpoint-map": "step_1.endpoint-map",
        "rate-limit-findings": "step_4.rate-limit-findings"
      },
      "outputs": {
        "input-validation-findings": "input-validation-findings",
        "serialization-findings": "serialization-findings"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "api-error-disclosure-check",
      "inputs": {
        "input-validation-findings": "step_5.input-validation-findings",
        "endpoint-map": "step_1.endpoint-map"
      },
      "outputs": {
        "disclosure-findings": "disclosure-findings",
        "exposed-internals": "exposed-internals"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "api-security-report",
      "inputs": {
        "authorization-findings": "step_3.authorization-findings",
        "input-validation-findings": "step_5.input-validation-findings",
        "disclosure-findings": "step_6.disclosure-findings"
      },
      "outputs": {
        "api-security-report": "api-security-report",
        "remediation-checklist": "remediation-checklist"
      },
      "parallel_group": 7
    }
  ],
