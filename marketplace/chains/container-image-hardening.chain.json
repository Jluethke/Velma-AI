        "image-justification": "image-justification"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "dockerfile-hardener",
      "inputs": {
        "selected-base-image": "step_1.selected-base-image",
        "application-requirements": "from_context.application-requirements"
      },
      "outputs": {
