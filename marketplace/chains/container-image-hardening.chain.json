      },
      "outputs": {
        "runtime-config": "runtime-config",
        "security-context": "security-context"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "container-image-signer",
      "inputs": {
        "hardened-dockerfile": "step_2.hardened-dockerfile",
        "runtime-config": "step_4.runtime-config"
      },
      "outputs": {
        "signed-image-reference": "signed-image-reference",
        "signing-verification-instructions": "signing-verification-instructions"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "container-hardening-documenter",
      "inputs": {
