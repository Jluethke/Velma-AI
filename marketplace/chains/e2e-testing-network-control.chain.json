      }
    },
    {
      "from_step": "s02_e2e_mock_vs_real_decide",
      "to_step": "s04_e2e_cypress_intercept",
      "data_type": "e2e-mock-vs-real-decide",
      "field_mapping": {
        "backend_plan": "backend_plan"
      }
    }
  ],
  "entry_inputs": [
