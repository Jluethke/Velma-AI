{
  "name": "team-skill-gap-analysis",
  "description": "Map the skills the work requires against who actually has them. Any skill held by only one person at a competent level is a single point of failure; any skill held by no one is a gap. Cross-train the single points of failure, and hire, train, or contract for the gaps.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "work-driven-skill-lister",
      "inputs": {
        "team-scope": "from_user_input",
        "recent-work-log": "from_user_input"
      },
      "outputs": {
        "required-skill-list": "required-skill-list",
        "skill-categories": "skill-categories"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "skill-coverage-mapper",
      "inputs": {
        "required-skill-list": "step_1.required-skill-list",
        "skill-categories": "step_1.skill-categories"
      },
      "outputs": {
        "coverage-matrix": "coverage-matrix",
        "confidence-notes": "confidence-notes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "single-point-of-failure-detector",
      "inputs": {
        "coverage-matrix": "step_2.coverage-matrix",
        "confidence-notes": "step_2.confidence-notes"
      },
      "outputs": {
        "single-point-list": "single-point-list",
        "spof-impact-ranking": "spof-impact-ranking"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "zero-coverage-gap-finder",
      "inputs": {
        "single-point-list": "step_3.single-point-list",
        "spof-impact-ranking": "step_3.spof-impact-ranking"
      },
      "outputs": {
        "gap-list": "gap-list",
        "gap-impact-ranking": "gap-impact-ranking"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "cross-train-vs-hire-decider",
      "inputs": {
        "gap-list": "step_4.gap-list",
        "gap-impact-ranking": "step_4.gap-impact-ranking"
      },
      "outputs": {
        "remediation-decisions": "remediation-decisions",
        "decision-rationale": "decision-rationale"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "coverage-remediation-planner",
      "inputs": {
        "remediation-decisions": "step_5.remediation-decisions",
        "decision-rationale": "step_5.decision-rationale"
      },
      "outputs": {
        "remediation-plan": "remediation-plan",
        "review-cadence": "review-cadence"
      },
      "parallel_group": 6
    }
  ],
