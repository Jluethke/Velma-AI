{
  "name": "email-server-hardening",
  "description": "Harden an email server by configuring authentication protocols, encryption, and anti-abuse controls.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "email-spf-dkim-dmarc-configurator",
      "inputs": {
        "domain-name": "from_user_input",
        "mail-server-ip": "from_user_input"
      },
      "outputs": {
        "dns-records": "dns-records",
        "dkim-keys": "dkim-keys"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "email-tls-enabler",
      "inputs": {
        "domain-name": "from_context.domain-name",
        "dns-records": "step_1.dns-records"
      },
      "outputs": {
        "tls-config": "tls-config",
        "mta-sts-policy": "mta-sts-policy"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "email-relay-disabler",
      "inputs": {
        "mail-server-ip": "from_context.mail-server-ip",
        "tls-config": "step_2.tls-config"
      },
      "outputs": {
        "relay-config": "relay-config",
        "relay-test-results": "relay-test-results"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "email-antispam-configurator",
      "inputs": {
        "domain-name": "from_context.domain-name",
        "relay-config": "step_3.relay-config"
      },
      "outputs": {
        "antispam-config": "antispam-config",
        "filter-test-results": "filter-test-results"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "email-message-limit-setter",
      "inputs": {
        "domain-name": "from_context.domain-name",
        "antispam-config": "step_4.antispam-config"
      },
      "outputs": {
        "limit-config": "limit-config",
        "limit-test-results": "limit-test-results"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "email-auth-configurator",
      "inputs": {
        "domain-name": "from_context.domain-name",
        "tls-config": "step_2.tls-config"
      },
      "outputs": {
        "auth-config": "auth-config",
        "auth-test-results": "auth-test-results"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "email-server-hardening-reporter",
      "inputs": {
        "domain-name": "from_context.domain-name",
        "dns-records": "step_1.dns-records"
      },
      "outputs": {
        "hardening-report": "hardening-report",
        "compliance-summary": "compliance-summary"
      },
      "parallel_group": 7
    }
  ],
