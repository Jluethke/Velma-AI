{
  "name": "thermal-analysis-protocol",
  "description": "Analyze thermal properties of a material: prepare samples, run DSC, TGA, and DMA measurements, interpret transitions, compare against references, and produce the thermal analysis report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "thermal-sample-prep",
      "inputs": {
        "material-description": "from_user_input",
        "analysis-objectives": "from_user_input"
      },
      "outputs": {
        "sample-prep-protocol": "sample-prep-protocol",
        "instrument-queue": "instrument-queue"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "dsc-measurement-run",
      "inputs": {
        "sample-prep-protocol": "step_1.sample-prep-protocol",
        "instrument-queue": "step_1.instrument-queue"
      },
      "outputs": {
        "dsc-thermogram": "dsc-thermogram",
        "dsc-parameters": "dsc-parameters"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "tga-measurement-run",
      "inputs": {
        "sample-prep-protocol": "step_1.sample-prep-protocol",
        "instrument-queue": "step_1.instrument-queue"
      },
      "outputs": {
        "tga-curve": "tga-curve",
        "tga-parameters": "tga-parameters"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "dma-measurement-run",
      "inputs": {
        "sample-prep-protocol": "step_1.sample-prep-protocol",
        "dsc-parameters": "step_2.dsc-parameters"
      },
      "outputs": {
        "dma-curves": "dma-curves",
        "dma-parameters": "dma-parameters"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "thermal-transition-interpreter",
      "inputs": {
        "dsc-parameters": "step_2.dsc-parameters",
        "tga-parameters": "step_3.tga-parameters",
        "dma-parameters": "step_4.dma-parameters"
      },
      "outputs": {
        "thermal-profile": "thermal-profile",
        "discrepancy-notes": "discrepancy-notes"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "thermal-reference-comparison",
      "inputs": {
        "thermal-profile": "step_5.thermal-profile",
        "material-description": "from_context.material-description"
      },
      "outputs": {
        "reference-comparison-table": "reference-comparison-table",
        "conformance-assessment": "conformance-assessment"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "thermal-analysis-report-writer",
      "inputs": {
        "thermal-profile": "step_5.thermal-profile",
        "reference-comparison-table": "step_6.reference-comparison-table",
        "discrepancy-notes": "step_5.discrepancy-notes"
      },
      "outputs": {
        "thermal-analysis-report": "thermal-analysis-report",
        "data-archive-package": "data-archive-package"
      },
      "parallel_group": 7
    }
  ],
