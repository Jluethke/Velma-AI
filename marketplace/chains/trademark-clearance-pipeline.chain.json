    },
    {
      "from_step": "step_3",
      "to_step": "step_4",
      "data_type": "tmview_eu_matches",
      "field_mapping": "tmview_eu_matches -> input"
    },
    {
      "from_step": "step_4",
      "to_step": "step_5",
      "data_type": "mark_similarity_scored",
      "field_mapping": "mark_similarity_scored -> exact_matches; mark_similarity_scored -> phonetic_neighbors; mark_similarity_scored -> visual_similarities; mark_similarity_scored -> common_law_conflict_candidates; mark_similarity_scored -> international_conflict_candidates; likelihood_of_confusion_rating -> likelihood_of_confusion_rating; dupont_factor_table -> dupont_factor_table; mark_similarity_scored -> proposed_mark; mark_similarity_scored -> proposed_goods_services"
    }
  ],
