    "include_dead_marks",
    "include_social_handles",
    "jurisdictions_required",
    "mark_variants",
    "proposed_mark",
    "target_jurisdictions",
    "trademark_classes"
  ],
  "terminal_outputs": [
    "overall_risk_level",
    "per_conflict_risk_breakdown",
    "action_recommendations",
    "attorney_review_flags",
    "clearance_opinion_brief",
    "filing_strategy_notes"
  ],
  "parallel_groups": [
