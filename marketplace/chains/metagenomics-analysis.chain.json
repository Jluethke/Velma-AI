{
  "name": "metagenomics-analysis",
  "description": "Analyze a metagenomic dataset from raw reads through taxonomy, diversity, and functional profiling.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "metagenomic-read-qc",
      "inputs": {
        "raw-reads": "from_user_input",
        "host-reference": "from_user_input"
      },
      "outputs": {
        "filtered-reads": "filtered-reads",
        "qc-report": "qc-report"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "metagenomic-taxonomy-assigner",
      "inputs": {
        "filtered-reads": "step_1.filtered-reads",
        "taxonomy-database": "from_context.taxonomy-database"
      },
      "outputs": {
        "taxonomy-table": "taxonomy-table",
        "classification-summary": "classification-summary"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "diversity-metrics-calculator",
      "inputs": {
        "taxonomy-table": "step_2.taxonomy-table",
        "sample-metadata": "from_context.sample-metadata"
      },
      "outputs": {
        "alpha-diversity": "alpha-diversity",
        "beta-diversity-matrix": "beta-diversity-matrix"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "differential-abundance-tester",
      "inputs": {
        "taxonomy-table": "step_2.taxonomy-table",
        "sample-metadata": "from_context.sample-metadata"
      },
      "outputs": {
        "differential-taxa-list": "differential-taxa-list",
        "abundance-plots": "abundance-plots"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "functional-potential-predictor",
      "inputs": {
        "taxonomy-table": "step_2.taxonomy-table",
        "filtered-reads": "step_1.filtered-reads"
      },
      "outputs": {
        "pathway-abundance-table": "pathway-abundance-table",
        "functional-summary": "functional-summary"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "metagenomics-report-compiler",
      "inputs": {
        "alpha-diversity": "step_3.alpha-diversity",
        "differential-taxa-list": "step_4.differential-taxa-list",
        "functional-summary": "step_5.functional-summary"
      },
      "outputs": {
        "metagenomics-report": "metagenomics-report",
        "supplementary-tables": "supplementary-tables"
      },
      "parallel_group": 6
    }
  ],
