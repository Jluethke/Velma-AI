{
  "name": "fluorescence-spectroscopy-analysis",
  "description": "Analyze fluorescence spectroscopy data from raw spectra through quantum yield calculation, decay fitting, and FRET analysis to a fluorescence report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "fluorescence-spectrum-acquirer",
      "inputs": {
        "raw-spectra-files": "from_user_input",
        "sample-identifiers": "from_user_input"
      },
      "outputs": {
        "excitation-spectra": "excitation-spectra",
        "emission-spectra": "emission-spectra"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "fluorescence-instrument-corrector",
      "inputs": {
        "emission-spectra": "step_1.emission-spectra",
        "instrument-response-function": "from_context.instrument-response-function"
      },
      "outputs": {
        "corrected-emission": "corrected-emission",
        "correction-factors": "correction-factors"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "fluorescence-quantum-yield-calculator",
      "inputs": {
        "corrected-emission": "step_2.corrected-emission",
        "absorbance-values": "from_context.absorbance-values"
      },
      "outputs": {
        "quantum-yield": "quantum-yield",
        "calculation-details": "calculation-details"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "fluorescence-decay-fitter",
      "inputs": {
        "decay-curves": "from_context.decay-curves",
        "instrument-response-function": "from_context.instrument-response-function"
      },
      "outputs": {
        "lifetime-fit-results": "lifetime-fit-results",
        "residuals": "residuals"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "fluorescence-fret-analyzer",
      "inputs": {
        "corrected-emission": "step_2.corrected-emission",
        "lifetime-fit-results": "step_4.lifetime-fit-results"
      },
      "outputs": {
        "fret-efficiency": "fret-efficiency",
        "distance-estimate": "distance-estimate"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "fluorescence-report-generator",
      "inputs": {
        "quantum-yield": "step_3.quantum-yield",
        "lifetime-fit-results": "step_4.lifetime-fit-results",
        "fret-efficiency": "step_5.fret-efficiency"
      },
      "outputs": {
        "fluorescence-report": "fluorescence-report",
        "data-tables": "data-tables"
      },
      "parallel_group": 6
    }
  ],
