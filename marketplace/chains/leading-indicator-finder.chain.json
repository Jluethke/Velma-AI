{
  "name": "leading-indicator-finder",
  "description": "Find the metrics that predict outcomes (leading indicators) instead of the ones that only record them (lagging indicators). For any goal, work backward from the outcome to the behavior that produces it, then to the measurable signal that precedes the behavior. That signal is your leading indicator.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "outcome-goal-definition",
      "inputs": {
        "goal-description": "from_user_input",
        "current-baseline": "from_user_input"
      },
      "outputs": {
        "defined-outcome": "defined-outcome",
        "lagging-metric": "lagging-metric"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "outcome-driver-decomposition",
      "inputs": {
        "defined-outcome": "step_1.defined-outcome",
        "lagging-metric": "step_1.lagging-metric"
      },
      "outputs": {
        "driver-tree": "driver-tree",
        "driver-levels": "driver-levels"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "leading-signal-identification",
      "inputs": {
        "driver-tree": "step_2.driver-tree",
        "driver-levels": "step_2.driver-levels"
      },
      "outputs": {
        "candidate-leading-indicators": "candidate-leading-indicators",
        "lead-time-estimates": "lead-time-estimates"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "predictive-validity-test",
      "inputs": {
        "candidate-leading-indicators": "step_3.candidate-leading-indicators",
        "current-baseline": "from_context.current-baseline"
      },
      "outputs": {
        "validated-indicators": "validated-indicators",
        "rejected-indicators": "rejected-indicators"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "indicator-cadence-assignment",
      "inputs": {
        "validated-indicators": "step_4.validated-indicators",
        "lagging-metric": "step_1.lagging-metric"
      },
      "outputs": {
        "indicator-schedule": "indicator-schedule",
        "review-cadence": "review-cadence"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "response-protocol-builder",
      "inputs": {
        "indicator-schedule": "step_5.indicator-schedule",
        "defined-outcome": "step_1.defined-outcome"
      },
      "outputs": {
        "response-protocols": "response-protocols",
        "leading-indicator-system": "leading-indicator-system"
      },
      "parallel_group": 6
    }
  ],
