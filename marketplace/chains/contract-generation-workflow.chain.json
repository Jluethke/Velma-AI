{
  "name": "contract-generation-workflow",
  "description": "Generate contracts from templates, route for review, and collect signatures.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "contract-template-selector",
      "inputs": {
        "deal-type": "from_user_input",
