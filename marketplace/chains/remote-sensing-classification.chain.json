      "skill_name": "rs-training-sampler",
      "inputs": {
        "corrected-imagery": "step_1.corrected-imagery",
        "class-definitions": "from_context.class-definitions"
      },
      "outputs": {
        "training-samples": "training-samples",
        "validation-samples": "validation-samples"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "rs-feature-selector",
      "inputs": {
        "corrected-imagery": "step_1.corrected-imagery",
        "training-samples": "step_2.training-samples"
      },
      "outputs": {
        "selected-features": "selected-features",
        "feature-space-visualization": "feature-space-visualization"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "rs-classifier-trainer",
      "inputs": {
        "selected-features": "step_3.selected-features",
        "training-samples": "step_2.training-samples"
      },
      "outputs": {
        "trained-classifier": "trained-classifier",
        "training-accuracy": "training-accuracy"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "rs-confusion-matrix-validator",
      "inputs": {
        "trained-classifier": "step_4.trained-classifier",
        "validation-samples": "step_2.validation-samples"
      },
      "outputs": {
        "confusion-matrix": "confusion-matrix",
        "accuracy-metrics": "accuracy-metrics"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "rs-classified-map-producer",
      "inputs": {
        "trained-classifier": "step_4.trained-classifier",
        "corrected-imagery": "step_1.corrected-imagery",
