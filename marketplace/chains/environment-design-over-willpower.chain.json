{
  "name": "environment-design-over-willpower",
  "description": "Redesign your environment so the behavior you want is the default and the behavior you want to drop takes effort. Willpower depletes across a day, so reduce friction for what you want to increase and stack three or four friction points against what you want to decrease.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "target-behavior-pair-definition",
      "inputs": {
        "behavior-to-increase": "from_user_input",
        "behavior-to-decrease": "from_user_input"
      },
      "outputs": {
        "defined-increase-target": "defined-increase-target",
        "defined-decrease-target": "defined-decrease-target"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "current-friction-count",
      "inputs": {
        "defined-increase-target": "step_1.defined-increase-target",
        "defined-decrease-target": "step_1.defined-decrease-target"
      },
      "outputs": {
        "increase-friction-points": "increase-friction-points",
        "decrease-friction-points": "decrease-friction-points"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "friction-removal-design",
      "inputs": {
        "increase-friction-points": "step_2.increase-friction-points",
        "defined-increase-target": "step_1.defined-increase-target"
      },
      "outputs": {
        "friction-removal-plan": "friction-removal-plan",
        "default-path-change": "default-path-change"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "friction-addition-stack",
      "inputs": {
        "decrease-friction-points": "step_2.decrease-friction-points",
        "defined-decrease-target": "step_1.defined-decrease-target"
      },
      "outputs": {
        "friction-addition-stack": "friction-addition-stack",
        "friction-point-count": "friction-point-count"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "one-session-reset-checklist",
      "inputs": {
        "friction-removal-plan": "step_3.friction-removal-plan",
        "friction-addition-stack": "step_4.friction-addition-stack"
      },
      "outputs": {
        "environment-reset-checklist": "environment-reset-checklist",
        "reset-completion-record": "reset-completion-record"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "friction-holding-review",
      "inputs": {
        "environment-reset-checklist": "step_5.environment-reset-checklist",
        "reset-completion-record": "step_5.reset-completion-record"
      },
      "outputs": {
        "behavior-shift-results": "behavior-shift-results",
        "friction-adjustment-list": "friction-adjustment-list"
      },
      "parallel_group": 6
    }
  ],
