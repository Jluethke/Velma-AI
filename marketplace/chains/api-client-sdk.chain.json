      "skill_name": "sdk-spec-spectral-lint",
      "inputs": {
        "spec_path": "from_user_input",
        "spectral_ruleset": "from_user_input_optional"
      },
      "outputs": {
        "lint_report": "lint_report",
        "validated_spec": "validated_spec"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_sdk_spec_sdk_readiness_rules",
      "skill_name": "sdk-spec-sdk-readiness-rules",
