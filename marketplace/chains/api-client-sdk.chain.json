        "project_dir": "from_user_input"
      },
      "outputs": {
        "py_client_package": "py_client_package"
      },
      "condition": "stack == 'python' && generation_plan.approach != 'handwritten'",
      "parallel_group": 5
    },
    {
      "id": "s07_sdk_ts_openapi_typescript",
      "skill_name": "sdk-ts-openapi-typescript",
      "inputs": {
        "validated_spec": "s01_sdk_spec_spectral_lint.validated_spec",
        "generation_plan": "s04_sdk_generator_decision.generation_plan",
