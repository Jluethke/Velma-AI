      "outputs": {
        "api_inventory": "api_inventory"
      },
      "parallel_group": 3
    },
    {
      "id": "s04_sdk_generator_decision",
      "skill_name": "sdk-generator-decision",
      "inputs": {
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "stack": "from_user_input",
        "sdk_constraints": "from_user_input_optional"
      },
      "outputs": {
        "generation_plan": "generation_plan"
      },
      "parallel_group": 4
    },
    {
      "id": "s05_sdk_model_type_mapping",
      "skill_name": "sdk-model-type-mapping",
      "inputs": {
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "validated_spec": "s01_sdk_spec_spectral_lint.validated_spec",
