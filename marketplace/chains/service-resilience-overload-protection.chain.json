{
  "name": "service-resilience-overload-protection",
  "description": "Protect a service from overload: measured latency, per-dependency bulkheads, token bucket or sliding window limits, nginx edge limits, and load shedding at the measured knee.",
  "steps": [
    {
      "id": "s01_res_dependency_map",
      "skill_name": "res-dependency-map",
      "inputs": {
        "service_repo": "from_user_input",
        "stack": "from_user_input",
        "trace_source": "from_user_input_optional"
      },
      "outputs": {
        "dependency_map": "dependency_map"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_res_latency_percentiles",
      "skill_name": "res-latency-percentiles",
      "inputs": {
        "dependency_map": "s01_res_dependency_map.dependency_map",
        "metrics_source": "from_user_input",
        "measurement_window": "from_user_input"
      },
      "outputs": {
        "latency_profile": "latency_profile"
      },
      "parallel_group": 2
    },
    {
      "id": "s03_res_bulkhead_partition",
      "skill_name": "res-bulkhead-partition",
      "inputs": {
        "service_repo": "from_user_input",
        "stack": "from_user_input",
        "dependency_map": "s01_res_dependency_map.dependency_map",
        "latency_profile": "s02_res_latency_percentiles.latency_profile"
      },
      "outputs": {
        "bulkhead_changes": "bulkhead_changes"
      },
      "parallel_group": 3
    },
    {
      "id": "s04_res_redis_token_bucket",
      "skill_name": "res-redis-token-bucket",
      "inputs": {
        "service_repo": "from_user_input",
        "rate_limit_spec": "from_user_input_optional",
        "redis_url": "from_user_input_optional"
      },
      "outputs": {
        "token_bucket_limiter": "token_bucket_limiter"
      },
      "condition": "rate_limit_spec.algorithm == 'token_bucket'",
      "parallel_group": 1
    },
    {
      "id": "s05_res_redis_sliding_window",
      "skill_name": "res-redis-sliding-window",
      "inputs": {
        "service_repo": "from_user_input",
        "rate_limit_spec": "from_user_input_optional",
        "redis_url": "from_user_input_optional"
      },
      "outputs": {
        "sliding_window_limiter": "sliding_window_limiter"
      },
      "condition": "rate_limit_spec.algorithm == 'sliding_window'",
      "parallel_group": 1
    },
    {
      "id": "s06_res_nginx_limit_req",
      "skill_name": "res-nginx-limit-req",
      "inputs": {
        "nginx_conf_path": "from_user_input_optional",
        "rate_limit_spec": "from_user_input_optional"
      },
      "outputs": {
        "edge_rate_limit_config": "edge_rate_limit_config"
      },
      "condition": "nginx_conf_path != null",
      "parallel_group": 1
    },
    {
      "id": "s07_res_load_shedding",
      "skill_name": "res-load-shedding",
      "inputs": {
        "service_repo": "from_user_input",
        "stack": "from_user_input",
        "latency_profile": "s02_res_latency_percentiles.latency_profile",
        "request_deadline_ms": "from_user_input"
      },
      "outputs": {
        "load_shed_changes": "load_shed_changes"
      },
      "parallel_group": 3
    }
  ],
  "edges": [
    {
      "from_step": "s01_res_dependency_map",
      "to_step": "s02_res_latency_percentiles",
      "data_type": "res-dependency-map",
      "field_mapping": {
        "dependency_map": "dependency_map"
      }
    },
    {
      "from_step": "s01_res_dependency_map",
      "to_step": "s03_res_bulkhead_partition",
      "data_type": "res-dependency-map",
      "field_mapping": {
        "dependency_map": "dependency_map"
      }
    },
    {
      "from_step": "s02_res_latency_percentiles",
      "to_step": "s03_res_bulkhead_partition",
      "data_type": "res-latency-percentiles",
      "field_mapping": {
        "latency_profile": "latency_profile"
      }
    },
    {
      "from_step": "s02_res_latency_percentiles",
      "to_step": "s07_res_load_shedding",
      "data_type": "res-latency-percentiles",
      "field_mapping": {
        "latency_profile": "latency_profile"
      }
    }
  ],
  "entry_inputs": [
    "service_repo",
    "stack",
    "trace_source",
    "metrics_source",
    "measurement_window",
    "rate_limit_spec",
    "redis_url",
    "nginx_conf_path",
    "request_deadline_ms"
  ],
  "terminal_outputs": [
    "bulkhead_changes",
    "token_bucket_limiter",
    "sliding_window_limiter",
    "edge_rate_limit_config",
    "load_shed_changes"
  ],
  "parallel_groups": [
    [
      "s01_res_dependency_map",
      "s04_res_redis_token_bucket",
      "s05_res_redis_sliding_window",
      "s06_res_nginx_limit_req"
    ],
    [
      "s02_res_latency_percentiles"
    ],
    [
      "s03_res_bulkhead_partition",
      "s07_res_load_shedding"
    ]
  ],
  "estimated_cost": 7,
  "critical_path": [
    "s01_res_dependency_map",
    "s02_res_latency_percentiles",
    "s03_res_bulkhead_partition"
  ]
}
