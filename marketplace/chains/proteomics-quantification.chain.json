{
  "name": "proteomics-quantification",
  "description": "Quantify proteins from mass spectrometry data: import raw files, search the database, filter by FDR, normalize, run differential expression, perform pathway enrichment, and produce the report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "proteomics-raw-importer",
      "inputs": {
        "raw-files": "from_user_input",
        "acquisition-metadata": "from_user_input"
      },
      "outputs": {
        "imported-spectra": "imported-spectra",
        "quality-summary": "quality-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "proteomics-database-search",
      "inputs": {
        "imported-spectra": "step_1.imported-spectra",
        "protein-database": "from_context.protein-database"
      },
      "outputs": {
        "peptide-spectrum-matches": "peptide-spectrum-matches",
        "search-parameters": "search-parameters"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "proteomics-fdr-filter",
      "inputs": {
        "peptide-spectrum-matches": "step_2.peptide-spectrum-matches",
        "fdr-threshold": "from_context.fdr-threshold"
      },
      "outputs": {
        "filtered-peptides": "filtered-peptides",
        "protein-groups": "protein-groups"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "proteomics-normalizer",
      "inputs": {
        "protein-groups": "step_3.protein-groups",
        "experimental-design": "from_context.experimental-design"
      },
      "outputs": {
        "normalized-abundances": "normalized-abundances",
        "normalization-report": "normalization-report"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "proteomics-differential-expression",
      "inputs": {
        "normalized-abundances": "step_4.normalized-abundances",
        "experimental-design": "from_context.experimental-design"
      },
      "outputs": {
        "de-results": "de-results",
        "volcano-plot-data": "volcano-plot-data"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "proteomics-pathway-enrichment",
      "inputs": {
        "de-results": "step_5.de-results",
        "pathway-database": "from_context.pathway-database"
      },
      "outputs": {
        "enrichment-results": "enrichment-results",
        "pathway-visualization": "pathway-visualization"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "proteomics-report-writer",
      "inputs": {
        "enrichment-results": "step_6.enrichment-results",
        "de-results": "step_5.de-results",
        "quality-summary": "step_1.quality-summary"
      },
      "outputs": {
        "proteomics-report": "proteomics-report",
        "supplementary-tables": "supplementary-tables"
      },
      "parallel_group": 7
    }
