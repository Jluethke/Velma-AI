{
  "name": "feature-impact-scoring",
  "description": "Score features by expected impact using ICE (Impact, Confidence, Ease) but weighted by the number of users affected AND frequency of use. A small improvement used daily beats a large improvement used yearly.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "feature-candidate-list",
      "inputs": {
        "feature-sources": "from_user_input",
        "current-roadmap": "from_user_input"
      },
      "outputs": {
        "feature-list": "feature-list",
        "feature-count": "feature-count"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "impact-score-with-frequency-weight",
      "inputs": {
        "feature-list": "step_1.feature-list",
        "current-roadmap": "from_context.current-roadmap"
      },
      "outputs": {
        "impact-scores": "impact-scores",
        "impact-rationale": "impact-rationale"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "confidence-and-ease-scoring",
      "inputs": {
        "impact-scores": "step_2.impact-scores",
        "feature-list": "step_1.feature-list"
      },
      "outputs": {
        "full-ice-scores": "full-ice-scores",
        "ice-ranking": "ice-ranking"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "prioritization-decision",
      "inputs": {
        "ice-ranking": "step_3.ice-ranking",
        "current-roadmap": "from_context.current-roadmap"
      },
      "outputs": {
        "prioritized-roadmap": "prioritized-roadmap",
        "deprioritized-list": "deprioritized-list"
      },
      "parallel_group": 4
    }
  ],
