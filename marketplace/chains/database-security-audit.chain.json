{
  "name": "database-security-audit",
  "description": "Audit database security covering access controls, privileges, encryption, credential strength, and audit logging.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "database-instance-inventory",
      "inputs": {
        "environment-scope": "from_user_input",
        "database-types": "from_user_input"
      },
      "outputs": {
        "database-inventory": "database-inventory",
        "patch-status": "patch-status"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "database-access-control-check",
      "inputs": {
        "database-inventory": "step_1.database-inventory",
        "patch-status": "step_1.patch-status"
      },
      "outputs": {
        "auth-control-findings": "auth-control-findings",
        "network-access-findings": "network-access-findings"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "database-privilege-review",
      "inputs": {
        "database-inventory": "step_1.database-inventory",
        "auth-control-findings": "step_2.auth-control-findings"
      },
      "outputs": {
        "privilege-findings": "privilege-findings",
        "role-hierarchy-map": "role-hierarchy-map"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "database-credential-testing",
      "inputs": {
        "database-inventory": "step_1.database-inventory",
        "privilege-findings": "step_3.privilege-findings"
      },
      "outputs": {
        "credential-findings": "credential-findings",
        "credential-reuse-map": "credential-reuse-map"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "database-encryption-audit",
      "inputs": {
        "database-inventory": "step_1.database-inventory",
        "credential-findings": "step_4.credential-findings"
      },
      "outputs": {
        "encryption-findings": "encryption-findings",
        "tls-configuration": "tls-configuration"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "database-audit-logging-review",
      "inputs": {
        "database-inventory": "step_1.database-inventory",
        "encryption-findings": "step_5.encryption-findings"
      },
      "outputs": {
        "audit-logging-findings": "audit-logging-findings",
        "log-retention-status": "log-retention-status"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "database-security-report",
      "inputs": {
        "privilege-findings": "step_3.privilege-findings",
        "encryption-findings": "step_5.encryption-findings",
        "audit-logging-findings": "step_6.audit-logging-findings"
      },
      "outputs": {
        "database-security-report": "database-security-report",
        "database-hardening-checklist": "database-hardening-checklist"
      },
      "parallel_group": 7
    }
  ],
