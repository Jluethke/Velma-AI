      },
      "outputs": {
        "scenario-models": "scenario-models",
        "sensitivity-results": "sensitivity-results"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "budget-consolidator",
      "inputs": {
        "scenario-models": "step_5.scenario-models",
