{
  "name": "budget-forecasting-cycle",
  "description": "Build a budget forecast from historical analysis through scenario modeling and leadership review.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "historical-actuals-analyzer",
      "inputs": {
        "financial-history": "from_user_input",
