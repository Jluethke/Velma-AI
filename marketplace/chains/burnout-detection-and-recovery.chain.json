    {
      "id": "step_1",
      "skill_name": "three-dimension-assessment",
      "inputs": {
        "current-state": "from_user_input",
        "recent-changes": "from_user_input"
      },
      "outputs": {
        "exhaustion-score": "exhaustion-score",
        "detachment-score": "detachment-score",
        "inefficacy-score": "inefficacy-score"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "root-cause-identification",
      "inputs": {
        "exhaustion-score": "step_1.exhaustion-score",
        "detachment-score": "step_1.detachment-score",
        "inefficacy-score": "step_1.inefficacy-score"
      },
      "outputs": {
        "exhaustion-causes": "exhaustion-causes",
        "detachment-causes": "detachment-causes",
        "inefficacy-causes": "inefficacy-causes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "recovery-protocol-design",
