      "outputs": {
        "characterization_tests": "characterization_tests",
        "target_coverage": "target_coverage"
      },
      "condition": "stack in ['typescript', 'javascript']",
      "parallel_group": 3
    },
    {
      "id": "s04_srf_go_golden_master_tests",
      "skill_name": "srf-go-golden-master-tests",
