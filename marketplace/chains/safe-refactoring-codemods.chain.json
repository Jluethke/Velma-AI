{
  "name": "safe-refactoring-codemods",
  "description": "Large mechanical rewrites with codemod tools: baseline, characterization for the chosen stack, then comby, Semgrep autofix, jscodeshift or gofmt -r, each fixture-tested and applied in green batches, then per-commit verification.",
  "steps": [
    {
      "id": "s01_srf_baseline_green_check",
      "skill_name": "srf-baseline-green-check",
      "inputs": {
        "repo_path": "from_user_input",
        "stack": "from_user_input",
        "test_command": "from_user_input",
        "refactorings": "from_user_input",
        "refactor_name": "from_user_input"
      },
      "outputs": {
        "baseline_commit": "baseline_commit",
        "refactor_branch": "refactor_branch",
        "baseline_report": "baseline_report"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_srf_py_characterization_tests",
      "skill_name": "srf-py-characterization-tests",
      "inputs": {
        "repo_path": "from_user_input",
        "target_paths": "from_user_input",
        "test_command": "from_user_input",
        "baseline_commit": "s01_srf_baseline_green_check.baseline_commit"
      },
      "outputs": {
        "characterization_tests": "characterization_tests",
        "target_coverage": "target_coverage"
      },
      "condition": "stack == 'python'",
      "parallel_group": 2
    },
    {
