{
  "name": "feedback-delivery-system",
  "description": "Deliver feedback using the SBIR model: Situation, Behavior, Impact, Request. Track whether feedback produces change. If the same feedback is delivered three times with no change, the problem is structural, not behavioral.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "feedback-situation-isolator",
      "inputs": {
        "behavior-to-address": "from_user_input",
        "recipient-context": "from_user_input"
      },
      "outputs": {
        "situation-anchor": "situation-anchor",
        "pattern-or-one-off": "pattern-or-one-off"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "feedback-behavior-describer",
      "inputs": {
        "situation-anchor": "step_1.situation-anchor",
        "behavior-to-address": "from_context.behavior-to-address"
      },
      "outputs": {
        "behavior-description": "behavior-description",
        "intent-assumptions-removed": "intent-assumptions-removed"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "feedback-impact-connector",
      "inputs": {
        "behavior-description": "step_2.behavior-description",
        "recipient-context": "from_context.recipient-context"
      },
      "outputs": {
        "impact-statement": "impact-statement",
        "impact-evidence": "impact-evidence"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "feedback-request-formulator",
      "inputs": {
        "impact-statement": "step_3.impact-statement",
        "pattern-or-one-off": "step_1.pattern-or-one-off"
      },
      "outputs": {
        "change-request": "change-request",
        "success-measure": "success-measure"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "feedback-follow-up-tracker",
      "inputs": {
        "change-request": "step_4.change-request",
        "success-measure": "step_4.success-measure"
      },
      "outputs": {
        "follow-up-plan": "follow-up-plan",
        "structural-escalation-criteria": "structural-escalation-criteria"
      },
      "parallel_group": 5
    }
  ],
