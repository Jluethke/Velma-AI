{
  "name": "insurance-coverage-audit",
  "description": "Audit insurance coverage for gaps and overlaps. Inventory every risk above a damage threshold, map existing coverage, identify gaps (uncovered risks) and overlaps (duplicate coverage), and prioritize the fixes. Applies to personal and commercial insurance.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "insurable-risk-inventory",
      "inputs": {
        "financial-profile": "from_user_input",
        "risk-context": "from_user_input"
      },
      "outputs": {
        "insurable-risk-list": "insurable-risk-list",
        "damage-threshold": "damage-threshold"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "existing-coverage-mapper",
      "inputs": {
        "insurable-risk-list": "step_1.insurable-risk-list",
        "financial-profile": "from_context.financial-profile"
      },
      "outputs": {
        "coverage-map": "coverage-map",
        "policy-inventory": "policy-inventory"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "gap-and-overlap-analyzer",
      "inputs": {
        "coverage-map": "step_2.coverage-map",
        "insurable-risk-list": "step_1.insurable-risk-list"
      },
      "outputs": {
        "coverage-gaps": "coverage-gaps",
        "coverage-overlaps": "coverage-overlaps"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "coverage-fix-prioritizer",
      "inputs": {
        "coverage-gaps": "step_3.coverage-gaps",
        "coverage-overlaps": "step_3.coverage-overlaps"
      },
      "outputs": {
        "coverage-action-plan": "coverage-action-plan",
        "annual-premium-projection": "annual-premium-projection"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "insurance-review-calendar",
      "inputs": {
        "policy-inventory": "step_2.policy-inventory",
        "coverage-action-plan": "step_4.coverage-action-plan"
      },
      "outputs": {
        "review-calendar": "review-calendar",
        "insurance-audit-document": "insurance-audit-document"
      },
      "parallel_group": 5
    }
  ],
