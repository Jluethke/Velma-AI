{
  "name": "feedback-loop-closure",
  "description": "Close the feedback loop from collection through categorization, routing, resolution, and respondent communication.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "feedback-intake-categorizer",
      "inputs": {
        "raw-feedback": "from_user_input",
        "category-taxonomy": "from_user_input"
      },
      "outputs": {
        "categorized-feedback": "categorized-feedback",
        "category-volume-summary": "category-volume-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "feedback-action-router",
      "inputs": {
        "categorized-feedback": "step_1.categorized-feedback"
      },
      "outputs": {
        "routed-items": "routed-items",
        "routing-rules": "routing-rules"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "feedback-resolution-tracker",
      "inputs": {
        "routed-items": "step_2.routed-items"
      },
      "outputs": {
        "resolution-status": "resolution-status",
        "sla-compliance-rate": "sla-compliance-rate"
      },
      "parallel_group": 3
    },
    {
