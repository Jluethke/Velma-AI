        "removable-claims": "removable-claims"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "irreducible-core-finder",
      "inputs": {
        "essential-claims": "step_2.essential-claims"
      },
      "outputs": {
        "irreducible-core": "irreducible-core",
        "derivative-claims": "derivative-claims"
      },
      "parallel_group": 3
    },
    {
