      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "subtraction-discipline-maintainer",
      "inputs": {
        "rebuilt-messaging": "step_4.rebuilt-messaging",
        "removable-claims": "step_2.removable-claims"
