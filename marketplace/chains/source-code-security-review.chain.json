        "sast-findings": "step_2.sast-findings",
        "manual-review-findings": "step_3.manual-review-findings"
      },
      "outputs": {
        "coding-standard-gaps": "coding-standard-gaps",
        "pattern-recommendations": "pattern-recommendations"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "code-security-report",
      "inputs": {
        "sast-findings": "step_2.sast-findings",
        "logic-flaw-findings": "step_4.logic-flaw-findings",
        "dependency-vulnerabilities": "step_5.dependency-vulnerabilities"
      },
      "outputs": {
        "code-security-report": "code-security-report",
        "fix-priority-list": "fix-priority-list"
      },
      "parallel_group": 7
    }
