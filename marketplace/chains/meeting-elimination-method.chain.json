      },
      "outputs": {
        "decision-tagged-meetings": "decision-tagged-meetings",
        "no-decision-meetings": "no-decision-meetings"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "cancellation-batch",
      "inputs": {
        "no-decision-meetings": "step_2.no-decision-meetings"
      },
      "outputs": {
        "cancelled-meetings": "cancelled-meetings",
        "reclaimed-hours": "reclaimed-hours"
      },
      "parallel_group": 3
    },
    {
