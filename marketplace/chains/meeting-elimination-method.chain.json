      },
      "outputs": {
        "meeting-list": "meeting-list",
        "meeting-time-cost": "meeting-time-cost"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "decision-dependency-test",
      "inputs": {
        "meeting-list": "step_1.meeting-list",
