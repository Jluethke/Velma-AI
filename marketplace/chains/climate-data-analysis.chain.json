{
  "name": "climate-data-analysis",
  "description": "Analyze climate records from data acquisition through quality control, homogenization, anomaly computation, trend testing, attribution, and reporting.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "climate-data-acquirer",
      "inputs": {
        "station-ids": "from_user_input",
        "time-period": "from_user_input",
        "variables": "from_user_input"
      },
      "outputs": {
        "raw-climate-series": "raw-climate-series",
        "initial-qc-flags": "initial-qc-flags"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "climate-homogenizer",
      "inputs": {
        "raw-climate-series": "step_1.raw-climate-series",
        "station-metadata": "from_context.station-metadata"
      },
      "outputs": {
        "homogenized-series": "homogenized-series",
        "homogenization-log": "homogenization-log"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "climate-anomaly-computer",
      "inputs": {
        "homogenized-series": "step_2.homogenized-series",
        "baseline-period": "from_context.baseline-period"
      },
      "outputs": {
        "anomaly-series": "anomaly-series",
        "climatology": "climatology"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "climate-trend-tester",
      "inputs": {
        "anomaly-series": "step_3.anomaly-series"
      },
      "outputs": {
        "trend-results": "trend-results",
        "trend-visualization": "trend-visualization"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "climate-forcing-attributor",
      "inputs": {
        "anomaly-series": "step_3.anomaly-series",
        "trend-results": "step_4.trend-results"
      },
      "outputs": {
        "attribution-results": "attribution-results",
        "attribution-confidence": "attribution-confidence"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "climate-analysis-reporter",
      "inputs": {
        "trend-results": "step_4.trend-results",
        "attribution-results": "step_5.attribution-results",
        "anomaly-series": "step_3.anomaly-series"
      },
      "outputs": {
        "climate-report": "climate-report",
        "projection-comparison": "projection-comparison"
      },
      "parallel_group": 6
    }
  ],
