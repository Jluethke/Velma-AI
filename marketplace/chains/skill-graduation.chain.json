    },
    {
      "from_step": "step_3",
      "to_step": "step_4",
      "data_type": "result",
      "field_mapping": "result -> input"
    },
    {
      "from_step": "step_4",
      "to_step": "step_5",
      "data_type": "review_comments",
      "field_mapping": "review_comments -> goal_or_event; review_comments -> deadline; review_comments -> constraints; review_comments -> experience_level"
    }
