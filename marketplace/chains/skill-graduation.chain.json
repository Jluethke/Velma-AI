{
  "name": "skill-graduation",
  "description": "Take a skill through the full graduation pipeline. Evaluate quality, generate test cases, run shadow validation against reference outputs, check health metrics, improve weak areas, and promote to graduated status. The meta-flow for skill quality assurance.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "data-extractor",
      "inputs": {
        "raw_text": "from_user_input",
        "target_fields": "from_user_input",
        "source_hint": "from_user_input",
        "examples": "from_user_input"
      },
      "outputs": {
        "extracted_data": "extracted_data_data",
        "confidence_scores": "confidence_scores_data",
        "extraction_notes": "extraction_notes_data",
        "raw_matches": "raw_matches_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "test-case-writer",
      "inputs": {
        "skill_md": "step_1.extracted_data",
        "test_count": "step_1.extracted_data",
        "focus_areas": "step_1.extracted_data",
        "domain_examples": "step_1.extracted_data"
      },
      "outputs": {
        "test_cases_json": "test_cases_json_data",
        "coverage_matrix": "coverage_matrix_data",
        "test_rationale": "test_rationale_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "skill-improver",
      "inputs": {
        "input": "step_1.extracted_data"
      },
      "outputs": {
        "result": "result_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_4",
      "skill_name": "code-review",
      "inputs": {
        "diff": "step_2.test_cases_json",
        "pr_description": "step_2.test_cases_json",
        "codebase_context": "step_2.test_cases_json",
        "task_description": "step_2.test_cases_json"
      },
      "outputs": {
        "review_comments": "review_comments_data",
        "approval_decision": "approval_decision_data",
        "summary": "summary_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_5",
      "skill_name": "checklist-builder",
      "inputs": {
        "goal_or_event": "step_4.review_comments",
        "deadline": "step_4.review_comments",
        "constraints": "step_4.review_comments",
        "experience_level": "step_4.review_comments"
      },
      "outputs": {
        "checklist": "checklist_data",
        "timeline": "timeline_data",
        "dont_forget": "dont_forget_data",
        "dependencies": "dependencies_data"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "extracted_data",
      "field_mapping": "extracted_data -> skill_md; extracted_data -> test_count; extracted_data -> focus_areas; extracted_data -> domain_examples"
    },
    {
      "from_step": "step_1",
      "to_step": "step_3",
      "data_type": "result",
      "field_mapping": "result -> input"
    },
    {
