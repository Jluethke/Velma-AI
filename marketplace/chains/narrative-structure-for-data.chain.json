{
  "name": "narrative-structure-for-data",
  "description": "Present data as a story using the Situation-Complication-Resolution framework. One chart per point. The chart title is the conclusion, not the axis label. Everything else goes in the appendix. Works for board presentations, investor updates, team meetings, and any context where data must produce a decision.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "decision-context-definer",
      "inputs": {
        "dataset-description": "from_user_input",
        "audience-and-decision": "from_user_input"
      },
      "outputs": {
        "decision-statement": "decision-statement",
        "data-relevance-filter": "data-relevance-filter"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "situation-frame-writer",
      "inputs": {
        "decision-statement": "step_1.decision-statement",
        "audience-and-decision": "from_context.audience-and-decision"
      },
      "outputs": {
        "situation-statement": "situation-statement",
        "shared-assumptions": "shared-assumptions"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "complication-data-selector",
      "inputs": {
        "situation-statement": "step_2.situation-statement",
        "data-relevance-filter": "step_1.data-relevance-filter"
      },
      "outputs": {
        "complication-finding": "complication-finding",
        "complication-chart": "complication-chart"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "resolution-recommendation-writer",
      "inputs": {
        "complication-finding": "step_3.complication-finding",
        "decision-statement": "step_1.decision-statement"
      },
      "outputs": {
        "resolution-statement": "resolution-statement",
        "confidence-level": "confidence-level"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "appendix-boundary-enforcer",
      "inputs": {
        "dataset-description": "from_context.dataset-description",
        "data-relevance-filter": "step_1.data-relevance-filter"
      },
      "outputs": {
        "appendix-contents": "appendix-contents",
        "main-presentation-contents": "main-presentation-contents"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "narrative-dry-run",
      "inputs": {
