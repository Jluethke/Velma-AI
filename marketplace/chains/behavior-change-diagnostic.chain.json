{
  "name": "behavior-change-diagnostic",
  "description": "Diagnose why a behavior change keeps failing using the capability, opportunity, motivation model. Score each of the three, find the lowest, and treat it as the bottleneck. Most people assume the problem is motivation when it is usually opportunity or capability.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "target-behavior-framing",
      "inputs": {
        "behavior-to-change": "from_user_input",
        "change-history": "from_user_input"
      },
      "outputs": {
        "framed-behavior": "framed-behavior",
        "past-attempt-notes": "past-attempt-notes"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "capability-scoring",
      "inputs": {
        "framed-behavior": "step_1.framed-behavior",
        "past-attempt-notes": "step_1.past-attempt-notes"
      },
      "outputs": {
        "capability-score": "capability-score",
        "capability-evidence": "capability-evidence"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "opportunity-scoring",
      "inputs": {
        "framed-behavior": "step_1.framed-behavior",
        "past-attempt-notes": "step_1.past-attempt-notes"
      },
      "outputs": {
        "opportunity-score": "opportunity-score",
        "opportunity-evidence": "opportunity-evidence"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "motivation-scoring",
      "inputs": {
        "framed-behavior": "step_1.framed-behavior",
        "past-attempt-notes": "step_1.past-attempt-notes"
      },
      "outputs": {
        "motivation-score": "motivation-score",
        "motivation-evidence": "motivation-evidence"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "comb-model-bottleneck-finder",
      "inputs": {
        "capability-score": "step_2.capability-score",
        "opportunity-score": "step_3.opportunity-score",
        "motivation-score": "step_4.motivation-score"
      },
      "outputs": {
        "lowest-component": "lowest-component",
        "bottleneck-rationale": "bottleneck-rationale"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "bottleneck-intervention-plan",
      "inputs": {
        "lowest-component": "step_5.lowest-component",
        "bottleneck-rationale": "step_5.bottleneck-rationale"
      },
      "outputs": {
        "intervention-plan": "intervention-plan",
        "reassessment-trigger": "reassessment-trigger"
      },
      "parallel_group": 6
    }
  ],
