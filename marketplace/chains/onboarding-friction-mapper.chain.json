      "data_type": "object",
      "field_mapping": {}
    },
    {
      "from_step": "step_4",
      "to_step": "step_5",
      "data_type": "object",
      "field_mapping": {}
    }
  ],
  "entry_inputs": [
    "product-or-service",
    "current-onboarding"
  ],
  "terminal_outputs": [
    "onboarding-metrics",
    "improvement-triggers"
  ],
