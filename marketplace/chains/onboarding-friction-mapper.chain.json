{
  "name": "onboarding-friction-mapper",
  "description": "Map every friction point in user onboarding: each field, click, decision, and wait. For each friction point, decide: remove it, defer it, or reduce it. The goal is time-to-value under 5 minutes.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "onboarding-step-inventory",
      "inputs": {
        "product-or-service": "from_user_input",
        "current-onboarding": "from_user_input"
      },
      "outputs": {
        "step-inventory": "step-inventory",
        "step-count": "step-count"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "friction-classification",
      "inputs": {
        "step-inventory": "step_1.step-inventory",
        "step-count": "step_1.step-count"
      },
      "outputs": {
        "classified-steps": "classified-steps",
        "removal-candidates": "removal-candidates"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "friction-reduction-design",
      "inputs": {
        "classified-steps": "step_2.classified-steps",
        "removal-candidates": "step_2.removal-candidates"
      },
      "outputs": {
        "redesigned-flow": "redesigned-flow",
        "time-to-value-estimate": "time-to-value-estimate"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "first-value-moment-optimization",
      "inputs": {
        "redesigned-flow": "step_3.redesigned-flow",
        "product-or-service": "from_context.product-or-service"
      },
      "outputs": {
        "first-value-design": "first-value-design",
        "value-confirmation": "value-confirmation"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "onboarding-measurement-system",
      "inputs": {
        "redesigned-flow": "step_3.redesigned-flow",
        "first-value-design": "step_4.first-value-design"
      },
      "outputs": {
        "onboarding-metrics": "onboarding-metrics",
        "improvement-triggers": "improvement-triggers"
      },
      "parallel_group": 5
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "object",
      "field_mapping": {}
    },
    {
