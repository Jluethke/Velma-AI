{
  "name": "dimensional-reduction-analysis",
  "description": "Reduce high-dimensional data to interpretable structure: standardize, select and run the decomposition method, interpret components, validate stability, and produce the reduced representation.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "data-standardizer",
      "inputs": {
        "raw-feature-matrix": "from_user_input",
        "feature-metadata": "from_user_input"
      },
      "outputs": {
        "standardized-matrix": "standardized-matrix",
        "scaling-parameters": "scaling-parameters"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "reduction-method-selector",
      "inputs": {
        "standardized-matrix": "step_1.standardized-matrix",
        "analysis-goal": "from_context.analysis-goal"
      },
      "outputs": {
        "method-choice": "method-choice",
        "hyperparameters": "hyperparameters"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "decomposition-executor",
      "inputs": {
        "standardized-matrix": "step_1.standardized-matrix",
        "method-choice": "step_2.method-choice",
        "hyperparameters": "step_2.hyperparameters"
      },
      "outputs": {
        "reduced-representation": "reduced-representation",
        "loading-matrix": "loading-matrix",
        "variance-explained": "variance-explained"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "component-interpreter",
      "inputs": {
        "loading-matrix": "step_3.loading-matrix",
        "reduced-representation": "step_3.reduced-representation",
        "feature-metadata": "from_context.feature-metadata"
      },
      "outputs": {
        "component-labels": "component-labels",
        "interpretation-evidence": "interpretation-evidence"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "cluster-stability-validator",
      "inputs": {
        "reduced-representation": "step_3.reduced-representation",
        "hyperparameters": "step_2.hyperparameters"
      },
      "outputs": {
        "stability-report": "stability-report",
        "stable-clusters": "stable-clusters"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "reduced-data-packager",
      "inputs": {
        "reduced-representation": "step_3.reduced-representation",
        "scaling-parameters": "step_1.scaling-parameters",
        "component-labels": "step_4.component-labels",
        "stability-report": "step_5.stability-report"
      },
      "outputs": {
        "reduced-dataset": "reduced-dataset",
        "projection-function": "projection-function",
        "reduction-report": "reduction-report"
      },
      "parallel_group": 6
    }
  ],
