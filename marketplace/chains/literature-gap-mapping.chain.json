      },
      "outputs": {
        "concept-matrix": "concept-matrix",
        "concept-list": "concept-list"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "gap-identifier",
      "inputs": {
        "concept-matrix": "step_2.concept-matrix",
        "concept-list": "step_2.concept-list"
      },
      "outputs": {
        "gap-list": "gap-list",
        "contradiction-list": "contradiction-list"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "tractability-assessor",
      "inputs": {
        "gap-list": "step_3.gap-list",
        "domain-constraints": "from_context.domain-constraints"
      },
      "outputs": {
        "tractability-ratings": "tractability-ratings",
        "feasibility-notes": "feasibility-notes"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "gap-impact-ranker",
      "inputs": {
        "gap-list": "step_3.gap-list",
        "tractability-ratings": "step_4.tractability-ratings",
        "concept-matrix": "step_2.concept-matrix"
      },
      "outputs": {
        "ranked-gaps": "ranked-gaps",
        "impact-rationale": "impact-rationale"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "gap-map-producer",
      "inputs": {
        "concept-matrix": "step_2.concept-matrix",
        "ranked-gaps": "step_5.ranked-gaps",
        "contradiction-list": "step_3.contradiction-list"
      },
      "outputs": {
        "gap-map": "gap-map",
        "research-agenda": "research-agenda"
      },
      "parallel_group": 6
    }
