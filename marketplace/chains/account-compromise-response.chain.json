{
  "name": "account-compromise-response",
  "description": "Respond to a compromised user account from confirmation through remediation and reporting.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "account-compromise-confirmation",
      "inputs": {
        "compromise-indicators": "from_user_input",
        "account-details": "from_user_input"
      },
      "outputs": {
        "compromise-confirmation": "compromise-confirmation",
        "indicator-summary": "indicator-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "account-lockdown",
      "inputs": {
        "compromise-confirmation": "step_1.compromise-confirmation",
        "account-details": "from_context.account-details"
      },
      "outputs": {
        "lockdown-log": "lockdown-log",
        "session-revocation": "session-revocation"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "account-impact-assessment",
      "inputs": {
        "lockdown-log": "step_2.lockdown-log",
        "indicator-summary": "step_1.indicator-summary"
      },
      "outputs": {
        "impact-assessment": "impact-assessment",
        "attacker-activity-timeline": "attacker-activity-timeline"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "account-persistence-check",
      "inputs": {
        "impact-assessment": "step_3.impact-assessment",
        "account-details": "from_context.account-details"
      },
      "outputs": {
        "persistence-findings": "persistence-findings",
        "cleanup-log": "cleanup-log"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "account-credential-restoration",
      "inputs": {
        "cleanup-log": "step_4.cleanup-log",
        "account-details": "from_context.account-details"
      },
      "outputs": {
        "restoration-confirmation": "restoration-confirmation",
        "user-notification": "user-notification"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "account-compromise-report-writer",
      "inputs": {
        "attacker-activity-timeline": "step_3.attacker-activity-timeline",
        "persistence-findings": "step_4.persistence-findings"
      },
      "outputs": {
        "account-compromise-report": "account-compromise-report",
        "prevention-recommendations": "prevention-recommendations"
      },
      "parallel_group": 6
    }
  ],
