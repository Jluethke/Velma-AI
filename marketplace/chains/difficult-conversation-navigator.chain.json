{
  "name": "difficult-conversation-navigator",
  "description": "Navigate difficult conversations using the interest-based approach from the Harvard Negotiation Project. Separate the person from the problem. Focus on interests, not positions. Generate options before deciding. Use objective criteria. Works for performance conversations, conflict resolution, salary discussions, relationship issues, and complaints.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "conversation-preparation",
      "inputs": {
        "situation-description": "from_user_input",
        "desired-outcome": "from_user_input"
      },
      "outputs": {
        "your-interests": "your-interests",
        "their-likely-interests": "their-likely-interests",
        "preparation-notes": "preparation-notes"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "conversation-opener",
      "inputs": {
        "preparation-notes": "step_1.preparation-notes",
        "desired-outcome": "from_context.desired-outcome"
      },
      "outputs": {
        "opening-script": "opening-script",
        "ground-rules": "ground-rules"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "interest-exploration-method",
      "inputs": {
        "your-interests": "step_1.your-interests",
        "their-likely-interests": "step_1.their-likely-interests"
      },
      "outputs": {
        "shared-interests": "shared-interests",
        "different-but-compatible-interests": "different-but-compatible-interests",
        "conflicting-interests": "conflicting-interests"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "option-generator",
      "inputs": {
        "shared-interests": "step_3.shared-interests",
        "different-but-compatible-interests": "step_3.different-but-compatible-interests",
        "conflicting-interests": "step_3.conflicting-interests"
      },
      "outputs": {
        "option-list": "option-list",
        "evaluation-criteria": "evaluation-criteria"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "agreement-and-follow-through",
      "inputs": {
        "option-list": "step_4.option-list",
        "evaluation-criteria": "step_4.evaluation-criteria"
      },
      "outputs": {
        "agreement-record": "agreement-record",
        "follow-up-plan": "follow-up-plan"
      },
      "parallel_group": 5
    }
