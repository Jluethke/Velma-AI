{
  "name": "cash-flow-timing-optimization",
  "description": "Optimize when money moves rather than how much. Map inflows and outflows by date across ninety days, find the valleys and peaks in the balance, shift movable outflows and pull receivables earlier, then value the smoother timing as float.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "cfto-flow-calendar-builder",
      "inputs": {
        "account-context": "from_user_input",
        "planning-horizon": "from_user_input"
      },
      "outputs": {
        "flow-calendar": "flow-calendar",
        "recurring-items": "recurring-items"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "cfto-balance-projector",
      "inputs": {
        "flow-calendar": "step_1.flow-calendar",
        "recurring-items": "step_1.recurring-items"
      },
      "outputs": {
        "daily-balance-curve": "daily-balance-curve",
        "starting-balance": "starting-balance"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "cfto-valley-peak-finder",
      "inputs": {
        "daily-balance-curve": "step_2.daily-balance-curve"
      },
      "outputs": {
        "cash-valleys": "cash-valleys",
        "cash-peaks": "cash-peaks"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cfto-outflow-shifter",
      "inputs": {
        "cash-valleys": "step_3.cash-valleys",
        "recurring-items": "step_1.recurring-items"
      },
      "outputs": {
        "shift-plan": "shift-plan",
        "protected-outflows": "protected-outflows"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "cfto-receivable-accelerator",
      "inputs": {
        "cash-valleys": "step_3.cash-valleys",
        "flow-calendar": "step_1.flow-calendar"
      },
      "outputs": {
        "acceleration-plan": "acceleration-plan",
        "expected-earlier-inflows": "expected-earlier-inflows"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "cfto-float-valuer",
      "inputs": {
        "shift-plan": "step_4.shift-plan",
        "acceleration-plan": "step_5.acceleration-plan"
      },
      "outputs": {
        "float-value": "float-value",
        "smoothed-balance-curve": "smoothed-balance-curve"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "cfto-timing-plan-writer",
      "inputs": {
        "float-value": "step_6.float-value",
        "smoothed-balance-curve": "step_6.smoothed-balance-curve"
      },
      "outputs": {
        "cash-timing-plan": "cash-timing-plan",
        "action-checklist": "action-checklist"
      },
      "parallel_group": 7
    }
  ],
