{
  "name": "motion-planning-control-lateral-tracking",
  "description": "Geometric and LQR lateral tracking in simulation: path smoothing, jerk-limited speed profile, pure pursuit, Stanley or LQR, closed-loop simulation, tracking metrics and stability margins.",
  "steps": [
    {
