      "skill_name": "ctrl-spec-intake",
      "inputs": {
        "vehicle_params": "from_user_input",
        "motion_limits": "from_user_input",
        "test_site": "from_user_input",
        "estop_description": "from_user_input",
        "stack": "from_user_input"
      },
      "outputs": {
        "control_spec": "control_spec",
        "open_questions": "open_questions"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_ctrl_bicycle_model_py",
      "skill_name": "ctrl-bicycle-model-py",
      "inputs": {
        "control_spec": "s01_ctrl_spec_intake.control_spec",
        "project_dir": "from_user_input"
      },
      "outputs": {
        "plant_model": "plant_model"
      },
      "parallel_group": 2
    },
    {
