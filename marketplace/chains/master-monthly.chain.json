        "last_done": "from_context.last_done",
        "climate": "from_context.climate"
      },
      "outputs": {
        "maintenance_calendar": "maintenance_calendar",
        "overdue_list": "overdue_list",
        "task_cards": "task_cards",
        "annual_budget": "annual_budget"
      },
      "parallel_group": 5
    },
    {
