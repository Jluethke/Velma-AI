{
  "name": "master-monthly",
  "description": "Master monthly chain. Deep dive every domain: full vehicle scan + parts check, home energy audit + maintenance, complete financial picture (portfolio, net worth, subscriptions, budget), fitness trends, cost of ownership analysis. Then monthly scorecard and goal check. 14 steps.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "vehicle-health",
      "inputs": {
        "vehicle": "from_user_input",
        "scan_scope": "from_user_input",
        "history": "from_user_input"
      },
      "outputs": {
        "module_status": "module_status",
        "dtc_report": "dtc_report",
        "signal_health": "signal_health",
        "trend_analysis": "trend_analysis",
        "action_plan": "action_plan"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "maintenance-schedule",
      "inputs": {
        "vehicle": "from_context.vehicle",
        "mileage": "from_context.mileage",
        "service_history": "from_context.service_history",
        "driving_conditions": "from_context.driving_conditions"
      },
      "outputs": {
        "interval_map": "interval_map",
        "current_status": "current_status",
        "calendar": "calendar",
        "cost_forecast": "cost_forecast"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "parts-finder",
      "inputs": {
        "vehicle": "from_context.vehicle",
        "dtc_or_symptom": "from_context.dtc_or_symptom",
        "component": "from_context.component"
      },
      "outputs": {
        "component_id": "component_id",
        "oem_parts": "oem_parts",
        "aftermarket_options": "aftermarket_options",
        "sourcing_plan": "sourcing_plan",
        "install_notes": "install_notes"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "home-status",
      "inputs": {
        "devices": "from_context.devices",
        "schedule": "from_context.schedule",
        "preferences": "from_context.preferences",
        "recent_alerts": "from_context.recent_alerts"
      },
      "outputs": {
        "status_board": "status_board",
        "anomalies": "anomalies",
        "action_items": "action_items",
        "efficiency_note": "efficiency_note"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "home-maintenance",
      "inputs": {
        "home": "from_context.home",
        "outdoor": "from_context.outdoor",
