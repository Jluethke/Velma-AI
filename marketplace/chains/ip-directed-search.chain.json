{
  "name": "ip-directed-search",
  "description": "Systematic IP licensing target discovery and sequencing. Scans every sector for companies deploying qualifying AI systems (Family A actuation governance, Family B learning governance), scores each target on deal size, regulatory urgency, accessibility, and response probability, then builds the master 90-day outreach sequence  --  who gets contacted in what order, through what channel, on what date. Feed it a sector and patent context  --  get back a ranked attack list and a day-by-day campaign calendar ready to execute.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "sector-target-scanner",
      "inputs": {
        "sector": "from_user_input",
        "patent_families": "from_user_input",
        "geography": "from_user_input",
        "company_size": "from_user_input",
        "scan_depth": "from_user_input",
        "exclude_list": "from_user_input"
      },
      "outputs": {
        "raw_targets": "raw_targets",
        "signal_summary": "signal_summary",
        "sector_intelligence": "sector_intelligence",
        "scan_report": "scan_report"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "target-qualifier",
      "inputs": {
        "raw_targets": "step_1.raw_targets",
        "patent_families": "from_context.patent_families",
        "deal_parameters": "from_context.deal_parameters",
        "licensor_network": "from_context.licensor_network",
        "urgency_window_days": "from_context.urgency_window_days"
      },
      "outputs": {
        "qualified_targets": "qualified_targets",
        "a_list": "a_list",
        "b_list": "b_list",
        "disqualified": "disqualified",
        "qualification_report": "qualification_report"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "outreach-prioritizer",
      "inputs": {
        "qualified_targets": "step_2.qualified_targets",
        "a_list": "step_2.a_list",
        "b_list": "step_2.b_list",
        "licensor_capacity": "from_context.licensor_capacity",
        "campaign_start_date": "from_context.campaign_start_date",
        "sector_stagger": "from_context.sector_stagger",
        "warm_path_lead_time_days": "from_context.warm_path_lead_time_days"
      },
      "outputs": {
        "master_sequence": "master_sequence",
        "active_pipeline_calendar": "active_pipeline_calendar",
        "sector_map": "sector_map",
        "trigger_events": "trigger_events",
        "campaign_dashboard": "campaign_dashboard"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "checklist-builder",
      "inputs": {
        "goal_or_event": "from_context.goal_or_event",
        "deadline": "from_context.deadline",
        "constraints": "from_context.constraints",
        "experience_level": "from_context.experience_level"
      },
      "outputs": {
        "checklist": "checklist",
        "timeline": "timeline",
        "dont_forget": "dont_forget",
        "dependencies": "dependencies"
      },
      "parallel_group": 4
    }
  ],
