{
  "name": "spaced-repetition-system-builder",
  "description": "Build a spaced repetition system that fights the Ebbinghaus forgetting curve: schedule reviews at increasing intervals (1, 3, 7, 14, 30, 90 days), reset intervals on failure, and produce better retention from fewer total reviews than massed study.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "knowledge-item-extraction",
      "inputs": {
        "source-material": "from_user_input",
        "retention-goal": "from_user_input"
      },
      "outputs": {
        "knowledge-items": "knowledge-items",
        "item-format-map": "item-format-map"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "review-card-creation",
      "inputs": {
        "knowledge-items": "step_1.knowledge-items",
        "item-format-map": "step_1.item-format-map"
      },
      "outputs": {
        "review-cards": "review-cards",
        "card-count": "card-count"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "interval-schedule-configuration",
      "inputs": {
        "review-cards": "step_2.review-cards",
        "card-count": "step_2.card-count"
      },
      "outputs": {
        "interval-schedule": "interval-schedule",
        "daily-review-estimate": "daily-review-estimate"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "daily-review-session-runner",
      "inputs": {
        "interval-schedule": "step_3.interval-schedule",
        "review-cards": "step_2.review-cards"
      },
      "outputs": {
        "session-results": "session-results",
        "updated-schedule": "updated-schedule"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "retention-analytics-review",
      "inputs": {
        "session-results": "step_4.session-results",
        "updated-schedule": "step_4.updated-schedule"
      },
      "outputs": {
        "leech-cards": "leech-cards",
        "retention-rate": "retention-rate"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "knowledge-integration-test",
      "inputs": {
        "retention-rate": "step_5.retention-rate",
        "review-cards": "step_2.review-cards"
      },
      "outputs": {
        "integration-test-results": "integration-test-results",
        "system-adjustments": "system-adjustments"
      },
      "parallel_group": 6
    }
  ],
