      },
      "outputs": {
        "baseline-measurements": "baseline-measurements",
        "variance-analysis": "variance-analysis"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "onboarding-process-mapper",
      "inputs": {
        "baseline-measurements": "step_2.baseline-measurements",
        "variance-analysis": "step_2.variance-analysis"
      },
      "outputs": {
        "process-map": "process-map",
        "new-hire-feedback": "new-hire-feedback"
      },
      "parallel_group": 3
    },
    {
