{
  "name": "onboarding-time-to-productivity",
  "description": "Measure and systematically shorten the time from hire to full productivity. Define full productivity in measurable terms, measure the current baseline, map the onboarding process, identify the bottlenecks with the longest delays, and fix them in order. Most onboarding problems are waiting problems (access, equipment, documentation), not learning problems.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "productivity-definition-writer",
      "inputs": {
        "role-title": "from_user_input",
        "current-performance-benchmarks": "from_user_input"
      },
      "outputs": {
        "productivity-definition": "productivity-definition",
        "milestone-ladder": "milestone-ladder"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "baseline-time-measurer",
      "inputs": {
        "productivity-definition": "step_1.productivity-definition",
