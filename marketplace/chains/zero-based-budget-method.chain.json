{
  "name": "zero-based-budget-method",
  "description": "Build a budget from zero each period. Every dollar must be justified by its expected return, not by the fact that it was spent last period. Forces conscious allocation instead of inertial spending. Works for households, departments, and entire organizations.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "budget-baseline-wipe",
      "inputs": {
        "last-period-spending": "from_user_input",
        "available-funds": "from_user_input"
      },
      "outputs": {
        "spending-categories": "spending-categories",
        "total-available": "total-available"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "spending-justification-builder",
      "inputs": {
        "spending-categories": "step_1.spending-categories",
        "total-available": "step_1.total-available"
      },
      "outputs": {
        "justified-requests": "justified-requests",
        "unjustified-spending": "unjustified-spending"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "priority-rank-allocator",
      "inputs": {
        "justified-requests": "step_2.justified-requests",
        "total-available": "step_1.total-available"
      },
      "outputs": {
        "funded-categories": "funded-categories",
        "unfunded-categories": "unfunded-categories",
        "marginal-allocation": "marginal-allocation"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "variance-tracking-setup",
      "inputs": {
        "funded-categories": "step_3.funded-categories",
        "marginal-allocation": "step_3.marginal-allocation"
      },
      "outputs": {
        "variance-tracking-plan": "variance-tracking-plan",
        "reallocation-rules": "reallocation-rules"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "zero-based-cycle-review",
      "inputs": {
        "variance-tracking-plan": "step_4.variance-tracking-plan",
        "justified-requests": "step_2.justified-requests"
      },
      "outputs": {
        "return-scorecard": "return-scorecard",
        "next-cycle-inputs": "next-cycle-inputs"
      },
      "parallel_group": 5
    }
  ],
