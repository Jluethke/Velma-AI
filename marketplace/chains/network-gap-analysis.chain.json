{
  "name": "network-gap-analysis",
  "description": "Find the structural holes in your network using Burt's structural holes theory. Map your network into clusters, find where you have zero connections, and recognize that those gaps are opportunities and information you will never hear about because no one in your network is positioned to tell you. Then fill one gap at a time by joining the communities your existing network does not reach, rather than adding more contacts in the clusters where you are already saturated.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "netgap-cluster-mapping",
      "inputs": {
        "contact-list": "from_user_input",
        "clustering-basis": "from_user_input"
      },
      "outputs": {
        "cluster-map": "cluster-map",
        "cluster-labels": "cluster-labels"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "netgap-zero-connection-finder",
      "inputs": {
        "cluster-map": "step_1.cluster-map",
        "cluster-labels": "step_1.cluster-labels"
      },
      "outputs": {
        "zero-connection-regions": "zero-connection-regions",
        "missing-cluster-list": "missing-cluster-list"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "netgap-opportunity-valuation",
      "inputs": {
        "zero-connection-regions": "step_2.zero-connection-regions",
        "missing-cluster-list": "step_2.missing-cluster-list"
      },
      "outputs": {
        "gap-value-scores": "gap-value-scores",
        "prioritized-gaps": "prioritized-gaps"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "netgap-community-identification",
      "inputs": {
        "gap-value-scores": "step_3.gap-value-scores",
        "prioritized-gaps": "step_3.prioritized-gaps"
      },
      "outputs": {
        "candidate-communities": "candidate-communities",
        "community-access-notes": "community-access-notes"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "netgap-single-gap-selector",
      "inputs": {
        "candidate-communities": "step_4.candidate-communities",
        "community-access-notes": "step_4.community-access-notes"
      },
      "outputs": {
        "selected-gap": "selected-gap",
        "selection-rationale": "selection-rationale"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "netgap-entry-strategy",
      "inputs": {
        "selected-gap": "step_5.selected-gap",
        "selection-rationale": "step_5.selection-rationale"
      },
      "outputs": {
        "entry-plan": "entry-plan",
        "first-contact-targets": "first-contact-targets"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "netgap-progress-tracker",
      "inputs": {
        "entry-plan": "step_6.entry-plan",
        "first-contact-targets": "step_6.first-contact-targets"
      },
      "outputs": {
        "gap-fill-tracker": "gap-fill-tracker",
        "progress-review-cadence": "progress-review-cadence"
      },
      "parallel_group": 7
    }
  ],
