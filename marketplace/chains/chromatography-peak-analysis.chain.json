{
  "name": "chromatography-peak-analysis",
  "description": "Analyze chromatographic data: detect peaks, integrate areas, identify compounds, assess separation quality, quantify concentrations, and produce the analytical report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "baseline-corrector",
      "inputs": {
        "raw-chromatogram": "from_user_input",
        "method-parameters": "from_user_input"
      },
      "outputs": {
        "corrected-chromatogram": "corrected-chromatogram",
        "baseline-trace": "baseline-trace"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "peak-detector-integrator",
      "inputs": {
        "corrected-chromatogram": "step_1.corrected-chromatogram",
        "detection-parameters": "from_context.detection-parameters"
      },
      "outputs": {
        "peak-list": "peak-list",
        "integration-report": "integration-report"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "compound-identifier",
      "inputs": {
        "peak-list": "step_2.peak-list",
        "reference-library": "from_context.reference-library"
      },
      "outputs": {
        "identified-peaks": "identified-peaks",
        "unidentified-peaks": "unidentified-peaks"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "separation-quality-assessor",
      "inputs": {
        "peak-list": "step_2.peak-list",
        "method-parameters": "from_context.method-parameters"
      },
      "outputs": {
        "separation-metrics": "separation-metrics",
        "suitability-verdict": "suitability-verdict"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "concentration-quantifier",
      "inputs": {
        "identified-peaks": "step_3.identified-peaks",
        "calibration-data": "from_context.calibration-data"
      },
      "outputs": {
        "concentration-table": "concentration-table",
        "calibration-quality": "calibration-quality"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "chromatography-report-writer",
      "inputs": {
        "concentration-table": "step_5.concentration-table",
        "separation-metrics": "step_4.separation-metrics",
        "identified-peaks": "step_3.identified-peaks"
      },
      "outputs": {
        "chromatography-report": "chromatography-report",
        "results-certificate": "results-certificate"
      },
      "parallel_group": 6
    }
  ],
