{
  "name": "first-principles-analysis",
  "description": "Break a problem down to its fundamental truths and reason upward from there instead of by analogy. State the problem with no solution baked in, enumerate every assumption, separate real constraints from inherited conventions, discard the conventions, rebuild a solution from the hard constraints, and validate it. Reasoning from first principles finds options that copying the industry template hides.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "first-principles-problem-statement",
      "inputs": {
        "problem-description": "from_user_input",
        "current-approach": "from_user_input",
        "desired-outcome": "from_user_input"
      },
      "outputs": {
        "problem-statement": "problem-statement",
        "solution-free-framing": "solution-free-framing"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "first-principles-assumption-enumeration",
      "inputs": {
        "problem-statement": "step_1.problem-statement",
        "solution-free-framing": "step_1.solution-free-framing"
      },
      "outputs": {
        "assumption-list": "assumption-list",
        "assumption-count": "assumption-count"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "first-principles-assumption-classification",
      "inputs": {
        "assumption-list": "step_2.assumption-list",
        "assumption-count": "step_2.assumption-count"
      },
      "outputs": {
        "classified-assumptions": "classified-assumptions",
        "convention-list": "convention-list"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "first-principles-convention-challenge",
      "inputs": {
        "convention-list": "step_3.convention-list",
        "classified-assumptions": "step_3.classified-assumptions"
      },
      "outputs": {
        "hard-constraints": "hard-constraints",
        "discarded-conventions": "discarded-conventions"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "first-principles-principle-rebuild",
      "inputs": {
        "hard-constraints": "step_4.hard-constraints",
        "discarded-conventions": "step_4.discarded-conventions"
      },
      "outputs": {
        "first-principles-solution": "first-principles-solution",
        "reasoning-trace": "reasoning-trace"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "first-principles-solution-validation",
      "inputs": {
        "first-principles-solution": "step_5.first-principles-solution",
        "hard-constraints": "step_4.hard-constraints",
        "problem-statement": "step_1.problem-statement"
      },
      "outputs": {
        "validated-solution": "validated-solution",
        "open-questions": "open-questions"
      },
      "parallel_group": 6
    }
  ],
