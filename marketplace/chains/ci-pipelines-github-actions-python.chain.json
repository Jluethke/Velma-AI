{
  "name": "ci-pipelines-github-actions-python",
  "description": "Build a hardened GitHub Actions CI for a Python project: commands, clean-room check, workflow, cache, version matrix, JUnit artifacts, SHA pins, secrets audit, workflow lint and required checks.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "ci0-detect-stack",
      "inputs": {
        "repo_dir": "from_user_input",
        "stack": "from_user_input"
      },
      "outputs": {
        "stack_profile": "stack_profile",
        "existing_ci_files": "existing_ci_files"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "ci0-py-ci-commands",
      "inputs": {
        "repo_dir": "from_context.repo_dir",
        "stack_profile": "step_1.stack_profile"
      },
      "outputs": {
        "py_ci_commands": "py_ci_commands"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "ci0-clean-room-command-check",
      "inputs": {
        "repo_dir": "from_context.repo_dir",
        "py_ci_commands": "step_2.py_ci_commands",
        "node_ci_commands": "from_context.node_ci_commands",
        "go_ci_commands": "from_context.go_ci_commands",
        "jvm_ci_commands": "from_context.jvm_ci_commands",
        "runner_image": "from_context.runner_image"
      },
      "outputs": {
        "verified_commands": "verified_commands",
        "junit_report_globs": "junit_report_globs"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "ci0-gha-workflow-baseline",
      "inputs": {
        "repo_dir": "from_context.repo_dir",
        "verified_commands": "step_3.verified_commands",
        "default_branch": "from_context.default_branch"
      },
      "outputs": {
        "gha_workflow_path": "gha_workflow_path",
        "gha_job_ids": "gha_job_ids"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "ci0-gha-dependency-cache",
      "inputs": {
        "gha_workflow_path": "step_4.gha_workflow_path",
        "stack_profile": "step_1.stack_profile"
      },
      "outputs": {
        "gha_cache_diff": "gha_cache_diff"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "ci0-gha-test-matrix",
      "inputs": {
        "gha_workflow_path": "step_4.gha_workflow_path",
        "matrix_versions": "from_context.matrix_versions",
        "matrix_os": "from_context.matrix_os"
      },
      "outputs": {
        "gha_matrix_diff": "gha_matrix_diff",
        "check_run_names": "check_run_names"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "ci0-gha-junit-artifacts",
      "inputs": {
        "gha_workflow_path": "step_4.gha_workflow_path",
        "junit_report_globs": "step_3.junit_report_globs"
      },
      "outputs": {
        "gha_report_diff": "gha_report_diff"
      },
      "parallel_group": 7
    },
    {
      "id": "step_8",
      "skill_name": "ci0-gha-pin-actions-sha",
      "inputs": {
        "gha_workflow_path": "step_4.gha_workflow_path"
      },
      "outputs": {
        "pinned_actions_table": "pinned_actions_table"
      },
      "parallel_group": 8
    },
    {
      "id": "step_9",
      "skill_name": "ci0-gha-secrets-permissions",
      "inputs": {
        "gha_workflow_path": "step_4.gha_workflow_path"
      },
      "outputs": {
        "secrets_findings": "secrets_findings"
      },
      "parallel_group": 9
    },
    {
      "id": "step_10",
      "skill_name": "ci0-gha-lint-workflows",
      "inputs": {
        "gha_workflow_path": "step_4.gha_workflow_path"
      },
      "outputs": {
        "lint_report": "lint_report"
      },
      "parallel_group": 10
    },
    {
      "id": "step_11",
      "skill_name": "ci0-gha-required-checks",
      "inputs": {
        "repo_slug": "from_context.repo_slug",
        "default_branch": "from_context.default_branch",
        "check_run_names": "step_6.check_run_names"
      },
      "outputs": {
        "protection_record": "protection_record"
      },
      "parallel_group": 11
    }
