{
  "name": "expense-velocity-analysis",
  "description": "Track how fast money leaves, not just how much. Separate slow leaks such as subscriptions from lumpy spends such as annual renewals, audit the leaks for waste, and set up sinking funds for the lumps so large bills do not land as shocks.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "eva-expense-collector",
      "inputs": {
        "expense-source": "from_user_input",
        "review-window": "from_user_input"
      },
      "outputs": {
        "expense-ledger": "expense-ledger",
        "timing-tags": "timing-tags"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "eva-velocity-classifier",
      "inputs": {
        "expense-ledger": "step_1.expense-ledger",
        "timing-tags": "step_1.timing-tags"
      },
      "outputs": {
        "slow-leak-set": "slow-leak-set",
        "lumpy-spend-set": "lumpy-spend-set"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "eva-leak-auditor",
      "inputs": {
        "slow-leak-set": "step_2.slow-leak-set"
      },
      "outputs": {
        "leak-findings": "leak-findings",
        "cancellable-leaks": "cancellable-leaks"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "eva-lump-planner",
      "inputs": {
        "lumpy-spend-set": "step_2.lumpy-spend-set"
      },
      "outputs": {
        "sinking-fund-plan": "sinking-fund-plan",
        "monthly-set-aside": "monthly-set-aside"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "eva-velocity-dashboard-builder",
      "inputs": {
        "leak-findings": "step_3.leak-findings",
        "sinking-fund-plan": "step_4.sinking-fund-plan"
      },
      "outputs": {
        "velocity-dashboard": "velocity-dashboard",
        "monthly-outflow-shape": "monthly-outflow-shape"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "eva-action-writer",
      "inputs": {
        "cancellable-leaks": "step_3.cancellable-leaks",
        "monthly-set-aside": "step_4.monthly-set-aside"
      },
      "outputs": {
        "velocity-report": "velocity-report",
        "expense-action-list": "expense-action-list"
      },
      "parallel_group": 6
    }
  ],
