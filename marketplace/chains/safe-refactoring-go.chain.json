      "to_step": "s06_srf_go_inline_call_gopls",
      "data_type": "srf-go-golden-master-tests",
      "field_mapping": {
        "characterization_tests": "characterization_tests"
      }
    },
    {
      "from_step": "s01_srf_baseline_green_check",
      "to_step": "s07_srf_go_rewrite_gofmt_r",
      "data_type": "srf-baseline-green-check",
