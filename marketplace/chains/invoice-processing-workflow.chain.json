{
  "name": "invoice-processing-workflow",
  "description": "Process inbound invoices from receipt through approval to payment scheduling.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "invoice-receiver",
      "inputs": {
        "invoice-source": "from_user_input",
        "vendor-name": "from_user_input"
      },
      "outputs": {
        "received-invoice": "received-invoice",
        "receipt-timestamp": "receipt-timestamp"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "invoice-field-extractor",
      "inputs": {
        "received-invoice": "step_1.received-invoice"
      },
      "outputs": {
        "extracted-fields": "extracted-fields",
        "extraction-confidence": "extraction-confidence"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "invoice-po-validator",
      "inputs": {
        "extracted-fields": "step_2.extracted-fields",
        "extraction-confidence": "step_2.extraction-confidence"
      },
      "outputs": {
        "validation-result": "validation-result",
        "variance-report": "variance-report"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "invoice-approval-router",
      "inputs": {
        "extracted-fields": "step_2.extracted-fields",
        "validation-result": "step_3.validation-result"
      },
      "outputs": {
        "approval-decision": "approval-decision",
        "approval-notes": "approval-notes"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "invoice-posting-scheduler",
      "inputs": {
        "extracted-fields": "step_2.extracted-fields",
        "approval-decision": "step_4.approval-decision"
      },
      "outputs": {
        "posting-confirmation": "posting-confirmation",
        "payment-schedule": "payment-schedule"
      },
      "parallel_group": 5
