{
  "name": "api-fuzzing-campaign",
  "description": "Run an authorized API fuzzing campaign from endpoint inventory through crash triage to exploitability assessment.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "api-endpoint-inventory",
      "inputs": {
        "api-specification": "from_user_input",
        "api-base-url": "from_user_input"
      },
      "outputs": {
        "endpoint-map": "endpoint-map",
        "auth-requirements": "auth-requirements"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "fuzz-payload-generation",
      "inputs": {
        "endpoint-catalog": "from_context.endpoint-catalog",
        "parameter-type-map": "from_context.parameter-type-map"
      },
      "outputs": {
        "payload-library": "payload-library",
        "mutation-rules": "mutation-rules"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "fuzz-execution-runner",
      "inputs": {
        "endpoint-catalog": "from_context.endpoint-catalog",
        "payload-library": "step_2.payload-library",
        "mutation-rules": "step_2.mutation-rules"
      },
      "outputs": {
        "raw-results": "raw-results",
        "coverage-metrics": "coverage-metrics"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "crash-triage-dedup",
      "inputs": {
        "raw-results": "step_3.raw-results"
      },
      "outputs": {
        "unique-findings": "unique-findings",
        "triage-summary": "triage-summary"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "finding-reproduction",
      "inputs": {
        "unique-findings": "step_4.unique-findings"
      },
      "outputs": {
        "confirmed-findings": "confirmed-findings",
        "false-positives": "false-positives"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "exploitability-assessment",
      "inputs": {
        "confirmed-findings": "step_5.confirmed-findings"
      },
      "outputs": {
        "rated-findings": "rated-findings",
        "poc-evidence": "poc-evidence"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "fuzzing-report-writer",
      "inputs": {
        "rated-findings": "step_6.rated-findings",
        "coverage-metrics": "step_3.coverage-metrics",
        "poc-evidence": "step_6.poc-evidence"
      },
      "outputs": {
        "fuzzing-report": "fuzzing-report",
        "remediation-plan": "remediation-plan"
      },
      "parallel_group": 7
    }
  ],
