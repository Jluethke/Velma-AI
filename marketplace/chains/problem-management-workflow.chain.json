{
  "name": "problem-management-workflow",
  "description": "Investigate and permanently resolve the root cause of recurring incidents.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "recurring-incident-identifier",
      "inputs": {
        "incident-data": "from_user_input",
        "threshold-criteria": "from_user_input"
      },
      "outputs": {
        "problem-candidates": "problem-candidates",
        "pattern-analysis": "pattern-analysis"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "problem-record-opener",
      "inputs": {
        "problem-candidates": "step_1.problem-candidates",
        "pattern-analysis": "step_1.pattern-analysis"
      },
      "outputs": {
        "problem-record": "problem-record",
        "investigation-scope": "investigation-scope"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "root-cause-investigator",
      "inputs": {
        "problem-record": "step_2.problem-record",
        "investigation-scope": "step_2.investigation-scope"
      },
      "outputs": {
        "root-cause": "root-cause",
        "workaround": "workaround"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "permanent-fix-developer",
      "inputs": {
        "root-cause": "step_3.root-cause",
        "problem-record": "step_2.problem-record"
      },
      "outputs": {
        "fix-implementation": "fix-implementation",
        "test-evidence": "test-evidence"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "known-error-updater",
      "inputs": {
        "problem-record": "step_2.problem-record",
        "root-cause": "step_3.root-cause",
        "fix-implementation": "step_4.fix-implementation"
      },
      "outputs": {
        "known-error-entry": "known-error-entry",
        "closed-problem-record": "closed-problem-record"
      },
      "parallel_group": 5
    }
  ],
