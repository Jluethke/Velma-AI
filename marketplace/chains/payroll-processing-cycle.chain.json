{
  "name": "payroll-processing-cycle",
  "description": "Process payroll from time collection through tax filing and register reconciliation.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "time-attendance-collector",
      "inputs": {
        "employee-roster": "from_user_input",
        "pay-period": "from_user_input"
      },
      "outputs": {
        "validated-timesheets": "validated-timesheets",
        "exceptions-list": "exceptions-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "gross-pay-calculator",
      "inputs": {
        "validated-timesheets": "step_1.validated-timesheets",
        "employee-roster": "from_context.employee-roster"
      },
      "outputs": {
        "gross-pay-register": "gross-pay-register",
        "overtime-report": "overtime-report"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "withholding-calculator",
      "inputs": {
        "gross-pay-register": "step_2.gross-pay-register",
        "employee-tax-elections": "from_context.employee-tax-elections"
      },
      "outputs": {
        "net-pay-register": "net-pay-register",
        "tax-liability-summary": "tax-liability-summary"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "paycheck-distributor",
      "inputs": {
        "net-pay-register": "step_3.net-pay-register",
        "employee-roster": "from_context.employee-roster"
      },
      "outputs": {
        "payment-file": "payment-file",
        "pay-stubs": "pay-stubs"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "payroll-tax-filer",
      "inputs": {
        "tax-liability-summary": "step_3.tax-liability-summary",
        "pay-period": "from_context.pay-period"
      },
      "outputs": {
        "tax-deposit-confirmations": "tax-deposit-confirmations",
        "quarterly-return-data": "quarterly-return-data"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "payroll-register-reconciler",
      "inputs": {
        "net-pay-register": "step_3.net-pay-register",
        "payment-file": "step_4.payment-file"
      },
      "outputs": {
        "payroll-reconciliation": "payroll-reconciliation",
        "payroll-journal-entries": "payroll-journal-entries"
      },
      "parallel_group": 6
    }
  ],
