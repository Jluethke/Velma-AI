{
  "name": "debug-and-fix",
  "description": "Drop your repo, get working code back. Scans the codebase, runs tests, parses errors, finds root cause, generates fixes, verifies with tests, reports before/after. Pure flow pipeline  --  no runtime dependencies.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "codebase-mapper",
      "inputs": {
        "repo_path": "from_user_input",
        "language_filter": "from_user_input",
        "depth": "from_user_input",
        "previous_map": "from_user_input"
      },
      "outputs": {
        "architecture_map": "architecture_map_data",
        "dependency_graph": "dependency_graph_data",
        "file_index": "file_index_data",
        "tech_stack_summary": "tech_stack_summary_data",
        "drift_report": "drift_report_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "test-coverage-generator",
      "inputs": {
        "source_code": "step_1.architecture_map",
        "existing_tests": "step_1.architecture_map",
        "coverage_report": "step_1.architecture_map",
        "test_framework": "step_1.architecture_map",
        "coverage_history": "step_1.architecture_map"
      },
      "outputs": {
        "coverage_analysis": "coverage_analysis_data",
        "prioritized_test_plan": "prioritized_test_plan_data",
        "generated_tests": "generated_tests_data",
        "validation_report": "validation_report_data",
        "coverage_summary": "coverage_summary_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "bug-root-cause",
      "inputs": {
        "error_message": "step_2.coverage_analysis",
        "stack_trace": "step_2.coverage_analysis",
        "logs": "step_2.coverage_analysis",
        "recent_changes": "step_2.coverage_analysis",
        "environment_info": "step_2.coverage_analysis",
        "bug_history": "step_2.coverage_analysis"
      },
      "outputs": {
        "root_cause_analysis": "root_cause_analysis_data",
        "fix_recommendation": "fix_recommendation_data",
        "regression_test": "regression_test_data",
        "prevention_measures": "prevention_measures_data",
        "pattern_report": "pattern_report_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "code-review",
      "inputs": {
        "diff": "step_3.root_cause_analysis",
        "pr_description": "step_3.root_cause_analysis",
        "codebase_context": "step_3.root_cause_analysis",
        "task_description": "step_3.root_cause_analysis"
      },
      "outputs": {
        "review_comments": "review_comments_data",
        "approval_decision": "approval_decision_data",
        "summary": "summary_data"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "test-coverage-generator",
      "inputs": {
        "source_code": "step_4.review_comments",
        "existing_tests": "step_4.review_comments",
        "coverage_report": "step_4.review_comments",
        "test_framework": "step_4.review_comments",
        "coverage_history": "step_4.review_comments"
      },
      "outputs": {
        "coverage_analysis": "coverage_analysis_data",
        "prioritized_test_plan": "prioritized_test_plan_data",
        "generated_tests": "generated_tests_data",
        "validation_report": "validation_report_data",
        "coverage_summary": "coverage_summary_data"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "checklist-builder",
      "inputs": {
        "goal_or_event": "step_5.coverage_analysis",
        "deadline": "step_5.coverage_analysis",
        "constraints": "step_5.coverage_analysis",
        "experience_level": "step_5.coverage_analysis"
      },
      "outputs": {
        "checklist": "checklist_data",
        "timeline": "timeline_data",
        "dont_forget": "dont_forget_data",
        "dependencies": "dependencies_data"
      },
      "parallel_group": 6
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "architecture_map",
      "field_mapping": "architecture_map -> source_code; architecture_map -> existing_tests; architecture_map -> coverage_report; architecture_map -> test_framework; architecture_map -> coverage_history"
    },
    {
      "from_step": "step_2",
      "to_step": "step_3",
      "data_type": "coverage_analysis",
      "field_mapping": "coverage_analysis -> error_message; coverage_analysis -> stack_trace; coverage_analysis -> logs; coverage_analysis -> recent_changes; coverage_analysis -> environment_info; coverage_analysis -> bug_history"
    },
    {
      "from_step": "step_3",
      "to_step": "step_4",
      "data_type": "root_cause_analysis",
      "field_mapping": "root_cause_analysis -> diff; root_cause_analysis -> pr_description; root_cause_analysis -> codebase_context; root_cause_analysis -> task_description"
    },
    {
      "from_step": "step_4",
      "to_step": "step_5",
      "data_type": "review_comments",
      "field_mapping": "review_comments -> source_code; review_comments -> existing_tests; review_comments -> coverage_report; review_comments -> test_framework; review_comments -> coverage_history"
    },
    {
      "from_step": "step_5",
      "to_step": "step_6",
      "data_type": "coverage_analysis",
      "field_mapping": "coverage_analysis -> goal_or_event; coverage_analysis -> deadline; coverage_analysis -> constraints; coverage_analysis -> experience_level"
    }
  ],
  "entry_inputs": [
    "depth",
    "language_filter",
    "previous_map",
    "repo_path"
  ],
  "terminal_outputs": [
    "checklist",
    "timeline",
    "dont_forget",
    "dependencies"
  ],
  "parallel_groups": [
    [
      "step_1"
    ],
    [
      "step_2"
    ],
    [
      "step_3"
    ],
    [
      "step_4"
    ],
    [
      "step_5"
    ],
    [
      "step_6"
    ]
  ],
  "estimated_cost": 0,
  "critical_path": [
    "step_1",
    "step_2",
    "step_3",
    "step_4",
    "step_5",
    "step_6"
  ],
  "chain_links": {
    "next_chains": [],
    "related_chains": [
      {
        "chain_name": "bug-repro-to-regression",
        "relationship": "complement"
      },
      {
        "chain_name": "something-went-wrong",
        "relationship": "complement"
      },
      {
        "chain_name": "verified-fix",
        "relationship": "complement"
      }
    ],
    "prerequisites": []
  }
}
