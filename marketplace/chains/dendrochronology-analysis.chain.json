        "crossdating-statistics": "crossdating-statistics"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "ring-width-standardization",
      "inputs": {
        "crossdated-series": "step_2.crossdated-series",
