      "skill_name": "dendrochronology-report",
      "inputs": {
        "climate-reconstruction": "step_6.climate-reconstruction",
        "verification-statistics": "step_6.verification-statistics",
        "signal-strength-statistics": "step_4.signal-strength-statistics"
      },
      "outputs": {
        "dendro-report": "dendro-report",
