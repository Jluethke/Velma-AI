      },
      "outputs": {
        "standardized-indices": "standardized-indices",
        "detrending-parameters": "detrending-parameters"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "site-chronology-builder",
      "inputs": {
