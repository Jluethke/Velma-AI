      },
      "outputs": {
        "site-chronology": "site-chronology",
        "signal-strength-statistics": "signal-strength-statistics"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "climate-correlation-analysis",
      "inputs": {
        "site-chronology": "step_4.site-chronology",
        "climate-records": "from_context.climate-records"
      },
      "outputs": {
        "correlation-results": "correlation-results",
        "response-function": "response-function"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "paleoclimate-reconstruction",
      "inputs": {
