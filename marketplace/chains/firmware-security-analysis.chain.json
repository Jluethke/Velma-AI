      },
      "outputs": {
        "extracted-filesystem": "extracted-filesystem",
        "firmware-metadata": "firmware-metadata"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "firmware-credential-search",
      "inputs": {
        "extracted-filesystem": "step_1.extracted-filesystem",
        "firmware-metadata": "step_1.firmware-metadata"
      },
      "outputs": {
        "credential-findings": "credential-findings",
        "crypto-material-inventory": "crypto-material-inventory"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "firmware-boot-chain-analyzer",
      "inputs": {
        "extracted-filesystem": "step_1.extracted-filesystem",
