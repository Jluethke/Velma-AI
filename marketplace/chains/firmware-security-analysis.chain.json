      },
      "outputs": {
        "boot-chain-findings": "boot-chain-findings",
        "trust-chain-map": "trust-chain-map"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "firmware-web-interface-test",
      "inputs": {
        "device-model": "from_context.device-model",
        "credential-findings": "step_2.credential-findings"
      },
      "outputs": {
        "web-interface-findings": "web-interface-findings",
        "command-injection-paths": "command-injection-paths"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "firmware-update-integrity-test",
      "inputs": {
        "device-model": "from_context.device-model",
        "firmware-metadata": "step_1.firmware-metadata"
      },
      "outputs": {
        "update-mechanism-findings": "update-mechanism-findings",
        "downgrade-attack-status": "downgrade-attack-status"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "firmware-security-report-compiler",
      "inputs": {
        "credential-findings": "step_2.credential-findings",
        "boot-chain-findings": "step_3.boot-chain-findings",
        "web-interface-findings": "step_4.web-interface-findings",
        "update-mechanism-findings": "step_5.update-mechanism-findings"
      },
      "outputs": {
        "firmware-security-report": "firmware-security-report",
        "remediation-priority-list": "remediation-priority-list"
      },
      "parallel_group": 6
    }
