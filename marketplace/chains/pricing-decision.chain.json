{
  "name": "pricing-decision",
  "description": "How much should you charge? Whether it's a freelance rate, product price, course fee, or service package. Research competitors, build a comparison matrix, simulate pricing models, assess risks of pricing too high or low, and produce a pricing recommendation.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "competitor-teardown",
      "inputs": {
        "company_profile": "from_user_input",
        "known_competitors": "from_user_input",
        "product_features": "from_user_input",
        "market_context": "from_user_input"
      },
      "outputs": {
        "competitor_profiles": "competitor_profiles",
        "feature_matrix": "feature_matrix",
        "positioning_map": "positioning_map",
        "gap_analysis": "gap_analysis",
        "strategic_recommendations": "strategic_recommendations"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "comparison-matrix",
      "inputs": {
        "options": "from_context.options",
        "criteria": "from_context.criteria",
        "context": "from_context.context",
        "dealbreakers": "from_context.dealbreakers"
      },
      "outputs": {
        "comparison_matrix": "comparison_matrix",
        "ranking": "ranking",
        "tradeoff_summary": "tradeoff_summary",
        "recommendation": "recommendation",
        "sensitivity_flags": "sensitivity_flags"
      },
      "parallel_group": 2
    },
    {
