{
  "name": "continuity-plan-builder",
  "description": "Build a business or personal continuity plan. For each critical activity: maximum tolerable downtime, required resources, recovery sequence. Define the triggers, the command structure, the first three actions, and the communication plan. Test annually. A plan that has never been tested is a document, not a plan.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "business-impact-analyzer",
      "inputs": {
        "organization-profile": "from_user_input",
        "system-inventory": "from_user_input"
      },
      "outputs": {
        "impact-analysis": "impact-analysis",
        "dependency-map": "dependency-map"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "disruption-scenario-definer",
      "inputs": {
        "impact-analysis": "step_1.impact-analysis",
        "operation-description": "from_context.operation-description"
      },
      "outputs": {
        "trigger-scenarios": "trigger-scenarios",
        "scenario-severity-levels": "scenario-severity-levels"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "command-structure-builder",
      "inputs": {
        "trigger-scenarios": "step_2.trigger-scenarios",
        "recovery-priority-order": "from_context.recovery-priority-order"
      },
      "outputs": {
        "command-structure": "command-structure",
        "succession-plan": "succession-plan"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "first-72-hour-playbook",
      "inputs": {
        "command-structure": "step_3.command-structure",
        "trigger-scenarios": "step_2.trigger-scenarios"
      },
      "outputs": {
        "first-72-hour-actions": "first-72-hour-actions",
        "communication-templates": "communication-templates"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "recovery-procedure-writer",
      "inputs": {
        "recovery-priority-order": "from_context.recovery-priority-order",
        "impact-analysis": "step_1.impact-analysis"
      },
      "outputs": {
        "recovery-procedures": "recovery-procedures",
        "resource-requirements": "resource-requirements"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "continuity-plan-test",
      "inputs": {
        "first-72-hour-actions": "step_4.first-72-hour-actions",
        "recovery-procedures": "step_5.recovery-procedures"
      },
      "outputs": {
        "test-results": "test-results",
        "updated-continuity-plan": "updated-continuity-plan"
      },
      "parallel_group": 6
    }
  ],
