      "skill_name": "batch-cooking-scheduler",
      "inputs": {
        "recipe_list": "step_2.recipe_list",
        "available_prep_days": "from_context.available_prep_days",
        "kitchen_equipment": "from_context.kitchen_equipment"
      },
      "outputs": {
        "prep_schedule": "prep_schedule",
        "equipment_timeline": "equipment_timeline",
        "prep_order": "prep_order"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "grocery-list-generator",
