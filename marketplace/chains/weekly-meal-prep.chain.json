{
  "name": "weekly-meal-prep",
  "description": "Plan a full week of meals: dietary needs, recipe selection, prep schedule, batch cooking strategy, and storage plan.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "dietary-needs-assessment",
      "inputs": {
        "household_members": "from_user_input",
        "dietary_restrictions": "from_user_input",
        "nutritional_goals": "from_user_input"
      },
      "outputs": {
        "dietary_profile": "dietary_profile",
        "calorie_targets": "calorie_targets",
        "ingredient_blacklist": "ingredient_blacklist"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "weekly-recipe-selector",
      "inputs": {
        "dietary_profile": "step_1.dietary_profile",
        "calorie_targets": "step_1.calorie_targets",
        "prep_time_budget": "from_context.prep_time_budget"
      },
      "outputs": {
        "weekly_menu": "weekly_menu",
        "recipe_list": "recipe_list",
        "ingredient_overlap": "ingredient_overlap"
      },
      "parallel_group": 2
    },
    {
