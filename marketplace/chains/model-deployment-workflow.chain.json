{
  "name": "model-deployment-workflow",
  "description": "Deploy a trained machine learning model to production with serving infrastructure.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "model-packager",
      "inputs": {
        "trained-model": "from_user_input",
        "deployment-target": "from_user_input"
      },
      "outputs": {
        "packaged-model": "packaged-model",
        "dependency-manifest": "dependency-manifest"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "serving-infrastructure-setup",
      "inputs": {
        "packaged-model": "step_1.packaged-model",
        "performance-requirements": "from_context.performance-requirements"
      },
      "outputs": {
        "serving-endpoint": "serving-endpoint",
        "infrastructure-config": "infrastructure-config"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "input-validation-layer",
      "inputs": {
        "serving-endpoint": "step_2.serving-endpoint",
        "input-schema": "from_context.input-schema"
      },
      "outputs": {
        "validated-endpoint": "validated-endpoint",
        "validation-rules": "validation-rules"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "autoscaling-configurator",
      "inputs": {
        "infrastructure-config": "step_2.infrastructure-config",
        "traffic-estimates": "from_context.traffic-estimates"
      },
      "outputs": {
        "scaling-config": "scaling-config",
        "cost-estimate": "cost-estimate"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "traffic-splitting-setup",
      "inputs": {
        "validated-endpoint": "step_3.validated-endpoint",
        "rollout-strategy": "from_context.rollout-strategy"
      },
      "outputs": {
        "traffic-config": "traffic-config",
        "rollout-plan": "rollout-plan"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "deployment-runbook-writer",
      "inputs": {
        "rollout-plan": "step_5.rollout-plan",
        "scaling-config": "step_4.scaling-config"
      },
      "outputs": {
        "deployment-runbook": "deployment-runbook",
        "rollback-procedure": "rollback-procedure"
      },
      "parallel_group": 6
    }
  ],
