      "skill_name": "stationarity-tester",
      "inputs": {
        "cleaned-series": "step_1.cleaned-series"
      },
      "outputs": {
        "stationarity-result": "stationarity-result",
        "differencing-recommendation": "differencing-recommendation"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "trend-seasonal-decomposer",
      "inputs": {
        "cleaned-series": "step_1.cleaned-series",
        "stationarity-result": "step_2.stationarity-result"
      },
      "outputs": {
        "trend-component": "trend-component",
        "seasonal-component": "seasonal-component",
        "residual-component": "residual-component"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "structural-break-tester",
      "inputs": {
        "cleaned-series": "step_1.cleaned-series",
        "residual-component": "step_3.residual-component"
      },
      "outputs": {
        "break-points": "break-points",
        "regime-descriptions": "regime-descriptions"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "forecast-generator",
      "inputs": {
        "trend-component": "step_3.trend-component",
        "seasonal-component": "step_3.seasonal-component",
        "break-points": "step_4.break-points"
      },
      "outputs": {
        "forecast": "forecast",
        "prediction-intervals": "prediction-intervals"
      },
      "parallel_group": 5
    },
    {
