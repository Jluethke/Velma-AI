{
  "name": "data-investigation",
  "description": "Investigate a data question end to end: decompose the problem, research context, build the data pipeline, detect KPI anomalies, and explain the dashboard.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "problem-decomposer",
      "inputs": {
        "problem_statement": "from_user_input",
        "constraints": "from_user_input",
        "stakeholders": "from_user_input",
        "context": "from_user_input",
        "known_sub_problems": "from_user_input"
      },
      "outputs": {
        "decomposition_tree": "decomposition_tree_data",
        "dependency_graph": "dependency_graph_data",
        "critical_path": "critical_path_data",
        "execution_roadmap": "execution_roadmap_data",
        "completeness_validation": "completeness_validation_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "research-synthesizer",
      "inputs": {
        "research_question": "from_context.research_question",
        "source_types": "from_context.source_types",
        "depth_level": "from_context.depth_level",
        "existing_knowledge": "from_context.existing_knowledge",
        "constraints": "from_context.constraints"
      },
      "outputs": {
        "executive_summary": "object",
        "detailed_findings": "object",
        "source_credibility_scores": "object",
        "confidence_levels": "object",
        "knowledge_gaps": "object",
        "contradiction_report": "object"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "data-pipeline",
      "inputs": {
        "data_sources": "step_2.executive_summary",
        "destination": "step_2.executive_summary",
        "freshness_requirements": "step_2.executive_summary",
        "volume_estimate": "step_2.executive_summary",
        "task_description": "step_2.executive_summary"
      },
      "outputs": {
        "pipeline_architecture": "pipeline_architecture_data",
        "pipeline_code": "pipeline_code_data",
        "quality_checks": "quality_checks_data",
        "monitoring_config": "monitoring_config_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "kpi-anomaly-detector",
      "inputs": {
        "kpi_data": "step_3.pipeline_architecture",
        "kpi_metadata": "step_3.pipeline_architecture",
        "alert_history": "step_3.pipeline_architecture",
        "detection_config": "step_3.pipeline_architecture"
      },
      "outputs": {
        "anomaly_report": "anomaly_report_data",
        "alert_list": "alert_list_data",
        "baseline_update": "baseline_update_data",
        "investigation_plan": "investigation_plan_data"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "dashboard-explainer",
      "inputs": {
        "dashboard_data": "step_4.anomaly_report",
        "metric_definitions": "step_4.anomaly_report",
        "comparison_period": "step_4.anomaly_report",
        "audience": "step_4.anomaly_report"
      },
      "outputs": {
        "narrative_report": "narrative_report_data",
        "key_insights": "key_insights_data",
        "recommended_actions": "recommended_actions_data"
      },
      "parallel_group": 5
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "result",
      "field_mapping": "result -> input"
    },
    {
      "from_step": "step_2",
      "to_step": "step_3",
      "data_type": "result",
      "field_mapping": "result -> data_sources; result -> destination; result -> freshness_requirements; result -> volume_estimate; result -> task_description"
    },
    {
      "from_step": "step_3",
      "to_step": "step_4",
      "data_type": "pipeline_architecture",
      "field_mapping": "pipeline_architecture -> kpi_data; pipeline_architecture -> kpi_metadata; pipeline_architecture -> alert_history; pipeline_architecture -> detection_config"
    },
    {
      "from_step": "step_4",
      "to_step": "step_5",
      "data_type": "anomaly_report",
      "field_mapping": "anomaly_report -> dashboard_data; anomaly_report -> metric_definitions; anomaly_report -> comparison_period; anomaly_report -> audience"
    }
  ],
  "entry_inputs": [
    "constraints",
    "context",
    "known_sub_problems",
    "problem_statement",
    "stakeholders"
  ],
  "terminal_outputs": [
    "narrative_report",
    "key_insights",
    "recommended_actions"
  ],
  "parallel_groups": [
    [
      "step_1"
    ],
    [
      "step_2"
    ],
    [
      "step_3"
    ],
    [
      "step_4"
    ],
    [
      "step_5"
    ]
  ],
  "estimated_cost": 0,
  "critical_path": [
    "step_1",
    "step_2",
    "step_3",
    "step_4",
    "step_5"
  ],
