      },
      "outputs": {
        "area-map": "area-map",
        "stratification-plan": "stratification-plan"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "sampling-method-selector",
      "inputs": {
        "survey-objectives": "from_context.survey-objectives",
