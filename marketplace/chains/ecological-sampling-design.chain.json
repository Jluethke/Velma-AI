      },
      "outputs": {
        "sampling-protocol": "sampling-protocol",
        "effort-allocation": "effort-allocation"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "field-data-collector",
      "inputs": {
        "sampling-protocol": "step_2.sampling-protocol",
        "effort-allocation": "step_2.effort-allocation"
      },
      "outputs": {
        "species-abundance-matrix": "species-abundance-matrix",
        "environmental-data": "environmental-data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "accumulation-curve-builder",
