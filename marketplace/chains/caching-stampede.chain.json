        "stack": "from_user_input"
      },
      "outputs": {
        "cache_metrics": "cache_metrics"
      },
      "parallel_group": 3
    },
    {
      "id": "s06_cache_hit_rate_latency_measure",
      "skill_name": "cache-hit-rate-latency-measure",
      "inputs": {
        "cache_metrics": "s05_cache_hit_miss_instrument.cache_metrics",
        "baseline_metrics": "from_user_input",
        "redis_url": "from_user_input_optional"
      },
      "outputs": {
        "cache_effect_report": "cache_effect_report"
      },
      "parallel_group": 4
    }
  ],
