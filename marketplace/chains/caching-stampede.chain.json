        "ttl_table": "from_user_input",
        "deployment_topology": "from_user_input"
      },
      "outputs": {
        "stampede_plan": "stampede_plan"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_cache_stampede_request_coalescing",
      "skill_name": "cache-stampede-request-coalescing",
      "inputs": {
        "repo_path": "from_user_input",
        "stampede_plan": "s01_cache_stampede_risk_assess.stampede_plan",
        "stack": "from_user_input"
      },
      "outputs": {
        "coalescing_change": "coalescing_change"
      },
      "condition": "'coalescing' in stampede_plan.techniques",
      "parallel_group": 2
    },
    {
      "id": "s03_cache_stampede_redis_lock",
      "skill_name": "cache-stampede-redis-lock",
      "inputs": {
