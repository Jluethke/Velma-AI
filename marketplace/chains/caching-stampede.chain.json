      },
      "outputs": {
        "lock_guard_change": "lock_guard_change"
      },
      "condition": "'lock' in stampede_plan.techniques",
      "parallel_group": 2
    },
    {
      "id": "s04_cache_stampede_xfetch_early_expiry",
      "skill_name": "cache-stampede-xfetch-early-expiry",
      "inputs": {
        "repo_path": "from_user_input",
        "ttl_table": "from_user_input",
        "stampede_plan": "s01_cache_stampede_risk_assess.stampede_plan",
        "stack": "from_user_input"
      },
      "outputs": {
        "early_expiry_change": "early_expiry_change"
      },
      "condition": "'early_expiry' in stampede_plan.techniques",
      "parallel_group": 2
    },
    {
      "id": "s05_cache_hit_miss_instrument",
      "skill_name": "cache-hit-miss-instrument",
