{
  "name": "opportunity-cost-calculator",
  "description": "Make the hidden cost of every decision visible. Every time you allocate a resource (money, time, attention, people) to one use, you lose the best alternative use. The opportunity cost is the value of the road not taken. Most bad decisions result from ignoring opportunity costs, not from miscalculating direct costs.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "alternative-use-brainstormer",
      "inputs": {
        "resource-description": "from_user_input",
        "proposed-use": "from_user_input",
        "resource-amount": "from_user_input"
      },
      "outputs": {
        "alternative-uses": "alternative-uses",
        "best-alternative": "best-alternative"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "opportunity-cost-quantifier",
      "inputs": {
        "proposed-use": "from_context.proposed-use",
        "best-alternative": "step_1.best-alternative"
      },
      "outputs": {
        "true-cost-calculation": "true-cost-calculation",
        "decision-threshold": "decision-threshold"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "sunk-cost-separator",
      "inputs": {
        "true-cost-calculation": "step_2.true-cost-calculation",
        "proposed-use": "from_context.proposed-use"
      },
      "outputs": {
        "forward-looking-analysis": "forward-looking-analysis",
        "sunk-cost-inventory": "sunk-cost-inventory"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "opportunity-cost-decision-log",
      "inputs": {
        "forward-looking-analysis": "step_3.forward-looking-analysis",
        "alternative-uses": "step_1.alternative-uses"
      },
      "outputs": {
        "decision-record": "decision-record",
        "review-date": "review-date"
      },
      "parallel_group": 4
    }
  ],
