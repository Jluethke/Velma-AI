{
  "name": "safety-critical-cpp-static-analysis",
  "description": "Choose the coding standard, apply compiler warning sets, clang-tidy and Cppcheck MISRA checks, triage the findings and write deviation records.",
  "steps": [
    {
      "id": "s01_sccpp_standard_select",
      "skill_name": "sccpp-standard-select",
      "inputs": {
        "language": "from_user_input",
        "codebase_dir": "from_user_input",
        "integrity_level": "from_user_input_optional"
      },
      "outputs": {
        "guideline_plan": "guideline_plan"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_sccpp_cmake_build_profiles",
      "skill_name": "sccpp-cmake-build-profiles",
      "inputs": {
        "codebase_dir": "from_user_input",
        "stack": "from_user_input",
        "language": "from_user_input",
        "toolchain_file": "from_user_input_optional"
      },
      "outputs": {
        "build_profiles": "build_profiles"
      },
      "parallel_group": 1
    },
    {
      "id": "s03_sccpp_gcc_warning_set",
      "skill_name": "sccpp-gcc-warning-set",
      "inputs": {
        "codebase_dir": "from_user_input",
        "build_profiles": "s02_sccpp_cmake_build_profiles.build_profiles",
        "language": "from_user_input"
      },
      "outputs": {
        "gcc_warning_report": "gcc_warning_report"
      },
      "condition": "stack == 'gcc'",
      "parallel_group": 2
    },
    {
      "id": "s04_sccpp_clang_warning_set",
      "skill_name": "sccpp-clang-warning-set",
      "inputs": {
        "codebase_dir": "from_user_input",
        "build_profiles": "s02_sccpp_cmake_build_profiles.build_profiles",
        "language": "from_user_input"
      },
      "outputs": {
        "clang_warning_report": "clang_warning_report"
      },
      "condition": "stack == 'clang'",
      "parallel_group": 2
    },
    {
      "id": "s05_sccpp_clang_tidy_config",
      "skill_name": "sccpp-clang-tidy-config",
      "inputs": {
        "codebase_dir": "from_user_input",
        "build_profiles": "s02_sccpp_cmake_build_profiles.build_profiles",
