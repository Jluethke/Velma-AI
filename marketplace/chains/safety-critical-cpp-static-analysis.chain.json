      },
      "outputs": {
        "clang_tidy_findings": "clang_tidy_findings"
      },
      "parallel_group": 2
    },
    {
      "id": "s06_sccpp_cppcheck_misra_c",
      "skill_name": "sccpp-cppcheck-misra-c",
      "inputs": {
        "codebase_dir": "from_user_input",
        "build_profiles": "s02_sccpp_cmake_build_profiles.build_profiles",
        "misra_rule_texts": "from_user_input_optional"
      },
      "outputs": {
        "cppcheck_findings": "cppcheck_findings"
      },
      "condition": "language == 'c'",
      "parallel_group": 2
    },
    {
      "id": "s07_sccpp_findings_triage",
      "skill_name": "sccpp-findings-triage",
      "inputs": {
        "guideline_plan": "s01_sccpp_standard_select.guideline_plan",
        "gcc_warning_report": "s03_sccpp_gcc_warning_set.gcc_warning_report",
        "clang_warning_report": "s04_sccpp_clang_warning_set.clang_warning_report",
