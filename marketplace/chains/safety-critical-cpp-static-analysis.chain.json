        "cppcheck_findings": "s06_sccpp_cppcheck_misra_c.cppcheck_findings"
      },
      "outputs": {
        "triaged_findings": "triaged_findings",
        "deviation_candidates": "deviation_candidates"
      },
      "parallel_group": 3
    },
    {
      "id": "s08_sccpp_deviation_record",
      "skill_name": "sccpp-deviation-record",
      "inputs": {
        "deviation_candidates": "s07_sccpp_findings_triage.deviation_candidates",
        "guideline_plan": "s01_sccpp_standard_select.guideline_plan"
      },
      "outputs": {
        "deviation_records": "deviation_records"
      },
      "parallel_group": 4
    }
