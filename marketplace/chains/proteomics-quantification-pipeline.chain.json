        "normalized-abundances": "step_4.normalized-abundances",
        "experimental-design": "from_context.experimental-design"
      },
      "outputs": {
        "de-results": "de-results",
        "volcano-plot-data": "volcano-plot-data"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
