      "outputs": {
        "processed-spectra": "processed-spectra",
        "preprocessing-report": "preprocessing-report"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "database-searcher",
      "inputs": {
        "processed-spectra": "step_1.processed-spectra",
        "search-database": "from_context.search-database"
      },
      "outputs": {
        "peptide-spectrum-matches": "peptide-spectrum-matches",
        "search-statistics": "search-statistics"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "fdr-controller",
      "inputs": {
        "peptide-spectrum-matches": "step_2.peptide-spectrum-matches",
