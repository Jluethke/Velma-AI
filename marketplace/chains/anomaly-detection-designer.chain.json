{
  "name": "anomaly-detection-designer",
  "description": "Build a system that spots unusual patterns without generating false alarms. Define the baseline from history, set detection thresholds using standard deviations, choose between static and dynamic baselines, and configure cool-down periods. Works for server metrics, financial data, health tracking, or any time series.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "baseline-profiler",
      "inputs": {
        "metric-to-monitor": "from_user_input",
        "historical-data-range": "from_user_input"
      },
      "outputs": {
        "baseline-profile": "baseline-profile",
        "baseline-quality": "baseline-quality"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "threshold-type-selector",
      "inputs": {
        "baseline-profile": "step_1.baseline-profile",
        "baseline-quality": "step_1.baseline-quality"
      },
      "outputs": {
        "threshold-type": "threshold-type",
        "threshold-parameters": "threshold-parameters"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "sensitivity-calibrator",
      "inputs": {
        "threshold-type": "step_2.threshold-type",
        "metric-to-monitor": "from_context.metric-to-monitor"
      },
      "outputs": {
        "sensitivity-level": "sensitivity-level",
        "expected-false-positive-rate": "expected-false-positive-rate"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "cooldown-and-dedup-config",
      "inputs": {
        "sensitivity-level": "step_3.sensitivity-level",
        "threshold-parameters": "step_2.threshold-parameters"
      },
      "outputs": {
        "cooldown-config": "cooldown-config",
        "dedup-rules": "dedup-rules"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "anomaly-response-protocol",
      "inputs": {
        "cooldown-config": "step_4.cooldown-config",
        "metric-to-monitor": "from_context.metric-to-monitor"
      },
      "outputs": {
        "response-protocol": "response-protocol",
        "anomaly-detection-system": "anomaly-detection-system"
      },
      "parallel_group": 5
    }
  ],
