{
  "name": "bayesian-update-framework",
  "description": "Apply Bayesian reasoning to real-world decisions. Start with a prior belief, define the evidence that would update it, and update systematically as evidence arrives. The key discipline: write down the prior and the update rules BEFORE seeing the evidence, to prevent motivated reasoning. Works for hiring assessments, market hypotheses, medical decisions, or any situation where you are updating beliefs based on new information.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "hypothesis-and-prior-setter",
      "inputs": {
        "hypothesis": "from_user_input",
        "base-rate-information": "from_user_input"
      },
      "outputs": {
        "stated-prior": "stated-prior",
        "base-rate-anchor": "base-rate-anchor"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "evidence-definition-planner",
      "inputs": {
        "stated-prior": "step_1.stated-prior",
        "hypothesis": "from_context.hypothesis"
      },
      "outputs": {
        "evidence-plan": "evidence-plan",
        "strongest-evidence": "strongest-evidence"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "evidence-collection-and-update",
      "inputs": {
        "evidence-plan": "step_2.evidence-plan",
        "stated-prior": "step_1.stated-prior"
      },
      "outputs": {
        "updated-probability": "updated-probability",
        "evidence-log": "evidence-log"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "surprise-and-anomaly-checker",
      "inputs": {
        "evidence-log": "step_3.evidence-log",
        "updated-probability": "step_3.updated-probability"
      },
      "outputs": {
        "surprise-list": "surprise-list",
        "model-revision-needed": "model-revision-needed"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "decision-threshold-applier",
      "inputs": {
        "updated-probability": "step_3.updated-probability",
        "hypothesis": "from_context.hypothesis"
      },
      "outputs": {
        "decision": "decision",
        "remaining-uncertainty": "remaining-uncertainty"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "bayesian-calibration-record",
      "inputs": {
        "stated-prior": "step_1.stated-prior",
        "evidence-log": "step_3.evidence-log",
        "decision": "step_5.decision"
      },
      "outputs": {
        "bayesian-record": "bayesian-record",
        "outcome-check-date": "outcome-check-date"
      },
      "parallel_group": 6
    }
  ],
