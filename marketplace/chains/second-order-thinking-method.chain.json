{
  "name": "second-order-thinking-method",
  "description": "For every decision ask 'and then what?' several times, mapping the first, second, and third order effects before you choose.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "secondorder-name-the-decision",
      "inputs": {
        "decision-statement": "from_user_input",
        "decision-context": "from_user_input"
      },
      "outputs": {
        "decision-defined": "decision-defined",
        "obvious-effect": "obvious-effect"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "secondorder-map-first-effects",
      "inputs": {
        "decision-defined": "step_1.decision-defined",
        "obvious-effect": "step_1.obvious-effect"
      },
      "outputs": {
        "first-order-effects": "first-order-effects",
        "first-order-notes": "first-order-notes"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "secondorder-ask-and-then-what-first",
      "inputs": {
        "first-order-effects": "step_2.first-order-effects",
        "first-order-notes": "step_2.first-order-notes"
      },
      "outputs": {
        "second-order-effects": "second-order-effects",
        "second-order-notes": "second-order-notes"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "secondorder-ask-and-then-what-second",
