      },
      "outputs": {
        "third-order-effects": "third-order-effects",
        "order-chain": "order-chain"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "secondorder-weight-by-probability",
      "inputs": {
        "third-order-effects": "step_4.third-order-effects",
        "order-chain": "step_4.order-chain"
      },
      "outputs": {
        "weighted-effects": "weighted-effects",
        "likely-branches": "likely-branches"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "secondorder-score-net-effect",
      "inputs": {
        "weighted-effects": "step_5.weighted-effects",
        "likely-branches": "step_5.likely-branches"
      },
      "outputs": {
        "net-score": "net-score",
        "hidden-costs": "hidden-costs"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "secondorder-decide-with-full-picture",
      "inputs": {
        "net-score": "step_6.net-score",
        "hidden-costs": "step_6.hidden-costs"
      },
      "outputs": {
        "decision-call": "decision-call",
        "decision-rationale": "decision-rationale"
      },
      "parallel_group": 7
    }
  ],
