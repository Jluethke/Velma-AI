{
  "name": "master-weekly",
  "description": "Master weekly chain. Runs every domain in parallel first (vehicle health, home maintenance, portfolio + net worth, fitness progress, subscription audit), then funnels into budget builder and weekly scorecard, then weekly review synthesizes everything. 11 steps, 3 stages.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "vehicle-health",
      "inputs": {
        "vehicle": "from_user_input",
        "scan_scope": "from_user_input",
        "history": "from_user_input"
      },
      "outputs": {
        "module_status": "module_status_data",
        "dtc_report": "dtc_report_data",
        "signal_health": "signal_health_data",
        "trend_analysis": "trend_analysis_data",
        "action_plan": "action_plan_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "maintenance-schedule",
      "inputs": {
        "vehicle": "step_1.module_status",
        "mileage": "step_1.module_status",
        "service_history": "step_1.module_status",
        "driving_conditions": "step_1.module_status"
      },
      "outputs": {
        "interval_map": "interval_map_data",
        "current_status": "current_status_data",
        "calendar": "calendar_data",
        "cost_forecast": "cost_forecast_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "home-status",
      "inputs": {
        "devices": "from_user_input",
        "schedule": "from_user_input",
        "preferences": "from_user_input",
        "recent_alerts": "from_user_input"
      },
      "outputs": {
        "status_board": "status_board_data",
        "anomalies": "anomalies_data",
        "action_items": "action_items_data",
        "efficiency_note": "efficiency_note_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_4",
      "skill_name": "home-maintenance",
      "inputs": {
        "home": "step_3.status_board",
        "outdoor": "step_3.status_board",
        "appliances": "step_3.status_board",
        "last_done": "step_3.status_board",
        "climate": "step_3.status_board"
      },
      "outputs": {
        "maintenance_calendar": "maintenance_calendar_data",
        "overdue_list": "overdue_list_data",
        "task_cards": "task_cards_data",
        "annual_budget": "annual_budget_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_5",
      "skill_name": "portfolio-check",
      "inputs": {
        "holdings": "from_user_input",
        "allocation_targets": "from_user_input",
        "time_horizon": "from_user_input"
      },
      "outputs": {
        "holdings_summary": "holdings_summary_data",
        "performance_report": "performance_report_data",
        "allocation_analysis": "allocation_analysis_data",
        "rebalance_actions": "rebalance_actions_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_6",
      "skill_name": "net-worth-tracker",
      "inputs": {
        "assets": "step_5.holdings_summary",
        "liabilities": "step_5.holdings_summary",
        "prior_snapshot": "step_5.holdings_summary"
      },
      "outputs": {
        "net_worth_statement": "net_worth_statement_data",
        "change_report": "change_report_data",
        "milestone_tracker": "milestone_tracker_data",
        "projection": "projection_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_7",
      "skill_name": "subscription-audit",
      "inputs": {
        "known_subscriptions": "from_user_input",
        "bank_statement_data": "from_user_input",
        "household_size": "from_user_input"
      },
      "outputs": {
        "subscription_inventory": "subscription_inventory_data",
        "categorized_assessment": "categorized_assessment_data",
        "savings_opportunities": "savings_opportunities_data",
        "cancellation_plan": "cancellation_plan_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_8",
      "skill_name": "fitness-progress",
      "inputs": {
        "training_history": "from_user_input",
        "body_measurements": "from_user_input",
        "time_window": "from_user_input"
      },
      "outputs": {
        "strength_trends": "strength_trends_data",
        "body_composition_trends": "body_composition_trends_data",
        "cardio_trends": "cardio_trends_data",
        "progress_summary": "progress_summary_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_9",
      "skill_name": "budget-builder",
      "inputs": {
        "income": "step_6.net_worth_statement",
        "fixed_expenses": "step_6.net_worth_statement",
        "variable_spending": "step_6.net_worth_statement",
        "financial_situation": "step_6.net_worth_statement",
        "goals": "step_6.net_worth_statement"
      },
      "outputs": {
        "spending_snapshot": "spending_snapshot_data",
        "monthly_budget": "monthly_budget_data",
        "bleed_points": "bleed_points_data",
        "action_plan": "action_plan_data",
        "monthly_checkup": "monthly_checkup_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_10",
      "skill_name": "weekly-scorecard",
      "inputs": {
        "week_ending:string": "step_2.interval_map",
        "domains:array": "step_2.interval_map"
      },
      "outputs": {
        "scorecard:object": "scorecard:object_data",
        "grades:object": "grades:object_data",
        "trends:object": "trends:object_data",
        "next_week_actions:array": "next_week_actions:array_data"
      },
      "parallel_group": 4
    },
    {
      "id": "step_11",
      "skill_name": "weekly-review",
      "inputs": {
        "last_week_goals": "step_10.scorecard:object",
        "what_happened": "step_10.scorecard:object",
        "wins": "step_10.scorecard:object",
        "frustrations": "step_10.scorecard:object",
        "energy_notes": "step_10.scorecard:object",
        "prior_review": "step_10.scorecard:object"
      },
      "outputs": {
        "achievement_summary": "achievement_summary_data",
        "goal_scorecard": "goal_scorecard_data",
        "lessons_learned": "lessons_learned_data",
        "pattern_report": "pattern_report_data",
        "energy_audit": "energy_audit_data",
        "next_week_priorities": "next_week_priorities_data",
        "commitment_statement": "commitment_statement_data"
      },
      "parallel_group": 5
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "module_status",
      "field_mapping": "module_status -> vehicle; module_status -> mileage; module_status -> service_history; module_status -> driving_conditions"
