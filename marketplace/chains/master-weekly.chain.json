      "data_type": "scorecard:object",
      "field_mapping": "scorecard:object -> last_week_goals; scorecard:object -> what_happened; scorecard:object -> wins; scorecard:object -> frustrations; scorecard:object -> energy_notes; scorecard:object -> prior_review"
    }
  ],
