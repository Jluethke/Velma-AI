{
  "name": "failure-conditions-analyzer",
  "description": "Move beyond 'what went wrong' to 'what were the conditions that made failure likely.' Map the contributing conditions (understaffing, time pressure, ambiguous procedures, fatigue, missing information). These conditions existed before the failure. Fix the conditions, not just the proximate cause.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "incident-timeline-builder",
      "inputs": {
        "incident-description": "from_user_input",
        "incident-data": "from_user_input"
      },
      "outputs": {
        "incident-timeline": "incident-timeline",
        "proximate-cause": "proximate-cause"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "contributing-conditions-mapper",
      "inputs": {
        "incident-timeline": "step_1.incident-timeline",
        "proximate-cause": "step_1.proximate-cause"
      },
      "outputs": {
        "condition-map": "condition-map",
        "defense-failures": "defense-failures"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "condition-persistence-checker",
      "inputs": {
        "condition-map": "step_2.condition-map",
        "defense-failures": "step_2.defense-failures"
      },
      "outputs": {
        "persistent-conditions": "persistent-conditions",
        "recurrence-risk": "recurrence-risk"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "condition-remediation-planner",
      "inputs": {
        "persistent-conditions": "step_3.persistent-conditions",
        "defense-failures": "step_2.defense-failures"
      },
      "outputs": {
        "condition-fixes": "condition-fixes",
        "defense-repairs": "defense-repairs"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "systemic-pattern-detector",
      "inputs": {
        "condition-fixes": "step_4.condition-fixes",
        "condition-map": "step_2.condition-map"
      },
      "outputs": {
        "systemic-conditions": "systemic-conditions",
        "systemic-remediation-priority": "systemic-remediation-priority"
      },
      "parallel_group": 5
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
