      },
      "outputs": {
        "tier-cadence-rules": "tier-cadence-rules",
        "cadence-load-estimate": "cadence-load-estimate"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "pcrm-tool-mapping",
      "inputs": {
        "tier-cadence-rules": "step_4.tier-cadence-rules",
        "cadence-load-estimate": "step_4.cadence-load-estimate"
      },
      "outputs": {
