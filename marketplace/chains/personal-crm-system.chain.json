{
  "name": "personal-crm-system",
  "description": "Build a personal CRM that holds 50 to 150 contacts organized into Dunbar tiers (5 intimate, 15 close, 50 regular, 150 acquaintance), tracks what matters about each person, sets a contact cadence per tier, and surfaces follow-ups when a contact falls past its cadence. The result is a system you can run from a spreadsheet or any contact tool, not a product you have to buy.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "pcrm-contact-roster-capture",
      "inputs": {
        "contact-sources": "from_user_input",
        "time-available": "from_user_input"
      },
      "outputs": {
        "raw-contact-roster": "raw-contact-roster",
        "source-coverage-notes": "source-coverage-notes"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "pcrm-dunbar-tier-assignment",
      "inputs": {
        "raw-contact-roster": "step_1.raw-contact-roster",
        "source-coverage-notes": "step_1.source-coverage-notes"
      },
      "outputs": {
        "tiered-roster": "tiered-roster",
        "tier-overflow-flags": "tier-overflow-flags"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "pcrm-context-field-design",
      "inputs": {
        "tiered-roster": "step_2.tiered-roster",
        "tier-overflow-flags": "step_2.tier-overflow-flags"
      },
      "outputs": {
        "context-field-schema": "context-field-schema",
        "field-fill-priority": "field-fill-priority"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "pcrm-cadence-rule-setter",
