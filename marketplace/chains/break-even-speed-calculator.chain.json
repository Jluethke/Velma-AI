{
  "name": "break-even-speed-calculator",
  "description": "Measure how fast an investment pays itself back rather than its total return. Divide the monthly incremental revenue or savings into the total cost to get a payback period, compare it against the planning horizon, and skip anything that pays back too slowly.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "bess-investment-scoper",
      "inputs": {
        "investment-context": "from_user_input",
        "planning-horizon": "from_user_input"
      },
      "outputs": {
        "investment-definition": "investment-definition",
        "total-cost": "total-cost"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "bess-return-estimator",
      "inputs": {
        "investment-definition": "step_1.investment-definition"
      },
      "outputs": {
        "monthly-return-estimate": "monthly-return-estimate",
        "return-assumptions": "return-assumptions"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "bess-payback-calculator",
      "inputs": {
        "total-cost": "step_1.total-cost",
        "monthly-return-estimate": "step_2.monthly-return-estimate"
      },
      "outputs": {
        "payback-months": "payback-months",
        "cumulative-curve": "cumulative-curve"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "bess-horizon-comparer",
      "inputs": {
        "payback-months": "step_3.payback-months",
        "planning-horizon": "from_context.planning-horizon"
      },
      "outputs": {
        "horizon-verdict": "horizon-verdict",
        "margin-of-safety": "margin-of-safety"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "bess-sensitivity-tester",
      "inputs": {
        "payback-months": "step_3.payback-months",
        "return-assumptions": "step_2.return-assumptions"
      },
      "outputs": {
        "sensitivity-table": "sensitivity-table",
        "breakeven-threshold": "breakeven-threshold"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "bess-decision-writer",
      "inputs": {
        "horizon-verdict": "step_4.horizon-verdict",
        "sensitivity-table": "step_5.sensitivity-table"
      },
      "outputs": {
        "payback-report": "payback-report",
        "invest-decision": "invest-decision"
      },
      "parallel_group": 6
    }
  ],
