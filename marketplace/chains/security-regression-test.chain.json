        "new-surface-findings": "step_4.new-surface-findings"
      },
      "outputs": {
        "security-delta": "security-delta",
        "coverage-gaps": "coverage-gaps"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "regression-report",
      "inputs": {
        "security-delta": "step_6.security-delta",
        "broken-controls": "step_5.broken-controls",
        "coverage-gaps": "step_6.coverage-gaps"
      },
      "outputs": {
        "regression-report": "regression-report",
        "go-nogo-recommendation": "go-nogo-recommendation"
      },
      "parallel_group": 7
    }
