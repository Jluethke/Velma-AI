{
  "name": "security-regression-test",
  "description": "Test for security regressions after code changes by comparing against a security baseline.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "change-surface-identification",
      "inputs": {
        "change-set": "from_user_input",
        "security-baseline": "from_user_input"
      },
