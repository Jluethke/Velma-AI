      "inputs": {
        "relevant-tests": "step_1.relevant-tests",
        "affected-surface": "step_1.affected-surface"
      },
      "outputs": {
        "retest-results": "retest-results",
        "pass-fail-delta": "pass-fail-delta"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "regression-vuln-check",
