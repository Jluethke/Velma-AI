        "new-risk-areas": "new-risk-areas"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "control-validation-test",
      "inputs": {
        "affected-surface": "step_1.affected-surface",
        "retest-results": "step_2.retest-results"
      },
      "outputs": {
        "control-status": "control-status",
        "broken-controls": "broken-controls"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "baseline-comparison",
      "inputs": {
        "retest-results": "step_2.retest-results",
