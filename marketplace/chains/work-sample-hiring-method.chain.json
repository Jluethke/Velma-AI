      },
      "outputs": {
        "work-sample-brief": "work-sample-brief",
        "time-and-materials-spec": "time-and-materials-spec"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "candidate-payment-structurer",
      "inputs": {
        "work-sample-brief": "step_2.work-sample-brief",
