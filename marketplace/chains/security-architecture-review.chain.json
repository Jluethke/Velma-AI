{
  "name": "security-architecture-review",
  "description": "Review the security architecture of a system by mapping trust boundaries, authentication paths, data flow protections, network segmentation, and forensic logging readiness.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "trust-boundary-mapper",
      "inputs": {
        "system-description": "from_user_input",
        "architecture-diagrams": "from_user_input"
      },
      "outputs": {
        "component-inventory": "component-inventory",
        "trust-boundary-map": "trust-boundary-map"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "authn-authz-architecture-evaluator",
      "inputs": {
        "component-inventory": "step_1.component-inventory",
        "trust-boundary-map": "step_1.trust-boundary-map"
      },
      "outputs": {
        "authn-assessment": "authn-assessment",
        "authz-assessment": "authz-assessment"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "data-flow-protection-assessor",
      "inputs": {
        "trust-boundary-map": "step_1.trust-boundary-map",
