      },
      "outputs": {
        "encryption-assessment": "encryption-assessment",
        "integrity-assessment": "integrity-assessment"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "network-segmentation-reviewer",
      "inputs": {
        "component-inventory": "step_1.component-inventory",
        "trust-boundary-map": "step_1.trust-boundary-map"
      },
      "outputs": {
        "segmentation-findings": "segmentation-findings",
        "lateral-movement-risks": "lateral-movement-risks"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "resilience-failover-security-checker",
      "inputs": {
        "component-inventory": "step_1.component-inventory",
        "segmentation-findings": "step_4.segmentation-findings"
      },
      "outputs": {
        "resilience-security-findings": "resilience-security-findings",
        "failover-exposure-map": "failover-exposure-map"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "forensic-logging-readiness-assessor",
