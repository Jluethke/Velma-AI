        "component-inventory": "step_1.component-inventory",
        "authn-assessment": "step_2.authn-assessment"
      },
      "outputs": {
        "logging-coverage-map": "logging-coverage-map",
        "forensic-readiness-score": "forensic-readiness-score"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "security-architecture-report-compiler",
      "inputs": {
        "authn-assessment": "step_2.authn-assessment",
        "encryption-assessment": "step_3.encryption-assessment",
        "segmentation-findings": "step_4.segmentation-findings",
        "forensic-readiness-score": "step_6.forensic-readiness-score"
      },
      "outputs": {
        "security-architecture-report": "security-architecture-report",
        "prioritized-remediation-list": "prioritized-remediation-list"
      },
      "parallel_group": 7
    }
