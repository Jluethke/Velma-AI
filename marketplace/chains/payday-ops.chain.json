      "field_mapping": "net_worth_statement -> income; net_worth_statement -> fixed_expenses; net_worth_statement -> variable_spending; net_worth_statement -> financial_situation; net_worth_statement -> goals"
    },
    {
      "from_step": "step_4",
      "to_step": "step_5",
      "data_type": "subscription_inventory",
      "field_mapping": "subscription_inventory -> input"
    }
  ],
  "entry_inputs": [
