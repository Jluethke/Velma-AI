{
  "name": "payday-ops",
  "description": "Payday financial picture: check markets, review portfolio against them, update net worth, audit subscriptions for waste, then rebuild the budget with all findings.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "market-brief",
      "inputs": {
        "interests": "from_user_input",
        "portfolio_context": "from_user_input",
        "period": "from_user_input"
      },
      "outputs": {
        "index_summary": "index_summary_data",
        "sector_rotation": "sector_rotation_data",
        "notable_events": "notable_events_data",
        "crypto_overview": "crypto_overview_data",
        "relevance_notes": "relevance_notes_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "portfolio-check",
      "inputs": {
        "holdings": "step_1.index_summary",
        "allocation_targets": "step_1.index_summary",
        "time_horizon": "step_1.index_summary"
      },
      "outputs": {
        "holdings_summary": "holdings_summary_data",
        "performance_report": "performance_report_data",
        "allocation_analysis": "allocation_analysis_data",
        "rebalance_actions": "rebalance_actions_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "net-worth-tracker",
      "inputs": {
        "assets": "step_2.holdings_summary",
        "liabilities": "step_2.holdings_summary",
        "prior_snapshot": "step_2.holdings_summary"
      },
      "outputs": {
        "net_worth_statement": "net_worth_statement_data",
        "change_report": "change_report_data",
        "milestone_tracker": "milestone_tracker_data",
        "projection": "projection_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "subscription-audit",
      "inputs": {
        "known_subscriptions": "from_user_input",
        "bank_statement_data": "from_user_input",
        "household_size": "from_user_input"
      },
      "outputs": {
        "subscription_inventory": "subscription_inventory_data",
        "categorized_assessment": "categorized_assessment_data",
        "savings_opportunities": "savings_opportunities_data",
        "cancellation_plan": "cancellation_plan_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_5",
      "skill_name": "budget-builder",
      "inputs": {
        "income": "step_3.net_worth_statement",
        "fixed_expenses": "step_3.net_worth_statement",
        "variable_spending": "step_3.net_worth_statement",
        "financial_situation": "step_3.net_worth_statement",
        "goals": "step_3.net_worth_statement"
      },
      "outputs": {
        "spending_snapshot": "spending_snapshot_data",
        "monthly_budget": "monthly_budget_data",
        "bleed_points": "bleed_points_data",
        "action_plan": "action_plan_data",
        "monthly_checkup": "monthly_checkup_data"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "index_summary",
      "field_mapping": "index_summary -> holdings; index_summary -> allocation_targets; index_summary -> time_horizon"
    },
    {
