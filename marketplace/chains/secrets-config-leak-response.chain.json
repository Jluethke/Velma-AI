{
  "name": "secrets-config-leak-response",
  "description": "Scan full git history with gitleaks and TruffleHog, triage findings, rotate every confirmed leak (AWS keys included), purge rotated secrets from history, and block recurrence with pre-commit and CI gates.",
  "steps": [
    {
      "id": "s01_cfg_gitleaks_scan_history",
      "skill_name": "cfg-gitleaks-scan-history",
      "inputs": {
        "repo_path": "from_user_input"
      },
      "outputs": {
        "gitleaks_report": "gitleaks_report"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_cfg_trufflehog_verify_secrets",
      "skill_name": "cfg-trufflehog-verify-secrets",
      "inputs": {
        "repo_path": "from_user_input"
      },
      "outputs": {
        "trufflehog_report": "trufflehog_report"
      },
      "parallel_group": 1
    },
    {
      "id": "s03_cfg_triage_secret_findings",
      "skill_name": "cfg-triage-secret-findings",
      "inputs": {
        "gitleaks_report": "s01_cfg_gitleaks_scan_history.gitleaks_report",
        "trufflehog_report": "s02_cfg_trufflehog_verify_secrets.trufflehog_report",
        "repo_path": "from_user_input"
      },
      "outputs": {
        "confirmed_leaks": "confirmed_leaks",
        "allowlist_changes": "allowlist_changes"
      },
      "parallel_group": 2
    },
    {
      "id": "s04_cfg_rotate_leaked_secret",
      "skill_name": "cfg-rotate-leaked-secret",
      "inputs": {
        "confirmed_leaks": "s03_cfg_triage_secret_findings.confirmed_leaks",
        "secret_store": "from_user_input_optional"
      },
      "outputs": {
        "rotation_log": "rotation_log",
        "revoked_credentials": "revoked_credentials"
      },
      "condition": "s03_cfg_triage_secret_findings.confirmed_leaks != []",
      "parallel_group": 3
    },
    {
      "id": "s05_cfg_aws_access_key_rotation",
      "skill_name": "cfg-aws-access-key-rotation",
      "inputs": {
        "confirmed_leaks": "s03_cfg_triage_secret_findings.confirmed_leaks",
        "aws_profile": "from_user_input_optional"
      },
      "outputs": {
        "aws_rotation_log": "aws_rotation_log"
      },
      "condition": "aws_profile != null and s03_cfg_triage_secret_findings.confirmed_leaks != []",
      "parallel_group": 3
    },
    {
      "id": "s06_cfg_git_filter_repo_purge",
      "skill_name": "cfg-git-filter-repo-purge",
      "inputs": {
        "confirmed_leaks": "s03_cfg_triage_secret_findings.confirmed_leaks",
        "rotation_log": "s04_cfg_rotate_leaked_secret.rotation_log",
        "repo_path": "from_user_input"
      },
      "outputs": {
        "purge_report": "purge_report"
      },
      "condition": "s03_cfg_triage_secret_findings.confirmed_leaks != []",
      "parallel_group": 4
    },
    {
      "id": "s07_cfg_precommit_gitleaks_hook",
      "skill_name": "cfg-precommit-gitleaks-hook",
      "inputs": {
        "repo_path": "from_user_input",
        "allowlist_changes": "s03_cfg_triage_secret_findings.allowlist_changes"
      },
      "outputs": {
        "precommit_config": "precommit_config"
      },
      "parallel_group": 3
    },
    {
      "id": "s08_cfg_ci_secret_scan_gate",
      "skill_name": "cfg-ci-secret-scan-gate",
      "inputs": {
        "repo_path": "from_user_input",
        "ci_platform": "from_user_input",
        "allowlist_changes": "s03_cfg_triage_secret_findings.allowlist_changes"
      },
      "outputs": {
        "ci_scan_job": "ci_scan_job"
      },
      "parallel_group": 3
    }
  ],
  "edges": [
    {
      "from_step": "s01_cfg_gitleaks_scan_history",
      "to_step": "s03_cfg_triage_secret_findings",
      "data_type": "cfg-gitleaks-scan-history",
