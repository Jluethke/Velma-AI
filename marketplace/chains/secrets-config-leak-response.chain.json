      "data_type": "cfg-triage-secret-findings",
      "field_mapping": {
        "confirmed_leaks": "confirmed_leaks"
      }
    },
    {
      "from_step": "s03_cfg_triage_secret_findings",
      "to_step": "s06_cfg_git_filter_repo_purge",
      "data_type": "cfg-triage-secret-findings",
      "field_mapping": {
        "confirmed_leaks": "confirmed_leaks"
      }
    },
    {
      "from_step": "s04_cfg_rotate_leaked_secret",
      "to_step": "s06_cfg_git_filter_repo_purge",
      "data_type": "cfg-rotate-leaked-secret",
      "field_mapping": {
        "rotation_log": "rotation_log"
      }
    },
    {
      "from_step": "s03_cfg_triage_secret_findings",
      "to_step": "s07_cfg_precommit_gitleaks_hook",
      "data_type": "cfg-triage-secret-findings",
      "field_mapping": {
        "allowlist_changes": "allowlist_changes"
      }
    },
    {
      "from_step": "s03_cfg_triage_secret_findings",
      "to_step": "s08_cfg_ci_secret_scan_gate",
      "data_type": "cfg-triage-secret-findings",
      "field_mapping": {
        "allowlist_changes": "allowlist_changes"
      }
    }
  ],
  "entry_inputs": [
