{
  "name": "expense-velocity-tracker",
  "description": "Track expense velocity (the rate of change of spending) rather than just expense levels. A $500/month expense growing at 10% per month is a bigger problem than a $1000/month expense that is flat.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "expense-time-series-build",
      "inputs": {
        "expense-data": "from_user_input",
        "expense-categories": "from_user_input"
      },
      "outputs": {
        "expense-time-series": "expense-time-series",
        "category-totals": "category-totals"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "velocity-calculation",
      "inputs": {
        "expense-time-series": "step_1.expense-time-series",
        "category-totals": "step_1.category-totals"
      },
      "outputs": {
        "velocity-table": "velocity-table",
        "acceleration-flags": "acceleration-flags"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "projected-impact-modeling",
      "inputs": {
        "velocity-table": "step_2.velocity-table",
        "acceleration-flags": "step_2.acceleration-flags"
      },
      "outputs": {
        "projections": "projections",
        "budget-breach-dates": "budget-breach-dates"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "intervention-design",
      "inputs": {
        "projections": "step_3.projections",
        "budget-breach-dates": "step_3.budget-breach-dates"
      },
      "outputs": {
        "interventions": "interventions",
        "target-velocity": "target-velocity"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "velocity-dashboard-maintenance",
      "inputs": {
        "interventions": "step_4.interventions",
        "velocity-table": "step_2.velocity-table"
      },
      "outputs": {
        "dashboard-design": "dashboard-design",
        "review-cadence": "review-cadence"
      },
      "parallel_group": 5
    }
  ],
