        "key-information": "from_user_input"
      },
      "outputs": {
        "conclusion-statement": "conclusion-statement",
        "audience-question": "audience-question"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "supporting-argument-builder",
      "inputs": {
        "conclusion-statement": "step_1.conclusion-statement",
        "key-information": "from_context.key-information"
      },
      "outputs": {
        "supporting-arguments": "supporting-arguments",
        "argument-order": "argument-order"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "evidence-layer-builder",
      "inputs": {
        "supporting-arguments": "step_2.supporting-arguments",
        "key-information": "from_context.key-information"
      },
      "outputs": {
