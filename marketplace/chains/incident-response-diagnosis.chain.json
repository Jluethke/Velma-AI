{
  "name": "incident-response-diagnosis",
  "description": "Find the cause after stabilization: metric onset, change correlation, Loki or CloudWatch logs, Tempo traces, a falsifiable hypothesis table, safe pod access, Python, Node.js, Go or JVM runtime evidence, PostgreSQL or MySQL lock evidence, and a verdict. Set stack, database, log_backend and trace_backend to route conditional steps.",
  "steps": [
    {
