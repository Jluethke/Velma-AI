      "skill_name": "inc-promql-red-triage",
      "inputs": {
        "incident_record": "from_user_input",
        "prometheus_url": "from_user_input",
        "sli_queries": "from_user_input_optional"
      },
      "outputs": {
        "metric_findings": "metric_findings"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_inc_change_correlation",
      "skill_name": "inc-change-correlation",
      "inputs": {
        "incident_record": "from_user_input",
        "timeline_log": "from_user_input",
        "metric_findings": "s01_inc_promql_red_triage.metric_findings",
