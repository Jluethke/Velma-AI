      },
      "outputs": {
        "aligned-bam": "aligned-bam",
        "alignment-stats": "alignment-stats"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "variant-or-expression-calling",
      "inputs": {
