      },
      "outputs": {
        "network-graph": "network-graph",
        "hub-genes": "hub-genes"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "bioinfo-visualization",
      "inputs": {
        "call-results": "step_3.call-results",
