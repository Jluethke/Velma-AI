        "enrichment-results": "step_4.enrichment-results"
      },
      "outputs": {
        "figure-set": "figure-set",
        "figure-legends": "figure-legends"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "bioinfo-reproducible-workflow",
      "inputs": {
        "figure-set": "step_6.figure-set",
        "qc-report": "step_1.qc-report"
      },
      "outputs": {
