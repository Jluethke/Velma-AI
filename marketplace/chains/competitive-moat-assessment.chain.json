{
  "name": "competitive-moat-assessment",
  "description": "Assess a business for a durable competitive moat using the four moat types: cost advantages, switching costs, network effects, and intangible assets. Score each type honestly with evidence, synthesize a scorecard, and reach a verdict. A business with no real moat competes on execution alone, which a better-resourced rival can eventually win.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "moat-business-model-capture",
      "inputs": {
        "business-description": "from_user_input",
        "customer-base": "from_user_input",
        "main-competitors": "from_user_input"
      },
      "outputs": {
        "business-profile": "business-profile",
        "competitor-set": "competitor-set"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "moat-cost-advantage-assessment",
      "inputs": {
        "business-profile": "step_1.business-profile",
        "competitor-set": "step_1.competitor-set"
      },
      "outputs": {
        "cost-advantage-score": "cost-advantage-score",
        "cost-advantage-evidence": "cost-advantage-evidence"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "moat-switching-cost-assessment",
      "inputs": {
        "business-profile": "step_1.business-profile",
        "competitor-set": "step_1.competitor-set"
      },
      "outputs": {
        "switching-cost-score": "switching-cost-score",
        "switching-cost-evidence": "switching-cost-evidence"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "moat-network-effect-assessment",
      "inputs": {
        "business-profile": "step_1.business-profile",
        "competitor-set": "step_1.competitor-set"
      },
      "outputs": {
        "network-effect-score": "network-effect-score",
        "network-effect-evidence": "network-effect-evidence"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "moat-intangible-asset-assessment",
      "inputs": {
        "business-profile": "step_1.business-profile",
        "competitor-set": "step_1.competitor-set"
      },
      "outputs": {
        "intangible-asset-score": "intangible-asset-score",
        "intangible-asset-evidence": "intangible-asset-evidence"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "moat-scorecard-synthesis",
      "inputs": {
        "cost-advantage-score": "step_2.cost-advantage-score",
        "switching-cost-score": "step_3.switching-cost-score",
        "network-effect-score": "step_4.network-effect-score",
        "intangible-asset-score": "step_5.intangible-asset-score"
      },
      "outputs": {
        "moat-scorecard": "moat-scorecard",
        "dominant-moat": "dominant-moat"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "moat-verdict",
      "inputs": {
        "moat-scorecard": "step_6.moat-scorecard",
        "dominant-moat": "step_6.dominant-moat"
      },
      "outputs": {
        "moat-verdict": "moat-verdict",
        "moat-building-priorities": "moat-building-priorities"
      },
      "parallel_group": 7
    }
  ],
