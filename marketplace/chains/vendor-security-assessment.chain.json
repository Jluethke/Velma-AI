{
  "name": "vendor-security-assessment",
  "description": "Assess a vendor's security posture from questionnaire design through response collection, control evaluation, risk rating, contract requirements, and a final assessment report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "vendor-questionnaire-designer",
      "inputs": {
        "vendor-profile": "from_user_input",
        "assessment-scope": "from_user_input"
      },
      "outputs": {
        "security-questionnaire": "security-questionnaire",
        "evidence-request-list": "evidence-request-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "vendor-response-collector",
      "inputs": {
        "security-questionnaire": "step_1.security-questionnaire",
        "evidence-request-list": "step_1.evidence-request-list"
      },
      "outputs": {
        "completed-responses": "completed-responses",
        "submitted-evidence": "submitted-evidence"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "vendor-control-evaluator",
      "inputs": {
        "completed-responses": "step_2.completed-responses",
        "submitted-evidence": "step_2.submitted-evidence"
      },
      "outputs": {
        "control-evaluation": "control-evaluation",
        "finding-list": "finding-list"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "vendor-risk-rater",
      "inputs": {
        "control-evaluation": "step_3.control-evaluation",
        "finding-list": "step_3.finding-list"
      },
      "outputs": {
        "risk-rating": "risk-rating",
        "risk-justification": "risk-justification"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "vendor-contract-requirements-builder",
      "inputs": {
        "risk-rating": "step_4.risk-rating",
        "finding-list": "step_3.finding-list"
      },
      "outputs": {
        "contract-security-requirements": "contract-security-requirements",
        "remediation-conditions": "remediation-conditions"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "vendor-assessment-report-compiler",
      "inputs": {
        "control-evaluation": "step_3.control-evaluation",
        "risk-rating": "step_4.risk-rating",
        "contract-security-requirements": "step_5.contract-security-requirements"
      },
      "outputs": {
        "vendor-assessment-report": "vendor-assessment-report",
        "executive-summary": "executive-summary"
      },
      "parallel_group": 6
    }
  ],
