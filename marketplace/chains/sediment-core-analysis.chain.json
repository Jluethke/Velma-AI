{
  "name": "sediment-core-analysis",
  "description": "Analyze a sediment core: log the core, subsample, measure organic content and grain size, identify microfossils, build the age model, and reconstruct the paleoenvironment.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "sediment-core-logger",
      "inputs": {
        "core-sections": "from_user_input",
        "site-metadata": "from_user_input"
      },
      "outputs": {
        "core-log": "core-log",
        "core-photos": "core-photos"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "sediment-subsampler",
      "inputs": {
        "core-log": "step_1.core-log",
        "sampling-plan": "from_context.sampling-plan"
      },
      "outputs": {
        "subsamples": "subsamples",
        "sampling-log": "sampling-log"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "sediment-loss-on-ignition",
      "inputs": {
        "subsamples": "step_2.subsamples"
      },
      "outputs": {
        "loi-results": "loi-results",
        "loi-profile": "loi-profile"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "sediment-grain-size",
      "inputs": {
        "subsamples": "step_2.subsamples"
      },
      "outputs": {
        "grain-size-results": "grain-size-results",
        "grain-size-profile": "grain-size-profile"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "sediment-microfossil-identifier",
      "inputs": {
        "subsamples": "step_2.subsamples",
        "reference-collection": "from_context.reference-collection"
      },
      "outputs": {
        "microfossil-counts": "microfossil-counts",
        "assemblage-diagram": "assemblage-diagram"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "sediment-age-depth-model",
      "inputs": {
        "dating-results": "from_context.dating-results",
        "core-log": "step_1.core-log"
      },
      "outputs": {
        "age-model": "age-model",
        "sedimentation-rates": "sedimentation-rates"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "sediment-paleoenviro-reconstruction",
      "inputs": {
        "age-model": "step_6.age-model",
        "microfossil-counts": "step_5.microfossil-counts",
        "loi-results": "step_3.loi-results",
        "grain-size-results": "step_4.grain-size-results"
      },
      "outputs": {
        "paleoenvironment-reconstruction": "paleoenvironment-reconstruction",
        "summary-diagram": "summary-diagram"
      },
      "parallel_group": 7
    }
  ],
