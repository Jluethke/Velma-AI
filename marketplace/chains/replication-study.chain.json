{
  "name": "replication-study",
  "description": "Replicate a published scientific study: extract the original protocol, critique the methodology, design the replication with pre-registration, collect data, compare effect sizes, and write the replication report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "original-protocol-extractor",
      "inputs": {
        "target-paper": "from_user_input",
        "supplementary-materials": "from_user_input",
        "author-contact": "from_user_input"
      },
      "outputs": {
        "extracted-protocol": "extracted-protocol",
        "ambiguity-log": "ambiguity-log",
        "materials-list": "materials-list"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "methodological-critic",
      "inputs": {
        "extracted-protocol": "step_1.extracted-protocol",
        "target-paper": "from_context.target-paper",
        "related-replications": "from_context.related-replications"
      },
      "outputs": {
        "validity-assessment": "validity-assessment",
        "statistical-critique": "statistical-critique",
        "replication-risk-factors": "replication-risk-factors"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "replication-designer",
      "inputs": {
        "extracted-protocol": "step_1.extracted-protocol",
        "validity-assessment": "step_2.validity-assessment",
        "replication-type": "from_context.replication-type"
      },
      "outputs": {
        "replication-protocol": "replication-protocol",
        "pre-registration": "pre-registration",
        "power-analysis": "power-analysis"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "replication-data-collector",
      "inputs": {
        "replication-protocol": "step_3.replication-protocol",
        "materials-list": "step_1.materials-list",
        "participant-pool": "from_context.participant-pool"
      },
      "outputs": {
        "replication-data": "replication-data",
        "fidelity-log": "fidelity-log",
        "participant-demographics": "participant-demographics"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "effect-size-comparator",
      "inputs": {
        "replication-data": "step_4.replication-data",
        "original-results": "from_context.original-results",
        "pre-registration": "step_3.pre-registration"
      },
      "outputs": {
        "replication-results": "replication-results",
        "comparison-analysis": "comparison-analysis",
        "meta-analytic-estimate": "meta-analytic-estimate"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "replication-reporter",
      "inputs": {
        "comparison-analysis": "step_5.comparison-analysis",
        "fidelity-log": "step_4.fidelity-log",
        "pre-registration": "step_3.pre-registration"
      },
      "outputs": {
        "replication-report": "replication-report",
        "data-and-code-archive": "data-and-code-archive",
        "comparison-table": "comparison-table"
      },
      "parallel_group": 6
    }
  ],
