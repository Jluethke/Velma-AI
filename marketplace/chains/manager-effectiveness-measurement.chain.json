{
  "name": "manager-effectiveness-measurement",
  "description": "Measure manager effectiveness using outputs, not inputs. Lagging indicators (retention, performance, promotion rate) show the result. Leading indicators (1:1 frequency, engagement scores, time-to-fill) predict the result 6-12 months in advance. Measure both, intervene on leading indicators before the lagging indicators deteriorate.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "lagging-indicator-collector",
      "inputs": {
        "manager-list": "from_user_input",
        "hr-data-access": "from_user_input"
      },
      "outputs": {
        "lagging-indicators": "lagging-indicators",
        "lagging-outliers": "lagging-outliers"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "leading-indicator-collector",
      "inputs": {
        "lagging-indicators": "step_1.lagging-indicators",
        "lagging-outliers": "step_1.lagging-outliers"
      },
      "outputs": {
        "leading-indicators": "leading-indicators",
        "leading-outliers": "leading-outliers"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "correlation-analyzer",
      "inputs": {
        "dataset_profile": "from_context.dataset_profile",
        "distribution_plan": "from_context.distribution_plan"
      },
      "outputs": {
        "correlation_plan": "correlation_plan"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "intervention-designer",
      "inputs": {
        "correlation-report": "from_context.correlation-report",
        "predictive-model": "from_context.predictive-model"
      },
      "outputs": {
        "intervention-plans": "intervention-plans",
        "escalation-criteria": "escalation-criteria"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "manager-scorecard-publisher",
      "inputs": {
        "intervention-plans": "step_4.intervention-plans",
        "escalation-criteria": "step_4.escalation-criteria"
      },
      "outputs": {
        "scorecard-template": "scorecard-template",
        "delivery-process": "delivery-process"
      },
      "parallel_group": 5
    }
  ],
