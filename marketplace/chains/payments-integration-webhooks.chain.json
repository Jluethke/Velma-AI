      },
      "outputs": {
        "webhook_handler": "webhook_handler"
      },
      "condition": "stack == 'node'",
      "parallel_group": 3
    },
    {
      "id": "s05_pay_go_webhook_verify",
      "skill_name": "pay-go-webhook-verify",
      "inputs": {
        "project_dir": "from_user_input",
