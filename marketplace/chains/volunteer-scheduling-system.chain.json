        "staffing-requirements": "step_1.staffing-requirements"
      },
      "outputs": {
        "availability-matrix": "availability-matrix",
        "skill-roster": "skill-roster"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "volunteer-schedule-generator",
      "inputs": {
        "availability-matrix": "step_2.availability-matrix",
        "skill-roster": "step_2.skill-roster"
      },
      "outputs": {
        "draft-schedule": "draft-schedule",
        "coverage-gaps": "coverage-gaps"
      },
      "parallel_group": 3
    },
    {
