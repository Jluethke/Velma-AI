{
  "name": "meeting-design-protocol",
  "description": "Design meetings that produce decisions, not discussions. Circulate the decision (not a topic) and pre-read before the meeting. Discuss only disagreements. End with a decision, owners, and deadlines. If no decision can be made, end the meeting and define what is needed to decide.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "meeting-decision-framer",
      "inputs": {
        "meeting-purpose": "from_user_input",
        "attendee-list": "from_user_input"
      },
      "outputs": {
        "decision-statement": "decision-statement",
        "options-list": "options-list",
        "meeting-necessity-check": "meeting-necessity-check"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "pre-read-builder",
      "inputs": {
        "decision-statement": "step_1.decision-statement",
        "options-list": "step_1.options-list"
      },
      "outputs": {
        "pre-read-document": "pre-read-document",
        "distribution-plan": "distribution-plan"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "meeting-opening-protocol",
      "inputs": {
        "pre-read-document": "step_2.pre-read-document",
        "attendee-list": "from_context.attendee-list"
      },
      "outputs": {
        "readiness-check-result": "readiness-check-result",
        "meeting-rules": "meeting-rules"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "disagreement-discussion-facilitator",
      "inputs": {
        "decision-statement": "step_1.decision-statement",
        "options-list": "step_1.options-list"
      },
      "outputs": {
        "disagreement-log": "disagreement-log",
        "new-information": "new-information"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "meeting-decision-closer",
      "inputs": {
        "disagreement-log": "step_4.disagreement-log",
        "new-information": "step_4.new-information"
      },
      "outputs": {
        "decision-record": "decision-record",
        "action-items": "action-items",
        "next-meeting-criteria": "next-meeting-criteria"
      },
      "parallel_group": 5
    }
