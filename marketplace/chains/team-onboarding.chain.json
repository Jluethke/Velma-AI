        "relationship": "complement"
      },
      {
        "chain_name": "codebase-takeover",
        "relationship": "complement"
      },
      {
        "chain_name": "developer-docs",
        "relationship": "complement"
      },
      {
        "chain_name": "manager-first-90",
        "relationship": "complement"
      },
      {
        "chain_name": "new-employee-ready",
        "relationship": "complement"
      }
    ],
    "prerequisites": []
  }
}
