{
  "name": "team-onboarding",
  "description": "Onboard a new team member: map the codebase, write documentation, scaffold their first project, and review their code.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "codebase-mapper",
      "inputs": {
        "repo_path": "from_user_input",
        "language_filter": "from_user_input",
        "depth": "from_user_input",
        "previous_map": "from_user_input"
      },
      "outputs": {
        "architecture_map": "architecture_map_data",
        "dependency_graph": "dependency_graph_data",
        "file_index": "file_index_data",
        "tech_stack_summary": "tech_stack_summary_data",
        "drift_report": "drift_report_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "technical-writing",
      "inputs": {
        "subject_matter": "step_1.architecture_map",
        "audience": "step_1.architecture_map",
        "doc_type": "step_1.architecture_map",
        "task_description": "step_1.architecture_map"
      },
      "outputs": {
        "documentation": "documentation_data",
        "templates": "templates_data",
        "style_feedback": "style_feedback_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "project-scaffolding",
      "inputs": {
        "language": "step_1.architecture_map",
        "framework": "step_1.architecture_map",
        "deploy_target": "step_1.architecture_map",
        "team_size": "step_1.architecture_map",
        "task_description": "step_1.architecture_map"
      },
      "outputs": {
        "project_files": "project_files_data",
        "ci_config": "ci_config_data",
        "docker_config": "docker_config_data",
        "documentation": "documentation_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_4",
      "skill_name": "code-review",
      "inputs": {
        "diff": "step_2.documentation",
        "pr_description": "step_2.documentation",
        "codebase_context": "step_2.documentation",
        "task_description": "step_2.documentation"
      },
      "outputs": {
        "review_comments": "review_comments_data",
        "approval_decision": "approval_decision_data",
        "summary": "summary_data"
      },
      "parallel_group": 3
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "architecture_map",
      "field_mapping": "architecture_map -> subject_matter; architecture_map -> audience; architecture_map -> doc_type; architecture_map -> task_description"
    },
    {
      "from_step": "step_1",
      "to_step": "step_3",
      "data_type": "architecture_map",
      "field_mapping": "architecture_map -> language; architecture_map -> framework; architecture_map -> deploy_target; architecture_map -> team_size; architecture_map -> task_description"
    },
    {
      "from_step": "step_2",
      "to_step": "step_4",
      "data_type": "documentation",
      "field_mapping": "documentation -> diff; documentation -> pr_description; documentation -> codebase_context; documentation -> task_description"
    },
    {
      "from_step": "step_3",
      "to_step": "step_4",
      "data_type": "project_files",
      "field_mapping": "project_files -> input"
    }
  ],
  "entry_inputs": [
    "depth",
    "language_filter",
    "previous_map",
    "repo_path"
  ],
  "terminal_outputs": [
    "review_comments",
    "approval_decision",
    "summary"
  ],
  "parallel_groups": [
    [
      "step_1"
    ],
    [
      "step_2",
      "step_3"
    ],
    [
      "step_4"
    ]
  ],
  "estimated_cost": 0,
  "critical_path": [
    "step_1",
    "step_2",
    "step_4"
  ],
  "chain_links": {
    "next_chains": [],
    "related_chains": [
