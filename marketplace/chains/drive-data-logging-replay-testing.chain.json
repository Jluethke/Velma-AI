        "test_cases": "test_cases"
      },
      "parallel_group": 2
    },
    {
      "id": "s04_dlog_ros2_bag_replay",
      "skill_name": "dlog-ros2-bag-replay",
      "inputs": {
        "archive_path": "from_user_input",
        "drive_index": "s01_dlog_drive_index_sqlite.drive_index",
        "entry_point": "from_user_input"
      },
      "outputs": {
        "replay_procedure": "replay_procedure"
      },
      "condition": "stack == 'ros2'",
      "parallel_group": 2
    },
    {
      "id": "s05_dlog_py_replay_harness",
      "skill_name": "dlog-py-replay-harness",
      "inputs": {
        "archive_path": "from_user_input",
        "drive_index": "s01_dlog_drive_index_sqlite.drive_index",
        "entry_point": "from_user_input"
      },
      "outputs": {
        "replay_procedure": "replay_procedure"
      },
      "condition": "stack == 'python'",
      "parallel_group": 2
    },
    {
