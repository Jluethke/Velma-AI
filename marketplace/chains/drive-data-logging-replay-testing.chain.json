{
  "name": "drive-data-logging-replay-testing",
  "description": "Turn archived drives into regression tests: index the archive, anonymize camera data, extract event test cases, replay them offline in the chosen stack and check determinism.",
  "steps": [
    {
      "id": "s01_dlog_drive_index_sqlite",
      "skill_name": "dlog-drive-index-sqlite",
      "inputs": {
        "archive_path": "from_user_input",
        "run_manifest": "from_user_input",
        "hash_manifest": "from_user_input"
      },
      "outputs": {
        "drive_index": "drive_index"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_dlog_camera_privacy_anonymize",
      "skill_name": "dlog-camera-privacy-anonymize",
      "inputs": {
        "archive_path": "from_user_input",
        "privacy_policy": "from_user_input",
        "drive_index": "s01_dlog_drive_index_sqlite.drive_index"
      },
      "outputs": {
        "anonymized_log": "anonymized_log",
        "privacy_audit": "privacy_audit"
      },
      "condition": "has_camera == true",
      "parallel_group": 2
    },
    {
      "id": "s03_dlog_test_case_extract",
      "skill_name": "dlog-test-case-extract",
