{
  "name": "irrigation-scheduling",
  "description": "Schedule and manage irrigation based on soil moisture, crop needs, and weather.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "soil-moisture-collector",
      "inputs": {
        "field-zones": "from_user_input",
        "sensor-readings": "from_user_input"
      },
      "outputs": {
        "moisture-profile": "moisture-profile",
        "deficit-zones": "deficit-zones"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "crop-water-needs-assessor",
      "inputs": {
        "moisture-profile": "step_1.moisture-profile",
        "crop-stage-data": "from_context.crop-stage-data"
      },
      "outputs": {
        "water-requirements": "water-requirements",
        "critical-periods": "critical-periods"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "water-source-evaluator",
      "inputs": {
        "water-requirements": "step_2.water-requirements",
        "system-specs": "from_context.system-specs"
      },
      "outputs": {
        "delivery-capacity": "delivery-capacity",
        "system-constraints": "system-constraints"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "irrigation-schedule-builder",
      "inputs": {
