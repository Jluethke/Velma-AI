        "delivery-capacity": "step_3.delivery-capacity",
        "deficit-zones": "step_1.deficit-zones"
      },
      "outputs": {
        "irrigation-schedule": "irrigation-schedule",
        "water-usage-forecast": "water-usage-forecast"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "weather-adjustment-module",
      "inputs": {
        "irrigation-schedule": "step_4.irrigation-schedule",
        "weather-forecast": "from_context.weather-forecast"
