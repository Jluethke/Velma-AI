{
  "name": "prompt-engineering-workflow",
  "description": "Engineer and iterate prompts for an LLM application from task definition through benchmarking.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "prompt-task-definer",
      "inputs": {
        "task-description": "from_user_input",
        "success-criteria": "from_user_input"
      },
      "outputs": {
        "task-spec": "task-spec",
        "evaluation-rubric": "evaluation-rubric"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "prompt-drafter",
      "inputs": {
        "task-spec": "step_1.task-spec",
        "evaluation-rubric": "step_1.evaluation-rubric"
      },
      "outputs": {
        "draft-prompt": "draft-prompt",
        "prompt-rationale": "prompt-rationale"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "prompt-tester",
      "inputs": {
        "draft-prompt": "step_2.draft-prompt",
        "evaluation-rubric": "step_1.evaluation-rubric"
      },
      "outputs": {
        "test-results": "test-results",
        "failure-cases": "failure-cases"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "prompt-iterator",
      "inputs": {
        "draft-prompt": "step_2.draft-prompt",
        "failure-cases": "step_3.failure-cases"
      },
      "outputs": {
        "revised-prompt": "revised-prompt",
        "change-log": "change-log"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "prompt-guardrail-designer",
      "inputs": {
        "revised-prompt": "step_4.revised-prompt",
        "task-spec": "step_1.task-spec"
      },
      "outputs": {
        "guarded-prompt": "guarded-prompt",
        "guardrail-spec": "guardrail-spec"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "prompt-benchmarker",
      "inputs": {
        "guarded-prompt": "step_5.guarded-prompt",
        "test-results": "step_3.test-results"
      },
      "outputs": {
        "benchmark-report": "benchmark-report",
        "prompt-package": "prompt-package"
      },
      "parallel_group": 6
    }
  ],
