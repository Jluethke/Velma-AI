{
  "name": "secrets-management-audit",
  "description": "Audit secrets management practices from inventory through source code scanning, vault configuration review, rotation testing, access logging, and emergency rotation verification.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "secrets-inventory-cataloger",
      "inputs": {
        "infrastructure-scope": "from_user_input",
        "team-contacts": "from_user_input"
      },
      "outputs": {
        "secrets-inventory": "secrets-inventory",
        "classification-map": "classification-map"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "source-code-secrets-scanner",
      "inputs": {
        "repo-list": "from_context.repo-list",
        "secrets-inventory": "step_1.secrets-inventory"
      },
      "outputs": {
        "exposed-secrets-report": "exposed-secrets-report",
        "historical-exposure-list": "historical-exposure-list"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "vault-configuration-reviewer",
      "inputs": {
        "vault-access": "from_context.vault-access",
        "classification-map": "step_1.classification-map"
      },
      "outputs": {
        "vault-config-findings": "vault-config-findings",
        "access-policy-map": "access-policy-map"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "secret-rotation-procedure-test",
      "inputs": {
        "secrets-inventory": "step_1.secrets-inventory",
        "vault-config-findings": "step_3.vault-config-findings"
      },
      "outputs": {
        "rotation-test-results": "rotation-test-results",
        "rotation-gap-list": "rotation-gap-list"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "secret-access-logging-validator",
      "inputs": {
        "access-policy-map": "step_3.access-policy-map",
        "rotation-test-results": "step_4.rotation-test-results"
      },
      "outputs": {
        "logging-findings": "logging-findings",
        "alert-coverage-map": "alert-coverage-map"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "emergency-rotation-drill",
      "inputs": {
        "secrets-inventory": "step_1.secrets-inventory",
        "rotation-gap-list": "step_4.rotation-gap-list"
      },
      "outputs": {
        "drill-results": "drill-results",
        "emergency-readiness-score": "emergency-readiness-score"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "secrets-audit-report-compiler",
      "inputs": {
        "exposed-secrets-report": "step_2.exposed-secrets-report",
        "logging-findings": "step_5.logging-findings",
        "drill-results": "step_6.drill-results",
        "vault-config-findings": "step_3.vault-config-findings"
      },
      "outputs": {
        "secrets-audit-report": "secrets-audit-report",
        "remediation-roadmap": "remediation-roadmap"
      },
      "parallel_group": 7
    }
  ],
