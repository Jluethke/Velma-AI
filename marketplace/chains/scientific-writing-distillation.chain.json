{
  "name": "scientific-writing-distillation",
  "description": "Distill raw experimental findings into structured scientific prose: extract claims from data, organize into a logical argument, draft each section (abstract, methods, results, discussion), and check internal consistency.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "claim-extractor",
      "inputs": {
        "experimental-results": "from_user_input",
        "research-question": "from_user_input"
      },
      "outputs": {
        "claim-list": "claim-list",
        "unsupported-observations": "unsupported-observations"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "argument-organizer",
      "inputs": {
        "claim-list": "step_1.claim-list",
        "research-question": "from_context.research-question"
      },
      "outputs": {
        "argument-outline": "argument-outline",
        "narrative-arc": "narrative-arc"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "methods-section-drafter",
      "inputs": {
        "experimental-results": "from_context.experimental-results",
        "protocol-notes": "from_context.protocol-notes"
      },
      "outputs": {
        "methods-draft": "methods-draft",
        "replication-checklist": "replication-checklist"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "results-section-drafter",
      "inputs": {
        "argument-outline": "step_2.argument-outline",
        "claim-list": "step_1.claim-list"
      },
      "outputs": {
        "results-draft": "results-draft",
        "figure-table-callouts": "figure-table-callouts"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "discussion-section-drafter",
      "inputs": {
        "claim-list": "step_1.claim-list",
        "literature-context": "from_context.literature-context"
      },
      "outputs": {
        "discussion-draft": "discussion-draft",
        "limitation-list": "limitation-list"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "abstract-distiller",
      "inputs": {
        "results-draft": "step_4.results-draft",
        "discussion-draft": "step_5.discussion-draft"
      },
      "outputs": {
        "abstract-text": "abstract-text",
        "keyword-list": "keyword-list"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "internal-consistency-checker",
      "inputs": {
        "abstract-text": "step_6.abstract-text",
        "methods-draft": "step_3.methods-draft",
        "results-draft": "step_4.results-draft"
      },
      "outputs": {
        "consistency-report": "consistency-report",
        "revision-checklist": "revision-checklist"
      },
      "parallel_group": 7
    }
  ],
