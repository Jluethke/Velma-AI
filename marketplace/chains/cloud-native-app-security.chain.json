      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "cloud-native-security-report-compiler",
      "inputs": {
        "ssrf-findings": "step_3.ssrf-findings",
        "iac-findings": "step_4.iac-findings",
        "autoscaling-findings": "step_5.autoscaling-findings",
