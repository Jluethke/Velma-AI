{
  "name": "financial-runway-calculator",
  "description": "Divide available cash by monthly burn to find how many months of runway remain, then stress the result against a revenue drop, a major expense, and a doubled timeline. Runway is a function of the burn rate, which is the variable you control.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "frc-cash-counter",
      "inputs": {
        "financial-context": "from_user_input",
        "as-of-date": "from_user_input"
      },
      "outputs": {
        "available-cash": "available-cash",
        "cash-sources": "cash-sources"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "frc-burn-calculator",
      "inputs": {
        "financial-context": "from_context.financial-context",
        "available-cash": "step_1.available-cash"
      },
      "outputs": {
        "monthly-burn": "monthly-burn",
        "burn-breakdown": "burn-breakdown"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "frc-runway-calculator",
      "inputs": {
        "available-cash": "step_1.available-cash",
        "monthly-burn": "step_2.monthly-burn"
      },
      "outputs": {
        "runway-months": "runway-months",
        "runway-end-date": "runway-end-date"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "frc-stress-tester",
      "inputs": {
        "runway-months": "step_3.runway-months",
        "burn-breakdown": "step_2.burn-breakdown"
      },
      "outputs": {
        "stress-scenarios": "stress-scenarios",
        "worst-case-runway": "worst-case-runway"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "frc-lever-finder",
      "inputs": {
        "burn-breakdown": "step_2.burn-breakdown",
        "worst-case-runway": "step_4.worst-case-runway"
      },
      "outputs": {
        "burn-levers": "burn-levers",
        "extended-runway": "extended-runway"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "frc-runway-report-writer",
      "inputs": {
        "stress-scenarios": "step_4.stress-scenarios",
        "burn-levers": "step_5.burn-levers"
      },
      "outputs": {
        "runway-report": "runway-report",
        "runway-action-plan": "runway-action-plan"
      },
      "parallel_group": 6
    }
  ],
