{
  "name": "seo-audit-workflow",
  "description": "Conduct a full SEO audit covering technical, on-page, and off-page factors.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "technical-seo-crawler",
      "inputs": {
        "site-url": "from_user_input",
        "crawl-config": "from_user_input"
      },
      "outputs": {
        "technical-issues": "technical-issues",
        "crawl-summary": "crawl-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "on-page-seo-analyzer",
      "inputs": {
        "crawl-summary": "step_1.crawl-summary",
        "site-url": "from_context.site-url"
      },
      "outputs": {
        "on-page-issues": "on-page-issues",
        "content-scores": "content-scores"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "backlink-profile-reviewer",
      "inputs": {
        "site-url": "from_context.site-url",
        "crawl-summary": "step_1.crawl-summary"
      },
      "outputs": {
        "backlink-report": "backlink-report",
        "link-opportunities": "link-opportunities"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "keyword-gap-analyzer",
      "inputs": {
        "site-url": "from_context.site-url",
        "on-page-issues": "step_2.on-page-issues"
      },
      "outputs": {
        "keyword-rankings": "keyword-rankings",
        "keyword-gaps": "keyword-gaps"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "seo-fix-prioritizer",
      "inputs": {
        "technical-issues": "step_1.technical-issues",
        "on-page-issues": "step_2.on-page-issues",
        "keyword-gaps": "step_4.keyword-gaps"
      },
      "outputs": {
        "prioritized-fixes": "prioritized-fixes",
        "seo-audit-report": "seo-audit-report"
      },
      "parallel_group": 5
    }
  ],
