{
  "name": "cloud-storage-organization",
  "description": "Organize cloud storage: audit the current structure, define the folder hierarchy and naming convention, reorganize files, set permissions, configure retention rules, and produce the storage organization plan.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "storage-structure-auditor",
      "inputs": {
        "storage-platform": "from_user_input",
        "team-size": "from_user_input"
      },
      "outputs": {
        "folder-inventory": "folder-inventory",
        "naming-issues": "naming-issues"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "folder-hierarchy-designer",
      "inputs": {
        "folder-inventory": "step_1.folder-inventory",
        "naming-issues": "step_1.naming-issues"
      },
      "outputs": {
        "folder-hierarchy": "folder-hierarchy",
        "naming-convention": "naming-convention"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "file-reorganization-executor",
      "inputs": {
        "folder-hierarchy": "step_2.folder-hierarchy",
        "naming-convention": "step_2.naming-convention"
      },
      "outputs": {
        "migration-log": "migration-log",
        "exceptions-list": "exceptions-list"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "storage-permissions-configurator",
      "inputs": {
        "folder-hierarchy": "step_2.folder-hierarchy",
        "team-size": "from_context.team-size"
      },
      "outputs": {
        "permissions-matrix": "permissions-matrix",
        "sharing-rules": "sharing-rules"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "storage-retention-planner",
      "inputs": {
        "folder-hierarchy": "step_2.folder-hierarchy",
        "permissions-matrix": "step_4.permissions-matrix"
      },
      "outputs": {
        "retention-schedule": "retention-schedule",
        "storage-organization-plan": "storage-organization-plan"
      },
      "parallel_group": 5
    }
  ],
