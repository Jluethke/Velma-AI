{
  "name": "graphql-security-assessment",
  "description": "Assess GraphQL API security from schema introspection through query complexity attacks, resolver authorization, batching abuse, error disclosure, and subscription access controls.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "graphql-schema-introspection-probe",
      "inputs": {
        "graphql-endpoint": "from_user_input",
        "auth-credentials": "from_user_input"
      },
      "outputs": {
        "schema-map": "schema-map",
        "introspection-status": "introspection-status"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "graphql-depth-complexity-attack",
      "inputs": {
        "graphql-endpoint": "from_context.graphql-endpoint",
        "schema-map": "step_1.schema-map"
      },
      "outputs": {
        "complexity-findings": "complexity-findings",
        "dos-risk-assessment": "dos-risk-assessment"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "graphql-resolver-authorization-test",
      "inputs": {
        "graphql-endpoint": "from_context.graphql-endpoint",
        "schema-map": "step_1.schema-map",
        "auth-credentials": "from_context.auth-credentials"
      },
      "outputs": {
        "authz-findings": "authz-findings",
        "idor-findings": "idor-findings"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "graphql-batching-attack-test",
      "inputs": {
        "graphql-endpoint": "from_context.graphql-endpoint",
        "complexity-findings": "step_2.complexity-findings"
      },
      "outputs": {
        "batching-findings": "batching-findings",
        "rate-limit-bypass-status": "rate-limit-bypass-status"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "graphql-error-disclosure-check",
      "inputs": {
        "graphql-endpoint": "from_context.graphql-endpoint",
        "authz-findings": "step_3.authz-findings"
      },
      "outputs": {
        "disclosure-findings": "disclosure-findings",
        "debug-mode-status": "debug-mode-status"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "graphql-subscription-mutation-access",
      "inputs": {
        "graphql-endpoint": "from_context.graphql-endpoint",
        "schema-map": "step_1.schema-map",
        "authz-findings": "step_3.authz-findings"
      },
      "outputs": {
        "subscription-findings": "subscription-findings",
        "mutation-findings": "mutation-findings"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "graphql-security-report-compiler",
      "inputs": {
        "batching-findings": "step_4.batching-findings",
        "disclosure-findings": "step_5.disclosure-findings",
        "subscription-findings": "step_6.subscription-findings",
        "idor-findings": "step_3.idor-findings"
      },
      "outputs": {
        "graphql-security-report": "graphql-security-report",
        "remediation-priority-list": "remediation-priority-list"
      },
      "parallel_group": 7
    }
  ],
