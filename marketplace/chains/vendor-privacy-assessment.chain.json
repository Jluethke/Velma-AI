{
  "name": "vendor-privacy-assessment",
  "description": "Assess a vendor's privacy practices before sharing personal data with them.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "privacy-questionnaire-distribution",
      "inputs": {
        "vendor-name": "from_user_input",
        "data-sharing-scope": "from_user_input"
      },
      "outputs": {
        "questionnaire-responses": "questionnaire-responses",
        "vendor-documentation": "vendor-documentation"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "vendor-privacy-evaluation",
      "inputs": {
        "questionnaire-responses": "step_1.questionnaire-responses",
        "vendor-documentation": "step_1.vendor-documentation"
      },
      "outputs": {
        "privacy-risk-score": "privacy-risk-score",
        "findings": "findings"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "vendor-dpa-negotiation",
      "inputs": {
        "findings": "step_2.findings",
