{
  "name": "ticket-triage-workflow",
  "description": "Triage incoming support tickets by category, severity, and routing.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "ticket-classifier",
      "inputs": {
        "ticket-queue": "from_user_input",
        "category-definitions": "from_user_input"
      },
      "outputs": {
        "classified-tickets": "classified-tickets",
        "classification-confidence": "classification-confidence"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "severity-assessor",
      "inputs": {
        "classified-tickets": "step_1.classified-tickets",
        "severity-matrix": "from_context.severity-matrix"
      },
      "outputs": {
        "scored-tickets": "scored-tickets",
        "critical-alerts": "critical-alerts"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "ticket-router",
      "inputs": {
        "scored-tickets": "step_2.scored-tickets",
        "routing-rules": "from_context.routing-rules"
      },
      "outputs": {
        "routed-tickets": "routed-tickets",
        "routing-exceptions": "routing-exceptions"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "ticket-acknowledgment-sender",
      "inputs": {
        "routed-tickets": "step_3.routed-tickets",
        "acknowledgment-templates": "from_context.acknowledgment-templates"
      },
      "outputs": {
        "acknowledged-tickets": "acknowledged-tickets",
        "acknowledgment-log": "acknowledgment-log"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "triage-queue-reporter",
      "inputs": {
        "acknowledged-tickets": "step_4.acknowledged-tickets",
        "routing-exceptions": "step_3.routing-exceptions"
      },
      "outputs": {
        "triage-report": "triage-report",
        "exception-list": "exception-list"
      },
      "parallel_group": 5
    }
  ],
