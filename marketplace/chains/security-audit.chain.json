{
  "name": "security-audit",
  "description": "Full security review of a codebase. Map the attack surface, harden vulnerabilities, review critical code paths, and produce an audit report with remediation checklist.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "codebase-mapper",
      "inputs": {
        "repo_path": "from_user_input",
        "language_filter": "from_user_input",
        "depth": "from_user_input",
        "previous_map": "from_user_input"
      },
      "outputs": {
        "architecture_map": "architecture_map",
        "dependency_graph": "dependency_graph",
        "file_index": "file_index",
        "tech_stack_summary": "tech_stack_summary",
        "drift_report": "drift_report"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "security-hardening",
      "inputs": {
        "codebase_context": "from_context.codebase_context",
        "deployment_environment": "from_context.deployment_environment",
        "auth_mechanism": "from_context.auth_mechanism",
        "task_description": "from_context.task_description"
      },
      "outputs": {
        "attack_surface_inventory": "attack_surface_inventory",
        "vulnerability_report": "vulnerability_report",
        "remediation_plan": "remediation_plan",
        "verification_checklist": "verification_checklist"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "code-review",
      "inputs": {
        "diff": "from_context.diff",
        "pr_description": "from_context.pr_description",
        "codebase_context": "from_context.codebase_context",
        "task_description": "from_context.task_description"
      },
      "outputs": {
        "review_comments": "review_comments",
        "approval_decision": "approval_decision",
        "summary": "summary"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "checklist-builder",
      "inputs": {
        "goal_or_event": "from_context.goal_or_event",
        "deadline": "from_context.deadline",
        "constraints": "from_context.constraints",
        "experience_level": "from_context.experience_level"
      },
      "outputs": {
        "checklist": "checklist",
        "timeline": "timeline",
        "dont_forget": "dont_forget",
        "dependencies": "dependencies"
      },
      "parallel_group": 4
    }
  ],
