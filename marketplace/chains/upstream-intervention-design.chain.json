{
  "name": "upstream-intervention-design",
  "description": "Trace a recurring problem to the point furthest upstream where a small change prevents it, then design and sequence the intervention. Uses the Five Whys to build the causal chain, scores prevention leverage at each level, and chooses the highest-leverage point rather than the most visible symptom. The highest-leverage intervention usually sits three to four levels above the symptom.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "problem-symptom-capture",
      "inputs": {
        "recurring-problem": "from_user_input",
        "observation-context": "from_user_input"
      },
      "outputs": {
        "symptom-statement": "symptom-statement",
        "occurrence-evidence": "occurrence-evidence"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "five-whys-causal-chain",
      "inputs": {
        "symptom-statement": "step_1.symptom-statement",
        "occurrence-evidence": "step_1.occurrence-evidence"
      },
      "outputs": {
        "causal-chain": "causal-chain",
        "root-cause-candidates": "root-cause-candidates"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "causal-level-leverage-scoring",
      "inputs": {
        "causal-chain": "step_2.causal-chain",
        "root-cause-candidates": "step_2.root-cause-candidates"
      },
      "outputs": {
        "leverage-scored-levels": "leverage-scored-levels",
        "highest-leverage-level": "highest-leverage-level"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "upstream-intervention-options",
      "inputs": {
        "leverage-scored-levels": "step_3.leverage-scored-levels",
        "highest-leverage-level": "step_3.highest-leverage-level"
      },
      "outputs": {
        "intervention-options": "intervention-options",
        "prevention-mechanism": "prevention-mechanism"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "downstream-effect-check",
      "inputs": {
        "intervention-options": "step_4.intervention-options",
        "prevention-mechanism": "step_4.prevention-mechanism"
      },
      "outputs": {
        "prevented-symptoms": "prevented-symptoms",
        "side-effect-watchlist": "side-effect-watchlist"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "intervention-feasibility-filter",
      "inputs": {
        "intervention-options": "step_4.intervention-options",
        "prevented-symptoms": "step_5.prevented-symptoms",
        "side-effect-watchlist": "step_5.side-effect-watchlist"
      },
      "outputs": {
        "feasible-interventions": "feasible-interventions",
        "feasibility-notes": "feasibility-notes"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "upstream-rollout-plan",
      "inputs": {
        "feasible-interventions": "step_6.feasible-interventions",
        "feasibility-notes": "step_6.feasibility-notes"
      },
      "outputs": {
        "rollout-plan": "rollout-plan",
        "verification-checkpoint": "verification-checkpoint"
      },
      "parallel_group": 7
    }
  ],
