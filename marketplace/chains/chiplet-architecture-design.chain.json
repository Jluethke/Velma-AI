{
  "name": "chiplet-architecture-design",
  "description": "Design a chiplet-based system: partition a monolithic die into chiplets, select die-to-die interfaces, budget bandwidth and latency, choose integration technology, model cost and yield, and plan known-good-die testing.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "die-partitioning-analysis",
      "inputs": {
        "monolithic-die-spec": "from_user_input",
        "target-yield": "from_user_input",
        "volume-projection": "from_user_input"
      },
      "outputs": {
        "partition-candidates": "partition-candidates",
        "yield-comparison": "yield-comparison"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "die-to-die-interface-selection",
      "inputs": {
        "partition-candidates": "step_1.partition-candidates",
        "bandwidth-requirements": "from_context.bandwidth-requirements",
        "latency-budget": "from_context.latency-budget"
      },
      "outputs": {
        "interface-selection": "interface-selection",
        "integration-technology": "integration-technology"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "chiplet-thermal-analysis",
      "inputs": {
        "interface-selection": "step_2.interface-selection",
        "integration-technology": "step_2.integration-technology",
        "power-map": "from_context.power-map"
      },
      "outputs": {
        "thermal-model": "thermal-model",
        "thermal-solution": "thermal-solution"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "known-good-die-test-strategy",
      "inputs": {
        "partition-candidates": "step_1.partition-candidates",
        "thermal-model": "step_3.thermal-model"
      },
      "outputs": {
        "test-plan": "test-plan",
        "kgd-yield-model": "kgd-yield-model"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "chiplet-cost-model",
      "inputs": {
        "test-plan": "step_4.test-plan",
        "kgd-yield-model": "step_4.kgd-yield-model",
        "integration-technology": "step_2.integration-technology"
      },
      "outputs": {
