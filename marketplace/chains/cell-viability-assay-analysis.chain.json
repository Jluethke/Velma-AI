{
  "name": "cell-viability-assay-analysis",
  "description": "Analyze cell viability assay data from plate reader import through normalization, dose-response fitting, assay quality assessment, and compound comparison to a viability report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "plate-reader-importer",
      "inputs": {
        "plate-reader-files": "from_user_input",
        "plate-layout": "from_user_input"
      },
      "outputs": {
        "mapped-readings": "mapped-readings",
        "control-wells": "control-wells"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "viability-normalizer",
      "inputs": {
        "mapped-readings": "step_1.mapped-readings",
        "control-wells": "step_1.control-wells"
      },
      "outputs": {
        "percent-viability": "percent-viability",
        "replicate-statistics": "replicate-statistics"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "dose-response-fitter",
      "inputs": {
        "percent-viability": "step_2.percent-viability",
        "concentration-series": "from_context.concentration-series"
      },
      "outputs": {
        "dose-response-fit": "dose-response-fit",
        "fit-quality": "fit-quality"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "assay-quality-assessor",
      "inputs": {
        "control-wells": "step_1.control-wells",
        "replicate-statistics": "step_2.replicate-statistics"
      },
      "outputs": {
        "z-factor": "z-factor",
        "quality-classification": "quality-classification"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "compound-comparator",
      "inputs": {
        "dose-response-fit": "step_3.dose-response-fit",
        "percent-viability": "step_2.percent-viability"
      },
      "outputs": {
        "potency-ranking": "potency-ranking",
        "selectivity-index": "selectivity-index"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "viability-report-generator",
      "inputs": {
        "potency-ranking": "step_5.potency-ranking",
        "z-factor": "step_4.z-factor",
        "dose-response-fit": "step_3.dose-response-fit"
      },
      "outputs": {
        "viability-report": "viability-report",
        "data-tables": "data-tables"
      },
      "parallel_group": 6
    }
  ],
