{
  "name": "evidence-synthesis-framework",
  "description": "Synthesize evidence across heterogeneous sources: classify and weight evidence by type and rigor, identify convergent and divergent findings, resolve contradictions, quantify confidence, and produce the synthesis report.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "evidence-inventory-builder",
      "inputs": {
        "evidence-sources": "from_user_input",
        "synthesis-question": "from_user_input"
      },
      "outputs": {
        "evidence-inventory": "evidence-inventory",
        "evidence-typology": "evidence-typology"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "rigor-weighting-engine",
      "inputs": {
        "evidence-inventory": "step_1.evidence-inventory"
      },
      "outputs": {
        "weighted-evidence-table": "weighted-evidence-table",
        "weighting-rubric": "weighting-rubric"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "convergence-divergence-mapper",
      "inputs": {
        "weighted-evidence-table": "step_2.weighted-evidence-table"
      },
      "outputs": {
        "convergence-map": "convergence-map",
        "divergence-catalog": "divergence-catalog"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "contradiction-resolver",
      "inputs": {
        "divergence-catalog": "step_3.divergence-catalog"
      },
      "outputs": {
        "resolution-table": "resolution-table",
        "residual-contradictions": "residual-contradictions"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "confidence-quantifier",
      "inputs": {
        "convergence-map": "step_3.convergence-map",
        "resolution-table": "step_4.resolution-table",
        "weighted-evidence-table": "step_2.weighted-evidence-table"
      },
      "outputs": {
        "confidence-ratings": "confidence-ratings",
        "downgrade-upgrade-log": "downgrade-upgrade-log"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "synthesis-report-composer",
      "inputs": {
        "convergence-map": "step_3.convergence-map",
        "confidence-ratings": "step_5.confidence-ratings",
        "residual-contradictions": "step_4.residual-contradictions"
      },
      "outputs": {
        "synthesis-report": "synthesis-report",
        "research-gap-list": "research-gap-list"
      },
      "parallel_group": 6
    }
  ],
