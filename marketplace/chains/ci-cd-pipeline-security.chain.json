      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "cicd-dependency-confusion-test",
      "inputs": {
        "pipeline-inventory": "step_1.pipeline-inventory",
        "scope-definition": "from_context.scope-definition"
      },
      "outputs": {
        "confusion-findings": "confusion-findings",
        "registry-config-assessment": "registry-config-assessment"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "cicd-artifact-integrity-check",
      "inputs": {
        "pipeline-inventory": "step_1.pipeline-inventory",
        "confusion-findings": "step_5.confusion-findings"
      },
      "outputs": {
        "integrity-findings": "integrity-findings",
        "tamper-resistance-score": "tamper-resistance-score"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "cicd-security-report",
      "inputs": {
        "secrets-findings": "step_2.secrets-findings",
        "isolation-results": "step_3.isolation-results",
        "gate-assessment": "step_4.gate-assessment",
        "integrity-findings": "step_6.integrity-findings"
      },
      "outputs": {
        "cicd-security-report": "cicd-security-report",
        "remediation-plan": "remediation-plan"
      },
      "parallel_group": 7
    }
