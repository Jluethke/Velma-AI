      "id": "step_1",
      "skill_name": "cicd-pipeline-inventory",
      "inputs": {
        "build-system-access": "from_user_input",
        "scope-definition": "from_user_input"
      },
      "outputs": {
        "pipeline-inventory": "pipeline-inventory",
        "access-map": "access-map"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
