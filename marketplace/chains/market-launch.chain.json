      "to_step": "step_3",
      "data_type": "competitor_profiles",
      "field_mapping": "competitor_profiles -> input"
    },
    {
      "from_step": "step_3",
      "to_step": "step_4",
      "data_type": "market_sizing",
      "field_mapping": "market_sizing -> brand_context; market_sizing -> audience_segments; market_sizing -> content_pillars; market_sizing -> distribution_channels; market_sizing -> performance_data"
    }
  ],
