{
  "name": "market-launch",
  "description": "Full market launch pipeline: research the market, tear down competitors, build entry strategy, create content plan.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "research-synthesizer",
      "inputs": {
        "research_question": "from_context.research_question",
        "source_types": "from_context.source_types",
        "depth_level": "from_context.depth_level",
        "existing_knowledge": "from_context.existing_knowledge",
        "constraints": "from_context.constraints"
      },
      "outputs": {
        "executive_summary": "object",
        "detailed_findings": "object",
        "source_credibility_scores": "object",
        "confidence_levels": "object",
        "knowledge_gaps": "object",
        "contradiction_report": "object"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "competitor-teardown",
      "inputs": {
        "company_profile": "step_1.executive_summary",
        "known_competitors": "step_1.executive_summary",
        "product_features": "step_1.executive_summary",
        "market_context": "step_1.executive_summary"
      },
      "outputs": {
        "competitor_profiles": "competitor_profiles_data",
        "feature_matrix": "feature_matrix_data",
        "positioning_map": "positioning_map_data",
        "gap_analysis": "gap_analysis_data",
        "strategic_recommendations": "strategic_recommendations_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "market-entry-analyzer",
      "inputs": {
        "product_description": "step_1.executive_summary",
        "target_market": "step_1.executive_summary",
        "company_capabilities": "step_1.executive_summary",
        "competitive_landscape": "step_1.executive_summary",
        "resource_constraints": "step_1.executive_summary"
      },
      "outputs": {
        "market_sizing": "market_sizing_data",
        "competitive_map": "competitive_map_data",
        "positioning_strategy": "positioning_strategy_data",
        "gtm_plan": "gtm_plan_data",
        "risk_assessment": "risk_assessment_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "growth-content-system",
      "inputs": {
        "brand_context": "step_3.market_sizing",
        "audience_segments": "step_3.market_sizing",
        "content_pillars": "step_3.market_sizing",
        "distribution_channels": "step_3.market_sizing",
        "performance_data": "step_3.market_sizing"
      },
      "outputs": {
        "content_strategy": "content_strategy_data",
        "content_ideas": "content_ideas_data",
        "content_drafts": "content_drafts_data",
        "distribution_plan": "distribution_plan_data",
        "performance_analysis": "performance_analysis_data"
      },
      "parallel_group": 4
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "result",
      "field_mapping": "result -> company_profile; result -> known_competitors; result -> product_features; result -> market_context"
