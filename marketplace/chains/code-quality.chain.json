      "skill_name": "security-hardening",
      "inputs": {
        "codebase_context": "from_context.codebase_context",
        "deployment_environment": "from_context.deployment_environment",
        "auth_mechanism": "from_context.auth_mechanism",
        "task_description": "from_context.task_description"
