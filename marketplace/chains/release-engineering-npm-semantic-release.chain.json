      "s02_rel_commit_history_audit",
      "s03_rel_node_api_break_extractor",
      "s06_rel_node_reproducible_pack"
    ],
    [
      "s04_rel_semver_bump_decision",
      "s07_rel_slsa_provenance_attest"
    ],
    [
      "s05_rel_changelog_semantic_release",
      "s08_rel_node_publish_npm_provenance"
    ],
    [
      "s09_rel_node_verify_install"
