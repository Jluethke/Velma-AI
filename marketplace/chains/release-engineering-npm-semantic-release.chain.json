      "field_mapping": {
        "node_dist": "node_dist"
      }
    },
    {
      "from_step": "s06_rel_node_reproducible_pack",
      "to_step": "s08_rel_node_publish_npm_provenance",
      "data_type": "rel-node-reproducible-pack",
      "field_mapping": {
        "node_dist": "node_dist"
      }
    },
    {
      "from_step": "s04_rel_semver_bump_decision",
      "to_step": "s08_rel_node_publish_npm_provenance",
      "data_type": "rel-semver-bump-decision",
      "field_mapping": {
        "next_version": "next_version"
      }
    },
    {
      "from_step": "s07_rel_slsa_provenance_attest",
      "to_step": "s08_rel_node_publish_npm_provenance",
      "data_type": "rel-slsa-provenance-attest",
      "field_mapping": {
        "provenance_verification": "provenance_verification"
      }
    },
    {
      "from_step": "s04_rel_semver_bump_decision",
      "to_step": "s09_rel_node_verify_install",
      "data_type": "rel-semver-bump-decision",
      "field_mapping": {
        "next_version": "next_version"
      }
    },
    {
      "from_step": "s08_rel_node_publish_npm_provenance",
      "to_step": "s09_rel_node_verify_install",
      "data_type": "rel-node-publish-npm-provenance",
      "field_mapping": {
        "npm_release_url": "npm_release_url"
      }
    }
  ],
  "entry_inputs": [
    "repo_path",
    "ci_platform",
    "last_tag",
    "package_name",
    "current_version",
    "prerelease_id",
    "py_api_breaks",
    "go_api_breaks",
    "rust_api_breaks",
    "deprecation_notices",
    "branching_model",
