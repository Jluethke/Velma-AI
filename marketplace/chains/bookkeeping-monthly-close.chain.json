{
  "name": "bookkeeping-monthly-close",
  "description": "Perform a monthly bookkeeping close from bank reconciliation through financial statement preparation.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "bank-account-reconciler",
      "inputs": {
        "bank-statements": "from_user_input",
        "general-ledger": "from_user_input"
      },
      "outputs": {
        "reconciliation-report": "reconciliation-report",
        "unmatched-items": "unmatched-items"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "accrual-adjustment-recorder",
      "inputs": {
        "reconciliation-report": "step_1.reconciliation-report",
        "accrual-schedule": "from_context.accrual-schedule"
      },
      "outputs": {
        "adjustment-entries": "adjustment-entries",
        "updated-ledger": "updated-ledger"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "receivable-payable-reconciler",
      "inputs": {
        "updated-ledger": "step_2.updated-ledger",
        "subledger-reports": "from_context.subledger-reports"
      },
      "outputs": {
        "subledger-reconciliation": "subledger-reconciliation",
        "aging-summary": "aging-summary"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "trial-balance-reviewer",
      "inputs": {
        "updated-ledger": "step_2.updated-ledger",
        "prior-period-trial-balance": "from_context.prior-period-trial-balance"
      },
      "outputs": {
        "reviewed-trial-balance": "reviewed-trial-balance",
        "correction-entries": "correction-entries"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "financial-statement-preparer",
      "inputs": {
        "reviewed-trial-balance": "step_4.reviewed-trial-balance",
        "prior-period-financials": "from_context.prior-period-financials"
      },
      "outputs": {
        "income-statement": "income-statement",
        "balance-sheet": "balance-sheet",
        "cash-flow-statement": "cash-flow-statement"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "month-end-close-packager",
      "inputs": {
        "income-statement": "step_5.income-statement",
        "balance-sheet": "step_5.balance-sheet",
        "reconciliation-report": "step_1.reconciliation-report"
      },
      "outputs": {
        "close-package": "close-package",
        "close-checklist": "close-checklist"
      },
      "parallel_group": 6
    }
  ],
