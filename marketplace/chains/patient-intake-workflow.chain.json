{
  "name": "patient-intake-workflow",
  "description": "Process a new patient intake from demographic collection through provider assignment.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "demographic-insurance-collector",
      "inputs": {
        "patient-name": "from_user_input",
        "contact-info": "from_user_input"
      },
      "outputs": {
        "demographic-record": "demographic-record",
        "insurance-details": "insurance-details"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "medical-history-gatherer",
      "inputs": {
        "demographic-record": "step_1.demographic-record",
        "patient-responses": "from_context.patient-responses"
      },
      "outputs": {
        "medical-history": "medical-history",
        "medication-list": "medication-list"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "allergy-adverse-reaction-documenter",
      "inputs": {
        "patient-responses": "from_context.patient-responses",
        "medication-list": "step_2.medication-list"
      },
      "outputs": {
        "allergy-list": "allergy-list",
        "interaction-flags": "interaction-flags"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "vital-signs-chief-complaint-collector",
      "inputs": {
        "demographic-record": "step_1.demographic-record",
        "medical-history": "step_2.medical-history"
      },
      "outputs": {
        "vital-signs": "vital-signs",
        "chief-complaint": "chief-complaint"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "insurance-eligibility-verifier",
      "inputs": {
        "insurance-details": "step_1.insurance-details",
        "chief-complaint": "step_4.chief-complaint"
      },
      "outputs": {
        "eligibility-status": "eligibility-status",
        "benefit-summary": "benefit-summary"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "provider-assignment-engine",
      "inputs": {
        "chief-complaint": "step_4.chief-complaint",
        "eligibility-status": "step_5.eligibility-status"
      },
      "outputs": {
        "assigned-provider": "assigned-provider",
        "intake-record": "intake-record"
      },
      "parallel_group": 6
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
