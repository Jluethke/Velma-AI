{
  "name": "incident-response-tabletop",
  "description": "Run an incident response tabletop exercise by defining a scenario, walking through detection and response procedures, and identifying gaps.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "ir-scenario-definition",
      "inputs": {
        "organization-context": "from_user_input",
        "exercise-objectives": "from_user_input"
      },
      "outputs": {
        "scenario-document": "scenario-document",
        "participant-guide": "participant-guide"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "ir-detection-triage-walkthrough",
      "inputs": {
        "scenario-document": "step_1.scenario-document",
        "organization-context": "from_context.organization-context"
      },
      "outputs": {
        "detection-assessment": "detection-assessment",
        "triage-walkthrough": "triage-walkthrough"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "ir-escalation-comms-test",
      "inputs": {
        "scenario-document": "step_1.scenario-document",
        "detection-assessment": "step_2.detection-assessment"
      },
      "outputs": {
        "escalation-findings": "escalation-findings",
        "communication-findings": "communication-findings"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "ir-containment-eradication-exercise",
      "inputs": {
        "triage-walkthrough": "step_2.triage-walkthrough",
        "escalation-findings": "step_3.escalation-findings"
      },
      "outputs": {
        "containment-assessment": "containment-assessment",
        "eradication-gaps": "eradication-gaps"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "ir-recovery-continuity-review",
      "inputs": {
        "containment-assessment": "step_4.containment-assessment",
        "scenario-document": "step_1.scenario-document"
      },
      "outputs": {
        "recovery-assessment": "recovery-assessment",
        "continuity-gaps": "continuity-gaps"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "ir-gap-analysis",
      "inputs": {
        "detection-assessment": "step_2.detection-assessment",
        "escalation-findings": "step_3.escalation-findings",
        "containment-assessment": "step_4.containment-assessment",
        "recovery-assessment": "step_5.recovery-assessment"
      },
      "outputs": {
        "gap-list": "gap-list",
        "improvement-actions": "improvement-actions"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "ir-tabletop-report",
      "inputs": {
        "gap-list": "step_6.gap-list",
        "improvement-actions": "step_6.improvement-actions"
      },
      "outputs": {
        "tabletop-report": "tabletop-report",
        "action-tracker": "action-tracker"
      },
      "parallel_group": 7
    }
  ],
