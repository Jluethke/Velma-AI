{
  "name": "escalation-path-architecture",
  "description": "Design escalation paths for any organization or system. Define triggers, receivers, authority levels, and response times. Build in skip-level paths for emergencies. Test with a drill. An untested escalation path is a wish, not a plan.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "escalation-trigger-inventory",
      "inputs": {
        "system-or-org-description": "from_user_input",
        "historical-incidents": "from_user_input"
      },
      "outputs": {
        "trigger-catalog": "trigger-catalog",
        "severity-levels": "severity-levels"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "escalation-receiver-mapper",
      "inputs": {
        "severity-levels": "step_1.severity-levels",
        "system-or-org-description": "from_context.system-or-org-description"
      },
      "outputs": {
        "receiver-map": "receiver-map",
        "authority-gaps": "authority-gaps"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "skip-level-path-builder",
      "inputs": {
        "receiver-map": "step_2.receiver-map",
        "trigger-catalog": "step_1.trigger-catalog"
      },
      "outputs": {
        "skip-level-criteria": "skip-level-criteria",
        "skip-level-path": "skip-level-path"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "escalation-communication-template-set",
      "inputs": {
        "severity-levels": "step_1.severity-levels",
        "receiver-map": "step_2.receiver-map"
      },
      "outputs": {
        "template-set": "template-set",
        "information-checklist": "information-checklist"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "escalation-drill-runner",
      "inputs": {
        "receiver-map": "step_2.receiver-map",
        "template-set": "step_4.template-set",
        "skip-level-path": "step_3.skip-level-path"
      },
      "outputs": {
        "drill-results": "drill-results",
        "path-revisions": "path-revisions"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "escalation-path-maintenance-plan",
      "inputs": {
        "drill-results": "step_5.drill-results",
        "path-revisions": "step_5.path-revisions"
      },
      "outputs": {
        "maintenance-schedule": "maintenance-schedule",
        "final-escalation-path-document": "final-escalation-path-document"
      },
      "parallel_group": 6
    }
  ],
