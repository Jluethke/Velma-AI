        "stack": "from_user_input",
        "project_dir": "from_user_input"
      },
      "outputs": {
        "link_paginator": "link_paginator"
      },
      "condition": "'link_header' in api_inventory.pagination_styles",
      "parallel_group": 8
    },
    {
      "id": "s18_sdk_error_hierarchy",
      "skill_name": "sdk-error-hierarchy",
      "inputs": {
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
