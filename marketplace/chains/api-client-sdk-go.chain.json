      },
      "parallel_group": 9
    },
    {
      "id": "s14_sdk_idempotency_keys",
      "skill_name": "sdk-idempotency-keys",
      "inputs": {
        "retry_policy": "s13_sdk_retry_backoff.retry_policy",
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "stack": "from_user_input",
        "project_dir": "from_user_input"
      },
      "outputs": {
        "idempotency_design": "idempotency_design"
      },
      "condition": "api_inventory.idempotency_header != 'unknown'",
      "parallel_group": 10
    },
    {
      "id": "s15_sdk_pagination_cursor",
      "skill_name": "sdk-pagination-cursor",
      "inputs": {
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "stack": "from_user_input",
        "project_dir": "from_user_input"
      },
      "outputs": {
        "cursor_paginator": "cursor_paginator"
      },
      "condition": "'cursor' in api_inventory.pagination_styles",
      "parallel_group": 8
    },
    {
      "id": "s16_sdk_pagination_offset",
      "skill_name": "sdk-pagination-offset",
      "inputs": {
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "stack": "from_user_input",
        "project_dir": "from_user_input"
      },
      "outputs": {
        "offset_paginator": "offset_paginator"
      },
      "condition": "'offset' in api_inventory.pagination_styles",
      "parallel_group": 8
    },
    {
      "id": "s17_sdk_pagination_link_header",
      "skill_name": "sdk-pagination-link-header",
