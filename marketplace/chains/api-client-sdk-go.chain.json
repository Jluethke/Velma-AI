{
  "name": "api-client-sdk-go",
  "description": "Build a Go client SDK from an OpenAPI spec: lint, inventory, Go generation or handwritten mapping, coverage audit, auth, timeouts, retries, idempotency, pagination, errors, typed responses, mock tests and Prism contract tests. Set stack to 'go'.",
  "steps": [
    {
      "id": "s01_sdk_spec_spectral_lint",
      "skill_name": "sdk-spec-spectral-lint",
      "inputs": {
        "spec_path": "from_user_input",
        "spectral_ruleset": "from_user_input_optional"
      },
      "outputs": {
        "lint_report": "lint_report",
        "validated_spec": "validated_spec"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_sdk_spec_sdk_readiness_rules",
      "skill_name": "sdk-spec-sdk-readiness-rules",
      "inputs": {
        "validated_spec": "s01_sdk_spec_spectral_lint.validated_spec",
        "lint_report": "s01_sdk_spec_spectral_lint.lint_report"
      },
      "outputs": {
        "readiness_ruleset": "readiness_ruleset",
        "readiness_report": "readiness_report"
      },
      "parallel_group": 2
    },
    {
      "id": "s03_sdk_spec_inventory",
      "skill_name": "sdk-spec-inventory",
      "inputs": {
        "validated_spec": "s01_sdk_spec_spectral_lint.validated_spec",
        "readiness_report": "s02_sdk_spec_sdk_readiness_rules.readiness_report"
      },
      "outputs": {
        "api_inventory": "api_inventory"
      },
      "parallel_group": 3
    },
    {
      "id": "s04_sdk_generator_decision",
      "skill_name": "sdk-generator-decision",
      "inputs": {
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "stack": "from_user_input",
        "sdk_constraints": "from_user_input_optional"
      },
      "outputs": {
        "generation_plan": "generation_plan"
      },
      "parallel_group": 4
    },
    {
      "id": "s05_sdk_model_type_mapping",
      "skill_name": "sdk-model-type-mapping",
      "inputs": {
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "validated_spec": "s01_sdk_spec_spectral_lint.validated_spec",
        "stack": "from_user_input"
      },
      "outputs": {
        "type_mapping": "type_mapping"
      },
      "parallel_group": 4
    },
    {
      "id": "s06_sdk_go_oapi_codegen",
      "skill_name": "sdk-go-oapi-codegen",
      "inputs": {
        "validated_spec": "s01_sdk_spec_spectral_lint.validated_spec",
        "generation_plan": "s04_sdk_generator_decision.generation_plan",
        "type_mapping": "s05_sdk_model_type_mapping.type_mapping",
        "project_dir": "from_user_input"
      },
      "outputs": {
        "go_client_package": "go_client_package"
      },
      "condition": "generation_plan.approach != 'handwritten'",
      "parallel_group": 5
    },
    {
      "id": "s07_sdk_handwritten_endpoint_map",
      "skill_name": "sdk-handwritten-endpoint-map",
      "inputs": {
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "type_mapping": "s05_sdk_model_type_mapping.type_mapping",
        "generation_plan": "s04_sdk_generator_decision.generation_plan",
        "stack": "from_user_input",
        "project_dir": "from_user_input"
      },
      "outputs": {
        "endpoint_map": "endpoint_map"
      },
      "condition": "generation_plan.approach != 'generated'",
      "parallel_group": 6
    },
    {
      "id": "s08_sdk_endpoint_coverage_audit",
      "skill_name": "sdk-endpoint-coverage-audit",
      "inputs": {
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "stack": "from_user_input",
        "project_dir": "from_user_input"
      },
      "outputs": {
        "coverage_report": "coverage_report"
      },
      "parallel_group": 7
    },
    {
      "id": "s09_sdk_auth_api_key",
      "skill_name": "sdk-auth-api-key",
      "inputs": {
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "stack": "from_user_input",
        "project_dir": "from_user_input"
      },
      "outputs": {
        "api_key_auth": "api_key_auth"
      },
      "condition": "'apiKey' in api_inventory.auth_schemes",
      "parallel_group": 8
    },
    {
      "id": "s10_sdk_auth_oauth_client_credentials",
      "skill_name": "sdk-auth-oauth-client-credentials",
      "inputs": {
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "stack": "from_user_input",
        "project_dir": "from_user_input",
        "token_expiry_skew_seconds": "from_user_input_optional"
      },
      "outputs": {
        "token_provider": "token_provider"
      },
      "condition": "'oauth2_client_credentials' in api_inventory.auth_schemes || 'oauth2_authorization_code' in api_inventory.auth_schemes || 'oidc' in api_inventory.auth_schemes",
      "parallel_group": 8
    },
    {
      "id": "s11_sdk_auth_token_refresh",
      "skill_name": "sdk-auth-token-refresh",
      "inputs": {
        "token_provider": "s10_sdk_auth_oauth_client_credentials.token_provider",
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "stack": "from_user_input",
        "project_dir": "from_user_input"
      },
      "outputs": {
        "refresh_policy": "refresh_policy"
      },
      "condition": "'oauth2_authorization_code' in api_inventory.auth_schemes || 'oidc' in api_inventory.auth_schemes",
      "parallel_group": 9
    },
    {
      "id": "s12_sdk_go_timeouts",
      "skill_name": "sdk-go-timeouts",
      "inputs": {
        "project_dir": "from_user_input",
        "timeout_budget": "from_user_input"
      },
      "outputs": {
        "go_timeout_config": "go_timeout_config"
      },
      "parallel_group": 8
    },
    {
      "id": "s13_sdk_retry_backoff",
      "skill_name": "sdk-retry-backoff",
      "inputs": {
        "api_inventory": "s03_sdk_spec_inventory.api_inventory",
        "stack": "from_user_input",
        "project_dir": "from_user_input",
        "retry_limits": "from_user_input"
      },
      "outputs": {
