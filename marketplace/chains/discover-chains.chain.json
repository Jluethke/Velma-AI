{
  "name": "discover-chains",
  "description": "The meta-flow. Tell it what's going on in your life and it figures out which flow pipelines you need  --  then designs NEW flow pipelines from the 120+ available skills if nothing fits perfectly. Finds your blind spots first, decomposes your situation into sub-problems, matches each to existing flow pipelines, and designs custom flows for the gaps.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "blind-spot-finder",
      "inputs": {
        "situation": "from_user_input",
        "what_you_know": "from_user_input",
        "what_worries_you": "from_user_input",
        "domain": "from_user_input"
      },
      "outputs": {
        "blind_spots": "blind_spots_data",
        "assumptions": "assumptions_data",
        "second_order": "second_order_data",
        "who_else": "who_else_data",
        "the_one_question": "the_one_question_data"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "problem-decomposer",
      "inputs": {
        "problem_statement": "step_1.blind_spots",
        "constraints": "step_1.blind_spots",
        "stakeholders": "step_1.blind_spots",
        "context": "step_1.blind_spots",
        "known_sub_problems": "step_1.blind_spots"
      },
      "outputs": {
        "decomposition_tree": "decomposition_tree_data",
        "dependency_graph": "dependency_graph_data",
        "critical_path": "critical_path_data",
        "execution_roadmap": "execution_roadmap_data",
        "completeness_validation": "completeness_validation_data"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "multi-skill-orchestrator",
      "inputs": {
        "input": "step_2.decomposition_tree"
      },
      "outputs": {
        "result": "result_data"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "flow-designer",
      "inputs": {
        "goal": "step_2.decomposition_tree",
        "available_skills": "step_2.decomposition_tree",
        "constraints": "step_2.decomposition_tree",
        "existing_data": "step_2.decomposition_tree"
      },
      "outputs": {
        "chain_definition": "chain_definition_data",
        "coverage_report": "coverage_report_data",
        "execution_plan": "execution_plan_data",
        "missing_skills": "missing_skills_data"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "checklist-builder",
      "inputs": {
        "goal_or_event": "step_3.result",
        "deadline": "step_3.result",
        "constraints": "step_3.result",
        "experience_level": "step_3.result"
      },
      "outputs": {
        "checklist": "checklist_data",
        "timeline": "timeline_data",
        "dont_forget": "dont_forget_data",
        "dependencies": "dependencies_data"
      },
      "parallel_group": 5
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "blind_spots",
      "field_mapping": "blind_spots -> problem_statement; blind_spots -> constraints; blind_spots -> stakeholders; blind_spots -> context; blind_spots -> known_sub_problems"
    },
    {
      "from_step": "step_2",
      "to_step": "step_3",
      "data_type": "result",
      "field_mapping": "result -> input"
    },
    {
      "from_step": "step_2",
      "to_step": "step_4",
      "data_type": "decomposition_tree",
      "field_mapping": "decomposition_tree -> goal; decomposition_tree -> available_skills; decomposition_tree -> constraints; decomposition_tree -> existing_data"
    },
    {
      "from_step": "step_3",
      "to_step": "step_4",
      "data_type": "result",
      "field_mapping": "result -> input"
    },
    {
      "from_step": "step_3",
      "to_step": "step_5",
      "data_type": "result",
      "field_mapping": "result -> goal_or_event; result -> deadline; result -> constraints; result -> experience_level"
    },
    {
      "from_step": "step_4",
      "to_step": "step_5",
      "data_type": "chain_definition",
      "field_mapping": "chain_definition -> input"
    }
  ],
  "entry_inputs": [
    "domain",
    "situation",
    "what_worries_you",
    "what_you_know"
  ],
  "terminal_outputs": [
    "checklist",
    "timeline",
    "dont_forget",
    "dependencies"
  ],
  "parallel_groups": [
    [
      "step_1"
    ],
    [
      "step_2"
    ],
    [
      "step_3"
    ],
    [
      "step_4"
    ],
    [
      "step_5"
    ]
  ],
  "estimated_cost": 0,
  "critical_path": [
    "step_1",
    "step_2",
    "step_3",
    "step_4",
    "step_5"
  ],
  "chain_links": {
    "next_chains": [],
    "related_chains": [
      {
        "chain_name": "skill-to-chain",
        "relationship": "complement"
      }
    ],
    "prerequisites": []
  }
}
