{
  "name": "assisted-living-evaluator",
  "description": "Evaluate assisted living options: needs assessment, facility comparison, cost analysis, transition planning, and quality monitoring.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "elder-care-needs-assessment",
      "inputs": {
        "current_abilities": "from_user_input",
        "medical_conditions": "from_user_input",
        "cognitive_status": "from_user_input",
        "social_situation": "from_user_input"
      },
