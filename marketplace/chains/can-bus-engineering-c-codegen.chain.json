      },
      "outputs": {
        "vcan_setup": "vcan_setup"
      },
      "parallel_group": 1
    },
    {
      "id": "s03_canb_dbc_lint_load",
      "skill_name": "canb-dbc-lint-load",
      "inputs": {
        "dbc_file": "from_user_input"
      },
      "outputs": {
        "dbc_report": "dbc_report"
      },
      "parallel_group": 1
    },
    {
