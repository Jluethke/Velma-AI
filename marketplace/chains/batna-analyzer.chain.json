{
  "name": "batna-analyzer",
  "description": "Determine your Best Alternative To a Negotiated Agreement before entering any negotiation. Your BATNA sets your walk-away point. A negotiator without a BATNA accepts bad deals because walking away feels worse than any offer on the table. Strengthen your BATNA before negotiating.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "alternative-generator",
      "inputs": {
        "negotiation-context": "from_user_input",
        "what-you-need": "from_user_input"
      },
      "outputs": {
        "alternatives-list": "alternatives-list",
        "alternative-costs": "alternative-costs"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "batna-evaluator",
      "inputs": {
        "alternatives-list": "step_1.alternatives-list",
        "alternative-costs": "step_1.alternative-costs"
      },
      "outputs": {
        "batna": "batna",
        "reservation-price": "reservation-price"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "batna-strengthener",
      "inputs": {
        "batna": "step_2.batna",
        "negotiation-context": "from_context.negotiation-context"
      },
      "outputs": {
        "strengthening-actions": "strengthening-actions",
        "updated-batna": "updated-batna"
      },
      "parallel_group": 3
    }
  ],
  "edges": [
    {
      "from_step": "step_1",
      "to_step": "step_2",
      "data_type": "object",
      "field_mapping": {}
    },
    {
      "from_step": "step_2",
      "to_step": "step_3",
      "data_type": "object",
      "field_mapping": {}
    }
  ],
  "entry_inputs": [
