      "outputs": {
        "resource-inventory": "resource-inventory",
        "dependency-map": "dependency-map"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "iac-tool-selector",
      "inputs": {
        "resource-inventory": "step_1.resource-inventory",
        "team-expertise": "from_context.team-expertise"
      },
      "outputs": {
        "selected-iac-tool": "selected-iac-tool",
        "module-structure": "module-structure"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "iac-configuration-writer",
      "inputs": {
        "resource-inventory": "step_1.resource-inventory",
