      },
      "outputs": {
        "imported-state": "imported-state",
        "import-log": "import-log"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "iac-staging-validator",
      "inputs": {
        "iac-configurations": "step_3.iac-configurations",
        "imported-state": "step_4.imported-state"
      },
      "outputs": {
        "validation-results": "validation-results",
        "drift-report": "drift-report"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "iac-cicd-setup",
      "inputs": {
        "validation-results": "step_5.validation-results",
