{
  "name": "critical-chain-scheduler",
  "description": "Apply Goldratt's Critical Chain method to any multi-step initiative. Remove task-level safety padding (which people add to every estimate and then waste). Add a project buffer at the end of the critical chain and feeding buffers where non-critical paths join. Manage by buffer consumption, not by individual task deadlines. Projects finish faster because padding is concentrated where it is useful instead of dispersed where it is wasted.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "task-network-builder",
      "inputs": {
        "initiative-description": "from_user_input",
        "task-list": "from_user_input"
      },
      "outputs": {
        "task-network": "task-network",
        "critical-path": "critical-path"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "resource-contention-resolver",
      "inputs": {
        "task-network": "step_1.task-network",
        "critical-path": "step_1.critical-path"
      },
      "outputs": {
        "critical-chain": "critical-chain",
        "resource-conflicts": "resource-conflicts"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "padding-remover-and-buffer-builder",
      "inputs": {
        "critical-chain": "step_2.critical-chain",
        "task-network": "step_1.task-network"
      },
      "outputs": {
        "aggressive-estimates": "aggressive-estimates",
        "project-buffer": "project-buffer",
        "feeding-buffers": "feeding-buffers"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "buffer-management-protocol",
      "inputs": {
        "project-buffer": "step_3.project-buffer",
        "feeding-buffers": "step_3.feeding-buffers"
      },
      "outputs": {
        "buffer-status-dashboard": "buffer-status-dashboard",
        "buffer-management-rules": "buffer-management-rules"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "critical-chain-review",
      "inputs": {
        "buffer-status-dashboard": "step_4.buffer-status-dashboard",
        "aggressive-estimates": "step_3.aggressive-estimates"
      },
      "outputs": {
        "estimation-accuracy": "estimation-accuracy",
        "method-improvements": "method-improvements"
      },
      "parallel_group": 5
    }
  ],
  "edges": [
