{
  "name": "compliance-gap-analysis",
  "description": "Assess compliance gaps against a security framework (NIST CSF, SOC2, ISO 27001): control mapping, gap identification, risk prioritization, effort estimation, owner assignment, and remediation roadmap.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "framework-control-mapper",
      "inputs": {
        "target-framework": "from_user_input",
        "existing-controls-inventory": "from_user_input"
      },
      "outputs": {
        "control-mapping": "control-mapping",
        "coverage-summary": "coverage-summary"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "compliance-gap-identifier",
      "inputs": {
        "control-mapping": "step_1.control-mapping",
        "coverage-summary": "step_1.coverage-summary"
      },
      "outputs": {
        "gap-inventory": "gap-inventory",
        "gap-evidence-list": "gap-evidence-list"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "compliance-risk-prioritizer",
      "inputs": {
        "gap-inventory": "step_2.gap-inventory",
        "target-framework": "from_context.target-framework"
      },
      "outputs": {
        "prioritized-gap-list": "prioritized-gap-list",
        "risk-heat-map": "risk-heat-map"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "remediation-effort-estimator",
      "inputs": {
        "prioritized-gap-list": "step_3.prioritized-gap-list",
        "existing-controls-inventory": "from_context.existing-controls-inventory"
      },
      "outputs": {
        "effort-estimates": "effort-estimates",
        "quick-win-list": "quick-win-list"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "gap-owner-assigner",
      "inputs": {
        "effort-estimates": "step_4.effort-estimates",
        "team-contacts": "from_context.team-contacts"
      },
      "outputs": {
        "ownership-assignments": "ownership-assignments",
        "capacity-conflicts": "capacity-conflicts"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "remediation-roadmap-builder",
      "inputs": {
        "deduplicated-findings": "from_context.deduplicated-findings",
        "root-cause-map": "from_context.root-cause-map",
        "executive-summary": "from_context.executive-summary"
      },
      "outputs": {
        "remediation-roadmap": "remediation-roadmap",
        "pentest-report": "pentest-report"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "compliance-gap-report-compiler",
      "inputs": {
        "control-mapping": "step_1.control-mapping",
        "risk-heat-map": "step_3.risk-heat-map",
        "remediation-roadmap": "step_6.remediation-roadmap",
        "effort-estimates": "step_4.effort-estimates"
      },
      "outputs": {
        "compliance-gap-report": "compliance-gap-report",
        "executive-summary": "executive-summary"
      },
      "parallel_group": 7
    }
  ],
