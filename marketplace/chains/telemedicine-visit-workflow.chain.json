{
  "name": "telemedicine-visit-workflow",
  "description": "Conduct a telemedicine visit from identity verification through visit summary.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "telehealth-identity-verifier",
      "inputs": {
        "patient-id": "from_user_input",
        "appointment-details": "from_user_input"
      },
      "outputs": {
        "identity-confirmed": "identity-confirmed",
        "patient-location": "patient-location"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "telehealth-consent-collector",
      "inputs": {
        "identity-confirmed": "step_1.identity-confirmed",
        "patient-location": "step_1.patient-location"
      },
      "outputs": {
        "consent-status": "consent-status",
        "consent-record": "consent-record"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "video-clinical-assessor",
      "inputs": {
        "consent-status": "step_2.consent-status",
        "patient-record": "from_context.patient-record"
      },
      "outputs": {
        "assessment-findings": "assessment-findings",
        "patient-reported-symptoms": "patient-reported-symptoms"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "telehealth-encounter-documenter",
      "inputs": {
        "assessment-findings": "step_3.assessment-findings",
        "patient-reported-symptoms": "step_3.patient-reported-symptoms"
      },
      "outputs": {
        "encounter-note": "encounter-note",
        "billing-codes": "billing-codes"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "telehealth-order-placer",
      "inputs": {
        "encounter-note": "step_4.encounter-note",
        "assessment-findings": "step_3.assessment-findings"
      },
      "outputs": {
        "prescription-orders": "prescription-orders",
        "diagnostic-orders": "diagnostic-orders"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "visit-summary-provider",
      "inputs": {
        "encounter-note": "step_4.encounter-note",
        "prescription-orders": "step_5.prescription-orders"
      },
      "outputs": {
        "visit-summary": "visit-summary",
        "telemedicine-encounter-record": "telemedicine-encounter-record"
      },
      "parallel_group": 6
    }
  ],
