{
  "name": "llm-application-security",
  "description": "Assess LLM-integrated application security: prompt injection (direct and indirect), training data extraction, output filtering, jailbreak resistance, excessive agency, and cross-session data leakage.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "prompt-injection-test-suite",
      "inputs": {
        "application-endpoint": "from_user_input",
        "system-prompt-access": "from_user_input"
      },
      "outputs": {
        "injection-findings": "injection-findings",
        "injection-resistance-score": "injection-resistance-score"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "training-data-extraction-test",
      "inputs": {
        "application-endpoint": "from_context.application-endpoint",
        "injection-findings": "step_1.injection-findings"
      },
      "outputs": {
        "extraction-findings": "extraction-findings",
        "memorization-risk-level": "memorization-risk-level"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "output-filtering-moderation-test",
      "inputs": {
        "application-endpoint": "from_context.application-endpoint",
        "extraction-findings": "step_2.extraction-findings"
      },
      "outputs": {
        "filter-bypass-findings": "filter-bypass-findings",
        "moderation-gap-list": "moderation-gap-list"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "jailbreak-resistance-test",
      "inputs": {
        "application-endpoint": "from_context.application-endpoint",
        "filter-bypass-findings": "step_3.filter-bypass-findings"
      },
      "outputs": {
        "jailbreak-findings": "jailbreak-findings",
        "jailbreak-resistance-score": "jailbreak-resistance-score"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "excessive-agency-tool-misuse-test",
      "inputs": {
        "application-endpoint": "from_context.application-endpoint",
        "jailbreak-findings": "step_4.jailbreak-findings"
      },
      "outputs": {
        "agency-findings": "agency-findings",
        "tool-abuse-paths": "tool-abuse-paths"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "cross-session-data-leakage-test",
      "inputs": {
        "application-endpoint": "from_context.application-endpoint",
        "agency-findings": "step_5.agency-findings"
      },
      "outputs": {
        "leakage-findings": "leakage-findings",
        "isolation-score": "isolation-score"
      },
      "parallel_group": 6
    },
    {
      "id": "step_7",
      "skill_name": "llm-security-report-compiler",
      "inputs": {
        "injection-findings": "step_1.injection-findings",
        "jailbreak-findings": "step_4.jailbreak-findings",
        "agency-findings": "step_5.agency-findings",
        "leakage-findings": "step_6.leakage-findings"
      },
      "outputs": {
        "llm-security-report": "llm-security-report",
        "owasp-llm-mapping": "owasp-llm-mapping"
      },
      "parallel_group": 7
    }
