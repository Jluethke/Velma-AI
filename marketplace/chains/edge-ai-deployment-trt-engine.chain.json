        "calibration_cache": "s02_edge_int8_calibration_cache.calibration_cache",
        "dla_core": "from_user_input_optional"
      },
      "outputs": {
        "engine_file": "engine_file",
        "build_log": "build_log"
      },
      "parallel_group": 3
    },
    {
      "id": "s04_edge_trt_engine_cache_key",
      "skill_name": "edge-trt-engine-cache-key",
      "inputs": {
        "engine_file": "s03_edge_trtexec_engine_build.engine_file",
        "onnx_model": "s01_edge_onnx_export_validate.onnx_model",
        "platform_report": "from_user_input",
        "cuda_stack_report": "from_user_input",
        "precision": "from_user_input",
        "input_shapes": "from_user_input"
      },
      "outputs": {
        "engine_cache_key": "engine_cache_key"
      },
      "parallel_group": 4
