{
  "name": "edge-ai-deployment-trt-engine",
  "description": "Turn a model into a validated TensorRT engine on the target device: ONNX export, optional INT8 calibration, trtexec build, per-device cache key, accuracy check and benchmark.",
  "steps": [
    {
