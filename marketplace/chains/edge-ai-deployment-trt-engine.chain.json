      "skill_name": "edge-onnx-export-validate",
      "inputs": {
        "model_path": "from_user_input",
        "input_shapes": "from_user_input",
        "opset_version": "from_user_input_optional"
      },
      "outputs": {
        "onnx_model": "onnx_model"
      },
      "parallel_group": 1
    },
    {
      "id": "s02_edge_int8_calibration_cache",
      "skill_name": "edge-int8-calibration-cache",
      "inputs": {
        "onnx_model": "s01_edge_onnx_export_validate.onnx_model",
        "calibration_data": "from_user_input",
        "precision": "from_user_input"
      },
      "outputs": {
        "calibration_cache": "calibration_cache"
      },
      "condition": "precision == 'int8'",
      "parallel_group": 2
    },
    {
      "id": "s03_edge_trtexec_engine_build",
      "skill_name": "edge-trtexec-engine-build",
      "inputs": {
        "device_host": "from_user_input",
