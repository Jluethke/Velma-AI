{
  "name": "process-documentation-method",
  "description": "Produce a process document that a newcomer can actually follow. Records the doer narrating the work, transcribes it into ordered steps, drafts a procedure, has a different person follow it, repairs every stuck point, and gates completion on a newcomer finishing the task using only the document. The test of a document is whether it works in someone else's hands.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "doer-narration-capture",
      "inputs": {
        "task-to-document": "from_user_input",
        "doer-identity": "from_user_input"
      },
      "outputs": {
        "narration-recording": "narration-recording",
        "task-scope": "task-scope"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "narration-transcription",
      "inputs": {
        "narration-recording": "step_1.narration-recording",
        "task-scope": "step_1.task-scope"
      },
      "outputs": {
        "raw-step-sequence": "raw-step-sequence",
        "decision-points": "decision-points"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "draft-procedure-writeup",
      "inputs": {
        "raw-step-sequence": "step_2.raw-step-sequence",
        "decision-points": "step_2.decision-points"
      },
      "outputs": {
        "draft-procedure": "draft-procedure",
        "assumed-knowledge": "assumed-knowledge"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "independent-follower-test",
      "inputs": {
        "draft-procedure": "step_3.draft-procedure",
        "assumed-knowledge": "step_3.assumed-knowledge"
      },
      "outputs": {
        "stuck-points": "stuck-points",
        "follower-feedback": "follower-feedback"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "gap-repair-pass",
      "inputs": {
        "draft-procedure": "step_3.draft-procedure",
        "stuck-points": "step_4.stuck-points",
        "follower-feedback": "step_4.follower-feedback"
      },
      "outputs": {
        "revised-procedure": "revised-procedure",
        "resolved-gaps": "resolved-gaps"
      },
      "parallel_group": 5
    },
    {
      "id": "step_6",
      "skill_name": "newcomer-completion-gate",
      "inputs": {
        "revised-procedure": "step_5.revised-procedure",
        "resolved-gaps": "step_5.resolved-gaps"
      },
      "outputs": {
        "validated-procedure": "validated-procedure",
        "completion-evidence": "completion-evidence"
      },
      "parallel_group": 6
    }
  ],
