{
  "name": "role-design-from-outcomes",
  "description": "Design roles starting from the measurable outcomes they must produce, not from a list of responsibilities. Responsibility-based job descriptions create busy people. Outcome-based job descriptions create productive people. Define the 3-5 outcomes the role must deliver in year one, then work backward to the activities, and then check whether one person can produce all of them.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "outcome-definer",
      "inputs": {
        "business-need": "from_user_input",
        "stakeholder-expectations": "from_user_input"
      },
      "outputs": {
        "role-outcomes": "role-outcomes",
        "outcome-priorities": "outcome-priorities"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "activity-reverse-engineer",
      "inputs": {
        "role-outcomes": "step_1.role-outcomes",
        "outcome-priorities": "step_1.outcome-priorities"
      },
      "outputs": {
        "activity-map": "activity-map",
        "total-time-estimate": "total-time-estimate"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "role-coherence-checker",
      "inputs": {
        "activity-map": "step_2.activity-map",
        "total-time-estimate": "step_2.total-time-estimate"
      },
      "outputs": {
        "coherence-assessment": "coherence-assessment",
        "role-structure-recommendation": "role-structure-recommendation"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "outcome-based-jd-writer",
      "inputs": {
        "coherence-assessment": "step_3.coherence-assessment",
        "role-structure-recommendation": "step_3.role-structure-recommendation"
      },
      "outputs": {
        "outcome-based-job-description": "outcome-based-job-description",
        "evaluation-criteria": "evaluation-criteria"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "90-day-outcome-plan-builder",
      "inputs": {
        "outcome-based-job-description": "step_4.outcome-based-job-description",
