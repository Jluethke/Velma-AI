{
  "name": "website-accessibility-audit",
  "description": "Audit a website for accessibility against WCAG 2.1 AA, from automated scans through manual testing.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "automated-accessibility-scanner",
      "inputs": {
        "site-url": "from_user_input",
        "pages-to-test": "from_user_input"
      },
      "outputs": {
        "automated-findings": "automated-findings",
        "scan-coverage": "scan-coverage"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "keyboard-navigation-tester",
      "inputs": {
        "automated-findings": "step_1.automated-findings",
        "site-url": "from_context.site-url"
      },
      "outputs": {
        "keyboard-findings": "keyboard-findings",
        "interactive-element-status": "interactive-element-status"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "screen-reader-tester",
      "inputs": {
        "keyboard-findings": "step_2.keyboard-findings",
        "site-url": "from_context.site-url"
      },
      "outputs": {
        "screen-reader-findings": "screen-reader-findings",
        "aria-issues": "aria-issues"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "accessibility-fix-prioritizer",
      "inputs": {
        "automated-findings": "step_1.automated-findings",
        "keyboard-findings": "step_2.keyboard-findings",
        "screen-reader-findings": "step_3.screen-reader-findings",
        "aria-issues": "step_3.aria-issues"
      },
      "outputs": {
        "prioritized-fixes": "prioritized-fixes",
        "accessibility-audit-report": "accessibility-audit-report"
      },
      "parallel_group": 4
    }
  ],
