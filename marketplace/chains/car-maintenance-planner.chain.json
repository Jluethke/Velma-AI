{
  "name": "car-maintenance-planner",
  "description": "Build a vehicle maintenance schedule with service intervals, cost forecasting, recall checks, and mechanic selection.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "vehicle-service-schedule",
      "inputs": {
        "vehicle_info": "from_user_input",
        "driving_conditions": "from_user_input",
        "current_mileage": "from_user_input"
      },
      "outputs": {
        "service_schedule": "service_schedule",
        "severe_schedule_items": "severe_schedule_items",
        "upcoming_milestones": "upcoming_milestones"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "maintenance-cost-forecaster",
      "inputs": {
        "service_schedule": "step_1.service_schedule",
        "vehicle_info": "from_context.vehicle_info",
        "local_labor_rate": "from_context.local_labor_rate"
      },
      "outputs": {
        "cost_forecast": "cost_forecast",
        "annual_budget": "annual_budget",
        "diy_savings": "diy_savings"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "recall-and-tsb-check",
      "inputs": {
        "vehicle_info": "from_context.vehicle_info",
        "vin": "from_context.vin"
      },
      "outputs": {
        "open_recalls": "open_recalls",
        "tsb_list": "tsb_list",
        "action_items": "action_items"
      },
      "parallel_group": 3
    },
    {
      "id": "step_4",
      "skill_name": "mechanic-selection-guide",
      "inputs": {
        "location": "from_context.location",
        "vehicle_info": "from_context.vehicle_info",
        "priorities": "from_context.priorities"
      },
      "outputs": {
        "mechanic_shortlist": "mechanic_shortlist",
        "evaluation_checklist": "evaluation_checklist",
        "red_flags": "red_flags"
      },
      "parallel_group": 4
    },
    {
      "id": "step_5",
      "skill_name": "maintenance-record-keeper",
      "inputs": {
        "vehicle_info": "from_context.vehicle_info",
        "past_services": "from_context.past_services"
      },
      "outputs": {
