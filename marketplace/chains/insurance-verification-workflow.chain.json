{
  "name": "insurance-verification-workflow",
  "description": "Verify patient insurance eligibility and benefits before a visit, including copay estimation and prior authorization checks.",
  "steps": [
    {
      "id": "step_1",
      "skill_name": "patient-insurance-collection",
      "inputs": {
        "patient-id": "from_user_input",
        "insurance-card-data": "from_user_input"
      },
      "outputs": {
        "insurance-profile": "insurance-profile",
        "secondary-insurance": "secondary-insurance"
      },
      "parallel_group": 1
    },
    {
      "id": "step_2",
      "skill_name": "eligibility-benefits-check",
      "inputs": {
        "insurance-profile": "step_1.insurance-profile",
        "visit-type": "from_context.visit-type"
      },
      "outputs": {
        "eligibility-result": "eligibility-result",
        "benefits-detail": "benefits-detail"
      },
      "parallel_group": 2
    },
    {
      "id": "step_3",
      "skill_name": "prior-auth-requirement-check",
      "inputs": {
        "benefits-detail": "step_2.benefits-detail",
        "visit-type": "from_context.visit-type"
      },
      "outputs": {
