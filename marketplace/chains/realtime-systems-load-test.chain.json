        "target_connections": "from_user_input",
        "slo_targets": "from_user_input",
        "os_limits_report": "s01_rtw_linux_connection_limits.os_limits_report"
      },
      "outputs": {
        "k6_summary": "k6_summary"
      },
      "condition": "load_tool == 'k6'",
      "parallel_group": 2
    },
    {
