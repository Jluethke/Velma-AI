      "outputs": {
        "artillery_report": "artillery_report"
      },
      "condition": "load_tool == 'artillery'",
      "parallel_group": 2
    },
    {
      "id": "s04_rtw_load_test_capacity_report",
      "skill_name": "rtw-load-test-capacity-report",
