{
  "name": "ledg-pg-audit-queries",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ledger",
    "audit",
    "postgresql",
    "trial-balance",
    "psql"
  ],
  "inputs": [
    "ledger_schema",
    "balance_queries"
  ],
  "outputs": [
    "audit_query_pack"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run a read-only pack of PostgreSQL ledger audit queries where every check expects zero rows or zero sums.",
  "related_flows": [
    {
      "flow_name": "ledg-pg-balance-snapshots",
      "relationship": "fed_by",
      "description": "provides balance_queries needed here"
    },
    {
      "flow_name": "ledg-pg-double-entry-schema",
      "relationship": "fed_by",
      "description": "provides ledger_schema needed here"
    },
    {
      "flow_name": "ledg-pg-immutable-reversals",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ledg-pg-idempotent-posting",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ledg-pg-balance-locking",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ledg-stripe-payout-reconciliation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ledg-bank-statement-reconciliation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ledg-qbo-journal-sync",
      "relationship": "feeds_into",
      "description": "outputs audit_query_pack consumed by ledg-qbo-journal-sync"
    }
  ]
}
