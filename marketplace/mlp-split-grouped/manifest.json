{
  "name": "mlp-split-grouped",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "group-k-fold",
    "grouped-split",
    "scikit-learn"
  ],
  "inputs": [
    "data_version",
    "problem_frame",
    "group_column",
    "split_seed",
    "test_fraction"
  ],
  "outputs": [
    "group_split"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Splits data so every row of one entity (patient, user, device, site) lands in exactly one of train, validation or test, using scikit-learn `GroupShuffleSplit` and `StratifiedGroupKFold`, so evaluation measures performance on unseen entities.",
  "related_flows": [
    {
      "flow_name": "mlp-frame-problem-metric",
      "relationship": "fed_by",
      "description": "provides problem_frame needed here"
    },
    {
      "flow_name": "mlp-dvc-version-raw-data",
      "relationship": "fed_by",
      "description": "provides data_version needed here"
    },
    {
      "flow_name": "mlp-leakage-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-split-random-stratified",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-split-time-based",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-split-integrity-check",
      "relationship": "feeds_into",
      "description": "outputs group_split consumed by mlp-split-integrity-check"
    },
    {
      "flow_name": "mlp-dvc-pipeline-stages",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
