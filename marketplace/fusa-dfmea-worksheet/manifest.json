    {
      "flow_name": "fusa-dependent-failure-analysis",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "fusa-fault-injection-campaign-plan",
      "relationship": "feeds_into",
      "description": "outputs dfmea_worksheet consumed by fusa-fault-injection-campaign-plan"
    },
    {
      "flow_name": "fusa-fault-injection-mcu-gdb",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "fusa-fault-injection-linux",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "fusa-item-definition",
      "relationship": "fed_by",
      "description": "provides item_definition needed here"
    }
  ]
