{
  "name": "gql-schema-lint-graphql-eslint",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "graphql",
    "lint",
    "graphql-eslint",
    "relay",
    "ci"
  ],
  "inputs": [
    "paginated_schema",
    "operation_documents"
  ],
  "outputs": [
    "validated_schema",
    "lint_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Lint the SDL and client operations with graphql-eslint schema, relay and operations rules, fixing violations one at a time until ESLint exits 0.",
  "related_flows": [
    {
      "flow_name": "gql-use-case-inventory",
      "relationship": "fed_by",
      "description": "provides operation_documents needed here"
    },
    {
      "flow_name": "gql-schema-sdl-draft",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-nullability-review",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-relay-connection-schema",
      "relationship": "fed_by",
      "description": "provides paginated_schema needed here"
    },
    {
      "flow_name": "gql-schema-breaking-diff",
      "relationship": "feeds_into",
      "description": "outputs validated_schema consumed by gql-schema-breaking-diff"
    },
    {
      "flow_name": "gql-node-apollo-server-resolvers",
      "relationship": "feeds_into",
      "description": "outputs validated_schema consumed by gql-node-apollo-server-resolvers"
    },
    {
      "flow_name": "gql-node-yoga-resolvers",
      "relationship": "feeds_into",
      "description": "outputs validated_schema consumed by gql-node-yoga-resolvers"
    },
    {
      "flow_name": "gql-py-strawberry-resolvers",
      "relationship": "feeds_into",
      "description": "outputs validated_schema consumed by gql-py-strawberry-resolvers"
    }
  ]
}
