{
  "name": "pcb-skidl-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "schematic",
    "skidl",
    "kicad"
  ],
  "inputs": [
    "bom",
    "board_spec",
    "critical_circuits",
    "project_dir"
  ],
  "outputs": [
    "skidl_source"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write the board schematic as SKiDL source with one subcircuit per function, named inter-subcircuit nets, every datasheet decoupling capacitor, and explicit no-connects.",
  "related_flows": [
    {
      "flow_name": "eda-toolchain-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-part-selection",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-stock-sourcing",
      "relationship": "fed_by",
      "description": "provides bom needed here"
    },
    {
      "flow_name": "pcb-erc-netlist",
      "relationship": "feeds_into",
      "description": "outputs skidl_source consumed by pcb-erc-netlist"
    },
    {
      "flow_name": "hw-critical-circuit-flagging",
      "relationship": "fed_by",
      "description": "provides critical_circuits needed here"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "fed_by",
      "description": "provides board_spec needed here"
    },
    {
      "flow_name": "pcb-power-input-review",
      "relationship": "feeds_into",
      "description": "outputs skidl_source consumed by pcb-power-input-review"
    },
    {
      "flow_name": "pcb-isolation-review",
      "relationship": "feeds_into",
      "description": "outputs skidl_source consumed by pcb-isolation-review"
    }
  ]
}
