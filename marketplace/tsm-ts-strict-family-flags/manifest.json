{
  "name": "tsm-ts-strict-family-flags",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "type-safety",
    "typescript",
    "strict",
    "tsconfig",
    "nouncheckedindexedaccess"
  ],
  "inputs": [
    "repo_path",
    "ts_strictnull_result"
  ],
  "outputs": [
    "ts_strict_result"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
