{
  "name": "race-cpp-tsan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "cpp",
    "c",
    "threadsanitizer",
    "tsan",
    "data-race"
  ],
  "inputs": [
    "repo_path",
    "stress_command"
  ],
  "outputs": [
    "cpp_tsan_reports"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Builds the C or C++ stress test with `-fsanitize=thread` in a separate build directory, runs it with TSAN_OPTIONS for complete reports, and reads data race, lock-order-inversion and thread-leak reports into file:line pairs.",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "fed_by",
      "description": "provides stress_command needed here"
    },
    {
      "flow_name": "race-go-goroutine-dump",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-java-thread-dump",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-py-hang-dump",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs cpp_tsan_reports consumed by race-findings-consolidate"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
