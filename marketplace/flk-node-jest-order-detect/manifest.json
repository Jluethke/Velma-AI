    {
      "flow_name": "flk-run-count-derive",
      "relationship": "fed_by",
      "description": "provides repeat_count needed here"
    },
    {
      "flow_name": "flk-node-jest-loop-measure",
      "relationship": "fed_by",
      "description": "provides node_flake_rate_report needed here"
    },
    {
      "flow_name": "flk-tz-locale-matrix-detect",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-classify-root-cause",
      "relationship": "feeds_into",
      "description": "outputs node_order_report consumed by flk-classify-root-cause"
    },
    {
      "flow_name": "flk-node-async-wait-fix",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-node-jest-isolation-fix",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-node-fake-timers-fix",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
