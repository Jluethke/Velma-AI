{
  "name": "flk-node-jest-order-detect",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "flaky-tests",
    "node",
    "jest",
    "test-order"
  ],
  "inputs": [
    "flake_evidence",
    "node_flake_rate_report",
    "repeat_count",
    "repo_path"
  ],
  "outputs": [
    "node_order_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Detect Jest order dependence with --randomize and --seed, then bisect the polluting test file or test case.",
  "related_flows": [
    {
      "flow_name": "flk-flake-evidence-intake",
