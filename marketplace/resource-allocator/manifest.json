{
  "name": "resource-allocator",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "resource",
    "allocator"
  ],
  "inputs": [
    "available_resources",
    "dependency_graph",
    "weekly_tasks"
  ],
  "outputs": [
    "resource_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process available_resources, dependency_graph, weekly_tasks to produce resource_plan.",
  "related_flows": [
    {
      "flow_name": "task-breakdown-engine",
      "relationship": "fed_by",
      "description": "provides weekly_tasks needed here"
    },
    {
      "flow_name": "plan-assembler",
      "relationship": "feeds_into",
      "description": "outputs resource_plan consumed by plan-assembler"
    }
  ]
}
