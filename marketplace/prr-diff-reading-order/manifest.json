{
  "name": "prr-diff-reading-order",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "reading-order",
    "diff",
    "pull-request",
    "stack-specific"
  ],
  "inputs": [
    "changed_files",
    "review_units",
    "stack"
  ],
  "outputs": [
    "reading_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Order each review unit's files so contracts come before implementations, callers and tests, using stack-specific path patterns.",
  "related_flows": [
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides changed_files needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "fed_by",
      "description": "provides review_units needed here"
    },
    {
      "flow_name": "prr-severity-comments",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-approval-decision",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-gh-post-review",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-glab-post-review",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "prr-concurrency-pass",
      "relationship": "feeds_into",
      "description": "outputs reading_plan consumed by prr-concurrency-pass"
    }
  ]
}
