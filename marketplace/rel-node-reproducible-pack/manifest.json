{
  "name": "rel-node-reproducible-pack",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "node",
    "npm-pack",
    "reproducible-builds",
    "lockfile"
  ],
  "inputs": [
    "repo_path",
