      "flow_name": "parity-py-golden-vectors",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "parity-golden-manifest-lock",
      "relationship": "fed_by",
      "description": "provides golden_manifest needed here"
    },
    {
      "flow_name": "parity-cpp-vector-harness",
      "relationship": "fed_by",
      "description": "provides harness_binary needed here"
    },
    {
      "flow_name": "parity-divergence-triage",
      "relationship": "feeds_into",
      "description": "outputs comparison_results consumed by parity-divergence-triage"
    },
    {
      "flow_name": "parity-report",
      "relationship": "feeds_into",
      "description": "outputs comparison_results consumed by parity-report"
