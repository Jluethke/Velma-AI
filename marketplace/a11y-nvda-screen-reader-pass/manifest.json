{
  "name": "a11y-nvda-screen-reader-pass",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "screen-reader",
    "nvda",
    "windows",
    "manual-testing"
  ],
  "inputs": [
    "page_inventory",
    "critical_journeys",
    "needs_review_items"
  ],
  "outputs": [
    "nvda_issues"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Completes each critical user journey with NVDA on Windows in Firefox and Chrome, using browse mode quick-navigation keys, focus mode, the Elements List and Speech Viewer transcripts, and records name, role, value, state, structure and announcement failures against SC 1.3.1, 2.4.4, 2.4.6, 4.1.2 and 4.1.3.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "fed_by",
      "description": "provides page_inventory needed here"
    },
    {
      "flow_name": "a11y-keyboard-operability-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-focus-order-visibility-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-voiceover-macos-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-voiceover-ios-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "feeds_into",
      "description": "outputs nvda_issues consumed by a11y-impact-ranking"
    },
    {
      "flow_name": "a11y-scan-merge-dedupe",
      "relationship": "fed_by",
      "description": "provides needs_review_items needed here"
    }
  ]
}
