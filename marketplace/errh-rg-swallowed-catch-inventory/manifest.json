{
  "name": "errh-rg-swallowed-catch-inventory",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "error-handling",
    "ripgrep",
    "swallowed-exceptions",
    "audit",
    "static-search"
  ],
  "inputs": [
    "repo_path",
    "stack",
    "boundary_map"
  ],
  "outputs": [
    "catch_inventory"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a file-and-line inventory of swallowed, broad, cause-dropping and string-matched error handling using exact ripgrep patterns per stack.",
  "related_flows": [
    {
      "flow_name": "errh-boundary-map",
      "relationship": "fed_by",
      "description": "provides boundary_map needed here"
    },
    {
      "flow_name": "errh-semgrep-swallowed-catch-scan",
      "relationship": "feeds_into",
      "description": "outputs catch_inventory consumed by errh-semgrep-swallowed-catch-scan"
    },
    {
      "flow_name": "errh-error-taxonomy",
      "relationship": "feeds_into",
      "description": "outputs catch_inventory consumed by errh-error-taxonomy"
    },
    {
      "flow_name": "errh-retryability-table",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "errh-catch-site-triage",
      "relationship": "feeds_into",
      "description": "outputs catch_inventory consumed by errh-catch-site-triage"
    },
    {
      "flow_name": "errh-rfc9457-problem-type-registry",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "errh-user-message-catalog",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "errh-context-and-correlation-id",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
