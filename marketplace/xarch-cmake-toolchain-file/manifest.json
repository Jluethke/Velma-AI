{
  "name": "xarch-cmake-toolchain-file",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "cross-compile",
    "aarch64",
    "cmake",
    "toolchain-file",
    "find-root-path"
  ],
  "inputs": [
    "target_triple",
    "toolchain_prefix",
    "sysroot"
  ],
  "outputs": [
    "cmake_toolchain_file",
    "toolchain_file_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a CMake toolchain file that sets the system name, cross compilers, sysroot and find-root-path modes for aarch64 and confirm it with a probe configure.",
  "related_flows": [
    {
      "flow_name": "xarch-target-triple-select",
      "relationship": "fed_by",
      "description": "provides target_triple needed here"
    },
    {
      "flow_name": "xarch-gcc-toolchain-select",
      "relationship": "fed_by",
      "description": "provides toolchain_prefix needed here"
    },
    {
      "flow_name": "xarch-sysroot-from-image",
      "relationship": "fed_by",
      "description": "provides sysroot needed here"
    },
    {
      "flow_name": "xarch-pkgconfig-cross",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "xarch-cmake-configure-build",
      "relationship": "feeds_into",
      "description": "outputs cmake_toolchain_file consumed by xarch-cmake-configure-build"
    },
    {
      "flow_name": "xarch-elf-arch-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
