{
  "name": "ctr-pin-base-digest",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "containers",
    "docker",
    "digest",
    "pinning",
    "renovate"
  ],
  "inputs": [
    "base_image_plan",
    "libc_verdict"
  ],
  "outputs": [
    "pinned_bases"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Pin every base image to its registry-resolved multi-platform index digest and configure an update path for the pins.",
  "related_flows": [
    {
      "flow_name": "ctr-stack-inventory",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ctr-dockerignore",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ctr-base-image-select",
      "relationship": "fed_by",
      "description": "provides base_image_plan needed here"
    },
    {
      "flow_name": "ctr-alpine-musl-check",
      "relationship": "fed_by",
      "description": "provides libc_verdict needed here"
    },
    {
      "flow_name": "ctr-layer-cache-order",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ctr-build-args-secrets",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "ctr-nonroot-user",
      "relationship": "feeds_into",
      "description": "outputs pinned_bases consumed by ctr-nonroot-user"
    },
    {
      "flow_name": "ctr-healthcheck",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
