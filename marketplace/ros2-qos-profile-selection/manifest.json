{
  "name": "ros2-qos-profile-selection",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ros2",
    "robotics",
    "qos",
    "dds",
    "reliability",
    "durability"
  ],
  "inputs": [
    "topic_list",
    "node_spec"
  ],
  "outputs": [
    "qos_table",
    "qos_mismatches"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Choose reliability, durability, history and depth per topic from a decision table, check every endpoint pair for QoS compatibility, and confirm against the live graph.",
  "related_flows": [
    {
      "flow_name": "ros2-qos-incompatibility-debug",
      "relationship": "feeds_into",
      "description": "outputs qos_table, qos_mismatches consumed by ros2-qos-incompatibility-debug"
    },
    {
      "flow_name": "ros2-dds-rmw-selection",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ros2-fastdds-xml-tuning",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ros2-cyclonedds-xml-tuning",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ros2-doctor-introspection",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
