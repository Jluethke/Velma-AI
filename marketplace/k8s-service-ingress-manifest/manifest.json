{
  "name": "k8s-service-ingress-manifest",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "service",
    "ingress",
    "tls"
  ],
  "inputs": [
    "workload_profile",
    "deployment_manifest",
    "ingress_host",
    "ingress_class",
    "tls_issuer"
  ],
  "outputs": [
    "service_manifest",
    "ingress_manifest"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write the ClusterIP Service and an optional networking.k8s.io/v1 Ingress with ingressClassName and TLS, and prove routing through EndpointSlices.",
  "related_flows": [
    {
      "flow_name": "k8s-workload-inventory",
      "relationship": "fed_by",
      "description": "provides workload_profile needed here"
    },
    {
      "flow_name": "k8s-deployment-manifest",
      "relationship": "fed_by",
      "description": "provides deployment_manifest needed here"
    },
    {
      "flow_name": "k8s-network-policy-default-deny",
      "relationship": "feeds_into",
      "description": "outputs ingress_manifest consumed by k8s-network-policy-default-deny"
    },
    {
      "flow_name": "k8s-helm-chart-build",
      "relationship": "feeds_into",
      "description": "outputs service_manifest, ingress_manifest consumed by k8s-helm-chart-build"
    },
    {
      "flow_name": "k8s-kustomize-overlays",
      "relationship": "feeds_into",
      "description": "outputs service_manifest, ingress_manifest consumed by k8s-kustomize-overlays"
    }
  ]
}
