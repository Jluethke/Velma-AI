{
  "name": "sccpp-clang-warning-set",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "clang",
    "warnings",
    "static-analysis",
    "werror"
  ],
  "inputs": [
    "codebase_dir",
    "build_profiles",
    "language"
  ],
  "outputs": [
    "clang_warning_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Survey Clang diagnostics with -Weverything, adopt a documented warning set with reasons, and promote zero-hit flags to -Werror.",
  "related_flows": [
    {
      "flow_name": "sccpp-standard-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-cmake-build-profiles",
      "relationship": "fed_by",
      "description": "provides build_profiles needed here"
    },
    {
      "flow_name": "sccpp-gcc-warning-set",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-clang-tidy-config",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-cppcheck-misra-c",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-findings-triage",
      "relationship": "feeds_into",
      "description": "outputs clang_warning_report consumed by sccpp-findings-triage"
    },
    {
      "flow_name": "sccpp-deviation-record",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
