{
  "name": "tkt-review-comment-response",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "pull-request",
    "gh-api",
    "collaboration"
  ],
  "inputs": [
    "pr_url",
    "acceptance_criteria"
  ],
  "outputs": [
    "review_resolution"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Classify every review thread with a fixed table, fix or answer each one, reply in-thread with evidence, and re-request review.",
  "related_flows": [
    {
      "flow_name": "tkt-ci-check-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-sync-strategy-choose",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-rebase-conflict-resolve",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-merge-conflict-resolve",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tkt-post-merge-verify",
      "relationship": "feeds_into",
      "description": "outputs review_resolution consumed by tkt-post-merge-verify"
    },
    {
      "flow_name": "tkt-acceptance-criteria-gwt",
      "relationship": "fed_by",
      "description": "provides acceptance_criteria needed here"
    },
    {
      "flow_name": "tkt-pr-description",
      "relationship": "fed_by",
      "description": "provides pr_url needed here"
    }
  ]
}
