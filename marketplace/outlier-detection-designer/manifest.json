{
  "name": "outlier-detection-designer",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "outlier",
    "detection",
    "designer"
  ],
  "inputs": [
    "dataset_profile",
    "distribution_plan"
  ],
  "outputs": [
