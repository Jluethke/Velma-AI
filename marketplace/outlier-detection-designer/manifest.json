      "description": "provides dataset_profile needed here"
    },
    {
      "flow_name": "distribution-planner",
      "relationship": "fed_by",
      "description": "provides distribution_plan needed here"
    },
    {
      "flow_name": "visualization-recommender",
      "relationship": "feeds_into",
      "description": "outputs outlier_detection_plan consumed by visualization-recommender"
    },
    {
      "flow_name": "eda-execution-planner",
      "relationship": "feeds_into",
      "description": "outputs outlier_detection_plan consumed by eda-execution-planner"
    }
  ]
}
