{
  "name": "dup-verify-and-pr",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "verification",
    "pull-request",
    "testing",
    "dependencies"
  ],
  "inputs": [
    "upgrade_scope",
    "baseline_report",
    "rollback_plan",
    "applied_bumps"
  ],
  "outputs": [
    "verification_report",
    "pr_description"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Verify an upgrade branch against the baseline with command-backed checks and write a PR description listing every commit, blocked item and rollback step.",
  "related_flows": [
    {
      "flow_name": "dup-scope-intake",
      "relationship": "fed_by",
      "description": "provides upgrade_scope needed here"
    },
    {
      "flow_name": "dup-baseline-snapshot",
      "relationship": "fed_by",
      "description": "provides baseline_report needed here"
    },
    {
      "flow_name": "dup-changelog-triage",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dup-upgrade-order-plan",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dup-rollback-plan",
      "relationship": "fed_by",
      "description": "provides rollback_plan needed here"
    },
    {
      "flow_name": "dup-apply-one-bump",
      "relationship": "fed_by",
      "description": "provides applied_bumps needed here"
    },
    {
      "flow_name": "dup-py-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "dup-node-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
