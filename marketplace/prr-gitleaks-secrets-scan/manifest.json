{
  "name": "prr-gitleaks-secrets-scan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "security",
    "secrets",
    "gitleaks",
    "git"
  ],
  "inputs": [
    "repo_dir",
    "base_branch",
    "head_sha",
    "findings_dir"
  ],
  "outputs": [
    "secret_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Scan every commit in the PR range with Gitleaks and redaction, audit scanner config changes, and record real secrets as blocking with rotation required.",
  "related_flows": [
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-self-review-before-request",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides head_sha needed here"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-test-revert-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-owasp-security-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-py-bandit-semgrep",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
