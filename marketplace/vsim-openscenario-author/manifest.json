{
  "name": "vsim-openscenario-author",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "openscenario",
    "scenario",
    "opendrive",
    "xml",
    "simulation"
  ],
  "inputs": [
    "scenario_description",
    "opendrive_file"
  ],
  "outputs": [
    "xosc_file"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Turn a written scenario description into a schema-valid ASAM OpenSCENARIO XML file with parameters and triggers.",
  "related_flows": [
    {
      "flow_name": "vsim-esmini-scenario-check",
      "relationship": "feeds_into",
      "description": "outputs xosc_file consumed by vsim-esmini-scenario-check"
    },
    {
      "flow_name": "vsim-fault-scenario-library",
      "relationship": "feeds_into",
      "description": "outputs xosc_file consumed by vsim-fault-scenario-library"
    },
    {
      "flow_name": "vsim-scenario-kpis",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "vsim-carla-server-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-carla-sync-mode",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-carla-sensor-rig",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-carla-seed-determinism",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-scenario-runner-exec",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
