{
  "name": "ffr-ab-sample-size",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "experimentation",
    "ab-testing",
    "sample-size",
    "power-analysis",
    "statsmodels"
  ],
  "inputs": [
    "flag_spec",
    "baseline_rate",
    "minimum_detectable_effect",
    "alpha",
    "power",
    "daily_traffic"
  ],
  "outputs": [
    "sample_size_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Compute per-arm sample size for a two-arm conversion experiment from baseline, MDE, alpha, and power, and convert it to a fixed duration in whole weeks.",
  "related_flows": [
    {
      "flow_name": "ffr-flag-type-classify",
      "relationship": "fed_by",
      "description": "provides flag_spec needed here"
    },
    {
      "flow_name": "ffr-targeting-rules",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-otel-flag-telemetry",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-guardrail-metrics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-srm-check",
      "relationship": "feeds_into",
      "description": "outputs sample_size_plan consumed by ffr-srm-check"
    },
    {
      "flow_name": "ffr-experiment-readout",
      "relationship": "feeds_into",
      "description": "outputs sample_size_plan consumed by ffr-experiment-readout"
    },
    {
      "flow_name": "ffr-stale-flag-detect",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-flag-removal-pr",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
