{
  "name": "ffr-react-openfeature-wire",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "openfeature",
    "react",
    "frontend",
    "web-sdk"
  ],
  "inputs": [
    "flag_spec",
    "provider_choice",
    "flagd_config",
    "unleash_config",
    "launchdarkly_config",
    "repo_path"
  ],
  "outputs": [
    "react_flag_wiring"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Wire the OpenFeature React SDK with a browser-safe provider and static context, and read one flag with useBooleanFlagValue without leaking secret keys.",
  "related_flows": [
    {
      "flow_name": "ffr-flag-type-classify",
      "relationship": "fed_by",
      "description": "provides flag_spec needed here"
    },
    {
      "flow_name": "ffr-provider-select",
      "relationship": "fed_by",
      "description": "provides provider_choice needed here"
    },
    {
      "flow_name": "ffr-flagd-local-setup",
      "relationship": "fed_by",
      "description": "provides flagd_config needed here"
    },
    {
      "flow_name": "ffr-unleash-setup",
      "relationship": "fed_by",
      "description": "provides unleash_config needed here"
    },
    {
      "flow_name": "ffr-launchdarkly-setup",
      "relationship": "fed_by",
      "description": "provides launchdarkly_config needed here"
    },
    {
      "flow_name": "ffr-safe-default-audit",
      "relationship": "feeds_into",
      "description": "outputs react_flag_wiring consumed by ffr-safe-default-audit"
    }
  ]
}
