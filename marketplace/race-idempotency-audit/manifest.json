{
  "name": "race-idempotency-audit",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "idempotency",
    "retries",
    "at-least-once",
    "unique-constraint",
    "outbox"
  ],
  "inputs": [
    "repo_path",
    "suspect_paths",
    "database"
  ],
  "outputs": [
    "idempotency_gaps"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Lists every operation that can run twice (client retries, HTTP POST resubmits, at-least-once queue redelivery, job retries, webhook replays), proves the duplicate with a replay test, and specifies a database-enforced idempotency key or natural unique constraint for each.",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "fed_by",
      "description": "provides suspect_paths needed here"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-db-postgres-isolation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-db-mysql-isolation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs idempotency_gaps consumed by race-findings-consolidate"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
