{
  "name": "res-chaos-experiment",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "resilience",
    "chaos-engineering",
    "chaos-toolkit",
    "chaos-mesh",
    "kubernetes"
  ],
  "inputs": [
    "dependency_map",
    "fault_results",
    "steady_state_slo"
  ],
  "outputs": [
    "chaos_journal"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run a time-boxed, label-scoped Chaos Mesh fault under a Chaos Toolkit PromQL steady-state hypothesis and record the journal verdict.",
  "related_flows": [
    {
      "flow_name": "res-dependency-map",
      "relationship": "fed_by",
      "description": "provides dependency_map needed here"
    },
    {
      "flow_name": "res-latency-percentiles",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "res-timeout-budget",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "res-retry-policy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "res-breaker-policy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "res-toxiproxy-faults",
      "relationship": "fed_by",
      "description": "provides fault_results needed here"
    },
    {
      "flow_name": "res-resilience-verify",
      "relationship": "feeds_into",
      "description": "outputs chaos_journal consumed by res-resilience-verify"
    }
  ]
}
