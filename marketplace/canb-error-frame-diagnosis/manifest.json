{
  "name": "canb-error-frame-diagnosis",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "error-frames",
    "error-counters",
    "socketcan",
    "diagnosis"
  ],
  "inputs": [
    "can_netdev",
    "link_state",
    "candump_log"
  ],
  "outputs": [
    "error_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Read SocketCAN error frames and TX/RX error counters, decode each error class and map the dominant class to its likely cause.",
  "related_flows": [
    {
      "flow_name": "canb-tx-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-usb-adapter-bringup",
      "relationship": "fed_by",
      "description": "provides can_netdev needed here"
    },
    {
      "flow_name": "canb-termination-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-bit-timing-calc",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "canb-socketcan-link-up",
      "relationship": "fed_by",
      "description": "provides link_state needed here"
    },
    {
      "flow_name": "canb-candump-capture",
      "relationship": "fed_by",
      "description": "provides candump_log needed here"
    },
    {
      "flow_name": "canb-busoff-recovery",
      "relationship": "feeds_into",
      "description": "outputs error_report consumed by canb-busoff-recovery"
    },
    {
      "flow_name": "canb-canbusload-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
