{
  "name": "troubleshooter",
  "version": "1.0.0",
  "domain": "velma",
  "tags": [
    "vehicle",
    "diagnostics",
    "troubleshoot",
    "symptoms",
    "dtc"
  ],
  "inputs": [
    "symptom",
    "vehicle",
    "conditions"
  ],
  "outputs": [
    "diagnosis",
    "test_results",
    "root_cause",
    "fix_plan"
  ],
  "execution_pattern": "linear",
  "price": "0",
  "license": "PRIVATE",
  "description": "Symptom-based vehicle troubleshooter. Describe what's wrong in plain language and the system maps it to diagnostic tests, reads the relevant DTCs and sensor data, narrows the root cause through a decision tree, and produces a fix plan with part numbers and difficulty rating.",
