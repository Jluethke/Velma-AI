  "related_flows": [
    {
      "flow_name": "parity-contract-scope",
      "relationship": "fed_by",
      "description": "provides parity_contract needed here"
    },
    {
      "flow_name": "parity-canonical-serialization",
      "relationship": "fed_by",
      "description": "provides serialization_spec needed here"
    },
    {
      "flow_name": "parity-golden-manifest-lock",
      "relationship": "feeds_into",
      "description": "outputs golden_vectors consumed by parity-golden-manifest-lock"
    },
    {
      "flow_name": "parity-cpp-vector-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "parity-ulp-compare",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
