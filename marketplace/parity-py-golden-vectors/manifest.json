{
  "name": "parity-py-golden-vectors",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "parity",
    "python",
    "golden-vectors",
    "numpy"
  ],
  "inputs": [
    "reference_repo",
    "parity_contract",
    "serialization_spec",
    "seed"
  ],
  "outputs": [
    "golden_vectors"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
