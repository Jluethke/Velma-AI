{
  "name": "pkg-scope-intake",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "packaging",
    "release",
    "intake",
    "registry"
  ],
  "inputs": [
    "project_dir",
    "stack",
    "package_name"
  ],
  "outputs": [
    "package_profile"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Detect a library's stack, build tool, current version, layout and registry name availability so every later packaging step works from verified facts.",
  "related_flows": [
