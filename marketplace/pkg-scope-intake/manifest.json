      "description": "outputs package_profile consumed by pkg-public-api-inventory"
    },
    {
      "flow_name": "pkg-license-metadata",
      "relationship": "feeds_into",
      "description": "outputs package_profile consumed by pkg-license-metadata"
    },
    {
      "flow_name": "pkg-py-dunder-all-exports",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "pkg-node-exports-map",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "pkg-rust-pub-surface",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "pkg-go-internal-packages",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-py-griffe-api-diff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-node-api-extractor-diff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
