{
  "name": "a11y-react-fix-and-test",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "react",
    "jest-axe",
    "eslint-plugin-jsx-a11y",
    "testing-library"
  ],
  "inputs": [
    "fix_plan",
    "repo_dir"
  ],
  "outputs": [
    "react_fix_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Applies each fix plan task in a React codebase one task at a time: writes a failing jest-axe or vitest-axe plus Testing Library test first, makes the smallest JSX change using native elements, `useRef` focus management and live regions, enables eslint-plugin-jsx-a11y, and commits only when the test, the lint and the full suite pass.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-axe-playwright-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-scan-merge-dedupe",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-fix-plan-by-criterion",
      "relationship": "fed_by",
      "description": "provides fix_plan needed here"
    },
    {
      "flow_name": "a11y-retest-verify",
      "relationship": "feeds_into",
      "description": "outputs react_fix_log consumed by a11y-retest-verify"
    },
    {
      "flow_name": "a11y-ci-regression-gate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
