{
  "name": "rag-ocr-scanned-pdf-ocrmypdf",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rag",
    "ocr",
    "ocrmypdf",
    "tesseract",
    "pdf"
  ],
  "inputs": [
    "corpus_manifest",
    "record_schema",
    "work_dir",
    "ocr_language"
  ],
  "outputs": [
    "ocr_records",
    "ocr_log"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Add a text layer to scanned PDF pages with OCRmyPDF and Tesseract in the right language, measure character error rate on a typed sample, and write page records.",
  "related_flows": [
    {
      "flow_name": "rag-corpus-inventory",
      "relationship": "fed_by",
      "description": "provides corpus_manifest, record_schema needed here"
    },
    {
      "flow_name": "rag-py-pdf-extract-pymupdf",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-py-html-extract-trafilatura",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-corpus-normalize-dedupe",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rag-gold-question-set-label",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
