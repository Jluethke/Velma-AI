{
  "name": "race-db-postgres-isolation",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "postgresql",
    "transaction-isolation",
    "lost-update",
    "write-skew",
    "deadlock"
  ],
  "inputs": [
    "repo_path",
    "suspect_paths",
    "db_connection"
  ],
  "outputs": [
    "pg_anomaly_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Reproduces lost updates, write skew and deadlocks in PostgreSQL with two scripted `psql` sessions at the application's real isolation level, reads SQLSTATE `40001` and `40P01` errors and `pg_locks`, and picks the fix (atomic UPDATE, `SELECT ... FOR UPDATE`, constraint, SERIALIZABLE with retry).",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "fed_by",
      "description": "provides suspect_paths needed here"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-db-mysql-isolation",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-idempotency-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs pg_anomaly_report consumed by race-findings-consolidate"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
