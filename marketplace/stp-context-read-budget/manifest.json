{
  "name": "stp-context-read-budget",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "context",
    "file-reading",
    "evidence",
    "small-model"
  ],
  "inputs": [
    "symbol_hits",
    "goal_check",
    "scratch_log"
  ],
  "outputs": [
    "context_notes",
    "target_files"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Pick the minimal files to read by a fixed table, read them as numbered line slices, and record every fact as a quoted file:line note.",
  "related_flows": [
    {
      "flow_name": "stp-rg-symbol-search",
      "relationship": "fed_by",
      "description": "provides symbol_hits needed here"
    },
    {
      "flow_name": "stp-decompose-small-edits",
      "relationship": "feeds_into",
      "description": "outputs context_notes, target_files consumed by stp-decompose-small-edits"
    },
    {
      "flow_name": "stp-edit-plan-write",
      "relationship": "feeds_into",
      "description": "outputs context_notes consumed by stp-edit-plan-write"
    },
    {
      "flow_name": "stp-cli-flag-exists-check",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "stp-edit-plan-lock",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "stp-goal-to-runnable-check",
      "relationship": "fed_by",
      "description": "provides goal_check needed here"
    },
    {
      "flow_name": "stp-scratch-log-start",
      "relationship": "fed_by",
      "description": "provides scratch_log needed here"
    },
    {
      "flow_name": "stp-baseline-capture",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
