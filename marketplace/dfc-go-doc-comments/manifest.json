{
  "name": "dfc-go-doc-comments",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "go",
    "godoc",
    "doc-comments",
    "staticcheck",
    "gofmt"
  ],
  "inputs": [
    "repo_path"
  ],
  "outputs": [
    "docstring_config",
