{
  "name": "dup-rust-lockfile-hygiene",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rust",
    "cargo",
    "lockfile",
    "msrv"
  ],
  "inputs": [
    "upgrade_scope",
    "baseline_report"
  ],
  "outputs": [
    "lockfile_status"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Make a Cargo project build from a committed in-sync Cargo.lock with --locked, record MSRV and resolver, and list duplicate crate versions.",
  "related_flows": [
    {
      "flow_name": "dup-scope-intake",
      "relationship": "fed_by",
      "description": "provides upgrade_scope needed here"
    },
    {
      "flow_name": "dup-baseline-snapshot",
      "relationship": "fed_by",
      "description": "provides baseline_report needed here"
    },
    {
      "flow_name": "dup-py-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "dup-node-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "dup-go-module-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "dup-py-vuln-scan",
      "relationship": "feeds_into",
      "description": "outputs lockfile_status consumed by dup-py-vuln-scan"
    },
    {
      "flow_name": "dup-node-vuln-scan",
      "relationship": "feeds_into",
      "description": "outputs lockfile_status consumed by dup-node-vuln-scan"
    },
    {
      "flow_name": "dup-go-vuln-scan",
      "relationship": "feeds_into",
      "description": "outputs lockfile_status consumed by dup-go-vuln-scan"
    }
  ]
}
