{
  "name": "vsens-ros2-diagnostics-health",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ros2",
    "diagnostics",
    "health-monitoring",
    "dropout",
    "diagnostic-updater"
  ],
  "inputs": [
    "timing_requirements",
    "topic_list"
  ],
  "outputs": [
    "health_monitor_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Monitor ROS 2 sensor topic rate and stamp age with diagnostic_updater and diagnostic_aggregator, and prove dropout detection by unplugging each sensor.",
  "related_flows": [
    {
      "flow_name": "vsens-sensor-inventory",
      "relationship": "fed_by",
      "description": "provides timing_requirements needed here"
    },
    {
      "flow_name": "vsens-ros2-stamp-latency",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-py-dropout-detector",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-integration-acceptance",
      "relationship": "feeds_into",
      "description": "outputs health_monitor_config consumed by vsens-integration-acceptance"
    }
  ]
}
