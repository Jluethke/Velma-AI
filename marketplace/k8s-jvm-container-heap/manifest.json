{
  "name": "k8s-jvm-container-heap",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "java",
    "jvm",
    "heap",
    "native-memory-tracking"
  ],
  "inputs": [
    "repo_dir",
    "resourced_deployment",
    "usage_report"
  ],
  "outputs": [
    "jvm_runtime_settings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Set JVM MaxRAMPercentage from Native Memory Tracking measurements, pin ActiveProcessorCount without a CPU limit, and add OOM diagnostics.",
  "related_flows": [
    {
      "flow_name": "k8s-resource-usage-measure",
      "relationship": "fed_by",
      "description": "provides usage_report needed here"
    },
    {
      "flow_name": "k8s-requests-limits-from-usage",
      "relationship": "fed_by",
      "description": "provides resourced_deployment needed here"
    },
    {
      "flow_name": "k8s-py-gunicorn-worker-sizing",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-node-heap-sizing",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-go-gomaxprocs-gomemlimit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-hpa-autoscaling",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-security-context-hardening",
      "relationship": "feeds_into",
      "description": "outputs jvm_runtime_settings consumed by k8s-security-context-hardening"
    }
  ]
}
