{
  "name": "prr-api-compat-pass",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "api",
    "compatibility",
    "semver",
    "breaking-change"
  ],
  "inputs": [
    "diff_file",
    "changed_files",
    "intent_statement",
    "findings_dir"
  ],
  "outputs": [
    "compat_findings",
    "openapi_specs"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Classify every external surface change in the PR as additive, behavioral or breaking, run stack API-diff tools, and check the version bump against SemVer.",
  "related_flows": [
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "fed_by",
      "description": "provides intent_statement needed here"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-test-revert-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "prr-self-review-before-request",
      "relationship": "fed_by",
      "description": "provides diff_file, changed_files needed here"
    },
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides diff_file, changed_files needed here"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-correctness-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-go-static-checks",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
