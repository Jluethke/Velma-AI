{
  "name": "email-response-drafter",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "email",
    "response",
    "drafter"
  ],
  "inputs": [
    "communication_style",
    "formality_level",
    "length_flag",
    "responder_relationship_clarity",
    "response_outline",
    "response_structure",
    "tone_profile",
    "unresolved_points",
    "urgency"
  ],
  "outputs": [
    "draft_word_count",
    "response_draft",
    "tone_consistency_check"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process communication_style, formality_level, length_flag to produce draft_word_count, response_draft, tone_consistency_check.",
  "related_flows": [
    {
      "flow_name": "email-point-extractor",
      "relationship": "fed_by",
      "description": "provides unresolved_points needed here"
    },
    {
      "flow_name": "email-tone-analyzer",
      "relationship": "fed_by",
      "description": "provides communication_style, formality_level, responder_relationship_clarity needed here"
    },
    {
      "flow_name": "response-mapper",
      "relationship": "fed_by",
      "description": "provides response_outline, response_structure, length_flag needed here"
    },
    {
      "flow_name": "response-validator",
      "relationship": "feeds_into",
      "description": "outputs response_draft consumed by response-validator"
    },
    {
      "flow_name": "email-response-finalizer",
      "relationship": "feeds_into",
      "description": "outputs response_draft consumed by email-response-finalizer"
    }
  ]
}
