{
  "name": "pkg-go-module-major-path",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "go",
    "semantic-import-versioning",
    "go.mod",
    "major-version"
  ],
  "inputs": [
    "go_change_class",
    "release_version",
    "project_dir"
  ],
  "outputs": [
    "go_module_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Apply Go semantic import versioning: decide whether the release needs a /vN module path, rewrite go.mod and every internal import, and prove the module builds and tests.",
  "related_flows": [
    {
      "flow_name": "pkg-go-gorelease-diff",
      "relationship": "fed_by",
      "description": "provides go_change_class needed here"
    },
    {
      "flow_name": "pkg-release-version-lock",
      "relationship": "fed_by",
      "description": "provides release_version needed here"
    },
    {
      "flow_name": "pkg-go-tag-and-proxy",
      "relationship": "feeds_into",
      "description": "outputs go_module_plan consumed by pkg-go-tag-and-proxy"
    }
  ]
}
