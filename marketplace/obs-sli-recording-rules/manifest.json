{
  "name": "obs-sli-recording-rules",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "observability",
    "prometheus",
    "recording-rules",
    "sli",
    "promtool"
  ],
  "inputs": [
    "slo_spec",
    "rules_dir"
  ],
  "outputs": [
    "recording_rules"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write Prometheus recording rules for each SLO's error ratio over the 5m, 30m, 1h, 6h and 3d burn-rate windows, check with promtool, load them and confirm every series exists.",
  "related_flows": [
    {
      "flow_name": "obs-signal-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "obs-red-metrics-spec",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "obs-histogram-bucket-design",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "obs-slo-error-budget-define",
      "relationship": "fed_by",
      "description": "provides slo_spec needed here"
    },
    {
      "flow_name": "obs-burn-rate-alert-rules",
      "relationship": "feeds_into",
      "description": "outputs recording_rules consumed by obs-burn-rate-alert-rules"
    },
    {
      "flow_name": "obs-alertmanager-routing",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "obs-alert-runbook-write",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "obs-promtool-rule-tests",
      "relationship": "feeds_into",
      "description": "outputs recording_rules consumed by obs-promtool-rule-tests"
    }
  ]
}
