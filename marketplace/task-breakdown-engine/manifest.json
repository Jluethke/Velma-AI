{
  "name": "task-breakdown-engine",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "task",
    "breakdown",
    "engine"
  ],
  "inputs": [
    "key_result_areas",
    "milestones"
  ],
  "outputs": [
    "weekly_tasks"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process key_result_areas, milestones to produce weekly_tasks.",
  "related_flows": [
    {
      "flow_name": "kra-decomposer",
      "relationship": "fed_by",
      "description": "provides key_result_areas needed here"
    },
    {
      "flow_name": "milestone-designer",
      "relationship": "fed_by",
      "description": "provides milestones needed here"
    },
    {
      "flow_name": "resource-allocator",
      "relationship": "feeds_into",
      "description": "outputs weekly_tasks consumed by resource-allocator"
    },
    {
      "flow_name": "checkpoint-designer",
      "relationship": "feeds_into",
      "description": "outputs weekly_tasks consumed by checkpoint-designer"
    },
    {
      "flow_name": "plan-assembler",
      "relationship": "feeds_into",
      "description": "outputs weekly_tasks consumed by plan-assembler"
    }
  ]
}
