{
  "name": "tkt-acceptance-criteria-gwt",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "acceptance-criteria",
    "gherkin",
    "given-when-then",
    "bdd",
    "requirements"
  ],
  "inputs": [
    "working_requirements",
    "ambiguity_list"
  ],
  "outputs": [
    "acceptance_criteria"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Convert working requirements into Given/When/Then scenarios with one When, literal Then values, and a test hint per scenario.",
  "related_flows": [
    {
      "flow_name": "tkt-ticket-ambiguity-extract",
      "relationship": "fed_by",
      "description": "provides working_requirements, ambiguity_list needed here"
    },
    {
      "flow_name": "tkt-repo-orient-detect",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "tkt-rg-call-trace",
      "relationship": "feeds_into",
      "description": "outputs acceptance_criteria consumed by tkt-rg-call-trace"
    },
    {
      "flow_name": "tkt-lsp-reference-trace",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "tkt-change-impact-list",
      "relationship": "feeds_into",
      "description": "outputs acceptance_criteria consumed by tkt-change-impact-list"
    },
    {
      "flow_name": "tkt-test-level-choose",
      "relationship": "feeds_into",
      "description": "outputs acceptance_criteria consumed by tkt-test-level-choose"
    },
    {
      "flow_name": "tkt-branch-create",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "tkt-failing-test-first",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
