{
  "name": "a11y-lighthouse-audit",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "lighthouse",
    "automated-testing",
    "chrome",
    "wcag"
  ],
  "inputs": [
    "page_inventory",
    "site_url"
  ],
  "outputs": [
    "lighthouse_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Runs the Lighthouse CLI accessibility category headless against every default-state URL in the inventory, saves JSON reports, and extracts failing audits with their node selectors plus the list of manual-check audits Lighthouse leaves to a human.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "fed_by",
      "description": "provides page_inventory needed here"
    },
    {
      "flow_name": "a11y-axe-playwright-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-pa11y-ci-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-scan-merge-dedupe",
      "relationship": "feeds_into",
      "description": "outputs lighthouse_findings consumed by a11y-scan-merge-dedupe"
    },
    {
      "flow_name": "a11y-color-contrast-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
