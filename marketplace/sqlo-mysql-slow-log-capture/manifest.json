{
  "name": "sqlo-mysql-slow-log-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "mysql",
    "slow-query-log",
    "pt-query-digest",
    "performance"
  ],
  "inputs": [
    "tuning_scope",
    "capture_window"
  ],
  "outputs": [
    "slow_query_list"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Enable the MySQL slow query log for a bounded window and summarize it with pt-query-digest into ranked fingerprints.",
  "related_flows": [
    {
      "flow_name": "sqlo-baseline-scope",
      "relationship": "fed_by",
      "description": "provides tuning_scope needed here"
    },
    {
      "flow_name": "sqlo-mysql-perf-schema-digest",
      "relationship": "feeds_into",
      "description": "outputs slow_query_list consumed by sqlo-mysql-perf-schema-digest"
    },
    {
      "flow_name": "sqlo-sargable-rewrite",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-keyset-pagination",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-btree-composite-order",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-index-write-cost",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-prod-like-verify",
      "relationship": "feeds_into",
      "description": "outputs slow_query_list consumed by sqlo-prod-like-verify"
    },
    {
      "flow_name": "sqlo-mysql-explain-analyze-read",
      "relationship": "feeds_into",
      "description": "outputs slow_query_list consumed by sqlo-mysql-explain-analyze-read"
    }
  ]
}
