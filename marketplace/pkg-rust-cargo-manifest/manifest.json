{
  "name": "pkg-rust-cargo-manifest",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rust",
    "cargo",
    "Cargo.toml",
    "crates.io",
    "msrv"
  ],
  "inputs": [
    "license_report",
    "release_version",
    "project_dir"
  ],
  "outputs": [
    "cargo_manifest_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Set the Cargo.toml fields crates.io requires and recommends, fix path and git dependencies, declare rust-version, and confirm the packaged file list with cargo package --list.",
  "related_flows": [
    {
      "flow_name": "pkg-scope-intake",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-public-api-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-license-metadata",
      "relationship": "fed_by",
      "description": "provides license_report needed here"
    },
    {
      "flow_name": "pkg-rust-pub-surface",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-rust-cargo-publish",
      "relationship": "feeds_into",
      "description": "outputs cargo_manifest_report consumed by pkg-rust-cargo-publish"
    },
    {
      "flow_name": "pkg-release-version-lock",
      "relationship": "fed_by",
      "description": "provides release_version needed here"
    }
  ]
}
