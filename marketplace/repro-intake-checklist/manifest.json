{
  "name": "repro-intake-checklist",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "debugging",
    "bug-report",
    "triage",
    "intake"
  ],
  "inputs": [
    "bug_report",
    "repo_path"
  ],
  "outputs": [
    "bug_brief",
    "missing_info"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Turn a raw bug report into a structured brief with quoted error signature and a list of every missing fact with the exact question to ask.",
  "related_flows": [
    {
      "flow_name": "repro-env-capture",
      "relationship": "feeds_into",
      "description": "outputs bug_brief consumed by repro-env-capture"
    },
    {
      "flow_name": "repro-container-env-replica",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-deterministic-script",
      "relationship": "feeds_into",
      "description": "outputs bug_brief consumed by repro-deterministic-script"
    },
    {
      "flow_name": "repro-nondeterminism-pin",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-ddmin-minimize",
      "relationship": "feeds_into",
      "description": "outputs bug_brief consumed by repro-ddmin-minimize"
    },
    {
      "flow_name": "repro-git-bisect-run",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "repro-py-pytest-regression-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "repro-red-test-gate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
