{
  "name": "vsens-kalibr-camera-imu",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "calibration",
    "kalibr",
    "camera-imu",
    "extrinsics",
    "time-offset"
  ],
  "inputs": [
    "camera_intrinsics",
    "imu_noise_params",
    "calibration_bag",
    "aprilgrid_spec"
  ],
  "outputs": [
    "camera_imu_extrinsics",
    "camera_imu_time_offset"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Estimate the camera-to-IMU transform and time offset with Kalibr and accept it only after reading reprojection and IMU residual plots.",
  "related_flows": [
    {
      "flow_name": "vsens-sensor-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-imu-driver-bringup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-imu-allan-variance",
      "relationship": "fed_by",
      "description": "provides imu_noise_params needed here"
    },
    {
      "flow_name": "vsens-lidar-driver-pointcloud",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-camera-lidar-extrinsics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-intrinsics-acceptance",
      "relationship": "fed_by",
      "description": "provides camera_intrinsics needed here"
    },
    {
      "flow_name": "vsens-integration-acceptance",
      "relationship": "feeds_into",
      "description": "outputs camera_imu_extrinsics consumed by vsens-integration-acceptance"
    }
  ]
}
