{
  "name": "business-context-enricher",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "business",
    "context",
    "enricher"
  ],
  "inputs": [
    "business_context_source",
    "column_metadata"
  ],
  "outputs": [
    "business_descriptions",
    "missing_descriptions",
    "valid_values"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process business_context_source, column_metadata to produce business_descriptions, missing_descriptions, valid_values.",
  "related_flows": [
    {
      "flow_name": "schema-metadata-extractor",
      "relationship": "fed_by",
      "description": "provides column_metadata needed here"
    },
    {
      "flow_name": "data-dictionary-compiler",
      "relationship": "feeds_into",
      "description": "outputs business_descriptions, valid_values consumed by data-dictionary-compiler"
    },
    {
      "flow_name": "dictionary-validator",
      "relationship": "feeds_into",
      "description": "outputs missing_descriptions consumed by dictionary-validator"
    }
  ]
}
