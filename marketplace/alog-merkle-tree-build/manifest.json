{
  "name": "alog-merkle-tree-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "audit-log",
    "merkle-tree",
    "rfc6962",
    "tree-head",
    "hash"
  ],
  "inputs": [
    "record_schema",
    "hash_algorithm_spec",
    "repo_path"
  ],
  "outputs": [
    "merkle_tree_spec"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a Merkle tree over the record content hashes using RFC 6962 leaf and node hashing with domain-separation prefixes, producing a tree head that summarizes the whole log.",
  "related_flows": [
    {
      "flow_name": "alog-hash-algorithm-select",
      "relationship": "fed_by",
      "description": "provides hash_algorithm_spec needed here"
    },
    {
      "flow_name": "alog-merkle-inclusion-proof",
      "relationship": "feeds_into",
      "description": "outputs merkle_tree_spec consumed by alog-merkle-inclusion-proof"
    },
    {
      "flow_name": "alog-merkle-consistency-proof",
      "relationship": "feeds_into",
      "description": "outputs merkle_tree_spec consumed by alog-merkle-consistency-proof"
    },
    {
      "flow_name": "alog-checkpoint-signing",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "alog-external-anchoring",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "alog-record-schema-design",
      "relationship": "fed_by",
      "description": "provides record_schema needed here"
    }
  ]
}
