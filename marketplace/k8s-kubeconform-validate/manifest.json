{
  "name": "k8s-kubeconform-validate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "kubeconform",
    "schema",
    "validation",
    "crd"
  ],
  "inputs": [
    "helm_rendered_manifests",
    "kustomize_rendered_manifests",
    "kubernetes_version"
  ],
  "outputs": [
    "schema_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Validate rendered manifests with kubeconform -strict against the target Kubernetes version, including CRD schemas, with skipped resources treated as unverified.",
  "related_flows": [
    {
      "flow_name": "k8s-kube-linter-check",
      "relationship": "feeds_into",
      "description": "outputs schema_report consumed by k8s-kube-linter-check"
    },
    {
      "flow_name": "k8s-helm-vs-kustomize-decision",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-security-context-hardening",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-rolling-update-pdb",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-network-policy-default-deny",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-helm-chart-build",
      "relationship": "fed_by",
      "description": "provides helm_rendered_manifests needed here"
    },
    {
      "flow_name": "k8s-kustomize-overlays",
      "relationship": "fed_by",
      "description": "provides kustomize_rendered_manifests needed here"
    },
    {
      "flow_name": "k8s-argocd-application",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
