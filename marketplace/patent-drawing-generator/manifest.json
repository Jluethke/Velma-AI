{
  "name": "patent-drawing-generator",
  "version": "1.0.0",
  "domain": "legal",
  "description": "Generates USPTO-compliant patent drawings from textual figure descriptions. Produces Mermaid diagram code for system architectures, flowcharts, state machines, sequence diagrams, and data flow diagrams. Outputs drawing specifications that meet 37 CFR 1.84 requirements.",
  "tags": [
    "patent",
    "drawing",
    "USPTO",
    "diagram",
    "mermaid",
    "flowchart",
    "state-machine",
    "architecture",
    "intellectual-property",
    "legal"
  ],
  "inputs": [
    "figure_description",
    "figure_number",
    "patent_family",
    "drawing_type"
  ],
  "outputs": [
    "mermaid_code",
    "drawing_specification",
    "compliance_notes",
    "reference_numerals"
  ],
  "execution_pattern": "linear",
  "price": 0,
  "license": "PRIVATE",
  "min_shadow_count": 3,
  "graduation_threshold": 0.75,
  "related_flows": [
    {
      "flow_name": "data-extractor",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "patent-spec-aligner",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "checklist-builder",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "patent-claims-drafter",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "patent-spec-writer",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
