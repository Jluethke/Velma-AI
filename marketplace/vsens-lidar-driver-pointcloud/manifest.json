{
  "name": "vsens-lidar-driver-pointcloud",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "lidar",
    "pointcloud2",
    "pcd",
    "tcpdump",
    "udp"
  ],
  "inputs": [
    "sensor_inventory",
    "lidar_model"
  ],
  "outputs": [
    "lidar_stream_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Bring up an Ethernet lidar by confirming UDP packet flow and kernel drop counters, and record the PointCloud2 or PCD field layout and per-point time unit.",
  "related_flows": [
    {
      "flow_name": "vsens-sensor-inventory",
      "relationship": "fed_by",
      "description": "provides sensor_inventory needed here"
    },
    {
      "flow_name": "vsens-imu-driver-bringup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-imu-allan-variance",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-kalibr-camera-imu",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-camera-lidar-extrinsics",
      "relationship": "feeds_into",
      "description": "outputs lidar_stream_report consumed by vsens-camera-lidar-extrinsics"
    }
  ]
}
