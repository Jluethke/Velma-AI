{
  "name": "race-rust-loom",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rust",
    "loom",
    "model-checking",
    "atomics",
    "memory-ordering"
  ],
  "inputs": [
    "repo_path",
    "shared_state_inventory"
  ],
  "outputs": [
    "loom_results"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Writes a `loom` model test for one Rust concurrent type (a hand-rolled lock, atomic counter, once-cell, queue or channel wrapper) so that loom exhaustively explores thread interleavings and memory orderings, and records any interleaving that breaks an invariant.",
  "related_flows": [
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "fed_by",
      "description": "provides shared_state_inventory needed here"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs loom_results consumed by race-findings-consolidate"
    }
  ]
}
