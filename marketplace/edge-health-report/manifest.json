    },
    {
      "flow_name": "edge-systemd-watchdog-service",
      "relationship": "fed_by",
      "description": "provides service_unit needed here"
    },
    {
      "flow_name": "edge-jetson-clocks-lock",
      "relationship": "fed_by",
      "description": "provides clock_state needed here"
    },
    {
      "flow_name": "edge-vehicle-integration-boundary",
      "relationship": "feeds_into",
      "description": "outputs health_report consumed by edge-vehicle-integration-boundary"
    }
  ]
