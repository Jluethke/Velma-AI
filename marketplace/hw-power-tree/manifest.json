      "relationship": "feeds_into",
      "description": "outputs power_tree consumed by hw-critical-circuit-flagging"
    },
    {
      "flow_name": "hw-mechanical-fab-constraints",
      "relationship": "feeds_into",
      "description": "outputs power_tree consumed by hw-mechanical-fab-constraints"
    },
    {
      "flow_name": "hw-spec-consolidate",
      "relationship": "feeds_into",
      "description": "outputs power_tree consumed by hw-spec-consolidate"
    }
  ]
}
