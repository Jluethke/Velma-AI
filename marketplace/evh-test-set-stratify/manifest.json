{
  "name": "evh-test-set-stratify",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "llm-evaluation",
    "dataset",
    "stratification",
    "deduplication",
    "scikit-learn"
  ],
  "inputs": [
    "task_spec",
    "failure_taxonomy",
    "trace_source",
    "project_dir",
    "target_items_per_stratum"
  ],
  "outputs": [
    "test_set",
    "strata_manifest"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a deduplicated, stratified, group-aware dev and held-out test set for an LLM eval with hashes recorded in a manifest.",
  "related_flows": [
    {
      "flow_name": "evh-task-rubric-spec",
      "relationship": "fed_by",
      "description": "provides task_spec needed here"
    },
    {
      "flow_name": "evh-adversarial-safety-cases",
      "relationship": "feeds_into",
      "description": "outputs test_set consumed by evh-adversarial-safety-cases"
    },
    {
      "flow_name": "evh-golden-labels-annotation",
      "relationship": "feeds_into",
      "description": "outputs test_set consumed by evh-golden-labels-annotation"
    },
    {
      "flow_name": "evh-prompt-model-versioning",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "evh-results-normalize",
      "relationship": "feeds_into",
      "description": "outputs strata_manifest consumed by evh-results-normalize"
    },
    {
      "flow_name": "evh-sample-size-confidence-intervals",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "evh-regression-diff-triage",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "evh-trace-error-analysis",
      "relationship": "fed_by",
      "description": "provides failure_taxonomy needed here"
    }
  ]
}
