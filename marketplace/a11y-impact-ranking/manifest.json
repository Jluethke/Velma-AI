{
  "name": "a11y-impact-ranking",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "prioritization",
    "triage",
    "user-impact",
    "wcag"
  ],
  "inputs": [
    "critical_journeys",
    "automated_issues",
    "keyboard_issues",
    "focus_issues",
    "nvda_issues",
    "voiceover_macos_issues",
    "voiceover_ios_issues",
    "contrast_issues",
    "form_issues",
    "image_issues",
    "structure_issues",
    "motion_issues",
    "target_size_issues",
    "reflow_issues",
    "pointer_help_issues"
  ],
  "outputs": [
    "ranked_issues"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Merges every automated and manual issue list into one register, assigns each issue an impact level and a \"blocks task\" flag with a fixed decision table, and orders the register lexicographically by task blocking, journey priority, impact, and number of pages affected, with no invented weights or scores.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "a11y-axe-playwright-scan",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "a11y-scan-merge-dedupe",
      "relationship": "fed_by",
      "description": "provides automated_issues needed here"
    },
    {
      "flow_name": "a11y-focus-order-visibility-check",
      "relationship": "fed_by",
      "description": "provides focus_issues needed here"
    },
    {
      "flow_name": "a11y-lighthouse-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-pa11y-ci-scan",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-keyboard-operability-pass",
      "relationship": "fed_by",
      "description": "provides keyboard_issues needed here"
    },
    {
      "flow_name": "a11y-nvda-screen-reader-pass",
      "relationship": "fed_by",
      "description": "provides nvda_issues needed here"
    }
  ]
}
