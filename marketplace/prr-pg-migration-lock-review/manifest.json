{
  "name": "prr-pg-migration-lock-review",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "code-review",
    "postgresql",
    "migrations",
    "locking",
    "squawk"
  ],
  "inputs": [
    "repo_dir",
    "changed_files",
    "findings_dir",
    "database_url"
  ],
  "outputs": [
    "migration_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Render each PR migration's SQL and check every statement against PostgreSQL lock levels and rewrite rules, requiring concurrent, NOT VALID and expand-contract patterns.",
  "related_flows": [
    {
      "flow_name": "prr-fetch-pr-diff",
      "relationship": "fed_by",
      "description": "provides changed_files needed here"
    },
    {
      "flow_name": "prr-intent-scope-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-large-pr-split",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-diff-reading-order",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-perf-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-pg-explain-new-queries",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-concurrency-pass",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "prr-severity-comments",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
