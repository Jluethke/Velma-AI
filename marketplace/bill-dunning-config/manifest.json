{
  "name": "bill-dunning-config",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "billing",
    "stripe",
    "dunning",
    "smart-retries",
    "revenue-recovery"
  ],
  "inputs": [
    "invoice_settings",
    "grace_period_days"
  ],
  "outputs": [
    "dunning_settings",
    "access_policy"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Configure Stripe Smart Retries, failed-payment emails and the post-retry subscription outcome, and derive an access policy table per subscription status.",
  "related_flows": [
    {
      "flow_name": "bill-invoice-lifecycle",
      "relationship": "fed_by",
      "description": "provides invoice_settings needed here"
    },
    {
      "flow_name": "bill-payment-failure-handler",
      "relationship": "feeds_into",
      "description": "outputs access_policy, dunning_settings consumed by bill-payment-failure-handler"
    },
    {
      "flow_name": "bill-py-feature-gate",
      "relationship": "feeds_into",
      "description": "outputs access_policy consumed by bill-py-feature-gate"
    },
    {
      "flow_name": "bill-node-feature-gate",
      "relationship": "feeds_into",
      "description": "outputs access_policy consumed by bill-node-feature-gate"
    },
    {
      "flow_name": "bill-test-clock-e2e",
      "relationship": "feeds_into",
      "description": "outputs dunning_settings consumed by bill-test-clock-e2e"
    }
  ]
}
