{
  "name": "res-retry-policy",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "resilience",
    "retries",
    "backoff",
    "jitter",
    "retry-budget"
  ],
  "inputs": [
    "dependency_map",
    "timeout_plan"
  ],
  "outputs": [
    "retry_policy"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Decide retryable failures, attempts within the deadline, full-jitter backoff, one owning retry layer, and a sourced retry budget for every dependency operation.",
  "related_flows": [
    {
      "flow_name": "res-dependency-map",
      "relationship": "fed_by",
      "description": "provides dependency_map needed here"
    },
    {
      "flow_name": "res-latency-percentiles",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "res-timeout-budget",
      "relationship": "fed_by",
      "description": "provides timeout_plan needed here"
    },
    {
      "flow_name": "res-breaker-policy",
      "relationship": "feeds_into",
      "description": "outputs retry_policy consumed by res-breaker-policy"
    },
    {
      "flow_name": "res-bulkhead-partition",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "res-toxiproxy-faults",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "res-resilience-verify",
      "relationship": "feeds_into",
      "description": "outputs retry_policy consumed by res-resilience-verify"
    },
    {
      "flow_name": "res-py-timeouts",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
