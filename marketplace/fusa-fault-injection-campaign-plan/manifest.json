{
  "name": "fusa-fault-injection-campaign-plan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "functional-safety",
    "fault-injection",
    "test-planning",
    "fmea",
    "fault-tree"
  ],
  "inputs": [
    "dfmea_worksheet",
    "sw_fmea_rows",
    "cut_set_report",
    "safety_requirements"
  ],
  "outputs": [
    "fault_injection_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a bench fault injection campaign where every fault traces to an FMEA row or cut set, with method, expected detection and reaction, time budget and a measurable pass rule.",
  "related_flows": [
    {
      "flow_name": "fusa-dfmea-worksheet",
      "relationship": "fed_by",
      "description": "provides dfmea_worksheet needed here"
    },
    {
      "flow_name": "fusa-sw-fmea-interface-guidewords",
      "relationship": "fed_by",
      "description": "provides sw_fmea_rows needed here"
    },
    {
      "flow_name": "fusa-fta-scram-cut-sets",
      "relationship": "fed_by",
      "description": "provides cut_set_report needed here"
    },
    {
      "flow_name": "fusa-dependent-failure-analysis",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "fusa-fault-injection-mcu-gdb",
      "relationship": "feeds_into",
      "description": "outputs fault_injection_plan consumed by fusa-fault-injection-mcu-gdb"
    },
    {
      "flow_name": "fusa-fault-injection-linux",
      "relationship": "feeds_into",
      "description": "outputs fault_injection_plan consumed by fusa-fault-injection-linux"
    },
    {
      "flow_name": "fusa-requirements-decomposition",
      "relationship": "fed_by",
      "description": "provides safety_requirements needed here"
    }
  ]
}
