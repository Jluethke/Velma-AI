{
  "name": "flk-flake-evidence-intake",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "flaky-tests",
    "ci",
    "triage",
    "evidence"
  ],
  "inputs": [
    "test_id",
    "repo_path",
    "stack",
    "ci_failure_logs"
  ],
  "outputs": [
    "flake_evidence"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Prove a test is flaky by finding the same commit with both a pass and a fail in CI history, and group its failure messages by signature.",
  "related_flows": [
    {
      "flow_name": "flk-run-count-derive",
      "relationship": "feeds_into",
      "description": "outputs flake_evidence consumed by flk-run-count-derive"
    },
    {
      "flow_name": "flk-classify-root-cause",
      "relationship": "feeds_into",
      "description": "outputs flake_evidence consumed by flk-classify-root-cause"
    },
    {
      "flow_name": "flk-verify-same-count",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "flk-tz-locale-matrix-detect",
      "relationship": "feeds_into",
      "description": "outputs flake_evidence consumed by flk-tz-locale-matrix-detect"
    },
    {
      "flow_name": "flk-random-seed-pin",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-network-stub-isolate",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-ci-shuffle-guard",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "flk-py-repeat-measure",
      "relationship": "feeds_into",
      "description": "outputs flake_evidence consumed by flk-py-repeat-measure"
    }
  ]
}
