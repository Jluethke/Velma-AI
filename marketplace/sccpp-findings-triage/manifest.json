{
  "name": "sccpp-findings-triage",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "triage",
    "static-analysis",
    "misra",
    "findings"
  ],
  "inputs": [
    "guideline_plan",
    "gcc_warning_report",
    "clang_warning_report",
    "clang_tidy_findings",
    "cppcheck_findings"
  ],
  "outputs": [
    "triaged_findings",
    "deviation_candidates"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Merge compiler, clang-tidy and Cppcheck findings and classify each as defect, false positive with evidence, or deviation candidate.",
  "related_flows": [
    {
      "flow_name": "sccpp-standard-select",
      "relationship": "fed_by",
      "description": "provides guideline_plan needed here"
    },
    {
      "flow_name": "sccpp-cmake-build-profiles",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-gcc-warning-set",
      "relationship": "fed_by",
      "description": "provides gcc_warning_report needed here"
    },
    {
      "flow_name": "sccpp-clang-warning-set",
      "relationship": "fed_by",
      "description": "provides clang_warning_report needed here"
    },
    {
      "flow_name": "sccpp-clang-tidy-config",
      "relationship": "fed_by",
      "description": "provides clang_tidy_findings needed here"
    },
    {
      "flow_name": "sccpp-cppcheck-misra-c",
      "relationship": "fed_by",
      "description": "provides cppcheck_findings needed here"
    },
    {
      "flow_name": "sccpp-deviation-record",
      "relationship": "feeds_into",
      "description": "outputs deviation_candidates consumed by sccpp-deviation-record"
    },
    {
      "flow_name": "sccpp-evidence-summary",
      "relationship": "feeds_into",
      "description": "outputs triaged_findings consumed by sccpp-evidence-summary"
    }
  ]
}
