{
    "name": "sccpp-findings-triage",
    "version": "1.0.0",
    "domain": "engineering",
    "tags": [
        "triage",
        "static-analysis",
        "misra",
        "findings"
    ],
    "inputs": [
        "guideline_plan",
        "gcc_warning_report",
        "clang_warning_report",
        "clang_tidy_findings",
        "cppcheck_findings"
    ],
    "outputs": [
        "triaged_findings",
        "deviation_candidates"
    ],
    "execution_pattern": "phase_pipeline",
    "price": "0",
