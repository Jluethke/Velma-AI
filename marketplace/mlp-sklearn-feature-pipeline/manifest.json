{
  "name": "mlp-sklearn-feature-pipeline",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "feature-engineering",
    "column-transformer",
    "scikit-learn"
  ],
  "inputs": [
    "split_manifest",
    "clean_feature_list",
    "primary_metric",
    "repo_path"
  ],
  "outputs": [
    "feature_pipeline",
    "pipeline_cv_scores"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Puts all preprocessing (imputation, scaling, encoding, target encoding) inside one scikit-learn `Pipeline` with a `ColumnTransformer`, so every transform is fit only on training folds during CV and the same object runs at inference.",
  "related_flows": [
    {
      "flow_name": "mlp-sklearn-seed-determinism",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-baseline-models",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-mlflow-tracking",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-optuna-search",
      "relationship": "feeds_into",
      "description": "outputs feature_pipeline consumed by mlp-optuna-search"
    },
    {
      "flow_name": "mlp-nested-cv-estimate",
      "relationship": "feeds_into",
      "description": "outputs feature_pipeline consumed by mlp-nested-cv-estimate"
    },
    {
      "flow_name": "mlp-bootstrap-metric-ci",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-paired-model-comparison",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-calibration-diagnose",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
