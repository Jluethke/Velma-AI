{
  "name": "repro-env-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "debugging",
    "environment",
    "versions",
    "reproduction"
  ],
  "inputs": [
    "bug_brief",
    "stack",
    "repo_path"
  ],
  "outputs": [
    "env_snapshot",
    "env_diff"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Capture OS, runtime, dependency, locale, time zone and config facts locally and as reported, and classify every difference that could change behavior.",
  "related_flows": [
    {
      "flow_name": "repro-intake-checklist",
      "relationship": "fed_by",
      "description": "provides bug_brief needed here"
    },
    {
      "flow_name": "repro-container-env-replica",
      "relationship": "feeds_into",
      "description": "outputs env_diff, env_snapshot consumed by repro-container-env-replica"
    },
    {
      "flow_name": "repro-deterministic-script",
      "relationship": "feeds_into",
      "description": "outputs env_snapshot consumed by repro-deterministic-script"
    },
    {
      "flow_name": "repro-nondeterminism-pin",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-ddmin-minimize",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-git-bisect-run",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "repro-py-pytest-regression-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "repro-red-test-gate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
