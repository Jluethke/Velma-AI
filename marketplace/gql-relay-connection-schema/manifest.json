{
  "name": "gql-relay-connection-schema",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "graphql",
    "pagination",
    "relay",
    "connections",
    "cursors"
  ],
  "inputs": [
    "nullable_schema",
    "operation_inventory"
  ],
  "outputs": [
    "paginated_schema",
    "cursor_spec"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Replace paginated list fields with spec-conformant Relay cursor connections and write the cursor contract resolvers must follow.",
  "related_flows": [
    {
      "flow_name": "gql-use-case-inventory",
      "relationship": "fed_by",
      "description": "provides operation_inventory needed here"
    },
    {
      "flow_name": "gql-schema-sdl-draft",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-nullability-review",
      "relationship": "fed_by",
      "description": "provides nullable_schema needed here"
    },
    {
      "flow_name": "gql-schema-lint-graphql-eslint",
      "relationship": "feeds_into",
      "description": "outputs paginated_schema consumed by gql-schema-lint-graphql-eslint"
    },
    {
      "flow_name": "gql-schema-breaking-diff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "gql-connection-keyset-resolver",
      "relationship": "feeds_into",
      "description": "outputs cursor_spec consumed by gql-connection-keyset-resolver"
    }
  ]
}
