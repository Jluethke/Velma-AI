{
  "name": "a11y-scope-inventory",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "wcag",
    "wcag-em",
    "inventory",
    "scope"
  ],
  "inputs": [
    "site_url",
    "repo_dir",
    "stack",
    "scope_notes"
  ],
  "outputs": [
    "page_inventory",
    "component_inventory"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Builds the page inventory and component inventory that every later WCAG 2.2 AA test runs against, using the W3C WCAG-EM sampling method (structured sample plus random sample plus complete processes), so no test is run on an ad hoc set of pages.",
  "related_flows": [
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "a11y-axe-playwright-scan",
      "relationship": "feeds_into",
      "description": "outputs page_inventory consumed by a11y-axe-playwright-scan"
    },
    {
      "flow_name": "a11y-scan-merge-dedupe",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "a11y-focus-order-visibility-check",
      "relationship": "feeds_into",
      "description": "outputs page_inventory consumed by a11y-focus-order-visibility-check"
    },
    {
      "flow_name": "a11y-lighthouse-audit",
      "relationship": "feeds_into",
      "description": "outputs page_inventory consumed by a11y-lighthouse-audit"
    },
    {
      "flow_name": "a11y-pa11y-ci-scan",
      "relationship": "feeds_into",
      "description": "outputs page_inventory consumed by a11y-pa11y-ci-scan"
    },
    {
      "flow_name": "a11y-keyboard-operability-pass",
      "relationship": "feeds_into",
      "description": "outputs page_inventory, component_inventory consumed by a11y-keyboard-operability-pass"
    },
    {
      "flow_name": "a11y-nvda-screen-reader-pass",
      "relationship": "feeds_into",
      "description": "outputs page_inventory consumed by a11y-nvda-screen-reader-pass"
    }
  ]
}
