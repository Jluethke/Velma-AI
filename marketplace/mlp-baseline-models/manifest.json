{
  "name": "mlp-baseline-models",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "baseline",
    "dummy-classifier",
    "scikit-learn"
  ],
  "inputs": [
    "split_manifest",
    "problem_frame",
    "primary_metric",
    "clean_feature_list"
  ],
  "outputs": [
    "baseline_models",
    "baseline_scores"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Fits a ladder of baselines (dummy, simple heuristic or naive forecast, linear model in a pipeline) with the exact split and metric of the project, so every later model is judged by how much it beats the simplest thing that works.",
  "related_flows": [
    {
      "flow_name": "mlp-sklearn-seed-determinism",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-sklearn-feature-pipeline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-mlflow-tracking",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-optuna-search",
      "relationship": "feeds_into",
      "description": "outputs baseline_scores consumed by mlp-optuna-search"
    },
    {
      "flow_name": "mlp-nested-cv-estimate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-bootstrap-metric-ci",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-paired-model-comparison",
      "relationship": "feeds_into",
      "description": "outputs baseline_models consumed by mlp-paired-model-comparison"
    },
    {
      "flow_name": "mlp-calibration-diagnose",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
