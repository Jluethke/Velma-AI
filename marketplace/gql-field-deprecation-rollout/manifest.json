{
  "name": "gql-field-deprecation-rollout",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "graphql",
    "deprecation",
    "schema-evolution",
    "usage-tracking"
  ],
  "inputs": [
    "breaking_changes",
    "persisted_manifest",
    "project_dir"
  ],
  "outputs": [
    "deprecation_plan",
    "deprecated_schema"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Ship breaking changes as additive fields with @deprecated, track usage statically and at runtime, and remove fields only when both show zero use.",
  "related_flows": [
    {
      "flow_name": "gql-persisted-documents-manifest",
      "relationship": "fed_by",
      "description": "provides persisted_manifest needed here"
    },
    {
      "flow_name": "gql-schema-breaking-diff",
      "relationship": "fed_by",
      "description": "provides breaking_changes needed here"
    }
  ]
}
