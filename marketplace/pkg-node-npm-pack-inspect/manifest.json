{
  "name": "pkg-node-npm-pack-inspect",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "npm",
    "npm-pack",
    "tarball",
    "files"
  ],
  "inputs": [
    "package_json_config",
    "types_report",
    "project_dir"
  ],
  "outputs": [
    "npm_tarball_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
