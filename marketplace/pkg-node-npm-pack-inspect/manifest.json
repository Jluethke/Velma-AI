      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-license-metadata",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-node-exports-map",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-node-dual-esm-cjs",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-node-types-lint",
      "relationship": "fed_by",
      "description": "provides types_report needed here"
    },
    {
      "flow_name": "pkg-node-package-json-metadata",
      "relationship": "fed_by",
      "description": "provides package_json_config needed here"
    },
    {
      "flow_name": "pkg-node-clean-install",
