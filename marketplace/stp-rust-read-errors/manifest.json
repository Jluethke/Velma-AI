{
  "name": "stp-rust-read-errors",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "rust",
    "rustc",
    "cargo-test",
    "error-reading"
  ],
  "inputs": [
    "verify_result",
    "applied_edit"
  ],
  "outputs": [
    "rust_error_diagnosis"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Read rustc error codes, help lines, clippy lints and test panics and map the first diagnostic to a cause class and next action.",
  "related_flows": [
    {
      "flow_name": "stp-apply-one-edit",
      "relationship": "fed_by",
      "description": "provides applied_edit needed here"
    },
    {
      "flow_name": "stp-run-verify-capture",
      "relationship": "fed_by",
      "description": "provides verify_result needed here"
    },
    {
      "flow_name": "stp-py-read-traceback",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "stp-node-read-errors",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "stp-go-read-errors",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "stp-java-read-errors",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "stp-keep-or-revert-edit",
      "relationship": "feeds_into",
      "description": "outputs rust_error_diagnosis consumed by stp-keep-or-revert-edit"
    },
    {
      "flow_name": "stp-test-integrity-guard",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
