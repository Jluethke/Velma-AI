{
  "name": "flk-py-repeat-measure",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "flaky-tests",
    "python",
    "pytest",
    "pytest-repeat"
  ],
  "inputs": [
    "flake_evidence",
    "repeat_count",
    "repo_path"
  ],
  "outputs": [
    "py_flake_rate_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Measure a pytest test's flake rate with pytest-repeat in one process and with a fresh-process loop, at a fixed order and the derived run count.",
  "related_flows": [
    {
      "flow_name": "flk-flake-evidence-intake",
      "relationship": "fed_by",
      "description": "provides flake_evidence needed here"
    },
    {
      "flow_name": "flk-run-count-derive",
      "relationship": "fed_by",
      "description": "provides repeat_count needed here"
    },
    {
      "flow_name": "flk-classify-root-cause",
      "relationship": "feeds_into",
      "description": "outputs py_flake_rate_report consumed by flk-classify-root-cause"
    },
    {
      "flow_name": "flk-verify-same-count",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "flk-node-jest-loop-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-go-count-measure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-py-order-pollution-bisect",
      "relationship": "feeds_into",
      "description": "outputs py_flake_rate_report consumed by flk-py-order-pollution-bisect"
    },
    {
      "flow_name": "flk-tz-locale-matrix-detect",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
