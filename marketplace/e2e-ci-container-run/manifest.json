{
  "name": "e2e-ci-container-run",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "e2e",
    "ci",
    "docker",
    "github-actions",
    "containers"
  ],
  "inputs": [
    "repo_dir",
    "stack",
    "artifact_config",
    "node_shard_plan",
    "py_shard_plan",
    "cypress_shard_plan",
