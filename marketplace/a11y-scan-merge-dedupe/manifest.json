{
  "name": "a11y-scan-merge-dedupe",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "accessibility",
    "triage",
    "deduplication",
    "wcag",
    "jq"
  ],
  "inputs": [
    "axe_findings",
    "lighthouse_findings",
    "pa11y_findings"
  ],
  "outputs": [
    "automated_issues",
    "needs_review_items"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Merges axe-core, Lighthouse and Pa11y findings into one issue list keyed by WCAG success criterion, page, and element, removes duplicates reported by more than one engine, and splits out every \"incomplete\" or \"warning\" item into a needs-review list for manual flows.",
  "related_flows": [
    {
      "flow_name": "a11y-scope-inventory",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "a11y-axe-playwright-scan",
      "relationship": "fed_by",
      "description": "provides axe_findings needed here"
    },
    {
      "flow_name": "a11y-impact-ranking",
      "relationship": "feeds_into",
      "description": "outputs automated_issues consumed by a11y-impact-ranking"
    },
    {
      "flow_name": "a11y-lighthouse-audit",
      "relationship": "fed_by",
      "description": "provides lighthouse_findings needed here"
    },
    {
      "flow_name": "a11y-pa11y-ci-scan",
      "relationship": "fed_by",
      "description": "provides pa11y_findings needed here"
    },
    {
      "flow_name": "a11y-color-contrast-measure",
      "relationship": "feeds_into",
      "description": "outputs needs_review_items consumed by a11y-color-contrast-measure"
    },
    {
      "flow_name": "a11y-fix-plan-by-criterion",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "a11y-react-fix-and-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
