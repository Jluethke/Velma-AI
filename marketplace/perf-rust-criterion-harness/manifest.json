{
  "name": "perf-rust-criterion-harness",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "performance",
    "rust",
    "criterion",
    "benchmarking",
    "cargo-bench"
  ],
  "inputs": [
    "perf_spec",
    "workload_spec",
    "bench_env_report",
    "repo_path"
  ],
  "outputs": [
    "rust_bench_raw"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Add a criterion.rs benchmark per workload size with black_box and untimed setup, run it, and save a named baseline read from estimates.json.",
  "related_flows": [
    {
      "flow_name": "perf-metric-workload-define",
      "relationship": "fed_by",
      "description": "provides perf_spec, workload_spec needed here"
    },
    {
      "flow_name": "perf-bench-env-stabilize",
      "relationship": "fed_by",
      "description": "provides bench_env_report needed here"
    },
    {
      "flow_name": "perf-py-pytest-benchmark-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-node-tinybench-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-go-bench-benchstat-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-jvm-jmh-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-hyperfine-cli-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-bench-baseline-normalize",
      "relationship": "feeds_into",
      "description": "outputs rust_bench_raw consumed by perf-bench-baseline-normalize"
    }
  ]
}
