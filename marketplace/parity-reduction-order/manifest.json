  "related_flows": [
    {
      "flow_name": "parity-contract-scope",
      "relationship": "fed_by",
      "description": "provides parity_contract needed here"
    },
    {
      "flow_name": "parity-ulp-tolerance-policy",
      "relationship": "feeds_into",
      "description": "outputs reduction_findings consumed by parity-ulp-tolerance-policy"
    }
  ]
}
