{
  "name": "parity-reduction-order",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "parity",
    "summation",
    "numpy",
    "blas"
  ],
  "inputs": [
    "reference_repo",
    "port_repo",
    "parity_contract"
  ],
  "outputs": [
    "reduction_findings"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
