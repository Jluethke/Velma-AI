{
    "name": "k8s-kube-linter-check",
    "version": "1.0.0",
    "domain": "engineering",
    "tags": [
        "kubernetes",
        "kube-linter",
        "lint",
        "best-practices"
    ],
    "inputs": [
        "helm_rendered_manifests",
        "kustomize_rendered_manifests",
        "schema_report",
        "repo_dir"
    ],
    "outputs": [
        "lint_report"
    ],
    "execution_pattern": "phase_pipeline",
    "price": "0",
    "license": "OPEN",
    "description": "Lint rendered manifests with all kube-linter built-in checks, fix findings at the source, and allow exceptions only through reasoned annotations."
}
