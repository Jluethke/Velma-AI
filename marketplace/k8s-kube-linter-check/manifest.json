{
  "name": "k8s-kube-linter-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "kube-linter",
    "lint",
    "best-practices"
  ],
  "inputs": [
    "helm_rendered_manifests",
    "kustomize_rendered_manifests",
    "schema_report",
    "repo_dir"
  ],
  "outputs": [
    "lint_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Lint rendered manifests with all kube-linter built-in checks, fix findings at the source, and allow exceptions only through reasoned annotations.",
  "related_flows": [
    {
      "flow_name": "k8s-kubeconform-validate",
      "relationship": "fed_by",
      "description": "provides schema_report needed here"
    },
    {
      "flow_name": "k8s-helm-vs-kustomize-decision",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-security-context-hardening",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-rolling-update-pdb",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-network-policy-default-deny",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-helm-chart-build",
      "relationship": "fed_by",
      "description": "provides helm_rendered_manifests needed here"
    },
    {
      "flow_name": "k8s-kustomize-overlays",
      "relationship": "fed_by",
      "description": "provides kustomize_rendered_manifests needed here"
    },
    {
      "flow_name": "k8s-argocd-application",
      "relationship": "feeds_into",
      "description": "outputs lint_report consumed by k8s-argocd-application"
    }
  ]
}
