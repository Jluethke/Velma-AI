{
  "name": "rel-yank-bad-release",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "release",
    "yank",
    "retract",
    "npm-deprecate",
    "incident"
  ],
  "inputs": [
    "package_name",
    "bad_version",
    "registry",
    "py_install_report",
    "node_install_report",
    "go_install_report",
    "rust_install_report"
  ],
  "outputs": [
    "withdrawal_actions"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Withdraw a broken or vulnerable published version with the registry-correct mechanism (PyPI yank, npm deprecate, Go retract, cargo yank, image tag repoint) without reusing the version.",
  "related_flows": [
    {
      "flow_name": "rel-changelog-git-cliff",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-tag-sign-git",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rel-hotfix-from-tag",
      "relationship": "feeds_into",
      "description": "outputs withdrawal_actions consumed by rel-hotfix-from-tag"
    },
    {
      "flow_name": "rel-py-verify-install",
      "relationship": "fed_by",
      "description": "provides py_install_report needed here"
    },
    {
      "flow_name": "rel-node-verify-install",
      "relationship": "fed_by",
      "description": "provides node_install_report needed here"
    },
    {
      "flow_name": "rel-go-verify-install",
      "relationship": "fed_by",
      "description": "provides go_install_report needed here"
    },
    {
      "flow_name": "rel-rust-verify-install",
      "relationship": "fed_by",
      "description": "provides rust_install_report needed here"
    }
  ]
}
