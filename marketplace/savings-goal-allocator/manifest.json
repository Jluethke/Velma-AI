{
  "name": "savings-goal-allocator",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "savings",
    "goal",
    "allocator"
  ],
  "inputs": [
    "emergency_fund_monthly_contribution",
    "financial_goals",
    "monthly_surplus_deficit",
    "total_debt_payments"
  ],
  "outputs": [
    "savings_allocation_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process emergency_fund_monthly_contribution, financial_goals, monthly_surplus_deficit to produce savings_allocation_plan.",
  "related_flows": [
    {
      "flow_name": "expense-analyzer",
      "relationship": "fed_by",
      "description": "provides monthly_surplus_deficit needed here"
    },
    {
      "flow_name": "zero-based-budget-builder",
      "relationship": "feeds_into",
      "description": "outputs savings_allocation_plan consumed by zero-based-budget-builder"
    },
    {
      "flow_name": "financial-timeline-report-generator",
      "relationship": "feeds_into",
      "description": "outputs savings_allocation_plan consumed by financial-timeline-report-generator"
    }
  ]
}
