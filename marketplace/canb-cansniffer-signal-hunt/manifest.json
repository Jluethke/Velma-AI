{
  "name": "canb-cansniffer-signal-hunt",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "can-bus",
    "can-utils",
    "cansniffer",
    "reverse-engineering",
    "read-only"
  ],
  "inputs": [
    "can_netdev",
    "candump_log",
    "tx_permission"
  ],
  "outputs": [
    "candidate_signals"
