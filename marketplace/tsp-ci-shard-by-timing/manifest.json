{
  "name": "tsp-ci-shard-by-timing",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "testing",
    "ci",
    "sharding",
    "pytest-split",
    "github-actions"
  ],
  "inputs": [
    "ci_config_path",
    "stack",
    "parallel_command",
    "shard_count"
  ],
  "outputs": [
    "shard_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Split the verified test command across GitHub Actions matrix shards using recorded timings and merge per-shard coverage.",
  "related_flows": [
    {
      "flow_name": "tsp-baseline-lock",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsp-ci-test-tool-cache",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsp-changed-test-selection",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsp-coverage-parity-gate",
      "relationship": "feeds_into",
      "description": "outputs shard_config consumed by tsp-coverage-parity-gate"
    },
    {
      "flow_name": "tsp-speedup-report",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tsp-order-isolation-check",
      "relationship": "fed_by",
      "description": "provides parallel_command needed here"
    }
  ]
}
