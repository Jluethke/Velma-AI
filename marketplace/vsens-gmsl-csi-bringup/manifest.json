{
  "name": "vsens-gmsl-csi-bringup",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "camera",
    "mipi-csi2",
    "gmsl",
    "media-ctl",
    "embedded-linux"
  ],
  "inputs": [
    "sensor_inventory",
    "board_bsp"
  ],
  "outputs": [
    "csi_link_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Bring up a MIPI CSI-2 or GMSL camera by confirming driver probe, the media controller graph and pad formats, then capturing raw frames of verified size.",
  "related_flows": [
    {
      "flow_name": "vsens-sensor-inventory",
      "relationship": "fed_by",
      "description": "provides sensor_inventory needed here"
    },
    {
      "flow_name": "vsens-v4l2-camera-probe",
      "relationship": "feeds_into",
      "description": "outputs csi_link_report consumed by vsens-v4l2-camera-probe"
    },
    {
      "flow_name": "vsens-v4l2-exposure-framerate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-gstreamer-capture-pipeline",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-cpp-v4l2-mmap-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-py-opencv-intrinsics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-cpp-opencv-intrinsics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsens-ros2-camera-calibrator",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
