{
  "name": "perc-trtexec-fp16-engine",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "perception",
    "tensorrt",
    "trtexec",
    "fp16",
    "benchmark"
  ],
  "inputs": [
    "onnx_model",
    "input_shape",
    "gpu_target"
  ],
  "outputs": [
    "fp16_engine",
    "trtexec_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build an FP16 TensorRT engine with trtexec on the target GPU and read its performance summary and layer precision report.",
  "related_flows": [
    {
      "flow_name": "perc-onnx-export-verify",
      "relationship": "fed_by",
      "description": "provides onnx_model needed here"
    },
    {
      "flow_name": "perc-preprocess-spec-extract",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "perc-int8-calibration-trt",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "perc-detection-map-eval",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "perc-model-select-pareto",
      "relationship": "feeds_into",
      "description": "outputs trtexec_report consumed by perc-model-select-pareto"
    },
    {
      "flow_name": "perc-nsys-profile-pipeline",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "perc-e2e-latency-budget",
      "relationship": "feeds_into",
      "description": "outputs trtexec_report consumed by perc-e2e-latency-budget"
    },
    {
      "flow_name": "perc-py-gpu-preprocess",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
