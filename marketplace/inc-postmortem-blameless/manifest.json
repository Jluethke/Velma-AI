{
  "name": "inc-postmortem-blameless",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "incident-response",
    "postmortem",
    "blameless",
    "contributing-factors",
    "sre"
  ],
  "inputs": [
    "incident_record",
    "resolution_record",
    "timeline_log",
    "confirmed_cause",
    "role_assignments"
  ],
  "outputs": [
    "postmortem_doc"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a blameless postmortem with contributing factors in four categories, a blame-language check, and typed candidate actions with done conditions.",
  "related_flows": [
    {
      "flow_name": "inc-declare-resolved",
      "relationship": "fed_by",
      "description": "provides resolution_record needed here"
    },
    {
      "flow_name": "inc-action-items-file",
      "relationship": "feeds_into",
      "description": "outputs postmortem_doc consumed by inc-action-items-file"
    },
    {
      "flow_name": "inc-follow-up-review",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-declare-severity",
      "relationship": "fed_by",
      "description": "provides incident_record needed here"
    },
    {
      "flow_name": "inc-assign-incident-roles",
      "relationship": "fed_by",
      "description": "provides role_assignments needed here"
    },
    {
      "flow_name": "inc-timeline-capture",
      "relationship": "fed_by",
      "description": "provides timeline_log needed here"
    },
    {
      "flow_name": "inc-hypothesis-verdict",
      "relationship": "fed_by",
      "description": "provides confirmed_cause needed here"
    }
  ]
}
