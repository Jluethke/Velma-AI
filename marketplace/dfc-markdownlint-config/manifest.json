{
  "name": "dfc-markdownlint-config",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "documentation",
    "markdown",
    "markdownlint",
    "lint",
    "style"
  ],
  "inputs": [
    "repo_path",
    "readme_path"
  ],
  "outputs": [
    "markdownlint_config",
    "markdownlint_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Configure markdownlint-cli2 with a reason for every rule change and fix Markdown violations one rule at a time until the lint exits 0.",
  "related_flows": [
    {
      "flow_name": "dfc-readme-structure",
      "relationship": "fed_by",
      "description": "provides readme_path needed here"
    },
    {
      "flow_name": "dfc-docs-ci-workflow",
      "relationship": "feeds_into",
      "description": "outputs markdownlint_config consumed by dfc-docs-ci-workflow"
    }
  ]
}
