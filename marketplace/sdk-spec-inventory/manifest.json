    },
    {
      "flow_name": "sdk-handwritten-endpoint-map",
      "relationship": "feeds_into",
      "description": "outputs api_inventory consumed by sdk-handwritten-endpoint-map"
    },
    {
      "flow_name": "sdk-endpoint-coverage-audit",
      "relationship": "feeds_into",
      "description": "outputs api_inventory consumed by sdk-endpoint-coverage-audit"
    },
    {
      "flow_name": "sdk-auth-api-key",
      "relationship": "feeds_into",
      "description": "outputs api_inventory consumed by sdk-auth-api-key"
