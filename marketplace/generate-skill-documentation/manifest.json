{
  "name": "generate-skill-documentation",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "generate",
    "skill",
    "documentation"
  ],
  "inputs": [
    "change_log",
    "improved_skill_definition",
    "validation_report"
  ],
  "outputs": [
    "skill_documentation"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Process change_log, improved_skill_definition, validation_report to produce skill_documentation.",
  "related_flows": [
    {
      "flow_name": "apply-skill-fixes",
      "relationship": "fed_by",
      "description": "provides improved_skill_definition needed here"
    },
    {
      "flow_name": "validate-skill-definition",
      "relationship": "fed_by",
      "description": "provides validation_report needed here"
    },
    {
      "flow_name": "export-skill-definition",
      "relationship": "feeds_into",
      "description": "outputs skill_documentation consumed by export-skill-definition"
    }
  ]
}
