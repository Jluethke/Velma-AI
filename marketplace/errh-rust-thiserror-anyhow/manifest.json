{
  "name": "errh-rust-thiserror-anyhow",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "error-handling",
    "rust",
    "thiserror",
    "anyhow",
    "result"
  ],
  "inputs": [
    "repo_path",
    "triage_table",
    "error_taxonomy",
    "logging_policy",
    "test_command"
  ],
  "outputs": [
    "rust_error_changes"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Apply triage actions to Rust code one module at a time with thiserror enums in libraries, anyhow context in binaries, and no unwrap on fallible paths.",
  "related_flows": [
    {
      "flow_name": "errh-error-taxonomy",
      "relationship": "fed_by",
      "description": "provides error_taxonomy needed here"
    },
    {
      "flow_name": "errh-catch-site-triage",
      "relationship": "fed_by",
      "description": "provides triage_table needed here"
    },
    {
      "flow_name": "errh-log-once-at-boundary",
      "relationship": "fed_by",
      "description": "provides logging_policy needed here"
    },
    {
      "flow_name": "errh-rust-axum-problem-details",
      "relationship": "feeds_into",
      "description": "outputs rust_error_changes consumed by errh-rust-axum-problem-details"
    },
    {
      "flow_name": "errh-rust-failure-path-tests",
      "relationship": "feeds_into",
      "description": "outputs rust_error_changes consumed by errh-rust-failure-path-tests"
    }
  ]
}
