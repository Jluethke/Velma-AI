{
  "name": "ffr-provider-select",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "openfeature",
    "flagd",
    "unleash",
    "launchdarkly"
  ],
  "inputs": [
    "flag_spec",
    "platform_constraints",
    "existing_flag_system"
  ],
  "outputs": [
    "provider_choice"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Choose flagd, Unleash, or LaunchDarkly behind the OpenFeature API from a fixed decision table and confirm the provider package names per language.",
  "related_flows": [
    {
      "flow_name": "ffr-flag-type-classify",
      "relationship": "fed_by",
      "description": "provides flag_spec needed here"
    },
    {
      "flow_name": "ffr-flagd-local-setup",
      "relationship": "feeds_into",
      "description": "outputs provider_choice consumed by ffr-flagd-local-setup"
    },
    {
      "flow_name": "ffr-py-openfeature-wire",
      "relationship": "feeds_into",
      "description": "outputs provider_choice consumed by ffr-py-openfeature-wire"
    },
    {
      "flow_name": "ffr-safe-default-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-both-paths-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-unleash-setup",
      "relationship": "feeds_into",
      "description": "outputs provider_choice consumed by ffr-unleash-setup"
    },
    {
      "flow_name": "ffr-launchdarkly-setup",
      "relationship": "feeds_into",
      "description": "outputs provider_choice consumed by ffr-launchdarkly-setup"
    },
    {
      "flow_name": "ffr-node-openfeature-wire",
      "relationship": "feeds_into",
      "description": "outputs provider_choice consumed by ffr-node-openfeature-wire"
    }
  ]
}
