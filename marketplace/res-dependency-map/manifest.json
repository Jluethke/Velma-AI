{
  "name": "res-dependency-map",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "resilience",
    "dependencies",
    "criticality",
    "inventory",
    "tracing"
  ],
  "inputs": [
    "service_repo",
    "stack",
    "trace_source"
  ],
  "outputs": [
    "dependency_map"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Inventory every outbound dependency of a service with call sites, client versions, current timeout and retry settings, idempotency, and a table-decided criticality class.",
  "related_flows": [
    {
      "flow_name": "res-latency-percentiles",
      "relationship": "feeds_into",
      "description": "outputs dependency_map consumed by res-latency-percentiles"
    },
    {
      "flow_name": "res-timeout-budget",
      "relationship": "feeds_into",
      "description": "outputs dependency_map consumed by res-timeout-budget"
    },
    {
      "flow_name": "res-retry-policy",
      "relationship": "feeds_into",
      "description": "outputs dependency_map consumed by res-retry-policy"
    },
    {
      "flow_name": "res-breaker-policy",
      "relationship": "feeds_into",
      "description": "outputs dependency_map consumed by res-breaker-policy"
    },
    {
      "flow_name": "res-bulkhead-partition",
      "relationship": "feeds_into",
      "description": "outputs dependency_map consumed by res-bulkhead-partition"
    },
    {
      "flow_name": "res-toxiproxy-faults",
      "relationship": "feeds_into",
      "description": "outputs dependency_map consumed by res-toxiproxy-faults"
    },
    {
      "flow_name": "res-resilience-verify",
      "relationship": "feeds_into",
      "description": "outputs dependency_map consumed by res-resilience-verify"
    },
    {
      "flow_name": "res-py-timeouts",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
