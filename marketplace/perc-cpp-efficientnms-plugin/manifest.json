{
  "name": "perc-cpp-efficientnms-plugin",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "perception",
    "cpp",
    "tensorrt",
    "nms",
    "plugin"
  ],
  "inputs": [
    "onnx_model",
    "cpp_inference_impl",
    "preprocess_spec",
    "nms_iou_threshold",
    "score_threshold"
  ],
  "outputs": [
    "cpp_postprocess_impl"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Append the EfficientNMS_TRT plugin with ONNX GraphSurgeon, rebuild the engine, read its fixed outputs from C++, and match the Python reference.",
  "related_flows": [
    {
      "flow_name": "perc-detection-map-eval",
      "relationship": "feeds_into",
      "description": "outputs cpp_postprocess_impl consumed by perc-detection-map-eval"
    },
    {
      "flow_name": "perc-onnx-export-verify",
      "relationship": "fed_by",
      "description": "provides onnx_model needed here"
    },
    {
      "flow_name": "perc-preprocess-spec-extract",
      "relationship": "fed_by",
      "description": "provides preprocess_spec needed here"
    },
    {
      "flow_name": "perc-cpp-cuda-preprocess",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perc-trtexec-fp16-engine",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perc-int8-calibration-trt",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perc-cpp-trt-runtime",
      "relationship": "fed_by",
      "description": "provides cpp_inference_impl needed here"
    },
    {
      "flow_name": "perc-py-nms-decode",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
