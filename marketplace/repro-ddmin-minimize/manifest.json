{
  "name": "repro-ddmin-minimize",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "debugging",
    "delta-debugging",
    "ddmin",
    "minimization",
    "cvise"
  ],
  "inputs": [
    "deterministic_repro",
    "bug_brief",
    "confirm_runs"
  ],
  "outputs": [
    "minimal_input",
    "minimal_repro"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Shrink the failing input and repro steps to a 1-minimal case with ddmin or cvise using an exit-1-only predicate.",
  "related_flows": [
    {
      "flow_name": "repro-intake-checklist",
      "relationship": "fed_by",
      "description": "provides bug_brief needed here"
    },
    {
      "flow_name": "repro-env-capture",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-container-env-replica",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-deterministic-script",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "repro-nondeterminism-pin",
      "relationship": "fed_by",
      "description": "provides deterministic_repro needed here"
    },
    {
      "flow_name": "repro-git-bisect-run",
      "relationship": "feeds_into",
      "description": "outputs minimal_repro consumed by repro-git-bisect-run"
    },
    {
      "flow_name": "repro-py-pytest-regression-test",
      "relationship": "feeds_into",
      "description": "outputs minimal_input, minimal_repro consumed by repro-py-pytest-regression-test"
    },
    {
      "flow_name": "repro-red-test-gate",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
