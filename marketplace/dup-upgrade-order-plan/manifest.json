{
  "name": "dup-upgrade-order-plan",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "dependency-graph",
    "upgrade-order",
    "planning",
    "lockstep"
  ],
  "inputs": [
    "upgrade_scope",
    "breaking_changes"
  ],
  "outputs": [
    "upgrade_plan"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Order upgrades into single-purpose commits from the dependency graph: runtime first when required, security fixes next, lockstep groups together, dependencies before dependents.",
  "related_flows": [
    {
      "flow_name": "dup-scope-intake",
      "relationship": "fed_by",
      "description": "provides upgrade_scope needed here"
    },
    {
      "flow_name": "dup-baseline-snapshot",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dup-changelog-triage",
      "relationship": "fed_by",
      "description": "provides breaking_changes needed here"
    },
    {
      "flow_name": "dup-rollback-plan",
      "relationship": "feeds_into",
      "description": "outputs upgrade_plan consumed by dup-rollback-plan"
    },
    {
      "flow_name": "dup-apply-one-bump",
      "relationship": "feeds_into",
      "description": "outputs upgrade_plan consumed by dup-apply-one-bump"
    },
    {
      "flow_name": "dup-verify-and-pr",
      "relationship": "complement",
      "description": "co-occurs in 5 chains"
    },
    {
      "flow_name": "dup-py-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "dup-node-lockfile-hygiene",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
