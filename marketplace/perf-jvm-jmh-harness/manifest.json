{
  "name": "perf-jvm-jmh-harness",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "performance",
    "java",
    "jvm",
    "jmh",
    "benchmarking"
  ],
  "inputs": [
    "perf_spec",
    "workload_spec",
    "bench_env_report",
    "repo_path"
  ],
  "outputs": [
    "jvm_bench_raw"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a forked JMH benchmark with State inputs and Param sizes that resists dead-code elimination, and export JSON results with the GC profiler.",
  "related_flows": [
    {
      "flow_name": "perf-metric-workload-define",
      "relationship": "fed_by",
      "description": "provides perf_spec, workload_spec needed here"
    },
    {
      "flow_name": "perf-bench-env-stabilize",
      "relationship": "fed_by",
      "description": "provides bench_env_report needed here"
    },
    {
      "flow_name": "perf-bench-baseline-normalize",
      "relationship": "feeds_into",
      "description": "outputs jvm_bench_raw consumed by perf-bench-baseline-normalize"
    },
    {
      "flow_name": "perf-py-pytest-benchmark-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-node-tinybench-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-go-bench-benchstat-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-rust-criterion-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-hyperfine-cli-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
