{
  "name": "vsim-gz-ros2-bridge",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "gazebo",
    "ros2",
    "ros-gz-bridge",
    "sim-time",
    "simulation"
  ],
  "inputs": [
    "world_file",
    "noisy_vehicle_sdf",
    "ros_distro",
    "gz_version"
  ],
  "outputs": [
    "bridge_config",
    "sim_launch_file"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Bridge Gazebo sensor, command and clock topics to ROS 2 with correct types and verify all nodes run on simulation time.",
  "related_flows": [
    {
      "flow_name": "vsim-gz-vehicle-model",
      "relationship": "fed_by",
      "description": "provides world_file needed here"
    },
    {
      "flow_name": "vsim-gz-sensor-noise",
      "relationship": "fed_by",
      "description": "provides noisy_vehicle_sdf needed here"
    },
    {
      "flow_name": "vsim-gz-seed-determinism",
      "relationship": "feeds_into",
      "description": "outputs sim_launch_file consumed by vsim-gz-seed-determinism"
    },
    {
      "flow_name": "vsim-ros2-bag-replay-sil",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-sim2real-gap-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
