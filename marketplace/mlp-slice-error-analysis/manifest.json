{
  "name": "mlp-slice-error-analysis",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ml",
    "error-analysis",
    "slicing",
    "fairlearn"
  ],
  "inputs": [
    "test_predictions",
    "slice_columns",
    "primary_metric",
    "min_slice_size"
  ],
  "outputs": [
    "slice_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Computes the primary metric with confidence intervals for every value of user-named slice columns and for quantile bins of key numeric features using Fairlearn `MetricFrame`, flags slices whose interval lies entirely below the overall score, and pulls example errors from each flagged slice.",
  "related_flows": [
    {
      "flow_name": "mlp-bootstrap-metric-ci",
      "relationship": "fed_by",
      "description": "provides test_predictions needed here"
    },
    {
      "flow_name": "mlp-paired-model-comparison",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-calibration-diagnose",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "mlp-model-card",
      "relationship": "feeds_into",
      "description": "outputs slice_report consumed by mlp-model-card"
    },
    {
      "flow_name": "mlp-frame-problem-metric",
      "relationship": "fed_by",
      "description": "provides primary_metric needed here"
    }
  ]
}
