{
  "name": "vsim-esmini-scenario-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "esmini",
    "openscenario",
    "scenario",
    "headless",
    "simulation"
  ],
  "inputs": [
    "xosc_file"
  ],
  "outputs": [
    "scenario_check_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run an OpenSCENARIO file headless in esmini with a fixed step and check every event fired and the scenario ended.",
  "related_flows": [
    {
      "flow_name": "vsim-openscenario-author",
      "relationship": "fed_by",
      "description": "provides xosc_file needed here"
    },
    {
      "flow_name": "vsim-fault-scenario-library",
      "relationship": "feeds_into",
      "description": "outputs scenario_check_report consumed by vsim-fault-scenario-library"
    },
    {
      "flow_name": "vsim-scenario-kpis",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "vsim-carla-server-setup",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-carla-sync-mode",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-carla-sensor-rig",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-carla-seed-determinism",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "vsim-scenario-runner-exec",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
