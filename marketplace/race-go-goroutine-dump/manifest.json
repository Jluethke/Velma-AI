{
  "name": "race-go-goroutine-dump",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "go",
    "deadlock",
    "goroutine-dump",
    "pprof",
    "goleak"
  ],
  "inputs": [
    "repo_path",
    "stress_command",
    "failure_class"
  ],
  "outputs": [
    "go_hang_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Captures every goroutine's stack from a hung Go test or process (SIGQUIT, test timeout panic, or pprof `goroutine?debug=2`), groups goroutines by wait reason, and finds the lock or channel cycle, plus goroutine leaks with `goleak`.",
  "related_flows": [
    {
      "flow_name": "race-symptom-triage",
      "relationship": "fed_by",
      "description": "provides failure_class needed here"
    },
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "fed_by",
      "description": "provides stress_command needed here"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs go_hang_report consumed by race-findings-consolidate"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "race-deterministic-regression-test",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "race-apply-fix",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
