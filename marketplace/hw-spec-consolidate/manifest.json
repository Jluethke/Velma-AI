{
  "name": "hw-spec-consolidate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "requirements",
    "scope"
  ],
  "inputs": [
    "interface_table",
    "environment_profile",
    "power_tree",
    "critical_circuits",
    "mechanical_envelope",
    "fab_rules",
    "layer_count"
  ],
  "outputs": [
    "board_spec",
    "product_scope",
    "open_questions"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Merge hardware requirements into one cross-checked board spec, decide which deliverables the product needs, and list open questions with defaults.",
  "related_flows": [
    {
      "flow_name": "hw-interface-spec",
      "relationship": "fed_by",
      "description": "provides environment_profile, interface_table needed here"
    },
    {
      "flow_name": "hw-power-tree",
      "relationship": "fed_by",
      "description": "provides power_tree needed here"
    },
    {
      "flow_name": "hw-critical-circuit-flagging",
      "relationship": "fed_by",
      "description": "provides critical_circuits needed here"
    },
    {
      "flow_name": "hw-mechanical-fab-constraints",
      "relationship": "fed_by",
      "description": "provides layer_count, mechanical_envelope, fab_rules needed here"
    },
    {
      "flow_name": "hw-baseline-architecture",
      "relationship": "feeds_into",
      "description": "outputs board_spec consumed by hw-baseline-architecture"
    },
    {
      "flow_name": "hw-architecture-candidates",
      "relationship": "feeds_into",
      "description": "outputs board_spec consumed by hw-architecture-candidates"
    },
    {
      "flow_name": "eda-toolchain-check",
      "relationship": "feeds_into",
      "description": "outputs product_scope consumed by eda-toolchain-check"
    },
    {
      "flow_name": "pcb-part-selection",
      "relationship": "feeds_into",
      "description": "outputs board_spec consumed by pcb-part-selection"
    }
  ]
}
