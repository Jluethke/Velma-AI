{
  "name": "stp-test-integrity-guard",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "test-integrity",
    "skip-detection",
    "suppression",
    "small-model"
  ],
  "inputs": [
    "edit_outcome",
    "start_commit",
    "baseline_report",
    "verify_card",
    "scratch_log",
    "repo_path"
  ],
  "outputs": [
    "integrity_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Prove no test was deleted, skipped, focused or weakened and no check was suppressed since the start commit.",
  "related_flows": [
    {
      "flow_name": "stp-apply-one-edit",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "stp-run-verify-capture",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    },
    {
      "flow_name": "stp-keep-or-revert-edit",
      "relationship": "fed_by",
      "description": "provides edit_outcome needed here"
    },
    {
      "flow_name": "stp-stop-or-continue",
      "relationship": "feeds_into",
      "description": "outputs integrity_report consumed by stp-stop-or-continue"
    },
    {
      "flow_name": "stp-final-evidence-report",
      "relationship": "feeds_into",
      "description": "outputs integrity_report consumed by stp-final-evidence-report"
    },
    {
      "flow_name": "stp-goal-to-runnable-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "stp-scratch-log-start",
      "relationship": "fed_by",
      "description": "provides scratch_log, start_commit needed here"
    },
    {
      "flow_name": "stp-baseline-capture",
      "relationship": "fed_by",
      "description": "provides verify_card, baseline_report needed here"
    }
  ]
}
