{
  "name": "k8s-helm-chart-build",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "helm",
    "chart",
    "values-schema"
  ],
  "inputs": [
    "packaging_choice",
    "manifest_layout",
    "rollout_deployment",
    "pdb_manifest",
    "service_manifest",
    "ingress_manifest",
    "config_manifests",
    "hpa_manifest",
    "network_policies",
    "namespace_manifest",
    "environments"
  ],
  "outputs": [
    "chart_dir",
    "helm_rendered_manifests"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Build a Helm chart that templates only per-environment differences, validate values with a JSON schema, and prove renders match the verified manifests.",
  "related_flows": [
    {
      "flow_name": "k8s-helm-vs-kustomize-decision",
      "relationship": "fed_by",
      "description": "provides packaging_choice, manifest_layout needed here"
    },
    {
      "flow_name": "k8s-kustomize-overlays",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-kubeconform-validate",
      "relationship": "feeds_into",
      "description": "outputs helm_rendered_manifests consumed by k8s-kubeconform-validate"
    },
    {
      "flow_name": "k8s-kube-linter-check",
      "relationship": "feeds_into",
      "description": "outputs helm_rendered_manifests consumed by k8s-kube-linter-check"
    },
    {
      "flow_name": "k8s-argocd-application",
      "relationship": "feeds_into",
      "description": "outputs chart_dir consumed by k8s-argocd-application"
    },
    {
      "flow_name": "k8s-flux-kustomization",
      "relationship": "feeds_into",
      "description": "outputs chart_dir consumed by k8s-flux-kustomization"
    },
    {
      "flow_name": "k8s-rollout-status-watch",
      "relationship": "feeds_into",
      "description": "outputs helm_rendered_manifests consumed by k8s-rollout-status-watch"
    },
    {
      "flow_name": "k8s-service-ingress-manifest",
      "relationship": "fed_by",
      "description": "provides service_manifest, ingress_manifest needed here"
    }
  ]
}
