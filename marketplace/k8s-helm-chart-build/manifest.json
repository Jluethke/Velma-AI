{
    "name": "k8s-helm-chart-build",
    "version": "1.0.0",
    "domain": "engineering",
    "tags": [
        "kubernetes",
        "helm",
        "chart",
        "values-schema"
    ],
    "inputs": [
        "packaging_choice",
        "manifest_layout",
        "rollout_deployment",
        "pdb_manifest",
        "service_manifest",
        "ingress_manifest",
        "config_manifests",
        "hpa_manifest",
        "network_policies",
        "namespace_manifest",
        "environments"
    ],
    "outputs": [
        "chart_dir",
        "helm_rendered_manifests"
    ],
    "execution_pattern": "phase_pipeline",
    "price": "0",
    "license": "OPEN",
    "description": "Build a Helm chart that templates only per-environment differences, validate values with a JSON schema, and prove renders match the verified manifests."
}
