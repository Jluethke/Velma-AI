      "description": "outputs pricing_spec consumed by bill-mor-paddle"
    },
    {
      "flow_name": "bill-mor-lemonsqueezy",
      "relationship": "feeds_into",
      "description": "outputs pricing_spec consumed by bill-mor-lemonsqueezy"
    },
    {
      "flow_name": "bill-stripe-catalog-setup",
      "relationship": "feeds_into",
      "description": "outputs pricing_spec consumed by bill-stripe-catalog-setup"
    },
    {
      "flow_name": "bill-py-webhook-endpoint",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "bill-node-webhook-endpoint",
