{
  "name": "sqlo-pg-auto-explain-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "postgresql",
    "auto_explain",
    "query-plan",
    "performance"
  ],
  "inputs": [
    "tuning_scope",
    "slow_query_list"
  ],
  "outputs": [
    "captured_plans"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Log real execution plans of slow PostgreSQL statements with auto_explain and extract one plan per slow query.",
  "related_flows": [
    {
      "flow_name": "sqlo-sargable-rewrite",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-keyset-pagination",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-btree-composite-order",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-index-write-cost",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-prod-like-verify",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-baseline-scope",
      "relationship": "fed_by",
      "description": "provides tuning_scope needed here"
    },
    {
      "flow_name": "sqlo-pg-stat-statements-capture",
      "relationship": "fed_by",
      "description": "provides slow_query_list needed here"
    },
    {
      "flow_name": "sqlo-pg-explain-analyze-read",
      "relationship": "feeds_into",
      "description": "outputs captured_plans consumed by sqlo-pg-explain-analyze-read"
    }
  ]
}
