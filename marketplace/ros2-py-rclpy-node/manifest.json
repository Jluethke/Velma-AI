{
  "name": "ros2-py-rclpy-node",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ros2",
    "robotics",
    "rclpy",
    "python",
    "node"
  ],
  "inputs": [
    "workspace_dir",
    "node_spec",
    "interface_package"
  ],
  "outputs": [
    "py_node_source",
    "py_test_result"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write an rclpy node class, register it as a console script in an ament_python package, and verify it runs, shuts down cleanly and passes package tests.",
  "related_flows": [
    {
      "flow_name": "ros2-workspace-colcon-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ros2-interface-definition",
      "relationship": "fed_by",
      "description": "provides interface_package needed here"
    },
    {
      "flow_name": "ros2-param-yaml-file",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ros2-py-param-callback",
      "relationship": "feeds_into",
      "description": "outputs py_node_source consumed by ros2-py-param-callback"
    },
    {
      "flow_name": "ros2-py-launch-file",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ros2-py-lifecycle-node",
      "relationship": "feeds_into",
      "description": "outputs py_node_source consumed by ros2-py-lifecycle-node"
    },
    {
      "flow_name": "ros2-py-executors-callback-groups",
      "relationship": "feeds_into",
      "description": "outputs py_node_source consumed by ros2-py-executors-callback-groups"
    },
    {
      "flow_name": "ros2-launch-testing",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
