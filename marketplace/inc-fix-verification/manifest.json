{
  "name": "inc-fix-verification",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "incident-response",
    "regression-test",
    "canary",
    "argo-rollouts",
    "verification"
  ],
  "inputs": [
    "confirmed_cause",
    "fix_change",
    "stabilization_status",
    "metric_findings",
    "prometheus_url"
  ],
  "outputs": [
    "fix_verification"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Prove an incident fix with a fail-before pass-after regression test, canary it with an explicit abort rule, and unwind temporary mitigations one at a time.",
  "related_flows": [
    {
      "flow_name": "inc-promql-red-triage",
      "relationship": "fed_by",
      "description": "provides metric_findings needed here"
    },
    {
      "flow_name": "inc-confirm-stabilization",
      "relationship": "fed_by",
      "description": "provides stabilization_status needed here"
    },
    {
      "flow_name": "inc-hypothesis-verdict",
      "relationship": "fed_by",
      "description": "provides confirmed_cause needed here"
    },
    {
      "flow_name": "inc-declare-resolved",
      "relationship": "feeds_into",
      "description": "outputs fix_verification consumed by inc-declare-resolved"
    }
  ]
}
