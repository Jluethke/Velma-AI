{
  "name": "sqlo-pg-statistics-analyze",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "postgresql",
    "statistics",
    "analyze",
    "create-statistics"
  ],
  "inputs": [
    "tuning_scope",
    "plan_findings"
  ],
  "outputs": [
    "stats_actions"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Trace PostgreSQL row estimate errors to their cause in pg_stats and fix them with ANALYZE, statistics targets or CREATE STATISTICS.",
  "related_flows": [
    {
      "flow_name": "sqlo-sargable-rewrite",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-keyset-pagination",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-btree-composite-order",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-index-write-cost",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "sqlo-prod-like-verify",
      "relationship": "feeds_into",
      "description": "outputs stats_actions consumed by sqlo-prod-like-verify"
    },
    {
      "flow_name": "sqlo-baseline-scope",
      "relationship": "fed_by",
      "description": "provides tuning_scope needed here"
    },
    {
      "flow_name": "sqlo-pg-stat-statements-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sqlo-pg-auto-explain-capture",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
