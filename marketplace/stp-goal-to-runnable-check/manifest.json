{
  "name": "stp-goal-to-runnable-check",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "goal",
    "acceptance-check",
    "scope",
    "small-model",
    "coding-loop"
  ],
  "inputs": [
    "task_request",
    "repo_path",
    "stack"
  ],
  "outputs": [
    "goal_check",
    "scope_limits"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Restate a coding request as one runnable command with a literal pass string, plus fixed scope limits and stop triggers.",
  "related_flows": [
    {
      "flow_name": "stp-scratch-log-start",
      "relationship": "feeds_into",
      "description": "outputs goal_check, scope_limits consumed by stp-scratch-log-start"
    },
    {
      "flow_name": "stp-baseline-capture",
      "relationship": "feeds_into",
      "description": "outputs goal_check consumed by stp-baseline-capture"
    },
    {
      "flow_name": "stp-rg-symbol-search",
      "relationship": "feeds_into",
      "description": "outputs goal_check consumed by stp-rg-symbol-search"
    },
    {
      "flow_name": "stp-context-read-budget",
      "relationship": "feeds_into",
      "description": "outputs goal_check consumed by stp-context-read-budget"
    },
    {
      "flow_name": "stp-decompose-small-edits",
      "relationship": "feeds_into",
      "description": "outputs goal_check, scope_limits consumed by stp-decompose-small-edits"
    },
    {
      "flow_name": "stp-edit-plan-write",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "stp-cli-flag-exists-check",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "stp-edit-plan-lock",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    }
  ]
}
