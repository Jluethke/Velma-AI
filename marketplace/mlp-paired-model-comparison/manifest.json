  "outputs": [
    "comparison_result"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Decides whether the tuned model beats the best baseline using paired tests on identical test rows: a paired bootstrap of the metric difference for any metric, and McNemar's exact test from statsmodels for accuracy-type outcomes.",
