{
  "name": "bill-usage-reconcile",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "billing",
    "stripe",
    "metering",
    "reconciliation",
    "sql"
  ],
  "inputs": [
    "meter_config",
    "usage_outbox_schema",
    "reconcile_window"
  ],
  "outputs": [
    "reconcile_report",
    "meter_adjustments"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Reconcile local usage totals against Stripe meter event summaries per customer and window, and correct over-reported events with meter event adjustments.",
  "related_flows": [
