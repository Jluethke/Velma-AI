      "description": "outputs model_package consumed by edge-ota-ab-swap-rollback"
    },
    {
      "flow_name": "edge-systemd-watchdog-service",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-health-report",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-onnx-export-validate",
      "relationship": "fed_by",
      "description": "provides onnx_model needed here"
    },
    {
      "flow_name": "edge-trtexec-engine-build",
      "relationship": "fed_by",
      "description": "provides engine_file needed here"
    },
    {
      "flow_name": "edge-trt-engine-cache-key",
      "relationship": "fed_by",
      "description": "provides engine_cache_key needed here"
    },
    {
      "flow_name": "edge-quantization-accuracy-check",
      "relationship": "fed_by",
      "description": "provides accuracy_report needed here"
    },
    {
      "flow_name": "edge-latency-throughput-benchmark",
      "relationship": "fed_by",
      "description": "provides benchmark_report needed here"
    }
  ]
