{
  "name": "edge-ota-model-package",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "ota",
    "packaging",
    "signing",
    "openssl",
    "model-update"
  ],
  "inputs": [
    "engine_file",
    "onnx_model",
    "engine_cache_key",
    "accuracy_report",
    "benchmark_report",
    "model_version"
  ],
  "outputs": [
    "model_package"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Assemble a reproducible, signed model update package with a hash-complete manifest and accuracy and benchmark evidence.",
  "related_flows": [
    {
      "flow_name": "edge-ota-ab-swap-rollback",
