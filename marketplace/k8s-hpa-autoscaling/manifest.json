{
  "name": "k8s-hpa-autoscaling",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "kubernetes",
    "hpa",
    "autoscaling",
    "metrics-server"
  ],
  "inputs": [
    "rollout_deployment",
    "usage_report",
    "min_replicas",
    "max_replicas",
    "target_cpu_utilization"
  ],
  "outputs": [
    "hpa_manifest"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write an autoscaling/v2 HorizontalPodAutoscaler on CPU utilization after checking its preconditions, and prove it scales under load.",
  "related_flows": [
    {
      "flow_name": "k8s-resource-usage-measure",
      "relationship": "fed_by",
      "description": "provides usage_report needed here"
    },
    {
      "flow_name": "k8s-requests-limits-from-usage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-py-gunicorn-worker-sizing",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-node-heap-sizing",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-go-gomaxprocs-gomemlimit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-jvm-container-heap",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "k8s-rolling-update-pdb",
      "relationship": "fed_by",
      "description": "provides rollout_deployment needed here"
    },
    {
      "flow_name": "k8s-helm-chart-build",
      "relationship": "feeds_into",
      "description": "outputs hpa_manifest consumed by k8s-helm-chart-build"
    }
  ]
}
