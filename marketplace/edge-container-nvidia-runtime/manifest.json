{
  "name": "edge-container-nvidia-runtime",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "docker",
    "nvidia-container-runtime",
    "l4t",
    "containers"
  ],
  "inputs": [
    "device_host",
    "platform_report",
    "container_image"
  ],
  "outputs": [
    "container_run_spec"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Configure Docker with the NVIDIA runtime on Jetson, pick an image matching the host L4T release, and verify GPU access inside it.",
  "related_flows": [
    {
      "flow_name": "edge-jetpack-l4t-version-check",
      "relationship": "fed_by",
      "description": "provides platform_report needed here"
    },
    {
      "flow_name": "edge-cuda-cudnn-aarch64-verify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-nvpmodel-power-mode",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-jetson-clocks-lock",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-tegrastats-thermal-log",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "edge-unified-memory-budget",
      "relationship": "feeds_into",
      "description": "outputs container_run_spec consumed by edge-unified-memory-budget"
    },
    {
      "flow_name": "edge-deepstream-nvinfer-pipeline",
      "relationship": "feeds_into",
      "description": "outputs container_run_spec consumed by edge-deepstream-nvinfer-pipeline"
    }
  ]
}
