{
  "name": "sccpp-cmake-build-profiles",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "cmake",
    "build",
    "compile-commands",
    "verification"
  ],
  "inputs": [
    "codebase_dir",
    "stack",
    "language",
    "toolchain_file"
  ],
  "outputs": [
    "build_profiles"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Set up separate CMake build directories for target, host test, coverage and sanitizer runs, each with its own compile database.",
  "related_flows": [
    {
      "flow_name": "sccpp-standard-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-gcc-warning-set",
      "relationship": "feeds_into",
      "description": "outputs build_profiles consumed by sccpp-gcc-warning-set"
    },
    {
      "flow_name": "sccpp-clang-warning-set",
      "relationship": "feeds_into",
      "description": "outputs build_profiles consumed by sccpp-clang-warning-set"
    },
    {
      "flow_name": "sccpp-clang-tidy-config",
      "relationship": "feeds_into",
      "description": "outputs build_profiles consumed by sccpp-clang-tidy-config"
    },
    {
      "flow_name": "sccpp-cppcheck-misra-c",
      "relationship": "feeds_into",
      "description": "outputs build_profiles consumed by sccpp-cppcheck-misra-c"
    },
    {
      "flow_name": "sccpp-findings-triage",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-deviation-record",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "sccpp-c-static-memory",
      "relationship": "feeds_into",
      "description": "outputs build_profiles consumed by sccpp-c-static-memory"
    }
  ]
}
