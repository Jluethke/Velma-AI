{
  "name": "flk-go-race-detect",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "flaky-tests",
    "go",
    "race-detector",
    "concurrency"
  ],
  "inputs": [
    "flake_evidence",
    "go_flake_rate_report",
    "repeat_count",
    "repo_path"
  ],
  "outputs": [
    "go_race_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run a flaky Go test under the race detector at the derived count and read each DATA RACE report down to the two conflicting source lines.",
  "related_flows": [
    {
      "flow_name": "flk-flake-evidence-intake",
      "relationship": "fed_by",
      "description": "provides flake_evidence needed here"
    },
    {
      "flow_name": "flk-run-count-derive",
      "relationship": "fed_by",
      "description": "provides repeat_count needed here"
    },
    {
      "flow_name": "flk-go-count-measure",
      "relationship": "fed_by",
      "description": "provides go_flake_rate_report needed here"
    },
    {
      "flow_name": "flk-go-shuffle-order-detect",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-tz-locale-matrix-detect",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-classify-root-cause",
      "relationship": "feeds_into",
      "description": "outputs go_race_report consumed by flk-classify-root-cause"
    },
    {
      "flow_name": "flk-go-sync-wait-fix",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "flk-go-test-isolation-fix",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
