{
  "name": "pcb-critical-routing",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "pcb",
    "hardware",
    "routing",
    "power",
    "differential-pair"
  ],
  "inputs": [
    "placed_board",
    "net_classes",
    "critical_circuits"
  ],
  "outputs": [
    "critical_routed_board",
    "locked_nets"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Script-route high-current power paths, differential bus pairs, and emergency stop loops at their required width and coupling, then lock them against autorouter changes.",
  "related_flows": [
    {
      "flow_name": "pcb-board-setup",
      "relationship": "fed_by",
      "description": "provides net_classes needed here"
    },
    {
      "flow_name": "pcb-placement-candidates",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-placement-scoring",
      "relationship": "fed_by",
      "description": "provides placed_board needed here"
    },
    {
      "flow_name": "pcb-autoroute",
      "relationship": "feeds_into",
      "description": "outputs locked_nets, critical_routed_board consumed by pcb-autoroute"
    },
    {
      "flow_name": "pcb-drc-closure",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pcb-layout-metrics",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "hw-critical-circuit-flagging",
      "relationship": "fed_by",
      "description": "provides critical_circuits needed here"
    }
  ]
}
