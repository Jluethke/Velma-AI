{
  "name": "perf-py-cprofile-capture",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "performance",
    "python",
    "cprofile",
    "pstats",
    "profiling"
  ],
  "inputs": [
    "workload_spec",
    "repo_path"
  ],
  "outputs": [
    "py_cprofile_stats"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Capture cProfile stats at two input sizes, read them with pstats by self and cumulative time, and compare call counts across sizes.",
  "related_flows": [
    {
      "flow_name": "perf-metric-workload-define",
      "relationship": "fed_by",
      "description": "provides workload_spec needed here"
    },
    {
      "flow_name": "perf-bench-env-stabilize",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-py-pytest-benchmark-harness",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-bench-baseline-normalize",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-py-spy-flamegraph",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-flame-graph-read",
      "relationship": "feeds_into",
      "description": "outputs py_cprofile_stats consumed by perf-flame-graph-read"
    },
    {
      "flow_name": "perf-hotspot-classify",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "perf-fix-algorithmic-complexity",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
