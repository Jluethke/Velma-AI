{
  "name": "tf-fmt-validate",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "terraform",
    "iac",
    "fmt",
    "validate",
    "quality-gate"
  ],
  "inputs": [
    "root_modules"
  ],
  "outputs": [
    "fmt_validate_report"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run terraform fmt -check and terraform validate -json across all modules without remote state, read the diagnostics, and fix one error at a time until both pass.",
  "related_flows": [
    {
      "flow_name": "tf-tflint",
      "relationship": "feeds_into",
      "description": "outputs fmt_validate_report consumed by tf-tflint"
    },
    {
      "flow_name": "tf-checkov",
      "relationship": "feeds_into",
      "description": "outputs fmt_validate_report consumed by tf-checkov"
    },
    {
      "flow_name": "tf-plan-review",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tf-plan-policy-conftest",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "tf-repo-layout",
      "relationship": "fed_by",
      "description": "provides root_modules needed here"
    },
    {
      "flow_name": "tf-env-strategy",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tf-version-pinning",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "tf-state-s3-backend",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
