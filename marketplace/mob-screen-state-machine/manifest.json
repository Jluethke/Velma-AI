{
  "name": "mob-screen-state-machine",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "mobile",
    "state-machine",
    "screen",
    "ui-state",
    "testing"
  ],
  "inputs": [
    "app_profile",
    "screen_spec"
  ],
  "outputs": [
    "screen_state_machine"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Turn a screen spec into a closed state machine with a full transition table, named effects, restoration fields, announcements and one test case per transition.",
  "related_flows": [
    {
      "flow_name": "mob-app-profile",
      "relationship": "fed_by",
      "description": "provides app_profile needed here"
    },
    {
      "flow_name": "mob-network-retry-policy",
      "relationship": "feeds_into",
      "description": "outputs screen_state_machine consumed by mob-network-retry-policy"
    },
    {
      "flow_name": "mob-ios-urlsession-offline",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "mob-android-okhttp-offline",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "mob-ios-local-store",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "mob-android-room-store",
      "relationship": "complement",
      "description": "co-occurs in 3 chains"
    },
    {
      "flow_name": "mob-ios-accessibility",
      "relationship": "feeds_into",
      "description": "outputs screen_state_machine consumed by mob-ios-accessibility"
    },
    {
      "flow_name": "mob-android-accessibility",
      "relationship": "feeds_into",
      "description": "outputs screen_state_machine consumed by mob-android-accessibility"
    }
  ]
}
