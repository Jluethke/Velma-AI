{
  "name": "race-symptom-triage",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "concurrency",
    "triage",
    "race-condition",
    "deadlock",
    "debugging"
  ],
  "inputs": [
    "symptom",
    "stack",
    "concurrency_model",
    "repo_path",
    "target_test"
  ],
  "outputs": [
    "failure_class",
    "suspect_paths"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Maps a reported concurrency symptom (wrong value, hang, crash message, duplicate side effect, database serialization error) to one named failure class using a fixed decision table, and lists the source paths that touch the failing operation.",
  "related_flows": [
    {
      "flow_name": "race-shared-state-inventory",
      "relationship": "feeds_into",
      "description": "outputs suspect_paths consumed by race-shared-state-inventory"
    },
    {
      "flow_name": "race-stress-harness",
      "relationship": "feeds_into",
      "description": "outputs failure_class consumed by race-stress-harness"
    },
    {
      "flow_name": "race-findings-consolidate",
      "relationship": "feeds_into",
      "description": "outputs failure_class consumed by race-findings-consolidate"
    },
    {
      "flow_name": "race-sync-primitive-choice",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-deterministic-regression-test",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-apply-fix",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-stress-verify",
      "relationship": "complement",
      "description": "co-occurs in 6 chains"
    },
    {
      "flow_name": "race-lock-ordering",
      "relationship": "complement",
      "description": "co-occurs in 4 chains"
    }
  ]
}
