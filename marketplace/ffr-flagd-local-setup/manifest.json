{
  "name": "ffr-flagd-local-setup",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "feature-flags",
    "flagd",
    "openfeature",
    "ofrep",
    "docker"
  ],
  "inputs": [
    "flag_spec",
    "provider_choice",
    "repo_path"
  ],
  "outputs": [
    "flagd_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a schema-valid flagd flag file, run flagd in Docker, and prove evaluation over the flagd evaluation API and OFREP with curl.",
  "related_flows": [
    {
      "flow_name": "ffr-flag-type-classify",
      "relationship": "fed_by",
      "description": "provides flag_spec needed here"
    },
    {
      "flow_name": "ffr-provider-select",
      "relationship": "fed_by",
      "description": "provides provider_choice needed here"
    },
    {
      "flow_name": "ffr-py-openfeature-wire",
      "relationship": "feeds_into",
      "description": "outputs flagd_config consumed by ffr-py-openfeature-wire"
    },
    {
      "flow_name": "ffr-safe-default-audit",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-both-paths-test",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "ffr-node-openfeature-wire",
      "relationship": "feeds_into",
      "description": "outputs flagd_config consumed by ffr-node-openfeature-wire"
    },
    {
      "flow_name": "ffr-go-openfeature-wire",
      "relationship": "feeds_into",
      "description": "outputs flagd_config consumed by ffr-go-openfeature-wire"
    },
    {
      "flow_name": "ffr-java-openfeature-wire",
      "relationship": "feeds_into",
      "description": "outputs flagd_config consumed by ffr-java-openfeature-wire"
    }
  ]
}
