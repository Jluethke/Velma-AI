{
  "name": "pkg-py-pyproject-metadata",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "python",
    "pyproject.toml",
    "hatchling",
    "setuptools",
    "pep621"
  ],
  "inputs": [
    "package_profile",
    "license_report",
    "release_version"
  ],
  "outputs": [
    "pyproject_config"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Write a valid PEP 621 pyproject.toml for hatchling or setuptools with build-system, single-sourced version, PEP 639 license fields and package discovery, validated with validate-pyproject.",
  "related_flows": [
    {
      "flow_name": "pkg-scope-intake",
      "relationship": "fed_by",
      "description": "provides package_profile needed here"
    },
    {
      "flow_name": "pkg-public-api-inventory",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-license-metadata",
      "relationship": "fed_by",
      "description": "provides license_report needed here"
    },
    {
      "flow_name": "pkg-py-dunder-all-exports",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-py-build-wheel-sdist",
      "relationship": "feeds_into",
      "description": "outputs pyproject_config consumed by pkg-py-build-wheel-sdist"
    },
    {
      "flow_name": "pkg-py-dist-inspect",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-py-clean-venv-install",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "pkg-py-testpypi-upload",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
