{
  "name": "alog-checkpoint-signing",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "audit-log",
    "checkpoint",
    "signed-head",
    "truncation",
    "ed25519"
  ],
  "inputs": [
    "chain_link_spec",
    "signing_keypair",
    "checkpoint_interval"
  ],
  "outputs": [
    "checkpoint_spec"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Define a periodic signed checkpoint that commits to the current chain head or tree head, sequence, size, and time, so a verifier has a signed high-water mark that resists tail truncation and whole-file replay.",
  "related_flows": [
    {
      "flow_name": "alog-hash-algorithm-select",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "alog-merkle-tree-build",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "alog-merkle-inclusion-proof",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "alog-merkle-consistency-proof",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "alog-external-anchoring",
      "relationship": "feeds_into",
      "description": "outputs checkpoint_spec consumed by alog-external-anchoring"
    },
    {
      "flow_name": "alog-hash-chain-link-design",
      "relationship": "fed_by",
      "description": "provides chain_link_spec needed here"
    },
    {
      "flow_name": "alog-ed25519-keygen",
      "relationship": "fed_by",
      "description": "provides signing_keypair needed here"
    },
    {
      "flow_name": "alog-log-rotation-chain-preserving",
      "relationship": "feeds_into",
      "description": "outputs checkpoint_spec consumed by alog-log-rotation-chain-preserving"
    }
  ]
}
