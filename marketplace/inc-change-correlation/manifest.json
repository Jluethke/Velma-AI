{
  "name": "inc-change-correlation",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "incident-response",
    "change-management",
    "deploy-history",
    "kubernetes",
    "audit-log"
  ],
  "inputs": [
    "incident_record",
    "timeline_log",
    "metric_findings",
    "platform",
    "recent_changes"
  ],
  "outputs": [
    "change_correlation"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Collect every deploy, config, flag, infrastructure and dependency change before the metric onset and rank them as rollback candidates.",
  "related_flows": [
    {
      "flow_name": "inc-promql-red-triage",
      "relationship": "fed_by",
      "description": "provides metric_findings needed here"
    },
    {
      "flow_name": "inc-declare-severity",
      "relationship": "fed_by",
      "description": "provides incident_record needed here"
    },
    {
      "flow_name": "inc-assign-incident-roles",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-timeline-capture",
      "relationship": "fed_by",
      "description": "provides timeline_log needed here"
    },
    {
      "flow_name": "inc-status-page-update",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-stabilize-decision-table",
      "relationship": "feeds_into",
      "description": "outputs change_correlation consumed by inc-stabilize-decision-table"
    },
    {
      "flow_name": "inc-k8s-rollout-undo",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "inc-feature-flag-off",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    }
  ]
}
