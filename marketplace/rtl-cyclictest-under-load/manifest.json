{
    "name": "rtl-cyclictest-under-load",
    "version": "1.0.0",
    "domain": "engineering",
    "tags": [
        "realtime-linux",
        "cyclictest",
        "stress-ng",
        "hackbench"
    ],
    "inputs": [
        "baseline_summary",
        "isolation_config",
        "power_config",
        "irq_thread_priorities",
        "test_duration",
        "rt_priority",
        "rt_cpus"
    ],
    "outputs": [
        "loaded_histogram",
        "loaded_summary"
    ],
    "execution_pattern": "phase_pipeline",
    "price": "0",
    "license": "OPEN",
    "description": "Run cyclictest on the isolated CPUs while stress-ng and hackbench load the housekeeping CPUs, and compare against the baseline."
}
