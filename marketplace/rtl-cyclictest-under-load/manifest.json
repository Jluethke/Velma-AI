{
  "name": "rtl-cyclictest-under-load",
  "version": "1.0.0",
  "domain": "engineering",
  "tags": [
    "realtime-linux",
    "cyclictest",
    "stress-ng",
    "hackbench"
  ],
  "inputs": [
    "baseline_summary",
    "isolation_config",
    "power_config",
    "irq_thread_priorities",
    "test_duration",
    "rt_priority",
    "rt_cpus"
  ],
  "outputs": [
    "loaded_histogram",
    "loaded_summary"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "OPEN",
  "description": "Run cyclictest on the isolated CPUs while stress-ng and hackbench load the housekeeping CPUs, and compare against the baseline.",
  "related_flows": [
    {
      "flow_name": "rtl-kernel-rt-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rtl-cyclictest-baseline",
      "relationship": "fed_by",
      "description": "provides baseline_summary needed here"
    },
    {
      "flow_name": "rtl-hw-noise-check",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rtl-power-cstate-tuning",
      "relationship": "fed_by",
      "description": "provides power_config needed here"
    },
    {
      "flow_name": "rtl-cpu-isolation-bootargs",
      "relationship": "fed_by",
      "description": "provides isolation_config needed here"
    },
    {
      "flow_name": "rtl-cpuset-partition",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rtl-irq-affinity",
      "relationship": "complement",
      "description": "co-occurs in 2 chains"
    },
    {
      "flow_name": "rtl-threaded-irq-priority",
      "relationship": "fed_by",
      "description": "provides irq_thread_priorities needed here"
    }
  ]
}
